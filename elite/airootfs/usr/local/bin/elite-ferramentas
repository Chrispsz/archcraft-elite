#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-ferramentas (v2 — E97, a loja de fábrica)
# ═══════════════════════════════════════════════════════════════════════════
# A v1 (E74) era a porta HONESTA de um sistema SEM loja: cada item
# instalava o que faltava (paru, octopi, appimagelauncher). A E97 MUDA
# A ARQUITETURA (a diretriz do dono: "o usuário abre o sistema e não
# fica perdido — como faço para instalar um Flatpak ou gerenciar meus
# pacotes?"): a loja NASCE DE FÁBRICA — octopi (GUI de repo+AUR),
# yay (o ajudante do AUR) e flatpak (com o remote Flathub pelo hook
# elite-flathub) entram na ISO (packages.add) E nos rigs (ADOCAO do
# craft-update). O menu da v2 é o MAPA do que JÁ ESTÁ na mão:
#
#   Loja de pacotes   → octopi (repo + AUR na GUI, zero terminal)
#   AppImage          → craft-appimage: o registrador da casa (o
#                       AppImage baixado ganha rosto no menu/dock —
#                       sem daemon, sem AUR, o awk da casa)
#   Relatório         → o que existe e de onde vem
#
# O paru e o appimagelauncher SAEM do menu (redundância era o réu: yay
# já é o ajudante — instalar paru em cima é dois ajudantes para o mesmo
# AUR; appimagelauncher é um daemon AUR-only para o que o craft-appimage
# resolve em 30 linhas de casa).
#
# Uso: elite-ferramentas            menu (craft-menu — o motor único)
#      elite-ferramentas --report   só o relatório do que existe
#      elite-ferramentas --loja     abre o octopi direto
#      elite-ferramentas --appimage o seletor do craft-appimage
# ═══════════════════════════════════════════════════════════════════════════
set -u
say() { printf 'elite-ferramentas: %s\n' "$*"; }
err() { printf 'elite-ferramentas: ERRO: %s\n' "$*" >&2; }

report() {
    printf 'ferramentas de pacotes presentes:\n'
    for t in octopi yay flatpak craft-appimage; do
        command -v "$t" >/dev/null 2>&1 && printf '  ✓ %s\n' "$t"
    done
    if command -v flatpak >/dev/null 2>&1; then
        flatpak remotes 2>/dev/null | grep -q '^flathub' \
            && printf '  ✓ flathub (remote configurado)\n' \
            || say "flatpak presente SEM o remote flathub — 'sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo'"
    fi
    command -v octopi >/dev/null 2>&1 || say "octopi ausente — 'sudo pacman -S octopi' (ou o craft-update adota na próxima dose)"
    command -v yay >/dev/null 2>&1 || command -v paru >/dev/null 2>&1 \
        || say "nenhum ajudante do AUR (yay/paru) — 'sudo pacman -S yay'"
}

do_loja() {
    if command -v octopi >/dev/null 2>&1; then
        setsid octopi >/dev/null 2>&1 &
        say "octopi abrindo (repo + AUR na GUI)"
        return 0
    fi
    err "octopi não está instalado — 'sudo pacman -S octopi'"
    return 4
}

do_appimage() {
    if command -v craft-appimage >/dev/null 2>&1; then
        exec craft-appimage
    fi
    err "craft-appimage ausente (elite-system antigo?) — atualize: sudo craft-update"
    return 4
}

case "${1:-menu}" in
    --report) report; exit 0 ;;
    --loja) do_loja; exit $? ;;
    --appimage) do_appimage; exit $? ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    menu|"") : ;;
    *) err "modo desconhecido: $1"; exit 2 ;;
esac

if ! command -v craft-menu >/dev/null 2>&1; then
    err "craft-menu ausente (sessão não-Elite?) — use os modos diretos (--loja/--appimage/--report)"
    exit 3
fi

choice="$(printf '%s\n' \
    "Loja de pacotes — Octopi (repo + AUR, sem terminal)" \
    "Registrar .AppImage no menu (o baixado ganha rosto)" \
    "Relatório do que existe" \
    | craft-menu --title=ferramentas --at=center)" || exit 0

case "$choice" in
    *Octopi*) do_loja ;;
    *AppImage*) do_appimage ;;
    *Relatório*) report ;;
esac
