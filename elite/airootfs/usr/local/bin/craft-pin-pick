#!/usr/bin/env bash
# craft-pin-pick — fixa um app na DOCK escolhendo numa lista (v2.0)
# ─────────────────────────────────────────────────────────────────────────
# Burn test do dono na v1.3 ao vivo: "tentei fixar alguma coisa nela e
# não consigo — na verdade fica fixando ali na bandeja de aplicativos".
# Causa-raiz: o clique-direito do nwg-drawer pinia no PRÓPRIO drawer
# (pinned box dele — upstream), não na dock; e o craft-pin (que fixa na
# dock de verdade) era CLI invisível. Este picker expõe o craft-pin no
# fluxo mouse-first: clique-direito no desktop → "Fixar app na dock…"
# → lista de apps instalados → craft-pin fixa o .desktop na dock nativa.
#
# v2.0 — DOCK NATIVA (craft-dock-gui): este picker estava PRESO à dock
# waybar extinta — exigia o .conf da dock waybar (apagado na v2.0) e
# morria com "✖ arquivo não encontrado"; o mapa glifo/cor era
# consumido por ninguém (ícones Nerd Font morreram com a dock waybar —
# o ícone REAL agora vem do tema via Gio.DesktopAppInfo, resolvido pela
# própria dock). O picker só entrega o .desktop ao craft-pin, que
# valida, faz backup, grava e recarrega a dock (SIGUSR2).
#
# v2.3.1 — FIM DO SILÊNCIO: o picker era o MAIOR silencioso da família
# (morria na linha do command -v sem JAMAIS aparecer para o usuário — a
# denúncia do rig: "fixar app na dock não abre menu"). Agora open/falha
# deixam linha em ~/.cache/elite/menus.log e crash do fuzzel avisa na tela.
set -euo pipefail

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

command -v fuzzel >/dev/null 2>&1 || { mlog "Fixar: fuzzel AUSENTE — picker morreu antes de abrir"; timeout 5 notify-send -a 'Elite' -u normal -t 8000 'Fixar na dock falhou' "fuzzel ausente — detalhe em ~/.cache/elite/menus.log" 2>/dev/null || true; exit 1; }
command -v craft-pin >/dev/null 2>&1 || { mlog "Fixar: craft-pin AUSENTE"; exit 1; }

# v2.10.5 — A FLAG É PROBADA ANTES DE USAR (lei do craft-menu: 'flag nova
# que mata'): --anchor sem probe matava o picker inteiro em fuzzel velho
# ('unrecognized option' → 'Fixar na dock falhou' na cara do usuário).
ANCHOR=''
fuzzel --help 2>&1 | grep -q -- '--anchor' && ANCHOR='--anchor=center'

# ── 1. Inventário: .desktop visíveis (overrides do USUÁRIO primeiro —
#       a MESMA precedência do resolve do craft-pin: um .desktop do usuário
#       (AppImage registrado pelo appimagelauncher, ex.) é fixável pelo
#       mesmo fluxo mouse-first — E76) ─────────────────────────────────────
LIST="$(mktemp)"
errf="$(mktemp)"
trap 'rm -f "$LIST" "$errf"' EXIT
: >"$LIST"
seen=""
for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
         /usr/local/share/applications /usr/share/applications; do
    [ -d "$d" ] || continue
    for f in "$d"/*.desktop; do
        [ -r "$f" ] || continue
        base="$(basename "$f")"
        case " $seen " in *" $base "*) continue ;; esac
        seen="$seen $base"
        grep -q '^NoDisplay=true' "$f" && continue
        grep -q '^Hidden=true' "$f" && continue   # v2.10.5: Hidden também esconde (a lei XDG é dupla)
        # v2.10.5 — o NOME É O DA GENTE: Name[pt_BR] vem antes do genérico
        # (app só-localizado não sumia mais do picker da distro pt-BR)
        name="$(sed -n 's/^Name\[pt_BR\]=//p' "$f" | head -1)"
        [ -n "$name" ] || name="$(sed -n 's/^Name=//p' "$f" | head -1)"
        [ -n "$name" ] || continue
        printf '%s\t%s\n' "$name" "$base" >>"$LIST"
    done
done
[ -s "$LIST" ] || { echo "✖ nenhum aplicativo encontrado" >&2; exit 1; }

# ── 2. Escolha (fuzzel dmenu central — é um picker, não um dropdown) ──
# v2.3.1: stderr CAPTURADO — crash vira log + notify (nunca morte calada)
mlog "Fixar: abrindo picker (fuzzel, $(grep -c . "$LIST") apps)"
ec=0
choice="$(cut -f1 "$LIST" | fuzzel --dmenu $ANCHOR --lines=10 --width=32 \
    --prompt='Fixar na dock  ' 2>"$errf")" || ec=$?
if [ "$ec" -eq 143 ]; then
    # v2.3.5 — SIGTERM = fechado de fora (toggle/cross-dismiss) —
    # benigno: sem notify crítico falso (o print do dono).
    mlog "Fixar: fechado de fora (SIGTERM — toggle/cross-dismiss) — benigno"
    rm -f "$errf"
    exit 0
fi
if [ "$ec" -eq 1 ] && [ ! -s "$errf" ]; then
    # v2.3.6 — ESC = fechado pelo usuário (stderr vazio ≠ crash) —
    # benigno: fechar NUNCA é erro (mesma classe do 143).
    mlog "Fixar: fechado pelo usuário (ESC) — benigno"
    rm -f "$errf"
    exit 0
fi
if [ "$ec" -ne 0 ]; then
    mlog "Fixar: FUZZEL FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
    command -v notify-send >/dev/null 2>&1 && \
        timeout 5 notify-send -a 'Elite' -u normal -t 8000 'Fixar na dock falhou' \
            "fuzzel exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    exit 1
fi
[ -n "$choice" ] || exit 0   # Esc: nada acontece

base="$(awk -F'\t' -v n="$choice" '$1 == n {print $2; exit}' "$LIST")"
[ -n "$base" ] || exit 0

# ── 3. Fixa o ID .desktop REAL (Gio.DesktopAppInfo.new() é case-sensitive:
#       nada de slug minúsculo — o ID exato é o que a dock consome) ──────
# E36 — três desfechos com TRÊS toasts (antes: duplicata era rc 0 = toast
# de sucesso falsa; falha real = silêncio — o leigo não sabia NADA).
# E76 — a gramática '|| addrc=$?' (a MESMA do fuzzel acima): a forma antiga
# capturava a saída numa atribuição e lia o rc na LINHA SEGUINTE — mas o
# set -e matava na própria atribuição quando o craft-pin devolvia rc≠0 (a
# duplicata é rc 1 desde o E36): o picker morria CALADO e o desfecho
# 'já estava na dock' era inalcançável (a morte silenciosa que a v2.3.1
# jurou extinta).
addrc=0
addout="$(craft-pin add "$base" 2>&1)" || addrc=$?
if [ "$addrc" -eq 0 ]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a craft-pin "Dock" \
            "'$choice' fixado na dock (clique-direito no desktop → Fixar p/ mais)" || true
    fi
elif printf '%s' "$addout" | grep -q 'já está fixado'; then
    # E36 — a verdade no toast: "já estava" ≠ "fixado"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a craft-pin "Dock" \
            "'$choice' já estava na dock" || true
    fi
else
    mlog "Fixar: craft-pin FALHOU rc=$addrc — $(printf '%s' "$addout" | head -c 200)"
    if command -v notify-send >/dev/null 2>&1; then
        # doutrina v2.3.10: pílula de falha avisa e SOME (-u normal + -t —
        # urgência critical é eterna por design no swaync e foi extinta)
        notify-send -a craft-pin -u normal -t 8000 "Fixar na dock falhou" \
            "rc=$addrc — detalhe em ~/.cache/elite/menus.log" || true
    fi
fi
