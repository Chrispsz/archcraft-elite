#!/usr/bin/env bash
# craft-pin-pick — A GAVETA DE FIXAÇÃO DA DOCK (v4.0 — E106, o laço com marcadores)
# ═════════════════════════════════════════════════════════════════════════
# A ORDEM DO DONO (dump 20261112): "Tanto fixar quanto desfixar poderia
# ser algo mais fácil… fosse um menu unificado… os programas, com o
# marcador se tá ativado, habilitado ou não, para você habilitar e
# desabilitar. Aí ele só fecharia quando você tirasse o mouse de cima da
# função ou clicasse fora da tela." A v3 era dois pickers fuzzel CRUDOS
# one-shot: o menu do desktop fechava, a ação rodava, e CADA fixação/
# desafixão extra exigia reabrir tudo (o menus.log do dump fotografou o
# dono desafixando um por um: 8→7→6→5 pins — quatro aberturas para
# quatro cliques) — e o fuzzel cru morreu rc=2 calado uma vez (sem
# toggle, sem state, sem rede).
#
# A v4.0 é UM fluxo: a lista de TODOS os apps visíveis com o MARCADOR
# (✓ fixado · não fixado), cada escolha ALTERNARIA o estado via
# craft-pin add/rm e REABRE a lista atualizada — o laço só termina em
# ESC, clique-fora (o craft-menu-dismiss do rc.xml mata o fuzzel e o
# craft-menu devolve 143) ou cross-dismiss (outro menu abriu). O motor é
# o craft-menu (não o fuzzel cru): pid no state, toggle/cross-dismiss
# determinísticos, gramática de saída 0/1/2/143 — a mesma lei dos menus
# da topbar. O clique-fora do dono FECHA O LAÇO INTEIRO (a lista que
# ele pediu: fecha quando clicar fora — literal).
#
# Notas de desenho:
#   · SEM modo --rm: a unificação cobre os dois verbos (o marcador diz
#     o estado; escolher um ✓ desafixa, escolher um · fixa) — um fluxo,
#     uma porta, zero caminho morto (a lei E33).
#   · O nome é o REAL (Name[pt_BR] primeiro — a escola v2.10.5).
#   · Cada alternância avisa na tela (normal, some em 3s) — o feedback
#     que a v3 nunca deu.
# ═════════════════════════════════════════════════════════════════════════
set -uo pipefail

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

avisa() { # $1=titulo $2=texto (feedback da ação do dono — some em 3s)
    command -v notify-send >/dev/null 2>&1 || return 0
    timeout 5 notify-send -a craft-pin -u normal -t 3000 "$1" "$2" >/dev/null 2>&1 || true
}

command -v fuzzel >/dev/null 2>&1 || { mlog "Dock: fuzzel AUSENTE — picker morreu antes de abrir"; avisa 'A dock não abriu o menu' "fuzzel ausente — detalhe em ~/.cache/elite/menus.log"; exit 1; }
command -v craft-pin >/dev/null 2>&1 || { mlog "Dock: craft-pin AUSENTE"; exit 1; }
command -v craft-menu >/dev/null 2>&1 || { mlog "Dock: craft-menu AUSENTE — a v4 é filha do motor"; exit 1; }

case "${1:-}" in
    -h|--help)
        printf '%s\n' \
            'uso: craft-pin-pick — a gaveta de fixação da dock (laço com marcadores)' \
            '' \
            '  lista TODOS os apps visíveis com o marcador de estado:' \
            '    ✓ fixado na dock · não fixado' \
            '  escolher alterna (fixa/desfixa) e REABRE a lista atualizada;' \
            '  o laço fecha no ESC, no clique-fora ou quando outro menu abre.' \
            '  (a v3 tinha dois pickers one-shot — o dono mandou unificar: E106)'
        exit 0 ;;
    *) : ;;
esac

LIST="$(mktemp)"
errf="$(mktemp)"
trap 'rm -f "$LIST" "$errf"' EXIT

voltas=0
while :; do
    : >"$LIST"
    pins="$(craft-pin list 2>/dev/null || true)"
    seen=""
    achou=0
    # ── o inventário visível com o marcador (a MESMA precedência do
    #    resolve do craft-pin: usuário → local → sistema — E76) ──
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
             /usr/local/share/applications /usr/share/applications; do
        [ -d "$d" ] || continue
        for f in "$d"/*.desktop; do
            [ -r "$f" ] || continue
            base="$(basename "$f")"
            case " $seen " in *" $base "*) continue ;; esac
            seen="$seen $base"
            grep -q '^NoDisplay=true' "$f" && continue
            grep -q '^Hidden=true' "$f" && continue   # a lei XDG é dupla
            name="$(sed -n 's/^Name\[pt_BR\]=//p' "$f" | head -1)"
            [ -n "$name" ] || name="$(sed -n 's/^Name=//p' "$f" | head -1)"
            [ -n "$name" ] || continue
            fixado="· "
            case " $pins " in *" $base "*) fixado="✓ " ;; esac
            printf '%s%s\t%s\n' "$fixado" "$name" "$base" >>"$LIST"
            achou=1
        done
    done
    # órfão: pin cujo .desktop sumiu — segue removível (o dono o quer ver)
    for id in $pins; do
        case " $seen " in *" $id "*) continue ;; esac
        printf '✓ %s\t%s\n' "$id" "$id" >>"$LIST"
        achou=1
    done
    [ "$achou" = 1 ] || { echo "✖ nenhum aplicativo encontrado" >&2; exit 1; }

    voltas=$((voltas + 1))
    [ "$voltas" -eq 1 ] && mlog "Dock: gaveta aberta (laço v4, $(grep -c . "$LIST") apps, $(printf '%s' "$pins" | grep -c . 2>/dev/null || echo 0) pins)"

    choice="$(cut -f1 "$LIST" | craft-menu --title='Apps da dock' --at=center 2>"$errf")" || {
        rc=$?
        case "$rc" in
            1)   mlog "Dock: fechado pelo usuário (ESC) após $voltas volta(s) — a gaveta v4 fecha honesta" ;;
            2)   mlog "Dock: gaveta fechada (toggle) após $voltas volta(s)" ;;
            143) mlog "Dock: gaveta fechada de fora (clique-fora/cross-dismiss) após $voltas volta(s)" ;;
            *)   mlog "Dock: gaveta FALHOU rc=$rc — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
                 avisa 'A gaveta da dock falhou' "rc=$rc — detalhe em ~/.cache/elite/menus.log" ;;
        esac
        break
    }
    [ -n "$choice" ] || break   # ESC sem item

    # E106 — o match é pela LINHA CRUA (o motor devolve a linha como é
    # mostrada: ✓ Nome · Nome — a coluna 1 da LIST é exatamente o que o
    # fuzzel devolve; marcador é parte da linha, não lixo a aparar — a
    # cura do bug que o fluxo B da suíte flagrou na primeira rodada).
    base="$(awk -F'\t' -v n="$choice" '$1 == n {print $2; exit}' "$LIST")"
    [ -n "$base" ] || continue

    # E106 — O VERBO PELO MARCADOR (case, não cut): o ✓ é glifo UTF-8 de 3
    # bytes — o cut -c1 num locale C devolve o 1º BYTE (0xe2) e a comparação
    # JAMAIS bate (o fluxo B da suíte flagrou: o ✓ não desfixava NADA). O
    # case casa o prefixo inteiro à prova de locale.
    case "$choice" in
        ✓*)
            rmrc=0
            rmout="$(craft-pin rm "$base" 2>&1)" || rmrc=$?
            if [ "$rmrc" -eq 0 ]; then
                avisa "Dock" "'${choice#✓ }' saiu da dock"
                mlog "Dock: desafixou $base (laço v4)"
            elif printf '%s' "$rmout" | grep -q 'não está na dock'; then
                avisa "Dock" "'${choice#✓ }' não está mais na dock"
            else
                mlog "Dock: craft-pin rm FALHOU rc=$rmrc — $(printf '%s' "$rmout" | head -c 200)"
                avisa 'Desafixar falhou' "rc=$rmrc — detalhe em ~/.cache/elite/menus.log"
            fi
            ;;
        *)
            addrc=0
            addout="$(craft-pin add "$base" 2>&1)" || addrc=$?
            if [ "$addrc" -eq 0 ]; then
                avisa "Dock" "'${choice#· }' fixado na dock"
                mlog "Dock: fixou $base (laço v4)"
            elif printf '%s' "$addout" | grep -q 'já está fixado'; then
                avisa "Dock" "'${choice#· }' já estava na dock"
            else
                mlog "Dock: craft-pin add FALHOU rc=$addrc — $(printf '%s' "$addout" | head -c 200)"
                avisa 'Fixar falhou' "rc=$addrc — detalhe em ~/.cache/elite/menus.log"
            fi
            ;;
    esac
done
exit 0
