#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-post-transaction (E75 — A CASA ACORDA NO -Syu)
# ═══════════════════════════════════════════════════════════════════════════
# Auditoria arquitetural do dono (07/nov): "estruturar hooks nativos do
# pacman para disparar checagens de hardware... automaticamente após
# qualquer pacman -Syu". O gap real medido no papel: a pedagogia de
# REBOOT do kernel só existia na porta do craft-update — um pacman -Syu
# cru trocava o kernel em silêncio e o dono vivia semanas num kernel
# antigo sem saber (o rolling release da base não avisa; só a Elite
# avisava, e só na porta dela).
#
# ESTE bin é o Exec do hook libalpm elite-post-transaction.hook
# (/usr/share/libalpm/hooks — Trigger PostTransaction, Target=*): roda ao
# fim de TODA transação de pacotes (a do craft-update incluída — ele é
# rápido e inofensivo: leituras de sysfs/pacman -Q, zero rede, zero lock).
#
# O QUE FAZ (e o que NÃO faz — a lei de não prometer o que não prova):
#   1. KERNEL NOVO → o aviso na cara de quem rodou o pacman + linha no
#      papel (/var/log/elite-post-transaction.log) + carimbo em
#      /var/lib/elite/kernel-seen (o aviso é UMA vez por troca de kernel —
#      a 1ª execução é só linha de base, nunca falso 'REINICIE');
#   2. WAKE-GUARD E24 OBSERVADO → quantas fontes ACPI seguem armadas (a
#      regra udev 90-elite-wake-guard rege o add de controladores; este
#      log é a vigília do papel — se um update de firmware/udev re-armar
#      o despertar USB, o dump nomeia a hora exata da re-transação);
#   3. E101 — SYSCTL DA CASA COM DRIFT → o update de OUTRO pacote pode
#      re-aplicar o sysctl DELE por cima do da casa (a prova do rig,
#      10/nov: kernel em vm.swappiness='150' com /etc/sysctl.d/99-elite.conf
#      pedindo '180' — o cachyos-settings re-escreveu depois do firstboot,
#      e o systemd-sysctl só roda no boot). O hook compara CADA chave do
#      conf da casa com o kernel vivo; drift = re-aplica só o conf da casa
#      e narra no papel (o tuning da casa vale no -Syu, não no próximo boot);
#   4. E106 — O FANTASMA DO INSTALADOR NÃO RENASCE (calamares/abif fora dos
#      rigs instalados); 5. E108 — O JORNAL PERSISTENTE (/var/log/journal);
#   6. E114 — O CONFO DO NAVEGADOR E A ASSOCIAÇÃO DO EDITOR GRÁFICO
#      sincronizam ao home dos rigs vivos (a cura do vídeo branco + o
#      mousepad como porta text/plain quando o dono não escolheu outra);
#      nada além disso: agir só onde há gargalo provado.
# ═══════════════════════════════════════════════════════════════════════════
set -u

LOG=/var/log/elite-post-transaction.log
STAMP=/var/lib/elite/kernel-seen
KPKG=linux-cachyos-bore   # o kernel da casa (mesma constante do craft-update)
ELITE_SYSCTL=/etc/sysctl.d/99-elite.conf

tlog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$LOG" 2>/dev/null || true
}

# ── 1. A PEDAGOGIA DO KERNEL — trocou na transação, o dono sabe NA HORA ──
cur="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}')"
if [ -n "$cur" ]; then
    if [ ! -e "$STAMP" ]; then
        mkdir -p "${STAMP%/*}" 2>/dev/null || true
        printf '%s\n' "$cur" > "$STAMP" 2>/dev/null || true
        tlog "linha de base: $KPKG $cur (o aviso só dispara em TROCA a partir de agora)"
    else
        seen="$(cat "$STAMP" 2>/dev/null)"
        if [ -n "$seen" ] && [ "$seen" != "$cur" ]; then
            tlog "kernel: $seen → $cur — REINICIE para rodá-lo (aviso ao fim da transação)"
            echo "==> Elite: kernel atualizado (${seen} → ${cur}) — REINICIE para rodá-lo"
            printf '%s\n' "$cur" > "$STAMP" 2>/dev/null || true
        fi
    fi
fi

# ── 2. A POLÍTICA DO DESPERTAR (E122→E126) — agora ENTREGA, não só observa ──
# E113 — O 0 COM ? ATRÁS: o '|| echo ?' dispara TAMBÉM quando o grep -c
# acha ZERO matches (rc=1 é resposta válida do -c) — o papel 19:49:19 do
# rig fotografou 'observado: 0\n? fonte(s)': o ? mentindo alongside o 0.
# O '|| true' + o default 0 separam ARQUIVO AUSENTE de ZERO ARMADAS.
# E126 — O BURACO DE ENTREGA (o dump 173137 provou com bytes: a unit
# elite-wake-guard.service chegou ao rig PELO PACOTE mas o symlink de
# wants NÃO viajava — a unit nunca rodou, os controladores ficaram
# wakeup=disabled e o teclado do dono NUNCA acordou a máquina; a regra
# udev da E122 morava só no airootfs da ISO — o rig da ISO velha segue
# com o fóssil E24 de 3/nov desarmando tudo). A cura em três gestos,
# idempotentes em TODA transação:
#   (a) a unit é HABILITADA e INICIADA aqui (o hook é o veículo que o
#       pacote não tinha — enable --now vale para o rig da dose antiga);
#   (b) a regra v2 viaja NO PACOTE como /usr/lib/udev/rules.d/91-* (o
#       nome 91 vence o fóssil /etc/90-* pela ordem lexical do udev);
#   (c) o fóssil E24 do /etc (sem o marcador E122) é aposentado COM
#       VOZ — renomeado .elite-fossil, nunca apagado às cegas.
armadas="$(grep -c '\*enabled' /proc/acpi/wakeup 2>/dev/null || true)"
[ -n "$armadas" ] || armadas=0
if [ -x /usr/local/bin/craft-wake-guard ]; then
    if systemctl enable elite-wake-guard.service >/dev/null 2>&1 \
       || systemctl is-enabled elite-wake-guard.service >/dev/null 2>&1; then
        tlog "wake-guard E122: unit garantida habilitada na transação (enable ok ou já estava — idempotente)"
    else
        tlog "wake-guard E122: unit não pôde ser habilitada (systemctl rc=$?) — o boot seguinte tenta de novo"
    fi
    systemctl start elite-wake-guard.service >/dev/null 2>&1 \
        && tlog "wake-guard E122: política APLICADA na transação (teclado acorda · mouse dorme · ACPI do USB armado)" \
        || true
fi
if [ -f /etc/udev/rules.d/90-elite-wake-guard.rules ] \
   && ! grep -q 'E122' /etc/udev/rules.d/90-elite-wake-guard.rules 2>/dev/null; then
    if mv -f /etc/udev/rules.d/90-elite-wake-guard.rules \
            /etc/udev/rules.d/90-elite-wake-guard.rules.elite-fossil 2>/dev/null; then
        tlog "wake-guard E126: fóssil E24 do /etc/udev aposentado (.elite-fossil) — a regra v2 do pacote (/usr/lib/…/91-*) reina; udevd relê no próximo evento"
        udevadm control --reload 2>/dev/null || true
    fi
fi
tlog "wake-guard observado: ${armadas} fonte(s) ACPI armada(s) em /proc/acpi/wakeup (política E122: teclado acorda · mouse dorme)"

# ── 3. A VIGÍLIA DO SYSCTL DA CASA (E101) — o drift que outro pacote ────
#     impõe por cima (prova do papel: swappiness 150 vs 180, 10/nov).
#     Comparação por chave (o conf da casa é a FONTE; o kernel é o vivo):
#     só chave presente NO CONF é julgada — nada da casa invadiu o alheio.
if [ -r "$ELITE_SYSCTL" ]; then
    drift=""
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        key="${line%%=*}"; val="${line#*=}"
        key="$(printf '%s' "$key" | awk '{$1=$1;print}')"
        val="$(printf '%s' "$val" | awk '{$1=$1;print}')"
        [ -n "$key" ] || continue
        cur="$(sysctl -n "$key" 2>/dev/null || true)"
        if [ -n "$cur" ] && [ "$cur" != "$val" ]; then
            drift="$drift $key($cur≠$val)"
        fi
    done < "$ELITE_SYSCTL"
    if [ -n "$drift" ]; then
        tlog "sysctl da casa com drift:${drift} — re-aplicando ${ELITE_SYSCTL} (o tuning vale no -Syu, não só no boot)"
        # E110 — A FALHA NOMEADA (família E108: o stderr engolido era o
        # porquê que o papel não dizia — o rig do dono fotografou 'FALHOU'
        # SEIS vezes em três dias SEM UMA prova do porquê). O rc e
        # o stderr da re-aplicação entram NO PAPEL.
        # E113 — O RC=127 RECEBE NOME E MORRE: o dump 170720 fotografou a
        # cura inteira do E110 — 'linha 97: systemd-sysctl: comando não
        # encontrado' em TODA execução desde 11-15 (o réu: systemd-sysctl
        # NÃO é comando de PATH — o binário é /usr/lib/systemd/systemd-
        # sysctl; o E110 nomeou o porquê do FALHOU e entregou uma cura que
        # não executa — a família E33 na cura). O padrão da casa que o
        # firstboot provou ('vm.swappiness = 180 confirmado no kernel',
        # elite-tune:790) assume: systemctl restart systemd-sysctl.service
        # — sysctl --system de fallback. E A FÉ MORRE: cada chave que deu
        # drift é RELIDA no kernel depois da cura; o valor VIVO é o
        # veredito, não o rc (o rig nasce em 150 com /etc pedindo 180 e o
        # ator do 150 ainda sem nome — os olhos novos do dump o caçam).
        _sys_rc=0
        _sys_out="$(systemctl restart systemd-sysctl.service 2>&1)" || _sys_rc=$?
        if [ "$_sys_rc" -ne 0 ]; then
            _sys_rc=0
            _sys_out="$(sysctl --system 2>&1)" || _sys_rc=$?
        fi
        _restou=""
        for _pair in $drift; do
            _k="${_pair%%(*}"
            _want="${_pair##*≠}"
            # E117 — O PARÊNTESE QUE IMPEDIA O VEREDITO (dump 163548: o papel
            # imprimia 're-aplicação FALHOU (rc=0 …)' com '(agora:180)' na
            # MESMA linha — o kernel JÁ no alvo e o papel gritando falha;
            # o _pair nasce 'chave(vivo≠alvo)' e o ##*≠ deixava o ')' de
            # fecho no _want ('180)' ≠ '180' — a comparação NUNCA passava,
            # todo drift virava FALHOU para sempre, família E33 na
            # verificação). O ')' morre aqui: o valor vivo é o veredito.
            _want="${_want%)}"
            _now="$(sysctl -n "$_k" 2>/dev/null || true)"
            [ "$_now" = "$_want" ] || _restou="$_restou $_pair(agora:${_now:-?})"
        done
        if [ -z "$_restou" ]; then
            tlog "sysctl: conf da casa re-aplicado e CONFIRMADO no kernel — o veredito é o valor vivo, não o rc"
        else
            tlog "sysctl: re-aplicação FALHOU (rc=$_sys_rc, stderr: $(printf '%s' "$_sys_out" | tail -c 220 | tr '\n' ';')) — drift que RESISTIU:$_restou (o réu segue vivo, a prova fica no papel)"
        fi
        unset _restou _pair _k _want _now
    fi
fi

# ── 4. O FANTASMA NÃO RENASCE (E106) — o calamares.desktop/abif.desktop ──
#     eram ferramentas da SESSÃO LIVE que o pacote embarcava por cima da
#     varredura E98; rigs instalados recebiam o instalador morto de volta
#     em TODA dose (--overwrite applications/*) — a gaveta indexava o
#     "Install Archcraft" sem ícone/sem função (o journal do drawer canta:
#     "Cannot load icon 'calamares'"). O build não os embala mais; ESTE
#     gesto cura os rigs CONTAMINADOS (o arquivo já em disco sai na
#     primeira transação pós-dose). Só fora do live (o live PRECISA dele).
if [ ! -e /run/archiso ]; then
    for dsk in /usr/local/share/applications/calamares.desktop \
               /usr/local/share/applications/abif.desktop; do
        if [ -e "$dsk" ]; then
            rm -f "$dsk" 2>/dev/null || true
            tlog "fantasma da live removido: $dsk (E106 — a gaveta não indexa mais o instalador morto)"
        fi
    done
fi

# ── 5. O JORNAL QUE SOBREVIVE AO REBOOT (E108) — a prova do rig 180302:
#      'journalctl --list-boots' só mostrou O BOOT VIVO (o journal era
#      VOLÁTIL — /var/log/journal não existe) e a perícia cross-boot
#      inteira morria a cada reinício (a caça ao despertar, a dupla senha,
#      o réu do boot anterior: tudo sem memória). Cura: o dir existe →
#      Storage=auto persiste sozinho; o try-restart faz o journald vivo
#      adotar o disco NA HORA (idempotente — o dir só nasce UMA vez).
if [ ! -e /run/archiso ] && [ ! -d /var/log/journal ]; then
    if install -d -m 2755 -o root -g systemd-journal /var/log/journal 2>/dev/null; then
        tlog "jornal do systemd: /var/log/journal criado (era VOLÁTIL — a história cross-boot morria no reboot); try-restart do journald para persistir já"
        systemctl try-restart systemd-journald.service 2>/dev/null || true
    else
        tlog "jornal: FALHOU criar /var/log/journal — o journal segue volátil (réu nomeado no papel)"
    fi
fi

# ── 6. O CONFO DO NAVEGADOR E O EDITOR GRÁFICO VIAJAM (E114) ─────────────
#      O brave-flags.conf era SKEL: rig vivo NUNCA recebia a cura (o réu
#      do vídeo branco do YouTube — a linha Vulkan da era v1.1 — morava
#      no home do dono e nenhuma dose o tocava). O conf da casa viaja no
#      PACOTE (/usr/local/share/elite/chromium-flags/) e este hook o
#      sincroniza ao home de cada usuário real — dono do arquivo é o
#      usuário (o papai root não deixa lixo). Idempotente: só copia
#      quando difere, com linha no papel.
#      E o editor gráfico (mousepad — a adoção da E114): quem não tem
#      associação text/plain ganha a porta moderna do dono ('saindo um
#      pouco desse uso do terminal… trazendo a experiência mais moderna
#      do Linux'); quem JÁ escolheu o seu, fica com o seu (a escolha do
#      dono é intocável).
SRC_FLAGS=/usr/local/share/elite/chromium-flags/brave-flags.conf
SRC_CODEFLAGS=/usr/local/share/elite/chromium-flags/code-flags.conf
if [ ! -e /run/archiso ] && { [ -r "$SRC_FLAGS" ] || [ -r "$SRC_CODEFLAGS" ]; }; then
    while IFS=: read -r _u _p _uid _gid _g _h _s; do
        [ "$_uid" -ge 1000 ] 2>/dev/null || continue
        [ -d "$_h" ] || continue
        _tgt="$_h/.config/brave-flags.conf"
        if ! cmp -s "$SRC_FLAGS" "$_tgt" 2>/dev/null; then
            if install -Dm644 -o "$_uid" -g "$_gid" "$SRC_FLAGS" "$_tgt" 2>/dev/null; then
                tlog "brave-flags: conf da casa sincronizado para $_u (o réu do vídeo branco morre no PRÓXIMO abrir do navegador)"
            else
                tlog "brave-flags: FALHOU sincronizar para $_u (réu nomeado no papel)"
            fi
        fi
        # E134 — O CODE-FLAGS DO VSCODIUM (a ordem do dono 1.0-81: o
        # --password-store=basic nos Electron da casa — zero chaveiro,
        # zero popup; o conf viaja no pacote como o do Brave)
        _ctgt="$_h/.config/code-flags.conf"
        if [ -r "$SRC_CODEFLAGS" ] && ! cmp -s "$SRC_CODEFLAGS" "$_ctgt" 2>/dev/null; then
            if install -Dm644 -o "$_uid" -g "$_gid" "$SRC_CODEFLAGS" "$_ctgt" 2>/dev/null; then
                tlog "code-flags: conf da casa sincronizado para $_u (o password-store basic do E134 — o chaveiro nunca mais é acordado)"
            else
                tlog "code-flags: FALHOU sincronizar para $_u (réu nomeado no papel)"
            fi
        fi
        unset _ctgt
        _mapps="$_h/.config/mimeapps.list"
        if ! grep -q "^text/plain=" "$_mapps" 2>/dev/null; then
            mkdir -p "${_mapps%/*}" 2>/dev/null || true
            if grep -q "^\[Default Applications\]" "$_mapps" 2>/dev/null; then
                sed -i "/^\[Default Applications\]/a text/plain=mousepad.desktop" "$_mapps" 2>/dev/null || true
            else
                printf '[Default Applications]\ntext/plain=mousepad.desktop\n' >> "$_mapps" 2>/dev/null || true
            fi
            chown "$_uid:$_gid" "$_mapps" 2>/dev/null || true
            grep -q "^text/plain=" "$_mapps" 2>/dev/null && \
                tlog "mimeapps: text/plain → mousepad para $_u (o editor gráfico da casa — o rig não tinha associação)"
        fi
        unset _tgt _mapps
    done < /etc/passwd
fi

# ── 7. O STAMP DA TELA MORRE COM A DOSE (E115) ──────────────────────────
#      O apply do craft-display com falha dorme no teto E106 (fail:6 —
#      silêncio honesto até o reboot). O rig do dump 224713 passou o boot
#      TODO no fail:6: o --scale-exact da era velha falhou 6× no arranque
#      e a tela foi para o modo errado até o dono abrir o wdisplays na
#      mão. A cura que chega POR DOSE (a E113: o probe da bandeira) ficava
#      presa atrás do stamp velho — a promessa valia só no reinício.
#      Cura: o hook apaga o stamp fail:* de cada usuário vivo — o
#      heartbeat do craft-bars re-aplica com o binário NOVO em ≤5s, SEM
#      reboot (o stamp ok NUNCA é tocado: arranjo assentado é fé; e o
#      conf salvo é a fonte da verdade — o apply restaurando o que o dono
#      escolheu, nunca o default do boot).
for _d in /run/user/[0-9]*; do
    [ -d "$_d/elite" ] || continue
    _st="$_d/elite/display-applied"
    if [ -f "$_st" ] && grep -q '^fail:' "$_st" 2>/dev/null; then
        rm -f "$_st" 2>/dev/null || true
        tlog "display: stamp fail apagado (uid ${_d##*/user/}) — o craft-display NOVO re-aplica o conf salvo no próximo heartbeat (≤5s), sem reboot"
    fi
    unset _st
done

# ── 8. O SEGUNDO TRONO DO SWAYNC MORRE (E117 — um trono só, E58) ────────
#      O journal do dump 163548 fotografa CINCO 'Failed to start Swaync
#      notification daemon' a CADA boot (15:11:31–33, 4s após o boot —
#      a unit de usuário do pacote sobe ANTES da sessão existir, falha
#      sem display e o systemd repete). O swaync VIVO é filho do
#      craft-bars (o supervisor da casa, que sobe com a sessão e carrega
#      o config do usuário — o ps do mesmo dump crava). Dois tronos para
#      um daemon é a doença que a E58 abomina — e as cinco linhas
#      vermelhas por boot são ruído que a perícia leria como defeito.
#      Cura: a unit de usuário é MASCARADA globalmente (o auto-start e
#      a ativação dbus morrem; o arquivo vive em /etc/systemd/user/ —
#      fora do pacote, sobrevive a doses, reversível com unmask).
_mask="/etc/systemd/user/swaync.service"
if [ ! -e /run/archiso ] && command -v systemctl >/dev/null 2>&1; then
    if [ -e "$_mask" ] && [ "$(readlink -f "$_mask" 2>/dev/null)" = "/dev/null" ]; then
        :   # já mascarado por uma dose anterior — silêncio (o papel não repete história)
    elif systemctl --global mask swaync.service >/dev/null 2>&1; then
        tlog "swaync: unit de usuário MASCARADA (E117) — o segundo trono morre; o swaync vivo é o do craft-bars (o journal deixa de nascer vermelho a cada boot)"
    else
        tlog "swaync: FALHOU mascarar a unit de usuário (réu nomeado no papel)"
    fi
fi
unset _mask

# ── 8-b. A CHAVE MORTA DO SWAYNC SAI DOS RIGS (E135) ─────────────────────
#      O dump 101339 crava: o config.json do home carrega
#      "image-visibility" — chave que o swaync 0.12.6 NÃO deserializa
#      (Json-WARNING a cada arranque) e o skel da casa já nasce sem ela.
#      A cura percorre os homes vivos e apaga SÓ a linha morta (JSON de
#      uma linha por chave — o sed honesto; o idempotente é não tocar o
#      arquivo que não tem a chave).
for _h in /home/*; do
    _swc="$_h/.config/swaync/config.json"
    if [ -f "$_swc" ] && grep -q '"image-visibility"' "$_swc" 2>/dev/null; then
        if sed -i '/"image-visibility"/d' "$_swc"; then
            chown --reference="${_h}" "$_swc" 2>/dev/null || true
            tlog "swaync: chave morta 'image-visibility' REMOVIDA de $_swc (E135 — o Json-WARNING morre; o default do swaync é o when-available)"
        else
            tlog "swaync: FALHOU apagar a chave 'image-visibility' em $_swc (réu nomeado)"
        fi
    fi
done
unset _h _swc

# ── 9. O TEMA DE ÍCONES É UM SÓ (E130 — a ordem do dono 2026-11-21) ────
#      "Garanta Papirus-Dark nos settings.ini GTK dos usuários ativos e o
#      qt6ct sincronizado." O E126 entregou o tema NO SKEL (veículo da
#      ISO) e o rig vivo ficava na babel hicolor/Adwaita — a ferida fecha
#      POR DOSE agora: a linha gtk-icon-theme-name é garantida nos DOIS
#      settings (GTK3 e GTK4) e o icon_theme do qt6ct.conf acompanha. A
#      casa sincroniza SÓ a linha de ícones — o resto do arquivo do dono
#      é intocável (a lei do domínio v3; a pele INTEIRA viaja pelo
#      craft-rice com marcador/fóssil — o post_upgrade chama).
SRC_QTC=/usr/local/share/elite/qt6ct/qt6ct.conf
if [ ! -e /run/archiso ]; then
    while IFS=: read -r _u _p _uid _gid _g _h _s; do
        [ "$_uid" -ge 1000 ] 2>/dev/null || continue
        [ -d "$_h" ] || continue
        for _ini in "$_h/.config/gtk-3.0/settings.ini" "$_h/.config/gtk-4.0/settings.ini"; do
            if [ -f "$_ini" ]; then
                if grep -q '^gtk-icon-theme-name=' "$_ini" 2>/dev/null; then
                    if ! grep -q '^gtk-icon-theme-name=Papirus-Dark$' "$_ini" 2>/dev/null; then
                        sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=Papirus-Dark/' "$_ini" 2>/dev/null || continue
                        chown "$_uid:$_gid" "$_ini" 2>/dev/null || true
                        tlog "icons: gtk-icon-theme-name → Papirus-Dark em $_u ($_ini — a ordem do dono E130; o resto do arquivo dele segue intocado)"
                    fi
                else
                    printf 'gtk-icon-theme-name=Papirus-Dark\n' >> "$_ini" 2>/dev/null || continue
                    chown "$_uid:$_gid" "$_ini" 2>/dev/null || true
                    tlog "icons: gtk-icon-theme-name ACRESCENTADA (Papirus-Dark) em $_u ($_ini não tinha a linha — a babel morre)"
                fi
            fi
        done
        # o Qt acompanha: qt6ct.conf vivo com ícone diferente da casa = cura
        if [ -f "$_h/.config/qt6ct/qt6ct.conf" ] && [ -r "$SRC_QTC" ]; then
            if grep -q '^icon_theme=' "$_h/.config/qt6ct/qt6ct.conf" 2>/dev/null; then
                if ! grep -q '^icon_theme=Papirus-Dark$' "$_h/.config/qt6ct/qt6ct.conf" 2>/dev/null; then
                    sed -i 's/^icon_theme=.*/icon_theme=Papirus-Dark/' "$_h/.config/qt6ct/qt6ct.conf" 2>/dev/null || true
                    chown "$_uid:$_gid" "$_h/.config/qt6ct/qt6ct.conf" 2>/dev/null || true
                    tlog "icons: icon_theme do qt6ct → Papirus-Dark em $_u (o Qt veste a mesma família do GTK)"
                fi
            fi
        fi
        unset _ini
    done < /etc/passwd
fi

# ── 10. O OKULAR FLATPAK NÃO RENASCE (E130 — a ordem do dono: apenas
#       GNOME Papers nativo mora na casa como leitor único de PDFs) ────
#      A cura E128 rodava SÓ na porta do craft-update (--sistema) e no
#      post_upgrade; um rig que não atualiza segue com o Okular Qt inteiro
#      (runtime ~1 GB no disco) até a próxima dose. ESTE hook roda em TODA
#      transação: o uninstall idempotente + o --unused dos runtimes órfãos
#      (o Qt do Flathub inteiro quando o okular era o único app Qt). O
#      papers (pacote nativo, packages.add) é o leitor da casa.
if [ ! -e /run/archiso ] && command -v flatpak >/dev/null 2>&1; then
    if flatpak info --system org.kde.okular >/dev/null 2>&1; then
        if flatpak uninstall --system --noninteractive org.kde.okular >/dev/null 2>&1; then
            tlog "flatpak: org.kde.okular REMOVIDO na transação (E130 — Papers nativo é o leitor único da casa)"
        else
            tlog "flatpak: okular não saiu nesta transação (best-effort — a próxima re-tenta)"
        fi
        flatpak uninstall --system --noninteractive --unused >/dev/null 2>&1 \
            && tlog "flatpak: --unused varreu os runtimes órfãos do okular (higiene de disco)"
    fi
fi

# ── 11. O GAMEMODE.INI DA CASA REESCRITO (E132 — a ordem do dono: a     ────
#       GPU high da RX 7600 NUNCA subiu). O dump pós-1.0-78 provou no log
#       do rig: 'gamemoded: ERROR: apply_gpu_optimisations set to value
#       other than "accept-responsibility" (accept-residual)' — o valor
#       'accept-residual' era invenção da casa (o parser do Feral só
#       conhece "accept-responsibility") e o gamemoded RECUSAVA o bloco
#       [gpu] INTEIRO em toda sessão de jogo. O pacote entrega o mestre
#       novo; ESTE gesto cura o rig vivo com o arquivo de dono ANTIGO em
#       toda transação (idempotente: valor já certo = silêncio).
if [ -f /etc/gamemode.ini ]; then
    if grep -q '^apply_gpu_optimisations=' /etc/gamemode.ini 2>/dev/null \
       && ! grep -q '^apply_gpu_optimisations=accept-responsibility$' /etc/gamemode.ini 2>/dev/null; then
        if sed -i 's/^apply_gpu_optimisations=.*/apply_gpu_optimisations=accept-responsibility/' /etc/gamemode.ini 2>/dev/null; then
            tlog "gamemode: apply_gpu_optimisations → accept-responsibility (o 'accept-residual' da era velha RECUSADO pelo gamemoded — a GPU high sobe na próxima sessão de jogo)"
        else
            tlog "gamemode: FALHOU reescrever apply_gpu_optimisations (réu nomeado no papel)"
        fi
    fi
    # o nível da AMD acompanha (linha ausente no fóssil velho = nasce)
    if ! grep -q '^amd_performance_level=high$' /etc/gamemode.ini 2>/dev/null; then
        printf 'amd_performance_level=high\n' >> /etc/gamemode.ini 2>/dev/null \
            && tlog "gamemode: amd_performance_level=high ACRESCENTADA (o fóssil não tinha a linha)"
    fi
fi

exit 0
