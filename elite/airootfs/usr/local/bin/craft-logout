#!/usr/bin/env bash
# craft-logout — menu de sessão (craft-menu nativo; Esc cancela)
# opções: lock · logout (labwc) · reboot · shutdown
#
# v2.3.8 — a era do menu NATIVO (o dono: "remover a barra que fica, tipo
# 'Rede |'"): craft-menu — título centrado, itens centrados, zero linha
# de digitação. A lei (toggle/cross-dismiss) é estrutural no craft-menu.
#
# v2.3.1 — FIM DO SILÊNCIO (família craft-*): crash calado nunca mais —
# log em ~/.cache/elite/menus.log + notify na tela (padrão dos menus).
set -euo pipefail

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

command -v craft-menu >/dev/null 2>&1 || { mlog "Logout: craft-menu AUSENTE"; exit 1; }

mlog "Logout: abrindo (craft-menu)"
errf="$(mktemp)"
trap 'rm -f "$errf"' EXIT
ec=0
choice="$(craft-menu --title='Sair' \
    'Travar tela' 'Sair da sessão' 'Reiniciar' 'Desligar' \
    2>"$errf")" || ec=$?
if [ "$ec" -eq 143 ]; then
    mlog "Logout: fechado de fora (SIGTERM — cross-dismiss) — benigno"
    exit 0
fi
if [ "$ec" -eq 2 ]; then
    mlog "Logout: toggle — 2ª chamada fechou o menu — benigno"
    exit 0
fi
if [ "$ec" -eq 1 ]; then
    # v2.3.10 — fechar NUNCA é erro, COM OU SEM stderr (o gate velho
    # '! -s "$errf"' gritava FALHOU em fechamento normal — a pilha de
    # notificações eternas da foto do dono). stderr vai pro log.
    if [ -s "$errf" ]; then
        mlog "Logout: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
    else
        mlog "Logout: fechado pelo usuário (ESC) — benigno"
    fi
    exit 0
fi
if [ "$ec" -ne 0 ]; then
    mlog "Logout: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
    # v2.3.10 — falha REAL avisa e SOME (-u normal + timeout 5).
    command -v notify-send >/dev/null 2>&1 && \
        timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
            'Menu de sessão falhou' \
            "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    exit 1
fi
[ -n "$choice" ] || exit 0
case "$choice" in
  'Travar tela')
    if command -v hyprlock >/dev/null 2>&1; then exec hyprlock
    elif command -v loginctl >/dev/null 2>&1; then exec loginctl lock-session
    fi ;;
  'Sair da sessão')
    if command -v labwc >/dev/null 2>&1; then exec labwc --exit; fi
    echo "labwc não encontrado (não é uma sessão labwc?)" >&2 ;;
  'Reiniciar')  exec systemctl reboot ;;
  'Desligar')   exec systemctl poweroff ;;
  *) exit 0 ;;
esac
