#!/bin/sh
# craft-logout — WRAPPER do craft-power (ARQUITETURA nº 9 — o polimento E65,
# a promessa do diário desde 11-02: "craft-logout vira wrapper do
# craft-power, −80 linhas de duplicação").
#
# ATÉ AQUI eram DOIS menus de sessão com a MESMA mecânica copiada duas
# vezes (mlog, gramática 0/1/143, cinta de falha) e conteúdos divergentes:
# o teclado (W-x / W-Escape / C-A-Delete no rc.xml) abria 3 itens SEM
# Suspender; o mouse (botão do power) abria o Sessão completo.
#
# DE AGORA EM DIANTE o menu de sessão é UM. O teclado herda o Sessão
# inteiro — 'Suspender' (gate logind/kernel, o lock primeiro, o -i da
# v2.6.0) e 'Tempo de idle…' passam a valer para quem usa teclado — e a
# mecânica inteira mora no craft-power (log, gramática, cinta v2.9.0).
# Copiar qualquer coisa aqui de novo é reabrir a duplicação que o nº 9
# aposentou.
set -eu

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
uso() {
    printf '%s\n' \
        'uso: craft-logout — o menu Sessão (wrapper do craft-power — UM menu,' \
        '     sem duplicação: ARQUITETURA nº 9)' \
        '' \
        '  atalhos: W-x · W-Escape · C-A-Delete. O teclado herda Suspender e' \
        '  Tempo de idle do mesmo menu.'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

command -v craft-power >/dev/null 2>&1 || {
    echo "craft-logout: craft-power AUSENTE — o menu de sessão mora lá (pacote elite-system); nada aberto" >&2
    exit 127
}
exec craft-power "$@"
