import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import warnings

import gi

# v2.10.8 — bars.log LIMPO: o PyGObject marca Gio.DesktopAppInfo e
# GLib.unix_signal_add como deprecados (o sucessor GioUnix/GLibUnix só
# existe em gi recentes; trocar o tipo sob os pés do scan/isinstance
# por uma classe irmã de outro namespace era risco sem recompensa).
# O warning caía 4× por sessão no bars.log do rig (dump d33o) e sujava
# a evidência da supervisão — filtrado na FONTE, comportamento intacto.
try:
    from gi import PyGIDeprecationWarning
    warnings.filterwarnings("ignore", category=PyGIDeprecationWarning)
except ImportError:
    pass

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GLib, Gio, Gtk, Gdk, GtkLayerShell, Pango  # noqa: E402

PINS_FILE = os.path.join(
    GLib.get_user_config_dir(), "elite", "dock-pins"
)
CSS_FILE = os.path.join(GLib.get_user_config_dir(), "elite", "dock.css")
LOG = os.path.join(GLib.get_user_cache_dir(), "elite", "dock.log")

ICON_SIZE = 36   # spec M3.2: escala fixa de fábrica
# v2.3.4 — o float da pílula mora DENTRO da superfície (margem GTK no
# widget, não margem layer-shell): a zona exclusiva cobre pílula + vão —
# a janela maximizada nunca invade nem o vão transparente.
PILL_FLOAT = 6

WLRCTL = shutil.which("wlrctl")  # foco/fecho de janela (wlr-foreign-toplevel)

# v2.10.1 — JANELAS REAIS: o craft-toplevel (pacote próprio, fonte em
# vendor/craft-toplevel.c) fala o protocolo zwlr_foreign_toplevel DIRETO
# com o labwc e serve a sessão neste socket, linha a linha. É o que dá ao
# clique o id EXATO da janela (foco/restauro/ciclo/fecho sem adivinhar
# capitalização) e o anel MRU do alt-tab para os verbos da pílula
# (v2.10.8: o comutador clicável saiu — o anel ficou para o ciclo
# dentro do botão do app).
TOPOS = os.path.join(GLib.get_user_runtime_dir(), "elite", "toplevel.sock")
F_ACTIVATED = 4   # flag do daemon (state activated do protocolo)
F_MINIMIZED = 2   # (1=maximized · 2=minimized · 4=activated · 8=fullscreen)

# v2.10.3 — o comutador tem ÍCONE FIXO (o veredito do dono: "o ícone fica
def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        try:
            # teto de 1 MiB (mesma política do bars.log — evidência recente vale mais)
            if os.path.getsize(LOG) > 1_048_576:
                os.truncate(LOG, 0)
        except OSError:
            pass
        with open(LOG, "a") as fh:
            fh.write(msg + "\n")
    except OSError:
        pass


def case_variants(c):
    """v2.10: as 3 formas canônicas de um candidato — o match do wlrctl é
    exato e o bridge X11 do wlroots expõe a WM_CLASS COM a capitalização do
    app ("Brave-browser"): enviar só o minúsculo é adivinhar errado de
    fábrica. Dedup preservando a ordem."""
    seen = set()
    out = []
    for v in (c, (c or "").lower(), (c or "").title()):
        if v and v not in seen:
            seen.add(v)
            out.append(v)
    return out


def _near_match(a, c):
    """v2.10.6 — contenção ≥4 chars COM FRONTEIRA (a lei v2.10.3 apertada):
    'brave' ⊂ 'brave-browser' casa (o '-' é fronteira — o Brave continua
    visto), mas 'foot' ⊂ 'footclient' NÃO casa mais (letra colada = outro
    app). A Rodada 2 da auditoria provou o custo do falso positivo: o MEIO
    no pin do foot encerrava janelas do footclient (e o fallback wlrctl,
    que casa por strcmp exato, mudava de mão e abria outro). Fronteira = o
    caractere colado na ocorrência não é letra/número; vale nos DOIS
    sentidos como antes."""
    if len(c) < 4 or len(a) < 4:
        return False
    for x, y in ((c, a), (a, c)):
        i = y.find(x)
        while i != -1:
            before = y[i - 1] if i > 0 else ""
            after = y[i + len(x)] if i + len(x) < len(y) else ""
            if not before.isalnum() and not after.isalnum():
                return True
            i = y.find(x, i + 1)
    return False


def read_pins():
    """Lê o arquivo de pins → lista de (DesktopAppInfo, app_id_hint).

    v2.7.0: a linha pode ter uma 2ª coluna — o app_id EXPLÍCITO para o
    foco (wlrctl) quando o app se apresenta com um id que nem o
    StartupWMClass nem o binário adivinham (ex. GTK: 'thunar.desktop
    org.xfce.Thunar'). A 1ª coluna continua sendo o ID do .desktop.
    """
    pins = []
    try:
        with open(PINS_FILE) as fh:
            for line in fh:
                parts = line.strip().split()
                if not parts or parts[0].startswith("#"):
                    continue
                appid = parts[0]
                hint = parts[1] if len(parts) > 1 else ""
                # v2.1.1 (run #93): o PyGObject LANÇA TypeError ("constructor
                # returned NULL") em construtor não-nullable — o None JAMAIS
                # chega ao `if info is None`. Pin inválido é ignorado com log;
                # um pin ruim NUNCA derruba a dock (na #93 o 'brave.desktop'
                # inexistente crash-loopou 15× e derrubou o verify).
                try:
                    info = Gio.DesktopAppInfo.new(appid)
                except TypeError:
                    info = None
                if info is None:
                    log(f"pin ignorado (desktop inexistente): {appid}")
                    continue
                pins.append((info, hint))
    except (OSError, UnicodeDecodeError) as exc:
        # v2.5.0 — era só FileNotFoundError: PermissionError/UnicodeDecode
        # no dock-pins subiam pela callback do SIGUSR2, o PyGObject
        # removia a source do sinal e a dock ficava SURDA (mesmo efeito
        # do return False — o audit 24-c flagrou). Pin/arquivo ruim =
        # log + ignora; a dock segue viva e OUVINDO.
        log(f"arquivo de pins ilegível ({type(exc).__name__}): {PINS_FILE}")
    return pins


def exec_of(info):
    """Commandline do .desktop sem os códigos de campo (%f %U …)."""
    raw = info.get_commandline() or ""
    raw = re.sub(r"\s%[a-zA-Z]", "", raw).strip()
    return raw


def binary_of(info):
    """Primeiro binário do commandline do .desktop."""
    raw = exec_of(info)
    if not raw:
        return ""
    try:
        first = shlex.split(raw)[0]
    except ValueError:
        first = raw.split()[0] if raw.split() else ""
    return os.path.basename(first)


class Dock:
    def __init__(self):
        self.shown = True  # v2.3.4: nasce visível e fica — esconder é escolha (W-S-d)
        self.buttons = []  # pins: (button, binary)
        self.running = set()      # comms vivos do usuário (o poll alimenta)
        self.pin_ids = set()      # desktop-ids fixados (dedup dos dinâmicos)
        self.dyn = {}             # dinâmicos: did → (button, comm, info, cmd)
        self.sep = None           # fio vertical pins | dinâmicos
        self._dindex = None       # cache: chave lower → DesktopAppInfo

        # v2.10.1 — janelas REAIS (o protocolo direto via craft-toplevel):
        # snapshot por tick (LIST), conexão persistente (zero fork) —
        # alimenta os indicadores e os verbos da pílula. v2.10.8: o
        # comutador e o MENU saíram; o snapshot fica (indicadores
        # honestos, foco/ciclo/fecho por janela real).
        self._sock = None          # conexão com o daemon (persistente)
        self.windows = {}          # id → (flags, rank, app_id, title)
        self.focused = 0           # id da janela focada (0 = nenhuma)
        self._last_act = {}        # app → última janela que NÓS focamos
        self.tl_alive = False      # o daemon falou no último tick?
        self._children = []        # Popen rastreados (a ceifa dos zumbis)

        self.win = Gtk.Window()
        self.win.set_name("dockwindow")
        GtkLayerShell.init_for_window(self.win)
        # layer BOTTOM — o coração do v2.3.4: janelas normais ficam ACIMA da
        # camada background/bottom (a dock não as cobre), e a tela cheia de
        # qualquer app cobre a dock. O "esconder em tela cheia" é a ordem de
        # renderização do protocolo — não existe código para falhar.
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.BOTTOM)
        # Ancorada SÓ na base: a layer-shell centra no eixo não-ancorado —
        # a superfície TEM o tamanho da pílula (nada de faixa invisível
        # full-width comendo clique ao lado dela).
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.BOTTOM, True)
        # Zona exclusiva automática: maximizadas/tileadas respeitam a faixa
        # da dock ("como funciona as outras distros" — diretriz do dono).
        GtkLayerShell.auto_exclusive_zone_enable(self.win)

        self.pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.pill.set_name("dockbox")
        self.pill.set_margin_bottom(PILL_FLOAT)

        # v2.10.8 — a superfície É SÓ a pílula de novo (o menubox da
        # v2.10.3 saiu da árvore inteira — o que não existe não falha).
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.root.pack_start(self.pill, False, False, 0)
        self.win.add(self.root)

        self.rebuild()

        self.load_css()
        self.win.show_all()
        log(f"dock iniciada: {len(self.buttons)} pin(s) · "
            f"sempre visível (layer BOTTOM — some só sob tela cheia/gaveta) · "
            f"dinâmicos ON (apps abertos sem pin aparecem após o fio) · "
            f"comutador/menu EXTINTOS (v2.10.8 — ordem do dono)")

        GLib.timeout_add(3000, self.poll_running)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             self.toggle)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                             self.rebuild)
        # v2.9.0 — SEM superfície auxiliar, SEM pid-file, SEM telefone:
        # a dock não recebe pedidos de ninguém. O dismiss de menu é lei do
        # rc.xml (craft-menu-dismiss) — a dock nem fica sabendo que um
        # menu abriu.

    # ── CSS ──────────────────────────────────────────────────────────────
    def load_css(self):
        css = b""
        try:
            with open(CSS_FILE, "rb") as fh:
                css = fh.read()
        except FileNotFoundError:
            log(f"CSS ausente ({CSS_FILE}) — usando fallback embutido")
            css = DEFAULT_CSS
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except GLib.Error as exc:
            log(f"CSS inválido — o fallback embutido entra no lugar: {exc}")
            prov = Gtk.CssProvider()
            prov.load_from_data(DEFAULT_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # ── índice de .desktops (v2.10 — para os dinâmicos) ─────────────────
    def _desktop_index(self):
        """Cache: chave lower → DesktopAppInfo. Uma varredura por sessão
        (Gio.AppInfo.get_all), casando StartupWMClass e o binário do
        commandline. NoDisplay/Hidden NUNCA entram (a gaveta limpa do E21 é
        a mesma lei aqui: xarchiver/papers/nm-connection-editor rodando não
        viram botão — são helpers, não apps de dock)."""
        if self._dindex is None:
            idx = {}
            try:
                apps = Gio.AppInfo.get_all()
            except Exception as exc:  # noqa: BLE001 — index vazio ≠ dock morta
                log(f"get_all falhou ({type(exc).__name__}) — sem dinâmicos")
                apps = []
            for app in apps:
                if not isinstance(app, Gio.DesktopAppInfo):
                    continue
                try:
                    if app.get_nodisplay() or app.get_is_hidden():
                        continue
                except Exception:  # noqa: BLE001 — .desktop exótico não derruba
                    continue
                did = app.get_id() or ""
                if not did:
                    continue
                try:
                    wmc = app.get_string("StartupWMClass") or ""
                except Exception:  # noqa: BLE001
                    wmc = ""
                b = binary_of(app)
                for k in dict.fromkeys(x for x in (wmc.lower(), b.lower()) if x):
                    idx.setdefault(k, app)
            self._dindex = idx
            log(f"índice de .desktops: {len(idx)} chave(s) resolvíveis")
        return self._dindex

    def _resolve_desktop(self, comm):
        """comm do /proc → DesktopAppInfo do app (ou None: não é 'programa'
        no sentido da dock — daemons/shells sem .desktop não viram botão).
        v2.10.6 — o casamento da era v2.10.3 chega AQUI: exato → stem →
        contenção com fronteira. O comm do Brave é 'brave' e as chaves do
        índice são 'brave-browser'/'brave-browser-stable' — o exato puro
        deixava o app rodando SEM botão dinâmico (a lei da auto-adaptação
        falhava no app mais comum do desktop)."""
        c = (comm or "").lower()
        if not c:
            return None
        idx = self._desktop_index()
        info = idx.get(c)
        if info is not None:
            return info
        info = idx.get(c.rsplit(".", 1)[-1])   # stem: org.xfce.Thunar → thunar
        if info is not None:
            return info
        for k, app in idx.items():             # contenção com fronteira (≥4)
            if _near_match(c, k):
                return app
        return None

    # ── pins ─────────────────────────────────────────────────────────────
    def rebuild(self, *_):
        for child in self.pill.get_children():
            self.pill.remove(child)
        self.buttons = []
        self.dyn = {}
        self.sep = None
        self.pin_ids = set()
        for info, hint in read_pins():
            btn = self._make_button(info, hint, dynamic=False)
            self.pill.pack_start(btn, False, False, 0)
            self.buttons.append((btn, binary_of(info), info, hint,
                                 info.get_id() or ""))
            did = info.get_id() or ""
            if did:
                self.pin_ids.add(did)
        self.pill.show_all()
        self.poll_running()
        # v2.5.0 — GLib.SOURCE_CONTINUE: callback de sinal que retorna False
        # é G_SOURCE_REMOVE — a source morria na 1ª dispatch e a dock
        # ficava SURDA (reload de pins e W-S-d mortos pelo resto da
        # sessão; o audit 24-c flagrou o mecanismo exato).
        return GLib.SOURCE_CONTINUE

    def _make_button(self, info, hint, dynamic=False):
        btn = Gtk.Button.new()
        btn.set_relief(Gtk.ReliefStyle.NONE)
        icon = info.get_icon()
        img = Gtk.Image()
        if icon is not None:
            img.set_from_gicon(icon, Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name("application-x-executable",
                                   Gtk.IconSize.DIALOG)
        img.set_pixel_size(ICON_SIZE)
        btn.add(img)
        # o tooltip ENSINA os verbos (a descoberta não mora escondida —
        # mesma gramática dos tooltips da topbar)
        name = info.get_display_name() or ""
        did = info.get_id() or ""
        cmd = exec_of(info)
        if dynamic:
            btn.set_tooltip_text(
                f"{name} — esquerdo: focar/abrir · direito: fixar na dock · "
                f"meio: encerrar programa")
        elif WLRCTL:
            btn.set_tooltip_text(
                f"{name} — esquerdo: focar/abrir · direito: nova janela · "
                f"meio: encerrar programa")
        else:
            btn.set_tooltip_text(f"{name} — clique: abrir")
        if cmd:
            # button-press-event distingue ESQUERDO/DIREITO/MEIO; o return
            # True consome o evento (o "clicked" não refira — zero duplo
            # lançamento); o "clicked" segue ligado para teclado.
            btn.connect("button-press-event", self._press,
                        info, hint, did, cmd, dynamic)
            btn.connect("clicked", self._clicked, info, hint, did, cmd)
        btn.set_name("dockbtn")
        return btn

    # ── o protocolo direto (v2.10.1 — craft-toplevel, linha a linha) ────
    def _tl_connect(self):
        """Conexão PERSISTENTE com o daemon: aberta uma vez, serve N ticks
        sem fork nenhum (a varredura /proc dos indicadores continua à parte).
        Morreu? reconnecta no próximo tick — a dock NUNCA depende dele."""
        if self._sock is not None:
            return self._sock
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(1)
            s.connect(TOPOS)
        except OSError:
            try:
                s.close()
            except OSError:
                pass
            return None
        self._sock = s
        log("craft-toplevel: conectado (janelas reais ON)")
        return s

    def _tl_close(self):
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None

    def _tl_cmd(self, cmd):
        """Um pedido linha-a-linha; resposta = linhas até OK*/ERR* (e PONG).
        Daemon morto/EPIPE → None — e TODO devolvedor de None tem fallback
        v2.10 logo atrás (wlrctl/launch): a cura nunca quebra o básico."""
        s = self._tl_connect()
        if s is None:
            return None
        try:
            s.sendall((cmd + "\n").encode())
            buf = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    raise OSError("daemon fechou")
                buf += chunk
                lines = buf.split(b"\n")
                if lines[-1] != b"":
                    continue  # resposta parcial — LIST grande segue chegando
                out = [l.decode("utf-8", "replace") for l in lines[:-1]]
                if out and (out[-1].startswith(("OK", "ERR", "PONG"))):
                    return out
        except (OSError, UnicodeDecodeError):
            self._tl_close()
            return None

    def _tl_list(self):
        """LIST → ({id: (flags, rank, app_id, title)}, focused_id) ou None.
        rank = recência do daemon (0 = topo do MRU — a semântica do alt-tab)."""
        out = self._tl_cmd("LIST")
        if out is None:
            return None
        wins = {}
        focused = 0
        for line in out:
            if line.startswith("W|"):
                parts = line.split("|", 5)
                if len(parts) == 6:
                    try:
                        wid, flags, rank = (int(parts[1]), int(parts[2]),
                                            int(parts[3]))
                    except ValueError:
                        continue
                    wins[wid] = (flags, rank, parts[4], parts[5])
            elif line.startswith("OK|"):
                try:
                    focused = int(line[3:])
                except ValueError:
                    focused = 0
        return (wins, focused)

    def _tl_act(self, wid):
        """Foco/restauro POR ID: unset_minimized + activate no daemon — a
        restauração de minimizada é COMANDO DO PROTOCOLO, não hipótese."""
        out = self._tl_cmd(f"ACT {wid}")
        return bool(out) and out[-1].startswith("OK")

    def _tl_close_win(self, wid):
        out = self._tl_cmd(f"CLOSE {wid}")
        return bool(out) and out[-1].startswith("OK")

    def _windows_of(self, info, hint, did):
        """Janelas REAIS do app no snapshot: app_id casa os candidatos
        (case-insensitive — o fim da adivinhação de capitalização do
        wlrctl) ou o título contém o nome de exibição (último recurso)."""
        cands = {c.lower() for c in self._focus_candidates(info, hint, did)}
        name = (info.get_display_name() or "").strip().lower()
        out = []
        for wid, (_fl, _rk, app_id, title) in self.windows.items():
            a = (app_id or "").lower()
            t = (title or "").lower()
            # v2.10.3 — o app_id COMPOSTO entra no casamento: o stem depois
            # do último ponto ("org.xfce.Thunar" → "thunar") e a contenção
            # nos dois sentidos (candidato ≥4 chars) — janelas que o match
            # antigo não via deixavam o fecho e o intercâmbio cegos.
            # v2.10.6 — a contenção ganhou FRONTEIRA (_near_match): sem ela
            # o pin do foot enxergava (e o MEIO encerrava) janelas do
            # footclient — falso positivo com custo real no fecho.
            stem = a.rsplit(".", 1)[-1] if a else ""
            near = any(_near_match(a, c) for c in cands)
            if (a in cands or (stem and stem in cands) or near
                    or (name and name in t)):
                out.append(wid)
        return sorted(out)

    def _app_cycle_next(self, wids, key):
        """A próxima janela DO APP depois da última que NÓS focamos (ring por
        id); sem memória, a focada de verdade; sem focada, a mais recente
        (menor rank = topo do MRU do daemon)."""
        last = self._last_act.get(key)
        if last in wids:
            i = wids.index(last)
            return wids[(i + 1) % len(wids)]
        fw = [w for w in wids if self.windows[w][0] & F_ACTIVATED]
        if fw:
            return fw[0]
        return min(wids, key=lambda w: self.windows[w][1])

    # ── os VERBOS do clique (v2.7 + v2.10 + v2.10.1) ─────────────────────
    def _press(self, btn, ev, info, hint, did, cmd, dynamic=False):
        if ev.button == 3:
            if dynamic:
                self._pin_add(did)                  # direito no dinâmico: FIXAR
            else:
                self._launch(btn, cmd)              # direito no pin: OUTRA instância
            return True                              # consumido — sem "clicked"
        if ev.button == 2:
            # v2.10.3 — o meio ENCERRA O PROGRAMA: TODAS as janelas do app
            # recebem o WM_DELETE gracioso (o dono: "clico na tarefa e ela
            # não encerra"). Sem daemon, o wlrctl da v2.10 assume.
            if self.tl_alive:
                wids = self._windows_of(info, hint, did)
                if wids and self._close_app_windows(wids):
                    return True
            if WLRCTL:
                self._close_windows(info, hint, did)  # meio: fechar (gracioso)
                return True
            return False
        if ev.button == 1:
            self._focus_or_launch(info, hint, did, cmd)  # esquerdo
            return True
        return False  # outros: GtkButton decide (clicked = esquerdo)

    def _clicked(self, _btn, info, hint, did, cmd):
        # teclado (Espaço/Enter) = o mesmo verbo do esquerdo
        self._focus_or_launch(info, hint, did, cmd)

    def _focus_candidates(self, info, hint, did):
        # ordem de adivinha: hint explícito → StartupWMClass → binário →
        # stem do desktop-id; dedup preservando a ordem
        cands = []
        if hint:
            cands.append(hint)
        try:
            wmc = info.get_string("StartupWMClass") or ""
        except Exception:  # noqa: BLE001 — .desktop exótico não derruba a dock
            wmc = ""
        if wmc:
            cands.append(wmc)
        b = binary_of(info)
        if b:
            cands.append(b)
        stem = did[:-8] if did.endswith(".desktop") else did
        if stem:
            cands.append(stem)
        return list(dict.fromkeys(c for c in cands if c))

    def _wlrctl(self, verb, key, value):
        """Uma chamada ao wlrctl; rc=0 = o compositor casou e executou."""
        if not WLRCTL:
            return False
        try:
            r = subprocess.run(
                [WLRCTL, "window", verb, f"{key}:{value}"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=1)
        except subprocess.TimeoutExpired:
            return False
        except OSError:
            return False
        return r.returncode == 0

    def _focus_or_launch(self, info, hint, did, cmd):
        b = binary_of(info)
        # v2.10.3 — DAEMON VIVO = a JANELA é a ÚNICA verdade: 1 janela →
        # foca/restaura (ACT por id); N → cicla ENTRE ELAS (o alt-tab
        # dentro do botão do app); 0 janela → abrir (processo em 2º plano
        # sem janela NÃO é "aberto" — o mesmo critério do indicador).
        if self.tl_alive:
            wids = self._windows_of(info, hint, did)
            if wids:
                key = did or b
                if len(wids) == 1:
                    if self._tl_act(wids[0]):
                        self._last_act[key] = wids[0]
                        log(f"foco por id {wids[0]}")
                        return
                else:
                    nxt = self._app_cycle_next(wids, key)
                    if nxt is not None and self._tl_act(nxt):
                        self._last_act[key] = nxt
                        log(f"ciclo do app: id {nxt} ({len(wids)} janelas)")
                        return
                # v2.10.6 — A MORTE NO MEIO DO CLIQUE: o ACT falhou e a
                # conexão MORREU (sock=None — o _tl_cmd fecha e zera). O
                # snapshot era velho e a janela pode estar VIVA no
                # compositor: cair direto no _launch abria DOIS. A lei do
                # fallback manda degradar: wlrctl tenta focar; só abre se
                # TODAS as formas falharem. ERR honesto (janela morta de
                # verdade, sock vivo) segue para o _launch — o tick
                # refresca o snapshot.
                if self._sock is None:
                    self._fallback_focus(info, hint, did, cmd)
                    return
            self._launch(None, cmd)
            return
        # daemon morto — LEI DO FALLBACK v2.10 INTACTA (o caminho inteiro
        # vive em _fallback_focus desde a v2.10.6; a morte no meio do
        # clique degrada PARA CÁ em vez de lançar duplicado).
        self._fallback_focus(info, hint, did, cmd)

    def _fallback_focus(self, info, hint, did, cmd):
        """LEI DO FALLBACK v2.10 INTACTA: o wlrctl com as 3 formas canônicas
        e o launch; a dock nunca fica pior por causa da cura. O check é o
        MESMO casamento do _windows_of (v2.10.4 — o exato puro lia 'brave'
        ≠ 'brave-browser-stable' como não-rodando e lançava DOIS)."""
        alive = self._fallback_alive(info, hint, did)
        if not (WLRCTL and alive):
            self._launch(None, cmd)
            return
        # rodando: FOCAR. Para cada candidato, 3 formas canônicas de app_id
        # (a cura v2.10 do case-sensitive que abria nova sessão no Brave);
        # por último, o TÍTULO com o nome do app (alguns apps expõem o nome
        # no título e não no app_id). rc=0 vence; TODOS falharam → abre
        # (nunca pior que a era v2.6).
        for c in self._focus_candidates(info, hint, did):
            for v in case_variants(c):
                if self._wlrctl("focus", "app_id", v):
                    log(f"foco: app_id:{v}")
                    return
        name = (info.get_display_name() or "").strip()
        if name:
            for v in case_variants(name):
                if self._wlrctl("focus", "title", v):
                    log(f"foco: title:{v}")
                    return
        log(f"foco sem match ({', '.join(self._focus_candidates(info, hint, did))}) — abrindo")
        self._launch(None, cmd)

    def _close_windows(self, info, hint, did):
        """v2.10: o verbo do MEIO — fechar (WM_DELETE gracioso; o app
        confirma se tiver o que salvar)."""
        closed = False
        for c in self._focus_candidates(info, hint, did):
            for v in case_variants(c):
                if self._wlrctl("close", "app_id", v):
                    log(f"fechado: app_id:{v}")
                    closed = True
                    break
            if closed:
                break
        if not closed:
            log("fechar sem match — nada encerrado")

    def _close_app_windows(self, wids):
        """v2.10.3 — encerrar O PROGRAMA de verdade: cada janela do app
        recebe o CLOSE por id (gracioso — WM_DELETE; o app confirma se
        tiver algo a salvar). Verdade: True se ALGUMA janela aceitou."""
        ok = False
        for w in wids:
            if self._tl_close_win(w):
                ok = True
                log(f"encerrado por id {w}")
        return ok

    def _pin_add(self, did):
        """v2.10: direito num DINÂMICO fixa o app (o mesmo craft-pin de
        sempre: fuzzy resolve, .bak e reload SIGUSR2 — a dock re-lê sozinha)."""
        if not did:
            return
        try:
            r = subprocess.run(
                ["/usr/local/bin/craft-pin", "add", did],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=10)
        except (subprocess.TimeoutExpired, OSError) as exc:
            log(f"craft-pin add falhou ({type(exc).__name__}): {did}")
            return
        if r.returncode == 0:
            log(f"fixado via craft-pin: {did}")
        else:
            log(f"craft-pin add rc={r.returncode}: {did}")

    def _reap_children(self):
        """v2.10.3 — A CEIFA DOS ZUMBIS: todo app lançado pela dock é filho
        DELA; saído sem colheita vira zumbi com /proc/<pid>/comm VIVO — o
        scan lia o morto e o indicador 'continuava' depois do fecho (o
        relato exato do dono). poll() = waitpid WNOHANG: ceifa sem travar,
        a cada tick."""
        vivos = []
        for p in self._children:
            try:
                if p.poll() is None:
                    vivos.append(p)
            except Exception:  # noqa: BLE001 — filho exótico nunca derruba
                pass
        self._children = vivos

    def _launch(self, _btn, cmd):
        try:
            p = subprocess.Popen(cmd, shell=True,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            self._children.append(p)   # rastreado: a ceifa do tick o colhe
            log(f"lançado: {cmd}")
        except OSError as exc:
            log(f"falha ao lançar {cmd}: {exc}")

    # ── o poll (v2.10 — /proc direto, pins + dinâmicos no MESMO scan) ────
    # v2.5.0 — o indicador nasceu com 1 fork POR PIN a cada 3s; virou UM
    # pgrep com alternância ERE (audit 24-b). v2.10 — o fork inteiro morreu:
    # a leitura DIRETA de /proc/<pid>/comm (uid do usuário) N leituras sem
    # NENHUM fork, sem ERE para escapar, e o MESMO scan alimenta os botões
    # dinâmicos (um só lugar onde "aberto" existe).
    def _scan_user_comms(self):
        uid = os.getuid()
        comms = set()
        try:
            pids = os.listdir("/proc")
        except OSError:
            return comms
        for pid in pids:
            if not pid.isdigit():
                continue
            try:
                if os.stat(f"/proc/{pid}").st_uid != uid:
                    continue
                with open(f"/proc/{pid}/comm") as fh:
                    c = fh.read().strip()
                if c:
                    comms.add(c)
            except OSError:
                continue
        return comms

    def poll_running(self):
        self._reap_children()          # a ceifa antes do scan (o zumbi sai)
        self.running = self._scan_user_comms()
        # v2.10.3 — a verdade do daemon PRIMEIRO: vivo = a JANELA é o
        # critério do "aberto" (indicador, dinâmicos, verbo do clique);
        # morto = o /proc assume (lei do fallback — nada muda).
        snap = self._tl_list()
        if snap is None:
            self.windows = {}
            self.focused = 0
            self.tl_alive = False
        else:
            self.windows, self.focused = snap
            self.tl_alive = True
        for btn, binary, info, hint, did in self.buttons:
            ctx = btn.get_style_context()
            if self.tl_alive:
                on = self._app_has_window(info, hint, did)
            else:
                # v2.10.4 — o mesmo casamento do _windows_of (o exato
                # puro deixava o Brave com o indicador apagado no fallback)
                on = self._fallback_alive(info, hint, did)
            if on:
                ctx.add_class("running")
            else:
                ctx.remove_class("running")
        self._sync_dynamic()
        return True

    def _app_has_window(self, info, hint, did):
        """v2.10.3 — o critério do 'aberto' com o daemon vivo: a JANELA
        REAL do snapshot. Processo em 2º plano sem janela não acende
        indicador — o dono fechou o programa, o marcador morre JUNTO."""
        return bool(self._windows_of(info, hint, did))

    def _fallback_alive(self, info, hint, did):
        """v2.10.4 — o 'está rodando?' do FALLBACK (daemon morto) usa o
        MESMO critério de casamento do _windows_of (v2.10.3): exato OU
        contenção ≥4 chars nos dois sentidos entre candidatos e comms.
        O casamento EXATO puro mordeu de novo: o comm do Brave é 'brave'
        e o binário do .desktop é 'brave-browser-stable' — 'não rodando'
        de fábrica → com o daemon morto o clique lançava DOIS e o
        indicador ficava apagado. Falso positivo é SEGURO (wlrctl falha
        → lança no fim); falso negativo é o bug (duplica a janela)."""
        cands = [c.lower() for c in self._focus_candidates(info, hint, did)]
        if not cands:
            return False
        for x in self.running:
            xl = (x or "").lower()
            for c in cands:
                # v2.10.6 — MESMA lei do _windows_of: exato OU contenção
                # ≥4 com FRONTEIRA (_near_match) — o fallback não vê o que
                # o daemon vivo não vê (foot ≠ footclient nos dois mundos).
                if c == xl or _near_match(xl, c):
                    return True
        return False

    # ── dinâmicos (v2.10 — a dock auto-adaptável) ───────────────────────
    def _sync_dynamic(self):
        """Apps rodando SEM pin e COM .desktop → botão após o fio. Ao fechar,
        o botão some sozinho (até restar só o fixado). Diff por desktop-id:
        nada toca no GTK se nada mudou (zero flicker no tick de 3s)."""
        current = {}
        for comm in self.running:
            info = self._resolve_desktop(comm)
            if info is None:
                continue
            did = info.get_id() or ""
            if not did or did in self.pin_ids or did in current:
                continue
            cmd = exec_of(info)
            if not cmd:
                continue
            # v2.10.3 — daemon vivo: SEM janela real não é "aberto" (o
            # processo teimoso que sobrevive ao fecho não segura botão)
            if self.tl_alive and not self._windows_of(info, "", did):
                continue
            current[did] = (info, comm)
        if set(current) == set(self.dyn):
            return
        dead = set(self.dyn) - set(current)
        for did in sorted(dead):
            btn = self.dyn[did][0]
            btn.destroy()
            del self.dyn[did]
            log(f"dinâmico saiu: {did}")
        fresh = set(current) - set(self.dyn)
        for did in sorted(fresh):
            info, comm = current[did]
            btn = self._make_button(info, "", dynamic=True)
            self.pill.pack_start(btn, False, False, 0)
            self.dyn[did] = (btn, comm, info, exec_of(info))
            log(f"dinâmico entrou: {did} (comm {comm})")
        # o fio só existe quando há os dois lados
        if self.dyn and self.buttons and self.sep is None:
            self.sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
            self.sep.set_name("dynsep")
            self.sep.set_margin_top(8)
            self.sep.set_margin_bottom(8)
            self.pill.pack_start(self.sep, False, False, 0)
            self.pill.reorder_child(self.sep, len(self.buttons))
        elif (not self.dyn or not self.buttons) and self.sep is not None:
            self.sep.destroy()
            self.sep = None
        if self.dyn or fresh or dead:
            self.pill.show_all()

    def toggle(self, *_):
        # v2.3.4: esconder é ESCOLHA do usuário (W-S-d) — nunca decisão
        # automática. Escondida, a zona exclusiva vai embora junto (a
        # superfície desmapeada libera a faixa — comportamento padrão).
        if self.shown:
            self.win.hide()
            self.shown = False
            log("toggle: dock escondida (W-S-d)")
        else:
            self.win.show_all()
            self.shown = True
            log("toggle: dock visível (W-S-d)")
        return GLib.SOURCE_CONTINUE


DEFAULT_CSS = b"""
