#!/usr/bin/python3
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-dock-gui (v2.9 — "a dock PURA")
# v2.1.1: read_pins à prova de TypeError (pin inválido é ignorado com log —
#         nunca mais crash-loop; run #93 como evidência).
# v2.3.4: FIM DO AUTOHIDE — a dock é SEMPRE VISÍVEL (diretriz do dono:
#         "funcionando como funciona as outras distros").
# v2.7.0: DOIS VERBOS NO CLIQUE (o dono: "clicar num programa já aberto deve
#         ir para a tarefa aberta invés de abrir outra… se o usuário quiser
#         abrir outra rapidamente ele pode fazer clicando com o botão
#         direito"):
#   · ESQUERDO num pin: se o programa ESTÁ rodando (pílula), FOCAR a janela
#     dele (wlrctl, protocolo wlr-foreign-toplevel — labwc fala); se NÃO
#     está, abrir — direto, sem subprocesso no caminho comum (instantâneo);
#   · DIREITO num pin: abrir OUTRA instância, sempre (o verbo rápido do
#     dono para "quero outro agora").
# v2.9.0 — A GAIOLA MORREU (o rig do dono desmentiu a v2.8.0 NA CARNE:
#         "matou o uso do mouse no sistema… só topbar e dock funcionam";
#         e a dock "continua fazendo tipo um refresh" ao mexer nos menus).
#         A perícia do código achou o crime COM PROVA:
#           1. o campo da gaiola era setado DEPOIS da chamada que aplicava
#              a região de entrada — a chamada lia o campo (ainda vazio) e
#              RETORNAVA sem aplicar nada: a gaiola nascia com a região
#              DEFAULT (TODA a superfície) — nunca "vazia";
#           2. o desarmar re-aplicava a região por UNIÃO — a rede só
#              crescia: UMA gaiola invisível full-screen no layer TOP
#              engolindo o clique de TODA janela (Calamares incluso — por
#              isso nem instalar dava) e do próprio desktop;
#           3. o "refresh" da dock ao abrir menu era a mesma família:
#              superfície extra no TOP + troca de região de entrada +
#              reinício do supervisor quando algo morria no caminho.
#         A CURA é estrutural: A DOCK VOLTA A SER SÓ A DOCK — uma
#         superfície (a pílula), ZERO superfícies auxiliares, ZERO input
#         regions, ZERO telefone de menus. O clique fora do menu virou LEI
#         DO COMPOSITOR (rc.xml §Root: esquerdo/direito executam
#         craft-menu-dismiss — o dismiss não precisa de rede nenhuma).
#         O que a dock não tem, ela não quebra.
# POR QUÊ EXISTE (feedback do dono, out/2026): a dock de waybar com pins de
# GLIFO Nerd Font entregou "botões mal recortados, mal encaixados" e "nada é
# o ícone real". Os caminhos conhecidos morreram COM EVIDÊNCIA:
#   · waybar 0.15 crasha com 3+ módulos image (Alexays/Waybar#5051 — pins de
#     ícone real IMPOSSÍVEIS no waybar; forense v1.6);
#   · nwg-dock log.Fatal sem sway IPC (tools.go/main.go — morto no labwc).
# CURA ESTRUTURAL: dock GTK3 NATIVA no protocolo wlr-layer-shell (o mesmo
# mecanismo do nwg-dock, SEM a dependência do sway IPC — funciona em
# qualquer compositor wlroots, labwc incluso), com:
#   1. ÍCONES REAIS — os pins são IDs de .desktop resolvidos via
#      Gio.DesktopAppInfo: ícone vem do fallback base do GTK (v2.2: sem
#      tema de ícones — o app traz o próprio no hicolor), nome e exec
#      vêm do .desktop. Zero glifo, zero desenho custom, zero override —
#      "deixe o ícone ser tratado como o sistema já é" (dono).
#   2. SEMPRE VISÍVEL (v2.3.4) — o auto-esconder por tira invisível
#      (v2.0→v2.3.3) morreu NA PRÁTICA: o dono instalou a v2.3.x e a dock
#      escondeu no fim do mostrinho de 4s e a tira na base nunca mais a
#      devolveu ("ela sumiu e não apareceu mais"). A cura é a SEMÂNTICA DO
#      PRÓPRIO PROTOCOLO — zero polling, zero heurística, zero estado para
#      corromper:
#        · layer BOTTOM: janelas em TELA CHEIA (e a gaveta de apps,
#          fullscreen) renderizam acima da dock — ela some sozinha e
#          volta quando a tela cheia acaba;
#        · zona exclusiva automática: janelas maximizadas/tileadas
#          RESPEITAM a faixa da dock (o comportamento dash-to-dock,
#          plank e do painel do KDE);
#        · W-S-d continua alternando (SIGUSR1) — esconder é ESCOLHA do
#          usuário, nunca decisão automática da dock.
#   3. PÍLULA CENTRADA — superfície ancorada SÓ na base (a layer-shell
#      centra no eixo não-ancorado): a janela TEM o tamanho da pílula —
#      nada de faixa invisível full-width comendo clique — e flutua
#      PILL_FLOAT px acima da base, com o gap DENTRO da superfície
#      (a zona exclusiva cobre o conjunto inteiro).
#   4. INDICADOR DE ABERTO — ponto sob o ícone (classe .running) via pgrep
#      por binário, 1× a cada 3s, IN-PROCESS (um único processo, sem
#      exec-json por pin — a classe de leak da v1.6.2 segue extinta).
#   5. RELOAD — SIGUSR2 re-lê o arquivo de pins (craft-pin add/rm).
# PINS: ~/.config/elite/dock-pins — 1 ID de .desktop por linha
# (ex.: "foot.desktop"). Gerido pelo craft-pin; skel de fábrica: 3 apps.
# ═══════════════════════════════════════════════════════════════════════════
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GLib, Gio, Gtk, Gdk, GtkLayerShell  # noqa: E402

PINS_FILE = os.path.join(
    GLib.get_user_config_dir(), "elite", "dock-pins"
)
CSS_FILE = os.path.join(GLib.get_user_config_dir(), "elite", "dock.css")
LOG = os.path.join(GLib.get_user_cache_dir(), "elite", "dock.log")

ICON_SIZE = 36   # spec M3.2: escala fixa de fábrica
# v2.3.4 — o float da pílula mora DENTRO da superfície (margem GTK no
# widget, não margem layer-shell): a zona exclusiva cobre pílula + vão —
# a janela maximizada nunca invade nem o vão transparente.
PILL_FLOAT = 6

WLRCTL = shutil.which("wlrctl")  # foco de janela (wlr-foreign-toplevel)


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        try:
            # teto de 1 MiB (mesma política do bars.log — evidência recente vale mais)
            if os.path.getsize(LOG) > 1_048_576:
                os.truncate(LOG, 0)
        except OSError:
            pass
        with open(LOG, "a") as fh:
            fh.write(msg + "\n")
    except OSError:
        pass


def read_pins():
    """Lê o arquivo de pins → lista de (DesktopAppInfo, app_id_hint).

    v2.7.0: a linha pode ter uma 2ª coluna — o app_id EXPLÍCITO para o
    foco (wlrctl) quando o app se apresenta com um id que nem o
    StartupWMClass nem o binário adivinham (ex. GTK: 'thunar.desktop
    org.xfce.Thunar'). A 1ª coluna continua sendo o ID do .desktop.
    """
    pins = []
    try:
        with open(PINS_FILE) as fh:
            for line in fh:
                parts = line.strip().split()
                if not parts or parts[0].startswith("#"):
                    continue
                appid = parts[0]
                hint = parts[1] if len(parts) > 1 else ""
                # v2.1.1 (run #93): o PyGObject LANÇA TypeError ("constructor
                # returned NULL") em construtor não-nullable — o None JAMAIS
                # chega ao `if info is None`. Pin inválido é ignorado com log;
                # um pin ruim NUNCA derruba a dock (na #93 o 'brave.desktop'
                # inexistente crash-loopou 15× e derrubou o verify).
                try:
                    info = Gio.DesktopAppInfo.new(appid)
                except TypeError:
                    info = None
                if info is None:
                    log(f"pin ignorado (desktop inexistente): {appid}")
                    continue
                pins.append((info, hint))
    except (OSError, UnicodeDecodeError) as exc:
        # v2.5.0 — era só FileNotFoundError: PermissionError/UnicodeDecode
        # no dock-pins subiam pela callback do SIGUSR2, o PyGObject
        # removia a source do sinal e a dock ficava SURDA (mesmo efeito
        # do return False — o audit 24-c flagrou). Pin/arquivo ruim =
        # log + ignora; a dock segue viva e OUVINDO.
        log(f"arquivo de pins ilegível ({type(exc).__name__}): {PINS_FILE}")
    return pins


def exec_of(info):
    """Exec do .desktop sem os códigos de campo (%f %U …)."""
    raw = info.get_commandline() or ""
    raw = re.sub(r"\s%[a-zA-Z]", "", raw).strip()
    return raw


def binary_of(info):
    """Primeiro binário do Exec — alvo do pgrep do indicador."""
    raw = exec_of(info)
    if not raw:
        return ""
    try:
        first = shlex.split(raw)[0]
    except ValueError:
        first = raw.split()[0] if raw.split() else ""
    return os.path.basename(first)


class Dock:
    def __init__(self):
        self.shown = True  # v2.3.4: nasce visível e fica — esconder é escolha (W-S-d)
        self.buttons = []  # (button, binary)
        self.running = set()      # comms vivos (o poll alimenta; o clique lê)

        self.win = Gtk.Window()
        self.win.set_name("dockwindow")
        GtkLayerShell.init_for_window(self.win)
        # layer BOTTOM — o coração do v2.3.4: janelas normais ficam ACIMA da
        # camada background/bottom (a dock não as cobre), e a tela cheia de
        # qualquer app cobre a dock. O "esconder em tela cheia" é a ordem de
        # renderização do protocolo — não existe código para falhar.
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.BOTTOM)
        # Ancorada SÓ na base: a layer-shell centra no eixo não-ancorado —
        # a superfície TEM o tamanho da pílula (nada de faixa invisível
        # full-width comendo clique ao lado dela).
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.BOTTOM, True)
        # Zona exclusiva automática: maximizadas/tileadas respeitam a faixa
        # da dock ("como funciona as outras distros" — diretriz do dono).
        GtkLayerShell.auto_exclusive_zone_enable(self.win)

        self.pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.pill.set_name("dockbox")
        self.pill.set_margin_bottom(PILL_FLOAT)
        self.win.add(self.pill)

        self.rebuild()

        self.load_css()
        self.win.show_all()
        log(f"dock iniciada: {len(self.buttons)} pin(s) · "
            f"sempre visível (layer BOTTOM — some só sob tela cheia/gaveta)")

        GLib.timeout_add(3000, self.poll_running)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             self.toggle)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                             self.rebuild)
        # v2.9.0 — SEM superfície auxiliar, SEM pid-file, SEM telefone:
        # a dock não recebe pedidos de ninguém. O dismiss de menu é lei do
        # rc.xml (craft-menu-dismiss) — a dock nem fica sabendo que um
        # menu abriu.

    # ── CSS ──────────────────────────────────────────────────────────────
    def load_css(self):
        css = b""
        try:
            with open(CSS_FILE, "rb") as fh:
                css = fh.read()
        except FileNotFoundError:
            log(f"CSS ausente ({CSS_FILE}) — usando fallback embutido")
            css = DEFAULT_CSS
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except GLib.Error as exc:
            log(f"CSS inválido — o fallback embutido entra no lugar: {exc}")
            prov = Gtk.CssProvider()
            prov.load_from_data(DEFAULT_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # ── pins ─────────────────────────────────────────────────────────────
    def rebuild(self, *_):
        for child in self.pill.get_children():
            self.pill.remove(child)
        self.buttons = []
        for info, hint in read_pins():
            btn = Gtk.Button.new()
            btn.set_relief(Gtk.ReliefStyle.NONE)
            icon = info.get_icon()
            img = Gtk.Image()
            if icon is not None:
                img.set_from_gicon(icon, Gtk.IconSize.DIALOG)
            else:
                img.set_from_icon_name("application-x-executable",
                                       Gtk.IconSize.DIALOG)
            img.set_pixel_size(ICON_SIZE)
            btn.add(img)
            # v2.7.0 — o tooltip ENSINA os dois verbos (a descoberta não
            # mora escondida — mesma gramática dos tooltips da topbar)
            name = info.get_display_name() or ""
            if WLRCTL:
                btn.set_tooltip_text(
                    f"{name} — esquerdo: focar/abrir · direito: nova janela")
            else:
                btn.set_tooltip_text(f"{name} — clique: abrir")
            cmd = exec_of(info)
            did = info.get_id() or ""
            if cmd:
                # v2.7.0 — button-press-event distingue ESQUERDO (focar se
                # roda, senão abrir) de DIREITO (abrir OUTRA instância,
                # sempre). O return True consome o evento (o "clicked" não
                # refira — zero duplo lançamento); o "clicked" segue ligado
                # para teclado (Espaço/Enter = esquerdo).
                btn.connect("button-press-event", self._press,
                            info, hint, did, cmd)
                btn.connect("clicked", self._clicked, info, hint, did, cmd)
            btn.set_name("dockbtn")
            self.pill.pack_start(btn, False, False, 0)
            self.buttons.append((btn, binary_of(info)))
        self.pill.show_all()
        self.poll_running()
        # v2.5.0 — GLib.SOURCE_CONTINUE: callback de sinal que retorna False
        # é G_SOURCE_REMOVE — a source morria na 1ª dispatch e a dock
        # ficava SURDA (reload de pins e W-S-d mortos pelo resto da
        # sessão; o audit 24-c flagrou o mecanismo exato).
        return GLib.SOURCE_CONTINUE

    # ── os DOIS VERBOS do clique (v2.7.0) ────────────────────────────────
    def _press(self, btn, ev, info, hint, did, cmd):
        if ev.button == 3:
            self._launch(btn, cmd)              # direito: OUTRA instância
            return True                          # consumido — sem "clicked"
        if ev.button == 1:
            self._focus_or_launch(info, hint, did, cmd)  # esquerdo
            return True
        return False  # meio/outros: GtkButton decide (clicked = esquerdo)

    def _clicked(self, _btn, info, hint, did, cmd):
        # teclado (Espaço/Enter) = o mesmo verbo do esquerdo
        self._focus_or_launch(info, hint, did, cmd)

    def _focus_candidates(self, info, hint, did):
        # ordem de adivinha: hint explícito → StartupWMClass → binário →
        # stem do desktop-id; dedup preservando a ordem
        cands = []
        if hint:
            cands.append(hint)
        try:
            wmc = info.get_string("StartupWMClass") or ""
        except Exception:  # noqa: BLE001 — .desktop exótico não derruba a dock
            wmc = ""
        if wmc:
            cands.append(wmc)
        b = binary_of(info)
        if b:
            cands.append(b)
        stem = did[:-8] if did.endswith(".desktop") else did
        if stem:
            cands.append(stem)
        return list(dict.fromkeys(c for c in cands if c))

    def _focus_or_launch(self, info, hint, did, cmd):
        b = binary_of(info)
        # NÃO rodando: abrir DIRETO (zero subprocesso no caminho comum —
        # o clique responde na hora; "responderem instantâneos" — dono).
        if not (WLRCTL and b and b in self.running):
            self._launch(None, cmd)
            return
        # rodando: FOCAR (wlrctl fala wlr-foreign-toplevel; labwc fala).
        # rc=0 = janela focada; rc≠0 = ninguém casou → tenta o próximo
        # candidato; TODOS falharam → abre (nunca pior que a era v2.6 —
        # e com o hint 'desktop-id app_id' o caso exótico tem saída).
        for c in self._focus_candidates(info, hint, did):
            try:
                r = subprocess.run(
                    [WLRCTL, "window", "focus", f"app_id:{c}"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=2)
            except subprocess.TimeoutExpired:
                break  # wlrctl preso: não repete o transtorno — abre
            except OSError:
                break
            if r.returncode == 0:
                log(f"foco: {c} (app_id)")
                return
        self._launch(None, cmd)

    def _launch(self, _btn, cmd):
        try:
            subprocess.Popen(cmd, shell=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True)
            log(f"lançado: {cmd}")
        except OSError as exc:
            log(f"falha ao lançar {cmd}: {exc}")

    # ── indicador de aberto (1 pgrep por tick — v2.5.0) ─────────────────
    # v2.5.0 — era 1 pgrep POR PIN a cada 3s (3 forks + 3 varreduras de
    # /proc no factory; escala com os pins do usuário). Agora: UM pgrep
    # com alternância (-x aceita ERE — provado no procps-ng 4.x) e a
    # identificação por /proc/<pid>/comm (leitura direta, sem fork).
    def poll_running(self):
        running = set()
        # v2.5.0 (N2, audit 24-r): re.escape — uma ERE inválida de UM
        # binário (ex.: '(' no nome) devolvia rc=2 do pgrep e apagava
        # TODAS as pílulas; o escape isola o pin ruim.
        pats = "|".join(dict.fromkeys(re.escape(b) for _, b in self.buttons if b))
        if pats:
            try:
                out = subprocess.run(
                    ["pgrep", "-x", pats],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True).stdout or ""
            except OSError:
                out = ""
            for pid in out.split():
                try:
                    with open(f"/proc/{pid}/comm") as fh:
                        running.add(fh.read().strip())
                except OSError:
                    pass
        self.running = running  # v2.7.0: o clique lê isto (focar vs abrir)
        for btn, binary in self.buttons:
            ctx = btn.get_style_context()
            if binary and binary in running:
                ctx.add_class("running")
            else:
                ctx.remove_class("running")
        return True

    def toggle(self, *_):
        # v2.3.4: esconder é ESCOLHA do usuário (W-S-d) — nunca decisão
        # automática. Escondida, a zona exclusiva vai embora junto (a
        # superfície desmapeada libera a faixa — comportamento padrão).
        if self.shown:
            self.win.hide()
            self.shown = False
            log("toggle: dock escondida (W-S-d)")
        else:
            self.win.show_all()
            self.shown = True
            log("toggle: dock visível (W-S-d)")
        return GLib.SOURCE_CONTINUE


DEFAULT_CSS = b"""
#dockwindow { background: transparent; }
#dockbox {
  background: rgba(5, 5, 8, 0.88);
  border: 1px solid rgba(22, 22, 31, 0.8);
  border-radius: 20px;
  padding: 4px 10px;
}
#dockbox button {
  padding: 4px;
  min-height: 44px;
  min-width: 44px;
  border-radius: 12px;
  background: transparent;
  border: none;
}
#dockbox button:hover { background: rgba(22, 22, 31, 0.95); }
#dockbox button.running { box-shadow: inset 0 -3px 0 rgba(205, 214, 244, 0.8); }
"""


def main():
    if not os.environ.get("WAYLAND_DISPLAY"):
        # v2.3.1: essa morte também fica LOUD no bars.log — o craft-bars
        # registra o exit=0 e o probe conta BARS_EXITS (nada calado)
        log("sem WAYLAND_DISPLAY — saindo (a dock só vive na sessão)")
        return 0
    try:
        Dock()
    except Exception as exc:  # noqa: BLE001 — o log é a evidência do boot
        log(f"FATAL: {exc}")
        raise
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
