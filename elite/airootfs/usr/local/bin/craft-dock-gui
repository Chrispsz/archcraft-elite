#!/usr/bin/python3
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-dock-gui (v2.10.1 — "a dock COMUTADORA")
# v2.1.1: read_pins à prova de TypeError (pin inválido é ignorado com log —
#         nunca mais crash-loop; run #93 como evidência).
# v2.3.4: FIM DO AUTOHIDE — a dock é SEMPRE VISÍVEL (diretriz do dono:
#         "funcionando como funciona as outras distros").
# v2.7.0: DOIS VERBOS NO CLIQUE (o dono: "clicar num programa já aberto deve
#         ir para a tarefa aberta invés de abrir outra… se o usuário quiser
#         abrir outra rapidamente ele pode fazer clicando com o botão
#         direito"): esquerdo foca/abre · direito abre OUTRA instância.
# v2.9.0 — A GAIOLA MORREU: a dock é SÓ a pílula (zero superfícies auxiliares,
#         zero input regions — o que não existe não come clique).
# v2.10.0 — A DOCK APRENDE A VER AS JANELAS (o rig do dono desmentiu a v2.9.1):
#   1. FOCO QUE VIRA "NOVA SESSÃO" MORRE — o matching do wlrctl é EXATO e
#      case-sensitive: o bridge X11 do wlroots expõe a WM_CLASS com a
#      capitalização do app ("Brave-browser") e os candidatos nasciam
#      minúsculos → NENHUM casava → o fallback abria outra instância (o foot
#      funcionava porque "foot" é minúsculo e idêntico ao binário). CURA: os
#      candidatos agora vão em 3 formas canônicas (original/minúscula/Título)
#      e há um último recurso por TÍTULO com o nome do app — para TODOS os
#      apps, não só para os de app_id bem-comportado.
#   2. A DOCK MOSTRA O QUE ESTÁ ABERTO (o dono: "quando abro um programa que
#      não está fixado na dock ele não vai pra dock… a dock deve ser auto
#      adaptável e funcionar como funciona uma dock em qualquer sistema") —
#      apps rodando SEM pin ganham botão dinâmico (ícone/nome do .desktop
#      resolvido pelo sistema), separados dos pins por um fio vertical.
#      Ao fechar, eles somem sozinhos até restar só o fixado. NADA se fixa
#      sozinho; o direito num dinâmico FIXA (craft-pin add — o mesmo verbo
#      do sempre, com .bak e reload SIGUSR2).
#   3. MEIO FECHA (convencional das docks) — wlrctl window close, gracioso
#      (WM_DELETE: o app confirma se tiver o que salvar).
#   4. O poll cresceu e SIMPLIFICOU: a varredura direta de /proc (uid do
#      usuário, leitura de comm) substitui o fork de pgrep a cada tick —
#      N processos = N reads sem fork, e o MESMO scan alimenta pins e
#      dinâmicos (um só lugar onde "aberto" existe).
#   Limitação HONESTA (documentada, não escondida): o matching é POR APP
#   (comm/.desktop), não por janela — o protocolo wlr-foreign-toplevel não
#   tem listagem via CLI (o wlrctl só casar). Duas janelas do mesmo app = um
#   botão; o foco vai para a que o compositor escolher. Multi-janela com
#   ciclo por janela exige falar o protocolo direto — v2.11 se o rig pedir.
# v2.10.1 — A DOCK COMUTADORA (o dono pediu a v2.10 "com a dock tendo meio
#   que essa funcionalidade de alt tab perfeitamente pra navegar entre os
#   programas abertos e etc ou até mesmo um atalho pra isso clicável na
#   dock… sem preview"): a limitação de cima MORREU — o craft-toplevel
#   (pacote novo, ~680 linhas de C, fonte em vendor/craft-toplevel.c) fala
#   o zwlr-foreign-toplevel DIRETO com o labwc e serve a sessão num socket:
#   1. CLIQUE ESQUERDO = janela EXATA: 1 janela → foca/restaura (ACT por
#      id: unset_minimized + activate — restauração POR COMANDO do
#      protocolo, a "hipótese forte" da v2.10 virou lei); N janelas →
#      cicla ENTRE ELAS (ring por id, a memória é de quem clicou);
#      0 → abre (como sempre). Fim da adivinhação de capitalização.
#   2. COMUTADOR CLICÁVEL (o atalho pedido): botão no FIM da pílula,
#      existe SÓ com ≥2 janelas, SEM preview e SEM miniatura — o ícone
#      dele é o ÍCONE DO APP de destino (o clique anuncia onde cai) e o
#      verbo é CYCLE: a próxima do anel MRU do daemon (o exato A-Tab,
#      em clique; cliques seguidos caminham pelo anel).
#   3. MEIO fecha a janela POR ID (a focada do app; wlrctl no fallback).
#   4. LEI DO FALLBACK: daemon ausente/morto = snapshot vazio e TODO verbo
#      cai no caminho v2.10 (wlrctl case-variants / launch) — a dock NUNCA
#      fica pior que a versão anterior por causa da cura. A conexão é
#      PERSISTENTE (zero fork por tick; o /proc scan dos indicadores segue).
#   5. A-Tab/A-S-Tab do compositor CONTINUAM (teclado cicla janelas com
#      OSD) — dock comuta por clique, teclado comanda ciclo; cada um no
#      que é melhor (a resposta à pergunta do dono).
# POR QUÊ EXISTE (feedback do dono, out/2026): a dock de waybar com pins de
# GLIFO Nerd Font entregou "botões mal recortados, mal encaixados" e "nada é
# o ícone real". Os caminhos conhecidos morreram COM EVIDÊNCIA:
#   · waybar 0.15 crasha com 3+ módulos image (Alexays/Waybar#5051 — pins de
#     ícone real IMPOSSÍVEIS no waybar; forense v1.6);
#   · nwg-dock log.Fatal sem sway IPC (tools.go/main.go — morto no labwc).
# CURA ESTRUTURAL: dock GTK3 NATIVA no protocolo wlr-layer-shell (o mesmo
# mecanismo do nwg-dock, SEM a dependência do sway IPC — funciona em
# qualquer compositor wlroots, labwc incluso), com:
#   1. ÍCONES REAIS — pins são IDs de .desktop resolvidos via
#      Gio.DesktopAppInfo: ícone vem do fallback base do GTK (v2.2: sem
#      tema de ícones — o app traz o próprio no hicolor), nome e exec
#      vêm do .desktop. Zero glifo, zero desenho custom, zero override.
#   2. SEMPRE VISÍVEL (v2.3.4) — layer BOTTOM: janelas em TELA CHEIA
#      renderizam acima da dock; zona exclusiva automática: maximizadas/
#      tileadas RESPEITAM a faixa; W-S-d alterna (SIGUSR1) — esconder é
#      ESCOLHA do usuário, nunca decisão automática da dock.
#   3. PÍLULA CENTRADA — ancorada SÓ na base, superfície com o tamanho da
#      pílula (nada de faixa invisível full-width comendo clique).
#   4. INDICADOR DE ABERTO — ponto sob o ícone (classe .running), in-process.
#   5. RELOAD — SIGUSR2 re-lê o arquivo de pins (craft-pin add/rm).
# PINS: ~/.config/elite/dock-pins — 1 ID de .desktop por linha
# (ex.: "foot.desktop"). Gerido pelo craft-pin; skel de fábrica: 3 apps.
# ═══════════════════════════════════════════════════════════════════════════
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GLib, Gio, Gtk, Gdk, GtkLayerShell  # noqa: E402

PINS_FILE = os.path.join(
    GLib.get_user_config_dir(), "elite", "dock-pins"
)
CSS_FILE = os.path.join(GLib.get_user_config_dir(), "elite", "dock.css")
LOG = os.path.join(GLib.get_user_cache_dir(), "elite", "dock.log")

ICON_SIZE = 36   # spec M3.2: escala fixa de fábrica
# v2.3.4 — o float da pílula mora DENTRO da superfície (margem GTK no
# widget, não margem layer-shell): a zona exclusiva cobre pílula + vão —
# a janela maximizada nunca invade nem o vão transparente.
PILL_FLOAT = 6

WLRCTL = shutil.which("wlrctl")  # foco/fecho de janela (wlr-foreign-toplevel)

# v2.10.1 — JANELAS REAIS: o craft-toplevel (pacote próprio, fonte em
# vendor/craft-toplevel.c) fala o protocolo zwlr_foreign_toplevel DIRETO
# com o labwc e serve a sessão neste socket, linha a linha. É o que dá ao
# clique o id EXATO da janela (foco/restauro/ciclo/fecho sem adivinhar
# capitalização) e o anel MRU do alt-tab para o comutador clicável.
TOPOS = os.path.join(GLib.get_user_runtime_dir(), "elite", "toplevel.sock")
F_ACTIVATED = 4   # flag do daemon (state activated do protocolo)
F_MINIMIZED = 2   # (1=maximized · 2=minimized · 4=activated · 8=fullscreen)


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        try:
            # teto de 1 MiB (mesma política do bars.log — evidência recente vale mais)
            if os.path.getsize(LOG) > 1_048_576:
                os.truncate(LOG, 0)
        except OSError:
            pass
        with open(LOG, "a") as fh:
            fh.write(msg + "\n")
    except OSError:
        pass


def case_variants(c):
    """v2.10: as 3 formas canônicas de um candidato — o match do wlrctl é
    exato e o bridge X11 do wlroots expõe a WM_CLASS COM a capitalização do
    app ("Brave-browser"): enviar só o minúsculo é adivinhar errado de
    fábrica. Dedup preservando a ordem."""
    seen = set()
    out = []
    for v in (c, (c or "").lower(), (c or "").title()):
        if v and v not in seen:
            seen.add(v)
            out.append(v)
    return out


def read_pins():
    """Lê o arquivo de pins → lista de (DesktopAppInfo, app_id_hint).

    v2.7.0: a linha pode ter uma 2ª coluna — o app_id EXPLÍCITO para o
    foco (wlrctl) quando o app se apresenta com um id que nem o
    StartupWMClass nem o binário adivinham (ex. GTK: 'thunar.desktop
    org.xfce.Thunar'). A 1ª coluna continua sendo o ID do .desktop.
    """
    pins = []
    try:
        with open(PINS_FILE) as fh:
            for line in fh:
                parts = line.strip().split()
                if not parts or parts[0].startswith("#"):
                    continue
                appid = parts[0]
                hint = parts[1] if len(parts) > 1 else ""
                # v2.1.1 (run #93): o PyGObject LANÇA TypeError ("constructor
                # returned NULL") em construtor não-nullable — o None JAMAIS
                # chega ao `if info is None`. Pin inválido é ignorado com log;
                # um pin ruim NUNCA derruba a dock (na #93 o 'brave.desktop'
                # inexistente crash-loopou 15× e derrubou o verify).
                try:
                    info = Gio.DesktopAppInfo.new(appid)
                except TypeError:
                    info = None
                if info is None:
                    log(f"pin ignorado (desktop inexistente): {appid}")
                    continue
                pins.append((info, hint))
    except (OSError, UnicodeDecodeError) as exc:
        # v2.5.0 — era só FileNotFoundError: PermissionError/UnicodeDecode
        # no dock-pins subiam pela callback do SIGUSR2, o PyGObject
        # removia a source do sinal e a dock ficava SURDA (mesmo efeito
        # do return False — o audit 24-c flagrou). Pin/arquivo ruim =
        # log + ignora; a dock segue viva e OUVINDO.
        log(f"arquivo de pins ilegível ({type(exc).__name__}): {PINS_FILE}")
    return pins


def exec_of(info):
    """Commandline do .desktop sem os códigos de campo (%f %U …)."""
    raw = info.get_commandline() or ""
    raw = re.sub(r"\s%[a-zA-Z]", "", raw).strip()
    return raw


def binary_of(info):
    """Primeiro binário do commandline do .desktop."""
    raw = exec_of(info)
    if not raw:
        return ""
    try:
        first = shlex.split(raw)[0]
    except ValueError:
        first = raw.split()[0] if raw.split() else ""
    return os.path.basename(first)


class Dock:
    def __init__(self):
        self.shown = True  # v2.3.4: nasce visível e fica — esconder é escolha (W-S-d)
        self.buttons = []  # pins: (button, binary)
        self.running = set()      # comms vivos do usuário (o poll alimenta)
        self.pin_ids = set()      # desktop-ids fixados (dedup dos dinâmicos)
        self.dyn = {}             # dinâmicos: did → (button, comm, info, cmd)
        self.sep = None           # fio vertical pins | dinâmicos
        self._dindex = None       # cache: chave lower → DesktopAppInfo

        # v2.10.1 — janelas REAIS (o protocolo direto via craft-toplevel):
        # snapshot por tick (LIST), conexão persistente (zero fork), estado
        # para o ciclo por app e o comutador clicável (alt-tab da dock)
        self._sock = None          # conexão com o daemon (persistente)
        self.windows = {}          # id → (flags, rank, app_id, title)
        self.focused = 0           # id da janela focada (0 = nenhuma)
        self._last_act = {}        # app → última janela que NÓS focamos
        self.switch_btn = None     # o comutador clicável (≥2 janelas)
        self._switch_icon_key = None

        self.win = Gtk.Window()
        self.win.set_name("dockwindow")
        GtkLayerShell.init_for_window(self.win)
        # layer BOTTOM — o coração do v2.3.4: janelas normais ficam ACIMA da
        # camada background/bottom (a dock não as cobre), e a tela cheia de
        # qualquer app cobre a dock. O "esconder em tela cheia" é a ordem de
        # renderização do protocolo — não existe código para falhar.
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.BOTTOM)
        # Ancorada SÓ na base: a layer-shell centra no eixo não-ancorado —
        # a superfície TEM o tamanho da pílula (nada de faixa invisível
        # full-width comendo clique ao lado dela).
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.BOTTOM, True)
        # Zona exclusiva automática: maximizadas/tileadas respeitam a faixa
        # da dock ("como funciona as outras distros" — diretriz do dono).
        GtkLayerShell.auto_exclusive_zone_enable(self.win)

        self.pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.pill.set_name("dockbox")
        self.pill.set_margin_bottom(PILL_FLOAT)
        self.win.add(self.pill)

        self.rebuild()

        self.load_css()
        self.win.show_all()
        log(f"dock iniciada: {len(self.buttons)} pin(s) · "
            f"sempre visível (layer BOTTOM — some só sob tela cheia/gaveta) · "
            f"dinâmicos ON (apps abertos sem pin aparecem após o fio)")

        GLib.timeout_add(3000, self.poll_running)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             self.toggle)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                             self.rebuild)
        # v2.9.0 — SEM superfície auxiliar, SEM pid-file, SEM telefone:
        # a dock não recebe pedidos de ninguém. O dismiss de menu é lei do
        # rc.xml (craft-menu-dismiss) — a dock nem fica sabendo que um
        # menu abriu.

    # ── CSS ──────────────────────────────────────────────────────────────
    def load_css(self):
        css = b""
        try:
            with open(CSS_FILE, "rb") as fh:
                css = fh.read()
        except FileNotFoundError:
            log(f"CSS ausente ({CSS_FILE}) — usando fallback embutido")
            css = DEFAULT_CSS
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except GLib.Error as exc:
            log(f"CSS inválido — o fallback embutido entra no lugar: {exc}")
            prov = Gtk.CssProvider()
            prov.load_from_data(DEFAULT_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # ── índice de .desktops (v2.10 — para os dinâmicos) ─────────────────
    def _desktop_index(self):
        """Cache: chave lower → DesktopAppInfo. Uma varredura por sessão
        (Gio.AppInfo.get_all), casando StartupWMClass e o binário do
        commandline. NoDisplay/Hidden NUNCA entram (a gaveta limpa do E21 é
        a mesma lei aqui: xarchiver/papers/nm-connection-editor rodando não
        viram botão — são helpers, não apps de dock)."""
        if self._dindex is None:
            idx = {}
            try:
                apps = Gio.AppInfo.get_all()
            except Exception as exc:  # noqa: BLE001 — index vazio ≠ dock morta
                log(f"get_all falhou ({type(exc).__name__}) — sem dinâmicos")
                apps = []
            for app in apps:
                if not isinstance(app, Gio.DesktopAppInfo):
                    continue
                try:
                    if app.get_nodisplay() or app.get_is_hidden():
                        continue
                except Exception:  # noqa: BLE001 — .desktop exótico não derruba
                    continue
                did = app.get_id() or ""
                if not did:
                    continue
                try:
                    wmc = app.get_string("StartupWMClass") or ""
                except Exception:  # noqa: BLE001
                    wmc = ""
                b = binary_of(app)
                for k in dict.fromkeys(x for x in (wmc.lower(), b.lower()) if x):
                    idx.setdefault(k, app)
            self._dindex = idx
            log(f"índice de .desktops: {len(idx)} chave(s) resolvíveis")
        return self._dindex

    def _resolve_desktop(self, comm):
        """comm do /proc → DesktopAppInfo do app (ou None: não é 'programa'
        no sentido da dock — daemons/shells sem .desktop não viram botão)."""
        return self._desktop_index().get((comm or "").lower())

    # ── pins ─────────────────────────────────────────────────────────────
    def rebuild(self, *_):
        for child in self.pill.get_children():
            self.pill.remove(child)
        self.buttons = []
        self.dyn = {}
        self.sep = None
        self.pin_ids = set()
        # o comutador morreu junto (o poll o recria sozinho — v2.10.1)
        self.switch_btn = None
        self._switch_icon_key = None
        for info, hint in read_pins():
            btn = self._make_button(info, hint, dynamic=False)
            self.pill.pack_start(btn, False, False, 0)
            self.buttons.append((btn, binary_of(info)))
            did = info.get_id() or ""
            if did:
                self.pin_ids.add(did)
        self.pill.show_all()
        self.poll_running()
        # v2.5.0 — GLib.SOURCE_CONTINUE: callback de sinal que retorna False
        # é G_SOURCE_REMOVE — a source morria na 1ª dispatch e a dock
        # ficava SURDA (reload de pins e W-S-d mortos pelo resto da
        # sessão; o audit 24-c flagrou o mecanismo exato).
        return GLib.SOURCE_CONTINUE

    def _make_button(self, info, hint, dynamic=False):
        btn = Gtk.Button.new()
        btn.set_relief(Gtk.ReliefStyle.NONE)
        icon = info.get_icon()
        img = Gtk.Image()
        if icon is not None:
            img.set_from_gicon(icon, Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name("application-x-executable",
                                   Gtk.IconSize.DIALOG)
        img.set_pixel_size(ICON_SIZE)
        btn.add(img)
        # o tooltip ENSINA os verbos (a descoberta não mora escondida —
        # mesma gramática dos tooltips da topbar)
        name = info.get_display_name() or ""
        did = info.get_id() or ""
        cmd = exec_of(info)
        if dynamic:
            btn.set_tooltip_text(
                f"{name} — esquerdo: focar/abrir · direito: fixar na dock · "
                f"meio: fechar janela")
        elif WLRCTL:
            btn.set_tooltip_text(
                f"{name} — esquerdo: focar/abrir · direito: nova janela")
        else:
            btn.set_tooltip_text(f"{name} — clique: abrir")
        if cmd:
            # button-press-event distingue ESQUERDO/DIREITO/MEIO; o return
            # True consome o evento (o "clicked" não refira — zero duplo
            # lançamento); o "clicked" segue ligado para teclado.
            btn.connect("button-press-event", self._press,
                        info, hint, did, cmd, dynamic)
            btn.connect("clicked", self._clicked, info, hint, did, cmd)
        btn.set_name("dockbtn")
        return btn

    # ── o protocolo direto (v2.10.1 — craft-toplevel, linha a linha) ────
    def _tl_connect(self):
        """Conexão PERSISTENTE com o daemon: aberta uma vez, serve N ticks
        sem fork nenhum (a varredura /proc dos indicadores continua à parte).
        Morreu? reconnecta no próximo tick — a dock NUNCA depende dele."""
        if self._sock is not None:
            return self._sock
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(1)
            s.connect(TOPOS)
        except OSError:
            try:
                s.close()
            except OSError:
                pass
            return None
        self._sock = s
        log("craft-toplevel: conectado (janelas reais ON)")
        return s

    def _tl_close(self):
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None

    def _tl_cmd(self, cmd):
        """Um pedido linha-a-linha; resposta = linhas até OK*/ERR* (e PONG).
        Daemon morto/EPIPE → None — e TODO devolvedor de None tem fallback
        v2.10 logo atrás (wlrctl/launch): a cura nunca quebra o básico."""
        s = self._tl_connect()
        if s is None:
            return None
        try:
            s.sendall((cmd + "\n").encode())
            buf = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    raise OSError("daemon fechou")
                buf += chunk
                lines = buf.split(b"\n")
                if lines[-1] != b"":
                    continue  # resposta parcial — LIST grande segue chegando
                out = [l.decode("utf-8", "replace") for l in lines[:-1]]
                if out and (out[-1].startswith(("OK", "ERR", "PONG"))):
                    return out
        except (OSError, UnicodeDecodeError):
            self._tl_close()
            return None

    def _tl_list(self):
        """LIST → ({id: (flags, rank, app_id, title)}, focused_id) ou None.
        rank = recência do daemon (0 = topo do MRU — a semântica do alt-tab)."""
        out = self._tl_cmd("LIST")
        if out is None:
            return None
        wins = {}
        focused = 0
        for line in out:
            if line.startswith("W|"):
                parts = line.split("|", 5)
                if len(parts) == 6:
                    try:
                        wid, flags, rank = (int(parts[1]), int(parts[2]),
                                            int(parts[3]))
                    except ValueError:
                        continue
                    wins[wid] = (flags, rank, parts[4], parts[5])
            elif line.startswith("OK|"):
                try:
                    focused = int(line[3:])
                except ValueError:
                    focused = 0
        return (wins, focused)

    def _tl_act(self, wid):
        """Foco/restauro POR ID: unset_minimized + activate no daemon — a
        restauração de minimizada é COMANDO DO PROTOCOLO, não hipótese."""
        out = self._tl_cmd(f"ACT {wid}")
        return bool(out) and out[-1].startswith("OK")

    def _tl_close_win(self, wid):
        out = self._tl_cmd(f"CLOSE {wid}")
        return bool(out) and out[-1].startswith("OK")

    def _windows_of(self, info, hint, did):
        """Janelas REAIS do app no snapshot: app_id casa os candidatos
        (case-insensitive — o fim da adivinhação de capitalização do
        wlrctl) ou o título contém o nome de exibição (último recurso)."""
        cands = {c.lower() for c in self._focus_candidates(info, hint, did)}
        name = (info.get_display_name() or "").strip().lower()
        out = []
        for wid, (_fl, _rk, app_id, title) in self.windows.items():
            a = (app_id or "").lower()
            t = (title or "").lower()
            if a in cands or (name and name in t):
                out.append(wid)
        return sorted(out)

    def _app_cycle_next(self, wids, key):
        """A próxima janela DO APP depois da última que NÓS focamos (ring por
        id); sem memória, a focada de verdade; sem focada, a mais recente
        (menor rank = topo do MRU do daemon)."""
        last = self._last_act.get(key)
        if last in wids:
            i = wids.index(last)
            return wids[(i + 1) % len(wids)]
        fw = [w for w in wids if self.windows[w][0] & F_ACTIVATED]
        if fw:
            return fw[0]
        return min(wids, key=lambda w: self.windows[w][1])

    # ── o COMUTADOR clicável (v2.10.1 — o alt-tab do dono na dock) ───────
    def _switch_target(self):
        """Onde o próximo clique do comutador VAI cair: a janela seguinte no
        anel MRU do daemon depois da focada (o exato A-Tab, em clique).
        Sem focada, a mais recente. → (id, app_id, title) ou None."""
        if len(self.windows) < 2:
            return None
        ranks = {w: v[1] for w, v in self.windows.items()}
        f_rank = ranks.get(self.focused, -1)
        targets = [w for w in self.windows if ranks[w] > f_rank]
        if targets:
            wid = min(targets, key=lambda w: ranks[w])
        else:
            # a focada é o topo do MRU: alvo = a segunda do anel
            wid = sorted(self.windows, key=lambda w: ranks[w])[1]
        _fl, _rk, app_id, title = self.windows[wid]
        return (wid, app_id, title)

    def _sync_switcher(self):
        """O botão comutador existe SÓ com ≥2 janelas e daemon vivo (zero
        poluição — minimalista). Ícone = o ÍCONE do app de DESTINO: o clique
        anuncia para onde vai, SEM preview e SEM miniatura nenhuma."""
        tgt = self._switch_target()
        if tgt is None:
            if self.switch_btn is not None:
                self.pill.remove(self.switch_btn)
                self.switch_btn.destroy()
                self.switch_btn = None
                self._switch_icon_key = None
                self.pill.show_all()
            return
        _wid, app_id, title = tgt
        if self.switch_btn is None:
            self.switch_btn = Gtk.Button.new()
            self.switch_btn.set_relief(Gtk.ReliefStyle.NONE)
            self.switch_btn.set_name("switchbtn")
            img = Gtk.Image()
            img.set_pixel_size(ICON_SIZE)
            self.switch_btn.add(img)
            self.switch_btn.connect("button-press-event", self._switch_press)
            self.switch_btn.connect("clicked", self._switch_click)
            self.pill.pack_start(self.switch_btn, False, False, 0)
            self.pill.reorder_child(self.switch_btn, -1)
            self.pill.show_all()
            log("comutador entrou (≥2 janelas)")
        key = app_id or title
        if key != self._switch_icon_key:
            self._switch_icon_key = key
            img = self.switch_btn.get_child()
            info = self._desktop_index().get((app_id or "").lower())
            icon = info.get_icon() if info is not None else None
            if icon is not None:
                img.set_from_gicon(icon, Gtk.IconSize.DIALOG)
            else:
                img.set_from_icon_name("preferences-system-windows",
                                       Gtk.IconSize.DIALOG)
            name = (info.get_display_name() if info is not None else None) \
                or title or app_id or "janela"
            self.switch_btn.set_tooltip_text(
                f"Alternar janelas — próxima: {name}")
            self.pill.show_all()

    def _switch_press(self, _btn, ev):
        # esquerdo segue para o "clicked" (mesmo verbo); direito/meio: nada
        return ev.button != 1

    def _switch_click(self, _btn):
        out = self._tl_cmd("CYCLE")
        if out is not None and out[-1].startswith("OK"):
            parts = out[-1].split("|", 3)
            if len(parts) == 4:
                log(f"comutador: → {parts[2]} ({parts[3]})")
        else:
            log("comutador: daemon indisponível — nada alternado")

    # ── os VERBOS do clique (v2.7 + v2.10 + v2.10.1) ─────────────────────
    def _press(self, btn, ev, info, hint, did, cmd, dynamic=False):
        if ev.button == 3:
            if dynamic:
                self._pin_add(did)                  # direito no dinâmico: FIXAR
            else:
                self._launch(btn, cmd)              # direito no pin: OUTRA instância
            return True                              # consumido — sem "clicked"
        if ev.button == 2:
            # v2.10.1 — o meio fecha a janela POR ID (a focada do app, ou a
            # primeira); sem snapshot/daemon, o wlrctl da v2.10 assume.
            if self.windows:
                wids = self._windows_of(info, hint, did)
                if wids:
                    fw = [w for w in wids
                          if self.windows[w][0] & F_ACTIVATED]
                    if self._tl_close_win((fw or wids)[0]):
                        log(f"fechado por id {(fw or wids)[0]}")
                        return True
            if WLRCTL:
                self._close_windows(info, hint, did)  # meio: fechar (gracioso)
                return True
            return False
        if ev.button == 1:
            self._focus_or_launch(info, hint, did, cmd)  # esquerdo
            return True
        return False  # outros: GtkButton decide (clicked = esquerdo)

    def _clicked(self, _btn, info, hint, did, cmd):
        # teclado (Espaço/Enter) = o mesmo verbo do esquerdo
        self._focus_or_launch(info, hint, did, cmd)

    def _focus_candidates(self, info, hint, did):
        # ordem de adivinha: hint explícito → StartupWMClass → binário →
        # stem do desktop-id; dedup preservando a ordem
        cands = []
        if hint:
            cands.append(hint)
        try:
            wmc = info.get_string("StartupWMClass") or ""
        except Exception:  # noqa: BLE001 — .desktop exótico não derruba a dock
            wmc = ""
        if wmc:
            cands.append(wmc)
        b = binary_of(info)
        if b:
            cands.append(b)
        stem = did[:-8] if did.endswith(".desktop") else did
        if stem:
            cands.append(stem)
        return list(dict.fromkeys(c for c in cands if c))

    def _wlrctl(self, verb, key, value):
        """Uma chamada ao wlrctl; rc=0 = o compositor casou e executou."""
        if not WLRCTL:
            return False
        try:
            r = subprocess.run(
                [WLRCTL, "window", verb, f"{key}:{value}"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=1)
        except subprocess.TimeoutExpired:
            return False
        except OSError:
            return False
        return r.returncode == 0

    def _focus_or_launch(self, info, hint, did, cmd):
        b = binary_of(info)
        # NÃO rodando: abrir DIRETO (zero subprocesso no caminho comum —
        # o clique responde na hora). O check é case-insensitive: o comm
        # do /proc pode ter capitalização própria ("Thunar").
        alive = any((x.lower() == b.lower()) for x in self.running) if b else False
        # v2.10.1 — CAMINHO DO PROTOCOLO (janelas reais por id): 1 janela =
        # foca/restaura; N janelas = cicla ENTRE ELAS (o alt-tab do dono,
        # dentro do botão do app); ACT falhou/janela sumiu = fallback abaixo.
        if self.windows:
            wids = self._windows_of(info, hint, did)
            if wids:
                key = did or b
                if len(wids) == 1:
                    if self._tl_act(wids[0]):
                        self._last_act[key] = wids[0]
                        log(f"foco por id {wids[0]}")
                        return
                else:
                    nxt = self._app_cycle_next(wids, key)
                    if nxt is not None and self._tl_act(nxt):
                        self._last_act[key] = nxt
                        log(f"ciclo do app: id {nxt} ({len(wids)} janelas)")
                        return
        if not (WLRCTL and alive):
            self._launch(None, cmd)
            return
        # rodando: FOCAR. Para cada candidato, 3 formas canônicas de app_id
        # (a cura v2.10 do case-sensitive que abria nova sessão no Brave);
        # por último, o TÍTULO com o nome do app (alguns apps expõem o nome
        # no título e não no app_id). rc=0 vence; TODOS falharam → abre
        # (nunca pior que a era v2.6).
        for c in self._focus_candidates(info, hint, did):
            for v in case_variants(c):
                if self._wlrctl("focus", "app_id", v):
                    log(f"foco: app_id:{v}")
                    return
        name = (info.get_display_name() or "").strip()
        if name:
            for v in case_variants(name):
                if self._wlrctl("focus", "title", v):
                    log(f"foco: title:{v}")
                    return
        log(f"foco sem match ({', '.join(self._focus_candidates(info, hint, did))}) — abrindo")
        self._launch(None, cmd)

    def _close_windows(self, info, hint, did):
        """v2.10: o verbo do MEIO — fechar (WM_DELETE gracioso; o app
        confirma se tiver o que salvar)."""
        closed = False
        for c in self._focus_candidates(info, hint, did):
            for v in case_variants(c):
                if self._wlrctl("close", "app_id", v):
                    log(f"fechado: app_id:{v}")
                    closed = True
                    break
            if closed:
                break
        if not closed:
            log("fechar sem match — nada encerrado")

    def _pin_add(self, did):
        """v2.10: direito num DINÂMICO fixa o app (o mesmo craft-pin de
        sempre: fuzzy resolve, .bak e reload SIGUSR2 — a dock re-lê sozinha)."""
        if not did:
            return
        try:
            r = subprocess.run(
                ["/usr/local/bin/craft-pin", "add", did],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=10)
        except (subprocess.TimeoutExpired, OSError) as exc:
            log(f"craft-pin add falhou ({type(exc).__name__}): {did}")
            return
        if r.returncode == 0:
            log(f"fixado via craft-pin: {did}")
        else:
            log(f"craft-pin add rc={r.returncode}: {did}")

    def _launch(self, _btn, cmd):
        try:
            subprocess.Popen(cmd, shell=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True)
            log(f"lançado: {cmd}")
        except OSError as exc:
            log(f"falha ao lançar {cmd}: {exc}")

    # ── o poll (v2.10 — /proc direto, pins + dinâmicos no MESMO scan) ────
    # v2.5.0 — o indicador nasceu com 1 fork POR PIN a cada 3s; virou UM
    # pgrep com alternância ERE (audit 24-b). v2.10 — o fork inteiro morreu:
    # a leitura DIRETA de /proc/<pid>/comm (uid do usuário) N leituras sem
    # NENHUM fork, sem ERE para escapar, e o MESMO scan alimenta os botões
    # dinâmicos (um só lugar onde "aberto" existe).
    def _scan_user_comms(self):
        uid = os.getuid()
        comms = set()
        try:
            pids = os.listdir("/proc")
        except OSError:
            return comms
        for pid in pids:
            if not pid.isdigit():
                continue
            try:
                if os.stat(f"/proc/{pid}").st_uid != uid:
                    continue
                with open(f"/proc/{pid}/comm") as fh:
                    c = fh.read().strip()
                if c:
                    comms.add(c)
            except OSError:
                continue
        return comms

    def poll_running(self):
        self.running = self._scan_user_comms()
        for btn, binary in self.buttons:
            ctx = btn.get_style_context()
            if binary and any(x.lower() == binary.lower()
                              for x in self.running):
                ctx.add_class("running")
            else:
                ctx.remove_class("running")
        self._sync_dynamic()
        # v2.10.1 — snapshot de janelas reais + comutador (um só tick):
        # daemon morto = janelas vazias (fallbacks assumem) e comutador fora
        snap = self._tl_list()
        if snap is None:
            self.windows = {}
            self.focused = 0
        else:
            self.windows, self.focused = snap
        self._sync_switcher()
        return True

    # ── dinâmicos (v2.10 — a dock auto-adaptável) ───────────────────────
    def _sync_dynamic(self):
        """Apps rodando SEM pin e COM .desktop → botão após o fio. Ao fechar,
        o botão some sozinho (até restar só o fixado). Diff por desktop-id:
        nada toca no GTK se nada mudou (zero flicker no tick de 3s)."""
        current = {}
        for comm in self.running:
            info = self._resolve_desktop(comm)
            if info is None:
                continue
            did = info.get_id() or ""
            if not did or did in self.pin_ids or did in current:
                continue
            cmd = exec_of(info)
            if not cmd:
                continue
            current[did] = (info, comm)
        if set(current) == set(self.dyn):
            return
        dead = set(self.dyn) - set(current)
        for did in sorted(dead):
            btn = self.dyn[did][0]
            btn.destroy()
            del self.dyn[did]
            log(f"dinâmico saiu: {did}")
        fresh = set(current) - set(self.dyn)
        for did in sorted(fresh):
            info, comm = current[did]
            btn = self._make_button(info, "", dynamic=True)
            self.pill.pack_start(btn, False, False, 0)
            self.dyn[did] = (btn, comm, info, exec_of(info))
            log(f"dinâmico entrou: {did} (comm {comm})")
        # o fio só existe quando há os dois lados
        if self.dyn and self.buttons and self.sep is None:
            self.sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
            self.sep.set_name("dynsep")
            self.sep.set_margin_top(8)
            self.sep.set_margin_bottom(8)
            self.pill.pack_start(self.sep, False, False, 0)
            self.pill.reorder_child(self.sep, len(self.buttons))
        elif (not self.dyn or not self.buttons) and self.sep is not None:
            self.sep.destroy()
            self.sep = None
        # v2.10.1 — o comutador é SEMPRE o último da pílula (os dinâmicos
        # entram com pack_start no fim — reorder devolve a ordem)
        if self.switch_btn is not None:
            self.pill.reorder_child(self.switch_btn, -1)
        if self.dyn or fresh or dead:
            self.pill.show_all()

    def toggle(self, *_):
        # v2.3.4: esconder é ESCOLHA do usuário (W-S-d) — nunca decisão
        # automática. Escondida, a zona exclusiva vai embora junto (a
        # superfície desmapeada libera a faixa — comportamento padrão).
        if self.shown:
            self.win.hide()
            self.shown = False
            log("toggle: dock escondida (W-S-d)")
        else:
            self.win.show_all()
            self.shown = True
            log("toggle: dock visível (W-S-d)")
        return GLib.SOURCE_CONTINUE


DEFAULT_CSS = b"""
#dockwindow { background: transparent; }
#dockbox {
  background: rgba(5, 5, 8, 0.88);
  border: 1px solid rgba(22, 22, 31, 0.8);
  border-radius: 20px;
  padding: 4px 10px;
}
#dockbox button {
  padding: 4px;
  min-height: 44px;
  min-width: 44px;
  border-radius: 12px;
  background: transparent;
  border: none;
}
#dockbox button:hover { background: rgba(22, 22, 31, 0.95); }
#dockbox button.running { box-shadow: inset 0 -3px 0 rgba(205, 214, 244, 0.8); }
#dockbox separator {
  min-width: 1px;
  margin: 8px 7px;
  background: rgba(108, 112, 134, 0.45);
}
"""


def main():
    if not os.environ.get("WAYLAND_DISPLAY"):
        # v2.3.1: essa morte também fica LOUD no bars.log — o craft-bars
        # registra o exit=0 e o probe conta BARS_EXITS (nada calado)
        log("sem WAYLAND_DISPLAY — saindo (a dock só vive na sessão)")
        return 0
    try:
        Dock()
    except Exception as exc:  # noqa: BLE001 — o log é a evidência do boot
        log(f"FATAL: {exc}")
        raise
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
