#!/bin/sh
# craft-power — menu de sessão MOUSE-FIRST (Desktop v2.1)
# ─────────────────────────────────────────────────────────────────────────
# v2.1 (diretriz do dono: "menu que fica na barra superior no canto
# direito"): dropdown vertical ANCORADO no canto superior direito, logo
# abaixo do botão ⏻ da waybar — fuzzel em modo dmenu (anchor=top-right),
# tema Catppuccin Mocha do fuzzel.ini, Esc fecha sem fazer nada.
# Fallback: labnag (o "nag bar" nativo do labwc) se o fuzzel faltar.
#
# v1.4 (burn test do dono na v1.3 ao vivo): TOGGLE — apertar ⏻ de novo
# com o menu aberto agora FECHA o menu (antes: cada pressão empilhava
# OUTRO fuzzel na frente do desktop e nada fechava — "esse tipo de erro
# não pode existir"). Detecta a instância pelo prompt único 'Sessão'
# (o craft-connect usa prompt 'Rede' — nunca colidem).
set -eu

# TOGGLE v1.4: menu de sessão aberto? fecha e sai (2ª pressão = fechar)
if pgrep -f 'fuzzel.*--prompt=Sess' >/dev/null 2>&1; then
    pkill -f 'fuzzel.*--prompt=Sess' 2>/dev/null || true
    exit 0
fi
# fallback labnag aberto (t -t 86400)? também vira toggle
if pgrep -x labnag >/dev/null 2>&1; then
    pkill -x labnag 2>/dev/null || true
    exit 0
fi
# v1.8.2 — CROSS-DISMISS (pedido do dono: "abro o menu de rede, clico no
# desligar, o de rede tem que SAIR da tela"): abrir Sessão fecha o menu
# de Rede — nunca dois dropdowns empilhados na frente do desktop.
pkill -f 'fuzzel.*--prompt=Rede' 2>/dev/null || true

if command -v fuzzel >/dev/null 2>&1; then
    # anchor top-right + margens: colado no canto, 44px abaixo do topo
    # (a menu bar tem 34px — o dropdown nasce "pendurado" nela);
    # --lines 5 = altura exata das opções, sem lista vazia.
    # v2.2 (leveza radical): entradas TEXTO PURO — o protocolo de ícones do
    # dmenu (NUL + icon + US + path) morreu com o papirus-icon-theme; sem
    # tema de ícones na ISO não existe path garantido, e o case de baixo
    # sempre leu o texto antes do NUL — o fluxo segue idêntico.
    choice="$(printf '%s\n' \
        'Travar tela' \
        'Sair da sessão' \
        'Suspender' \
        'Reiniciar' \
        'Desligar' \
        | fuzzel --dmenu \
        --anchor=top-right --x-margin=10 --y-margin=44 \
        --lines=5 --width=26 --prompt='Sessão  ' 2>/dev/null || true)"
else
    # fallback: labnag — barra de botões no topo (Lock · Logout · Reboot …)
    if command -v labnag >/dev/null 2>&1; then
        exec labnag \
            -t 86400 \
            -e top \
            -y overlay \
            -k none \
            -m 'Sessão' \
            --background-color 1e1e2eee \
            --text-color cdd6f4ff \
            --button-background-color 313244ff \
            --button-text-color cdd6f4ff \
            --button-border-color 45475aff \
            --border-bottom-color cba6f7ff \
            -Z 'Lock' 'craft-lock' \
            -Z 'Logout' 'labwc --exit' \
            -Z 'Suspend' 'systemctl suspend' \
            -Z 'Reboot' 'systemctl reboot' \
            -Z 'Desligar' 'systemctl poweroff' \
            -Z 'Cancelar' 'true'
    fi
    choice=''   # sem fuzzel nem labnag: sai limpo (W-x/craft-logout no rc.xml)
fi

case "$choice" in
    'Travar tela')    exec craft-lock ;;
    'Sair da sessão') labwc --exit ;;
    'Suspender')      systemctl suspend ;;
    'Reiniciar')      systemctl reboot ;;
    'Desligar')       systemctl poweroff ;;
    *)                exit 0 ;;   # Esc/vazio: menu fecha e NADA acontece
esac
