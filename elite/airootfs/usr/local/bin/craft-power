#!/bin/sh
# craft-power — menu de sessão MOUSE-FIRST (Desktop v2.1)
# ─────────────────────────────────────────────────────────────────────────
# v2.6.0 — O SESSÃO que o dono aprovou, sem o peso que ele apontou:
#   · "é necessária essa opção de travar tela?" — NÃO: o menu fica
#     minimalista e o item de travar a tela sai (o lock segue vivo no W-l
#     e passa a ser PARTE do suspender — acordou, a tela está travada);
#   · "o suspender tenta mas rapidamente liga e fica como se eu só
#     tivesse clicado em travar tela" — a causa: o systemctl suspend SEM
#     -i morre calado quando um app (navegador/players) segura inibidor
#     de sono — o lock fica e o PC nunca desliga os olhos. Agora: trava
#     PRIMEIRO (hyprlock sobe antes de dormir) e suspende com -i
#     (inibidores IGNORADOS — quem pede delay de sono não manda no dono);
#   · menus com âncora no BOTÃO do power (--at=power — craft-menu v4).
# v2.4.0 — O MOTOR QUE JÁ ABRIA: o craft-menu v3 voltou ao motor do
# launcher (a era GTK+layer-shell do menu saiu de cena — nunca abriu no
# rig do dono, nem a nativa nem a gaiola). Gramática 0/1/143 intocada.
# v2.3.8 — "o que eu queria centralizar é o nome do menu e remover a barra
# que fica, tipo 'Rede |'" — agora a v4 cura de vez (lista pura, sem
# linha de digitação). v2.1 dropdown · v1.4 TOGGLE · v2.3.1 fim do
# silêncio.
# ─────────────────────────────────────────────────────────────────────────
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    # teto de 256 KiB (mesma política do bars.log — evidência recente vale mais)
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# fallback labnag aberto (t -t 86400)? também vira toggle
if pgrep -x labnag >/dev/null 2>&1; then
    pkill -x labnag 2>/dev/null || true
    exit 0
fi

if command -v craft-menu >/dev/null 2>&1; then
    mlog "Sessão: abrindo (craft-menu)"
    errf="$(mktemp)"
    ec=0
    choice="$(craft-menu --title='Sessão' --at=power \
        'Sair da sessão' \
        'Suspender' \
        'Reiniciar' \
        'Desligar' \
        'Tempo de idle…' \
        'Rollback do sistema…' \
        2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # v2.3.5 — SIGTERM = fechado de fora (cross-dismiss: outro menu
        # abriu) — benigno: sem notify crítico falso (o print do dono).
        mlog "Sessão: fechado de fora (SIGTERM — cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 2 ]; then
        # v2.3.8 — TOGGLE estrutural: a 2ª chamada fechou a 1ª (a lei mora
        # no craft-menu) — nada a mostrar.
        mlog "Sessão: toggle — 2ª chamada fechou o menu — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ]; then
        # v2.3.10 — fechar NUNCA é erro (ESC/clique fora), COM OU SEM
        # stderr: o GTK emite warnings benignos no destroy (o gate velho
        # '! -s "$errf"' transformava TODO fechamento normal em FALHOU
        # com toast crítico ETERNO — a pilha de notificações da foto do
        # dono). stderr vai pro log, nunca pra tela.
        if [ -s "$errf" ]; then
            mlog "Sessão: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        else
            mlog "Sessão: fechado pelo usuário (ESC) — benigno"
        fi
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Sessão: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        # v2.3.10 — falha REAL avisa e SOME: -u normal + -t 8000 +
        # timeout 5 (daemon preso nunca prende o chamador).
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                'Menu de Sessão falhou' \
                "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"
else
    mlog "Sessão: craft-menu AUSENTE — fallback labnag"
    # fallback: labnag — barra de botões no topo (Lock · Logout · Reboot …)
    if command -v labnag >/dev/null 2>&1; then
        exec labnag \
            -t 86400 \
            -e top \
            -y overlay \
            -k none \
            -m 'Sessão' \
            --background-color 1e1e2eee \
            --text-color cdd6f4ff \
            --button-background-color 313244ff \
            --button-text-color cdd6f4ff \
            --button-border-color 45475aff \
            --border-bottom-color cba6f7ff \
            -Z 'Lock' 'craft-lock' \
            -Z 'Logout' 'labwc --exit' \
            -Z 'Suspend' 'systemctl suspend' \
            -Z 'Reboot' 'systemctl reboot' \
            -Z 'Desligar' 'systemctl poweroff' \
            -Z 'Cancelar' 'true'
    fi
    choice=''   # sem craft-menu nem labnag: sai limpo (W-x/craft-logout no rc.xml)
fi

case "$choice" in
    'Sair da sessão') labwc --exit ;;
    'Suspender')
        # v2.6.0 — trava PRIMEIRO (acordou = tela travada, só o wallpaper
        # borrado) e suspende IGNORANDO inibidores: o -i é a cura do
        # "tenta mas rapidamente liga" (o inibidor de sono de app matava
        # o suspend calado e sobrava só o lock). O 0.6s dá tempo do
        # hyprlock mapear antes de a tela apagar.
        ( craft-lock >/dev/null 2>&1 & )
        sleep 0.6
        if ! systemctl suspend -i >/dev/null 2>&1; then
            mlog "Sessão: suspend falhou mesmo com -i — avisando"
            command -v notify-send >/dev/null 2>&1 && \
                timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                    'Suspender falhou' \
                    'O sistema recusou a suspensão — journal: ~/.cache/elite/menus.log' || true
        fi
        exit 0 ;;
    'Reiniciar')
        # v2.9.0 — FIM DO SILÊNCIO (o dono, rig v2.8.0: "o click no menu de
        # encerrar não está encerrando as tarefas"): a causa raiz foi a
        # gaiola da v2.8 engolindo o clique (até o diálogo do polkit ficava
        # intocável) — morta na v2.9. A cinta que fica: se o systemctl
        # RECUSAR por qualquer motivo (polkit, inibidor, logind), o erro
        # NUNCA morre calado — log + toast crítico na tela.
        if ! systemctl reboot 2>>"$MLOG"; then
            mlog "Sessão: reboot RECUSADO pelo sistema — detalhe no fim do log"
            command -v notify-send >/dev/null 2>&1 && \
                timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                    'Reiniciar falhou' \
                    'O sistema recusou o reboot — detalhe em ~/.cache/elite/menus.log' || true
        fi ;;
    'Desligar')
        # v2.9.0 — mesma cinta do Reiniciar (falha NUNCA é silêncio).
        if ! systemctl poweroff 2>>"$MLOG"; then
            mlog "Sessão: poweroff RECUSADO pelo sistema — detalhe no fim do log"
            command -v notify-send >/dev/null 2>&1 && \
                timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                    'Desligar falhou' \
                    'O sistema recusou o desligamento — detalhe em ~/.cache/elite/menus.log' || true
        fi ;;
    # v2.3.6 — descoberta do idle: o dono perguntou 'tem como controlar o
    # tempo de idle facilmente?' — o craft-idle JÁ fazia, mas morava só no
    # menu do desktop. Agora o Sessão carrega (as ações de energia e o
    # controle do idle na mesma porta — UX de um só lugar).
    'Tempo de idle…') exec craft-idle ;;
    # v2.5.0 — o craft-rollback ganha PORTA DE ENTRADA (o menu completo de
    # snapshots v2.3.6 não tinha NENHUM chamador — órfão de UX flagrado
    # pelo audit 24-a; a porta natural é a do sistema: Sessão).
    'Rollback do sistema…') exec craft-rollback ;;
    *)                exit 0 ;;   # Esc/vazio: menu fecha e NADA acontece
esac
