#!/bin/sh
# craft-power — menu de sessão MOUSE-FIRST (Desktop v2.1)
# ─────────────────────────────────────────────────────────────────────────
# v2.1 (diretriz do dono: "menu que fica na barra superior no canto
# direito"): dropdown vertical ANCORADO no canto superior direito, logo
# abaixo do botão ⏻ da waybar — fuzzel em modo dmenu (anchor=top-right),
# tema Catppuccin Mocha do fuzzel.ini, Esc fecha sem fazer nada.
# Fallback: labnag (o "nag bar" nativo do labwc) se o fuzzel faltar.
#
# v1.4 (burn test do dono na v1.3 ao vivo): TOGGLE — apertar ⏻ de novo
# com o menu aberto agora FECHA o menu (antes: cada pressão empilhava
# OUTRO fuzzel na frente do desktop e nada fechava — "esse tipo de erro
# não pode existir"). Detecta a instância pelo prompt único 'Sessão'
# (o craft-connect usa prompt 'Rede' — nunca colidem).
#
# v2.3.1 — FIM DO SILÊNCIO (rig do dono, v2.1.1: "os menus morreram e não
# funcionam"): fuzzel que não abre é morte CALADA (o stderr ia pro
# /dev/null e o menu só não aparecia — sem um rastro sequer). Agora todo
# open e toda falha deixa linha em ~/.cache/elite/menus.log e a falha
# AINDA avisa na tela (notify-send). Log vazio = clique nunca chegou ao
# script (problema de handler da waybar); "aberto" sem menu na tela =
# fuzzel morreu DEPOIS de abrir (problema de render/protocolo).
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    # teto de 256 KiB (mesma política do bars.log — evidência recente vale mais)
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# TOGGLE v1.4: menu de sessão aberto? fecha e sai (2ª pressão = fechar)
if pgrep -f 'fuzzel.*--prompt=Sess' >/dev/null 2>&1; then
    pkill -f 'fuzzel.*--prompt=Sess' 2>/dev/null || true
    exit 0
fi
# fallback labnag aberto (t -t 86400)? também vira toggle
if pgrep -x labnag >/dev/null 2>&1; then
    pkill -x labnag 2>/dev/null || true
    exit 0
fi
# v1.8.2 — CROSS-DISMISS (pedido do dono: "abro o menu de rede, clico no
# desligar, o de rede tem que SAIR da tela"): abrir Sessão fecha o menu
# de Rede — nunca dois dropdowns empilhados na frente do desktop.
pkill -f 'fuzzel.*--prompt=Rede' 2>/dev/null || true
# v2.3.4 — o menu de processos (craft-bgapps) entra na mesma lei.
pkill -f 'fuzzel.*--prompt=Encer' 2>/dev/null || true
# v2.3.6 — o prompt de senha do picker Wi-Fi entra na lei do cross-dismiss
pkill -f 'fuzzel.*--prompt=Senha' 2>/dev/null || true

if command -v fuzzel >/dev/null 2>&1; then
    # anchor top-right + margens: colado no canto, 44px abaixo do topo
    # (a menu bar tem 36px — o dropdown nasce "pendurado" nela);
    # --lines 5 = altura exata das opções, sem lista vazia.
    # v2.2 (leveza radical): entradas TEXTO PURO — o protocolo de ícones do
    # dmenu (NUL + icon + US + path) morreu com o papirus-icon-theme; sem
    # tema de ícones na ISO não existe path garantido, e o case de baixo
    # sempre leu o texto antes do NUL — o fluxo segue idêntico.
    # v2.3.1: stderr CAPTURADO (era /dev/null) — exit != 0 = crash do fuzzel
    # (config/protocolo) → log + notify; Esc = exit 0 com choice vazio.
    mlog "Sessão: abrindo (fuzzel)"
    errf="$(mktemp)"
    ec=0
    choice="$(printf '%s\n' \
        'Travar tela' \
        'Sair da sessão' \
        'Suspender' \
        'Reiniciar' \
        'Desligar' \
        'Tempo de idle…' \
        | fuzzel --dmenu \
        --anchor=top-right --x-margin=10 --y-margin=44 \
        --lines=6 --width=26 --prompt='Sessão  ' 2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # v2.3.5 — SIGTERM = fechado de fora (toggle/cross-dismiss) —
        # benigno: sem notify crítico falso (o print do dono).
        mlog "Sessão: fechado de fora (SIGTERM — toggle/cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ] && [ ! -s "$errf" ]; then
        # v2.3.6 — ESC = fechado pelo usuário (stderr vazio ≠ crash) —
        # benigno: fechar NUNCA é erro (o rig flagrou "erro 1" no fechamento
        # normal da Rede; mesma classe do 143).
        mlog "Sessão: fechado pelo usuário (ESC) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Sessão: FUZZEL FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -a 'Elite' -u critical 'Menu de Sessão falhou' \
                "fuzzel exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"
else
    mlog "Sessão: fuzzel AUSENTE — fallback labnag"
    # fallback: labnag — barra de botões no topo (Lock · Logout · Reboot …)
    if command -v labnag >/dev/null 2>&1; then
        exec labnag \
            -t 86400 \
            -e top \
            -y overlay \
            -k none \
            -m 'Sessão' \
            --background-color 1e1e2eee \
            --text-color cdd6f4ff \
            --button-background-color 313244ff \
            --button-text-color cdd6f4ff \
            --button-border-color 45475aff \
            --border-bottom-color cba6f7ff \
            -Z 'Lock' 'craft-lock' \
            -Z 'Logout' 'labwc --exit' \
            -Z 'Suspend' 'systemctl suspend' \
            -Z 'Reboot' 'systemctl reboot' \
            -Z 'Desligar' 'systemctl poweroff' \
            -Z 'Cancelar' 'true'
    fi
    choice=''   # sem fuzzel nem labnag: sai limpo (W-x/craft-logout no rc.xml)
fi

case "$choice" in
    'Travar tela')    exec craft-lock ;;
    'Sair da sessão') labwc --exit ;;
    'Suspender')      systemctl suspend ;;
    'Reiniciar')      systemctl reboot ;;
    'Desligar')       systemctl poweroff ;;
    # v2.3.6 — descoberta do idle: o dono perguntou 'tem como controlar o
    # tempo de idle facilmente?' — o craft-idle JÁ fazia, mas morava só no
    # menu do desktop. Agora o Sessão carrega (as ações de energia e o
    # controle do idle na mesma porta — UX de um só lugar).
    'Tempo de idle…') exec craft-idle ;;
    *)                exit 0 ;;   # Esc/vazio: menu fecha e NADA acontece
esac
