#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · calamares-elite-log (v2.0 — A LEI DO LOG SILENCIOSO)
# ═══════════════════════════════════════════════════════════════════════════
# Histórico: a v1.9 cumpria o spec M1.2 original exibindo o log do instalador
# numa janela de terminal que se abria SOZINHA antes do instalador subir. O
# dono aposentou isso na v2.9.2 ("Log calamaris não precisa mais abrir um
# terminal só pra aparecer logs") — sujeira visual da mesma família do
# debloat: nada aparece sem pedido. AUDITORIA v2.9.2: este era o ÚNICO spawn
# de terminal/janela iniciado pelo sistema em toda a ISO — todos os outros
# (W-Return/C-A-t, monitor de processos, mixer, TUIs de fallback do
# craft-connect) são resposta a pedido do usuário.
#
# 2 frentes (a lei agora):
#   1. LOG PERSISTENTE — no fim (qualquer que seja o resultado) o log
#      completo vai para /var/log/calamares.log do AMBIENTE DO INSTALADOR
#      e é COPIADO para o /var/log do SISTEMA INSTALADO (auditoria pós-boot,
#      exatamente o que o spec M1.2 pede). Log é ARQUIVO para AUDITORIA —
#      não é janela para interromper. O session.log do Calamares continua
#      nascendo em ~/.cache/calamares/ (nativo do instalador).
#   2. LAUNCHER OFICIAL — o calamares.desktop da Elite aponta para ESTE
#      script; o launch.sh upstream permanece intocado (curado na v1.6).
# ═══════════════════════════════════════════════════════════════════════════
SESSION="${XDG_CACHE_HOME:-$HOME/.cache}/calamares/session.log"
[ -d "$(dirname "$SESSION")" ] || mkdir -p "$(dirname "$SESSION")"

# (1) instalador upstream curado (E5a2 — intocado)
/etc/calamares/launch.sh
RC=$?

# (1b) log completo → /var/log do ambiente do instalador…
if [ -f "$SESSION" ]; then
    mkdir -p /var/log
    cp -f "$SESSION" /var/log/calamares.log 2>/dev/null || true
    chmod 644 /var/log/calamares.log 2>/dev/null || true
    echo "ELITE: log do Calamares persistido em /var/log/calamares.log (instalador)"
fi
# …e copiado para o /var/log do SISTEMA INSTALADO (auditoria dentro do alvo).
# v2.10.6 — O ALVO REAL (achado D4 da Rodada 2): o mountPoint do Calamares
# é um mkdtemp 'calamares-root-*' (mount/main.py upstream) — os caminhos
# /mnt/elite e /mnt eram CÓDIGO MORTO (nunca existiram). A cópia de verdade
# para o disco instalado é o preservefiles UPSTREAM (log → /var/log/
# Calamares.log no alvo) — a promessa v2.0 se cumpre por esse mecanismo;
# o glob abaixo é a cópia best-effort QUANDO o alvo ainda existe no disco.
for tgt in /mnt/elite /mnt /tmp/calamares-root-*/; do
    if [ -d "$tgt/var/log" ] && [ -f "$tgt/etc/os-release" ]; then
        cp -f /var/log/calamares.log "$tgt/var/log/calamares.log" 2>/dev/null || true
        echo "ELITE: log do Calamares persistido em $tgt/var/log/calamares.log (alvo)"
        break
    fi
done

exit "$RC"
