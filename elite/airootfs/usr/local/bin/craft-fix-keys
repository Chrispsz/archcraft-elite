#!/bin/sh
# craft-fix-keys — cura o keyring CachyOS (v1.5 · NOVO)
# ─────────────────────────────────────────────────────────────────────────
# ESPECIFICAÇÃO DO DONO: "pacman/yay falha com 'signature from CachyOS
# <admin@cachyos.org> is unknown trust' e banco PGP inválido". Comandos
# da própria spec (idempotentes — a ordem importa: init ANTES de populate):
#
#   pacman-key --init
#   pacman-key --populate archlinux cachyos
#   pacman -Sy --noconfirm cachyos-keyring archlinux-keyring
#
# Camadas da cura na v1.5 (esta é a ÚLTIMA, self-healing de runtime):
#   1. BUILD: cachyos-keyring virou PACOTE da ISO (packages.add) — o
#      scriptlet do pacote popula o keyring dentro do chroot;
#   2. BUILD: elite-customize [E2b] roda init+populate explícito;
#   3. INSTALAÇÃO: o shellprocess@btrfs (E10) repete o populate no
#      arch-chroot do ALVO — o sistema instalado nasce curado;
#   4. SESSÃO: este script (autostart, background) — cobre liveuser no
#      live e qualquer skew futuro de keyring no sistema instalado.
#
# Requer root (sudo): no liveuser é NOPASSWD; no sistema instalado, sem
# terminal pra senha o sudo falha em silêncio — as camadas 1-3 já curaram
# o essencial; aqui é belt-and-suspenders. Nunca bloqueia a sessão.
#
# v2.5.0 — GUARD de 24h: a cura completa custa gpg + download de TODOS os
# sync DBs (10–20MB de rede + I/O) a CADA login (o audit 24-b flagrou).
# Belt-and-suspenders roda 1× ao dia, não a cada sessão; o stamp mora no
# state do usuário (sobe limpo no live).
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/elite/keyring-refresh.stamp"
now=$(date +%s)
last=$(cat "$STAMP" 2>/dev/null || echo 0)
case "$last" in
    ''|*[!0-9]*) last=0 ;;
esac
# v2.5.0 (N3, audit 24-r): stamp no FUTURO (clock skew/RTC morto)
# suprimiria o guard para sempre — clamp.
[ "$last" -gt "$now" ] && last=0
if [ $((now - last)) -lt 86400 ]; then
    exit 0
fi

if [ "$(id -u)" -eq 0 ]; then
    SUDO=''
else
    command -v sudo >/dev/null 2>&1 || exit 0
    SUDO='sudo -n'   # -n: nunca trava pedindo senha em background
fi

$SUDO pacman-key --init >/dev/null 2>&1 || true
$SUDO pacman-key --populate archlinux cachyos >/dev/null 2>&1 || true
$SUDO pacman -Sy --noconfirm archlinux-keyring cachyos-keyring >/dev/null 2>&1 || true
mkdir -p "${STAMP%/*}" 2>/dev/null || true
date +%s > "$STAMP" 2>/dev/null || true
exit 0
