#!/bin/sh
# ═════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-acpi-wakeup (E106/5a → 1.0-107 → 1.0-108) — OS GATILHOS
# ═════════════════════════════════════════════════════════════════════════
# O RELATO DO RIG (journalctl -b -p 0..4, placa AM4 desktop): a máquina
# "acordava" sozinha LOGO APÓS suspender — os suspeitos nomeados no
# journal eram os GATILHOS de ACPI da placa: GPP*/GP[0-9]* (portas
# físicas PCIe — GPU/rede), XHC*/XHCI (controladores USB), PTXH (hub
# USB da AMD), GP12/GP13/SWUS/SWDS (as pontes de era que a lista FIXA
# de família não alcançava) — os dongles 2.4G/periféricos acordam o
# desktop num pigarro por uma interface HID de teclado FALSA que expõem.
#
# 1.0-108 — A LEI PURA (a diretriz do dono: ler /proc/acpi/wakeup
# DIRETAMENTE e alternar TODO dispositivo *enabled FORA da allowlist
# para *disabled — o echo <DEV> > /proc/acpi/wakeup que a tabela
# entende): a família FIXA de era (XHC*/PTXH/GPP*/GP[0-9]*/X1*) deixava
# os nomes FORA da lista ACORDADOS sem dono (GP12, GP13, SWUS, SWDS…)
# — a regra agora é PURA: a MÃO DO DONO é a allowlist
# (PWRB/SLPB/PBTN/PS2K/LID) e TODO o resto dorme, QUALQUER que seja o
# nome que a placa imprimir amanhã. O PS2K que o hardware NÃO tem
# (desktop USB-only) simplesmente não está na tabela — a passada do
# cinto pula sem drama (a ausência nunca é erro; a presença dormindo
# é que era o roubo do despertar).
#
# O OFÍCIO: o arquivo é TOGGLE — escrever o nome inverte o estado;
# escrever o de quem já dorme REARMARIA o espúrio, por isso o juízo
# ANTES de cada escrita. Idempotente por desenho: já no estado da lei
# = silêncio (nada no papel, nada na porta).
#
# Seam de teste: ELITE_ACPI_WAKEUP aponta pra uma tabela fake (a suíte
# prova o toggle e a idempotência 2× sem /proc de verdade). Em produção
# nada é setado — /proc/acpi/wakeup é o caminho vivo.
# ═════════════════════════════════════════════════════════════════════════
WAKEUP="${ELITE_ACPI_WAKEUP:-/proc/acpi/wakeup}"
# 1.0-107.2/1.0-108 — A MÃO DO DONO UNIVERSAL (desktop E notebook em
# QUALQUER placa AMD/Intel): PWRB/PBTN (as duas grafias do botão do
# power), SLPB (o botão de sleep físico), PS2K (o teclado PS/2 de
# sempre — dongle 2.4G nenhum finge ser) e LID (a tampa do notebook).
# O RESTO INTEIRO da tabela dorme (a lei PURA da 1.0-108).
MANTEM="PWRB SLPB PBTN PS2K LID"

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/elite"
LOG="$LOG_DIR/acpi-wakeup.log"

wlog() {
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null
    return 0
}

[ -r "$WAKEUP" ] || exit 0   # sem a tabela ACPI (container/exótico): silêncio honesto

# o gatilho é a MÃO do dono? (o allowlist explícito universal)
mantido() { # $1 = nome do gatilho
    case " $MANTEM " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

apagou=0
armou=0

# ── 1. O CINTO DO DESPERTAR: a mão do dono presente e dormindo ACORDA ────
#    (o firmware que entrega o botão *disabled de fábrica não rouba o
#    despertar do dono; o nome AUSENTE da tabela simplesmente segue —
#    o PS2K que o hardware não tem nunca é erro)
while read -r _nome _estado _st _resto; do
    [ -n "${_nome:-}" ] || continue
    [ "${_st:-}" = "*disabled" ] || continue
    mantido "$_nome" || continue
    if printf '%s\n' "$_nome" >>"$WAKEUP" 2>/dev/null; then
        wlog "acpi-wakeup: $_nome *disabled → rearmado (a allowlist da mão do dono — $MANTEM)"
        armou=$((armou + 1))
    fi
done <"$WAKEUP" 2>/dev/null

# ── 2. A VARREDURA DA LEI PURA: TODO *enabled FORA da allowlist DORME ─────
#    (GP12/GP13/SWUS/SWDS/XHC*/PTXH e qualquer nome novo que a placa
#    imprimir — a família fixa de era morreu com os fora-da-lista
#    acordados; o TOGGLE só escreve quem está ACORDANDO a máquina sem
#    ninguém ter pedido)
while read -r _nome _estado _st _resto; do
    [ -n "${_nome:-}" ] || continue
    [ "${_st:-}" = "*enabled" ] || continue
    mantido "$_nome" && continue
    if printf '%s\n' "$_nome" >>"$WAKEUP" 2>/dev/null; then
        wlog "acpi-wakeup: $_nome *enabled → desarmado (fora da mão do dono — $MANTEM)"
        apagou=$((apagou + 1))
    else
        wlog "acpi-wakeup: FALHA ao desarmar $_nome (a porta /proc não aceitou a escrita)"
    fi
done <"$WAKEUP" 2>/dev/null
# já todo na lei: zero linha no papel (o silêncio é a idempotência)
[ "$armou" -gt 0 ] && wlog "acpi-wakeup: o cinto do despertar vestiu ($armou gatilho(s) da mão do dono rearmado(s) — $MANTEM)"
[ "$apagou" -gt 0 ] && wlog "acpi-wakeup: varredura fechada ($apagou gatilho(s) fora da allowlist desarmado(s) nesta passada — despertar só na mão do dono: $MANTEM)"
exit 0
