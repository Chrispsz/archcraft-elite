#!/usr/bin/env bash
# craft-rollback — snapshots e restauração (v2 — snapper)
# ═══════════════════════════════════════════════════════════════════════════
# v1 (v1.0.4): launcher do timeshift — "a ÚNICA estratégia de snapshot".
# v2 (v2.3.6 — o dump do rig flagrou): o timeshift JAMAIS foi configurado
# (sem config, sem snapshot — a promessa do rollback era pela metade) e o
# grub-btrfsd nasce FAILED ('No directory found at /.snapshots') porque
# vigia o diretório do SNAPPER. O par canônico do grub-btrfs é o snapper —
# um rei só agora:
#   · o firstboot cria config + /.snapshots (idempotente);
#   · este menu: CRIAR snapshot (antes de mudança de risco) e RESTAURAR
#     (snapper rollback — o reboot finaliza; o grub-btrfsd regenera o
#     menu do GRUB a cada snapshot novo).
# Elevação: snapper pede root — cada ação sobe via pkexec (janela de senha
# do polkit; o MENU roda como usuário — GUI como root no Wayland morre com
# o ambiente vazio). Lista também: o --no-dbus lê o config direto.
# Gramática da família: stderr capturado, ESC/143 benignos, mlog sem
# alarme falso.
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}
note() { command -v notify-send >/dev/null 2>&1 && notify-send -a 'Elite' "$@" || true; }

command -v snapper >/dev/null 2>&1 || {
    mlog "Rollback: snapper AUSENTE"
    note 'Rollback' 'snapper ausente — sistema sem a camada Elite?'
    exit 1
}

# lista: "id · data · descrição" (colunas do snapper: #=$2, Date=$4, Desc=$7)
snap_list() {
    pkexec snapper --no-dbus -c root list 2>/dev/null \
        | awk -F'|' '($2+0)>0 {
            gsub(/^[ \t]+|[ \t]+$/, "", $2)
            gsub(/^[ \t]+|[ \t]+$/, "", $4)
            gsub(/^[ \t]+|[ \t]+$/, "", $7)
            print $2 " · " $4 " · " $7
        }'
}

mlog "Rollback: abrindo (craft-menu)"
errf="$(mktemp)"
ec=0
choice="$(craft-menu --title='Rollback' 'Criar snapshot agora' 'Restaurar snapshot…' \
    2>"$errf")" || ec=$?
if [ "$ec" -eq 143 ]; then
    mlog "Rollback: fechado de fora (SIGTERM — toggle/cross-dismiss) — benigno"
    rm -f "$errf"
    exit 0
fi
if [ "$ec" -eq 1 ] && [ ! -s "$errf" ]; then
    mlog "Rollback: fechado pelo usuário (ESC) — benigno"
    rm -f "$errf"
    exit 0
fi
if [ "$ec" -ne 0 ]; then
    mlog "Rollback: FUZZEL FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
    note -u critical 'Menu de Rollback falhou' "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log"
fi
rm -f "$errf"

case "$choice" in
    'Criar snapshot agora')
        ec=0
        errf="$(mktemp)"
        desc="$(fuzzel --dmenu </dev/null \
            --anchor=center \
            --lines=0 --width=30 --prompt='Descrição  ' 2>"$errf")" || ec=$?
        if [ "$ec" -ne 0 ]; then
            [ "$ec" -eq 1 ] && [ ! -s "$errf" ] \
                && mlog "Rollback: descrição cancelada — benigno" \
                || mlog "Rollback: prompt de descrição falhou exit=$ec"
            rm -f "$errf"
            exit 0
        fi
        rm -f "$errf"
        mlog "Rollback: criando snapshot ($desc)"
        if pkexec snapper --no-dbus -c root create --description "$desc" >/dev/null 2>&1; then
            mlog "Rollback: snapshot criado ($desc)"
            note 'Rollback' "Snapshot criado: $desc"
        else
            mlog "Rollback: FALHA ao criar snapshot (pkexec/snapper)"
            note -u critical 'Rollback' 'Não deu para criar o snapshot — senha ou snapper sem config.'
        fi
        ;;
    'Restaurar snapshot…')
        list="$(snap_list || true)"
        if [ -z "$list" ]; then
            mlog "Rollback: nenhum snapshot para restaurar"
            note 'Rollback' 'Nenhum snapshot ainda — crie um antes de mexer em algo arriscado.'
            exit 0
        fi
        ec=0
        errf="$(mktemp)"
        pick="$(craft-menu --title='Restaurar' $(printf '%s\n' "$list" | awk '{printf "\"%s\" ", $0}') \
            2>"$errf")" || ec=$?
        if [ "$ec" -ne 0 ]; then
            [ "$ec" -eq 1 ] && [ ! -s "$errf" ] \
                && mlog "Rollback: restauração cancelada — benigno" \
                || mlog "Rollback: picker de snapshot falhou exit=$ec"
            rm -f "$errf"
            exit 0
        fi
        rm -f "$errf"
        snap="$(printf '%s' "$pick" | cut -d' ' -f1)"
        ec=0
        errf="$(mktemp)"
        ok="$(craft-menu --title='Confirmar' 'Cancelar' 'CONFIRMAR — o sistema volta a este snapshot' \
            2>"$errf")" || ec=$?
        rm -f "$errf"
        if [ "$ec" -ne 0 ] || [ "$ok" != 'CONFIRMAR — o sistema volta a este snapshot' ]; then
            mlog "Rollback: restauração do snapshot $snap não confirmada — benigno"
            exit 0
        fi
        mlog "Rollback: restaurando snapshot $snap"
        if pkexec snapper --no-dbus -c root rollback "$snap" >/dev/null 2>&1; then
            mlog "Rollback: restaurado para $snap (reboot pendente)"
            note -u critical 'Rollback' "Sistema restaurado ao snapshot $snap — REINICIE para finalizar."
        else
            mlog "Rollback: FALHA ao restaurar snapshot $snap (pkexec/snapper)"
            note -u critical 'Rollback' 'Não deu para restaurar — senha ou snapshot inválido.'
        fi
        ;;
    *)  exit 0 ;;
esac
