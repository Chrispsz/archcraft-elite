#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-dump (v2.1 — o "btop completão" polido, v2.10.6)
# ═══════════════════════════════════════════════════════════════════════════
# Pedido do dono (out/2026): "como puxo tudo que está rodando como se fosse
# um btop completão pra gente ter um diagnóstico da RAM, pacotes, uso, CPU
# e etc… puxar todos os caches do elite" — e v2.10.6: "deixa bem mais polido
# esse log btop para que quando eu instalar a 10.6 e mandar o log, você já
# saiba como está o sistema COMPLETAMENTE". O dump v2.0 ABRE com o veredito
# (o sistema descrevendo a si mesmo) e só então o detalhe, seção a seção.
# v2.0.1 (o 1º rig-install da 10.6 falou — dump 0qmq — e o papel ganhou as
# provas que faltavam): /sys/power/state (o veredito do suspend), journal
# das units Elite falhadas, bluetoothctl (adaptador ausente ≠ serviço
# morto), fuzzel.ini (a linha :35 corrompida), toplevel.log (o ACK honesto
# do daemon), host via uname -n (o 'hostname' não existe em toda ISO) e o
# NUL do termbin morto no capture (a linha 292 do rig gritou de novo).
# v2.1 (o dono mandou o dump d33o via 'sudo craft-dump' e o papel mentiu
# em 3 vozes): (1) CONTEXTO — rodando via sudo, $HOME era /root e as
# seções de sessão liam o root: '(sem arquivo de pins)', '(sem fuzzel.ini)'
# e '(sem idle.conf)' num rig COM os três; agora o dump resolve o usuário
# da SESSÃO (SUDO_USER → labwc) e lê o /home dele, com XDG_RUNTIME_DIR
# bridge para wpctl/wlr-randr (o dump de root volta a ver o PipeWire e o
# randr da sessão); (2) O can-suspend ENGOLEU A PROVA — o '2>/dev/null'
# do rig d33o mostrou LINHA VAZIA onde devia estar o veredito do logind;
# agora o stderr vai pro papel e as sessões do logind (Active/State) junto;
# (3) sleep.conf* /sys/power/disk/systemd-inhibit entram — a cadeia de
# sono INTEIRA no papel (o menu recusou suspend com kernel provando
# 'freeze mem disk' — o meio do caminho agora tem réu nomeado).
#
#    0 · VEREDITO RÁPIDO — probe da sessão + units falhados + disco raiz
#    1 · identidade (+ o ambiente de sessão: o dump nasceu dentro dela?)
#    2 · hardware — CPU/RAM/GPU com DRIVER EM USO/discos/zram/temperaturas
#    3 · kernel & tuning
#    4 · boot & rollback — história de boots, tempo, findmnt (lição D1),
#        snapshots
#    5 · serviços Elite + a VERSÃO dos pacotes craft/elite NO RIG (pacman)
#    6 · sessão — processos, barras, supervisão, PINS e a TABELA REAL de
#        janelas do daemon toplevel (o socket que a dock fala:
#        W|id|flags|rank|app_id|título — o teste do btop chega com prova)
#    7 · display & teclado — wlr-randr (posição/scale/modo ATUAL), XKB
#        (o ABNT2 com prova), localectl
#    8 · rede — nmcli (a cura B2 com evidência) + IPs + hardware de rede
#    9 · áudio — sink/fonte default (wpctl)
#   10 · suspend/ACPI — a caça ao despertar + idle.conf (a escolha do dono)
#   11 · journal de erros deste boot
#   12 · os 3 logs da Elite + firstboot + Calamares
#   13 · pacotes (explicit/órfãos/foreign/flatpak/repos)
#   14 · caches e uso de disco
#
# Uso:
#   craft-dump            → gera ~/elite-dump-<data>.txt e mostra o caminho
#   craft-dump --upload   → idem + sobe no termbin.com e imprime a URL curta
#                           (via /dev/tcp do bash — sem depender de nc;
#                           timeout 15 — rede morta devolve o terminal)
#
# Somente leitura (nada é modificado). Logs são TAILADOS (evidência recente
# vale mais — mesma política do bars.log). Para o journal COMPLETO rode com
# sudo; como usuário comum, o que o grupo adm/journal permite já cobre o
# essencial.
# ═══════════════════════════════════════════════════════════════════════════
set -u

STAMP="$(date +%Y%m%d-%H%M)"

# v2.1 — O CONTEXTO DA SESSÃO (a cura do dump d33o): via sudo, o $HOME é
# /root e as seções 6/7/9/10/12/14 liam o root. O usuário-alvo é o SUDO_USER
# (quem chamou o sudo — a sessão gráfica); sem sudo, quem chama.
DUMP_USER="${SUDO_USER:-$(id -un)}"
DUMP_UID="$(id -u "$DUMP_USER" 2>/dev/null || id -u)"
UHOME="$(getent passwd "$DUMP_USER" 2>/dev/null | cut -d: -f6)"
[ -n "$UHOME" ] || UHOME="$HOME"
URUNTIME="/run/user/$DUMP_UID"
UCACHE="${UHOME}/.cache"
OUT="${UHOME}/elite-dump-${STAMP}.txt"

# cada bloco: "$ <comando>" + saída + tail (evidência recente vale mais)
# tr -d '\0': journal/systemd cospem NUL — no upload o $( ) do termbin
# gritava 'byte nulo ignorado' (o rig flagrou na linha 144). NUL morre na
# FONTE: o arquivo do dump nasce limpo.
r() { # r <comando> [linhas]
    printf '\n$ %s\n' "$1"
    bash -c "$1" 2>&1 | tr -d '\0' | tail -n "${2:-40}"
}

{
    printf '══════════ ELITE DUMP v2.1 — diagnóstico completo ══════════\n'
    if [ "$(id -un)" != "$DUMP_USER" ]; then
        printf 'gerado: %s · usuário: %s → sessão de %s (uid %s) · host: %s\n' \
            "$(date)" "$(id -un)" "$DUMP_USER" "$DUMP_UID" "$(uname -n 2>/dev/null || echo '?')"
    else
        printf 'gerado: %s · usuário: %s · host: %s\n' \
            "$(date)" "$(id -un)" "$(uname -n 2>/dev/null || echo '?')"
    fi

    printf '\n══════════ 0 · VEREDITO RÁPIDO ══════════\n'
    printf '(o sistema descrevendo a si mesmo — o detalhe mora nas seções 1-14)\n'
    # v2.1.1: o probe é o veredito que a sessão faz de si (barras, dock,
    # toplevel vivo E FALANDO — PING real no socket —, memória, versões)
    if [ -x /usr/local/bin/elite-session-probe ]; then
        r "/usr/local/bin/elite-session-probe" 100
    else
        printf '(probe ausente — sessão anterior à v2.1.1?)\n'
    fi
    # a 1ª pergunta de qualquer perícia de boot: o que está FAILED
    r "systemctl --failed --no-pager --plain" 8
    r "systemctl --user --failed --no-pager --plain" 8
    r "df -h / | tail -1" 2

    printf '\n══════════ 1 · IDENTIDADE ══════════\n'
    r "grep PRETTY /etc/os-release" 2
    r "uname -a" 2
    r "uptime" 2
    # o dump nasceu DENTRO da sessão gráfica? (SSH/vty = variáveis vazias —
    # e aí o wlr-randr da seção 7 decai para os conectores do kernel)
    r "env | grep -E '^(XDG_SESSION_TYPE|WAYLAND_DISPLAY|XDG_RUNTIME_DIR|LANG|DESKTOP_SESSION)='" 6

    printf '\n══════════ 2 · HARDWARE — CPU/RAM/GPU/DISCO/TEMPERATURA ══════════\n'
    r "lscpu | grep -E 'Model name|^CPU\(s\)|Thread|MHz|Socket|L3'" 8
    r "free -h" 5
    # v2.10.6: -k mostra o DRIVER EM USO (a cura D5 do híbrido com prova:
    # nvidia bound ou não; nouveau vs nvidia; amdgpu presente ou ausente)
    r "lspci -k | grep -EA3 'VGA|3D|Display'" 14
    if command -v nvidia-smi >/dev/null 2>&1; then
        r "nvidia-smi --query-gpu=name,driver_version,memory.total,temperature.gpu --format=csv,noheader" 4
    fi
    r "lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT" 20
    r "df -h / /home /boot /boot/grub 2>/dev/null | sort -u" 10
    r "zramctl 2>/dev/null" 5
    r "swapon --show 2>/dev/null" 4
    printf '\n── temperaturas (sysfs do kernel — sem precisar de lm_sensors; valor em m°C)\n'
    for z in /sys/class/thermal/thermal_zone*; do
        [ -d "$z" ] || continue
        tz_type="$(cat "$z/type" 2>/dev/null)"
        tz_temp="$(cat "$z/temp" 2>/dev/null)"
        [ -n "$tz_type" ] && printf '%-28s %s\n' "$tz_type" "$tz_temp"
    done

    printf '\n══════════ 3 · KERNEL & TUNING ══════════\n'
    r "cat /proc/cmdline" 2
    r "cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null" 2
    r "sysctl vm.swappiness vm.vfs_cache_pressure kernel.sched_autogroup_enabled 2>/dev/null" 4
    r "cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null" 2
    r "sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc 2>/dev/null" 3

    printf '\n══════════ 4 · BOOT & ROLLBACK ══════════\n'
    # v2.10.6: a história cross-boot (o 'acordou sozinho de anteontem'
    # precisa de lugar no papel — a caça ao despertar não termina no reboot)
    r "journalctl --list-boots --no-pager 2>/dev/null | tail -8" 10
    r "systemd-analyze 2>&1" 4
    # lição D1: findmnt é a verdade do mount ('mount | grep " on / btrfs"'
    # NUNCA casou) — o fstype/subvol daqui é o que o rollback cura usa
    r "findmnt /" 6
    r "findmnt /home 2>/dev/null" 4
    r "ls -d /.snapshots 2>/dev/null && ls /.snapshots | tail -5 || echo '(sem /.snapshots)'" 7
    r "timeshift --list 2>/dev/null | head -12" 12

    printf '\n══════════ 5 · SERVIÇOS ELITE ══════════\n'
    for s in ananicy-cpp lactd grub-btrfsd elite-firstboot; do
        printf '%-16s active=%-10s enabled=%s\n' "$s" \
            "$(systemctl is-active "$s" 2>/dev/null || echo '?')" \
            "$(systemctl is-enabled "$s" 2>/dev/null || echo '?')"
    done
    printf 'firstboot-done: %s\n' \
        "$([ -f /var/lib/elite/firstboot-done ] && echo sim || echo 'não (pende/re-tenta)')"
    # v2.10.6: a versão dos pacotes da Elite NO RIG — a prova de que o rig
    # roda a 10.6 de verdade (não o que o papel promete; o que o pacman tem)
    r "pacman -Q 2>/dev/null | grep -Ei 'craft|elite' || echo '(nenhum pacote craft/elite — anômalo)'" 12
    # v2.10.9 — A PERÍCIA DO CICLO (o rig julga a si mesmo): o d33o L403
    # mostrou 'Found ordering cycle: elite-firstboot after graphical after
    # multi-user' e o journal do firstboot NASCEU VAZIO — o systemd apagou
    # o job calado (INFO) e o firstboot nunca rodou. O sandbox NÃO
    # reproduziu o ciclo com as units do repo (Wants= de symlink é inerte
    # para ordenação), então a aresta exata do rig ficou sem nome. Este
    # bloco nomeia: a unit EFETIVA (com drop-ins), os symlinks de
    # habilitação REAIS e o verify do próprio rig — se o ciclo existir,
    # ele sai NOMEADO no papel, com a aresta culpada.
    r "systemctl cat elite-firstboot.service 2>/dev/null | head -45" 30
    r "for d in /etc/systemd/system/multi-user.target.wants /etc/systemd/system/graphical.target.wants; do echo \"── \$d\"; ls -l \"\$d\" 2>/dev/null | grep -v '^total' || echo '   (ausente)'; done" 10
    r "for d in /etc/systemd/system/multi-user.target.d /usr/lib/systemd/system/multi-user.target.d /etc/systemd/system/graphical.target.d /usr/lib/systemd/system/graphical.target.d; do [ -d \"\$d\" ] && { echo \"── \$d (DROP-IN — réu da aresta)\"; ls -l \"\$d\"; cat \"\$d\"/*.conf 2>/dev/null; }; done; true" 15
    r "systemd-analyze verify --recursive-errors=no multi-user.target graphical.target 2>&1 | grep -iE 'cycle|cyclic|firstboot' | head -10; echo '── fim do verify do rig (vazio = sem ciclo nomeável)'" 25

    printf '\n══════════ 6 · SESSÃO — PROCESSOS/BARRAS/DOCK/JANELAS ══════════\n'
    # v2.1 — os processos DA SESSÃO (d33o via sudo listou só o root: systemd,
    # Xorg, NetworkManager — a dock e o swayidle do dono eram invisíveis)
    r "ps -u $DUMP_UID -o pid,pcpu,pmem,comm --sort=-pcpu | head -25" 30
    r "pgrep -a labwc | head -3" 4
    # v2.10.6: contagem ANCORADA (o comm da dock é python3 — o pgrep -c puro
    # nunca acharia; e '-f craft-dock-gui' solto somava editor com o fonte)
    printf 'waybar=%s · dock_gui=%s (cmdline ancorada)\n' \
        "$(pgrep -c waybar 2>/dev/null)" \
        "$(pgrep -u "$DUMP_UID" -fc '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' 2>/dev/null)"
    # v2.10.8 — o idle na prova: swayidle (lock/DPMS/suspend) e o supervisor
    # (a reclamação 'o PC não entra em idle' precisa de réu nomeado)
    printf 'swayidle=%s · craft-bars=%s\n' \
        "$(pgrep -c swayidle 2>/dev/null)" \
        "$(pgrep -c craft-bars 2>/dev/null)"
    if [ -f "$UCACHE/elite/bars.log" ]; then
        r "grep -c 'SAIU exit' $UCACHE/elite/bars.log 2>/dev/null" 2
        printf '\n── supervisão: as últimas mortes/reinícios (o detalhe do count)\n'
        grep -E 'SAIU exit=|FORA — reiniciando' "$UCACHE/elite/bars.log" 2>/dev/null | tail -10
    fi

    printf '\n── pins da dock (~/.config/elite/dock-pins — fixado ≠ dinâmico)\n'
    if [ -f "$UHOME/.config/elite/dock-pins" ]; then
        grep -v '^[[:space:]]*#' "$UHOME/.config/elite/dock-pins" \
            | grep -v '^[[:space:]]*$' || printf '(vazio)\n'
    else
        printf '(sem arquivo de pins)\n'
    fi

    # v2.10.6 — A TABELA REAL DE JANELAS: o MESMO socket que a dock fala
    # (LIST do craft-toplevel). O teste do btop — ou qualquer reclamação de
    # janela — chega com a prova do daemon: app_id, título, flags e a ordem
    # MRU do alt-tab. Daemon morto = linha honesta aqui embaixo.
    tp_done=""
    for s in /run/user/*/elite/toplevel.sock; do
        [ -S "$s" ] || continue
        printf '\n── toplevel.sock: %s\n' "$s"
        printf '   (W|id|flags|rank|app_id|título — flags: 1=max 2=min 4=ativa 8=fullscreen · rank 0 = mais recente)\n'
        if PYTHONDONTWRITEBYTECODE=1 python3 - "$s" <<'PY'
import socket, sys
try:
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    c.settimeout(3)
    c.connect(sys.argv[1])
    c.sendall(b"LIST\n")
    f = c.makefile("r", encoding="utf-8", errors="replace")
    n = 0
    while True:
        ln = f.readline()
        if not ln:
            break
        ln = ln.rstrip("\n")
        print(ln)
        if ln.startswith("W|"):
            n += 1
        if ln.startswith("OK|"):
            break
    print("janelas=%d" % n)
except Exception as e:
    print("(toplevel indisponível: %s)" % e)
    sys.exit(3)
PY
        then
            tp_done=1
            break
        fi
    done
    [ -n "$tp_done" ] || printf '(socket do toplevel não encontrado — daemon craft-toplevel morto? veja o probe na seção 0 e o bars.log na seção 12)\n'

    printf '\n── processos da Elite (a sessão inteira, com args)\n'
    r "ps -u $DUMP_UID -o pid,args | grep -E 'craft-|waybar|swayidle|swaync|fuzzel|labwc|hyprlock' | grep -v grep" 25

    printf '\n══════════ 7 · DISPLAY & TECLADO ══════════\n'
    # v2.10.6: wlr-randr NA ISO — posição/scale/MODO ATUAL de cada monitor.
    # v2.1: via sudo, o bridge do runtime do usuário (XDG_RUNTIME_DIR da
    # sessão) traz o randr REAL; sem sessão, decai p/ os conectores do kernel
    r "for d in wayland-0 wayland-1 wayland-2; do if env XDG_RUNTIME_DIR=$URUNTIME WAYLAND_DISPLAY=\$d wlr-randr 2>/dev/null; then break; fi; done || { echo '(sem sessão wlr — conectores do kernel):'; grep -H . /sys/class/drm/card*-*/status 2>/dev/null; grep -H . /sys/class/drm/card*-*/modes 2>/dev/null | head -8; }" 30
    # o ABNT2 (Z2) com prova: o XKB_DEFAULT_LAYOUT chegou à sessão ou não
    r "grep XKB /etc/environment 2>/dev/null || echo '(sem XKB_DEFAULT_LAYOUT em /etc/environment)'" 4
    # v2.1 — a prova DENTRO da sessão: o ambiente REAL do labwc (o
    # /etc/environment pode estar certo e a sessão ter nascido antes dele)
    r "for p in \$(pgrep -x labwc); do echo \"labwc pid \$p:\"; tr '\\0' '\\n' < /proc/\$p/environ 2>/dev/null | grep -E '^XKB' ; done; true" 8
    r "localectl status 2>/dev/null" 6
    r "locale | grep -E 'LANG=|LC_CTYPE='" 3
    # v2.10.7 — a linha 35 do rig ('ain].exit-on-focus-loss: yes — not a
    # valid option') gritou em TODO menu aberto; a config viaja no papel
    # para a perícia ver o arquivo de verdade, não o erro dele
    printf '\n── fuzzel.ini (linhas 28-42 — o config que os menus comem)\n'
    r "sed -n '28,42p' \"$UHOME/.config/fuzzel/fuzzel.ini\" 2>/dev/null || echo '(sem fuzzel.ini)'" 16

    printf '\n══════════ 8 · REDE ══════════\n'
    # a cura B2 ('Not authorized' ≠ senha errada) com evidência no papel
    r "nmcli general status 2>/dev/null" 6
    r "nmcli -f NAME,TYPE,DEVICE,STATE con show --active 2>/dev/null" 12
    r "ip -brief addr 2>/dev/null" 10
    r "lspci -k | grep -EA3 'Network|Ethernet'" 10
    # v2.10.7 — o gerenciador Bluetooth vazio do rig precisa de réu: o
    # adaptador existe? (desktop sem BT = lista vazia CORRETA; serviço
    # morto = outra história — a evidência decide)
    r "bluetoothctl show 2>/dev/null || echo '(sem adaptador bluetooth — No default controller)'" 14
    r "lsusb 2>/dev/null | head -10" 12

    printf '\n══════════ 9 · ÁUDIO ══════════\n'
    # v2.1 — o bridge do runtime da sessão: o wpctl de root sem XDG_RUNTIME_DIR
    # morre no 'Could not connect to PipeWire' (o d33o não viu o áudio do rig)
    r "if command -v wpctl >/dev/null 2>&1; then env XDG_RUNTIME_DIR=$URUNTIME wpctl status | head -30; else echo '(wpctl ausente)'; fi" 32

    printf '\n══════════ 10 · SUSPEND/ACPI — A CAÇA AO DESPERTAR ══════════\n'
    printf '(despertar imediato após suspender = dispositivo/BIOS — as linhas\n'
    printf ' abaixo mostram QUEM acordou e QUANDO)\n'
    printf '\n── idle.conf (a escolha do dono — o SUSPEND_MIN que viajou)\n'
    if [ -f "$UHOME/.config/elite/idle.conf" ]; then
        cat "$UHOME/.config/elite/idle.conf"
    else
        printf '(ausente — craft-idle nos defaults: lock 10 · apagar 15 · SUSPEND 20)\n'
    fi
    # v2.10.7 — O VEREDITO DO SUSPEND COM PROVA DO KERNEL: o menu disse
    # 'loginctl can-suspend ≠ yes' no rig e o dump não tinha O QUE julgar
    # (sem /sys/power/state não dá para saber se é BIOS ou kernel). Agora:
    # os estados que o kernel oferece + a palavra do logind + o mem_sleep.
    # v2.1 — d33o gritou: 'loginctl can-suspend' com 2>/dev/null = LINHA
    # VAZIA no papel (a prova do meio engolida). stderr vai pro papel agora.
    r "printf 'kernel: '; cat /sys/power/state 2>/dev/null || echo '(sem /sys/power/state)'" 4
    r "printf 'mem_sleep: '; cat /sys/power/mem_sleep 2>/dev/null || echo '(sem mem_sleep)'" 4
    r "printf 'disk: '; cat /sys/power/disk 2>/dev/null || echo '(sem /sys/power/disk)'" 4
    r "loginctl can-suspend" 4
    # v2.1 — as SESSÕES do logind (a pergunta que faltava: o can-suspend é
    # respondido PARA o chamador — sessão não-active pode virar 'challenge')
    r "for s in \$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print \$1}'); do loginctl show-session \"\$s\" -p Id -p Name -p Active -p State -p Type -p Remote 2>/dev/null; done; true" 20
    # v2.1 — a config de sono INTEIRA (AllowSuspend=no herdado de base é
    # réu possível do '≠ yes' do rig; o /usr/lib é o que o pacote entrega,
    # o /etc é a palavra final do drop-in)
    r "for f in /etc/systemd/sleep.conf /etc/systemd/sleep.conf.d/*.conf /usr/lib/systemd/sleep.conf.d/*.conf; do [ -f \"\$f\" ] && { echo '── \$f'; cat \"\$f\"; }; done; true" 30
    r "journalctl -u systemd-suspend --no-pager 2>/dev/null | tail -40" 45
    r "cat /proc/acpi/wakeup 2>/dev/null" 25
    r "journalctl --no-pager 2>/dev/null | grep -iE 'wake(ing|up)?|resume|suspending' | tail -25" 30
    r "grep -E '^[#]?Handle(Suspend|Power|Lid)' /etc/systemd/logind.conf 2>/dev/null" 6
    # v2.1 — quem segura inibidor de sono AGORA (o 'tenta e volta' do menu
    # era app com delay inhibitor; o -i do craft-power ignora, o idle do
    # swayidle respeita o idle-inhibit — os dois réus no papel)
    r "systemd-inhibit --list 2>/dev/null | head -20" 22

    printf '\n══════════ 11 · JOURNAL — ERROS DESTE BOOT ══════════\n'
    r "journalctl -b -p err --no-pager 2>/dev/null | tail -50" 55
    # v2.10.7 — as units da Elite contam a própria história: o tail de -p
    # err do rig deixou o erro do grub-btrfsd fora do dump (afogado entre
    # fuzzel e iwlwifi); o journal DA UNIT é a prova direta
    r "journalctl -b -u elite-firstboot -u grub-btrfsd --no-pager 2>/dev/null | tail -30" 35

    printf '\n══════════ 12 · LOGS DA ELITE (evidência recente) ══════════\n'
    for f in "$UCACHE/elite/bars.log" "$UCACHE/elite/menus.log" \
             "$UCACHE/elite/dock.log"; do
        if [ -f "$f" ]; then
            printf '\n── tail %s\n' "$f"
            tail -n 150 "$f"
        else
            printf '\n── (ausente: %s)\n' "$f"
        fi
    done
    for f in /var/log/elite-firstboot.log /var/log/calamares.log \
             "$CACHE/calamares/session.log"; do
        if [ -f "$f" ]; then
            printf '\n── tail %s\n' "$f"
            tail -n 120 "$f"
        fi
    done
    # v2.10.7 — a fala do daemon toplevel: o ACK honesto do ACT/CLOSE
    # (confirmação do compositor, denúncia de timeout — a caça ao
    # 'menu abriu, foco saiu, nada aconteceu' do rig 1º-install)
    for f in /run/user/*/elite/toplevel.log; do
        if [ -f "$f" ]; then
            printf '\n── tail %s (o ACK honesto do ACT/CLOSE)\n' "$f"
            tail -n 80 "$f"
        fi
    done

    printf '\n══════════ 13 · PACOTES ══════════\n'
    r "pacman -Qq | wc -l" 2
    r "pacman -Qe" 400
    r "pacman -Qtdq || echo '(nenhum órfão)'" 40
    r "pacman -Qm || echo '(nenhum foreign)'" 40
    if command -v flatpak >/dev/null 2>&1; then
        r "flatpak list --columns=application,version,origin 2>/dev/null" 40
    else
        printf '(flatpak não instalado)\n'
    fi
    r "grep -E '^\[[a-z]' /etc/pacman.conf" 12
    r "du -sh /var/cache/pacman/pkg 2>/dev/null" 2

    printf '\n══════════ 14 · CACHES & DISCO ══════════\n'
    # v2.10.5: caminho citado DENTRO do payload — caminho com espaço não
    # quebra o du (o $r vai inteiro pro bash -c)
    r "du -sh '$UCACHE/elite' '$UCACHE/calamares' 2>/dev/null" 4
    r "du -sh '$UHOME/.cache'/* 2>/dev/null | sort -rh | head -12" 14
    r "journalctl --disk-usage 2>/dev/null" 2

    printf '\n══════════ FIM DO DUMP v2.1 ══════════\n'
    printf 'a seção 0 é o resumo; as seções 1-14 são o detalhe.\n'
    printf 'envie este arquivo (ou a URL do --upload) para a análise.\n'
} > "$OUT" 2>&1

LINES="$(wc -l <"$OUT")"
printf 'dump pronto: %s (%s linhas)\n' "$OUT" "$LINES"
# v2.1 — o arquivo nasce no /home da SESSÃO (não no /root do sudo) e o
# dono dele volta a ser o dono (root escreveu por cima)
if [ "$(id -un)" != "$DUMP_USER" ] && [ -f "$OUT" ]; then
    chown "$DUMP_USER":"$(id -gn "$DUMP_USER" 2>/dev/null)" "$OUT" 2>/dev/null || true
fi

if [ "${1:-}" = "--upload" ]; then
    # termbin via /dev/tcp do bash — sem nc (a ISO não o carrega).
    # v2.10.6: timeout 15 — rede morta devolve o terminal em 15s, não nunca.
    url="$(timeout 15 bash -c '
        exec 3<>/dev/tcp/termbin.com/9999 || exit 1
        cat "'"$OUT"'" >&3
        head -c 200 <&3 2>/dev/null
        exec 3>&- 3<&-
    ' 2>/dev/null | tr -d '\0\n')"
    if [ -n "$url" ]; then
        printf 'URL curta: %s\n' "$url"
    else
        printf 'upload falhou (rede/termbin) — o arquivo continua em: %s\n' "$OUT"
        exit 1
    fi
fi
