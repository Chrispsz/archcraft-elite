#!/bin/sh
# ═════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-idle (2.0) — A TRAVA AUTOMÁTICA DA CASA
# ═════════════════════════════════════════════════════════════════════════
# 2.0 — O SWAYIDLE APOSENTOU: a vigília é do elite-daemon (o
# ext-idle-notify-v1 nativo — trava + tela apagada no MESMO gesto E43,
# o suspend de travado E60, os inibidores de jogo/mídia respeitados).
# ESTE bin é o ESCRITOR do conf: os minutos moram em
# ~/.config/elite/idle.conf e o daemon os lê NA ARMAÇÃO de cada ciclo —
# a mudança vale na hora, SEM restart, SEM relogin (o menu do dono
# continua mandando como sempre mandou).
#
# Uso:
#   craft-idle            → cicla os presets (5 → 10 → 15 → 30 → nunca → 5)
#   craft-idle N          → trava em N minutos (0 = nunca sozinho, W-l manda)
#   craft-idle status     → o conf vivo e o que o daemon fará com ele
# ═════════════════════════════════════════════════════════════════════════
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/elite"
CONF="$CONF_DIR/idle.conf"

uso() {
    printf '%s\n' \
        'uso: craft-idle [N | cycle | menu | status] — a trava automática da casa' \
        '' \
        '  2.0: a vigília é do elite-daemon (ext-idle-notify nativo); este' \
        '  bin escreve ~/.config/elite/idle.conf e o daemon lê na ARMAÇÃO' \
        '  de cada ciclo — a mudança vale na hora, sem restart.' \
        '' \
        '  N        minutos de inatividade até TRAVAR E APAGAR (0 = nunca)' \
        '  menu     o painel nativo com os presets (5/15/30 min, 1 hora,' \
        '           Desativado e Travar agora — o item do menu do dono)' \
        '  cycle    o ciclo dos presets (5 → 15 → 30 → 1 hora → Desativado)' \
        '  status   o conf vivo'
    exit 0
}
case "${1:-cycle}" in -h|--help|uso) uso ;; esac

le_lock() {
    [ -r "$CONF" ] || return 0
    _l="$(grep -m1 '^LOCK_MIN=' "$CONF" 2>/dev/null | cut -d= -f2)"
    case "${_l:-}" in ''|*[!0-9]*) echo 5 ;; *) echo "$_l" ;; esac
}
le_suspend() {
    [ -r "$CONF" ] || return 0
    _s="$(grep -m1 '^SUSPEND_MIN=' "$CONF" 2>/dev/null | cut -d= -f2)"
    case "${_s:-}" in ''|*[!0-9]*) echo 20 ;; *) echo "$_s" ;; esac
}

escreve() {
    _lock="$1"
    _susp="$(le_suspend)"
    # E150 — o menu é o gesto ÚNICO de sempre (LOCK=OFF no mesmo papel:
    # o preset do painel trava E apaga no MESMO minuto — a fábrica 5/10
    # separada fica no skel para quem edita o papel à mão; o daemon lê
    # os DOIS de qualquer jeito)
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    _tmp="$CONF.$$.tmp"
    printf '# Archcraft ELITE · tempo de idle (escrito pelo craft-idle 2.0)\n# O daemon arma a vigília com ESTES valores a cada ciclo.\nLOCK_MIN=%s\nOFF_MIN=%s\nSUSPEND_MIN=%s\n' \
        "$_lock" "$_lock" "$_susp" >"$_tmp" 2>/dev/null \
        && mv -f "$_tmp" "$CONF" 2>/dev/null \
        || { rm -f "$_tmp" 2>/dev/null; echo "craft-idle: não consegui escrever $CONF" >&2; exit 1; }
}

nota() {
    _msg="$1"
    command -v notify-send >/dev/null 2>&1 \
        && notify-send -a 'Elite · Trava automática' -u low -t 4000 'Trava automática' "$_msg" &
}

# E150→1.0-105 — O PICK VESTE AS FLAGS REAIS DO `craft-pick --help` E A
# FORMA DO FOOT (a prova do rig da 1.0-98: o painel abortava com 'Opção
# --title=... desconhecida' quando o binário do rig não conhecia a flag
# — o chamador e o binário de eras diferentes MATAM o menu; e o terminal
# foot NÃO aceita --title=VALOR colado: a forma da casa é o -T "..."
# COM ESPAÇO — 1.0-105). O título só entra quando o craft-pick
# INSTALADO anuncia o -T no papel de ajuda; sem ele, o painel segue
# sem título (o contrato 0/1 intacto — o menu nunca morre por flag de
# era).
# E106/2 — DOIS CONSERTOS da sessão nativa (o item do menu roda SEM foot —
# o craft-pick é a ÚNICA janela): (1) a sonda do -T casa o traço também
# colado ao COLCHETE do uso ('[-T TÍTULO' — a âncora de espaço/linha da
# era JAMAIS casava o papel real e o painel nascia SEM título de
# boa-fé); (2) o stderr do craft-pick desce no vazio (os avisos de
# portal do GTK não mancham a sessão nativa) SEM tocar no contrato 0/1 —
# o exit code do pick continua o juiz da escolha, sempre.
_pick() {
    if craft-pick --help 2>/dev/null | grep -qE -- '(^|[^[:alnum:]])-T[[:space:]]'; then
        craft-pick -T "$1" 2>/dev/null
    else
        craft-pick 2>/dev/null
    fi
}

# ── status: o papel vivo ─────────────────────────────────────────────────
if [ "${1:-}" = "status" ]; then
    _lock="$(le_lock)"; _susp="$(le_suspend)"
    if [ "$_lock" = "0" ]; then
        printf 'trava automática: NUNCA sozinha (W-l manual manda)\n'
    else
        printf 'trava automática: %s min de inatividade → trava (a tela apaga no OFF_MIN do papel)\n' "$_lock"
        if [ "$_susp" != "0" ]; then
            printf 'sono de travado:   %s min depois da trava (a vigília E60)\n' "$_susp"
        else
            printf 'sono de travado:   desligado (SUSPEND_MIN=0)\n'
        fi
    fi
    printf 'conf: %s (o daemon relê na próxima armação — sem restart)\n' "$CONF"
    exit 0
fi

# ── N direto: o dono cravou o número ─────────────────────────────────────
case "${1:-}" in
    ''|*[!0-9]*) : ;;  # (cycle cai no ramo abaixo)
    *)
        escreve "$1"
        if [ "$1" = "0" ]; then
            nota "Nunca sozinha — o W-l manda na mão"
        else
            nota "Trava e apaga em $1 minuto(s) de inatividade"
        fi
        exit 0
        ;;
esac

# ── menu: O PAINEL DO DONO (1.0-94 — a cura do "clico e não abre nada":
# o cycle era mudo de janela — só a notificação; o item do menu agora
# abre o seletor NATIVO da casa com os presets e o estado atual na
# cabeça; a escolha escreve e a vigília arma NA HORA, como sempre).
if [ "${1:-}" = "menu" ]; then
    if ! command -v craft-pick >/dev/null 2>&1; then
        # sem o seletor nativo: o cycle de sempre (a função nunca morre)
        set -- cycle
    else
        _atual="$(le_lock)"
        _titulo="Trava automática"
        case "$_atual" in
            0) _titulo="Trava automática — NUNCA sozinha (W-l manual manda)" ;;
            60) _titulo="Trava automática — agora: 1 hora" ;;
            *) _titulo="Trava automática — agora: ${_atual} min" ;;
        esac
        # 1.0-104 — OS PRESETS DO DONO (5 min, 15 min, 30 min, 1 hora,
        # Desativado) + O BLOQUEIO IMEDIATO (Travar agora — o craft-lock
        # da casa, o mesmo W-l; a vigília do elite-daemon segue armada
        # com o conf atual: o travar-agora é o GESTO, nunca o desligar)
        _rc=0
        _escolha="$(printf '%s\n' "5 min" "15 min" "30 min" "1 hora" "Desativado" "Travar agora" \
            | _pick "$_titulo")" || _rc=$?
        # rc 1/2/143 = ESC/fora — a lei dos menus, benigno
        if [ "$_rc" = 0 ]; then
            case "$_escolha" in
                "5 min")       escreve 5  ;;
                "15 min")      escreve 15 ;;
                "30 min")      escreve 30 ;;
                "1 hora")      escreve 60 ;;
                "Desativado")   escreve 0  ;;
                "Travar agora")
                    if command -v craft-lock >/dev/null 2>&1; then
                        craft-lock >/dev/null 2>&1 &
                    fi
                    ;;
                *) exit 0 ;;
            esac
        fi
        exit 0
    fi
fi

# ── cycle: os presets da casa (1.0-104 — o ciclo VESTE os presets do
#    menu: 5 → 15 → 30 → 1 hora → Desativado → 5) ──────────────────────
_atual="$(le_lock)"
case "$_atual" in
    5)  _novo=15 ;;
    15) _novo=30 ;;
    30) _novo=60 ;;
    60) _novo=0  ;;
    *)  _novo=5  ;;
esac
escreve "$_novo"
if [ "$_novo" = "0" ]; then
    nota "Nunca sozinha — o W-l manda na mão (o ciclo volta a 5 no próximo clique)"
elif [ "$_novo" = "60" ]; then
    nota "Trava e apaga em 1 hora de inatividade"
else
    nota "Trava e apaga em $_novo minuto(s) de inatividade"
fi
