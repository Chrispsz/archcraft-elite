#!/bin/sh
# craft-idle — central de IDLE da Elite (v1.6.1)
# ─────────────────────────────────────────────────────────────────────────
# Diretriz do dono: "consigo controlar em quanto tempo o Pc entra em
# idle?" — antes os tempos eram HARDCODED no autostart (10 min lock /
# 15 min apagar). Agora vivem em ~/.config/elite/idle.conf e este script
# é a interface: presets no fuzzel (mesma família do craft-power/
# craft-connect), escrita no conf e REINÍCIO IMEDIATO do daemon —
# trocar o tempo vale NA HORA, sem relogin.
#
# FLUXO do idle (E44 — O GESTO ÚNICO; a versão antiga deste comentário
# vendia a janela 'X min trava → X+5 apaga' que o dono REJEITOU no rig:
# 'o PC vai pra tela de bloqueio e fica infinitamente' — travado e ACESO):
#   'X min de inatividade → TRAVA E APAGA no MESMO tick (hyprlock + wlopm
#                          --off — acorda já no lock, escuro de fato)'
# E60 — O BRAÇO DO LOCK É IDEMPOTENTE (--if-needed): o timeout do lock
#   chamava 'craft-lock' cru — se o hyprlock vivo rearmar o relógio de
#   idle do compositor (surface nova + grab = atividade), o tick voltava
#   a 0 e o lock REEXECUTAVA: escrachador infinito de relock e o suspend
#   (20min de idle) NUNCA disparava — o relato do dono ('bloqueia, passa
#   o tempo, nada acontece', v2.10.28+). Agora: lock vivo = no-op (o tick
#   re-ticado não recria NADA); lock morto = fluxo completo (E47 + E30
#   preservados nos caminhos que os prometem). E O SUSPEND GARANTIDO
#   ganhou a VIGÍLIA (craft-vigil — armada pelo próprio craft-lock): o
#   tempo TRAVADO decide, o relógio de idle deixou de ser o único juiz.
#   SUSPEND_MIN          → suspende ESCURO e TRAVADO (acorda no lock:
#                          senha UMA vez e usa — nunca suspende com
#                          alguém na frente; o conf legado X/Y é
#                          normalizado pelo daemon, com aviso explícito)
#   cada braço deixa linha no idle.log — 'a tela nunca apaga' e 'nunca
#   entra em idle' ganham RÉU NOMEADO com rc no papel
# E61 — O SUSPEND DO IDLE NÃO DORME SOB AS MÃOS (o dono esclareceu a
#   ordem: ele suspendia DEPOIS da senha digitada, nunca enquanto
#   travado): o braço idle DEFERE quando há lock vivo com vigília no ar
#   — enquanto travado, quem manda é a vigília (o deadline de idle não
#   vê digitação em compositor que não conta input travado). O resume
#   renova a marca de atividade (idle-activity) que a vigília lê.
#
# Uso:
#   craft-idle           menu de presets (mouse-first — item do menu do
#                        desktop: "Tempo para travar a tela…")
#   craft-idle start     sobe o daemon com os valores do conf (o
#                        autostart chama isto — única definição da
#                        receita swayidle, zero duplicação)
#   craft-idle status    mostra os valores vigentes
#
# E47 — O BEFORE-SLEEP SEM CORRIDA: o hook do suspend chama
#   'craft-lock --if-needed' — o hyprlock que JÁ está na tela (nascido no
#   timeout do LOCK_MIN, ou no 'Suspender' do menu) NÃO é morto e recriado
#   dentro da janela de 5s do logind (InhibitDelayMaxSec): o blur do
#   wallpaper demora segundos e o kernel congelava no meio da init — o
#   acordar podia não ter lock (a denúncia recorrente do dono: a lógica
#   do suspend/lock 'é burra'). Lock vivo sobrevive; lock morto recria
#   (auto-cura); o manual (W-l) segue a E30.
#
# v2.3.1 — FIM DO SILÊNCIO (família craft-*): open/falha do fuzzel deixam
# linha em ~/.cache/elite/menus.log — crash nunca mais é morte calada.
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/elite"
CONF="$CONF_DIR/idle.conf"

# E44 — a evidência do fluxo em ~/.cache/elite/idle.log (teto 256 KiB — a
# lei da família E36): apagar/acordar/suspende deixam linha com rc — o
# 'nunca entra em idle sozinho' do dono ganha prova, não opinião.
IDLE_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/idle.log"
# E61 — a marca de atividade que o RESUME deixa e a VIGÍLIA lê (o mtime
# é o último idle→ativo que o compositor viu — mundo A, onde input
# travado CONTA como atividade). Vive no XDG_RUNTIME_DIR (morre com a
# sessão — zero lixo em disco).
ACT_EPOCH="${XDG_RUNTIME_DIR:-/tmp}/elite/idle-activity"
ilog() {
    mkdir -p "${IDLE_LOG%/*}" 2>/dev/null || true
    if [ -f "$IDLE_LOG" ] && [ "$(wc -c <"$IDLE_LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$IDLE_LOG" > "$IDLE_LOG.tmp" 2>/dev/null && mv -f "$IDLE_LOG.tmp" "$IDLE_LOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$IDLE_LOG" 2>/dev/null
    return 0
}
# v2.10.8 — SUSPEND_MIN de fábrica 0 → 20: a 10.7 nascia com suspend OFF
# ('a ISO não muda comportamento às escondidas') e o dono ficou com um PC
# que NUNCA dormia — o dump d33o provou o kernel capaz ('freeze mem disk',
# mem_sleep [deep]) e o idle.conf do skel ditando 'nunca'. O default agora
# é o das outras distros (o que o dono pediu: 'consiga entrar em
# idle/suspensão'); 0 continua valendo (off consciente, explícito).
# E43 — fábrica = o gesto ÚNICO (trava E apaga no mesmo tick): 5 min.
# O padrão antigo (10 → 15) e o do rig do dono (2 → 7) deixavam a tela
# TRAVADA E ACESA no meio-caminho — o fluxo que o dono rejeitou no dump
# tg0b1. Um só instante: hyprlock + wlopm --off juntos; acorda no lock.
LOCK_MIN=5
OFF_MIN=5
SUSPEND_MIN=20  # auto-suspende APÓS X min de inatividade (o before-sleep
                # já travou — acorda no lock; 0 = off, escolha explícita)
# shellcheck disable=SC1090  # caminho dinâmico POR DESIGN: é o conf do
# usuário (~/.config/elite/idle.conf) — o ajuste sem relogin da v1.6.1
[ -r "$CONF" ] && . "$CONF"

# v2.10.5 — CONFIANÇA NO CONFINO, MAS PROVA DO VALOR: conf editado à mão
# com lixo ('LOCK_MIN=10min', linha vazia) não pode matar o daemon calado
# sob o set -eu (o -eq do start_daemon morreria antes do primeiro timeout).
# Valor ruim = padrão de fábrica, e o conf continua lá pra o usuário ver.
case "${LOCK_MIN:-}"    in ''|*[!0-9]*) LOCK_MIN=5     ;; esac
case "${OFF_MIN:-}"     in ''|*[!0-9]*) OFF_MIN=5      ;; esac
case "${SUSPEND_MIN:-}" in ''|*[!0-9]*) SUSPEND_MIN=20 ;; esac

# E44 — A NORMALIZAÇÃO DO FLUXO (o rig do dono: 2/7 = a janela 'travada e
# acesa' que ele denunciou — 'fica infinitamente na tela de bloqueio').
# Conf legado com LOCK>0 e OFF_MIN ≠ LOCK_MIN é a janela morta: o daemon
# REESCREVE o conf EXPLICITAMENTE (linha no idle.log + notificação — nada
# às escondidas, a lei da casa) e o gesto único vira o estado real. O
# update NUNCA pisa config de usuário — mas o FLUXO que a janela criava é
# 'uso burro' por definição do dono, e aqui ele morre com a prova no papel.
if [ "${LOCK_MIN:-0}" -gt 0 ] && [ "${OFF_MIN:-0}" -ne "${LOCK_MIN}" ]; then
    _off_velho="$OFF_MIN"
    OFF_MIN="$LOCK_MIN"
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    printf 'LOCK_MIN=%s\nOFF_MIN=%s\nSUSPEND_MIN=%s\n' "$LOCK_MIN" "$OFF_MIN" "${SUSPEND_MIN:-0}" > "$CONF"
    ilog "E44: conf legado normalizado — OFF_MIN ${_off_velho}→${OFF_MIN} (o gesto único: trava e apaga juntos; a janela 'travada e acesa' morre)"
    command -v notify-send >/dev/null 2>&1 && \
        timeout 5 notify-send -a 'Elite' -u normal -t 8000 'Idle · fluxo novo' \
            "Travar e apagar agora é UM gesto (${LOCK_MIN}min — era ${LOCK_MIN}/${_off_velho}). Ajuste no menu se quiser." || true
fi

# ── start: a receita inteira do swayidle num lugar só ────────────────────
start_daemon() {
    # E30 (v2.10.18) — MUTEX DO SPAWN (dump p6aw: DOIS swayidle vivos no
    # mesmo rig — pid 937 com o conf velho 10min e pid 21282 com o novo
    # 15min: o pkill+exec sem exclusão mútua deixa dois spawners
    # atravessarem — quem pkillou ANTES do outro exec não vê ninguém vivo
    # e ambos sobram; o lock de 10min dispara junto com o de 15min).
    # O lock mora no XDG_RUNTIME_DIR (morre com a sessão) e guarda o PID
    # do spawn em curso — após o exec, o MESMO pid É o swayidle, e o
    # /proc/$pid/comm distingue: 'sh' = spawn em voo (rival sai — o
    # vencedor da corrida serve a sessão); 'swayidle' = daemon vivo
    # (o rival é um RESTART legítimo, do menu do dono, e prossegue).
    LK="${XDG_RUNTIME_DIR:-/tmp}/elite/idle-start.lock"
    mkdir -p "${LK%/*}" 2>/dev/null || true
    if [ -f "$LK" ]; then
        lpid="$(cat "$LK" 2>/dev/null || true)"
        case "$lpid" in
            ''|*[!0-9]*)
                rm -f "$LK" ;;                       # lixo no lock — reescreve
            *)
                if kill -0 "$lpid" 2>/dev/null; then
                    lcomm=""
                    [ -r "/proc/$lpid/comm" ] && lcomm="$(cat "/proc/$lpid/comm" 2>/dev/null || true)"
                    if [ "$lcomm" != "swayidle" ]; then
                        exit 0   # spawn em voo — não nasce daemon duplo
                    fi
                else
                    rm -f "$LK"   # lock velho — o dono morreu
                fi
                ;;
        esac
    fi
    echo $$ > "$LK"
    # v2.5.0 (N4, audit 24-r): o lock por idle passa pelo CRAFT-LOCK (o
    # resolvedor de wallpaper png→jpg) — chamar hyprlock direto ignorava
    # a cadeia e dava fundo errado para quem usa só jpg.
    pkill -x swayidle 2>/dev/null || true
    i=0
    while [ "$i" -lt 20 ] && pgrep -x swayidle >/dev/null 2>&1; do
        sleep 0.1
        i=$((i + 1))
    done
    # E36 (audit de arquitetura — sessão Q4): o exit calado morria ANTES do
    # ramo do SUSPEND — "Travar: Nunca + Suspender: 20 min" gravava o conf,
    # dava pkill e não subia NADA: o usuário PERDIA um suspend que
    # funcionava, sem um aviso (o menu vende Travar e Suspender como
    # escolhas independentes — o daemon passou a respeitar a independência).
    if [ "${LOCK_MIN:-0}" -eq 0 ] && [ "${SUSPEND_MIN:-0}" -eq 0 ]; then
        rm -f "$LK"
        exit 0   # "Nunca" nos dois: ausência INTENCIONAL — sem daemon
    fi
    # E36 — o -i do craft-power (v2.10.12) espelhado no idle: inibidores
    # IGNORADOS — navegador com vídeo segurando o inibidor de sono deixava
    # o PC trancar e NUNCA dormir (o bug exato que o dono denunciou).
    # v2.3.5 — SUSPEND_MIN > 0 = auto-suspender depois de X min de idle
    # (o padrão das outras distros; o antes-sleep já trava — acorda no lock).
    if [ "${LOCK_MIN:-0}" -gt 0 ]; then
        if [ "${SUSPEND_MIN:-0}" -gt 0 ]; then
            exec swayidle -w \
                timeout $((LOCK_MIN * 60)) 'craft-lock --if-needed' \
                timeout $((OFF_MIN * 60)) 'craft-idle screenoff' \
                resume 'craft-idle screenon' \
                timeout $((SUSPEND_MIN * 60)) 'craft-idle suspend' \
                before-sleep 'craft-lock --if-needed'
        fi
        exec swayidle -w \
            timeout $((LOCK_MIN * 60)) 'craft-lock --if-needed' \
            timeout $((OFF_MIN * 60)) 'craft-idle screenoff' \
            resume 'craft-idle screenon' \
            before-sleep 'craft-lock --if-needed'
    fi
    # E36 — LOCK_MIN=0 com SUSPEND_MIN>0: sem lock automático ("Nunca" é a
    # escolha EXPLÍCITA do dono — nem before-sleep trava; quem quiser
    # privacidade no wake trava à mão com W-l). O suspend prometido é
    # ENTREGUE, o DPMS segue (apagar tela ≠ travar).
    exec swayidle -w \
        timeout $((OFF_MIN * 60)) 'craft-idle screenoff' \
        resume 'craft-idle screenon' \
        timeout $((SUSPEND_MIN * 60)) 'craft-idle suspend'
}

case "${1:-}" in
    start)  start_daemon ;;
    status)
        # E36 — o status conta a verdade nos 4 estados (o "nunca" antigo
        # escondia o suspend que a combinação Nunca+20min AGORA entrega).
        if [ "${LOCK_MIN:-0}" -eq 0 ]; then
            if [ "${SUSPEND_MIN:-0}" -gt 0 ]; then
                echo "idle: suspend aos ${SUSPEND_MIN}min (travar é manual — W-l)"
            else
                echo "idle: nunca (travar é manual — W-l)"
            fi
        else
            # E43 — o gesto único: quando trava e apaga é o MESMO instante, o
            # status diz a verdade sem fingir dois eventos.
            if [ "${LOCK_MIN}" -eq "${OFF_MIN}" ]; then
                echo "idle: trava e apaga aos ${LOCK_MIN}min · suspend: ${SUSPEND_MIN:-0}"
            else
                echo "idle: trava aos ${LOCK_MIN}min · tela apaga aos ${OFF_MIN}min · suspend: ${SUSPEND_MIN:-0}"
            fi
        fi
        exit 0
        ;;
    # E44 — os BRAÇOS OBSERVÁVEIS do fluxo: o swayidle executa ESTES
    # subcomandos (não os binários crus) — todo resultado deixa linha com
    # rc no idle.log. 'A tela nunca apaga' e 'nunca entra em idle' viram
    # réu nomeado, não reclamação sem corpo (a lei E33 no papel).
    # E61 — E SAEM DE IMEDIATO: os braços são callbacks do DAEMON — cair
    # no menu interativo depois da ação pendurava o callback num 'read'
    # com stdin vivo (achado do smoke test da E61: 'craft-idle suspend'
    # bloqueado 120s — o filho do swayidle herdaria o stdin da sessão).
    screenoff)
        if wlopm --off '*'; then
            ilog "tela: APAGOU (wlopm rc=0) — gesto único do lock cumprido"
        else
            ilog "FALHA: wlopm --off rc=$? — a tela NÃO apagou (réu nomeado no papel)"
        fi
        exit 0
        ;;
    screenon)
        # E61 — A ORELHA DO COMPOSITOR: TODO idle→ativo renova a marca
        # (mtime) ANTES de qualquer efeito — a VIGÍLIA lê este arquivo e
        # ADIA o suspend com mãos no lock. Em compositor que conta input
        # travado, a digitação da senha renova a marca a cada tecla.
        mkdir -p "${ACT_EPOCH%/*}" 2>/dev/null || true
        : > "$ACT_EPOCH" 2>/dev/null || true
        # E63 — A VOLTA DA IMAGEM: acordar deixou de ser UM tiro único.
        # Relato do dono (06/nov): suspendeu, voltou — e o monitor ficou
        # SEM SINAL (luz vermelha) até o clique no power desligar o PC.
        # O wlopm de UMA vez corre a corrida contra a re-inicialização do
        # driver/compositor no resume e perde: o output morre DESLIGADO no
        # DRM com o sistema já de pé (e o logind, com HandlePowerKey
        # default, desliga no segundo aperto — o poder de decisão ficou
        # com o estado de pânico do dono). Sondagem: até 6 tentativas a
        # cada 2s (12s de janela — a re-init do driver dá conta); o
        # primeiro rc=0 vence e o resto nem roda. Idempotente com o hook
        # de sistema (elite-resume-display) e com a vigília — wlopm --on
        # em output aceso é no-op.
        i=0
        rc=0
        while [ "$i" -lt 6 ]; do
            rc=0
            wlopm --on '*' || rc=$?
            if [ "$rc" -eq 0 ]; then
                ilog "tela: ACORDOU (wlopm rc=0, tentativa $((i + 1)))"
                break
            fi
            i=$((i + 1))
            sleep 2
        done
        if [ "$rc" -ne 0 ]; then
            ilog "FALHA: wlopm --on rc=$rc após 6 tentativas — a tela NÃO acordou (réu nomeado no papel; o driver/compositor contam no craft-dump seção 10)"
        fi
        # E63 — A VIGÍLIA RENASCE NO RESUME: ela MORRE depois do suspend
        # que ela mesma disparou (missão cumprida — exit 0) e o braço idle
        # do suspend SÓ DEFERE com vigia no ar (E61). Lock vivo com vigia
        # morto no wake = o dono na frente do lock (tela preta, senha
        # pendente) e a rede de fundo ABLE de dormir sob as mãos de novo
        # — o bug que a E61 curou, reintroduzido pelo próprio ciclo de
        # sono. Re-armar aqui fecha o ciclo: o wake renova a marca,
        # religa a tela e re-embaralha o vigia — lock vivo tem autoridade
        # de novo. (O vigia que chama ESTE screenon após o seu suspend vê
        # o próprio sucessor no ar e sai sem re-armar.)
        if pgrep -x hyprlock >/dev/null 2>&1 && ! pgrep -x craft-vigil >/dev/null 2>&1; then
            setsid craft-vigil >/dev/null 2>&1 &
            ilog "VIGÍLIA: re-armada no resume (lock vivo, vigia morto — o braço idle volta a DEFERIR)"
        fi
        exit 0
        ;;
    suspend)
        # E61 — O SUSPEND DO IDLE NÃO DORME SOB AS MÃOS (a ordem certa,
        # esclarecida pelo dono: ele suspendia DEPOIS da senha digitada —
        # nunca enquanto travado). A arma era ESTE braço: o deadline de
        # idle não vê a digitação quando o compositor não conta input
        # travado como atividade — o timeout vencia com a senha no meio e
        # o PC dormia em vez de desbloquear. Agora: lock vivo COM vigília
        # no ar = DEFERIDO — enquanto travado, o tempo TRAVADO é a
        # autoridade (a vigília tem orelhas e não dorme sob o dono). Lock
        # vivo com vigília MORTA = o braço volta a ser rede de fundo
        # (E47/E30 preservados — o before-sleep mantém o lock vivo). Lock
        # morto = fluxo normal (LOCK_MIN=0 e wake manual intactos).
        if pgrep -x hyprlock >/dev/null 2>&1 && pgrep -x craft-vigil >/dev/null 2>&1; then
            ilog "idle: suspend DEFERIDO — lock vivo com vigília no ar (o tempo TRAVADO manda; o sintoma 'suspende quando digito a senha' era este braço)"
            exit 0
        fi
        ilog "suspendindo (idle ${SUSPEND_MIN:-?}min — escuro e travado: acorda no lock, senha UMA vez)"
        if systemctl suspend -i; then
            ilog "suspend: ciclo completo (dormiu e voltou — o idle EXISTE e está no papel)"
        else
            ilog "FALHA: systemctl suspend -i rc=$? — o PC NÃO dormiu (réu nomeado no papel)"
        fi
        exit 0
        ;;
esac

# ── menu de presets (fuzzel · mesma âncora da família craft-*) ───────────
CUR="${LOCK_MIN}min"
[ "${LOCK_MIN:-0}" -eq 0 ] && CUR='nunca'

# v2.10.12 — AS ETIQUETAS FALAVAM MEIO BAJO (relato do dono: 'mudei o
# tempo de tela para 2 minutos e a tela bloqueou invés de suspender —
# essa lógica está toda errada'): o menu dizia só '2 minutos' e era o
# TEMPO DE TRAVAR (o lock vem primeiro — acorda já travado é a lei
# v1.6.1) — e o SUSPENDER não tinha knob nenhum (SUSPEND_MIN=20 fixo de
# fábrica, invisível). Agora cada item nomeia o que faz e o suspender é
# escolha do dono no MESMO menu (SUSPEND_MIN=0 = nunca, suportado no
# start desde a v2.3.5).
# E43 — O GESTO ÚNICO NO MENU: 'Travar: N minutos' virou 'Idle: N min
# (trava e apaga)' — o item nomeia o que acontece de verdade (lock+off no
# MESMO instante; a janela 'travada e acesa' dos presets antigos, que o
# dono rejeitou ('as montagens do bloquear e do suspender fazendo mais
# sentido'), morre aqui). O 'Suspender: 5 min' entra porque o dono o
# flutuou — o padrão fica em 20 (5min suspende um desktop com trabalho
# vivo; a escolha de 5 é um clique, não uma edição).
# E46 — O MENU EM DUAS PORTAS (o dono: "organiza melhor o de tempo de idle
# e etc"): a parede de 13 itens (7 de tela + 6 de suspend numa lista só)
# virou DUAS SEÇÕES NOMEADAS — a 1ª porta diz o que controla E mostra o
# valor ATUAL no próprio item ('Tela: trava e apaga — 5 min'); o 2º nível
# lista só os valores da seção, com a marca '← atual'. O fallback de
# terminal também aprendeu o gesto único: ele AINDA escrevia OFF_MIN=
# mins+5 — a janela 'travada e acesa' que a E43 matou no menu sobrevivia
# no terminal (E33 de espelho, achado da própria ordem E46).
# v2.10.26/E38 — o MENU órfão saiu: era definido aqui e INCONDICIONALMENTE
# sobrescrito dentro do if do craft-menu (o else terminal usa read/prompt,
# nunca $MENU) — 12 linhas mortas que a suíte teria que carregar para
# sempre. O MENU vivo é o de dentro do if (com a marca '← atual').

if command -v craft-menu >/dev/null 2>&1; then
    # v2.3.8 — o menu NATIVO (título centrado, sem linha de digitação —
    # o dono: "remover a barra que fica").
    # E46 — o pick com a gramática COMPLETA do craft-menu (143/2/1/erro)
    # mora numa função só: as TRÊS portas (seção, tela, suspender) falam
    # a mesma gramática sem tríplicar o tratamento. Os itens entram por
    # STDIN (um por linha — o espaço dentro do item nunca vira separador).
    idle_pick() {
        _ip_title="$1"
        errf="$(mktemp)"
        ec=0
        choice="$(craft-menu --title="$_ip_title" --at=power 2>"$errf")" || ec=$?
        if [ "$ec" -eq 143 ]; then
            mlog "Idle: fechado de fora (SIGTERM — cross-dismiss) — benigno"
            rm -f "$errf"
            exit 0
        fi
        if [ "$ec" -eq 2 ]; then
            mlog "Idle: toggle — 2ª chamada fechou o menu — benigno"
            rm -f "$errf"
            exit 0
        fi
        if [ "$ec" -eq 1 ]; then
            # v2.3.10 — fechar NUNCA é erro, COM OU SEM stderr (o gate velho
            # '! -s "$errf"' gritava FALHOU em fechamento normal — a pilha
            # de notificações eternas da foto do dono). stderr vai pro log.
            if [ -s "$errf" ]; then
                mlog "Idle: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
            else
                mlog "Idle: fechado pelo usuário (ESC) — benigno"
            fi
            rm -f "$errf"
            exit 0
        fi
        if [ "$ec" -ne 0 ]; then
            mlog "Idle: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
            # v2.10.5 — FIM DO ÚLTIMO LOG-ONLY: todo irmão (power/rollback/
            # connect) avisa na central; o idle era o único que falhava calado
            # para quem está na tela.
            command -v notify-send >/dev/null 2>&1 && \
                timeout 5 notify-send -a 'Elite' -u normal -t 6000 'Idle' \
                    "Menu do idle falhou (exit=$ec) — log: ~/.cache/elite/menus.log" || true
        fi
        rm -f "$errf"
        printf '%s' "$choice" | sed 's/ ← atual$//'
    }
    # o valor corrente na LÍNGUA DO MENU (o item EXATO — a marca nunca
    # falha por divergência de texto; herdeiro do audit 24-c)
    cur_lock_item() {
        case "${LOCK_MIN:-0}" in
            0)  printf 'Nunca (só W-l)' ;;
            60) printf '1 hora' ;;
            *)  printf '%s min' "${LOCK_MIN:-0}" ;;
        esac
    }
    cur_susp_item() {
        case "${SUSPEND_MIN:-0}" in
            0)  printf 'Nunca' ;;
            20) printf '20 min (padrão)' ;;
            60) printf '1 hora' ;;
            *)  printf '%s min' "${SUSPEND_MIN:-0}" ;;
        esac
    }
    lock_txt="$(cur_lock_item)"
    susp_txt="$(cur_susp_item)"
    mlog "Idle: abrindo (craft-menu — duas portas)"
    secao="$(printf '%s\n' \
        "Tela: trava e apaga — $lock_txt" \
        "Suspender após o idle — $susp_txt" | idle_pick 'Idle')" || exit 0
    case "$secao" in
        'Tela: trava e apaga'*)
            # E43/E46 — o gesto único: os valores AQUI são LOCK=OFF (a
            # janela 'travada e acesa' não tem mais porta em nenhum menu)
            itens="$(printf '%s\n' '2 min' '5 min' '10 min' '15 min' '30 min' '1 hora' 'Nunca (só W-l)' \
                | sed "s|^${lock_txt}\$|& ← atual|")"
            choice="$(printf '%s\n' "$itens" | idle_pick 'Tela (trava e apaga)')" || exit 0
            case "$choice" in
                '2 min')          LOCK_MIN=2;  OFF_MIN=2  ;;
                '5 min')          LOCK_MIN=5;  OFF_MIN=5  ;;
                '10 min')         LOCK_MIN=10; OFF_MIN=10 ;;
                '15 min')         LOCK_MIN=15; OFF_MIN=15 ;;
                '30 min')         LOCK_MIN=30; OFF_MIN=30 ;;
                '1 hora')         LOCK_MIN=60; OFF_MIN=60 ;;
                'Nunca (só W-l)') LOCK_MIN=0;  OFF_MIN=0  ;;
                *)                exit 0 ;;
            esac ;;
        'Suspender após o idle'*)
            itens="$(printf '%s\n' '5 min' '10 min' '20 min (padrão)' '30 min' '1 hora' 'Nunca' \
                | sed "s|^${susp_txt}\$|& ← atual|")"
            choice="$(printf '%s\n' "$itens" | idle_pick 'Suspender após o idle')" || exit 0
            case "$choice" in
                '5 min')           SUSPEND_MIN=5  ;;
                '10 min')          SUSPEND_MIN=10 ;;
                '20 min (padrão)') SUSPEND_MIN=20 ;;
                '30 min')          SUSPEND_MIN=30 ;;
                '1 hora')          SUSPEND_MIN=60 ;;
                'Nunca')           SUSPEND_MIN=0  ;;
                *)                 exit 0 ;;
            esac ;;
        *) exit 0 ;;
    esac
else
    mlog "Idle: fuzzel AUSENTE — fallback terminal"
    # sem fuzzel: prompt de terminal (foot -e) — não trava o ajuste
    printf 'Idle — minutos até travar (atual: %s; vazio = cancela): ' "$CUR"
    read -r mins || mins=''   # v2.10.5: EOF/set -e não mata calado — vazio = cancela
    case "$mins" in
        ''|*[!0-9]*) exit 0 ;;
        # E46 — o gesto único vale TAMBÉM no terminal (OFF=LOCK): o fallback
        # ainda escrevia OFF=mins+5 — a janela 'travada e acesa' que a E43
        # matou no menu sobrevivia aqui. E o 0 AGORA persiste (antes: o
        # 'Nunca' do terminal cavia no `*)` do case antigo e saía sem
        # escrever — ajuste que o usuário fez e o conf nunca soube).
        *)  LOCK_MIN="$mins"; OFF_MIN="$mins"
            mkdir -p "$CONF_DIR"
            printf 'LOCK_MIN=%s\nOFF_MIN=%s\nSUSPEND_MIN=%s\n' "$LOCK_MIN" "$OFF_MIN" "${SUSPEND_MIN:-0}" > "$CONF"
            setsid craft-idle start >/dev/null 2>&1 &
            exit 0 ;;
    esac
fi

# persiste e reinicia o daemon JÁ (efeito imediato, sem relogin)
# v2.10.5 — SUSPEND_MIN VIAJA NO REESCRITO: o menu regravava SÓ lock/off
# e o suspend opt-in do usuário MORRIA na primeira troca de tempo de lock
# (mudança de comportamento silenciosa — a lei proíbe).
mkdir -p "$CONF_DIR"
printf 'LOCK_MIN=%s\nOFF_MIN=%s\nSUSPEND_MIN=%s\n' "$LOCK_MIN" "$OFF_MIN" "${SUSPEND_MIN:-0}" > "$CONF"
setsid craft-idle start >/dev/null 2>&1 &
exit 0
