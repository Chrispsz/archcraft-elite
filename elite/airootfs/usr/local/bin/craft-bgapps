#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-bgapps (v4.1 — SÓ PROGRAMA DO DONO, v2.6.0)
# ═══════════════════════════════════════════════════════════════════════════
# Pedido ORIGINAL (out/2026, ao instalar a v2.3.3): "um botão tray na
# topbar para encerrar programas que estão executando em segundo plano".
#
# A LEI v2.3.10 (fica): a SESSÃO nunca aparece — compositor, barras,
# áudio, dbus, portals, keyring, idle, notificações, clipboard, automount,
# acessibilidade, systemd/sd, os craft-* (matar isso não é "encerrar um
# app", é quebrar o desktop) — e TODO PROGRAMA de verdade aparece:
# nativo, flatpak (o processo real dentro do sandbox tem o próprio nome),
# AppImage, interpretado. Varredura = o /proc/ps REAL do UID; casamento
# POR PREFIXO (o ps corta o comm em 15 caracteres — at-spi2-registr,
# xdg-document-po e gvfsd-metadata vazavam na lista exata da v2.3.7).
#
# A LEI v2.4.0 (o dono: "abri o Brave e abriu 11 serviços no preview…
# deve pegar sempre a execução principalmente do programa… só no processo
# principal e nos programas do usuário"):
#   · UM PROCESSO POR PROGRAMA — entra no menu o PRINCIPAL de cada
#     árvore: o candidato cujo PAI não é outro candidato. Filhos
#     (renderer/gpu/utility do Chromium, zygotes, crashpad, o app dentro
#     do sandbox do flatpak) são a sombra do programa — NUNCA entrada.
#     O Brave volta a ser 1, não 11;
#   · cintura de segurança: cmdline com " --type=" (família Chromium)
#     nunca é principal — nem órfã adotada pelo init;
#   · o tooltip vira DESCRIÇÃO curta, a gramática dos outros módulos
#     ("não precisa de preview apenas uma descrição assim como outro e
#     ao clicar que abre o menu") — o preview da lista morreu;
#   · status à prova de bala: QUALQUER falha interna ainda emite JSON
#     válido — o botão nunca some por erro de leitura (só por não ter
#     programa de verdade, que é a regra).
#
# A LEI v2.6.0 (o dono, prints do rig 26/out: "continua pegando serviços
# do sistema que inclusive não encerram — (sd-pam), dconf-service,
# gvfs-udisks2-vo, gvfs-mtp-volume"):
#   · o comm de kernel-vênia era o BURACO: o sd-pam se apresenta como
#     "(sd-pam)" — COM PARÊNTESES — e o padrão sd-pam* não casava; o
#     dconf e os monitores gvfs-* (cortados pelo ps em 15 chars) idem.
#     O comm agora é NORMALIZADO (parênteses fora) e a casca ganhou
#     dconf* · gvfs* (cobre gvfsd E gvfs-*) · Xwayland* · hyprlock/idle ·
#     labnag*;
#   · cinto: CANDIDATO SEM DISPLAY NUNCA É PROGRAMA — o /proc/PID/environ
#     sem WAYLAND_DISPLAY/DISPLAY é assinatura de serviço de fundo (o
#     Brave, o Files e o Terminal conversam com o compositor; o sd-pam,
#     o dconf e o gvfs, nunca);
#   · ENCERRAR de VERDADE: SIGTERM, espera 2s, e quem aguentou ganha
#     SIGKILL — o dono não clica duas vezes no mesmo botão por teimosia
#     do processo.
#
# Verbos: status → JSON do módulo custom/bgapps (vazio = botão some);
#         menu   → craft-menu com "nome (pid N)"; o escolhido recebe
#                  SIGTERM (+SIGKILL teimoso) + notificação que SOME.
#
# A CURA v4.1 (o dono, rig da v2.10.2: "a parte de programas em segundo
# plano não funciona, eu clico na tarefa e ela não encerra"): a escolha é
# 'Nome (pid N)' e o corte ${choice##*pid } deixava o ')' no fim — o
# guard *[!0-9]* rejeitava TODA escolha ('escolha sem pid válido' no
# menus.log) e o kill NUNCA partia. O pid agora é SÓ dígito (tr -cd
# '0-9'): o parêntese morre e qualquer ruído futuro do formato morre
# junto. Prova funcional na suíte (a extração roda de verdade).
#
# A CURA v4.2 (o dono, rig da 28: "tá pegando python 3, pactl e etc no
# botão de encerrar programas, o Brave continua sem aparecer lá para
# fechar e não sei se detecta tudo") — DOIS RÉUS PROVADOS COM PROVA DE
# COMPORTAMENTO no sandbox (o comm de script python3 invocado DIRETO é
# o INTERPRETADOR, não o script — provado: `python3 /tmp/x.py` →
# /proc/comm = 'python3'):
#   1. O 'python 3' do menu ERA O CRAFT-AUDIO-ROUTE — o daemon de
#      roteamento de áudio nasce com shebang '#!/usr/bin/env python3'
#      (a cadeia env executa o interpretador DIRETO → comm = 'python3')
#      e corre com WAYLAND_DISPLAY no environ (conversa com a sessão).
#      O seu filho 'pactl subscribe' (craft-bars o supervisiona) é o
#      'pactl' da lista. Matar 'python3'/'pactl' = MATAR O ÁUDIO — e o
#      craft-bars RESSUSCITA o daemon: o dono matava e eles VOLTAVAM
#      ('tá pegando python 3, pactl e etc'). CURA DUPLA: (a) o
#      candidato cujo comm é interpretador se apresenta pelo SCRIPT do
#      cmdline (caminho com '/' que EXISTE — '/usr/local/bin/craft-
#      audio-route' → nome 'craft-audio-route' → a casca craft-* o
#      pega); sem script real (python3 -c/-m/pip) é encanamento, nunca
#      programa; (b) o encanamento de ÁUDIO/MÍDIA da casa entra na
#      casca (pactl/wpctl/playerctl/pulsemixer — o subscribe é filho
#      permanente do daemon; playerctl vive nos bindings da topbar;
#      pulsemixer é o W-a; wpctl é a sonda do PipeWire).
#   2. 'O Brave não aparece' GANHA RÉU NOMEADO: quem é cortado como
#      SOMBRA deixa linha no menus.log com QUEM o sombreou
#      (BGAPPS_TRACE=1 nos verbos menu/list; o status de 30s NUNCA
#      escreve — a lei do teto E36). 'Não sei se detecta tudo' passa a
#      ser pergunta com resposta no papel: o verbo NOVO `list` mostra
#      a lista bruta (o mesmo que o menu vê), linha a linha.
# ═══════════════════════════════════════════════════════════════════════════
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    # teto de 256 KiB (mesma política do bars.log — evidência recente vale mais)
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# ── a CASCA da sessão (nunca listada, nunca morta) — POR PREFIXO ────────────
# ps -o comm= corta em 15 caracteres — o case casa o PREFIXO que sobrevive
# ao corte. O próprio craft-bgapps roda como craft-* — coberto pelo
# prefixo craft-. flatpak* (sem traço) cobre o wrapper `flatpak run` E os
# serviços flatpak-* — o que fica na lista é o app REAL dentro do sandbox.
is_protected() {
    case "$1" in
        # compositor · barras · ferramentas da casa
        labwc*|waybar*|craft-*|elite-*|labnag*|swaybg*|fuzzel*|nwg-*|kanshi*|wlsunset*)
            return 0 ;;
        # lock/idle/notificações/clipboard/automount — serviço, não app
        swaylock*|swayidle*|swaync*|cliphist*|wl-copy*|wl-paste*|udiskie*|playerctld*|mpd*|mako*|dunst*|hyprlock*|hypridle*|hyprpaper*)
            return 0 ;;
        # E30 (v2.10.18, dump p6aw): o dono matou 'notify-send' no menu e o
        # killer AVISOU a morte do próprio aviso — recursão cômica e ruído.
        # notify-send é um cliente efêmero (nasce, avisa, morre); tumblerd/
        # xfconfd são serviços de sessão dbus-ativados — matar é inútil
        # (renascem no próximo acesso; o dono matou os dois às 16:12). Saem
        # da lista: o menu encerra PROGRAMAS, não encanamento da sessão.
        notify-send*|tumblerd*|xfconfd*)
            return 0 ;;
        # áudio · dbus · systemd · portals · keyring · acessibilidade · sandbox
        # v2.6.0 — dconf* (o serviço de config do rig) · gvfs* (cobre gvfsd
        #          E os monitores gvfs-udisks2-vo/gvfs-mtp-volume, cortados
        #          pelo ps em 15 chars) · Xwayland* (o servidor, não os apps)
        pipewire*|wireplumber*|dbus*|systemd*|sd-pam*|dconf*|gvfs*|at-spi*|xdg-*|polkit*|gnome-keyring*|bwrap*|flatpak*|gjs*|Xwayland*)
            return 0 ;;
        # terminal da sessão (a janela fecha por ela mesma, não daqui)
        foot*)
            return 0 ;;
        # interpretadores e pipe-fitting: ruído de pipeline, nunca "programa"
        sh|bash|zsh|fish|dash|ksh|sleep|sudo|doas|tee|cat|tail|head|grep|sed|awk|cut|sort|uniq|wc|xargs|env|nohup|setsid|timeout|watch|ps|pgrep|pkill|kill|date|mkdir|rm|mv|cp|ln|chmod|chown|tr|find|basename|dirname|readlink|stat|true|false|which|mktemp)
            return 0 ;;
        # v4.2 — encanamento de ÁUDIO/MÍDIA da casa: o 'pactl subscribe' é
        # filho PERMANENTE do craft-audio-route (matar = matar o roteamento,
        # e o supervisor ressuscita o par — o dono matava e eles voltavam);
        # playerctl vive nos bindings da topbar; pulsemixer é o W-a;
        # wpctl é a sonda do PipeWire. Ferramenta de consulta/controle, não
        # "programa do dono" (a mesma lei do dconf*/gvfs* da v2.6.0).
        pactl*|wpctl*|playerctl*|pulsemixer*)
            return 0 ;;
    esac
    return 1
}

# ── UM processo por PROGRAMA: o PRINCIPAL de cada árvore ────────────────────
# 1ª passada: candidatos do usuário (pid ppid comm) fora da casca e da
#             render-pipeline do Chromium.
# 2ª passada: principal = candidato cujo PAI não é outro candidato.
#             (o pai ser encanamento — labwc, systemd --user, bwrap — é o
#             sinal de que este É o topo da árvore do programa).
list_main_entries() {
    uid="$(id -u)"
    cands="$(ps -u "$uid" -o pid=,ppid=,comm= 2>/dev/null || true)"
    [ -n "$cands" ] || return 0

    survivors=" "
    clean=""
    while read -r pid ppid comm; do
        [ -n "${comm:-}" ] || continue
        # v2.6.0 — o comm normalizado: o sd-pam se apresenta como "(sd-pam)"
        # (com parênteses — assinatura do systemd) e escapava do padrão
        # sd-pam*; os parênteses SAEM antes do casamento
        case "$comm" in
            \(*\)) comm="${comm#\(}"; comm="${comm%\)}" ;;
        esac
        is_protected "$comm" && continue
        # v2.6.0 — cinto: CANDIDATO SEM DISPLAY NUNCA É PROGRAMA. O
        # /proc/PID/environ sem WAYLAND_DISPLAY/DISPLAY é serviço de fundo
        # (dconf, gvfs, sd-pam conversam por D-Bus; o Brave, o Files e o
        # Terminal conversam com o compositor). Falso-positivo na lista
        # doía mais que falso-negativo: serviço NUNCA entra.
        # v2.10.12 — A CORRIDA DO PROCESSO MORRENDO (dump nl3z, bars.log
        # ×4: 'linha 133: /proc/13298/environ: Processo inexistente'): o
        # -r passa e o arquivo some ANTES do redirect — o erro é do SHELL
        # do pipeline (o 2>/dev/null do tr não o cobre). O subshell com
        # stderr fechado engole o erro da corrida; sem environ legível =
        # sem Wayland = service (a semântica de falha conservadora fica).
        if [ -r "/proc/$pid/environ" ] && \
           ! ( tr '\0' '\n' <"/proc/$pid/environ" ) 2>/dev/null | \
             grep -q -e '^WAYLAND_DISPLAY=' -e '^DISPLAY='; then
            continue
        fi
        # cintura de segurança: filho da render-pipeline (Chromium e
        # derivados — Brave/Chrome/Edge/Electron) nunca é principal,
        # nem quando o pai morreu e o init o adotou
        if [ -r "/proc/$pid/cmdline" ] && \
           tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q -- ' --type='; then
            continue
        fi
        # v4.2 — O NOME HONESTO DO INTERPRETADOR: script python lançado
        # DIRETO (python3 /caminho/app — ou shebang '#!/usr/bin/env
        # python3', onde a cadeia env executa o interpretador direto) tem
        # comm = 'python3', o INTERPRETADOR. O réu real: o craft-audio-
        # route aparecia como 'python 3' no menu (e o filho 'pactl' ao
        # lado) — matar era matar o áudio, e o supervisor ressuscitava:
        # o dono matava e eles VOLTAVAM. O candidato-interpretador se
        # apresenta pelo SCRIPT do cmdline: caminho com '/' que EXISTE;
        # sem script real (-c/-m/pip) é encanamento, nunca programa. O
        # nome resolvido passa pela MESMA casca (craft-*/elite-* caem
        # aqui) e o menu mostra o nome de VERDADE (um app python de
        # terceiros aparece como o seu nome, não como 'python3').
        case "$comm" in
            python|python3|python3.*)
                script=""
                if [ -r "/proc/$pid/cmdline" ]; then
                    script="$( (tr '\0' '\n' <"/proc/$pid/cmdline") 2>/dev/null | \
                        awk 'NR>1 && $0 !~ /^-/ && $0 !~ /^python3?(\.[0-9]+)?$/ {print; exit}')"
                fi
                case "$script" in
                    # v4.2 — o caminho resolve NO CWD DO PROCESSO
                    # (/proc/pid/cwd — mágica do kernel): cmdline relativo
                    # ('./app') é real, o CWD do MENÚ não manda
                    /*) [ -f "$script" ] || script="" ;;
                    */*) [ -f "/proc/$pid/cwd/$script" ] || script="" ;;
                    *)   script="" ;;
                esac
                if [ -z "$script" ]; then
                    continue    # interpretador sem script = encanamento
                fi
                comm="$(basename "$script")"
                ;;
        esac
        is_protected "$comm" && continue
        survivors="$survivors$pid "
        clean="$clean$pid $ppid $comm
"
    done <<EOF
$cands
EOF
    [ -n "$clean" ] || return 0

    while read -r pid ppid comm; do
        [ -n "${pid:-}" ] || continue
        case "$survivors" in
            *" $ppid "*)
                # v4.2 — A EXCLUSÃO COM RÉU NOMEADO (o 'não sei se detecta
                # tudo' do dono): quem é cortado como sombra deixa LINHA
                # com QUEM o sombreou — sob trace (menu/list ligam;
                # status de 30s NUNCA escreve, lei do teto E36). 'O Brave
                # não aparece' passa a ter resposta no papel: ou entra,
                # ou a linha nomeia o pai que o sombreou.
                if [ "${BGAPPS_TRACE:-0}" = "1" ]; then
                    pcomm="$(printf '%s\n' "$clean" | awk -v p="$ppid" '$1==p {print $3; exit}')"
                    mlog "sombra: $comm (pid $pid) — filho de ${pcomm:-?} (pid $ppid) — não é principal"
                fi
                continue ;;   # filho de outro programa — a sombra
        esac
        printf '%s (pid %s)\n' "$comm" "$pid"
    done <<EOF
$clean
EOF
}

status() {
    entries="$(list_main_entries)" || entries=""
    if [ -z "$entries" ]; then
        printf '{"text":"","class":"","tooltip":""}\n'
        return 0
    fi
    count="$(printf '%s\n' "$entries" | grep -c '(pid ')"
    # v2.4.0 — o tooltip é DESCRIÇÃO (a gramática dos outros módulos), não
    # preview: nada de lista, o MENU mora no clique.
    if [ "$count" -eq 1 ]; then
        tip="1 programa em 2º plano — clique: escolher o que encerrar"
    else
        tip="$count programas em 2º plano — clique: escolher o que encerrar"
    fi
    # glifo como escape JSON \uXXXX (lição v1.1: ASCII puro, à prova de
    # encoding); zero newline cru no JSON (lição v2.3.7 — o waybar recusa)
    printf '{"text":"\\uf085 %s","class":"bgapps-on","tooltip":"%s"}\n' \
        "$count" "$tip"
}

menu() {
    # a lei dos fechamentos (ESC benigno, cross-dismiss, toggle) vive na
    # GRAMÁTICA de saída do craft-menu — este script só obedece os códigos.
    # v4.2 — o menu roda COM trace: toda sombra cortada deixa réu nomeado
    # no menus.log (o 'não sei se detecta tudo' do dono tem resposta).
    entries="$(BGAPPS_TRACE=1 list_main_entries)"
    if [ -z "$entries" ]; then
        # corrida benigna: o botão estava na barra e o app saiu sozinho
        mlog "Processos: nada vivo para encerrar — saindo"
        exit 0
    fi

    mlog "Processos: abrindo (craft-menu)"
    errf="$(mktemp)"
    ec=0
    # stdin = a interface dmenu do craft-menu (listas dinâmicas sem eval)
    choice="$(printf '%s\n' "$entries" | craft-menu --title='Encerrar' --at=bgapps 2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # SIGTERM = fechado de fora (cross-dismiss) — benigno.
        mlog "Processos: fechado de fora (SIGTERM — cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 2 ]; then
        # toggle — VIVO e determinístico: o 2º clique no MESMO título faz
        # o craft-menu matar o fuzzel PELO PID gravado e sair 2 (lei do
        # pid desde a v4 — o rig DESMENTIU a 'física do compositor'; o
        # comentário antigo dizia 'ramo dormente' e mentia — E38/E33).
        mlog "Processos: toggle — 2ª chamada fechou o menu — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ]; then
        # fechar NUNCA é erro, COM OU SEM stderr (a lei v2.3.10 — a pilha
        # de notificações eternas da foto do dono). stderr vai pro log.
        if [ -s "$errf" ]; then
            mlog "Processos: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        else
            mlog "Processos: fechado pelo usuário (ESC) — benigno"
        fi
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Processos: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        # falha REAL avisa e SOME (urgência normal + timeout — um daemon
        # preso nunca prende o chamador).
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                'Menu de processos falhou' \
                "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"

    [ -n "$choice" ] || exit 0   # Esc: nada acontece
    # v4.1 — o pid é SÓ DÍGITO: o corte ##*pid deixava o ')' da entrada
    # 'Nome (pid N)' e o guard rejeitava TODA escolha — o encerrar
    # NUNCA partia (o relato exato do dono). tr -cd cova o parêntese
    # e qualquer ruído futuro do formato.
    pid="$(printf '%s' "${choice##*pid }" | tr -cd '0-9')"
    case "$pid" in
        ''|*[!0-9]*) mlog "Processos: escolha sem pid válido — '$choice'"; exit 0 ;;
    esac
    name="${choice%% (pid*}"
    if kill -TERM "$pid" 2>/dev/null; then
        mlog "Processos: SIGTERM enviado — $name (pid $pid)"
        # v2.6.0 — o encerrar de VERDADE: 2s de paciência (o app salva
        # estado no TERM); quem aguentou ganha SIGKILL. O dono clica UMA vez.
        i=0
        while [ "$i" -lt 8 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 0.25
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null
            mlog "Processos: SIGKILL — $name (pid $pid) ignorou o TERM"
        fi
        # E30 (v2.10.18) — O ENCERRAR FICA MUDO (o dono: 'ao encerrar
        # programas não precisa aparecer notificação'; a foto p6aw mostrou
        # 3 toasts de encerrado empilhados — o feedback REAL de um programa
        # encerrado é a janela sumir e o ícone sair da dock, não um toast
        # que nasce e morre sozinho). O log fica (forense viva); o toast
        # só em FALHA de verdade.
    else
        mlog "Processos: kill falhou — $name (pid $pid) (saiu sozinho?)"
        # saiu sozinho = o objetivo do dono já aconteceu — silêncio também
    fi
}

case "${1:-}" in
    status) status || printf '{"text":"","class":"","tooltip":""}\n' ;;
    menu)   menu ;;
    # v4.2 — a lista BRUTA no stdout (o que o menu veria, linha a linha):
    # a forense do 'não sei se detecta tudo' do dono — e a porta da suíte.
    list)   BGAPPS_TRACE=1 list_main_entries ;;
    *) printf 'uso: craft-bgapps [status|menu|list]\n' >&2; exit 2 ;;
esac
