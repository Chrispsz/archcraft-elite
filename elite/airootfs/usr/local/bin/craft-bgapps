#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-bgapps (v3.0 — UM processo por PROGRAMA, v2.4.0)
# ═══════════════════════════════════════════════════════════════════════════
# Pedido ORIGINAL (out/2026, ao instalar a v2.3.3): "um botão tray na
# topbar para encerrar programas que estão executando em segundo plano".
#
# A LEI v2.3.10 (fica): a SESSÃO nunca aparece — compositor, barras,
# áudio, dbus, portals, keyring, idle, notificações, clipboard, automount,
# acessibilidade, systemd/sd, os craft-* (matar isso não é "encerrar um
# app", é quebrar o desktop) — e TODO PROGRAMA de verdade aparece:
# nativo, flatpak (o processo real dentro do sandbox tem o próprio nome),
# AppImage, interpretado. Varredura = o /proc/ps REAL do UID; casamento
# POR PREFIXO (o ps corta o comm em 15 caracteres — at-spi2-registr,
# xdg-document-po e gvfsd-metadata vazavam na lista exata da v2.3.7).
#
# A LEI v2.4.0 (o dono: "abri o Brave e abriu 11 serviços no preview…
# deve pegar sempre a execução principalmente do programa… só no processo
# principal e nos programas do usuário"):
#   · UM PROCESSO POR PROGRAMA — entra no menu o PRINCIPAL de cada
#     árvore: o candidato cujo PAI não é outro candidato. Filhos
#     (renderer/gpu/utility do Chromium, zygotes, crashpad, o app dentro
#     do sandbox do flatpak) são a sombra do programa — NUNCA entrada.
#     O Brave volta a ser 1, não 11;
#   · cintura de segurança: cmdline com " --type=" (família Chromium)
#     nunca é principal — nem órfã adotada pelo init;
#   · o tooltip vira DESCRIÇÃO curta, a gramática dos outros módulos
#     ("não precisa de preview apenas uma descrição assim como outro e
#     ao clicar que abre o menu") — o preview da lista morreu;
#   · status à prova de bala: QUALQUER falha interna ainda emite JSON
#     válido — o botão nunca some por erro de leitura (só por não ter
#     programa de verdade, que é a regra).
#
# Verbos: status → JSON do módulo custom/bgapps (vazio = botão some);
#         menu   → craft-menu com "nome (pid N)"; o escolhido recebe
#                  SIGTERM + notificação que SOME.
# ═══════════════════════════════════════════════════════════════════════════
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    # teto de 256 KiB (mesma política do bars.log — evidência recente vale mais)
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# ── a CASCA da sessão (nunca listada, nunca morta) — POR PREFIXO ────────────
# ps -o comm= corta em 15 caracteres — o case casa o PREFIXO que sobrevive
# ao corte. O próprio craft-bgapps roda como craft-* — coberto pelo
# prefixo craft-. flatpak* (sem traço) cobre o wrapper `flatpak run` E os
# serviços flatpak-* — o que fica na lista é o app REAL dentro do sandbox.
is_protected() {
    case "$1" in
        # compositor · barras · ferramentas da casa
        labwc*|waybar*|craft-*|elite-*|labnag*|swaybg*|fuzzel*|nwg-*|kanshi*|wlsunset*)
            return 0 ;;
        # lock/idle/notificações/clipboard/automount — serviço, não app
        swaylock*|swayidle*|swaync*|cliphist*|wl-copy*|wl-paste*|udiskie*|playerctld*|mpd*|mako*|dunst*)
            return 0 ;;
        # áudio · dbus · systemd · portals · keyring · acessibilidade · sandbox
        pipewire*|wireplumber*|dbus*|systemd*|sd-pam*|at-spi*|xdg-*|gvfsd*|polkit*|gnome-keyring*|bwrap*|flatpak*|gjs*)
            return 0 ;;
        # terminal da sessão (a janela fecha por ela mesma, não daqui)
        foot*)
            return 0 ;;
        # interpretadores e pipe-fitting: ruído de pipeline, nunca "programa"
        sh|bash|zsh|fish|dash|ksh|sleep|sudo|doas|tee|cat|tail|head|grep|sed|awk|cut|sort|uniq|wc|xargs|env|nohup|setsid|timeout|watch|ps|pgrep|pkill|kill|date|mkdir|rm|mv|cp|ln|chmod|chown|tr|find|basename|dirname|readlink|stat|true|false|which|mktemp)
            return 0 ;;
    esac
    return 1
}

# ── UM processo por PROGRAMA: o PRINCIPAL de cada árvore ────────────────────
# 1ª passada: candidatos do usuário (pid ppid comm) fora da casca e da
#             render-pipeline do Chromium.
# 2ª passada: principal = candidato cujo PAI não é outro candidato.
#             (o pai ser encanamento — labwc, systemd --user, bwrap — é o
#             sinal de que este É o topo da árvore do programa).
list_main_entries() {
    uid="$(id -u)"
    cands="$(ps -u "$uid" -o pid=,ppid=,comm= 2>/dev/null || true)"
    [ -n "$cands" ] || return 0

    survivors=" "
    clean=""
    while read -r pid ppid comm; do
        [ -n "${comm:-}" ] || continue
        is_protected "$comm" && continue
        # cintura de segurança: filho da render-pipeline (Chromium e
        # derivados — Brave/Chrome/Edge/Electron) nunca é principal,
        # nem quando o pai morreu e o init o adotou
        if [ -r "/proc/$pid/cmdline" ] && \
           tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q -- ' --type='; then
            continue
        fi
        survivors="$survivors$pid "
        clean="$clean$pid $ppid $comm
"
    done <<EOF
$cands
EOF
    [ -n "$clean" ] || return 0

    while read -r pid ppid comm; do
        [ -n "${pid:-}" ] || continue
        case "$survivors" in
            *" $ppid "*) continue ;;   # filho de outro programa — a sombra
        esac
        printf '%s (pid %s)\n' "$comm" "$pid"
    done <<EOF
$clean
EOF
}

status() {
    entries="$(list_main_entries)" || entries=""
    if [ -z "$entries" ]; then
        printf '{"text":"","class":"","tooltip":""}\n'
        return 0
    fi
    count="$(printf '%s\n' "$entries" | grep -c '(pid ')"
    # v2.4.0 — o tooltip é DESCRIÇÃO (a gramática dos outros módulos), não
    # preview: nada de lista, o MENU mora no clique.
    if [ "$count" -eq 1 ]; then
        tip="1 programa em 2º plano — clique: escolher o que encerrar"
    else
        tip="$count programas em 2º plano — clique: escolher o que encerrar"
    fi
    # glifo como escape JSON \uXXXX (lição v1.1: ASCII puro, à prova de
    # encoding); zero newline cru no JSON (lição v2.3.7 — o waybar recusa)
    printf '{"text":"\\uf085 %s","class":"bgapps-on","tooltip":"%s"}\n' \
        "$count" "$tip"
}

menu() {
    # a lei dos fechamentos (ESC benigno, cross-dismiss, toggle) vive na
    # GRAMÁTICA de saída do craft-menu — este script só obedece os códigos.
    entries="$(list_main_entries)"
    if [ -z "$entries" ]; then
        # corrida benigna: o botão estava na barra e o app saiu sozinho
        mlog "Processos: nada vivo para encerrar — saindo"
        exit 0
    fi

    mlog "Processos: abrindo (craft-menu)"
    errf="$(mktemp)"
    ec=0
    # stdin = a interface dmenu do craft-menu (listas dinâmicas sem eval)
    choice="$(printf '%s\n' "$entries" | craft-menu --title='Encerrar' 2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # SIGTERM = fechado de fora (cross-dismiss) — benigno.
        mlog "Processos: fechado de fora (SIGTERM — cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 2 ]; then
        # toggle (aposentado na v2.4.0 — virou física do compositor; o
        # ramo fica dormente por compatibilidade da gramática).
        mlog "Processos: toggle — 2ª chamada fechou o menu — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ]; then
        # fechar NUNCA é erro, COM OU SEM stderr (a lei v2.3.10 — a pilha
        # de notificações eternas da foto do dono). stderr vai pro log.
        if [ -s "$errf" ]; then
            mlog "Processos: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        else
            mlog "Processos: fechado pelo usuário (ESC) — benigno"
        fi
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Processos: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        # falha REAL avisa e SOME (urgência normal + timeout — um daemon
        # preso nunca prende o chamador).
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                'Menu de processos falhou' \
                "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"

    [ -n "$choice" ] || exit 0   # Esc: nada acontece
    pid="${choice##*pid }"
    case "$pid" in
        ''|*[!0-9]*) mlog "Processos: escolha sem pid válido — '$choice'"; exit 0 ;;
    esac
    name="${choice%% (pid*}"
    if kill -TERM "$pid" 2>/dev/null; then
        mlog "Processos: SIGTERM enviado — $name (pid $pid)"
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 4000 'Encerrado' \
                "$name (pid $pid) recebeu o sinal de término." || true
    else
        mlog "Processos: kill falhou — $name (pid $pid) (saiu sozinho?)"
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 'Não encerrou' \
                "$name (pid $pid) — o processo pode ter saído sozinho." || true
    fi
}

case "${1:-}" in
    status) status || printf '{"text":"","class":"","tooltip":""}\n' ;;
    menu)   menu ;;
    *) printf 'uso: craft-bgapps [status|menu]\n' >&2; exit 2 ;;
esac
