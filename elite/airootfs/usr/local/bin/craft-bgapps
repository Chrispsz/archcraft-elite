#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-bgapps (v2.0 — só PROGRAMA de verdade, v2.3.10)
# ═══════════════════════════════════════════════════════════════════════════
# Pedido ORIGINAL (out/2026, ao instalar a v2.3.3): "um botão tray na
# topbar para encerrar programas que estão executando em segundo plano".
#
# A CORREÇÃO DO DONO (live 25/10, foto do tooltip: 17 "apps" que eram
# encanamento da sessão + o próprio craft-bgapps 7×): "essa função dos
# processos é ruim… esses processos do sistema não deveriam aparecer e
# também deve pegar todo tipo de programa, appimage, flatpak e etc".
#
# A LEI NOVA (v2.3.10):
#   · o que é da SESSÃO nunca aparece — compositor, barras, áudio, dbus,
#     portals, keyring, idle, notificações, clipboard, automount,
#     acessibilidade, systemd/sd, os craft-* (a própria ferramenta);
#     matar isso não é "encerrar um app", é quebrar o desktop;
#   · TODO PROGRAMA de verdade aparece — nativo, flatpak (o processo
#     real dentro do sandbox tem o próprio nome), AppImage (o binário
#     montado), interpretado — a varredura é o /proc real do UID, sem
#     lista inventada;
#   · casamento POR PREFIXO (case), não por lista exata: o ps corta o
#     comm em 15 caracteres (at-spi2-registr, xdg-document-po,
#     gvfsd-metadata) e a lista exata da v2.3.7 deixava vazar exatamente
#     esses.
#
# Verbos: status → JSON do módulo custom/bgapps (vazio = botão some);
#         menu   → craft-menu com "nome (pid N)"; o escolhido recebe
#                  SIGTERM + notificação que SOME (v2.3.10: -u normal).
# ═══════════════════════════════════════════════════════════════════════════
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    # teto de 256 KiB (mesma política do bars.log — evidência recente vale mais)
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# ── a CASCA da sessão (nunca listada, nunca morta) — POR PREFIXO ────────────
# ps -o comm= corta em 15 caracteres — o case casa o PREFIXO que sobrevive
# ao corte: at-spi2-registr, xdg-document-po e gvfsd-metadata vazavam na
# lista exata da v2.3.7 (foto do dono). O próprio craft-bgapps roda como
# craft-* — coberto pelo prefixo craft- (7 cópias na foto; o poller de
# 10s da waybar + os menus abertos se acumulavam e entravam na lista).
is_protected() {
    case "$1" in
        # compositor · barras · ferramentas da casa
        labwc*|waybar*|craft-*|elite-*|labnag*|swaybg*|fuzzel*|nwg-*|kanshi*|wlsunset*)
            return 0 ;;
        # lock/idle/notificações/clipboard/automount — serviço, não app
        swaylock*|swayidle*|swaync*|cliphist*|wl-copy*|wl-paste*|udiskie*|playerctld*|mpd*|mako*|dunst*)
            return 0 ;;
        # áudio · dbus · systemd · portals · keyring · acessibilidade
        pipewire*|wireplumber*|dbus*|systemd*|sd-pam*|at-spi*|xdg-*|gvfsd*|polkit*|gnome-keyring*|bwrap*|flatpak-*|gjs*)
            return 0 ;;
        # terminal da sessão (a janela fecha por ela mesma, não daqui)
        foot*)
            return 0 ;;
        # interpretadores e pipe-fitting: ruído de pipeline, nunca "programa"
        sh|bash|zsh|fish|dash|ksh|sleep|sudo|doas|tee|cat|tail|head|grep|sed|awk|cut|sort|uniq|wc|xargs|env|nohup|setsid|timeout|watch|ps|pgrep|pkill|kill|date|mkdir|rm|mv|cp|ln|chmod|chown|tr|find|basename|dirname|readlink|stat|true|false|which|mktemp)
            return 0 ;;
    esac
    return 1
}

# ── varredura: comms ÚNICOS do usuário, fora da casca ───────────────────────
list_bgapps() {
    ps -u "$(id -u)" -o comm= 2>/dev/null | sort -u | while IFS= read -r c; do
        [ -n "$c" ] || continue
        is_protected "$c" && continue
        printf '%s\n' "$c"
    done
}

# "nome (pid N)" para cada pid vivo de cada candidato — o formato que o
# menu exibe e de onde o pid volta (última coisa depois de "pid ")
list_entries() {
    list_bgapps | while IFS= read -r c; do
        pgrep -u "$(id -u)" -x "$c" 2>/dev/null | while IFS= read -r pid; do
            printf '%s (pid %s)\n' "$c" "$pid"
        done
    done
}

status() {
    entries="$(list_entries)"
    if [ -z "$entries" ]; then
        printf '{"text":"","class":"","tooltip":""}\n'
        return 0
    fi
    count="$(printf '%s\n' "$entries" | grep -c '(pid ')"
    names="$(printf '%s\n' "$entries" | sed 's/^/ • /; s/ (pid [0-9]*)$//' | sed -z 's/\n/\\n/g')"
    # glifo como escape JSON \uXXXX (lição v1.1: ASCII puro, à prova de
    # encoding — waybar decodifica o escape ao renderizar)
    # v2.3.7 — os \n dos nomes viram escape JSON (sed -z): newline CRUO
    # dentro de string JSON é ILEGAL e o waybar cuspia 'Error parsing
    # JSON · Line 1, Column 51' a cada 10s — o botão morreu no live do
    # dono (bars.log 25/10). Zero newline cru: JSON nasce inteiro.
    printf '{"text":"\\uf085 %s","class":"bgapps-on","tooltip":"Em segundo plano (%s):\\n%s\\nClique para escolher o que encerrar."}\n' \
        "$count" "$count" "$names"
}

menu() {
    # v2.3.8 — a lei (toggle + cross-dismiss) é ESTRUTURAL no craft-menu:
    # este script não mata irmão nenhum mais (o menu nativo cuida — 2ª
    # chamada do mesmo título fecha; abrir outro menu fecha este).

    entries="$(list_entries)"
    if [ -z "$entries" ]; then
        # corrida benigna: o botão estava na barra e o app saiu sozinho
        mlog "Processos: nada vivo para encerrar — saindo"
        exit 0
    fi

    mlog "Processos: abrindo (craft-menu)"
    errf="$(mktemp)"
    ec=0
    # stdin = a interface dmenu do craft-menu (listas dinâmicas sem eval)
    choice="$(printf '%s\n' "$entries" | craft-menu --title='Encerrar' 2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # v2.3.5 — SIGTERM = fechado de fora (cross-dismiss) —
        # benigno: sem notify crítico falso (o print do dono).
        mlog "Processos: fechado de fora (SIGTERM — cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 2 ]; then
        # v2.3.8 — TOGGLE estrutural (a lei mora no craft-menu)
        mlog "Processos: toggle — 2ª chamada fechou o menu — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ]; then
        # v2.3.10 — fechar NUNCA é erro, COM OU SEM stderr (o gate velho
        # '! -s "$errf"' gritava FALHOU em fechamento normal — a pilha de
        # notificações eternas da foto do dono). stderr vai pro log.
        if [ -s "$errf" ]; then
            mlog "Processos: fechado pelo usuário (ESC) — benigno — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        else
            mlog "Processos: fechado pelo usuário (ESC) — benigno"
        fi
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Processos: MENU FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        # v2.3.10 — falha REAL avisa e SOME (urgência normal + timeout 5 —
        # o toast eterno da urgência critical é a pilha da foto do dono,
        # e um daemon preso nunca prende o chamador).
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 \
                'Menu de processos falhou' \
                "craft-menu exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"

    [ -n "$choice" ] || exit 0   # Esc: nada acontece
    pid="${choice##*pid }"
    case "$pid" in
        ''|*[!0-9]*) mlog "Processos: escolha sem pid válido — '$choice'"; exit 0 ;;
    esac
    name="${choice%% (pid*}"
    if kill -TERM "$pid" 2>/dev/null; then
        mlog "Processos: SIGTERM enviado — $name (pid $pid)"
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 4000 'Encerrado' \
                "$name (pid $pid) recebeu o sinal de término." || true
    else
        mlog "Processos: kill falhou — $name (pid $pid) (saiu sozinho?)"
        command -v notify-send >/dev/null 2>&1 && \
            timeout 5 notify-send -a 'Elite' -u normal -t 8000 'Não encerrou' \
                "$name (pid $pid) — o processo pode ter saído sozinho." || true
    fi
}

case "${1:-}" in
    status) status ;;
    menu)   menu ;;
    *) printf 'uso: craft-bgapps [status|menu]\n' >&2; exit 2 ;;
esac
