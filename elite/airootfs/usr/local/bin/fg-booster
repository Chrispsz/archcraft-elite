#!/usr/bin/env bash
# =====================================================================
#  fg-booster v4.1 — o "plasma-foreground-booster" (CachyOS) para X11
#  genérico (Openbox/BSPWM do Archcraft).
#
#  Sessão labwc (default da Elite v1.0.3+): este booster atua apenas em
#  clientes XWayland (jogos Steam/proton são X11 na prática) quando há
#  ~/.Xauthority; sem Xauthority ele fica em no-op silencioso — sem erro,
#  sem crash-loop (guarda `[[ -f $XA ]] || continue`). Jogo em foco segue
#  garantido por gamemoderun/mangohud em qualquer sessão.
#
#  O que faz:
#    · App em foco  → árvore de processos promovida para fg-boost.slice
#                     (CPUWeight/IOWeight altos, SEM teto de VRAM).
#    · Perde o foco → árvore devolvida ao cgroup LEAF de origem
#                     (registrado no momento da promoção). Escrita em
#                     leaf é SEMPRE permitida pelo kernel (cgroup v2) —
#                     a devolução não pode falhar por "no internal
#                     processes", bug da v4.0.
#    · Tetos de VRAM para background: NÃO são daqui — são do
#      dmemcg-booster (CachyOS). Este script não escreve MemoryDevice*
#      por design (evita hazard de jogo sob teto em GPUs AMD).
#
#  Validação (rode uma vez):
#    systemctl status fg-booster
#    systemd-cgls /fg-boost.slice   (app focado deve aparecer aqui,
#                                    e SUMIR ao perder o foco)
# =====================================================================
set -u

CG=/sys/fs/cgroup
POLL=1
last=""
tick=0
declare -A ORIG   # pid-raiz → cgroup leaf de origem

command -v xdotool >/dev/null 2>&1 || { echo "fg-booster: xdotool ausente"; exit 1; }
[[ -d "$CG/fg-boost.slice" ]] || { echo "fg-booster: fg-boost.slice não existe (systemctl start fg-boost.slice)"; exit 1; }

# árvore de processos (filhos, netos...)
tree() {
  local p=$1 c
  for c in $(ps -o pid= --ppid "$p" 2>/dev/null); do tree "$c"; done
  echo "$p"
}

# caminho cgroup v2 (hierarquia unificada) de um pid
cgroup_of() { awk -F: '/^0::/ {print $3}' "/proc/$1/cgroup" 2>/dev/null; }

# devolve a árvore ao cgroup leaf de origem
demote() {
  local root=$1 dst=${ORIG[$1]:-}
  if [[ -n "$dst" && -d "$CG$dst" ]]; then
    local p
    for p in $(tree "$root" 2>/dev/null); do
      echo "$p" > "$CG$dst/cgroup.procs" 2>/dev/null
    done
  fi
  unset "ORIG[$root]"
  return 0
}

# promove a árvore para o slice turbinado, registrando a origem
promote() {
  local root=$1 dst
  dst=$(cgroup_of "$root")
  [[ -n "$dst" ]] || return 0
  ORIG[$root]=$dst
  local p
  for p in $(tree "$root" 2>/dev/null); do
    echo "$p" > "$CG/fg-boost.slice/cgroup.procs" 2>/dev/null
  done
  return 0
}

while sleep "$POLL"; do
  # a cada 30 polls: limpa PIDs mortos do mapa ORIG (evita crescimento)
  (( tick = (tick + 1) % 30 )) || for _p in "${!ORIG[@]}"; do
    [[ -e /proc/$_p ]] || unset "ORIG[$_p]"
  done
  # sessões gráficas seat0 (uid por uid)
  for uid in $(loginctl list-sessions --no-legend  2>/dev/null \
               | awk '($4=="seat0"){print $2}' | sort -u); do
    H=$(getent passwd "$uid" | cut -d: -f6)
    XA="$H/.Xauthority"
    [[ -f "$XA" ]] || continue
    for D in :0 :1; do
      FOC=$(DISPLAY=$D XAUTHORITY=$XA xdotool getactivewindow getwindowpid 2>/dev/null) || continue
      [[ "$FOC" == "$last" ]] && continue 2
      U=$(ps -o user= -p "$FOC" 2>/dev/null | tr -d ' ')
      # greeter/root/daemon: registra e segue (sem promover)
      if [[ -z "$U" || "$U" == "root" || "$U" == "gdm" || "$U" == "sddm" || "$U" == "lightdm" ]]; then
        last="$FOC"; continue 2
      fi
      [[ -n "$last" ]] && demote "$last"
      promote "$FOC"
      last="$FOC"
      continue 2
    done
  done
done
