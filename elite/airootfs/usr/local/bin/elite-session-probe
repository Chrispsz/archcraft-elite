#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-session-probe (v2.2) — evidência da SESSÃO GRÁFICA
# ═══════════════════════════════════════════════════════════════════════════
# POR QUÊ: o gate do CI (verify/QEMU) boota a ISO e para no LOGIN — nunca
# viu a sessão gráfica. As duas barras waybar morreram caladas no rig do
# dono por 3 releases seguidas (v1.6.2 → v1.7.0: "iniciou sem aparecer nada
# além do wallpaper") e o CI nunca pôde gritar, porque o sintoma nasce DEPOIS
# do ponto onde o gate olhava.
#
# CURA: este probe roda 60s após o graphical.target (ver
# elite-session-probe.service), colhe o ESTADO REAL da sessão (barras vivas,
# mortes registradas no bars.log, memória, versões) e imprime um bloco
# MARCADO no console — no QEMU do gate o console é o serial, que o gate
# grepa (ELITE_PROBE_BEGIN/END, WAYBAR_COUNT, DOCK_COUNT, BARS_EXITS). No
# stdout vai a mesma carga (→ journal do systemd, forense pós-mortem).
#
# v2.1.1 (run #93): a sessão v2.0 é waybar top + dock NATIVA — o probe
# só contava waybar e o gate cobrava "2 waybars" (contrato da era
# waybar-dock, defasado). Agora DOCK_COUNT entra no bloco. E134: a dock
# é o BINÁRIO Rust craft-dock-rs (o comm casa o nome; a contagem da era
# Python era por cmdline — o fóssil seguiu contado à parte no craft-dump).
#
# Inofensivo por construção: one-shot, sem escrita em disco, exit 0 SEMPRE
# (uma unidade failed aqui viraria falso negativo do gate "nenhuma unidade
# em failed" — o probe é observador, nunca parte do sistema).
# ═══════════════════════════════════════════════════════════════════════════

say() {
    printf '%s\n' "$1"
    # console (serial no QEMU do gate; tty texto no rig — invisível sob X/WL)
    if [ -w /dev/console ]; then
        printf '%s\n' "$1" >/dev/console 2>/dev/null
    fi
    return 0
}

# contador à prova de dupla impressão (pgrep -c imprime "0" E sai 1 — o
# `|| echo 0` clássico duplicaria a linha no command substitution)
count() {
    c="$(pgrep -c "$1" 2>/dev/null)"
    [ -n "$c" ] || c=0
    printf '%s' "$c"
}

wb_list="$(pgrep -a waybar 2>/dev/null | tr '\n' ';' | sed 's/;$//')"
wb_count="$(count waybar)"
sn_count="$(count swaync)"
# E137 — O PROBE AUDITA O LANÇADOR REAL: a sessão é filha do
# `elite-daemon session` (o craft-bars execa o binário — E135). As
# métricas fósseis morrem: o contador do craft-bars contava o NOME de um wrapper
# que virou exec (o sh some do ps por desenho — o número mentia 0 com a
# sessão viva, o dump 201219 fotografou o contador em 0 na casa sã) e
# DOCK_COUNT ancorava o cmdline COMPLETO '^/usr/local/bin/craft-dock-rs$'
# que o daemon nunca escreve (ele lança por PATH — argv[0]=
# 'craft-dock-rs'; a dock VIVA era contada como 0 no mesmo dump). A
# contagem agora é por COMM (-x), o nome que o kernel garante nos DOIS
# mundos de spawn.
dk_count="$(pgrep -c -x craft-dock-rs 2>/dev/null)"; [ -n "$dk_count" ] || dk_count=0
# o motor: o daemon da sessão + a trava da porta session (a vaga é de
# quem segura o flock — a mesma prova de posse do supervise)
daemon_count="$(count elite-daemon)"
daemon_session="LIVRE"
flock -n /tmp/elite-daemon-session.lock true 2>/dev/null || daemon_session="ATIVO"
# os residentes da família (o painel completo da sessão em números)
idle_count="$(count swayidle)"
osd_count="$(count swayosd-server)"
udiskie_count="$(count udiskie)"
pk_count="$(pgrep -c -f 'lxqt-policykit-agent' 2>/dev/null)"; [ -n "$pk_count" ] || pk_count=0
# v2.10.1: o daemon wlr-foreign-toplevel (a dock COMUTADORA) — vivo E
# FALANDO (a prova é o PING no socket da sessão, não só o processo)
tp_count="$(count craft-toplevel)"
tp_sock="DEAD"
for s in /run/user/*/elite/toplevel.sock; do
    [ -S "$s" ] || continue
    if PYTHONDONTWRITEBYTECODE=1 python3 - "$s" <<'PY' 2>/dev/null
import socket, sys
c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
c.settimeout(2)
c.connect(sys.argv[1])
c.sendall(b"PING\n")
assert c.recv(64).startswith(b"PONG")
PY
    then
        tp_sock="OK"
        break
    fi
done

# barras.log de TODOS os usuários (live=liveuser; instalado=dono do login)
restarts=0
exits=0
logf=""
for f in /root/.cache/elite/bars.log /home/*/.cache/elite/bars.log; do
    [ -f "$f" ] || continue
    r="$(grep -c 'FORA — reiniciando' "$f" 2>/dev/null)"
    [ -n "$r" ] || r=0
    e="$(grep -c 'SAIU exit=' "$f" 2>/dev/null)"
    [ -n "$e" ] || e=0
    restarts=$((restarts + r))
    exits=$((exits + e))
    logf="$f"
done

# E138 — O MOTOR DO JOGO NA PROVA (a ordem do dono, dump v2.13: AUTO=1
# ativo mas 'watch FORA — sem daemon vivo' — a vaga do jogo é filha da
# sessão desde a E138; a métrica lê o game-watch.pid que o MOTOR escreve
# e o AUTO do conf — ON = AUTO=1 E pid vivo; OFF = AUTO=0 (ausência
# intencional); FORA = AUTO=1 sem motor (a doença do dump, nomeada)
game_watch="FORA"
_gw_auto=0
for _gw_home in /home/* /root; do
    [ -r "$_gw_home/.config/elite/game.conf" ] || continue
    grep -qx 'AUTO=1' "$_gw_home/.config/elite/game.conf" 2>/dev/null && { _gw_auto=1; break; }
done
if [ "$_gw_auto" = 1 ]; then
    game_watch="FORA"
    for _gwp in /run/user/*/elite/game-watch.pid; do
        [ -r "$_gwp" ] || continue
        _gwd="$(cat "$_gwp" 2>/dev/null)"
        [ -n "$_gwd" ] && [ -d "/proc/$_gwd" ] && { game_watch="ON"; break; }
    done
else
    game_watch="OFF"
fi
unset _gw_auto _gw_home _gwp _gwd

say "ELITE_PROBE_BEGIN"
say "WAYBAR_COUNT=$wb_count"
say "DOCK_COUNT=$dk_count"
say "TOPLEVEL_COUNT=$tp_count"
say "TOPLEVEL_SOCKET=$tp_sock"
say "SWAYNC_COUNT=$sn_count"
say "IDLE_COUNT=$idle_count"
say "OSD_COUNT=$osd_count"
say "UDISKIE_COUNT=$udiskie_count"
say "POLICYKIT_COUNT=$pk_count"
# E137 — O MOTOR NA PROVA: o elite-daemon (session/game/supervise) e a
# TRAVA da porta session (posse provada por flock — a métrica que
# substitui a fóssil do craft-bars; o gate do QEMU segue consumindo
# os tokens de sempre, WAYBAR/DOCK/TOPLEVEL/BARS_EXITS)
say "ELITE_DAEMON_COUNT=$daemon_count"
say "DAEMON_SESSION=$daemon_session"
# E138 — ON = AUTO=1 com o motor vivo (vaga da sessão); OFF = AUTO=0
# (ausência intencional assinada); FORA = AUTO=1 SEM motor (o réu do
# dump v2.13, agora visível no papel da casa)
say "GAME_WATCH=$game_watch"
# E43 — a verdade da supervisão é a POSSE DO LOCK: ATIVO = o flock está
# segurado (o craft-bars segura e o exec para o daemon HERDA o fd — em
# ambos os mundos a trava segue viva enquanto a sessão vive); LIVRE =
# ninguém cuidando (o que nunca pode dormir).
sup_lock="LIVRE"
flock -n "${XDG_RUNTIME_DIR:-/run/user/1000}/elite/bars.lock" true 2>/dev/null || sup_lock="ATIVO"
say "SUPERVISOR_LOCK=$sup_lock"
say "BARS_RESTARTS=$restarts"
say "BARS_EXITS=$exits"
# E117 — O RÓTULO QUE JURAVA CONTAGEM E MOSTRAVA LISTA (dump 163548: o
# perito leria 'WAYBAR_PROCS=997 waybar -c …' como NOVECENTAS waybars
# vivas — era o PID do processo ÚNICO concatenado com o cmdline do
# pgrep -a). Hoje: a contagem de verdade numa linha, a lista na outra —
# a família E33 aplicada ao próprio papel da casa.
say "WAYBAR_PROCS=$wb_count"
say "WAYBAR_LIST=$wb_list"
say "BARS_LOG=$logf"
if [ -n "$logf" ]; then
    tail -12 "$logf" 2>/dev/null | while IFS= read -r line; do
        say "BARS| $line"
    done
fi
mem="$(free -m 2>/dev/null | awk 'NR==2 {printf "%s/%sMB", $3, $2}')"
say "MEM=$mem"
say "WAYBAR_VER=$(waybar --version 2>/dev/null | head -1)"
say "LABWC_VER=$(labwc --version 2>/dev/null | head -1)"

# ── v2.3.1 — MENUS: a família craft-* (Sessão/Rede/Fixar/Idle/Logout) ────
# vive no fuzzel e morria CALADA (a denúncia do rig na v2.1.1: "os menus
# morreram e não funcionam" — o stderr ia pro /dev/null). Evidência que o
# probe consegue colher sem abrir janela nenhuma:
#   FUZZEL_BIN/FUZZEL_VER — binário presente e executável;
#   FUZZEL_INI           — o fuzzel.ini DO USUÁRIO parseado de verdade
#                          (configparser strict; seção principal+cores é
#                          contrato — config corrompida = todos os 5 menus
#                          mortos antes de desenhar);
#   MENUS|/DOCK|         — caudas dos logs de runtime (vazio = nada
#                          falhou; falha de menu agora É logada).
say "FUZZEL_BIN=$(command -v fuzzel 2>/dev/null || echo AUSENTE)"
say "FUZZEL_VER=$(fuzzel --version 2>/dev/null | head -1)"
ini_ok="skip"
if command -v python3 >/dev/null 2>&1; then
    for f in /root/.config/fuzzel/fuzzel.ini /home/*/.config/fuzzel/fuzzel.ini; do
        [ -f "$f" ] || continue
        if PYTHONDONTWRITEBYTECODE=1 python3 - "$f" <<'PY' 2>/dev/null
import configparser, sys
cp = configparser.ConfigParser(strict=True)
cp.read(sys.argv[1])
assert {'main', 'colors', 'border'} <= set(cp.sections())
PY
        then
            ini_ok="OK"
        else
            ini_ok="BAD($f)"
        fi
        break
    done
fi
say "FUZZEL_INI=$ini_ok"
# v2.2 (E98 — A LENTE DA GAVETA): o relato do dono ('menu de aplicativos
# em primeiro plano que não fecha') chegou SEM réu no papel — a gaveta é
# layer-shell com keyboard-exclusivo (nunca vira toplevel da dock; o ps da
# seção 3 do dump não a filtrava). A lente: quem está aberto AGORA, com
# pid E argv — a gaveta presa aparece aqui lavada no próximo dump, e o
# fuzzel órfão idem (o torch do veredito acende no papel, não no palpite).
say "DRAWER_OPEN=$(pgrep -ax nwg-drawer 2>/dev/null || true)"
say "FUZZEL_OPEN=$(pgrep -ax fuzzel 2>/dev/null || true)"
for f in /root/.cache/elite/menus.log /home/*/.cache/elite/menus.log; do
    [ -f "$f" ] || continue
    tail -8 "$f" 2>/dev/null | while IFS= read -r line; do
        say "MENUS| $line"
    done
done
for f in /root/.cache/elite/dock.log /home/*/.cache/elite/dock.log; do
    [ -f "$f" ] || continue
    tail -8 "$f" 2>/dev/null | while IFS= read -r line; do
        say "DOCK| $line"
    done
done

say "ELITE_PROBE_END"
exit 0
