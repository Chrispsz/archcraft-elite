#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-session-probe (v2.1.1) — evidência da SESSÃO GRÁFICA
# ═══════════════════════════════════════════════════════════════════════════
# POR QUÊ: o gate do CI (verify/QEMU) boota a ISO e para no LOGIN — nunca
# viu a sessão gráfica. As duas barras waybar morreram caladas no rig do
# dono por 3 releases seguidas (v1.6.2 → v1.7.0: "iniciou sem aparecer nada
# além do wallpaper") e o CI nunca pôde gritar, porque o sintoma nasce DEPOIS
# do ponto onde o gate olhava.
#
# CURA: este probe roda 60s após o graphical.target (ver
# elite-session-probe.service), colhe o ESTADO REAL da sessão (barras vivas,
# mortes registradas no bars.log, memória, versões) e imprime um bloco
# MARCADO no console — no QEMU do gate o console é o serial, que o gate
# grepa (ELITE_PROBE_BEGIN/END, WAYBAR_COUNT, DOCK_COUNT, BARS_EXITS). No
# stdout vai a mesma carga (→ journal do systemd, forense pós-mortem).
#
# v2.1.1 (run #93): a sessão v2.0 é waybar top + dock NATIVA (craft-dock-gui,
# GTK) — o probe só contava waybar e o gate cobrava "2 waybars" (contrato da
# era waybar-dock, defasado). Agora DOCK_COUNT entra no bloco; o comm do
# script Python é "python3" (shebang), então a contagem é por cmdline (-f).
#
# Inofensivo por construção: one-shot, sem escrita em disco, exit 0 SEMPRE
# (uma unidade failed aqui viraria falso negativo do gate "nenhuma unidade
# em failed" — o probe é observador, nunca parte do sistema).
# ═══════════════════════════════════════════════════════════════════════════

say() {
    printf '%s\n' "$1"
    # console (serial no QEMU do gate; tty texto no rig — invisível sob X/WL)
    if [ -w /dev/console ]; then
        printf '%s\n' "$1" >/dev/console 2>/dev/null
    fi
    return 0
}

# contador à prova de dupla impressão (pgrep -c imprime "0" E sai 1 — o
# `|| echo 0` clássico duplicaria a linha no command substitution)
count() {
    c="$(pgrep -c "$1" 2>/dev/null)"
    [ -n "$c" ] || c=0
    printf '%s' "$c"
}

wb_list="$(pgrep -a waybar 2>/dev/null | tr '\n' ';' | sed 's/;$//')"
wb_count="$(count waybar)"
sn_count="$(count swaync)"
# v2.10.8 — O IDLE NA PROVA (o dono: 'o PC não entra em idle' — o dump d33o
# não tinha réu nomeado): swayidle é o daemon do lock/DPMS/suspend e o
# craft-bars é o supervisor que o ressuscita (B1). Morto aqui = resposta.
idle_count="$(count swayidle)"
cb_count="$(count craft-bars)"
# v2.1.1: dock GTK contada por cmdline (comm = "python3" — pgrep -c puro
# nunca acharia). Padrão do count(): sem '|| echo 0' (duplicaria a linha).
# v2.10.6 — padrão ANCORADO: '-f craft-dock-gui' casava substring — um
# editor com o fonte aberto ('vim …/craft-dock-gui') contava como DOCK
# (o falso positivo da Rodada 2). A âncora pega só a dock de verdade.
dk_count="$(pgrep -fc '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' 2>/dev/null)"
[ -n "$dk_count" ] || dk_count=0
# v2.10.1: o daemon wlr-foreign-toplevel (a dock COMUTADORA) — vivo E
# FALANDO (a prova é o PING no socket da sessão, não só o processo)
# v2.10.6 — a contagem do toplevel virou -x (comm = 'craft-toplevel',
# binário C — o casamento exato é possível e é o honesto; '-f' somava
# editor com o fonte aberto).
tp_count="$(count craft-toplevel)"
tp_sock="DEAD"
for s in /run/user/*/elite/toplevel.sock; do
    [ -S "$s" ] || continue
    if PYTHONDONTWRITEBYTECODE=1 python3 - "$s" <<'PY' 2>/dev/null
import socket, sys
c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
c.settimeout(2)
c.connect(sys.argv[1])
c.sendall(b"PING\n")
assert c.recv(64).startswith(b"PONG")
PY
    then
        tp_sock="OK"
        break
    fi
done

# barras.log de TODOS os usuários (live=liveuser; instalado=dono do login)
restarts=0
exits=0
logf=""
for f in /root/.cache/elite/bars.log /home/*/.cache/elite/bars.log; do
    [ -f "$f" ] || continue
    r="$(grep -c 'FORA — reiniciando' "$f" 2>/dev/null)"
    [ -n "$r" ] || r=0
    e="$(grep -c 'SAIU exit=' "$f" 2>/dev/null)"
    [ -n "$e" ] || e=0
    restarts=$((restarts + r))
    exits=$((exits + e))
    logf="$f"
done

say "ELITE_PROBE_BEGIN"
say "WAYBAR_COUNT=$wb_count"
say "DOCK_COUNT=$dk_count"
say "TOPLEVEL_COUNT=$tp_count"
say "TOPLEVEL_SOCKET=$tp_sock"
say "SWAYNC_COUNT=$sn_count"
say "IDLE_COUNT=$idle_count"
say "CRAFTBARS_COUNT=$cb_count"
say "BARS_RESTARTS=$restarts"
say "BARS_EXITS=$exits"
say "WAYBAR_PROCS=$wb_list"
say "BARS_LOG=$logf"
if [ -n "$logf" ]; then
    tail -12 "$logf" 2>/dev/null | while IFS= read -r line; do
        say "BARS| $line"
    done
fi
mem="$(free -m 2>/dev/null | awk 'NR==2 {printf "%s/%sMB", $3, $2}')"
say "MEM=$mem"
say "WAYBAR_VER=$(waybar --version 2>/dev/null | head -1)"
say "LABWC_VER=$(labwc --version 2>/dev/null | head -1)"

# ── v2.3.1 — MENUS: a família craft-* (Sessão/Rede/Fixar/Idle/Logout) ────
# vive no fuzzel e morria CALADA (a denúncia do rig na v2.1.1: "os menus
# morreram e não funcionam" — o stderr ia pro /dev/null). Evidência que o
# probe consegue colher sem abrir janela nenhuma:
#   FUZZEL_BIN/FUZZEL_VER — binário presente e executável;
#   FUZZEL_INI           — o fuzzel.ini DO USUÁRIO parseado de verdade
#                          (configparser strict; seção principal+cores é
#                          contrato — config corrompida = todos os 5 menus
#                          mortos antes de desenhar);
#   MENUS|/DOCK|         — caudas dos logs de runtime (vazio = nada
#                          falhou; falha de menu agora É logada).
say "FUZZEL_BIN=$(command -v fuzzel 2>/dev/null || echo AUSENTE)"
say "FUZZEL_VER=$(fuzzel --version 2>/dev/null | head -1)"
ini_ok="skip"
if command -v python3 >/dev/null 2>&1; then
    for f in /root/.config/fuzzel/fuzzel.ini /home/*/.config/fuzzel/fuzzel.ini; do
        [ -f "$f" ] || continue
        if PYTHONDONTWRITEBYTECODE=1 python3 - "$f" <<'PY' 2>/dev/null
import configparser, sys
cp = configparser.ConfigParser(strict=True)
cp.read(sys.argv[1])
assert {'main', 'colors', 'border'} <= set(cp.sections())
PY
        then
            ini_ok="OK"
        else
            ini_ok="BAD($f)"
        fi
        break
    done
fi
say "FUZZEL_INI=$ini_ok"
for f in /root/.cache/elite/menus.log /home/*/.cache/elite/menus.log; do
    [ -f "$f" ] || continue
    tail -8 "$f" 2>/dev/null | while IFS= read -r line; do
        say "MENUS| $line"
    done
done
for f in /root/.cache/elite/dock.log /home/*/.cache/elite/dock.log; do
    [ -f "$f" ] || continue
    tail -8 "$f" 2>/dev/null | while IFS= read -r line; do
        say "DOCK| $line"
    done
done

say "ELITE_PROBE_END"
exit 0
