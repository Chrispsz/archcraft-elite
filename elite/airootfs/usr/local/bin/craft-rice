#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-rice — o rice da casa viaja NO PACOTE (E54)
# ═══════════════════════════════════════════════════════════════════════════
# POR QUÊ: as curas de COMPORTAMENTO viajam no elite-system (pacote único,
# E50), mas as REGRAS DE JANELA moravam só no rc.xml do usuário — e config
# de usuário NUNCA é tocada por update (a lei do domínio v3). O dono pagou
# a lacuna: "jogos abertos com proton não desenha o maximizar, minimizar e
# fechar" — o jogo Proton PEDE janela sem decoração e o labwc OBEDECE
# (decoração = server-side, o compositor desenha quando a janela aceita).
# A cura: fragmento de rice entregue como CÓDIGO (o padrão do craft-dock-gui:
# o conteúdo mora dentro do script que viaja no pacote único) num DROP-IN
# rc.xml.d — o labwc lê o diretório inteiro além do rc.xml e o arquivo do
# dono NUNCA é aberto.
#
# LEIS:
#  · ADITIVO — só escreve em ~/.config/labwc/rc.xml.d/; o rc.xml do dono é
#    intocável (o drop-in não substitui nada, some ao apagar).
#  · IDEMPOTENTE — conteúdo idêntico = zero escrita (o mtime não mente).
#  · O DONO MANDA — arquivo na casa SEM o marcador "entregue por
#    craft-rice" não é da casa: intocável (editou/renomeou, o respeito é
#    a mesma lei das configs de usuário).
#  · VIVO — com sessão labwc de pé, `labwc-msg reconfigure` aplica SEM
#    relogin (mesma escola do refresh E48/E49 — a cura que chega viva;
#    reconfigure é barato e não derruba janela nenhuma).
#
# FRAGMENTOS (a ordem lexical é a ordem de merge do labwc):
#  10-elite-games.xml — jogos Proton/Steam (steam_app_*) ganham a decoração
#    DE VOLTA: botões fechar/minimizar/maximizar da casa nas janelas que
#    pediram para ficar nuas. Fullscreen do jogo segue limpo (regra de
#    fullscreen não desenha titlebar — o labwc sabe).
#  20-elite-ssd.xml — A DECORAÇÃO É UMA SÓ (spec do dono 06/nov: "todas,
#    absolutamente todas as janelas seguem o mesmo padrão"): a família
#    Chromium/Brave e o imv DESENHAM a própria moldura (CSD) e deixam o
#    dono sem botões — aqui eles são FORÇADOS à decoração do tema (SSD).
#    E70 (print do dono 20:46): o xdg-decoration é NEGOCIADO — todo app
#    que PEDE CSD vence o default do compositor (libadwaita/LACT e
#    Electron/VS Code caíram fora da regra da família). A REGRA UNIVERSAL
#    (identifier=".*") fecha a classe: a moldura é propriedade do
#    COMPOSITOR para TODA janela que negocia — libadwaita, GTK3, Qt,
#    Electron, AppImage. App que PRECISA ficar nu sai com drop-in do dono
#    (serverDecoration="no" — o dono manda, não o app).
#  30-elite-organize.xml — A ÁREA SE ORGANIZA NO LANÇAMENTO (E70): os
#    dois apps de corpo inteiro (brave, Code) nascem MAXIMIZADOS — o
#    arranjo inicial não é pago pelo dedo (o snap W-Setas/W-m segue para
#    o resto). Revertível por desenho: apagar o drop-in devolve.
# ═══════════════════════════════════════════════════════════════════════════

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
uso() {
    printf '%s\n' \
        'uso: craft-rice — garante os drop-ins da casa em ~/.config/labwc/rc.xml.d/' \
        '     10-elite-games.xml (serverDecoration para jogos Proton/Steam) e' \
        '     20-elite-ssd.xml (a decoração ÚNICA — Chromium/Brave/imv forçados à' \
        '     moldura do tema, a spec do dono: "todas as janelas seguem o mesmo padrão")' \
        '' \
        '  aditivo e idempotente (o rc.xml do usuário NUNCA é tocado); arquivo sem' \
        '  o marcador da casa = intocável. O craft-bars chama no arranque; mudou' \
        '  algo = labwc-msg reconfigure na sessão viva.' \
        '' \
        '  E91 — a LOCK SKIN: o hyprlock.conf alcança homes VIVOS (fóssil da' \
        '  casa → renova; personalizado → intocável + papel honesto).' \
        '  craft-rice --lock-adopt = adota a pele atual NA FORÇA (backup .bak-<stamp>).' \
        '  craft-rice --lock-quiet  = a mesma gramática SEM papel (o craft-lock' \
        '  chama antes de CADA lock — E100: a dose da casa vale no próximo lock,' \
        '  não no próximo relogin; o lock não é lugar de log).'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

MARKER="entregue por craft-rice"
DIR="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/rc.xml.d"

# E100 — o modo calado: o craft-lock chama a renovação da pele ANTES de
# cada lock; o lock não é lugar de log (o papel da pele fica no arranque,
# no craft-dump — a foto da pele — e no --lock-adopt).
QUIET=0
say() {
    [ "$QUIET" -eq 1 ] && return 0
    printf '%s\n' "$1"
}
# o modo calado é lido NO TOPO: os fragmentos também saem calados (o lock
# não é lugar de log — o lock_skin herda o silêncio)
case "${1:-}" in
    --lock-quiet) QUIET=1; set -- "" ;;
esac

# ── fragmento 10-elite-games.xml (E54 — a decoração de volta nos jogos) ──
GAMES="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!-- Archcraft ELITE · fragmento de rice 10-jogos ($MARKER) -->
<!-- Jogos Proton/Steam (steam_app_*): o jogo pede janela SEM decoração e o
     labwc obedece — esta regra devolve os botões fechar/minimizar/maximizar
     da casa. Jogo em fullscreen segue limpo (titlebar não se desenha lá). -->
<labwc_config>
  <windowRules>
    <windowRule identifier=\"^steam_app_[0-9]+\$\" serverDecoration=\"yes\" />
  </windowRules>
</labwc_config>
"

# ── fragmento 20-elite-ssd.xml (06/nov spec do dono + E70 a REGRA UNIVERSAL) ──
SSD="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!-- Archcraft ELITE · fragmento de rice 20-ssd ($MARKER) -->
<!-- O relato do dono (E30): Brave e imv abriam SEM moldura/botões — a
     família Chromium desenha a própria janela (CSD) ou pede para ficar
     nua, e o labwc OBEDECE. O print do dono (E70, 20:46) provou a classe
     inteira: o xdg-decoration é NEGOCIADO — LACT (libadwaita) e VS Code
     (Electron) pediram CSD e venceram o default server do rc.xml. A
     regra UNIVERSAL fecha a classe: identifier=\".*\" força a decoração
     do tema em TODA janela que negocia (libadwaita, GTK3, Qt, Electron,
     AppImage) — a moldura é propriedade do COMPOSITOR, não do toolkit:
     o MESMO traffic light em TODAS as janelas, qualquer que seja o
     pacote ou desenho do programa. App que PRECISA ficar nu sai com um
     drop-in do dono (serverDecoration=\"no\" — o dono manda). -->
<labwc_config>
  <windowRules>
    <windowRule identifier=\"^(brave-browser|chromium|google-chrome|microsoft-edge|vivaldi-stable|thorium-browser|imv)\$\" serverDecoration=\"yes\" />
    <windowRule identifier=\".*\" serverDecoration=\"yes\" />
  </windowRules>
</labwc_config>
"


# ── fragmento 30-elite-organize.xml (E70 — a área se organiza no lançamento) ──
ORG="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!-- Archcraft ELITE · fragmento de rice 30-organize ($MARKER) -->
<!-- E70 — o print do dono: quatro janelas caçando posição à mão. Os dois
     apps de corpo inteiro nascem MAXIMIZADOS — o arranjo inicial não é
     pago pelo dedo. O snap da casa (W-Setas metades, W-m, A-F10/F11)
     segue para o resto. Revertível por desenho: apagar este arquivo
     devolve o comportamento (o drop-in some ao apagar). -->
<labwc_config>
  <windowRules>
    <windowRule identifier=\"^(brave-browser|Code)\$\" maximized=\"yes\" />
  </windowRules>
</labwc_config>
"

ensure_fragment() {
    # $1 = nome do arquivo, $2 = conteúdo — rc: 0 = ESCREVEU, 1 = idêntico
    # (zero escrita), 2 = não é da casa / falhou (intocável é a lei)
    f="$DIR/$1"
    if [ -f "$f" ] && ! grep -q "$MARKER" "$f" 2>/dev/null; then
        say "craft-rice: $1 não é da casa (sem marcador) — intocável"
        return 2
    fi
    if [ -f "$f" ] && [ "$(cat "$f" 2>/dev/null)" = "$(printf '%s' "$2")" ]; then
        return 1   # idêntico — zero escrita, zero reconfigure
    fi
    mkdir -p "$DIR" 2>/dev/null || return 2
    printf '%s\n' "$2" > "$f" 2>/dev/null || return 2
    say "craft-rice: fragmento $1 entregue ($DIR)"
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# E91 — A LOCK SKIN QUE ALCANÇA O HOME VIVO (o bloqueio que "não mudou")
# ═══════════════════════════════════════════════════════════════════════════
# A FERIDA (dump 231955, o dono: "o bloqueio de tela não mudou nada"): o
# hyprlock.conf v3 (E88) mora no SKEL da ISO — e home que JÁ EXISTE nunca o
# recebe (a lei do domínio v3: config de usuário não é tocada por update —
# correta, mas sem porta nenhuma o lock novo era uma promessa da ISO nova,
# nunca do canal). A GRAMÁTICA DO RICE RESOLVE sem quebrar a lei:
#   · conf AUSENTE            → entrega (home novo/primeiro uso);
#   · conf da CASA            → o marcador acima autoriza a renovação;
#   · conf FÓSSIL             → hash de versão antiga da casa conhecida
#                               (ninguém personalizou — é a nossa velha);
#   · conf PERSONALIZADO      → NÃO TOCA + papel honesto + a porta
#                               `craft-rice --lock-adopt` (backup e entrega).
# A pele-mestra viaja NO PACOTE (build.sh): /usr/local/share/elite/hyprlock/
# hyprlock.conf — mesma escola do fastfetch (E73). Chamo no arranque pelo
# craft-bars e — E100 — pelo craft-lock antes de CADA lock (--lock-quiet):
# o update entrega, o rice aplica no próximo arranque OU no próximo lock.
#
# ═══════════════════════════════════════════════════════════════════════
# E100 — A PELE IRMÃ DO GREETER (o sinal que escondeu o relógio por três
# eras: o eixo Y do hyprlock é PRA CIMA — valign=top com y>0 nasce ACIMA da
# tela; a suíte cobra a lei do sinal em 40-integration)
# ═══════════════════════════════════════════════════════════════════════

# ── AS TRÊS SKINS DA CASA (fontes mestras do pacote, destes nos homes) ──
LOCK_SRC="${ELITE_LOCK_SRC:-/usr/local/share/elite/hyprlock/hyprlock.conf}"
LOCK_DST="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
# fósseis do lock: v2.8.0 (6e9cf53) · v2.5.0 (5c6c3dd) · v2.3.0/v2.1.1
# (e96bec4) · v4 (E97, e53fbf2c) · v5 (E100, a37c7c13 — quem adotou a v5
# renova para a v6 PELO FÓSSIL, sem --lock-adopt). O git da casa é a fonte.
LOCK_FOSSILS="8db51ea1b3f1538ff8205da0acfee007ad09f45a312680f4c7584259ee7a254c 3b12babe69f16e40edd5dd1c8a4680e2b32d116821f7c3aad138d803a3ef5407 67e7a7da7ded2b55bbfe3b0090ce6801a902a8d89f410c9e8155ff435f095711 e53fbf2c5fa2779c0881141d8b0f9198e09b6dfbb1be8937da00c5a6e4669717 a37c7c13e6f51b0fe912ecccff2dcb0f5ab0a430eb144e80041fe751617ef9f9"

# E101 — AS SKINS DA CASA (a gramática E91 generalizada): o rc.xml e o
# swayosd/config.toml adotam a MESMA lei da lock skin. O rc.xml de rig vivo
# é domínio do dono — mas o skel da ISO é a nossa velha: a REDE DE FÓSSEIS
# (os shas dos blobs históricos do git, calculados em 11/nov sobre
# elite/airootfs/etc/skel/.config/labwc/rc.xml) distingue 'é a nossa velha'
# de 'o dono editou'. Fóssil = renova (o rig do dono recebe os binds E101
# do OSD SEM --rc-adopt); marcador = renova; outro conteúdo = PERSONALIZADO.
# Fósseis rc.xml: v2.3.0 (c2374d0) · v2.3.3 (ca551a0) · v2.3.6 (285c5a0) ·
# v2.7.0 (ca30384) · v2.8.0 (0d3966e) · v2.9.0 (4982e58) · v2.10.5 (fd4bfdb) ·
# v2.10.6 (c13e9b4) · E36 (e1c48ab) · E73 (b483f32) · E74 (5b9b0c6).
RC_SRC="${ELITE_RC_SRC:-/usr/local/share/elite/labwc/rc.xml}"
RC_DST="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/rc.xml"
RC_FOSSILS="6e587404c68ae1bd9cbfa3031e252c7c977c638508acc37a093e602de1c89027 e2da4dd412e27eb5a675a0e8017daf5bf5ad3353ac456ef416f937150d106868 ccab2c54730b0b6d826e0bd705ff097797b636b6c670de83f235544830676ce6 161346f2df37a7806ee3c00d2e772653d5ee05fe62f89fc30a249c517b4b8aa5 b738b6a0209b541bfc32dc73541d43ddf9205bad5430f96b4a0bce21fbc01ae0 3bf86bafa2bc961164b545669e065afef3515f89ce0067482a791d4c3804f5dc f1db32b41677107fe0ca3c18f32ba759746f0299316d06676f85aadf1b92f48c edda13fcddb603ce63722104597c2e046529fb89905d008bd24ba3508d03f8cf b631ad7586d7a5185193bf0ff7c326b88ebb778ac5bc8de7887338da4a388816 0838944e0a6a0adcfed9fd78f2bfac584753aebe18f43b4464643276fd7625b7 a1a972d5482926e88c0de2bcc27b7e14337f412147e84f0a6734309f53b47ac4"

OSD_SRC="${ELITE_OSD_SRC:-/usr/local/share/elite/swayosd/config.toml}"
OSD_DST="${XDG_CONFIG_HOME:-$HOME/.config}/swayosd/config.toml"

# ── a pele ÚNICA (uma gramática, três peles) ─────────────────────────────
# RETORNO: 0 = a pele MEXEU (o fluxo cobra reconfigure); 1 = nada mudou
# (idêntica, personalizada, mestre ausente ou cp falhou)
skin_ensure() {
    # POSIX puro (a lei do shellcheck 0 avisos — local é bashismo):
    # os cinco parâmetros moram em nomes únicos do próprio corpo
    _sk_src="$1" _sk_dst="$2" _sk_fossils="$3" _sk_modo="$4" _sk_nome="$5"
    [ -r "$_sk_src" ] || return 1   # elite-system antigo: silêncio honesto
    if [ "$_sk_modo" = "adopt" ]; then
        if [ -f "$_sk_dst" ]; then
            cp -p "$_sk_dst" "$_sk_dst.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null \
                && say "craft-rice: backup do seu $_sk_nome salvo ao lado ($_sk_dst.bak-*)"
        fi
        mkdir -p "${_sk_dst%/*}" 2>/dev/null
        cp -p "$_sk_src" "$_sk_dst" && say "craft-rice: $_sk_nome adotada (a pele nova vale no próximo uso)"
        return 0
    fi
    if [ -f "$_sk_dst" ]; then
        if grep -q "$MARKER" "$_sk_dst" 2>/dev/null; then
            cmp -s "$_sk_src" "$_sk_dst" && return 1
            cp -p "$_sk_src" "$_sk_dst" 2>/dev/null \
                && say "craft-rice: $_sk_nome renovada (a casa atualizou a própria pele)"
            return 0
        fi
        _sk_hash="$(sha256sum "$_sk_dst" 2>/dev/null | cut -d' ' -f1)"
        case " $_sk_fossils " in
            *" $_sk_hash "*)
                cmp -s "$_sk_src" "$_sk_dst" && return 1
                cp -p "$_sk_src" "$_sk_dst" 2>/dev/null \
                    && say "craft-rice: $_sk_nome fóssil renovada — a pele da casa chegou ao home vivo"
                return 0
                ;;
        esac
        say "craft-rice: $_sk_dst é PERSONALIZADO — intocável (a lei do domínio v3)"
        say "             a pele da casa existe: craft-rice --skin-adopt (backup + entrega)"
        return 1
    fi
    mkdir -p "${_sk_dst%/*}" 2>/dev/null
    cp -p "$_sk_src" "$_sk_dst" 2>/dev/null \
        && say "craft-rice: $_sk_nome entregue (primeiro uso)" && return 0
    return 1
}

lock_skin() {
    skin_ensure "$LOCK_SRC" "$LOCK_DST" "$LOCK_FOSSILS" "${1:-none}" "lock skin"
}
rc_skin() {
    skin_ensure "$RC_SRC" "$RC_DST" "$RC_FOSSILS" "${1:-none}" "rc.xml"
}
osd_skin() {
    skin_ensure "$OSD_SRC" "$OSD_DST" "" "${1:-none}" "config do OSD"
}

# ── o despacho (as portas de adoção explícita) ──────────────────────────
case "${1:-}" in
    --lock-adopt) lock_skin "adopt"; exit 0 ;;
    --rc-adopt)   rc_skin "adopt"; exit 0 ;;
    --skin-adopt) # TODAS as skins da casa de uma vez (backup em cada)
                  lock_skin "adopt"; rc_skin "adopt"; osd_skin "adopt"
                  exit 0 ;;
esac

# ── o fluxo padrão: os três fragmentos + as TRÊS skins da casa ──────────
CHANGED=0
ensure_fragment "10-elite-games.xml" "$GAMES" && CHANGED=1
ensure_fragment "20-elite-ssd.xml" "$SSD" && CHANGED=1
ensure_fragment "30-elite-organize.xml" "$ORG" && CHANGED=1
rc_skin   && CHANGED=1   # rc.xml renovado = binds/leis novas valem no reconfigure
osd_skin   && CHANGED=2  # config do OSD renovado: o server RE-LÊ no nascimento
                         # (o pkill abaixo ressuscita com a pele nova)
lock_skin  || true       # a lock skin NÃO mexe no CHANGED (o hyprlock lê no
                         # próximo lock — o craft-lock chama ANTES de cada
                         # lock, E100; a lei E91/E100: a dose vale no PRÓXIMO
                         # LOCK, sem reconfigure)

if [ "$CHANGED" -ge 1 ]; then
    if command -v labwc-msg >/dev/null 2>&1 \
            && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        labwc-msg reconfigure 2>/dev/null \
            && say "craft-rice: reconfigure aplicado (as regras valem na sessão viva)"
    fi
    if [ "$CHANGED" -eq 2 ] && cmp -s "$OSD_SRC" "$OSD_DST" 2>/dev/null; then
        pgrep -x swayosd-server >/dev/null 2>&1 \
            && pkill -x swayosd-server 2>/dev/null || true
    fi
fi

exit 0
