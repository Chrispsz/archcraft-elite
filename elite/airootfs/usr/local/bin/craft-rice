QTC_DST="${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf"
QTC_FOSSILS="ccb2683f56523a9c088a441feac762f1d7c922bcab8bfb2f5dfe797dae1f1026"


# ── a pele ÚNICA (uma gramática, seis peles — E115 soma a topbar) ──────
# RETORNO: 0 = a pele MEXEU (o fluxo cobra reconfigure); 1 = nada mudou
# (idêntica, personalizada, mestre ausente ou cp falhou)
skin_ensure() {
    # POSIX puro (a lei do shellcheck 0 avisos — local é bashismo):
    # os cinco parâmetros moram em nomes únicos do próprio corpo
    _sk_src="$1" _sk_dst="$2" _sk_fossils="$3" _sk_modo="$4" _sk_nome="$5"
    [ -r "$_sk_src" ] || return 1   # elite-system antigo: silêncio honesto
    if [ "$_sk_modo" = "adopt" ]; then
        if [ -f "$_sk_dst" ]; then
            # E120: o backup do dono é a REDE do adopt — sem rede a adoção é
            # RECUSADA (gravar por cima sem backup era a perda de dados do
            # dono esperando o disco cheio; o erro engolido não é lei aqui)
            if ! cp -p "$_sk_dst" "$_sk_dst.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null; then
                say "craft-rice: FALHA no backup do seu $_sk_nome — adoção RECUSADA (o arquivo seu segue intocado)"
                return 1
            fi
            say "craft-rice: backup do seu $_sk_nome salvo ao lado ($_sk_dst.bak-*)"
        fi
        mkdir -p "${_sk_dst%/*}" 2>/dev/null
        if cp -p "$_sk_src" "$_sk_dst" 2>/dev/null; then
            say "craft-rice: $_sk_nome adotada (a pele nova vale no próximo uso)"
            return 0
        fi
        say "craft-rice: FALHA ao gravar a $_sk_nome adotada (o cp recusou) — o arquivo seu segue no lugar"
        return 1
    fi
    if [ -f "$_sk_dst" ]; then
        if grep -q "$MARKER" "$_sk_dst" 2>/dev/null; then
            cmp -s "$_sk_src" "$_sk_dst" && return 1
            cp -p "$_sk_dst" "$_sk_dst.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null
            if cp -p "$_sk_src" "$_sk_dst" 2>/dev/null; then
                say "craft-rice: $_sk_nome renovada (a casa atualizou a própria pele)"
                return 0
            fi
            say "craft-rice: FALHA ao renovar a $_sk_nome (o cp recusou) — a pele viva segue no lugar"
            return 1
        fi
        _sk_hash="$(sha256sum "$_sk_dst" 2>/dev/null | cut -d' ' -f1)"
        case " $_sk_fossils " in
            *" $_sk_hash "*)
                cmp -s "$_sk_src" "$_sk_dst" && return 1
                cp -p "$_sk_dst" "$_sk_dst.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null
                if cp -p "$_sk_src" "$_sk_dst" 2>/dev/null; then
                    say "craft-rice: $_sk_nome fóssil renovada — a pele da casa chegou ao home vivo"
                    return 0
                fi
                say "craft-rice: FALHA ao renovar a $_sk_nome fóssil (o cp recusou) — a pele viva segue no lugar"
                return 1
                ;;
        esac
        say "craft-rice: $_sk_dst é PERSONALIZADO — intocável (a lei do domínio v3)"
        say "             a pele da casa existe: craft-rice --skin-adopt (backup + entrega)"
        return 1
    fi
    mkdir -p "${_sk_dst%/*}" 2>/dev/null
    cp -p "$_sk_src" "$_sk_dst" 2>/dev/null \
        && say "craft-rice: $_sk_nome entregue (primeiro uso)" && return 0
    return 1
}

lock_skin() {
    skin_ensure "$LOCK_SRC" "$LOCK_DST" "$LOCK_FOSSILS" "${1:-none}" "lock skin"
}
rc_skin() {
    # E107 — o gate de XML antes da entrega (pele doente não viaja ao home)
    if [ -r "$RC_SRC" ] && ! xml_ok "$RC_SRC"; then
        say "craft-rice: a pele nova do rc.xml NÃO é XML válido (comentário com dois hífens? a suíte E107 é o juiz) — renovação RECUSADA, a pele viva segue no lugar"
        return 1
    fi
    skin_ensure "$RC_SRC" "$RC_DST" "$RC_FOSSILS" "${1:-none}" "rc.xml"
}
osd_skin() {
    # E126 — DOIS arquivos, UMA pele: o config.toml (comportamento) e o
    # style.css (a cara do popup — a casa agora TEM cara própria para o
    # OSD: escada AMOLED + mauve, a cura do GtkGizto min-width do
    # bars.log no mesmo gesto). O veredito é o OU dos dois: qualquer um
    # que MEXEU pede o restart do swayosd-server do fim do fluxo.
    _osd_rc=1
    skin_ensure "$OSD_SRC" "$OSD_DST" "" "${1:-none}" "config do OSD" && _osd_rc=0
    skin_ensure "$OSDCSS_SRC" "$OSDCSS_DST" "" "${1:-none}" "CSS do OSD" && _osd_rc=0
    return "$_osd_rc"
}
menu_skin() {
    # E107 — o gate de XML antes da entrega (o menu de fábrica de 3 itens
    # do labwc é o preço de uma pele que não parseia: o rig perde TODAS as
    # portas do botão direito de uma vez)
    if [ -r "$MENU_SRC" ] && ! xml_ok "$MENU_SRC"; then
        say "craft-rice: a pele nova do menu.xml NÃO é XML válido (comentário com dois hífens? a suíte E107 é o juiz) — renovação RECUSADA, a pele viva segue no lugar"
        return 1
    fi
    skin_ensure "$MENU_SRC" "$MENU_DST" "$MENU_FOSSILS" "${1:-none}" "menu.xml"
}
wtop_skin() {
    skin_ensure "$WTOP_SRC" "$WTOP_DST" "$WTOP_FOSSILS" "${1:-none}" "config da topbar"
}
wsty_skin() {
    skin_ensure "$WSTY_SRC" "$WSTY_DST" "$WSTY_FOSSILS" "${1:-none}" "CSS da topbar"
}
theo_skin() {
    # E130 — o tema do labwc no home vivo (o destaque mauve vale na sessão)
    skin_ensure "$THEO_SRC" "$THEO_DST" "$THEO_FOSSILS" "${1:-none}" "themerc-override"
}
gtk_skin() {
    # E130 — DOIS arquivos, UMA pele (os settings da casa): o veredito é o
    # OU dos dois. Os apps GTK leem no próximo NASCIMENTO — sem reconfigure.
    _g_rc=1
    skin_ensure "$GTK3_SRC" "$GTK3_DST" "$GTK3_FOSSILS" "${1:-none}" "settings GTK3" && _g_rc=0
    skin_ensure "$GTK4_SRC" "$GTK4_DST" "$GTK4_FOSSILS" "${1:-none}" "settings GTK4" && _g_rc=0
    return "$_g_rc"
}
qtc_skin() {
    # E130 — o tema Qt na dança das irmãs (renova por marcador/fóssil)
    skin_ensure "$QTC_SRC" "$QTC_DST" "$QTC_FOSSILS" "${1:-none}" "qt6ct.conf"
}

# ── o despacho (as portas de adoção explícita) ──────────────────────────
case "${1:-}" in
    --lock-adopt) lock_skin "adopt"; exit 0 ;;
    --rc-adopt)   rc_skin "adopt"; exit 0 ;;
    --menu-adopt) menu_skin "adopt"; exit 0 ;;
    --topbar-adopt) wtop_skin "adopt"; wsty_skin "adopt"; exit 0 ;;
    --skin-adopt) # TODAS as skins da casa de uma vez (backup em cada)
                  lock_skin "adopt"; rc_skin "adopt"; osd_skin "adopt"; menu_skin "adopt"
                  wtop_skin "adopt"; wsty_skin "adopt"
                  theo_skin "adopt"; gtk_skin "adopt"; qtc_skin "adopt"
                  exit 0 ;;
esac

# ── o fluxo padrão: a LEI DE REMOÇÃO + AS PELES da casa ────────────────
CHANGED=0
rice_sweep
[ "$REMOVED" -eq 1 ] && CHANGED=1  # fóssil do rc.xml.d removido = reconfigure cobra
rc_skin   && CHANGED=1   # rc.xml renovado = binds/REGRAS novas valem no reconfigure
                         # (E123: as regras de janela moram NO rc.xml mestre)
menu_skin && CHANGED=1   # menu.xml renovado = o reconfigure re-lê o menu — o
                         # menu novo aparece na sessão VIVA (sem relogin)
_wt=0; _ws=0
wtop_skin && _wt=1       # config da topbar renovada = o waybar RE-LÊ no
                         # NASCIMENTO (o kill abaixo; no boot o rice corre
                         # ANTES da barra — sem kill nenhum)
wsty_skin && _ws=1       # CSS da topbar — reload_style_on_change re-lê o
                         # estilo vivo; o kill cobre os DOIS por garantia
theo_skin  && CHANGED=1  # E130 — themerc-override renovado = o reconfigure
                         # re-lê o TEMA (o destaque mauve vale na sessão viva)
gtk_skin   || true       # E130 — settings GTK valem no PRÓXIMO app GTK (sem
                         # reconfigure; o Papirus-Dark chega sem relogin)
qtc_skin   || true       # E130 — qt6ct.conf vale no próximo app Qt (a dança
                         # das irmãs; personalizado segue intocável)
osd_skin   && CHANGED=2  # config do OSD renovado: o server RE-LÊ no nascimento
                         # (o pkill abaixo ressuscita com a pele nova)
lock_skin  || true       # a lock skin NÃO mexe no CHANGED (o hyprlock lê no
                         # próximo lock — o craft-lock chama ANTES de cada
                         # lock, E100; a lei E91/E100: a dose vale no PRÓXIMO
                         # LOCK, sem reconfigure)

if [ "$_wt" = 1 ] || [ "$_ws" = 1 ]; then
    # E115 — a topbar lê config no NASCIMENTO (não há reconfigure para
    # waybar): o waybar vivo morre e o supervisor da casa o respawna
    # em ≤5s com a pele nova (a mesma física do OSD — o pkill aqui).
    # Âncora ^: só o waybar DE VERDADE (um editor com o conf aberto
    # nunca morre por isso — a lição E43/E106 da família).
    if pgrep -f '^waybar -c ' >/dev/null 2>&1; then
        pkill -f '^waybar -c ' 2>/dev/null || true
        say "craft-rice: waybar reiniciando com a pele nova (o supervisor respawna em ≤5s)"
    fi
fi

if [ "$CHANGED" -ge 1 ]; then
    if command -v labwc-msg >/dev/null 2>&1; then
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            # E125 — O RECONFIGURE COM REDE (a corrida do arranque): no
            # boot o rice corre NO autostart — o labwc ainda está
            # assentando e o IPC pode não responder no 1º tiro. O dump
            # 161746 fotografou o crime inteiro: o menu.xml renovou às
            # 16:15:15 e a linha do reconfigure NUNCA chegou ao papel —
            # o labwc tinha lido o menu VELHO no próprio arranque e
            # serviu a pele antiga o dia inteiro (o dono: 'os botões de
            # captura continuam separados' — o submenu que a casa
            # entregou nunca apareceu; a dose 1.0-72 estava no disco e
            # INVISÍVEL na sessão). Até 6 tentativas, 0.5s entre elas: a
            # 1ª que responde encerra; o veredito honesto sai nos dois
            # desfechos (o papel nunca chama de aplicado o que não
            # respondeu — a lição E33 na escala da pele).
            _rice_ok=0
            _rice_try=1
            while [ "$_rice_try" -le 6 ]; do
                if labwc-msg reconfigure >/dev/null 2>&1; then
                    _rice_ok=1
                    break
                fi
                sleep 0.5
                _rice_try=$((_rice_try + 1))
            done
            if [ "$_rice_ok" = 1 ]; then
                say "craft-rice: reconfigure aplicado (tentativa $_rice_try — as peles valem na sessão viva)"
            else
                say "craft-rice: labwc-msg SEM resposta nas 6 tentativas — as peles valem no próximo reconfigure/arranque (o réu fica nomeado no papel)"
            fi
        else
            say "craft-rice: peles mudaram mas WAYLAND_DISPLAY está vazio neste env (sem sessão gráfica alcançável) — valem no próximo arranque/reconfigure"
        fi
    else
        say "craft-rice: peles mudaram mas labwc-msg não existe — valem no próximo arranque"
    fi
    if [ "$CHANGED" -eq 2 ] && cmp -s "$OSD_SRC" "$OSD_DST" 2>/dev/null; then
        pgrep -x swayosd-server >/dev/null 2>&1 \
            && pkill -x swayosd-server 2>/dev/null || true
    fi
fi

exit 0
