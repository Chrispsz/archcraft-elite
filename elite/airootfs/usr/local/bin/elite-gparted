#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# elite-gparted — O GPARTED QUE VESTE A SESSÃO (E95 → E137 → E138)
# ───────────────────────────────────────────────────────────────────────────
# POR QUÊ: o pkexec entrega ao root um ambiente LIMPO por lei. Sem
# DISPLAY/XAUTHORITY válidos, a GDK do gparted-root morre com "cannot
# open display" ANTES de mapear janela — o clique MURO do dump 201219
# (20:11:54 e 20:11:57, duas tentativas, zero janela, zero aviso). O
# XWayland exige um COOKIE do usuário: sem XAUTHORITY o root não tem
# credencial nenhuma, mesmo com DISPLAY correto (e o XAUTHORITY="" vazio
# da versão anterior era lido como caminho inexistente — pior que nada).
#
# A CURA (4 camadas, nesta ordem):
#   1. DESCOBRIR o display XWayland ativo (env, senão o socket vivo em
#      /tmp/.X11-unix/X*) e o XAUTHORITY do usuário (env, senão
#      ~/.Xauthority, senão os candidatos do $XDG_RUNTIME_DIR, senão um
#      cookie temporário via xauth em /run/user/$UID — tmpfs da sessão,
#      nunca em disco);
#   2. O CINTO xhost +SI:localuser:root — o servidor X aceita o root
#      LOCAL sem cookie (ServerInterpreted: sem rede, sem wildcard)
#      quando o xhost existe na máquina — E138: o cinto é REVOGADO ao
#      encerrar (a concessão vive só enquanto o gparted vive; a ordem do
#      dono, dump v2.13);
#   3. `pkexec env DISPLAY=… XAUTHORITY=… … /usr/bin/gpartedbin` — o
#      BINÁRIO REAL direto: o wrapper /usr/bin/gparted só decide
#      ELEVAÇÃO e, já root, executaria gpartedbin do mesmo jeito (o
#      alvo NUNCA é um .desktop e o guard abaixo recusa se resolver
#      para ESTE bin — não há loop recursivo possível);
#   4. O RC DE ACORDO COM O PRÓPRIO pkexec (E138, dump v2.13: o rc=127
#      das 22:35:32 era o polkit recusando a senha — a mensagem antiga
#      mentia "binário não encontrado"; 127 = autorização não obtida,
#      126 = diálogo fechado — man pkexec é a fonte).
#
# FEEDBACK (a ordem do dono: "nunca deixando o clique mudo"): só erro
# REAL gera notify-send — senha recusada, diálogo fechado, display
# morto, binário ausente. Sucesso é silêncio + a janela aberta na sessão.
#
# uso:      elite-gparted [ARQUIVO] — a senha é pedida UMA vez (polkit)
# bin:      /usr/local/bin/elite-gparted (chamado pelo gparted.desktop
#           da casa — dock, gaveta e fuzzel lançam todos por aqui)
# seam:     ELITE_PKEXEC_BIN (default pkexec), ELITE_GPARTED_BIN (alvo
#           explícito da suíte), ELITE_X11_UNIX_DIR (default
#           /tmp/.X11-unix — o diretório de sockets do teste) e
#           ELITE_NOTIFY_BIN (default notify-send) — as portas de prova
#           que julgam a VESTIMENTA sem polkit nem gparted instalados.
# ═══════════════════════════════════════════════════════════════════════════
set -eu

uso() {
    printf '%s\n' \
        'uso: elite-gparted [ARQUIVO] — abre o GParted como root na sessão' \
        '     viva (Wayland e XWayland): display e cookie X descobertos na' \
        '     HORA, o root nasce vestido com o fio do usuário.' \
        '' \
        '  a senha é pedida UMA vez pelo agente polkit da sessão;' \
        '  falha real gera notificação — o clique nunca é mudo.'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

# ── o alvo: o BINÁRIO REAL primeiro (gpartedbin), o wrapper como queda ─────
GPARTED_BIN="${ELITE_GPARTED_BIN:-}"
if [ -z "$GPARTED_BIN" ]; then
    for cand in /usr/bin/gpartedbin /usr/bin/gparted /usr/local/bin/gparted; do
        [ -x "$cand" ] && GPARTED_BIN="$cand" && break
    done
fi
case "$GPARTED_BIN" in
    */elite-gparted|elite-gparted)
        printf 'elite-gparted: o alvo resolveu para este próprio bin — loop recusado\n' >&2
        exit 1 ;;
esac
if [ -z "$GPARTED_BIN" ] || [ ! -x "$GPARTED_BIN" ]; then
    printf 'elite-gparted: o binário do gparted não existe — instale-o (pacman -S gparted)\n' >&2
    exit 1
fi

PKEXEC_BIN="${ELITE_PKEXEC_BIN:-pkexec}"
if ! command -v "$PKEXEC_BIN" >/dev/null 2>&1; then
    printf 'elite-gparted: o %s não existe — sem ele não há root vestido\n' "$PKEXEC_BIN" >&2
    exit 1
fi

# ── O DISPLAY: o env da sessão vence; senão o socket VIVO do XWayland ─────
# (o socket precisa existir AGORA — número gravado no /tmp não é prova)
DISP="${DISPLAY:-}"
if [ -z "$DISP" ]; then
    X11DIR="${ELITE_X11_UNIX_DIR:-/tmp/.X11-unix}"
    if [ -d "$X11DIR" ]; then
        for s in "$X11DIR"/X*; do
            [ -S "$s" ] || continue
            n="${s##*/}"; n="${n#X}"
            case "$n" in ''|*[!0-9]*) continue ;; esac
            DISP=":$n"
            break
        done
    fi
fi

# ── O XAUTHORITY: a credencial do USUÁRIO que o root vai vestir ───────────
XA="${XAUTHORITY:-}"
if [ -z "$XA" ] && [ -n "$DISP" ]; then
    RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 0)}"
    for cand in "$HOME/.Xauthority" "$RT/.Xauthority"; do
        [ -f "$cand" ] && { XA="$cand"; break; }
    done
    if [ -z "$XA" ]; then
        for cand in "$RT"/.Xauthority-*; do
            [ -f "$cand" ] && { XA="$cand"; break; }
        done
    fi
    # último recurso: UM cookie extraído para o display vivo — tmpfs da
    # sessão (/run/user/$UID), nunca em disco; o servidor pode recusar a
    # geração (best-effort calado — o cinto xhost vem logo abaixo)
    if [ -z "$XA" ] && command -v xauth >/dev/null 2>&1; then
        mkdir -p "$RT/elite" 2>/dev/null || true
        ck="$RT/elite/gparted.xauth"
        if xauth -f "$ck" generate "$DISP" . trusted >/dev/null 2>&1 && [ -s "$ck" ]; then
            XA="$ck"
        else
            rm -f "$ck" 2>/dev/null || true
        fi
    fi
fi

# ── O CINTO xhost: o root LOCAL entra no X sem cookie (no-op honesto sem
# X11 ou sem o xhost instalado — o fio principal segue sendo o WAYLAND).
# E138 — O CINTO É FECHADO AO SAIR (a ordem do dono, dump v2.13: "revogue
# xhost -SI:localuser:root ao encerrar"): a concessão vive APENAS durante
# a execução do gparted — o trap cobre o caminho inteiro (sucesso, erro
# real E o próprio encerramento do wrapper).
_xhost_deu=0
if [ -n "$DISP" ] && command -v xhost >/dev/null 2>&1; then
    DISPLAY="$DISP" xhost +SI:localuser:root >/dev/null 2>&1 || true
    _xhost_deu=1
fi
revoke_xhost() {
    [ "$_xhost_deu" -eq 1 ] || return 0
    DISPLAY="$DISP" xhost -SI:localuser:root >/dev/null 2>&1 || true
    _xhost_deu=0
}
trap revoke_xhost EXIT HUP INT TERM

# ── A VESTIMENTA: cada variável viaja EXPLÍCITA (o pkexec entrega um
# ambiente LIMPO — o que não é nomeado não atravessa) e só entra na lista
# o valor NÃO-VAZIO (string vazia no env é ruído que a GDK lê como
# caminho inexistente — o réu do XAUTHORITY="" fotografado no dump).
# A MONTAGEM é por PREPEND em ordem reversa: $@ nasce como os argumentos
# do USUÁRIO (%f do .desktop) e cada peça entra NA FRENTE — no fim,
# $@ = env DISPLAY=… … alvo args… (um só set -- por peça, sem perder os
# argumentos originais em variável nenhuma).
set -- "$GPARTED_BIN" "$@"
[ -n "$XA" ]                   && set -- "XAUTHORITY=$XA" "$@"
[ -n "${XDG_SESSION_TYPE:-}" ] && set -- "XDG_SESSION_TYPE=$XDG_SESSION_TYPE" "$@"
[ -n "${XDG_RUNTIME_DIR:-}" ]  && set -- "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" "$@"
[ -n "${WAYLAND_DISPLAY:-}" ]  && set -- "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "$@"
[ -n "$DISP" ]                 && set -- "DISPLAY=$DISP" "$@"
set -- env "$@"

# ── a chamada: ESPERA o rc — o clique nunca é mudo (feedback só no erro).
# O stderr do root cai num mktemp do usuário (o root escreve, o dono lê).
# E138 — O RC DE ACORDO COM O PRÓPRIO pkexec (man pkexec: 127 = "não
# autorizado OU a autorização não pôde ser obtida por autenticação OU
# ocorreu um erro"; 126 = "o usuário FECHOU o diálogo"). O dump v2.13
# provou na carne: às 22:35:32 o polkit-agent-helper falhou a conversa
# PAM (senha recusada/agente não completou) e o pkexec devolveu 127 —
# a mensagem da E137 dizia "binário não encontrado no PATH do root",
# mentindo para o dono com o gparted INSTALADO. A verdade agora nomeia
# cada rc pelo seu dono.
errf="$(mktemp "${TMPDIR:-/tmp}/elite-gparted.XXXXXX" 2>/dev/null)" || errf=/dev/null
rc=0
"$PKEXEC_BIN" "$@" 2>"$errf" || rc=$?
if [ "$rc" -ne 0 ]; then
    motivo="terminou com erro (rc=$rc)"
    [ "$rc" -eq 126 ] && motivo="a senha foi cancelada (o diálogo foi fechado)"
    [ "$rc" -eq 127 ] && motivo="a senha foi recusada ou a autorização foi negada — tente de novo"
    det=""
    [ -s "$errf" ] && det="$(tail -c 200 "$errf" 2>/dev/null | tr '\n' ' ')"
    NOT="${ELITE_NOTIFY_BIN:-notify-send}"
    if command -v "$NOT" >/dev/null 2>&1; then
        "$NOT" -u normal -t 6000 'GParted' \
            "Não abriu: $motivo${det:+ · último erro: $det}" >/dev/null 2>&1 || true
    fi
    # o papel da família (uma linha por erro REAL — nunca spam por tick)
    BL="${XDG_CACHE_HOME:-$HOME/.cache}/elite/bars.log"
    ( mkdir -p "${BL%/*}" 2>/dev/null
      printf '[%s] elite-gparted: FALHOU rc=%s · display=%s · xauth=%s\n' \
          "$(date '+%F %T')" "$rc" "${DISP:-nenhum}" "${XA:-nenhum}" >>"$BL" ) 2>/dev/null || true
fi
[ "$errf" = /dev/null ] || rm -f "$errf" 2>/dev/null || true
revoke_xhost
trap - EXIT HUP INT TERM
exit "$rc"
