#!/usr/bin/env python3
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-audio — A CENTRAL RÁPIDA DE ÁUDIO E MICROFONE (E138)
# ═══════════════════════════════════════════════════════════════════════════
# A ORDEM DO DONO (dump v2.13, PROMPT 4): "Integre no craft-menu (acessível
# pelo indicador de volume da barra) um seletor instantâneo de dispositivos
# de Saída (Sinks) e Entrada/Microfone (Sources) com controle de volume e
# mudo rápido, mantendo um botão direto para abrir o mixer completo
# (pavucontrol) caso o usuário queira roteamento ou ajustes avançados."
#
# O DESENHO (a camada operacional rápida da diretriz arquitetural — a
# troca do dia-a-dia NÃO pode abrir mixer pesado nem terminal):
#   · indicador de volume da topbar → ESTA central (craft-menu/fuzzel —
#     a mesma tela das centrais de rede/sessão: abre sob o botão);
#   · SAÍDAS e ENTRADAS listadas ao vivo (pactl -f json — o PipeWire é
#     a fonte única; ícone ● marca o dispositivo padrão, % e mudo à
#     mostra: a decisão do clique é informada ANTES do clique);
#   · a troca é UM gesto (set-default) + o volume/mudo do dispositivo
#     ESCOLHIDO mora no submenu dele (toques em sequência: +5% por
#     clique, SEM reabrir nada — o loop devolve à lista do dispositivo);
#   · o MIXER COMPLETO é um item (pavucontrol — roteamento por app,
#     ajustes avançados; o dono que usa o pwvucontrol continua livre:
#     o pacote dele segue instalado onde está).
#   · O ROTEADOR AUTOMÁTICO segue vivo (craft-audio-route por evento —
#     fone no jack muda a PORTA, sink BT novo vira default: a central é
#     para ESCOLHA manual; o roteador nunca briga com ela).
#
# A GRAMÁTICA DOS FECHAMENTOS é a do craft-menu (ESC 1 · toggle 2 ·
# cross-dismiss 143 — benignos: saem sem drama). Papel: ~/.cache/elite/
# menus.log (a mesma trilha das centrais da casa). Uso:
#   craft-audio            abre na visão de SAÍDAS
#   craft-audio --input    abre na visão de ENTRADAS/MICROFONES
# ═══════════════════════════════════════════════════════════════════════════
import json
import os
import subprocess
import sys

LOGDIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "elite")
MLOG = os.path.join(LOGDIR, "menus.log")
AT = "network"  # o slot da topbar direita — onde o indicador de volume mora


def mlog(msg):
    try:
        os.makedirs(LOGDIR, exist_ok=True)
        if os.path.exists(MLOG) and os.path.getsize(MLOG) > 262144:
            open(MLOG, "w").close()
        stamp = subprocess.run(
            ["date", "+%F %T"], capture_output=True, text=True
        ).stdout.strip()
        with open(MLOG, "a") as f:
            f.write("[%s] %s\n" % (stamp, msg))
    except OSError:
        pass


def note(titulo, corpo):
    try:
        subprocess.run(
            ["notify-send", "-t", "3000", titulo, corpo],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def menu(titulo, itens):
    """craft-menu com itens por stdin → (escolha, rc). rc benigno = None."""
    try:
        r = subprocess.run(
            ["craft-menu", "--title=" + titulo, "--at=" + AT],
            input="\n".join(itens) + "\n",
            capture_output=True, text=True)
    except FileNotFoundError:
        note("Áudio", "craft-menu ausente — a central não abre")
        return None, None
    if r.returncode not in (0,):
        return None, None  # 1/2/143: ESC/toggle/cross-dismiss — benigno
    escolha = r.stdout.strip()
    return (escolha or None), 0


def pactl_json(que):
    """pactl -f json list sinks|sources → lista (o PipeWire é a fonte)."""
    try:
        r = subprocess.run(
            ["pactl", "-f", "json", "list", que],
            capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            return []
        return json.loads(r.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def default_de(que):
    """o padrão vivo (get-default-sink|source) — o ● da lista."""
    try:
        r = subprocess.run(
            ["pactl", "get-default-" + que],
            capture_output=True, text=True, timeout=5)
        return r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def pct_do(dispositivo):
    """o volume percentual do canal frontal (arredondado)."""
    vol = dispositivo.get("volume") or {}
    canal = vol.get("front-left") or vol.get("front-right") or {}
    return int(round(float(canal.get("value_percent", 0) or 0)))


def lista_dispositivos(que):
    """[(nome, descrição, pct, mudo, é_default)] ao vivo — sem state velho."""
    padrao = default_de(que)
    fora = []
    for d in pactl_json(que):
        nome = d.get("name", "")
        desc = (d.get("description") or nome)[:44]
        if not nome:
            continue
        fora.append((nome, desc, pct_do(d), bool(d.get("mute")),
                     nome == padrao))
    return fora


def verbo(que, nome, desc):
    """os verbos do DISPOSITIVO escolhido — o loop instantâneo."""
    rotulo = "saída" if que == "sinks" else "entrada"
    while True:
        itens = ["Usar esta %s" % rotulo,
                 "Volume +5%",
                 "Volume −5%",
                 "Mudo (alternar)",
                 "Voltar"]
        escolha, rc = menu(desc, itens)
        if escolha is None:
            return
        if escolha == "Voltar":
            return
        if escolha.startswith("Usar"):
            if set_default(que, nome):
                mlog("Áudio: %s padrão → '%s'" % (rotulo, desc))
                note("Áudio", "%s: %s" % (
                    "Saída" if que == "sinks" else "Entrada", desc))
            return  # trocado: o trabalho da central está feito
        elif escolha == "Volume +5%":
            pactl("set-%s-volume" % ("sink" if que == "sinks" else "source"),
                  nome, "+5%")
        elif escolha == "Volume −5%":
            pactl("set-%s-volume" % ("sink" if que == "sinks" else "source"),
                  nome, "-5%")
        elif escolha == "Mudo (alternar)":
            pactl("set-%s-mute" % ("sink" if que == "sinks" else "source"),
                  nome, "toggle")


def pactl(*args):
    try:
        subprocess.run(["pactl"] + list(args),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def set_default(que, nome):
    """troca o padrão (sink|source) — UM gesto, sem state próprio."""
    alvo = "sink" if que == "sinks" else "source"
    try:
        r = subprocess.run(
            ["pactl", "set-default-" + alvo, nome],
            capture_output=True, text=True, timeout=5)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def central(que):
    """a visão de sinks ou sources — a lista ao vivo, o ● na frente."""
    rotulo = "Saídas de som" if que == "sinks" else "Entradas e microfones"
    while True:
        dispositivos = lista_dispositivos(que)
        if not dispositivos:
            note("Áudio", "Nenhum dispositivo de %s vivo (PipeWire acordou?)"
                 % ("saída" if que == "sinks" else "entrada"))
            return
        itens = []
        for _nome, desc, pct, mudo, eh_padrao in dispositivos:
            marca = "● " if eh_padrao else "  "
            estado = " · mudo" if mudo else ""
            itens.append("%s%s · %d%%%s" % (marca, desc, pct, estado))
        itens += ["Mixer completo", "Voltar"]
        escolha, rc = menu(rotulo, itens)
        if escolha is None:
            return
        if escolha == "Voltar":
            return
        if escolha == "Mixer completo":
            mixer()
            return
        # o item escolhido casa pela ORDEM (a descrição pode estar
        # truncada em tela — o índice é a verdade, não o texto)
        idx = None
        base = [i for i in itens if not i.startswith("Mixer")
                and i != "Voltar"]
        for i, linha in enumerate(base):
            if linha == escolha:
                idx = i
                break
        if idx is None or idx >= len(dispositivos):
            return
        nome, desc, _pct, _mudo, _padrao = dispositivos[idx]
        verbo(que, nome, desc)


def mixer():
    """o botão direto do mixer completo (a ordem do dono: pavucontrol)."""
    mlog("Áudio: abrindo o mixer completo (pavucontrol)")
    try:
        subprocess.Popen(["pavucontrol"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except FileNotFoundError:
        note("Áudio", "pavucontrol ausente — instale (pacman -S pavucontrol)")


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    que = "sources" if "--input" in sys.argv[1:] else "sinks"
    mlog("Áudio: abrindo central (%s)" % (
        "saídas" if que == "sinks" else "entradas"))
    # a raiz pergunta o CAMINHO (a ordem do dono: saídas E microfones na
    # mesma central — o atalho do indicador de microfone pula direto)
    itens = ["Saídas de som",
             "Entradas e microfones",
             "Mixer completo"]
    escolha, rc = menu("Áudio", itens)
    if escolha is None:
        return 0
    if escolha == "Saídas de som":
        central("sinks")
    elif escolha == "Entradas e microfones":
        central("sources")
    elif escolha == "Mixer completo":
        mixer()
    return 0


if __name__ == "__main__":
    sys.exit(main())
