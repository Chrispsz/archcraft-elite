#!/usr/bin/env bash
# elite-clean (o motor da era craft-clean 2.0) — limpeza do sistema (v6 — E133, as DUAS FASES do fechamento)
# ═══════════════════════════════════════════════════════════════════════
# v1: cache do pacman, órfãos e journal.
# v2 (E88): UM relatório honesto — tamanhos antes/depois, lixeira, flatpak.
# v3 (E107): os caches de usuário (octopi/yay/thumbnails) medidos no papel.
# v4 (E114): o modo root honesto (pkexec COM o HOME do dono) + o cache do
#            Brave (o maior do disco) com o navegador fechado.
# v5 (E115/E118): o trace sobrevive à morte no meio, a porta se nomeia,
#            a morte deixa testemunho (trap), o botão não empilha (flock).
# v6 (E133 — o fechamento do dono): a limpeza vira DUAS FASES CLARAS com o
#            TOTAL LIBERADO no fim:
#   FASE 1 — 100% segura e automática (sem risco, sem pergunta):
#     · journal: vacuum de 7 dias E teto de 100M (--vacuum-time=7d
#       --vacuum-size=100M);
#     · paccache -rk2 (2 versões por pacote — o rollback seguro) e
#       paccache -ruk0 (o cache de pacotes JÁ DESINSTALADOS sai inteiro);
#     · o trio redundante da casa (E132: polkit-gnome/blueman/
#       network-manager-applet — -Rns recusa dependentes);
#     · links simbólicos QUEBRADOS em ~/.local/share/applications e
#       ~/.config (find -xtype l — contados no papel, removidos);
#     · coredumps velhos (systemd-coredump >7 dias) e órfãos de /var/tmp
#       (>7 dias — o mesmo critério do tmpfiles do systemd, apertado);
#     · os caches regeneráveis de usuário (octopi/yay) e o cache do Brave
#       SÓ com o navegador fechado (só Cache/Code Cache/GPUCache);
#     · a lixeira do desktop.
#     REGRA INVIOLÁVEL: NUNCA tocar em pastas pessoais (~/Documentos,
#     ~/Downloads, ~/Imagens, ~/Vídeos, ~/Projetos, ~/Música), em PERFIL
#     de navegador (senhas/histórico/extensões — só os caches
#     regeneráveis do Cache/*) nem em configurações viva de ~/.config
#     (a varredura de symlinks SÓ apaga o link quebrado, nunca o alvo).
#   FASE 2 — avançada e INTERATIVA, cada pergunta [s/N] com padrão NÃO:
#     1. órfãos/mortos (pacman -Qtdq) listados → remover? [s/N]
#     2. runtimes Flatpak não utilizados → remover? [s/N]
#     3. miniaturas (~/.cache/thumbnails) e caches de shaders
#        (Mesa/Vulkan/NVIDIA — recriados sozinhos no uso) → limpar? [s/N]
#   PORTAS:
#     · --auto-safe: SÓ a fase 1, sem PERGUNTA nenhuma (a porta da
#       automação e dos testes — o mesmo desenho honesto do --yes);
#     · --yes: fase 1 + fase 2 SEM pergunta (a porta velha, preservada
#       para scripts que já a chamam);
#     · menu: terminal de pé — as perguntas [s/N] funcionam no terminal.
#     · --as-root USUÁRIO HOME (E134): a porta do pkexec DIRETO — o
#       alvo raiz do pkexec nasce com ambiente limpo, então o menu
#       entrega o dono como ARGUMENTO (nada de `pkexec env HOME=…`,
#       cujo lookup é /usr/bin/env e fica FORA da regra 50-elite-wheel
#       — o réu dos transient polkit-agent-helper FAILED do dump
#       1.0-80). Válido só como root: valida o usuário no passwd, o
#       home existe, e o $HOME da corrida inteira vira o DELE (a
#       lixeira e os caches de usuário certos).
# ═══════════════════════════════════════════════════════════════════════
set -euo pipefail

# E134 — A PORTA DO PKEXEC DIRETO (--as-root USUÁRIO HOME): o pkexec
# entrega ambiente LIMPO por lei — o HOME raiz seria /root e a lixeira
# limpa seria a do root. O menu passa o DONO como argumento e a validação
# é cinto triplo: só root, usuário presente no passwd, home existente.
# Válida: $HOME (e $USER) da corrida inteira viram os DO dono — antes
# do CLEAN_LOG e de qualquer uso de caminho de usuário.
_asroot=0
_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --as-root)
      [ $# -ge 3 ] || { echo "elite-clean: --as-root exige USUÁRIO e HOME (a porta do pkexec do menu)" >&2; exit 2; }
      _asroot=1
      _ar_user="$2"
      _ar_home="$3"
      shift 3
      ;;
    *) _args+=("$1"); shift ;;
  esac
done
set -- ${_args[@]+"${_args[@]}"}
if [ "$_asroot" = 1 ]; then
    if [ "$(id -u)" != 0 ]; then
        echo "elite-clean: --as-root é porta de RAIZ (o pkexec do menu é quem chama)" >&2
        exit 2
    fi
    if ! _ar_uid="$(id -u "$_ar_user" 2>/dev/null)"; then
        echo "elite-clean: usuário '$_ar_user' não existe (o --as-root recusa)" >&2
        exit 2
    fi
    if [ ! -d "$_ar_home" ]; then
        echo "elite-clean: HOME '$_ar_home' não existe (o --as-root recusa)" >&2
        exit 2
    fi
    export HOME="$_ar_home" USER="$_ar_user"
fi
unset _asroot _args _ar_user _ar_home _ar_uid

# E109 — O PAPEL DA LIMPEZA (teto 256 KiB — a lei da família E36).
CLEAN_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/clean.log"
clog() {
    mkdir -p "${CLEAN_LOG%/*}" 2>/dev/null || true
    if [ -f "$CLEAN_LOG" ] && [ "$(wc -c <"$CLEAN_LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$CLEAN_LOG" > "$CLEAN_LOG.tmp" 2>/dev/null && mv -f "$CLEAN_LOG.tmp" "$CLEAN_LOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$CLEAN_LOG" 2>/dev/null || true
    return 0
}

ASSUME_YES=0
AUTO_SAFE=0
MENU_HOLD=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    --auto-safe) AUTO_SAFE=1 ;;
    menu) MENU_HOLD=1 ;;
    -h|--help) printf 'uso: elite-clean [--as-root USUÁRIO HOME] [--yes|--auto-safe|menu] — a limpeza em DUAS FASES (E133)\n\n'; sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "elite-clean: arg desconhecido: $arg (use --yes, --auto-safe ou menu)" >&2; exit 2 ;;
  esac
done

_modo="interativo"
[ "$ASSUME_YES" = 1 ] && _modo="--yes"
[ "$ASSUME_YES" != 1 ] && [ "$AUTO_SAFE" = 1 ] && _modo="--auto-safe"
[ "$ASSUME_YES" != 1 ] && [ "$AUTO_SAFE" != 1 ] && [ "$MENU_HOLD" = 1 ] && _modo="menu"
clog "═══ elite-clean iniciado (TTY: $([ -t 0 ] && echo sim || echo não) · modo: $_modo · uid: $(id -u) · HOME: ${HOME:-?})"

# E118 — a testemunha da porta + a morte deixa testemunho + o flock.
_ppid="$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')"
[ -n "$_ppid" ] && _pai="$(tr '\0' ' ' </proc/"$_ppid"/cmdline 2>/dev/null | cut -c1-100)" || _pai='(pai já saiu)'
clog "porta: ppid=$_ppid pai: ${_pai:-?}"
_sem_fim=1
trap 'if [ "${_sem_fim:-0}" = 1 ]; then clog "MORTE no meio (rc=$? — set -e, kill ou janela fechada): o último passo antes da morte é o último passo logado acima"; fi' EXIT
if exec 9>>"${CLEAN_LOG%/*}/clean.lock" 2>/dev/null && command -v flock >/dev/null 2>&1; then
  if ! flock -n 9; then
    _sem_fim=0
    clog "saiu: já há uma limpeza a correr — este clique não empilha (a corrida viva é a dona do papel)"
    echo "  (já há uma limpeza a correr — esta janela sai; a corrida viva segue no comando dela)"
    exit 0
  fi
fi

PKG_CACHE="/var/cache/pacman/pkg"
cache_mib() {
  # E118 — a medida não mata: du que falha devolve 0 (o papel segue).
  local m=''
  if [[ -d "$PKG_CACHE" ]]; then
    m="$(du -sm "$PKG_CACHE" 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '%s\n' "${m:-0}"
}
antes="$(cache_mib)"
step() { printf '\n==> %s\n' "$*"; }
skipped() { printf '   (pulado: %s — sudo indisponível/sem TTY; nada quebrou)\n' "$*" >&2; }

srun() {
  # sudo que NÃO mata o script: sem root/TTY o passo é pulado com aviso
  if (( EUID == 0 )); then "$@"; return 0; fi
  if command -v sudo >/dev/null 2>&1 && [[ -t 0 || ${ASSUME_YES} -eq 1 ]]; then
    sudo "$@"
  else
    return 127
  fi
}

# E133 — O CONTADOR ÚNICO DO TOTAL (a fonte de cada número é o passo dele;
# o fim soma e fala MiB E GB — o dono pediu 'em MB/GB').
TOTAL_MIB=0
add_mib() { # $1 = MiB medidos → soma no total e imprime quando > 0
  local m="${1:-0}"
  [[ "$m" =~ ^[0-9]+$ ]] || m=0
  TOTAL_MIB=$((TOTAL_MIB + m))
  [ "$m" -gt 0 ] && printf '     −%s MiB\n' "$m"
  return 0
}
dir_mib() { # $1 = diretório → tamanho em MiB (0 se ausente/ilegível)
  local m=''
  [ -d "$1" ] && m="$(du -sm "$1" 2>/dev/null | awk '{print $1}' || true)"
  printf '%s\n' "${m:-0}"
}
hum_gb() { # $1 = MiB → texto humano (MiB e GB)
  local m="$1"
  if [ "$m" -ge 1024 ]; then
    printf '%s MiB (≈ %s GB)' "$m" "$(awk -v m="$m" 'BEGIN{printf "%.1f", m/1024}')"
  else
    printf '%s MiB' "$m"
  fi
}

# ═══════════════════════════════════════════════════════════════════════
# FASE 1 — LIMPEZA AUTOMÁTICA 100% SEGURA (sem pergunta, sem risco)
# ═══════════════════════════════════════════════════════════════════════
fase1() {
step "fase 1 · cache: mantendo 2 versões (paccache -rk2) e limpando desinstalados (-ruk0)"
# E133 — o -ruk0 do dono: pacotes JÁ DESINSTALADOS não guardam versão
# nenhuma no cache (o -ruk1 velha mantinha 1 — rollback de desinstalado
# não existe, é lixo que nunca volta sozinho).
clog "passo: paccache iniciado (cache grande pode levar até 1 min)"
echo "   (o paccache lê o cache inteiro — cache grande leva até 1 min)"
if srun paccache -rk2 2>/dev/null; then
  clog "paccache -rk2: OK"
else
  _prc=$?
  clog "paccache -rk2: PULADO (rc=$_prc — pacman-contrib ausente? sudo recusado? 'sudo pacman -S pacman-contrib' cura à mão)"
  skipped "paccache (instale pacman-contrib)"
fi
srun paccache -ruk0 2>/dev/null && clog "paccache -ruk0: OK (desinstalados saem)" || clog "paccache -ruk0: pulado"

step "fase 1 · journal: retendo 7 dias, teto de 100M"
# E133 — o vacuum duplo do dono (tempo E tamanho): o journal não passa
# de 100M nem de 7 dias — o -vacuum do v4 mantinha 2 semanas e nenhum teto.
clog "passo: journalctl --vacuum-time=7d --vacuum-size=100M"
_jb="$(dir_mib /var/log/journal)"
if srun journalctl --vacuum-time=7d --vacuum-size=100M >/dev/null 2>&1; then
  _ja="$(dir_mib /var/log/journal)"
  _jd=$((_jb - _ja)); [ "$_jd" -lt 0 ] && _jd=0
  echo "  journal: ${_jb} MiB → ${_ja} MiB"
  clog "journal: ${_jb}→${_ja} MiB (liberado ${_jd} MiB)"
  add_mib "$_jd"
else
  skipped "journalctl --vacuum (sudo indisponível?)"
  clog "journal: PULADO (sudo indisponível)"
fi

step "fase 1 · redundantes (E132 — applets com substituto na casa)"
for pkg in polkit-gnome blueman network-manager-applet; do
  if pacman -Q "$pkg" >/dev/null 2>&1; then
    if srun pacman -Rns --noconfirm "$pkg"; then
      clog "redundante $pkg: removido (substituto da casa no lugar)"
    else
      skipped "remoção do $pkg (dependentes?)"
    fi
  fi
done

step "fase 1 · links quebrados em applications e config"
# E133 — o find -xtype l: o link cujo ALVO morreu (aplicativo desinstalado
# que deixou lançador órfão, cache que sumiu). A regra inviolável vale:
# SÓ o link quebrado sai — o alvo já não existe, nada pessoal é tocado.
_ln=0
while IFS= read -r -d '' _l; do
  rm -f -- "$_l" 2>/dev/null || true
  _ln=$((_ln + 1))
done < <(find "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
               "${XDG_CONFIG_HOME:-$HOME/.config}" -xtype l -print0 2>/dev/null || true)
if [ "$_ln" -gt 0 ]; then
  echo "  $_ln link(s) quebrado(s) removido(s) (alvos mortos — lançadores órfãos)"
  clog "links quebrados: $_ln removidos"
else
  echo "  nenhum link quebrado (limpo)"
  clog "links quebrados: nenhum"
fi

step "fase 1 · coredumps velhos (>7 dias)"
_cd="$(dir_mib /var/lib/systemd/coredump)"
if [ "$_cd" -gt 0 ] && [ "$_cd" != "0" ]; then
  _cdlist="$(find /var/lib/systemd/coredump -type f -mtime +7 -print 2>/dev/null | head -50 || true)"
  if [ -n "$_cdlist" ]; then
    _cdc="$(printf '%s\n' "$_cdlist" | wc -l | tr -d ' ')"
    srun find /var/lib/systemd/coredump -type f -mtime +7 -delete 2>/dev/null \
      && { echo "  $_cdc coredump(s) velho(s) apagado(s)"; clog "coredump: $_cdc apagados"; }
  else
    echo "  nenhum coredump com mais de 7 dias"
    clog "coredump: nenhum >7d"
  fi
else
  echo "  sem /var/lib/systemd/coredump (ou vazio)"
  clog "coredump: ausente"
fi

step "fase 1 · órfãos de /var/tmp (>7 dias)"
# E133 — o mesmo critério do tmpfiles do systemd para /var/tmp (30d),
# apertado para 7d pela ordem do dono: o que 7 dias ninguém abriu é órfão.
# -mindepth 1 -maxdepth 1: o próprio /var/tmp nunca sai.
_vt="$(find /var/tmp -mindepth 1 -maxdepth 1 -mtime +7 2>/dev/null | head -50 || true)"
if [ -n "$_vt" ]; then
  _vtm="$(printf '%s\n' "$_vt" | while IFS= read -r _p; do du -sm "$_p" 2>/dev/null | awk '{print $1}'; done | awk '{s+=$1} END{print s+0}')"
  srun find /var/tmp -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null \
    && { echo "  $(printf '%s\n' "$_vt" | wc -l | tr -d ' ') órfão(s) de /var/tmp apagado(s) ($_vtm MiB)"; clog "/var/tmp: apagados (${_vtm} MiB)"; add_mib "$_vtm"; }
else
  echo "  nenhum órfão de /var/tmp (tudo com menos de 7 dias)"
  clog "/var/tmp: nenhum >7d"
fi

step "fase 1 · octopi: cache do gerenciador"
if [ -d "$HOME/.cache/octopi" ]; then
  mib="$(du -sm "$HOME/.cache/octopi" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/octopi"/* 2>/dev/null || true
  echo "  $mib MiB varridos (ícones/imports antigos — reconstroem no uso)"
  add_mib "$mib"
else
  echo "  (sem cache do octopi — nada a fazer)"
fi

step "fase 1 · yay: cache de build do AUR"
if [ -d "$HOME/.cache/yay" ]; then
  mib="$(du -sm "$HOME/.cache/yay" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/yay"/* 2>/dev/null || true
  echo "  $mib MiB varridos (fontes/pkgbuilds de builds passados — o próximo -S baixa de novo)"
  add_mib "$mib"
else
  echo "  (sem cache do yay — nada a fazer)"
fi

# E114 — O PRÊMIO (o cache do Brave): SÓ com o navegador fechado e SÓ os
# regeneráveis — senhas, histórico e extensões moram em OUTROS arquivos do
# perfil: nada deles sai (a regra inviolável do fechamento por extenso).
step "fase 1 · Brave: cache do navegador (o maior prêmio do disco)"
clog "passo: cache do Brave iniciado (checa navegador vivo antes de tocar)"
if pgrep -x brave >/dev/null 2>&1; then
  echo "  (Brave está ABERTO — pulado: feche o navegador e rode a limpeza de novo)"
  clog "Brave cache: PULADO (o navegador está vivo)"
elif [ -d "$HOME/.cache/BraveSoftware" ]; then
  mib="$(du -sm "$HOME/.cache/BraveSoftware" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/BraveSoftware"/Brave-Browser/*/Cache \
            "$HOME/.cache/BraveSoftware"/Brave-Browser/*/Code*Cache \
            "$HOME/.cache/BraveSoftware"/Brave-Browser/*/GPUCache 2>/dev/null || true
  echo "  $mib MiB avaliados (Cache/Code Cache/GPUCache varridos — o perfil intacto; reconstroem no uso)"
  add_mib "$mib"
  clog "Brave cache: varrido (${mib} MiB avaliados — só os caches regeneráveis)"
else
  echo "  (sem cache do Brave — nada a fazer)"
  clog "Brave cache: ausente"
fi

step "fase 1 · lixeira do desktop"
# E114 — o modo pkexec é root com o HOME do dono: a lixeira certa.
if [ "$(id -u)" = "0" ] && [ -n "${HOME:-}" ] && [ -d "$HOME/.local/share/Trash" ]; then
  rm -rf -- "$HOME/.local/share/Trash/files" "$HOME/.local/share/Trash/info" 2>/dev/null || true
  echo "  lixeira esvaziada (modo pkexec: a lixeira do dono)"
elif command -v gio >/dev/null 2>&1; then
  gio trash --empty 2>/dev/null && echo "  lixeira esvaziada" || echo "  lixeira já vazia (ou sem acesso — nada quebrou)"
else
  echo "  (gio ausente — pulado)"
fi

# E139 — OS PAPÉIS DA CASA NASCEM PODADOS (a rotação da casa): o frame 0
# do autostart e a DOSE (elite-post-upgrade) podam cada ~/.cache/elite/
# *.log para os últimos 256 KiB — a Limpeza fecha o trio com o MESMO
# gesto na mão do dono (uptimes longos sem relogin eram o buraco entre
# os dois). A régua é a E36: evidência recente vale mais que história.
step "fase 1 · papéis da Elite (logs podados para os últimos 256 KiB)"
_podados=0
for _l in "${XDG_CACHE_HOME:-$HOME/.cache}/elite/"*.log; do
  [ -f "$_l" ] || continue
  if [ "$(wc -c <"$_l" 2>/dev/null || echo 0)" -gt 262144 ]; then
    if tail -c 131072 "$_l" > "$_l.poda" 2>/dev/null && mv -f "$_l.poda" "$_l" 2>/dev/null; then
      _podados=$((_podados + 1))
    else
      rm -f "$_l.poda" 2>/dev/null || true
    fi
  fi
done
if [ "$_podados" -gt 0 ]; then
  echo "  $_podados papel(is) da Elite podado(s) (bars/display/dock/… — os últimos 256 KiB ficam)"
  clog "papéis: $_podados podado(s) para 256 KiB (a régua E36 na mão do dono — E139)"
else
  echo "  (nenhum papel da Elite passou do teto — a rotação do boot/dose segura)"
fi
unset _podados _l
}

# ═══════════════════════════════════════════════════════════════════════
# FASE 2 — LIMPEZA AVANÇADA INTERATIVA (cada pergunta [s/N], padrão NÃO)
# ═══════════════════════════════════════════════════════════════════════
fase2() {
step "fase 2 · órfãos e pacotes mortos (pacman -Qtdq)"
orphans="$(pacman -Qtdq 2>/dev/null || true)"
if [[ -n "$orphans" ]]; then
  echo "$orphans" | sed 's/^/  /'
  clog "órfãos achados: $(echo "$orphans" | tr '\n' ' ')"
  if (( ASSUME_YES == 1 )); then
    srun pacman -Rns --noconfirm $orphans || skipped "remoção dos órfãos"
    clog "órfãos: removidos (--yes)"
  else
    # E133 — a pergunta do fechamento, palavra por palavra, padrão NÃO.
    # v2.10.6 preservada: o EOF não mata calado (read com fallback).
    read -r -p "Remover pacotes órfãos/mortos listados acima? [s/N] " ans || ans=''
    if [[ "${ans,,}" == "s" ]]; then
      srun pacman -Rns --noconfirm $orphans || skipped "remoção dos órfãos"
      clog "órfãos: removidos (escolha do dono no TTY)"
    else
      echo "  (órfãos mantidos — padrão NÃO; escolha do usuário no papel)"
      clog "órfãos: mantidos (escolha do usuário)"
    fi
  fi
else
  echo "  nenhum órfão (o sistema já está limpo desta praga)"
  clog "órfãos: nenhum"
fi

step "fase 2 · runtimes Flatpak não utilizados"
if command -v flatpak >/dev/null 2>&1; then
  if (( ASSUME_YES == 1 )); then
    flatpak uninstall --unused -y 2>/dev/null || echo "  (nada a remover ou sem sessão — pulado)"
  else
    # E133 — o flatpak LISTA o que vai no próprio comando; a casa pergunta
    # ANTES (padrão NÃO) e o -y só desce com o sim do dono.
    read -r -p "Remover runtimes Flatpak não utilizados? [s/N] " ans || ans=''
    if [[ "${ans,,}" == "s" ]]; then
      flatpak uninstall --unused -y 2>/dev/null || echo "  (nada a remover ou sem sessão — pulado)"
      clog "flatpak --unused: corrido (escolha do dono)"
    else
      echo "  (runtimes mantidos — padrão NÃO)"
      clog "flatpak --unused: mantidos (escolha do usuário)"
    fi
  fi
else
  echo "  (flatpak ausente — pulado)"
fi

step "fase 2 · miniaturas e caches de shaders (recriados automaticamente)"
# E133 — os caches de SHADER da casa: Mesa (~/.cache/mesa_shader_cache e
# mesa_shader_cache_db — RADV/anv), Vulkan (~/.cache/vulkan_shader_cache)
# e NVIDIA (~/.cache/nvidia/GLCache — DXVK/OGL). Todos reconstroem sozinhos
# no primeiro uso — o jogo compila de novo o que precisa.
_thumb="$(dir_mib "$HOME/.cache/thumbnails")"
_shm=0
for _d in "$HOME/.cache/mesa_shader_cache" "$HOME/.cache/mesa_shader_cache_db" \
          "$HOME/.cache/vulkan_shader_cache" "$HOME/.cache/nvidia/GLCache"; do
  _m="$(dir_mib "$_d")"
  _shm=$((_shm + _m))
done
echo "  miniaturas: ${_thumb} MiB · shaders (Mesa/Vulkan/NVIDIA): ${_shm} MiB"
clog "fase 2 caches: miniaturas ${_thumb} MiB · shaders ${_shm} MiB"
if (( ASSUME_YES == 1 )); then
  _ans=s
else
  read -r -p "Limpar caches de miniaturas e shaders (recriados automaticamente)? [s/N] " _ans || _ans=''
fi
if [[ "${_ans,,}" == "s" ]]; then
  _freed=0
  for _d in "$HOME/.cache/thumbnails" "$HOME/.cache/mesa_shader_cache" \
            "$HOME/.cache/mesa_shader_cache_db" "$HOME/.cache/vulkan_shader_cache" \
            "$HOME/.cache/nvidia/GLCache"; do
    if [ -d "$_d" ]; then
      _m="$(du -sm "$_d" 2>/dev/null | awk '{print $1}')"; _m="${_m:-0}"
      rm -rf -- "${_d:?}/"* 2>/dev/null || true
      _freed=$((_freed + _m))
    fi
  done
  echo "  $_freed MiB varridos (miniaturas + shaders — recriam no primeiro uso)"
  add_mib "$_freed"
  clog "miniaturas+shaders: ${_freed} MiB varridos (escolha do dono)"
else
  echo "  (caches mantidos — padrão NÃO)"
  clog "miniaturas+shaders: mantidos (escolha do usuário)"
fi
}

# ── o corpo: fase 1 SEMPRE; fase 2 só quem pediu ────────────────────────
fase1
if [ "$AUTO_SAFE" = 1 ]; then
  echo
  echo "  --auto-safe: fase 2 (órfãos/flatpak/shaders) NÃO corre — a porta da automação não pergunta"
  clog "--auto-safe: fase 2 pulada (sem prompts por desenho)"
else
  if [[ -t 0 && -t 1 ]] || (( ASSUME_YES == 1 )); then
    fase2
  else
    echo
    echo "  (sem TTY de pergunta: a fase 2 interativa fica para a próxima corrida com terminal — nada foi perguntado, nada foi removido)"
    clog "fase 2: PULADA (sem TTY — as perguntas [s/N] exigem terminal; use --yes ou --auto-safe)"
  fi
fi

depois="$(cache_mib)"
liberado=$(( antes - depois ))
(( liberado < 0 )) && liberado=0
TOTAL_MIB=$(( TOTAL_MIB + liberado ))
_sem_fim=0
clog "fim: cache do pacman ${antes}→${depois} MiB · TOTAL LIBERADO: ${TOTAL_MIB} MiB"
echo
printf '✔ limpo. cache do pacman: %s MiB → %s MiB (liberado: %s MiB)\n' "$antes" "$depois" "$liberado"
printf '✔ TOTAL LIBERADO (todas as fases): %s\n' "$(hum_gb "$TOTAL_MIB")"
printf '   (a fonte de cada número está no passo dele acima e no papel ~/.cache/elite/clean.log)\n'
# E136 — A VERIFICAÇÃO DE FALHAS (a PARTE 2/2 do dono): a limpeza termina
# olhando o PULSO do sistema — units FAILED são o sintoma que sobra
# depois de qualquer transação grande (o veredito no terminal E no papel;
# o juiz é o systemctl, a limpeza não apaga o que não é dela — só APONTA).
_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | sed '/^[[:space:]]*$/d' || true)"
if [ -n "$_failed" ]; then
  printf '⚠ units FAILED (%s linha(s)) — olho neles:\n' "$(printf '%s\n' "$_failed" | wc -l)"
  printf '%s\n' "$_failed" | sed 's/^/  /'
  clog "saúde: units FAILED no fim da limpeza: $(printf '%s' "$_failed" | tr '\n' ';')"
else
  printf '✔ saúde: 0 units failed (systemctl --failed limpo)\n'
fi
# E96/E110 — o relatório não some: o modo menu pausa INCONDICIONAL.
if (( MENU_HOLD == 1 )); then
  read -r -p 'Enter para fechar' _ || true
elif (( ASSUME_YES == 0 )) && [[ -t 0 ]] && [[ -t 1 ]]; then
  read -r -p 'Enter para fechar' _ || true
fi
