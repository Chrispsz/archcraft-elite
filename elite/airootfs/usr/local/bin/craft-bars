#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-bars (v1.6.3) — supervisor das duas barras waybar
# ═══════════════════════════════════════════════════════════════════════════
# POR QUÊ (burn test da v1.6.2, out/2026): o dono bootou e a sessão subiu
# SÓ com o wallpaper — as duas instâncias do waybar morreram caladas, sem
# deixar stderr em lugar nenhum (o labwc não redireciona o autostart e o
# gate de boot do CI para no LOGIN — nunca abre a sessão gráfica para ver).
#
# CURA EM 2 FRENTES:
#   1. SUPERVISÃO — barra que morrer volta em ≤5s (loop com sleep; o sh
#      dormindo custa ~1 MB e ~0% CPU — o seguro da UI que o dono exige
#      "completamente estável");
#   2. FORENSE — o stderr do waybar vai para ~/.cache/elite/bars.log
#      (teto de 1 MiB — sem crescimento ilimitado, diretriz v1.6.2).
#      Se morrer de novo, o log tem a mensagem EXATA do waybar — fim do
#      "iniciou sem aparecer nada" sem explicação.
#
# NOTA: o "FORA — reiniciando" no início do log é o arranque normal
# (nenhuma barra existe ainda no primeiro loop); restarts em série com
# mensagem do waybar entre eles = problema real, agora com evidência.
# ═══════════════════════════════════════════════════════════════════════════
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/elite"
mkdir -p "$LOG_DIR" 2>/dev/null
LOG="$LOG_DIR/bars.log"

# Teto de 1 MiB (bytes): estourou, zera — evidência recente vale mais.
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    : >"$LOG"
fi

ensure() {
    # $1=nome  $2=config  $3=css
    if ! pgrep -f "waybar -c $2" >/dev/null 2>&1; then
        printf '[%s] waybar %s FORA — reiniciando\n' "$(date '+%F %T')" "$1" >>"$LOG"
        # v1.7.1 — EXIT CODE COMO EVIDÊNCIA: a v1.6.3 capturava o stderr,
        # mas morte LIMPA (exit 0) ou sinal não escrevem stderr nenhum —
        # "morreu calada" continuava possível. Agora TODA saída do waybar
        # deixa linha com hora e exit code (0 = morte limpa; ≠0 = crash;
        # 137 = OOM killer — o gate do CI grepa BARS_EXITS no probe).
        (
            waybar -c "$2" -s "$3" >>"$LOG" 2>&1
            st=$?
            printf '[%s] waybar %s SAIU exit=%d\n' "$(date '+%F %T')" "$1" "$st" >>"$LOG"
        ) &
    fi
}

# v1.9 — spec M3.5 do dono: a dock segue o MODO da sessão (PADRÃO de
# fábrica = peek/autohide, tira de 6px; o craft-dock-config devolve o
# config vigente — peek gerado em tmpfs a partir do config ATUAL do
# usuário, com os pins do craft-pin inclusive). O craft-dock-autohide
# alterna (W-S-d / clique na tira) matando a instância — este loop
# religa no modo novo em ≤5s.
while :; do
    ensure top  "$HOME/.config/waybar/config.top"  "$HOME/.config/waybar/style.top.css"
    ensure dock "$(/usr/local/bin/craft-dock-config)" "$HOME/.config/waybar/style.dock.css"
    sleep 5
done
