#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-bars — supervisor da barra waybar (top) + dock GTK
# ═══════════════════════════════════════════════════════════════════════════
# POR QUÊ (burn test da v1.6.2, out/2026): o dono bootou e a sessão subiu
# SÓ com o wallpaper — as duas instâncias do waybar morreram caladas, sem
# deixar stderr em lugar nenhum (o labwc não redireciona o autostart e o
# gate de boot do CI para no LOGIN — nunca abre a sessão gráfica para ver).
#
# CURA EM 2 FRENTES:
#   1. SUPERVISÃO — barra que morrer volta em ≤5s (loop com sleep; o sh
#      dormindo custa ~1 MB e ~0% CPU — o seguro da UI que o dono exige
#      "completamente estável");
#   2. FORENSE — o stderr do waybar vai para ~/.cache/elite/bars.log
#      (teto de 1 MiB — sem crescimento ilimitado, diretriz v1.6.2).
#      Se morrer de novo, o log tem a mensagem EXATA do waybar — fim do
#      "iniciou sem aparecer nada" sem explicação.
#
# NOTA: o "FORA — reiniciando" no início do log era o arranque normal
# (nenhuma barra existe ainda no primeiro loop) — e MENTIA: o dump tg0b1
# do rig na 28 mostrou BARS_RESTARTS=5 com ZERO mortes reais. E43: o 1º
# spawn de cada componente é logado 'iniciando (1ª vez — nada morreu)';
# 'FORA — reiniciando' agora significa MORTE DE VERDADE (a métrica volta
# a ser evidência, não ruído).
# E43 — A FERIDA DO FD 9: os subshells `( … ) &` HERDAVAM o fd 9 do flock
# — o supervisor morto à mão deixava os wrappers segurando o lock, e a
# nova instância saía no-op: supervisão MORTA em silêncio com a casa
# parecendo cuidada. Todo spawn agora fecha o fd (9>&-) — o lock vive e
# morre COM o supervisor. (Achado do dump tg0b1: 5 'craft-bars' no ps —
# 1 supervisor + 4 wrappers com o cmdline herdado; a contagem honesta
# mora na posse do lock, não no cmdline.)
# ═══════════════════════════════════════════════════════════════════════════
# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP: a descoberta
# dentro do sistema). O bars é o supervisor da SESSÃO — não é porta de mão.
uso() {
    printf '%s\n' \
        'uso: craft-bars — supervisor da sessão (waybar top, dock, toplevel,' \
        '     idle, áudio, swaync, udiskie, polkit) com forense em bars.log' \
        '' \
        '  quem morre renasce em ≤5s; o stderr de tudo vai para' \
        '  ~/.cache/elite/bars.log (teto 1 MiB). Chamado pelo autostart do' \
        '  labwc — rodar na mão cria supervisor DUPLICADO (a lei E30 manda).'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/elite"
mkdir -p "$LOG_DIR" 2>/dev/null
LOG="$LOG_DIR/bars.log"

# v2.10.5 — SINGLETON (a mesma lei do flock do craft-toplevel): se um
# labwc morre e o logind demora a colher a sessão velha, um craft-bars
# ÓRFÃO sobrevive ao relogin — dois supervisores = barra duplicada e
# dois loops escrevendo no mesmo bars.log. Segunda instância é no-op:
# quem não segura o lock sai 0 SEM tocar em nada.
if command -v flock >/dev/null 2>&1; then
    mkdir -p "${XDG_RUNTIME_DIR:-/tmp}/elite" 2>/dev/null
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/elite/bars.lock"
    flock -n 9 || exit 0
fi

# Teto de 1 MiB (bytes): estoura, zera — evidência recente vale mais.
# v2.5.0 — virou FUNÇÃO chamada DENTRO do loop: o cap só no arranque
# deixava o crash-loop crescer sem freio (2 linhas + stderr do waybar
# por ciclo de 5s ≈ 1,7MB/h — o audit 24-b flagrou).
cap_log() {
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
        : >"$LOG"
    fi
}
cap_log

# E54 — O RICE DA CASA DESPERTA COM A SESSÃO: o craft-rice entrega os
# fragmentos de labwc (rc.xml.d — hoje, a decoração de volta nos jogos
# Proton) e aplica o reconfigure na sessão viva. Antes das barras: o rice
# nasce antes da UI que o assume. Melhor-esforço com silêncio — o arranque
# da sessão NUNCA fica preso ao rice (a barra é a missão aqui).
craft-rice >>"$LOG" 2>&1 9>&- || true

# E95 — O CHAVEIRO QUE O PAM NÃO ABRIU (a chave dos diálogos gcr-prompter):
# o journal de TODO login do rig canta 'gkr-pam: couldn't unlock the
# login keyring' e o Brave responde com o diálogo do gcr-prompter (o
# dump 225119 o flagrou 2×: 'raw entrou/saiu: gcr-prompter'). A causa é a
# herança da era do live: o bootstrap de chaveiro de senha VAZIA (a cura
# do live/autologin, v2.10.12) chegou ao home instalado ANTES do 1º
# login por senha — o PAM tenta a senha do login num chaveiro de senha
# VAZIA e falha PARA SEMPRE (a senha do chaveiro ≠ senha do login).
# A cura é a mesma porta do autostart do live, agora para o rig vivo:
# desbloquear com a senha VAZIA o chaveiro que EXISTE (o guard de
# existência é o cinto — sem chaveiro, quem o cria com a senha CERTA
# continua sendo o PAM do 1º login, a lição v2.10.12 segue LEI).
# Idempotente por natureza: chaveiro já aberto (PAM são) = no-op;
# chaveiro de senha própria = falha em silêncio (o dono vê o prompt —
# protegido é protegido). O canal é o craft-bars (domínio do PACOTE):
# o autostart do home é skel e os rigs vivos nunca o receberiam.
if command -v gnome-keyring-daemon >/dev/null 2>&1 && \
   [ -e "$HOME/.local/share/keyrings/login.keyring" ]; then
    ( printf '' | gnome-keyring-daemon --unlock >/dev/null 2>&1 ) &
fi

ensure() {
    # $1=valor da flag (0=1ª vez, 1=já visto vivo)  $2=config  $3=css
    # E36 — âncora ^: 'pgrep -f' casa SUBSTRING — um editor com "waybar -c
    # config.top" aberto mascarava a morte da barra (a mesma lição da dock
    # e do toplevel na v2.10.6; aqui estava por vir).
    # E43 — o 1º spawn é 'iniciando' (nada morreu ainda); 'FORA' só com
    # o componente JÁ VISTO vivo (a métrica BARS_RESTARTS volta a contar
    # morte, não arranque). O spawn fecha o fd 9 (ver cabeçalho E43).
    if ! pgrep -f "^waybar -c $2" >/dev/null 2>&1; then
        if [ "$1" -eq 1 ]; then
            printf '[%s] waybar top FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] waybar top iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        # v1.7.1 — EXIT CODE COMO EVIDÊNCIA: a v1.6.3 capturava o stderr,
        # mas morte LIMPA (exit 0) ou sinal não escrevem stderr nenhum —
        # "morreu calada" continuava possível. Agora TODA saída do waybar
        # deixa linha com hora e exit code (0 = morte limpa; ≠0 = crash;
        # 137 = OOM killer — o gate do CI grepa BARS_EXITS no probe).
        (
            waybar -c "$2" -s "$3" >>"$LOG" 2>&1
            st=$?
            printf '[%s] waybar top SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
        ) 9>&- &
    fi
}

# v2.0 — a dock é o craft-dock-gui (GTK3 nativa + layer-shell): ícones
# REAIS via .desktop (Gio), pílula centrada que abraça o conteúdo.
# v2.3.4 — SEMPRE VISÍVEL (o autohide por hotspot morreu na prática: o dono
# instalou a v2.3.x e a dock "sumiu e não apareceu mais"): layer BOTTOM +
# zona exclusiva = some SÓ sob tela cheia/gaveta, zero polling.
# Supervisão igual: morreu, volta em ≤5s com o stderr no bars.log (a
# evidência que a v1.6.3 instituiu).
# v2.10.1 — o craft-toplevel (o daemon wlr-foreign-toplevel que dá à dock
# as janelas por id e o anel MRU do comutador) ganha a MESMA supervisão:
# morrer calado nunca mais (a lição do burn test v1.6.2 vale pra toda a
# sessão, não só para as barras). Segunda instância é no-op (o daemon
# detecta o socket vivo e sai 0 — o restart nunca rouba nada).
cyc=0
# E43 — flags "já viu vivo": 0 = ainda não nasceu (o 1º ciclo loga
# 'iniciando'); após o 1º ciclo = 1, e ausência vira morte real ('FORA').
seen_top=0 seen_dock=0 seen_tl=0 seen_idle=0 seen_audio=0 seen_osd=0 seen_game=0 seen_swyn=0 seen_udiskie=0 seen_polkit=0 seen_display=0

# ── E97 — O COMPRIMIR CHEGA AO RIG VIVO (a ordem do dono, de novo: "o ───
# botão de comprimir ainda continua aqui no gerenciador de arquivos…
# quero desativar e ter essa opção completamente do sistema junto do
# arquivo XML que ela fica"). A E72 matou o verbo no SKEL e criou a
# seção [9] do elite-tune para os rigs — mas a chegada era MANUAL
# ("sudo craft-update && sudo elite-tune"): o dono só roda o
# craft-update, o elite-tune nunca rodou no rig, e o uca.xml FÓSSIL do
# home segue carregando o bloco <action> do Comprimir (o 'criar arquivo'
# do xarchiver — que o dono aprovou — é o outro caminho e segue vivo).
# A CURA É O CANAL QUE SEMPRE ALCANÇA: este supervisor roda como o
# USUÁRIO da sessão a TODO arranque (a lei E58/E95 — polkit, chaveiro e
# o display da E96 vieram por aqui). One-shot natural: o grep falhou =
# o bloco já não existe = silêncio eterno (escola E64); o awk é o MESMO
# da seção [9] do elite-tune (a gêmea de root) — os vizinhos
# elite-open-terminal-1/elite-craft-extract-1 intactos, backup .bak-
# ao lado. O Thunar vivo relê o uca.xml na próxima sessão dele (ou
# reinício do próprio Thunar) — o papel registra o resto.
UCA_E97="$HOME/.config/Thunar/uca.xml"
if [ -f "$UCA_E97" ] && grep -q 'elite-craft-compress-1' "$UCA_E97" 2>/dev/null; then
    cp -p "$UCA_E97" "$UCA_E97.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    if awk '
        /<action>/ { ina=1; buf="" }
        ina { buf = buf (buf=="" ? "" : ORS) $0 }
        ina && /<\/action>/ {
            ina=0
            if (buf !~ /elite-craft-compress-1/) print buf
            next
        }
        !ina { print }
    ' "$UCA_E97" > "$UCA_E97.tmp" && [ -s "$UCA_E97.tmp" ]; then
        mv -f "$UCA_E97.tmp" "$UCA_E97"
        printf '[%s] thunar: verbo Comprimir… removido do uca.xml (E97 — a E72 chegou ao rig pelo supervisor; terminal e Extrair intactos)\n' "$(date '+%F %T')" >>"$LOG"
    else
        rm -f "$UCA_E97.tmp" 2>/dev/null || true
        printf '[%s] thunar: FALHA ao reescrever o uca.xml — o verbo Comprimir… segue (réu nomeado)\n' "$(date '+%F %T')" >>"$LOG"
    fi
fi
unset UCA_E97

while :; do
    # v2.10.26/E38 — o teto segue NO LOOP, agora a cada 6 ciclos (30s): o
    # fork do wc só em 1 de 6 (eram 17.280 forks/dia só para medir tamanho;
    # agora ~2.880 — o crash-loop de ~1,7MB/h passa do teto de 1 MiB em
    # ~35min de qualquer forma, o cap continua honesto).
    cyc=$((cyc + 1))
    [ $((cyc % 6)) -eq 0 ] && cap_log
    # E43 — as flags "já viu vivo": o 1º ciclo loga 'iniciando'; depois,
    # ausência = morte real ('FORA — reiniciando').
    ensure "$seen_top" "$HOME/.config/waybar/config.top" "$HOME/.config/waybar/style.top.css"
    seen_top=1
    if ! pgrep -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' >/dev/null 2>&1; then
        if [ "$seen_dock" -eq 1 ]; then
            printf '[%s] dock craft-dock-gui FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] dock craft-dock-gui iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        (
            /usr/local/bin/craft-dock-gui >>"$LOG" 2>&1
            st=$?
            printf '[%s] dock craft-dock-gui SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
        ) 9>&- &
    fi
    seen_dock=1
    # v2.10.6 — as ÂNCORAS: 'pgrep -f' casa SUBSTRING do cmdline — o dono
    # com o fonte aberto no editor ('vim …/craft-toplevel.c') MASCARAVA a
    # morte do daemon e a supervisão ficava cega enquanto o editor vivesse.
    # O comm do toplevel É 'craft-toplevel' (binário C): -x é o casamento
    # honesto; o comm da dock é 'python3' (shebang): -f com padrão ANCORA­DO
    # (só a dock de verdade — editor com o arquivo aberto não engana mais).
    if ! pgrep -x craft-toplevel >/dev/null 2>&1; then
        if [ "$seen_tl" -eq 1 ]; then
            printf '[%s] toplevel craft-toplevel FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] toplevel craft-toplevel iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        (
            /usr/local/bin/craft-toplevel >>"$LOG" 2>&1
            st=$?
            # v2.10.5 — A CORRIDA DO FORK: o autostart lança o daemon e o
            # 1º pgrep deste loop pode chegar ANTES do exec completar →
            # spawn duplicado → o novo perde o flock do socket e sai 0.
            # Isso NÃO é morte: logar 'SAIU exit=0' inchava o BARS_EXITS
            # e derrubava o gate do QEMU numa sessão SAUDÁVEL (a perícia
            # da auditoria de simulações v2.10.5). Veredito por prova:
            # exit 0 + outro daemon vivo = corrida, não óbito.
            if [ "$st" -eq 0 ] && pgrep -x craft-toplevel >/dev/null 2>&1; then
                printf '[%s] toplevel 2ª instância saiu 0 (flock já segurado) — benigno\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] toplevel craft-toplevel SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            fi
        ) 9>&- &
    fi
    seen_tl=1
    # v2.10.6 — O IDLE ENTRA NA SUPERVISÃO (achado da Rodada 2): o
    # craft-idle start era lançado UMA vez no autostart — morrendo calado,
    # lock/DPMS/suspend ficavam fora PARA SEMPRE e ninguém avisa. Mesma
    # cura da família: morreu, volta em ≤5s com o stderr no bars.log.
    # LOCK_MIN=0 ("Nunca") é AUSÊNCIA INTENCIONAL — sem linha, sem spam
    # (o clamp espelha o próprio craft-idle: valor lixo = padrão de
    # fábrica). O spawn do autostart saiu: um só lançador (o supervisor)
    # mata a corrida fork/exec da classe toplevel — dois 'craft-idle
    # start' próximos se pkillariam (o pkill -x swayidle do começo do
    # start) e o morto deixaria 'SAIU exit=143' no gate.
    if ! pgrep -x swayidle >/dev/null 2>&1; then
        lm="$(sed -n 's/^LOCK_MIN=//p' "$HOME/.config/elite/idle.conf" 2>/dev/null | head -1)"
        case "${lm:-}" in ''|*[!0-9]*) lm=10 ;; esac
        # E36 (audit de arquitetura): o gate só olhava LOCK_MIN — a
        # combinação Lock=Nunca + Suspender=20min nunca nascia (o menu
        # gravava o conf, o daemon morria no exit 0 e NADA era dito).
        # O clamp do sm espelha o próprio craft-idle (valor lixo = 20 de
        # fábrica — o conf do skel).
        sm="$(sed -n 's/^SUSPEND_MIN=//p' "$HOME/.config/elite/idle.conf" 2>/dev/null | head -1)"
        case "${sm:-}" in ''|*[!0-9]*) sm=20 ;; esac
        if [ "$lm" -gt 0 ] 2>/dev/null || [ "$sm" -gt 0 ] 2>/dev/null; then
            if [ "$seen_idle" -eq 1 ]; then
                printf '[%s] idle swayidle FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] idle swayidle iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
            fi
            (
                /usr/local/bin/craft-idle start >>"$LOG" 2>&1
                st=$?
                printf '[%s] idle swayidle SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            ) 9>&- &
        fi
    fi
    seen_idle=1
    # E30 (v2.10.18) — O ROTEADOR DE ÁUDIO ENTRA NA SUPERVISÃO (dump p6aw:
    # o som do rig saía pelo SINK FANTASMA do microfone USB — o dono pediu
    # troca automática ao plugar fone/saída). Mesma lei da família: o
    # daemon é event-driven (pactl subscribe, zero polling) e morrer
    # calado deixaria a troca automática fora PARA SEMPRE. Saída 1 do
    # spawn = pactl/binário ausente (sem pilha de áudio) — a condição
    # abaixo não teria deixado nascer; morreu dentro = volta em ≤5s.
    if command -v craft-audio-route >/dev/null 2>&1 && command -v pactl >/dev/null 2>&1; then
        if ! pgrep -f '^/usr/bin/env python3 /usr/local/bin/craft-audio-route$|^python3 /usr/local/bin/craft-audio-route$' >/dev/null 2>&1; then
            if [ "$seen_audio" -eq 1 ]; then
                printf '[%s] audio craft-audio-route FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] audio craft-audio-route iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
            fi
            (
                /usr/local/bin/craft-audio-route >>"$LOG" 2>&1
                st=$?
                printf '[%s] audio craft-audio-route SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            ) 9>&- &
        fi
    fi
    seen_audio=1
    # E101 — O OSD ENTRA NA SUPERVISÃO (a lição v2.10.6 do idle aplicada ao
    # irmão): o spawn do autostart é do home VIVO (domínio do dono) — nos
    # rigs onde ele existe fica (o pgrep guarda a dupla nasceria); nos que
    # NÃO têm a linha, o supervisor lança e RELANÇA (a barra do swayosd
    # morria calada e o volume voltava a ser cego). O pacote é a âncora
    # E94 (ADOCAO) — o rig do dono recebe o binário na dose e o daemon
    # sobe na hora, sem relogin.
    if command -v swayosd-server >/dev/null 2>&1; then
        if ! pgrep -x swayosd-server >/dev/null 2>&1; then
            if [ "$seen_osd" -eq 1 ]; then
                printf '[%s] OSD swayosd-server FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] OSD swayosd-server iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
            fi
            (
                swayosd-server >>"$LOG" 2>&1
                st=$?
                printf '[%s] OSD swayosd-server SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            ) 9>&- &
        fi
    fi
    seen_osd=1
    # E101 — O WATCH DO MODO DE JOGO ENTRA NA SUPERVISÃO (o mesmo corpo da
    # família): AUTO=1 no ~/.config/elite/game.conf é o contrato — o daemon
    # SAI 0 sozinho quando AUTO≠1 (ausência intencional, lei do idle, zero
    # spam); AUTO=1 + gamemode presente = o detector de jogos no ar, morre
    # → volta em ≤5s. O gamemoded em si é D-Bus activation (idle = RAM zero
    # — o músculo só existe quando há jogo).
    if command -v craft-game >/dev/null 2>&1; then
        auto="$(sed -n 's/^AUTO=//p' "$HOME/.config/elite/game.conf" 2>/dev/null | head -1)"
        if [ "${auto:-0}" = 1 ] && ! pgrep -f '^/usr/local/bin/craft-game watch$' >/dev/null 2>&1; then
            if [ "$seen_game" -eq 1 ]; then
                printf '[%s] game watch FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] game watch iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
            fi
            (
                /usr/local/bin/craft-game watch >>"$LOG" 2>&1
                st=$?
                printf '[%s] game watch SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            ) 9>&- &
        fi
    fi
    seen_game=1
    # E36 — FIM DOS ÓRFÃOS (audit de arquitetura, sessão Q2/Q8): o swaync é
    # a superfície de TODOS os avisos de erro dos craft-*; o udiskie monta
    # o USB; o agente polkit responde o pkexec — os três morriam CALADOS
    # (nenhum relançamento, nenhum log, nenhum gate). Mesma lei da família:
    # o autostart lança na 1ª vez; este ensure é a rede — pgrep vivo =
    # nada acontece (idempotente, sem corrida fork/exec da classe idle).
    if command -v swaync >/dev/null 2>&1 && ! pgrep -x swaync >/dev/null 2>&1; then
        if [ "$seen_swyn" -eq 1 ]; then
            printf '[%s] swaync FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] swaync iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        (
            swaync >>"$LOG" 2>&1
            st=$?
            printf '[%s] swaync SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
        ) 9>&- &
    fi
    seen_swyn=1
    if command -v udiskie >/dev/null 2>&1 && ! pgrep -x udiskie >/dev/null 2>&1; then
        if [ "$seen_udiskie" -eq 1 ]; then
            printf '[%s] udiskie FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] udiskie iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        (
            udiskie --automount --notify --no-tray >>"$LOG" 2>&1
            st=$?
            printf '[%s] udiskie SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
        ) 9>&- &
    fi
    seen_udiskie=1
    # E43 — O AGENTE POLKIT DA CASA: hyprpolkitagent (wlroots-nativo) na
    # frente; o polkit-gnome 0.105 (GTK2, 2010) fica como legado de
    # transição. O gparted do dono morreu no diálogo do velho com senha
    # VIVA provada (dump tg0b1: o sudo do craft-dump pediu e ACEITOU a
    # senha de chris) — o diálogo é o réu, não a senha.
    # E58 — O ROLLING TROCA O JOGO EMBAIXO (verify da ISO 05/nov:
    # BARS_EXITS=17, 'invalid version for global zwlr_layer_shell_v1 —
    # expected at most 4, got 5'): o hyprpolkitagent 0.2.0 (02/nov) nasceu
    # REESCRITO em hyprtoolkit, e o hyprtoolkit binda layer-shell v5 — o
    # labwc 0.20.2 do live oferece v4: o agente morre a cada spawn, o
    # supervisor ressuscita, morre de novo. A cura é o PROBE POR CONTEÚDO:
    # binário com 'hyprtoolkit' dentro não roda no labwc de hoje e SAI DA
    # FILA. lxqt-policykit 2.4 (Qt6, WM-agnóstico, no extra desde abr/26)
    # assume a frente; o hyprpolkitagent da era Qt (v0.1.x, o dos rigs que
    # ainda não atualizaram) segue válido de fallback; polkit-gnome segue
    # último recurso (aposentado no packages.remove da ISO). Fila única,
    # decisão provável no papel — quando o labwc aprender v5, uma linha
    # aqui devolve o agente nativo.
    # E101 — O POLKIT SOB DEMANDA (a diretriz do dono: 'subir o prompt
    # APENAS quando uma aplicação solicitar, encerrando logo em seguida —
    # RAM nula em idle'). A perícia no fonte do polkit provou: o polkitd
    # NUNCA D-Bus ativa agentes e REJEITA um segundo por sessão — o agente
    # se REGISTRA e o prompt é DESAFIO. O elite-polkit-listener (C vendado,
    # sha pinado, do pacote único) é o corpo SEMPRE VIVO MÍNIMO (GDBus,
    # idle ~1–2 MB — sem Qt na RAM): registra o agente da sessão e abre o
    # diálogo (zenity) SÓ quando um app pede privilégio, matando-o com o
    # desafio. A fila da casa reorganiza: LISTENER (idle nulo) → lxqt
    # (residente, fallback honesto) → hyprpolkitagent (era Qt) → polkit-gnome
    # (legado). O TRONO segue um só (E95): com o listener eleito, TODOS os
    # residentes se aposentam (o polkitd recusa o segundo registro —
    # dois agentes = duas caixas de senha por pedido).
    POLKIT_BIN=""
    if command -v elite-polkit-listener >/dev/null 2>&1 \
            && command -v zenity >/dev/null 2>&1; then
        POLKIT_BIN=/usr/local/bin/elite-polkit-listener
    else
        for pb in /usr/bin/lxqt-policykit-agent \
                  /usr/lib/hyprpolkitagent/hyprpolkitagent \
                  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
            [ -x "$pb" ] || continue
            grep -q 'hyprtoolkit' "$pb" 2>/dev/null && continue
            POLKIT_BIN="$pb"
            break
        done
    fi
    # E95 — UM TRONO SÓ (o perdedor sai da sala): os homes VIVOS ainda
    # sobem o polkit-gnome às cegas pelo autostart do skel velho (home é
    # domínio do dono — update nenhum o toca), e quando o eleito chega
    # pelo craft-update os DOIS viveriam juntos: dois agentes registrados
    # = o diálogo da senha nasce DUAS vezes por pedido. A fila E58 reina
    # em UM trono: o eleito sobe (o bloco de baixo), os demais que
    # estiverem VIVOS são aposentados na hora — o supervisor é quem
    # decide, e o home velho obedece.
    # E101 — com o listener eleito, o lxqt-policykit-agent RESIDENTE também
    # é aposentado (ele é o perdedor da fila nova; sem listener na máquina,
    # ele é o eleito e NINGUÉM o toca — o fallback é a rede).
    for loser in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
                /usr/lib/hyprpolkitagent/hyprpolkitagent; do
        [ "$loser" = "$POLKIT_BIN" ] && continue
        if pgrep -f "^$loser\$" >/dev/null 2>&1; then
            pkill -f "^$loser\$" 2>/dev/null || true
            printf '[%s] polkit perdedor aposentado (%s — a fila única E58 reina: um trono só)\n' \
                "$(date '+%F %T')" "${loser##*/}" >>"$LOG"
        fi
    done
    if [ "$POLKIT_BIN" = "/usr/local/bin/elite-polkit-listener" ]; then
        if pgrep -x lxqt-policykit-agent >/dev/null 2>&1; then
            pkill -x lxqt-policykit-agent 2>/dev/null || true
            printf '[%s] polkit perdedor aposentado (lxqt-policykit-agent residente — o listener E101 reina com idle nulo)\n' \
                "$(date '+%F %T')" >>"$LOG"
        fi
    fi
    # E105 — A DEMOÇÃO HONESTA (a prova do dump 195332: o listener morrendo
    # no arranque voltava a cada tick PARA SEMPRE — o supervisor relançava
    # o mesmo perdedor a cada 5s e a sessão vivia SEM agente, com o lxqt
    # aposentado antes: a rede ficou muda). O tempo de vida de cada saída
    # vai para o papel (polkit-fails em XDG_RUNTIME_DIR — tmpfs por boot):
    # três mortes curtas (≤5s) seguidas = o trono troca de rei (o fallback
    # da fila assume) e o contador zera. Sucesso apaga o passado.
    POLKIT_FAILS="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/elite/polkit-fails"
    mkdir -p "${POLKIT_FAILS%/*}" 2>/dev/null || true
    if pgrep -f "^$POLKIT_BIN\$" >/dev/null 2>&1; then
        : > "$POLKIT_FAILS" 2>/dev/null || true
    fi
    if [ -x "$POLKIT_BIN" ] && ! pgrep -f "^$POLKIT_BIN\$" >/dev/null 2>&1; then
        if [ "$POLKIT_BIN" = "/usr/local/bin/elite-polkit-listener" ] \
                && [ "$(grep -c . "$POLKIT_FAILS" 2>/dev/null || echo 0)" -ge 3 ]; then
            _novo=""
            for pb in /usr/bin/lxqt-policykit-agent \
                      /usr/lib/hyprpolkitagent/hyprpolkitagent \
                      /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
                [ -x "$pb" ] || continue
                grep -q 'hyprtoolkit' "$pb" 2>/dev/null && continue
                _novo="$pb"
                break
            done
            if [ -n "$_novo" ]; then
                printf '[%s] polkit DEMOÇÃO: o listener morreu %s arranques seguidos em ≤5s — %s assume o trono (a fila é a rede, E105)\n' \
                    "$(date '+%F %T')" "$(grep -c . "$POLKIT_FAILS" 2>/dev/null || echo '?')" "${_novo##*/}" >>"$LOG"
                POLKIT_BIN="$_novo"
                : > "$POLKIT_FAILS" 2>/dev/null || true
                pkill -x elite-polkit-listener 2>/dev/null || true
            else
                : > "$POLKIT_FAILS" 2>/dev/null || true
            fi
        fi
        if [ "$seen_polkit" -eq 1 ]; then
            printf '[%s] polkit FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
        else
            printf '[%s] polkit iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
        fi
        (
            _t0=$(date +%s)
            "$POLKIT_BIN" >>"$LOG" 2>&1
            st=$?
            _d=$(( $(date +%s) - _t0 ))
            if [ "$st" -ne 0 ] && [ "$_d" -le 5 ]; then
                printf '%s\n' "$_d" >>"$POLKIT_FAILS" 2>/dev/null || true
            else
                : > "$POLKIT_FAILS" 2>/dev/null || true
            fi
            printf '[%s] polkit SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
        ) 9>&- &
    fi
    seen_polkit=1
    # E96 — A TELA QUE LEMBRA ALCANÇA OS RIGS VIVOS (a classe fóssil
    # E90/E95, réu do relato do dono: "reiniciei, ele não ficou os
    # hertz"): o apply/watch nasceram no AUTOSTART (E89), mas o autostart
    # do home vivo é domínio do dono — o rig da casa carrega o fóssil SEM
    # as linhas, o displays.conf nunca nasceu (dump 150829 L436: 'sem
    # displays.conf') e os 200 Hz morriam a cada boot. O supervisor é a
    # casa do pacote que alcança rigs vivos (a lei E58/E95 — polkit e
    # chaveiro vieram antes). O watch é daemon de sessão (grava sozinho a
    # mudança estável de QUALQUER porta — wdisplays, menu, CLI); o apply
    # corre UMA vez por sessão (stamp próprio em XDG_RUNTIME_DIR — quem
    # chega 2º sai em silêncio, escola E64; autostart que um dia ganhe as
    # linhas não vira corrida dupla).
    if command -v craft-display >/dev/null 2>&1; then
        (
            /usr/local/bin/craft-display apply >>"$LOG" 2>&1
        ) 9>&- &
        if ! pgrep -f 'craft-display watch$' >/dev/null 2>&1; then
            if [ "$seen_display" -eq 1 ]; then
                printf '[%s] display watch FORA — reiniciando\n' "$(date '+%F %T')" >>"$LOG"
            else
                printf '[%s] display watch iniciando (1ª vez — nada morreu)\n' "$(date '+%F %T')" >>"$LOG"
            fi
            (
                /usr/local/bin/craft-display watch >>"$LOG" 2>&1
                st=$?
                printf '[%s] display watch SAIU exit=%d\n' "$(date '+%F %T')" "$st" >>"$LOG"
            ) 9>&- &
        fi
        seen_display=1
    fi
    sleep 5
done
