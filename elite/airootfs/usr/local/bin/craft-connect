#!/bin/sh
# craft-connect — central de CONECTIVIDADE da menu bar (v4 — o menu que CHAMA o serviço)
# ─────────────────────────────────────────────────────────────────────────
# v4 (v2.3.7 — o dono USOU o picker no live e decretou a direção, 25/10):
#   · "um menu serve pra chamar o serviço… evitando criar submenus e
#     coisas que podem quebrar" — o picker fuzzel+nmcli da v3 conectou
#     3× COM SENHA CORRETA e falhou (menus.log 23:14: FALHA NILDOMAR-2G,
#     Natalya Dias ×2). Desenhar submenu próprio = desenhar a falha junto.
#   · "assim como o bluetooth faz: eu clicar no bluetooth ele abre o
#     gerenciador" — o verbo Wi-Fi agora abre o GERENCIADOR DO SISTEMA
#     (nm-connection-editor — o mesmo que o W-n já chamava; fallback
#     nmtui, ferramenta do próprio NetworkManager). Zero lógica nossa no
#     caminho da conexão: conectar, esquecer, priorizar, criar VPN — é
#     o trabalho do gerenciador, não de um dropdown desenhado.
#   · o picker, o prompt 'Senha' e o parse de SSID/signal MORREM AQUI —
#     menos superfície, menos modo de falhar (a lição inteira da v3).
# v3 (v2.3.6 — relato do dono com prints do rig v2.3.5):
#   · "remove esse ícone feio de Pc" — o applet da tray MORREU: o ícone SNI
#     de ethernet é bitmap de tema de ícones, quebra a família tipográfica
#     da barra (todo o resto é glifo Nerd Font) e vive mal alinhado. A
#     tray saiu junto: nada mais a exibir (udiskie roda --no-tray).
#   · "tira isso de editar conexão da tela de rede" — o EDITOR saiu do
#     menu (volta a ser O MENU INTEIRO na v4, pelo mesmo dono).
# Histórico: v1.4 toggle · v1.8.2 GUIs no lugar dos TUIs · v2.3.1 fim do
#            silêncio · v2.3.6 o conector é o menu · v2.3.7 o menu chama
#            o serviço (fim do picker desenhado).
# ─────────────────────────────────────────────────────────────────────────
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# TOGGLE: central aberta? fecha e sai
# v2.3.7 — o prompt 'Wi-Fi' era do picker (morto); o toggle só cuida da Rede
if pgrep -f 'fuzzel.*--prompt=Rede' >/dev/null 2>&1; then
    pkill -f 'fuzzel.*--prompt=Rede' 2>/dev/null || true
    exit 0
fi
# v1.8.2 — CROSS-DISMISS: dois dropdowns nunca coexistem.
# v2.3.7 — 'Senha' sai da lei (o prompt morreu com o picker)
pkill -f 'fuzzel.*--prompt=(Sess|Encer)' 2>/dev/null || true

MENU='Wi-Fi: gerenciar conexões…
Bluetooth: dispositivos'

if command -v fuzzel >/dev/null 2>&1; then
    # v2.3.7 — menus CENTRALIZADOS (dono: "centralizar neles no meio" —
    # os dropdowns nascem no centro da tela, como nos sistemas que ele
    # citou como referência; sem margens de canto)
    # v2.3.1: stderr CAPTURADO — crash do fuzzel vira log + notify, nunca
    # morte calada (a denúncia do rig: "os menus morreram").
    mlog "Rede: abrindo (fuzzel)"
    errf="$(mktemp)"
    ec=0
    choice="$(printf '%s\n' "$MENU" | fuzzel --dmenu \
        --anchor=center \
        --lines=2 --width=28 --prompt='Rede  ' 2>"$errf")" || ec=$?
    if [ "$ec" -eq 143 ]; then
        # v2.3.5 — SIGTERM = fechado de fora (toggle/cross-dismiss)
        mlog "Rede: fechado de fora (SIGTERM — toggle/cross-dismiss) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -eq 1 ] && [ ! -s "$errf" ]; then
        # v2.3.6 — ESC = fechado pelo usuário (stderr vazio ≠ crash — e com
        # o fuzzel.ini em #, o stderr fica VAZIO de verdade: o ';' da v1.3
        # sujava o stderr de TODA abertura e ESC virava alarme crítico falso,
        # o que o dono reviu ao vivo: "o menu de processos falhou, o mesmo
        # erro 1 que vem acontecendo nos demais")
        mlog "Rede: fechado pelo usuário (ESC) — benigno"
        rm -f "$errf"
        exit 0
    fi
    if [ "$ec" -ne 0 ]; then
        mlog "Rede: FUZZEL FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -a 'Elite' -u critical 'Menu de Rede falhou' \
                "fuzzel exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"
else
    mlog "Rede: fuzzel AUSENTE — fallback impala"
    exec foot -e impala
fi

case "$choice" in
    'Wi-Fi: gerenciar conexões…')
        # v2.3.7 — o MENU CHAMA O SERVIÇO (a diretriz do dono): o
        # gerenciador do sistema cuida de conectar/esquecer/priorizar/VPN.
        mlog "Rede: chamando o gerenciador de conexões do sistema"
        if command -v nm-connection-editor >/dev/null 2>&1; then
            exec nm-connection-editor
        fi
        exec foot -e nmtui ;;
    'Bluetooth: dispositivos')
        if command -v blueman-manager >/dev/null 2>&1; then
            exec blueman-manager
        fi
        exec foot -e bluetui ;;
    *)                            exit 0 ;;
esac
