#!/bin/sh
# craft-connect — central de CONECTIVIDADE da menu bar (v1.4)
# ─────────────────────────────────────────────────────────────────────────
# Diretriz do dono (burn test da v1.3 ao vivo): "um só ícone" — o módulo
# network da waybar chama ESTE script no clique: cabo + Wi-Fi + Bluetooth
# resolvidos de UM lugar (dropdown fuzzel ancorado no canto superior
# direito, pendurado na menu bar como o de Sessão). Esc fecha; teclado
# continua valendo: W-n (impala direto) e W-S-b (bluetui direto).
#
# v1.4: TOGGLE — 2ª chamada com o menu aberto apenas fecha (mesma cura
# do craft-power; prompt único 'Rede' nunca colide com o 'Sessão').
# Sem fuzzel: cai direto no impala (a rede é o caso padrão).
#
# v2.3.1 — FIM DO SILÊNCIO (mesma cura da família): open/falha deixam linha
# em ~/.cache/elite/menus.log e falha de fuzzel avisa na tela (notify-send).
# "Rede: abrindo" sem menu na tela = fuzzel morreu depois de abrir.
set -eu

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

# TOGGLE: central aberta? fecha e sai
if pgrep -f 'fuzzel.*--prompt=Rede' >/dev/null 2>&1; then
    pkill -f 'fuzzel.*--prompt=Rede' 2>/dev/null || true
    exit 0
fi
# v1.8.2 — CROSS-DISMISS: abrir a central de Rede FECHA o menu de Sessão
# (a mesma cura do craft-power, no sentido oposto — dois dropdowns nunca
# ficam na tela ao mesmo tempo).
pkill -f 'fuzzel.*--prompt=Sess' 2>/dev/null || true
# v2.3.4 — o menu de processos (craft-bgapps) entra na mesma lei.
pkill -f 'fuzzel.*--prompt=Encer' 2>/dev/null || true

# v1.8.2 — GUI (áudio do dono, 24/out: "impala e bluetui… eu não sei
# utilizar esses programas que são terminal, quero gerenciadores que
# funcionem melhor com a interface, mais bonito e mais fácil"): o menu
# abre os GERENCIADORES GRÁFICOS (nm-connection-editor para rede com
# Wi-Fi/Ethernet/VPN em árvore; blueman-manager para Bluetooth com
# pareamento em janela). Os TUIs Rust continuam como fallback no foot
# (e W-n/W-S-b agora apontam para os GUIs — rc.xml).
MENU='Wi-Fi e Ethernet (configurações)
Bluetooth (dispositivos)'

if command -v fuzzel >/dev/null 2>&1; then
    # mesmas âncoras do craft-power: pendurado no canto direito da menu
    # bar (36px) — os dois dropdowns da barra nascem do mesmo lugar
    # v2.3.1: stderr CAPTURADO — crash do fuzzel vira log + notify, nunca
    # morte calada (a denúncia do rig: "os menus morreram").
    mlog "Rede: abrindo (fuzzel)"
    errf="$(mktemp)"
    ec=0
    choice="$(printf '%s\n' "$MENU" | fuzzel --dmenu \
        --anchor=top-right --x-margin=10 --y-margin=44 \
        --lines=2 --width=28 --prompt='Rede  ' 2>"$errf")" || ec=$?
    if [ "$ec" -ne 0 ]; then
        mlog "Rede: FUZZEL FALHOU exit=$ec — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -a 'Elite' -u critical 'Menu de Rede falhou' \
                "fuzzel exit=$ec — detalhe em ~/.cache/elite/menus.log" || true
    fi
    rm -f "$errf"
else
    mlog "Rede: fuzzel AUSENTE — fallback impala"
    exec foot -e impala
fi

case "$choice" in
    'Wi-Fi e Ethernet (configurações)')
        if command -v nm-connection-editor >/dev/null 2>&1; then
            exec nm-connection-editor
        fi
        exec foot -e impala ;;
    'Bluetooth (dispositivos)')
        if command -v blueman-manager >/dev/null 2>&1; then
            exec blueman-manager
        fi
        exec foot -e bluetui ;;
    *)                            exit 0 ;;
esac
