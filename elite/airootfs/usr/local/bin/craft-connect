#!/bin/sh
# craft-connect — CENTRAL DE REDE que CONTROLA o NetworkManager (v6)
# ─────────────────────────────────────────────────────────────────────────
# v6 (v2.7.0 — o dono, rig: "o menu de redes não ficou tão responsivo e
# rápido apesar de finalmente funcionar… buscar redes por exemplo demora
# um pouco" + "conseguir excluir rede diretamente da tela de conexões
# salvas ou até mesmo editar a senha… deixar a parte de editor para
# editar as redes invés de criar um menu só pra isso"):
#   · RÁPIDO DE VERDADE: a lista de redes abre do CACHE do NetworkManager
#     (--rescan no — instantâneo; a varredura BLOQUEANTE da era v5
#     travava a abertura por 2–8s — a lentidão que o dono flagrou). A
#     varredura nova roda EM PARALELO (fogo-e-esquece na abertura da
#     central) e o verbo EXPLÍCITO "Atualizar…" varre e espera — o custo
#     dos segundos é só quem pediu;
#   · status de dispositivos e rádio consultados em PARALELO (wait) — a
#     central responde na hora;
#   · CONEXÕES SALVAS se GEREM no próprio lugar, SEM menu separado de
#     gestão: o pick da conexão abre os verbos DELA (estado-aware):
#     Conectar/Desconectar · Alterar senha… (Wi-Fi, --ask) · Esquecer…
#     (com confirmação — apagar rede salva não pode ser acidente);
#   · o EDITOR (nm-connection-editor) fica para o que o dono definiu:
#     a CRIAÇÃO manual mora lá.
# v5 (v2.6.0): o menu volta a ser O CONTROLE, com o nmcli (o cli do
# PRÓPRIO NetworkManager) como fonte única de verdade — cada verbo é UM
# comando do serviço, zero lógica de rede nossa. O bug do picker v3
# (v2.3.6) morreu de vez: o par linha→SSID/segredo é guardado num MAPA
# escrito pelo MESMO awk que desenha a lista — o valor devolvido ao NM é
# o que o NM entregou, nunca um parse de tela.
# Os menus abrem SOB O BOTÃO de rede (--at=network — craft-menu v4) e a
# lei dos fechamentos (ESC 1 · toggle 2 · cross-dismiss 143) é a do
# craft-menu, intacta.
# v4 (v2.3.7 — o dono USOU o picker no live e decretou a direção): menu
# chamava o gerenciador. v3 (v2.3.6): picker conectou 3× COM SENHA e
# falhou (menus.log 23:14). v1.4 toggle · v1.8.2 GUIs · v2.3.1 fim do
# silêncio · v2.3.6 o conector é o menu · v2.3.7 o menu chama o serviço.
# ─────────────────────────────────────────────────────────────────────────
set -u

MLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/menus.log"
mlog() {
    mkdir -p "${MLOG%/*}" 2>/dev/null
    if [ -f "$MLOG" ] && [ "$(wc -c <"$MLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        : >"$MLOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$MLOG" 2>/dev/null
    return 0
}

note() {
    # aviso que SOME (urgência normal + timeout — o v2.3.10: crítico eterno
    # nunca mais)
    if command -v notify-send >/dev/null 2>&1; then
        timeout 5 notify-send -a 'Elite' "$@" >/dev/null 2>&1 || true
    fi
    return 0
}

# MAPA linha→valor (escrito pelo MESMO awk que desenha a lista; rm em TODO
# ponto de saída + trap — e rm ANTES de qualquer exec, lição 24-c).
# T1/T2 — os rasps do nmcli PARALELO do main_rows (nomes fixos com uid:
# sobrescritos a cada abertura, sem mktemp para esquecer no trap).
# id -u e não a variavel UID do bash (dash não a tem; sob set -u seria morte silenciosa)
UN="$(id -u 2>/dev/null || echo 0)"
MAP="${XDG_RUNTIME_DIR:-/tmp}/elite-net.$UN.map"
T1="${XDG_RUNTIME_DIR:-/tmp}/elite-net.$UN.dev"
T2="${XDG_RUNTIME_DIR:-/tmp}/elite-net.$UN.radio"
trap 'rm -f "$MAP" "$T1" "$T2"' EXIT
: >"$MAP"

_c=""
_rc=0
open_menu() {
    # craft-menu com stderr capturado (falha vira log + aviso, nunca morte
    # calada — a lei v2.3.1)
    errf="$(mktemp)"
    _rc=0
    _c="$(craft-menu "$@" 2>"$errf")" || _rc=$?
    if [ "$_rc" -ne 0 ] && [ -s "$errf" ]; then
        mlog "Rede: craft-menu rc=$_rc — stderr: $(head -c 200 "$errf" | tr '\n' ';')"
    fi
    rm -f "$errf"
    return 0
}

benign_close() {
    # fechamento SEM escolha NUNCA é erro (ESC 1 · toggle 2 · cross-dismiss 143)
    case "$1" in
        1|2|143) mlog "Rede: fechado pelo usuário (ESC)/toggle/cross-dismiss (rc=$1) — benigno"; return 0 ;;
    esac
    return 1
}

menu_fail() {
    mlog "Rede: MENU FALHOU rc=$1"
    note -u normal -t 8000 'Menu de Rede falhou' \
        "craft-menu exit=$1 — detalhe em ~/.cache/elite/menus.log"
}

# ── as LINHAS do menu principal (estado ao vivo do NetworkManager) ─────────
main_rows() {
    rows=""
    # v6 — PARALELO: status de dispositivos e rádio ao MESMO tempo (em
    # série eram 2 viagens de D-Bus seguidas; o menu responde instantâneo)
    nmcli -t -f DEVICE,TYPE,STATE device status >"$T1" 2>/dev/null &
    nmcli radio wifi >"$T2" 2>/dev/null &
    wait
    eth="$(awk -F: '$2=="ethernet" && $1!="" && $1!="--" {print $1 "\t" $3}' "$T1" 2>/dev/null || true)"
    if [ -n "$eth" ]; then
        while read -r d s; do
            [ -n "${d:-}" ] || continue
            case "${s:-}" in
                connected)
                    rows="${rows}Desligar cabo ($d)
" ;;
                disconnected)
                    rows="${rows}Ligar cabo ($d)
" ;;
                *)
                    # unmanaged/unavailable (sem cabo na porta) — informativa
                    rows="${rows}Cabo: indisponível ($d)
" ;;
            esac
        done <<EOF
$eth
EOF
    fi
    wifi="$(cat "$T2" 2>/dev/null || true)"
    case "$wifi" in
        enabled)
            rows="${rows}Wi-Fi: desligar
Redes Wi-Fi…
" ;;
        disabled)
            rows="${rows}Wi-Fi: ligar
" ;;
    esac
    rows="${rows}Conexões salvas…
Bluetooth: dispositivos…
Editor de conexões…"
    printf '%s\n' "$rows"
}

# ── varredura de FUNDO (fogo-e-esquece — o cache fica fresco sozinho) ──────
bg_rescan() {
    # a varredura NUNCA segura o menu: dispara, some, e o NM atualiza o
    # cache dele — a próxima lista abre já com rede nova (o --rescan no
    # da lista é instantâneo por isso mesmo)
    ( nmcli device wifi rescan >/dev/null 2>&1 & ) 2>/dev/null
    return 0
}

# ── varredura EXPLÍCITA (o verbo Atualizar — varre e ESPERA a NOVA) ─────────
wifi_rescan() {
    mlog "Rede: varredura explícita (Atualizar)"
    # A PROVA da varredura nova é o RELÓGIO do dispositivo (LAST_SCAN),
    # não a lista: a varredura de FUNDO já atualizou o cache sozinha, e
    # comparar listas não distingue "varreu agora" de "varreu antes" —
    # o relógio da varredura não mente. Sem relógio (NM velho/dispositivo
    # sumido): sem espera honesta — a lista volta do cache do jeito que
    # está (nunca presa).
    ndev="$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
        | awk -F: '$2=="wifi" {print $1; exit}')"
    old=""
    [ -n "$ndev" ] && old="$(nmcli -g LAST_SCAN device show "$ndev" 2>/dev/null || true)"
    nmcli device wifi rescan >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 16 ]; do
        sleep 0.5
        [ -n "$ndev" ] || break
        new="$(nmcli -g LAST_SCAN device show "$ndev" 2>/dev/null || true)"
        [ -n "$new" ] || break
        [ "$new" != "$old" ] && break
        i=$((i+1))
    done
    return 0
}

# ── CONECTAR em rede Wi-Fi ──────────────────────────────────────────────────
wifi_connect() {
    ssid="$1"
    sec="$2"
    # rede já salva? sobe pelo NOME — a senha vem do cofre do NM, sem prompt
    if nmcli -g NAME connection show 2>/dev/null | grep -Fxq -- "$ssid"; then
        mlog "Rede: conexão salva '$ssid' — nmcli connection up"
        # v2.10.5 — o stderr do nmcli É O DIAGNÓSTICO (antes: >/dev/null
        # 2>&1 escondia a causa e o aviso jurava 'fora de alcance' até para
        # senha recusada — e a senha NUNCA era pedida de novo).
        err="$(nmcli connection up "$ssid" 2>&1 1>/dev/null)"
        if [ -z "$err" ]; then
            note -t 4000 'Wi-Fi' "Conectado: $ssid"
            return 0
        fi
        mlog "Rede: '$ssid' falhou — stderr: $(printf '%s' "$err" | head -c 200 | tr '\n' ';')"
        case "$err" in
            # v2.10.6 — RECUSA DE AUTORIZAÇÃO ≠ SENHA ERRADA: 'Not authorized
            # to control networking' (polkit) casava '*auth*' do léxico de
            # credencial e o perfil BOM era APAGADO — a rede só voltava
            # re-digitando senha. Autorização negada NÃO apaga nada; o aviso
            # diz o que é (a Rodada 2 da auditoria provou o falso positivo).
            *uthoriz*|*ermission*)
                mlog "Rede: '$ssid' bloqueado por AUTORIZAÇÃO (polkit/permissão) — perfil PRESERVADO"
                note -u normal -t 8000 'Wi-Fi' \
                    "Sem permissão para controlar a rede agora ($ssid) — perfil mantido."
                return 0 ;;
            # credencial recusada (NM fala inglês OU português — os dois
            # léxicos entram: secrets/segredos, auth/autent, senha/password)
            *ecret*|*egredo*|*auth*|*utent*|*802-11*|*enha*|*assword*)
                mlog "Rede: credencial de '$ssid' recusada — perfil apagado, pedindo senha de novo"
                note -u normal -t 6000 'Wi-Fi' "Senha de $ssid recusada — tenta de novo."
                nmcli connection delete "$ssid" >/dev/null 2>&1 || true
                wifi_connect "$ssid" "$sec"   # perfil morto → cai no ramo 'rede nova' e PERGUNTA
                return 0 ;;
            *)
                note -u normal -t 8000 'Wi-Fi' \
                    "Falhou ao conectar em $ssid — rede fora de alcance? Tente de novo."
                return 0 ;;
        esac
    fi
    # rede aberta: direto
    if [ -z "$sec" ]; then
        mlog "Rede: rede aberta '$ssid' — conexão direta"
        if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
            note -t 4000 'Wi-Fi' "Conectado: $ssid"
        else
            note -u normal -t 8000 'Wi-Fi' "Falhou ao conectar em $ssid."
        fi
        return 0
    fi
    # rede nova protegida: o menu pede a senha (prompt visível no fuzzel;
    # a rede salva na próxima vez não pergunta mais)
    mlog "Rede: rede nova protegida '$ssid' — pedindo senha"
    open_menu --title='Senha Wi-Fi' --at=network --ask='Senha' </dev/null
    if [ "$_rc" -ne 0 ]; then
        if benign_close "$_rc"; then return 0; fi
        menu_fail "$_rc"
        return 0
    fi
    pass="$_c"
    [ -n "$pass" ] || return 0
    if nmcli device wifi connect "$ssid" password "$pass" >/dev/null 2>&1; then
        note -t 4000 'Wi-Fi' "Conectado: $ssid"
    else
        note -u normal -t 8000 'Wi-Fi' \
            "Não conectou em $ssid — senha recusada ou rede fora de alcance."
    fi
    return 0
}

# ── as REDES WI-FI ao vivo ──────────────────────────────────────────────────
wifi_menu() {
    while :; do
        : >"$MAP"
        # v6 — --rescan no: o CACHE do NM, SEM varrer (a era v5 varria
        # DENTRO do open e BLOQUEAVA 2–8s na abertura — a lentidão que o
        # dono flagrou). A varredura de fundo engatilhada na central deixa
        # o cache fresco; "Atualizar…" varre e espera EXPLICITAMENTE.
        raw="$(nmcli -g IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan no 2>/dev/null || true)"
        printf '%s\n' "$raw" | awk -F: '
            {
                use = $1; ssid = $2; sig = $3; sec = $4
                gsub(/\\:/, ":", ssid)
                gsub(/\\:/, ":", sec)
                if (ssid == "") next          # rede oculta: não conecta da lista
                row = sprintf("%s%s (%s%%)%s", (use == "*") ? "● " : "   ", \
                              ssid, sig, (sec != "") ? "  🔒" : "")
                print row "\t" ssid "\t" sec
            }' >"$MAP"
        if [ ! -s "$MAP" ]; then
            # cache vazio (1º boot / rádio recém-ligado): o menu NÃO morre —
            # avisa e oferece a varredura DE VERDADE (que espera o resultado)
            note -t 4000 'Rede' 'Sem redes no cache — atualizando…'
            rows='Atualizar…'
        else
            rows="$( { cut -f1 "$MAP"; printf 'Atualizar…'; } )"
        fi
        open_menu --title='Wi-Fi' --at=network <<EOF
$rows
EOF
        if [ "$_rc" -eq 0 ]; then
            [ -n "$_c" ] || return 0
        else
            if benign_close "$_rc"; then return 0; fi
            menu_fail "$_rc"
            return 0
        fi
        case "$_c" in
            'Atualizar…') wifi_rescan; continue ;;
            *)
                ssid="$(awk -F'\t' -v r="$_c" '$1 == r { print $2; exit }' "$MAP")"
                sec="$(awk -F'\t' -v r="$_c" '$1 == r { print $3; exit }' "$MAP")"
                [ -n "$ssid" ] || return 0
                wifi_connect "$ssid" "$sec"
                return 0
                ;;
        esac
    done
}

# ── as CONEXÕES SALVAS (reconectar / desconectar) ───────────────────────────
known_menu() {
    : >"$MAP"
    nmcli -g NAME,TYPE,DEVICE connection show 2>/dev/null | awk -F: '
        $2 == "802-3-ethernet" || $2 == "802-11-wireless" {
            name = $1; type = $2; dev = $3
            gsub(/\\:/, ":", name)
            mark = (dev != "" && dev != "--") ? "● " : "   "
            print mark name "\t" name "\t" type
        }' >"$MAP"
    if [ ! -s "$MAP" ]; then
        note -t 4000 'Rede' 'Nenhuma conexão salva.'
        return 0
    fi
    rows="$(cut -f1 "$MAP")"
    open_menu --title='Conexões' --at=network <<EOF
$rows
EOF
    if [ "$_rc" -eq 0 ]; then
        [ -n "$_c" ] || return 0
    else
        if benign_close "$_rc"; then return 0; fi
        menu_fail "$_rc"
        return 0
    fi
    name="$(awk -F'\t' -v r="$_c" '$1 == r { print $2; exit }' "$MAP")"
    [ -n "$name" ] || return 0
    ctype="$(awk -F'\t' -v r="$_c" '$1 == r { print $3; exit }' "$MAP")"
    known_manage "$name" "$ctype" "$_c"
    return 0
}

# ── VERBOS de uma conexão salva (o pick abre os verbos DELA — v6) ─────────
known_password() {
    # a senha edita DENTRO do menu (nmcli connection modify — o cofre do
    # NM é a fonte); conecta em seguida para provar a senha nova AGORA
    name="$1"
    mlog "Rede: alterando a senha de '$name'"
    open_menu --title='Senha' --at=network --ask='Nova senha' </dev/null
    if [ "$_rc" -ne 0 ]; then
        if benign_close "$_rc"; then return 0; fi
        menu_fail "$_rc"
        return 0
    fi
    pass="$_c"
    [ -n "$pass" ] || return 0
    if nmcli connection modify "$name" 802-11-wireless-security.psk "$pass" >/dev/null 2>&1; then
        if nmcli connection up "$name" >/dev/null 2>&1; then
            note -t 4000 'Rede' "Senha atualizada — conectado: $name"
        else
            note -u normal -t 8000 'Rede' \
                "Senha atualizada em $name — não conectou (rede fora de alcance?)."
        fi
    else
        note -u normal -t 8000 'Rede' \
            "Não deu para alterar a senha de $name (rede corporativa/VPN?)."
    fi
    return 0
}

known_forget() {
    # DESTRUTIVO: um passo de confirmação — o fuzzel filtra por digitação,
    # o mispick é raro, mas apagar rede salva não pode ser acidente
    name="$1"
    mlog "Rede: esquecer '$name'? (confirmação)"
    open_menu --title='Esquecer' --at=network <<EOF
Sim, esquecer $name
Cancelar
EOF
    if [ "$_rc" -ne 0 ]; then
        if benign_close "$_rc"; then return 0; fi
        menu_fail "$_rc"
        return 0
    fi
    # if e não case: SSID com glifo glob (* ?) viraria padrão de case —
    # comparação literal não mente
    if [ "$_c" = "Sim, esquecer $name" ]; then
        if nmcli connection delete "$name" >/dev/null 2>&1; then
            note -t 4000 'Rede' "Esquecida: $name"
        else
            note -u normal -t 8000 'Rede' "Falhou ao esquecer $name."
        fi
    fi
    return 0
}

known_manage() {
    # o pick da conexão salva abre os verbos DELA (estado-aware) — a tela
    # de conexões salvas se gerencia sozinha, SEM menu separado de gestão
    name="$1"
    ctype="$2"
    row="$3"
    case "$row" in
        '● '*) acts='Desconectar' ;;
        *)     acts='Conectar' ;;
    esac
    if [ "$ctype" = "802-11-wireless" ]; then
        acts="${acts}
Alterar senha…"
    fi
    acts="${acts}
Esquecer…"
    open_menu --title='Conexões' --at=network <<EOF
$acts
EOF
    if [ "$_rc" -eq 0 ]; then
        [ -n "$_c" ] || return 0
    else
        if benign_close "$_rc"; then return 0; fi
        menu_fail "$_rc"
        return 0
    fi
    case "$_c" in
        Conectar)
            mlog "Rede: ligando conexão '$name'"
            if nmcli connection up "$name" >/dev/null 2>&1; then
                note -t 4000 'Rede' "Conectado: $name"
            else
                note -u normal -t 8000 'Rede' \
                    "Falhou ao conectar em $name — cabo fora? Wi-Fi desligado?"
            fi ;;
        Desconectar)
            mlog "Rede: desligando conexão '$name'"
            if nmcli connection down "$name" >/dev/null 2>&1; then
                note -t 4000 'Rede' "Desconectado: $name"
            else
                note -u normal -t 8000 'Rede' "Falhou ao desligar $name."
            fi ;;
        'Alterar senha…')
            known_password "$name" ;;
        'Esquecer…')
            known_forget "$name" ;;
    esac
    return 0
}

# ── guardas de ausência (o fallback honesto das eras antigas) ───────────────
if ! command -v nmcli >/dev/null 2>&1; then
    mlog "Rede: nmcli AUSENTE — fallback impala"
    exec foot -e impala
fi
if ! command -v craft-menu >/dev/null 2>&1; then
    mlog "Rede: craft-menu AUSENTE — fallback impala"
    exec foot -e impala
fi

# ── o LOOP principal: cada ação reabre o menu com o estado NOVO ─────────────
# (o menu entra por HEREDOC, nunca por pipeline: função em pipeline roda
# em subshell e perde _c/_rc — e o heredoc expande $rows numa passada só,
# então SSID com $/`/espaço chega INTEIRO ao craft-menu)
mlog "Rede: abrindo central (craft-menu v4, âncora no botão)"
# v6 — a varredura de FUNDO dispara na ABERTURA: enquanto o usuário olha o
# menu principal, o cache do NM já está sendo atualizado (a lista de redes
# abre instantânea do cache, e fresca)
bg_rescan
while :; do
    rows="$(main_rows)"
    open_menu --title='Rede' --at=network <<EOF
$rows
EOF
    if [ "$_rc" -eq 0 ]; then
        [ -n "$_c" ] || exit 0
    else
        if benign_close "$_rc"; then exit 0; fi
        menu_fail "$_rc"
        exit 0
    fi
    case "$_c" in
        'Wi-Fi: ligar')
            mlog "Rede: rádio Wi-Fi ON"
            if nmcli radio wifi on >/dev/null 2>&1; then
                note -t 3000 'Rede' 'Wi-Fi ligado.'
            else
                note -u normal -t 8000 'Rede' 'Falhou ao ligar o Wi-Fi.'
            fi
            continue ;;
        'Wi-Fi: desligar')
            mlog "Rede: rádio Wi-Fi OFF"
            if nmcli radio wifi off >/dev/null 2>&1; then
                note -t 3000 'Rede' 'Wi-Fi desligado.'
            else
                note -u normal -t 8000 'Rede' 'Falhou ao desligar o Wi-Fi.'
            fi
            continue ;;
        'Ligar cabo ('*)
            d="${_c#Ligar cabo (}"
            d="${d%)}"
            mlog "Rede: ligar cabo ($d)"
            if nmcli device connect "$d" >/dev/null 2>&1; then
                note -t 3000 'Rede' "Cabo conectado ($d)."
            else
                note -u normal -t 8000 'Rede' "Falhou ao ligar o cabo ($d)."
            fi
            continue ;;
        'Desligar cabo ('*)
            d="${_c#Desligar cabo (}"
            d="${d%)}"
            mlog "Rede: desligar cabo ($d)"
            if nmcli device disconnect "$d" >/dev/null 2>&1; then
                note -t 3000 'Rede' "Cabo desligado ($d)."
            else
                note -u normal -t 8000 'Rede' "Falhou ao desligar o cabo ($d)."
            fi
            continue ;;
        'Cabo: indisponível ('*)
            # linha informativa (sem cabo na porta) — nada a fazer, o menu
            # reabre com o mesmo estado
            continue ;;
        'Redes Wi-Fi…')
            # v6 — re-engatilha a varredura de fundo por via das dúvidas (o
            # usuário pode ter ficado no menu principal); a lista NÃO espera
            bg_rescan
            wifi_menu
            continue ;;
        'Conexões salvas…')
            known_menu
            continue ;;
        'Bluetooth: dispositivos…')
            # v2.6.0 — o verbo que o dono APROVOU no rig ("o de bluetooth é
            # legal e funcional") segue: blueman-manager (GUI) com o
            # bluetui de fallback
            mlog "Rede: abrindo o gerenciador Bluetooth"
            rm -f "$MAP" "$T1" "$T2"   # v2.10.5: exec pula o trap — limpa na mão
            if command -v blueman-manager >/dev/null 2>&1; then
                exec blueman-manager
            fi
            exec foot -e bluetui ;;
        'Editor de conexões…')
            # a CRIAÇÃO manual de redes mora no gerenciador gráfico do
            # sistema (a definição do próprio dono para o editor)
            mlog "Rede: abrindo o editor de conexões do sistema"
            rm -f "$MAP" "$T1" "$T2"   # v2.10.5: exec pula o trap — limpa na mão
            if command -v nm-connection-editor >/dev/null 2>&1; then
                exec nm-connection-editor
            fi
            exec foot -e nmtui ;;
        *)
            rm -f "$MAP"
            exit 0 ;;
    esac
done
