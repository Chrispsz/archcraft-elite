#!/usr/bin/env bash
# craft-shot — screenshots defensivos (grim + slurp + wl-copy)
# uso: craft-shot area   → região selecionada → clipboard + arquivo
#      craft-shot full   → tela cheia → arquivo
set -euo pipefail
mode="${1:-area}"
for bin in grim wl-copy; do
  command -v "$bin" >/dev/null 2>&1 \
    || { echo "✖ $bin ausente: sudo pacman -S grim wl-clipboard" >&2; exit 1; }
done
dir="$HOME/Pictures"
mkdir -p -- "$dir"
file="$dir/shot-$(date +%Y%m%d-%H%M%S).png"
notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 2000 "Screenshot" "$1" >/dev/null 2>&1 || true
  fi
}
case "$mode" in
  area)
    command -v slurp >/dev/null 2>&1 \
      || { echo "✖ slurp ausente: sudo pacman -S slurp" >&2; exit 1; }
    # E119 — O CANCELAR FALA (o dono no dump 221647: 'se aperto o Esc,
    # também ele tira o screenshot… não tem a forma de cancelar nem
    # nada'): o ESC do slurp morava num silêncio ambíguo — o rc=1 sem
    # saída descia para o grim com geometria vazia e o set -e matava o
    # script SEM NENHUMA voz (o dono não sabia se cancelou ou tirou).
    # Hoje o cancelar é um DESFECHO NOMEADO: notificação na cara, zero
    # arquivo, zero clipboard — 'nada foi salvo' é a resposta visível.
    geometria="$(slurp)" || {
      notify "captura cancelada (Esc) — nada foi salvo"
      echo "captura cancelada (Esc) — nada foi salvo" >&2
      exit 0
    }
    [ -n "$geometria" ] || {
      notify "captura cancelada — nada foi salvo"
      exit 0
    }
    grim -g "$geometria" "$file" && wl-copy < "$file"
    notify "região → clipboard + $file" ;;
  full)
    grim "$file"
    notify "tela cheia → $file" ;;
  *) echo "uso: craft-shot area|full" >&2; exit 1 ;;
esac
