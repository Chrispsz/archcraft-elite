#!/usr/bin/env python3
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-audio-route — roteamento automático de áudio (E30)
# ═══════════════════════════════════════════════════════════════════════════
# O PEDIDO DO DONO (v2.10.17, dump p6aw): "quando conectasse um fone ou
# alguma fonte de saída de áudio ele já mudasse automático" — e o achado
# forense que deu urgência: o sink PADRÃO do rig era o "fifine Microphone
# Estéreo analógico" (o microfone USB expõe um sink fantasma; o som
# "saía pelo microfone" = silêncio real na caixa).
#
# O QUE ELE FAZ (event-driven — zero polling):
#   1. NASCIMENTO: se o default é da classe proibida (microfone/fifine/
#      webcam/"Monitor of"), conserta para o melhor remanescente;
#   2. FONE no MESMO sink (jack com detecção): a PORTA ativa segue a
#      disponibilidade — fone disponível → sai por ele; desconectado →
#      volta para a porta de caixa (pactl set-sink-port);
#   3. SINK NOVO de classe alvo (Bluetooth/USB/DAC de fone ou caixa) →
#      o áudio vai para ele na hora (pactl set-default-sink);
#   4. DEFAULT SUMIU (BT desconectou, USB saiu) → melhor remanescente
#      (fone/headset/caixa > analógico > HDMI — HDMI por último porque
#      monitor acordando não pode roubar o som; classe proibida nunca).
#
# O QUE ELE NÃO FAZ (as fronteiras honestas):
#   · não briga com escolha MANUAL do dono — só age em nascimento de
#     sink, desaparecimento do default e default inválido no arranque;
#   · jack SEM detecção (availability 'unknown') não tem como o software
#     saber — aí o W-a/pavucontrol mandam (limitação de hardware);
#   · não toca em volume, não toca em fontes (microfones).
#
# EVIDÊNCIA no ~/.cache/elite/audio.log (teto 256 KiB) + toast discreto
# em cada troca (o feedback necessário: som mudou de lugar SEM clique).
# Supervisão: craft-bars (morreu, volta em ≤5s — a lei da família).
# ═══════════════════════════════════════════════════════════════════════════
import json
import os
import re
import subprocess
import time

LOGDIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "elite")
LOG = os.path.join(LOGDIR, "audio.log")

# classes: 'bad' (nunca default) · 'target' (ganha quando nasce) ·
# 'ok' (analógico de verdade) · 'hdmi' (por último — monitor não rouba som)
# E36 — 'microphone' EN entra: o réu original era a MARCA (fifine) e um
# 'USB Microphone' genérico escapava e podia virar default — a reincidência
# exata da doença p6aw por outro nome (o ALSA/PipeWire nomeia em EN).
BAD_RE = re.compile(r"microfone|microphone|\bmic\b|fifine|webcam|c[âa]mera|monitor of", re.I)
HDMI_RE = re.compile(r"hdmi|displayport", re.I)
WIRE_RE = re.compile(r"headphone|headset|fone", re.I)
GOOD_FF = ("headphone", "headset", "speaker", "hands-free")
RANK = {"target": 0, "ok": 1, "hdmi": 2}


def log(msg):
    try:
        os.makedirs(LOGDIR, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 262144:
            open(LOG, "w").close()
        with open(LOG, "a") as f:
            f.write("[%s] %s\n" % (time.strftime("%F %T"), msg))
    except Exception:
        pass


def notify(title, body):
    try:
        subprocess.Popen(
            ["notify-send", "-a", "Elite", "-u", "low", "-t", "3000", title, body],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def run(args, timeout=10):
    return subprocess.run(args, capture_output=True, text=True,
                          timeout=timeout).stdout


def wait_audio():
    # o pipewire-pulse da sessão pode nascer depois do autostart — espera
    # sem teto (um sleep de 2s enquanto não há som é o custo do acerto)
    while True:
        try:
            subprocess.run(["pactl", "info"], capture_output=True,
                           timeout=10, check=True)
            return
        except Exception:
            time.sleep(2)


def list_sinks():
    try:
        data = json.loads(run(["pactl", "-f", "json", "list", "sinks"]))
    except Exception:
        return []
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        return list(data.values())
    return []


def default_sink():
    try:
        return run(["pactl", "get-default-sink"]).strip()
    except Exception:
        return ""


# E132 — O AUTO_NULL PRESO NO WIREPLUMBER (a ordem do dono, dump
# pós-1.0-78: o wpctl fotografou 'Default Configured Devices: 0.
# Audio/Sink auto_null' COM placa física viva — o pactl via um default
# runtime escolhido à moda, mas o CONFIGURADO (o que sobrevive ao
# próximo plug/boot) era NENHUM: a sessão renascia sem escolha). A cura
# lê o status do WirePlumber e devolve o sink CONFIGURADO: 'auto_null'
# aqui = a doença, mesmo com o runtime aparentando saúde.
def configured_default_sink():
    try:
        out = run(["wpctl", "status"], timeout=10)
    except Exception:
        return ""
    m = re.search(r"Default Configured Devices:(.*?)(?:\n\s*\n|\Z)",
                  out, re.S)
    if not m:
        return ""
    line = re.search(r"Audio/Sink\s+([^\n]+)", m.group(1))
    if not line:
        return ""
    # '0. alsa_output.pci-… (HD Audio…)' → o NOME do node (índice e nick fora)
    val = re.sub(r"^\d+\.\s*", "", line.group(1).strip())
    return val.split("(")[0].strip()


def classify(sink):
    props = sink.get("properties") or {}
    desc = "%s %s" % (sink.get("description", ""), sink.get("name", ""))
    ff = str(props.get("device.form_factor", "")).lower()
    bus = str(props.get("device.bus", "")).lower()
    prof = str(props.get("device.profile.name", "")).lower()
    if BAD_RE.search(desc):
        return "bad"
    if ff in GOOD_FF or bus == "bluetooth":
        return "target"
    if "hdmi" in prof or HDMI_RE.search(desc):
        return "hdmi"
    return "ok"


def ports_of(sink):
    out = []
    for p in sink.get("ports") or []:
        out.append((str(p.get("name", "")), str(p.get("description", "")),
                    str(p.get("availability", "")).lower()))
    return out


def choose(sinks):
    cands = sorted((s for s in sinks if classify(s) != "bad"),
                   key=lambda s: RANK.get(classify(s), 3))
    return cands[0] if cands else None


# E140 — O MARCADOR DO HDMI DELIBERADO: a ordem do dono do dossiê é a
# analógica PRIORITÁRIA sobre o HDMI sem som; o dono que de VERDADE
# quiser o som no monitor cria ~/.config/elite/audio-hdmi-ok (toque
# vazio) e a casa respeita a escolha para sempre.
HDMI_OK = os.path.expanduser("~/.config/elite/audio-hdmi-ok")


def switch_to(sink, reason):
    name = sink.get("name", "")
    if not name or name == default_sink():
        return
    try:
        if subprocess.run(["pactl", "set-default-sink", name],
                          capture_output=True, timeout=10).returncode == 0:
            log("TROCA (%s) → %s" % (reason, sink.get("description", name)))
            notify("Áudio", "Saída: %s" % sink.get("description", name))
            # E140 — O PISO DO VOLUME: a analógica do dump nascia
            # 'vol: 0.00' (nunca usada, nunca mexida) e o dono ficava
            # sem som MESMO com a troca certa; quem chega ao trono com
            # zero ganha voz (40%) — a lição do craft-audio E138: o
            # '45%' do pactl vem com sufixo, o juízo mastiga os DOIS
            # formatos (float cru OU percentual com %)
            vol = (sink.get("volume") or {}).get("front-left") or {}
            try:
                v = float(str(vol.get("value", "1")).rstrip("%"))
            except Exception:
                v = 1.0
            if v <= 0.001:
                try:
                    rc = subprocess.run(
                        ["pactl", "set-sink-volume", name, "40%"],
                        capture_output=True, timeout=10).returncode
                    if rc == 0:
                        log("VOLUME 0 → 40%% (%s — o piso da voz, E140)"
                            % sink.get("description", name))
                    else:
                        log("FALHA set-sink-volume 40%% %s (rc=%d)" % (name, rc))
                except Exception as e:
                    log("FALHA set-sink-volume %s: %s" % (name, e))
        else:
            log("FALHA set-default-sink %s (%s)" % (name, reason))
    except Exception as e:
        log("FALHA set-default-sink %s: %s" % (name, e))


def manage_ports(sink):
    # fone no MESMO sink (jack com detecção): porta segue a disponibilidade
    name = sink.get("name", "")
    if not name:
        return
    ports = ports_of(sink)
    if not ports:
        return
    active = str(sink.get("active_port") or "")
    hp = [p for p in ports
          if WIRE_RE.search(p[1]) or WIRE_RE.search(p[0])]
    if not hp:
        return
    avail = [p for p in hp if p[2] == "yes"]
    if avail and active != avail[0][0]:
        try:
            if subprocess.run(["pactl", "set-sink-port", name, avail[0][0]],
                              capture_output=True, timeout=10).returncode == 0:
                log("PORTA (%s) → %s" % (sink.get("description", ""),
                                         avail[0][1] or avail[0][0]))
                notify("Áudio", "Fone: %s" % (avail[0][1] or avail[0][0]))
        except Exception as e:
            log("FALHA set-sink-port %s: %s" % (name, e))
    elif not avail and active and WIRE_RE.search(active):
        # fone saiu e a porta ativa era a dele — volta pra 1ª disponível;
        # o rc é CHECADO (a escola E33: log que anuncia ação sem conferir o
        # pactl mente na falha — o sink pode sumir entre a lista e o set)
        other = [p for p in ports if p[2] == "yes"
                 and not WIRE_RE.search(p[1]) and not WIRE_RE.search(p[0])]
        if other:
            try:
                if subprocess.run(["pactl", "set-sink-port", name, other[0][0]],
                                  capture_output=True, timeout=10).returncode == 0:
                    log("PORTA (fone saiu) → %s" % (other[0][1] or other[0][0]))
                else:
                    log("FALHA set-sink-port (unplug) %s: rc != 0" % name)
            except Exception as e:
                log("FALHA set-sink-port (unplug) %s: %s" % (name, e))


def evaluate(prev_names, trigger):
    sinks = list_sinks()
    if not sinks:
        return prev_names
    names = {s.get("name", "") for s in sinks}
    dflt = default_sink()
    d = next((s for s in sinks if s.get("name") == dflt), None)

    # E132 — O AUTO_NULL PRESO: o default CONFIGURADO do WirePlumber em
    # nenhum (auto_null) com placa viva = a escolha persistente não
    # existe; o set-default-sink por BAIXO reescreve o configurado (o
    # WirePlumber implementa a porta PulseAudio e PERSISTE nela) — o
    # boot seguinte nasce com a escolha da casa, não com a sorte.
    conf_bad = (dflt == "auto_null" or dflt.startswith("auto_null")
                or configured_default_sink() == "auto_null")
    if conf_bad and d is not None:
        # o runtime já aponta para um sink válido: SÓ reafirma o
        # CONFIGURADO (o switch_to pularia — o nome é o mesmo)
        try:
            if subprocess.run(["pactl", "set-default-sink", d.get("name", "")],
                              capture_output=True, timeout=10).returncode == 0:
                log("AUTO_NULL (%s) → configurado reafirmado: %s"
                    % ("runtime" if dflt.startswith("auto_null") else "WirePlumber",
                       d.get("description", d.get("name", ""))))
        except Exception as e:
            log("FALHA reafirmar default contra auto_null: %s" % e)
        return names

    # 1) o default sumiu (BT desconectou, USB saiu) → melhor remanescente
    if d is None:
        best = choose(sinks)
        if best:
            switch_to(best, "saída sumiu")
        return names

    manage_ports(d)   # o jack do sink atual segue a disponibilidade

    # 2) sink NOVO de classe alvo (fone/BT/USB) → o som vai para ele
    if trigger != "start":
        arrived = names - prev_names
        for s in sinks:
            if s.get("name") in arrived and classify(s) == "target":
                switch_to(s, "conectado")
                return names

    # 3) default na classe proibida (o sink-fantasma do microfone) → cura
    if classify(d) == "bad":
        best = choose(sinks)
        if best and best.get("name") != dflt:
            switch_to(best, "saída inválida")
        return names
    # 3.5) E140 — O HDMI SEM SOM CEDE (a ordem do dono, dossiê 1.0-88: o
    # dump fotografou o default NO HDMI 'Navi 31' do monitor com a
    # analógica Starship/Matisse em vol 0.00 — o monitor sem caixa de
    # som roubava o áudio da mesa e o dono ficava mudo; a regra antiga
    # só curava a classe 'bad', o HDMI default era ACEITO como estado
    # legítimo). Agora: HDMI default + sink melhor (fone/analógico)
    # existente = TROCA — salvo o marcador audio-hdmi-ok do dono que
    # QUER o monitor (a escolha dele é a lei, a casa só não deixa a
    # sorte decidir no boot)
    if classify(d) == "hdmi" and not os.path.exists(HDMI_OK):
        best = choose(sinks)
        if best and best.get("name") != dflt:
            switch_to(best, "HDMI sem som — a analógica tem prioridade (E140)")
    return names


def main():
    log("daemon iniciado (pid %d)" % os.getpid())
    wait_audio()
    prev = evaluate(set(), "start")
    while True:
        try:
            proc = subprocess.Popen(["pactl", "subscribe"],
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
        except Exception as e:
            log("pactl subscribe indisponível (%s) — retry em 5s" % e)
            time.sleep(5)
            continue
        try:
            for line in proc.stdout:
                low = line.lower()
                if "sink" not in low and "card" not in low and "server" not in low:
                    continue
                # debounce: a enxurrada de eventos do plug assenta primeiro
                time.sleep(0.4)
                prev = evaluate(prev, "event")
        except Exception as e:
            log("loop: %s" % e)
        finally:
            try:
                proc.kill()
            except Exception:
                pass
        # subscribe morreu (pipewire reiniciou) — recomeça, o estado volta
        # a ser avaliado no primeiro evento útil
        time.sleep(2)


if __name__ == "__main__":
    # E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
    import sys as _sys  # local: o daemon nunca precisa do sys; só o help
    if len(_sys.argv) > 1 and _sys.argv[1] in ("-h", "--help", "uso"):
        print(
            "uso: craft-audio-route — roteamento automático de áudio\n"
            "     (disparo por evento do elite-daemon; sem argumentos =\n"
            "     daemon legado da era residente)\n"
            "\n"
            "  fone pluga → som troca de porta; sink novo (BT/USB/DAC) vira o\n"
            "  default na hora; default morre → melhor remanescente (a classe\n"
            "  microfone/webcam é PROIBIDA de ser default — o sink fantasma do\n"
            "  dump p6aw). Não briga com escolha MANUAL do dono.\n"
            "\n"
            "  --once        UM evento de som (netlink): só QUEM CHEGOU vira\n"
            "                default (o snapshot de conhecidos separa o novo\n"
            "                do velho — E139)\n"
            "  --sleep-save  a FOTO pré-sono do default (o daemon chama no\n"
            "                PrepareForSleep(true), com colheita e teto)\n"
            "  --resume      o PÓS-SONO: o default de antes volta se o HDMI/DP\n"
            "                do monitor sequestrou o som no wake (E139)\n"
            "\n"
            "  a prova das TROCAS mora em ~/.cache/elite/audio.log; os\n"
            "  snapshots de sessão em $XDG_RUNTIME_DIR/elite/."
        )
        _sys.exit(0)
    # E135 — O DISPARO ÚNICO: o elite-daemon session chama este modo a
    # CADA evento de som do netlink (hotplug de fone/BT/DAC/jack) — o
    # roteamento é POR EVENTO e o python deixa de ser RESIDENTE (a
    # ordem do dono do dump 101339: zero python3 residente na sessão;
    # o daemon de roteamento residente morre, a LEI de roteamento é a
    # MESMA — o evaluate() é o cérebro e fica 1:1).
    if len(_sys.argv) > 1 and _sys.argv[1] == "--once":
        # E139 — O SNAPSHOT DE CONHECIDOS: sem ele, TODO --once via
        # prev=vazio → "chegou" era TODO MUNDO e o 1º sink target
        # (fone/BT) roubava o default MESMO sem chegar (a escolha
        # MANUAL do dono pisada a cada evento — a fronteira honesta do
        # "não briga com a mão do dono"). Agora só QUEM CHEGOU vira.
        log("once: roteamento por evento (E135/E139 — o residente morreu, o snapshot decide quem CHEGOU)")
        wait_audio()
        prev = load_set(KNOWN)
        names = evaluate(prev, "event" if prev else "once")
        if names:
            save_set(KNOWN, names)
        _sys.exit(0)
    # E139 — A FOTO PRÉ-SONO (o daemon chama com colheita e teto de 3s:
    # o freeze vem aí — o pactl responde em ms quando o PipeWire vive;
    # um filho congelado escreveria DEPOIS o default JÁ sequestrado)
    if len(_sys.argv) > 1 and _sys.argv[1] == "--sleep-save":
        d = default_sink()
        if d:
            try:
                os.makedirs(RUN_DIR, exist_ok=True)
                with open(PRE_SLEEP, "w") as f:
                    f.write(d + "\n")
                log("sleep-save: default pré-sono = %s (a foto para o resume)" % d)
            except OSError as e:
                log("FALHA sleep-save (%s): %s" % (PRE_SLEEP, e))
        else:
            log("sleep-save: sem default vivo — o resume decide pela lei (HDMI por último)")
        _sys.exit(0)
    # E139 — O PÓS-SONO ANTI-SEQUESTRO: o monitor HDMI/DP que re-registra
    # no wake vira default calado (DPMS/S3 → o som "mudou sozinho"). O
    # default de ANTES volta se ainda existe; o que se foi cai na LEI
    # (melhor remanescente, HDMI por último — nunca o sequestrador).
    if len(_sys.argv) > 1 and _sys.argv[1] == "--resume":
        pre = ""
        try:
            with open(PRE_SLEEP) as f:
                pre = f.read().strip()
        except OSError:
            pre = ""
        wait_audio()
        sinks = list_sinks()
        names = {s.get("name", "") for s in sinks}
        cur = default_sink()
        if pre and cur and pre != cur and pre in names:
            try:
                if subprocess.run(["pactl", "set-default-sink", pre],
                                  capture_output=True, timeout=10).returncode == 0:
                    log("RESUME: default devolvido → %s (o HDMI/DP do monitor não rouba o som pós-sono — E139)" % pre)
                    notify("Áudio", "Saída restaurada após o sono")
                else:
                    log("FALHA resume set-default-sink %s" % pre)
            except Exception as e:
                log("FALHA resume set-default-sink %s: %s" % (pre, e))
        elif pre and cur and pre != cur and pre not in names:
            log("resume: o default pré-sono (%s) não voltou do sono — a LEI decide (HDMI por último)" % pre)
            evaluate(load_set(KNOWN), "start")
        else:
            log("resume: default intacto (%s) — nada a restaurar" % (cur or "?"))
        if names:
            save_set(KNOWN, names)
        _sys.exit(0)
    main()
