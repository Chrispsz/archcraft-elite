#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-display (E89 — A TELA QUE LEMBRA)
# ═══════════════════════════════════════════════════════════════════════════
# O RELATO DO DONO (07/nov): "o sistema não tem uma persistência, por
#   exemplo, da resolução, dos hertz… Eu coloco 200 hertz e toda vez que eu
#   reinicio o PC tem que estar colocando os 200 hertz na minha tela porque
#   ele some". O réu é a FÍSICA do Wayland, não o monitor: o modo é
#   propriedade do COMPOSITOR em RAM — o wdisplays (e o wlr-randr) aplicam
#   na hora e MORREM sem memória; nenhum componente da casa gravava a
#   escolha, e o labwc nasce no modo preferido do EDID (a resolução "vai",
#   os hertz somem — exatamente o sintoma).
#
# A CURA (três braços, um conf):
#   · apply  — o AUTOSTART chama: espera os outputs de pé (o wlr-randr
#     falha nos primeiros instantes da sessão) e aplica o que está salvo
#     em ~/.config/elite/displays.conf — o 200 Hz nasce aplicado, sem
#     clique nenhum.
#   · watch  — vigia a sessão: o estado atual do wlr-randr que DIFERIR do
#     conf e SE ESTABILIZAR (2 leituras seguidas iguais = não é ruído de
#     arranque) é a escolha do dono por QUALQUER porta (wdisplays, menu
#     daqui, wlr-randr CLI) — grava sozinho. A persistência deixa de
#     depender de lembrar de salvar.
#   · menu   — o craft-display NU (o item "Telas…" do menu do desktop):
#     fuzzel com TODOS os modos que o EDID do monitor oferece — "deveria
#     ser todas as detectadas… ou então esse menu fosse bem pensado"
#     (relato do dono) — aplica E grava no mesmo clique. A porta gráfica
#     avançada (wdisplays) segue a um item de distância.
#
# FORMATO DO CONF (~/.config/elite/displays.conf — 1 linha por output):
#   NOME|mode:LARGURAxA@TAXA|pos:X,Y|scale:S|transform:T|adaptive:estado
#   (campos ausentes = o labwc manda — o conf só fala o que o dono escolheu)
#
# LEIS DA CASA: log em ~/.cache/elite/display.log (teto 256 KiB — família
# E36); notify em falha (nada morre calado para quem está na tela); o
# watch NUNCA briga com o apply (começa DEPOIS dele e o primeiro estado
# igual ao conf não é "mudança").
#
# E105 — O STAMP NÃO É FÉ: conf ≠ realidade estável por ~30s = o arranjo
#   salvo REAPLICA (o mode1 reset do amdgpu no resume devolvia o rig a
#   60 Hz com o conf salvo em 200 Hz e o stamp mandava calar).
#
# E106 — O STAMP HONESTO: o stamp só é escrito DEPOIS do feito (ok /
#   fail:N) e o fail re-tenta com teto de 6 (o link DP frio treina na
#   2ª-3ª tentativa; depois de 6, silêncio sem spam).
#
# E107 — AS TRÊS CARGAS DO DUMP 200537 (o dono: "ele sempre volta para
#   60 hertz… você tá salvando lixo no meu PC"):
#   1. O ECO MENTIROSO (E33): o do_apply anunciava 'RE-TENTANDO (1/6)' e
#      chamava a aplicadora, que carregava o SEU próprio guarda de stamp
#      (a gramática anti-duplo E96) — o guarda via 'fail:1', respondia
#      'nada a fazer' e matava o SCRIPT INTEIRO com exit 0: o contador
#      congelava em 1/6 PARA SEMPRE (o log do dump: o par de linhas no
#      MESMO segundo, de 5 em 5s, e o rig a 60 Hz desde o boot). O retry
#      era teatro. CURA: a aplicadora é PURA (não lê stamp nenhum —
#      só espera os outputs e aplica); a máquina de estados mora SÓ no
#      do_apply e o contador ANDA de verdade (fail:1 → fail:2 → …).
#   2. O SAVE DE LIXO: no meio de uma troca de modo o wlr-randr some com
#      a marca '(current)' e o parser devolve 'mode:-' — a v2.11.4
#      GRAVOU isso: o displays.conf do rig amanheceu com um traço no
#      lugar do 200 Hz (19:57:08, um minuto após o boot) e o apply pula
#      campo traço por desenho: a escolha saiu do disco PARA SEMPRE.
#      CURA: o save RECUSA estado sem marca de modo atual (espera a
#      marca assentar até 5s; não vem = recusa com a prova no papel —
#      nada de lixo no conf) e o watch NÃO conta transição como
#      estabilidade.
#   3. O ENVENENAMENTO DO BOOT: o watch gravava o DEFAULT DO BOOT (60
#      Hz) como se fosse escolha do dono antes do apply da sessão
#      assentar. CURA: o watch só grava com o apply desta sessão
#      assentado (stamp ok) — o conf salvo é a fonte da verdade até o
#      arranjo de pé; a escolha explícita do MENU grava sempre (é a mão
#      do dono, com o stamp ok nela).
# ═══════════════════════════════════════════════════════════════════════════
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/elite"
CONF="$CONF_DIR/displays.conf"
DLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/display.log"
RANDR="${ELITE_RANDR:-wlr-randr}"
RUN_E="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 0)}/elite"
STAMP="$RUN_E/display-applied"
DIVERGE="$RUN_E/display-diverge"

dlog() {
    mkdir -p "${DLOG%/*}" 2>/dev/null || true
    if [ -f "$DLOG" ] && [ "$(wc -c <"$DLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$DLOG" > "$DLOG.tmp" 2>/dev/null && mv -f "$DLOG.tmp" "$DLOG"
    fi
    if ! printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$DLOG" 2>/dev/null; then
        # E106 — a mesma honestidade do ilog do craft-idle: papel que não
        # aceita escrita não é mais silêncio (tmpfs sempre gravável).
        printf '[%s] dlog FALHOU (%s): %s\n' "$(date '+%F %T')" "$DLOG" "$*" \
            >>"${XDG_RUNTIME_DIR:-/tmp}/elite/display-write-fail" 2>/dev/null || true
    fi
    return 0
}
dnotify() {
    command -v notify-send >/dev/null 2>&1 && \
        timeout 5 notify-send -a 'Elite' -u normal -t 6000 'Displays' "$1" || true
    return 0
}

# ── O PARSER do wlr-randr (a única leitura de verdade da casa) ───────────
# Lê o stdout do $RANDR e imprime, POR output, uma linha canônica:
#   NOME|mode:LxA@T|pos:X,Y|scale:S|transform:T|adaptive:ESTADO
# Duas gerações de formato cobertas: o "Current mode:" da 0.4 e a marca
# "(current)" na lista de modos da 0.5 (a do rig).
parse_state() {
    "$RANDR" 2>/dev/null | awk '
        function flush() {
            if (name != "" && enabled == "yes") {
                if (cur == "") cur="-"
                if (pos == "") pos="-"
                if (scale == "") scale="-"
                if (tr == "") tr="normal"
                if (adap == "") adap="disabled"
                printf "%s|mode:%s|pos:%s|scale:%s|transform:%s|adaptive:%s\n",
                       name, cur, pos, scale, tr, adap
            }
        }
        # a impressão é no FIM do bloco de cada output (a marca "(current)"
        # da 0.5 vem DEPOIS da lista — imprimir na Adaptive Sync perderia)
        /^[A-Za-z0-9-]+[ \t]+"/ {
            flush()
            name=$1
            enabled=""; cur=""; pos=""; scale=""; tr=""; adap=""
        }
        /Enabled:/    { enabled=$2 }
        /Current mode:/ {
            for (i=1;i<=NF;i++) {
                if ($i ~ /^[0-9]+x[0-9]+$/) cur=$i
                if ($i ~ /^[0-9.]+$/ && $(i+1)=="Hz") cur=cur"@"$i
            }
        }
        /Position:/   { pos=$2 }
        /Transform:/  { tr=$2 }
        /Scale:/      { scale=$2 }
        /Adaptive Sync:/ { adap=$NF }
        /^[ \t]+[0-9]+x[0-9]+ px,/ {
            if (index($0, "(current)") > 0) {
                m=$1; r=""
                for (i=2;i<=NF;i++) if ($i ~ /^[0-9.]+$/) r=$i
                cur=m"@"r
            }
        }
        END { flush() }
    '
}

# conf_hash — a impressão digital do conf (a mesma linha canônica, sem
# comentários/linhas vazias — o watch compara ESTADO com CONF, não ruído)
conf_keys() {
    grep -v '^[[:space:]]*#' "$CONF" 2>/dev/null | grep -v '^[[:space:]]*$' | sort
}
state_keys() {
    parse_state | sort
}

# E107 — a TRANSIÇÃO não é escolha: no meio de uma troca de modo o
# wlr-randr some com a marca '(current)' e o parse devolve 'mode:-'. Essa
# leitura NÃO é a vontade do dono — nem o save grava, nem o watch conta
# estabilidade sobre ela.
modo_em_curso() {
    state_keys | grep -q 'mode:-|'
}

# E106 — o MARCO DO RESUME (a fronteira entre ESCOLHA e REVERSÃO): o
# hook elite-resume-display (root, system-sleep) toca ESTE arquivo no
# pós-sono. O watch e o reconcile leem a idade: reversão do driver no
# resume NÃO é escolha — não grava e não re-aplica sob o wake instável.
RESUME_MARK="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 0)}/elite/display-resume"
resume_fresco() {
    [ -r "$RESUME_MARK" ] || return 1
    _m="$(stat -c %Y "$RESUME_MARK" 2>/dev/null || echo 0)"
    [ "$(($(date +%s) - _m))" -lt 45 ]
}

# ── apply: o braço PURO (só aplica o conf; o stamp é do do_apply) ────────
aplica_arranjo() {
    # E107 — O APLICADOR PURO: a v2.11.4 carregava DUAS gramáticas de
    # stamp no mesmo corpo (o guarda anti-duplo E96 DENTRO da aplicadora
    # + o retry E106 FORA) — o retry anunciava 'RE-TENTANDO' e a
    # aplicadora respondia 'nada a fazer' e matava o processo inteiro
    # com exit 0: o contador congelava em 1/6 para sempre (o eco duplo
    # no log do dump 200537, o rig a 60 Hz desde o boot). Agora ela NÃO
    # LÊ stamp nenhum: espera os outputs e aplica; ok/fail:N é decisão
    # do do_apply, DEPOIS do feito.
    [ -s "$CONF" ] || { dlog "apply: sem conf salvo — nada a aplicar (o monitor manda o preferido do EDID)"; return 0; }
    # a espera: o compositor precisa dos outputs de pé para o wlr-randr
    # responder (o autostart roda antes da primeira frame às vezes)
    i=0
    while [ "$i" -lt 30 ]; do
        out="$("$RANDR" 2>/dev/null)" && [ -n "$out" ] && break
        sleep 0.5
        i=$((i + 1))
    done
    if [ "$i" -ge 30 ]; then
        dlog "FALHA: wlr-randr não respondeu em 15s — apply abortado (o conf fica salvo; o retry do heartbeat tenta de novo)"
        return 1
    fi
    vivos="$(parse_state | cut -d'|' -f1)"
    aplicados=0
    falhas=0
    while IFS= read -r linha; do
        case "$linha" in ''|'#'*) continue ;; esac
        nome="${linha%%|*}"
        # vivo? (o grep -qx casa a LINHA exata — o output sumiu = pulado,
        # o conf fica para a volta dele)
        if ! printf '%s\n' "$vivos" | grep -qx "$nome"; then
            dlog "apply: $nome não está presente agora — pulado (o conf fica)"
            continue
        fi
        args=""
        campo=""
        rest="${linha#*|}"
        resto="$rest"
        while [ -n "$resto" ]; do
            campo="${resto%%|*}"
            resto="${resto#*|}"
            [ "$campo" = "$resto" ] && resto=""
            case "$campo" in
                mode:*)
                    modo="${campo#mode:}"
                    [ "$modo" = "-" ] && continue
                    # E96 — a string salva INTEIRA (WxH@TAXA, 6 casas do
                    # float do EDID): sem reformat %.3f (viagem de ida e
                    # volta que podia cair no mHz vizinho) e sem sufixo
                    # Hz (o parse_mode do wlr-randr antigo exigia número
                    # puro). O que o EDID imprimiu é o que volta.
                    args="$args --mode $modo"
                    ;;
                pos:*)      [ "${campo#pos:}" != "-" ] && args="$args --pos ${campo#pos:}" ;;
                scale:*)    [ "${campo#scale:}" != "-" ] && args="$args --scale-exact ${campo#scale:}" ;;
                transform:*) [ "${campo#transform:}" != "normal" ] && args="$args --transform ${campo#transform:}" ;;
                adaptive:*)
                    case "${campo#adaptive:}" in
                        enabled)  args="$args --adaptive-sync on" ;;
                        disabled) args="$args --adaptive-sync off" ;;
                    esac ;;
            esac
            [ "$campo" = "${linha##*|}" ] && break
        done
        if [ -z "$args" ]; then
            continue
        fi
        if "$RANDR" --output "$nome" $args >/dev/null 2>&1; then
            dlog "apply: $nome$args — OK"
            aplicados=$((aplicados + 1))
        else
            dlog "FALHA: apply $nome$args — o modo pode não existir mais neste EDID (o monitor manda)"
            falhas=$((falhas + 1))
        fi
    done < "$CONF"
    dlog "apply: fim ($aplicados aplicado(s), $falhas falha(s))"
    if [ "$falhas" -gt 0 ]; then
        dnotify "Modo salvo não pôde ser aplicado em $falhas tela(s) — log: ~/.cache/elite/display.log"
        return 1
    fi
    return 0
}

do_apply() {
    # E107 — A MÁQUINA DE ESTADOS ÚNICA (a casa do stamp): o E96
    # (anti-duplo: autostart e supervisor podem AMBOS chamar — o ok é a
    # fé do heartbeat), o E105 (reconcile: o reset do driver no resume
    # não vence o conf) e o E106 (o fail re-tenta com teto) moram TODOS
    # aqui — e SÓ aqui. Quem escreve o stamp é este corpo, DEPOIS do
    # feito: ok no sucesso, fail:N+1 na falha (o contador ANDA — a
    # v2.11.4 relia um stamp vazio e eternizava fail:1).
    mkdir -p "${STAMP%/*}" 2>/dev/null || true
    if [ ! -s "$CONF" ]; then
        rm -f "$STAMP" "$DIVERGE" 2>/dev/null || true
        exit 0   # sem conf = nada a aplicar (o monitor manda o EDID; silêncio — heartbeat)
    fi
    n_fail=0
    estado_stamp=""
    if [ -f "$STAMP" ] && [ -s "$STAMP" ]; then
        estado_stamp="$(cat "$STAMP" 2>/dev/null || true)"
    fi
    case "$estado_stamp" in
        ok)
            # E105 — O RECONCILIE (o mode1 reset do amdgpu no resume
            # devolvia o rig a 60 Hz com o conf em 200 Hz): conf ≠
            # realidade estável por ~30s = o arranjo salvo volta.
            vivos="$(state_keys)"
            divergente=0
            while IFS= read -r linha; do
                case "$linha" in ''|'#'*) continue ;; esac
                if ! printf '%s\n' "$vivos" | grep -Fxq "$linha"; then
                    divergente=1
                    break
                fi
            done < "$CONF"
            if [ "$divergente" -eq 0 ]; then
                rm -f "$DIVERGE" 2>/dev/null || true
                exit 0   # confere — no-op silencioso (o heartbeat de 5s)
            fi
            if resume_fresco; then
                dlog "apply: realidade diverge do conf DURANTE o resume (marca fresca) — a reversão do driver não é escolha; o reconcile aguarda o assentar"
                exit 0
            fi
            n_div=$(( $(cat "$DIVERGE" 2>/dev/null || echo 0) + 1 ))
            printf '%s\n' "$n_div" > "$DIVERGE" 2>/dev/null || true
            if [ "$n_div" -lt 6 ]; then
                dlog "apply: realidade diverge do conf salvo (tick $n_div/6) — esperando a estabilidade (a escolha do dono pode estar a caminho)"
                exit 0
            fi
            dlog "apply: realidade ≠ conf salvo há ~30s — REAPLICANDO o arranjo do dono (resume/replug?)"
            rm -f "$DIVERGE" 2>/dev/null || true
            # cai no apply real abaixo (o stamp ok renasce do feito)
            ;;
        fail:*)
            # E106 — O RETRY COM TETO (a ferida que muteava a sessão:
            # fail era terminal na v2.6). Até 6 falhas seguidas o apply
            # re-tenta a cada heartbeat (o link DP frio treina na 2ª-3ª
            # tentativa); depois de 6 = silêncio honesto (o papel tem as
            # 6 provas; o menu à mão grava o conf e recomeça o ciclo).
            # E107 — o retry agora RETENTA DE VERDADE (a aplicadora pura
            # não recusa mais; o contador caminha para o teto).
            n_fail="${estado_stamp#fail:}"
            case "$n_fail" in ''|*[!0-9]*) n_fail=1 ;; esac
            if [ "$n_fail" -ge 6 ]; then
                exit 0
            fi
            if resume_fresco; then
                exit 0   # o wake ainda está assentando — o retry espera
            fi
            dlog "apply: tentativa anterior falhou ($n_fail/6) — RE-TENTANDO (o stamp honesto re-tenta; a v2.11.4 congelava em 1/6 com o eco duplo)"
            ;;
        *)
            # stamp vazio/lixo (a era v2.6 do 'sucesso antecipado') =
            # em curso: o apply corre de novo (quem nasceu por último
            # vence — a escola E64)
            ;;
    esac

    if aplica_arranjo; then
        printf 'ok\n' > "$STAMP" 2>/dev/null || true
        rm -f "$DIVERGE" 2>/dev/null || true
    else
        n_fail=$((n_fail + 1))
        [ "$n_fail" -ge 1 ] || n_fail=1
        printf 'fail:%s\n' "$n_fail" > "$STAMP" 2>/dev/null || true
    fi
    exit 0
}

# ── save: fotografa o AGORA para o conf (SEM lixo de transição) ───────────
do_save() {
    estado="$(state_keys)"
    if [ -z "$estado" ]; then
        dlog "FALHA: save sem estado do wlr-randr (sessão sem outputs?)"
        dnotify "Não consegui ler as telas agora — nada salvo"
        return 1
    fi
    # E107 — A GUARDA CONTRA O LIXO: o displays.conf do rig do dono
    # amanheceu com 'mode:-' (um traço no lugar do 200 Hz — gravado no
    # meio de uma troca de modo, quando a marca '(current)' some do
    # wlr-randr). O apply pula campo traço por desenho: o 200 Hz saiu
    # do disco para sempre ('tá salvando lixo', na letra do dono).
    # Estado sem marca de modo atual NÃO entra no conf — espera a marca
    # assentar (até 5s); não vem, recusa com a prova no papel.
    i=0
    while [ "$i" -lt 5 ] && modo_em_curso; do
        sleep 1
        i=$((i + 1))
    done
    if modo_em_curso; then
        dlog "save: RECUSADO — modo em transição sem a marca de atual (o parser não viu o '(current)' em 5s; nada de lixo no conf)"
        dnotify "A tela ainda está trocando de modo — o registro assenta sozinho quando ela parar"
        return 1
    fi
    estado="$(state_keys)"
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    tmp="$CONF.tmp.$$"
    {
        printf '# Archcraft ELITE · displays.conf — o arrangement salvo (craft-display E89)\n'
        printf '# Regrado por craft-display em %s\n' "$(date '+%F %T')"
        printf '%s\n' "$estado"
    } > "$tmp" 2>/dev/null || { dlog "FALHA: save não conseguiu escrever $tmp"; rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$CONF"
    dlog "save: arrangement gravado ($estado)"
    return 0
}

# ── watch: a escolha do dono grava sozinha (com o gate do arranjo) ───────
do_watch() {
    # o watch nasce DEPOIS do apply (ordem do autostart): o primeiro
    # estado é fotografiado como base — só MUDANÇA estável depois dele
    # vira conf. Sem conf inicial, o estado atual É a base (nada é salvo
    # "à toa" no arranque — a mudança tem que ser uma ESCOLHA visível).
    base="$(state_keys | sort | md5sum | cut -d' ' -f1)"
    estavel=0
    while :; do
        sleep 4
        agora="$(state_keys | sort | md5sum | cut -d' ' -f1)"
        [ -z "$agora" ] && continue                     # sessão sem resposta — espera
        if [ "$agora" = "$base" ]; then
            estavel=0
            continue
        fi
        estavel=$((estavel + 1))
        if [ "$estavel" -lt 2 ]; then
            continue                                    # mudança instável — pode ser transição
        fi
        # E106 — A FRONTEIRA ENTRE ESCOLHA E REVERSÃO: divergência com o
        # marco do resume fresco (<45s) = reversão do driver, NÃO é
        # escolha: NÃO grava — o reconcile do apply re-assegura o conf.
        if resume_fresco; then
            dlog "watch: mudança estável DURANTE o resume (marca fresca) — NÃO grava (a reversão do driver não é escolha; o apply re-assegura o conf salvo)"
            base="$agora"
            estavel=0
            continue
        fi
        # E107 — A TRANSIÇÃO NÃO É ESTABILIDADE: leitura sem a marca de
        # modo atual é o MEIO de uma troca, não o fim dela — a base
        # atualiza e a escolha REAL (o estado com marca) grava no
        # próximo tick.
        if modo_em_curso; then
            base="$agora"
            estavel=0
            continue
        fi
        # E107 — O GATE DO ARRANJO: o apply desta sessão ainda não
        # assentou (stamp fail) — o estado estável agora é o DEFAULT DO
        # BOOT, não a mão do dono: gravá-lo seria destruir o conf salvo
        # (o envenenamento que o dump 200537 fotografou — o conf
        # sobrescrito 1 minuto após o boot). O conf é a fonte da
        # verdade até o arranjo de pé; a porta do MENU grava sempre (é
        # escolha explícita, com o stamp ok na mão).
        if ! grep -qx 'ok' "$STAMP" 2>/dev/null; then
            dlog "watch: mudança estável com o apply pendente (stamp '$(cat "$STAMP" 2>/dev/null || echo ausente)') — NÃO grava (o conf salvo é a fonte da verdade até o arranjo assentar)"
            base="$agora"
            estavel=0
            continue
        fi
        # mudança estável com marca e arranjo assentado: é a escolha do
        # dono por qualquer porta — grava.
        do_save || true
        dnotify "Arranjo de telas salvo — volta assim nos próximos boots"
        base="$agora"
        estavel=0
    done
}

# ── o MENU (craft-display nu): todos os modos do EDID, aplicado+salvo ────
menu_pick() {
    _mp_title="$1"
    errf="$(mktemp)"
    ec=0
    choice="$(craft-menu --title="$_mp_title" --at=power 2>"$errf")" || ec=$?
    rm -f "$errf"
    # 143 (cross-dismiss) e 2 (toggle) e 1 (ESC) = fechamentos benignos —
    # a mesma gramática do craft-idle (E46/v2.3.10)
    case "$ec" in
        0) printf '%s' "$choice"; return 0 ;;
        *) return 1 ;;
    esac
}

# E107 — O GESTO DO MENU ASSENTA O ARRANJO: escolha explícita do dono
# aplicada com sucesso = stamp ok na hora (o watch volta a gravar por
# qualquer porta) + o save guardado (a transição não entra no conf; a
# recusa avisa e o watch grava quando assentar).
menu_escolheu() { # $1 = alvo, $2 = modo mostrado
    if "$RANDR" --output "$1" --mode "$3" >/dev/null 2>&1; then
        printf 'ok\n' > "$STAMP" 2>/dev/null || true
        if do_save; then
            dnotify "$1: $2 — aplicado e salvo para os próximos boots"
        else
            dnotify "$1: $2 aplicado — o registro assenta sozinho quando a tela parar (o watch grava)"
        fi
        return 0
    fi
    dnotify "Falhou aplicar $2 (log: ~/.cache/elite/display.log)"
    dlog "FALHA: menu apply $1 --mode $3"
    return 1
}

do_menu() {
    command -v craft-menu >/dev/null 2>&1 || {
        # sem fuzzel/menu: a porta gráfica direta (o binário existe na ISO)
        dlog "menu: craft-menu ausente — abrindo wdisplays direto"
        exec wdisplays 2>/dev/null || dnotify "Nenhuma porta de Displays disponível"
        exit 0
    }
    estado="$(state_keys)"
    if [ -z "$estado" ]; then
        dnotify "Não consegui ler as telas agora"
        exit 1
    fi
    n_out="$(printf '%s\n' "$estado" | grep -c .)"
    alvo=""
    if [ "$n_out" -gt 1 ]; then
        itens="$(printf '%s\n' "$estado" | awk -F'|' '{
            m=$2; sub(/^mode:/,"",m); sub(/@/," @ ",m); sub(/Hz$/," Hz",m)
            printf "Tela: %s (%s)\n", $1, m
        }')"
        escolha="$(printf '%s\n' "$itens" | menu_pick 'Displays — qual tela?')" || exit 0
        alvo="$(printf '%s' "$escolha" | sed 's/^Tela: //; s/ (.*$//')"
        [ -n "$alvo" ] || exit 0
    else
        alvo="$(printf '%s\n' "$estado" | head -1 | cut -f1)"
    fi
    linhad="$(printf '%s\n' "$estado" | awk -F'|' -v a="$alvo" '$1==a')"
    [ -n "$linhad" ] || exit 0
    cur="$(printf '%s\n' "$linhad" | cut -d'|' -f2 | sed 's/^mode://')"
    # a lista de modos REAIS do EDID (a porta "todas as detectadas" do dono)
    modos="$("$RANDR" 2>/dev/null | awk -v out="$alvo" '
        $1 == out && /"/ { dentro=1; proxima=0 }
        dentro && /^  Modes:/ { proxima=1; next }
        dentro && proxima && /^[ \t]+[0-9]+x[0-9]+ px,/ {
            m=$1; r=""
            for (i=2;i<=NF;i++) if ($i ~ /^[0-9.]+$/) r=$i
            printf "%s @ %s Hz\n", m, r
        }
    ')"
    if [ -z "$modos" ]; then
        dnotify "Não listei os modos de $alvo — abra o wdisplays"
        exit 1
    fi
    cur_label="$(printf '%s' "$cur" | sed 's/@/ @ /; s/$/ Hz/')"
    itens="$(printf '%s\n' "$modos" | awk -v c="$cur_label" '$0 == c { print $0 " ← atual"; next } { print }' | sort -u)"
    itens="$(printf '%s\n' "$itens" \
        "Modo preferido do monitor" \
        "Posição/escala avançado (wdisplays)" \
        "Salvar o arrangement atual")"
    escolha="$(printf '%s\n' "$itens" | menu_pick "Displays — $alvo")" || exit 0
    case "$escolha" in
        'Modo preferido do monitor')
            if "$RANDR" --output "$alvo" --preferred >/dev/null 2>&1; then
                printf 'ok\n' > "$STAMP" 2>/dev/null || true
                if do_save; then
                    dnotify "$alvo no modo preferido — salvo para os próximos boots"
                else
                    dnotify "$alvo no modo preferido — o registro assenta quando a tela parar"
                fi
            else
                dnotify "Falhou aplicar o modo preferido (log: ~/.cache/elite/display.log)"
            fi
            exit 0 ;;
        'Posição/escala avançado (wdisplays)')
            if command -v wdisplays >/dev/null 2>&1; then
                exec wdisplays   # o watch grava o que o dono fechar configurado
            else
                dnotify "wdisplays não está instalado"
            fi
            exit 0 ;;
        'Salvar o arrangement atual')
            do_save && dnotify "Arranjo atual salvo para os próximos boots"
            exit 0 ;;
        '← atual'|*←\ atual) exit 0 ;;
        *)
            modo="$(printf '%s' "$escolha" | sed 's/ ← atual$//; s/ @ /@/; s/ Hz$//')"
            menu_escolheu "$alvo" "$escolha" "$modo"
            exit 0 ;;
    esac
}

case "${1:-}" in
    apply)  do_apply ;;
    save)   do_save; exit $? ;;
    watch)  do_watch ;;
    status)
        # E106 — O STATUS QUE FALAVA SOZINHO: seções vazias ganham LINHA
        # NOMEADA e exit ≠ 0 quando a realidade não responde. E107 — o
        # estado do stamp também é veredito (o eco mentiroso do retry
        # morre na transparência: o papel mostra a máquina inteira).
        _rc=0
        echo "── salvo ($(basename "$CONF")) em $CONF_DIR"
        if [ -s "$CONF" ]; then
            conf_keys || true
        else
            echo "   (sem conf em disco — nenhuma escolha registrada ainda)"
        fi
        echo "── agora:"
        st="$(state_keys 2>/dev/null)"
        if [ -n "$st" ]; then
            printf '%s\n' "$st"
        else
            echo "   (wlr-randr sem resposta — WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<não setado>}, HOME=${HOME:-<não setado>})"
            _rc=1
        fi
        echo "── stamp da sessão:"
        if [ -f "$STAMP" ]; then
            echo "   $(cat "$STAMP" 2>/dev/null || echo '(ilegível)')"
        else
            echo "   (sem stamp — o apply ainda não rodou nesta sessão)"
        fi
        exit "$_rc" ;;
    *)      do_menu ;;
esac
