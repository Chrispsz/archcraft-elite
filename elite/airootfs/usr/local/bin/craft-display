#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-display (E89 — A TELA QUE LEMBRA)
# ═══════════════════════════════════════════════════════════════════════════
# O RELATO DO DONO (07/nov): "o sistema não tem uma persistência, por
#   exemplo, da resolução, dos hertz… Eu coloco 200 hertz e toda vez que eu
#   reinicio o PC tem que estar colocando os 200 hertz na minha tela porque
#   ele some". O réu é a FÍSICA do Wayland, não o monitor: o modo é
#   propriedade do COMPOSITOR em RAM — o wdisplays (e o wlr-randr) aplicam
#   na hora e MORREM sem memória; nenhum componente da casa gravava a
#   escolha, e o labwc nasce no modo preferido do EDID (a resolução "vai",
#   os hertz somem — exatamente o sintoma).
#
# A CURA (três braços, um conf):
#   · apply  — o AUTOSTART chama: espera os outputs de pé (o wlr-randr
#     falha nos primeiros instantes da sessão) e aplica o que está salvo
#     em ~/.config/elite/displays.conf — o 200 Hz nasce aplicado, sem
#     clique nenhum.
#   · watch  — vigia a sessão: o estado atual do wlr-randr que DIFERIR do
#     conf e SE ESTABILIZAR (2 leituras seguidas iguais = não é ruído de
#     arranque) é a escolha do dono por QUALQUER porta (wdisplays, menu
#     daqui, wlr-randr CLI) — grava sozinho. A persistência deixa de
#     depender de lembrar de salvar.
#   · menu   — o craft-display menu (porta CLI; o item 'Telas' do menu
#     do desktop saiu pela E114 — a porta gráfica do dono é o wdisplays,
#     e o watch E89 grava a escolha que vier por QUALQUER delas):
#     fuzzel com TODOS os modos que o EDID do monitor oferece — "deveria
#     ser todas as detectadas… ou então esse menu fosse bem pensado"
#     (relato do dono) — aplica E grava no mesmo clique. A porta gráfica
#     avançada (wdisplays) segue a um item de distância.
#
# FORMATO DO CONF (~/.config/elite/displays.conf — 1 linha por output):
#   NOME|mode:LARGURAxA@TAXA|pos:X,Y|scale:S|transform:T|adaptive:estado
#   (campos ausentes = o labwc manda — o conf só fala o que o dono escolheu)
#
# LEIS DA CASA: log em ~/.cache/elite/display.log (teto 256 KiB — família
# E36); notify em falha (nada morre calado para quem está na tela); o
# watch NUNCA briga com o apply (começa DEPOIS dele e o primeiro estado
# igual ao conf não é "mudança").
#
# E105 — O STAMP NÃO É FÉ: conf ≠ realidade estável por ~30s = o arranjo
#   salvo REAPLICA (o mode1 reset do amdgpu no resume devolvia o rig a
#   60 Hz com o conf salvo em 200 Hz e o stamp mandava calar).
#
# E106 — O STAMP HONESTO: o stamp só é escrito DEPOIS do feito (ok /
#   fail:N) e o fail re-tenta com teto de 6 (o link DP frio treina na
#   2ª-3ª tentativa; depois de 6, silêncio sem spam).
#
# E107 — AS TRÊS CARGAS DO DUMP 200537 (o dono: "ele sempre volta para
#   60 hertz… você tá salvando lixo no meu PC"):
#   1. O ECO MENTIROSO (E33): o do_apply anunciava 'RE-TENTANDO (1/6)' e
#      chamava a aplicadora, que carregava o SEU próprio guarda de stamp
#      (a gramática anti-duplo E96) — o guarda via 'fail:1', respondia
#      'nada a fazer' e matava o SCRIPT INTEIRO com exit 0: o contador
#      congelava em 1/6 PARA SEMPRE (o log do dump: o par de linhas no
#      MESMO segundo, de 5 em 5s, e o rig a 60 Hz desde o boot). O retry
#      era teatro. CURA: a aplicadora é PURA (não lê stamp nenhum —
#      só espera os outputs e aplica); a máquina de estados mora SÓ no
#      do_apply e o contador ANDA de verdade (fail:1 → fail:2 → …).
#   2. O SAVE DE LIXO: no meio de uma troca de modo o wlr-randr some com
#      a marca '(current)' e o parser devolve 'mode:-' — a v2.11.4
#      GRAVOU isso: o displays.conf do rig amanheceu com um traço no
#      lugar do 200 Hz (19:57:08, um minuto após o boot) e o apply pula
#      campo traço por desenho: a escolha saiu do disco PARA SEMPRE.
#      CURA: o save RECUSA estado sem marca de modo atual (espera a
#      marca assentar até 5s; não vem = recusa com a prova no papel —
#      nada de lixo no conf) e o watch NÃO conta transição como
#      estabilidade.
#   3. O ENVENENAMENTO DO BOOT: o watch gravava o DEFAULT DO BOOT (60
#      Hz) como se fosse escolha do dono antes do apply da sessão
#      assentar. CURA: o watch só grava com o apply desta sessão
#      assentado (stamp ok) — o conf salvo é a fonte da verdade até o
#      arranjo de pé; a escolha explícita do MENU grava sempre (é a mão
#      do dono, com o stamp ok nela).
# ═══════════════════════════════════════════════════════════════════════════
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/elite"
CONF="$CONF_DIR/displays.conf"
DLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/display.log"
RANDR="${ELITE_RANDR:-wlr-randr}"
# E113 — A BANDEIRA QUE CADA WLR-RANDR ACEITA: o rig do dono fotografa
# 'wlr-randr: unrecognized option --scale-exact' rc=1 (dump 170720,
# display.log: 6 FALHAS por boot — a tela sobe no preferido do EDID, 60 Hz,
# até o dono abrir o wdisplays na mão). O upstream anuncia as bandeiras que
# tem no --help; a casa chutava '--scale-exact' e a geração do rig NÃO tem.
# O probe decide UMA vez por processo e o apply usa a bandeira local — o
# conf salvo volta a valer no boot (a promessa E89 de pé em qualquer
# geração; o que o wlr-randr da máquina aceita é o que a casa manda).
RANDR_SCALE_FLAG="--scale-exact"
"$RANDR" --help 2>&1 | grep -q -- '--scale-exact' || RANDR_SCALE_FLAG="--scale"
RUN_E="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 0)}/elite"
STAMP="$RUN_E/display-applied"
DIVERGE="$RUN_E/display-diverge"
# E126 — O MUTEX DO APPLY (a tempestade de retries do rig, 17:13-17:14 do
# dump 173137: o craft-bars spawna um apply a cada 5s e o apply de CADA um
# vivia 15s+ com o compositor mudo — três ou quatro em voo LERAM o mesmo
# stamp 'fail:N' e cada um logou o MESMO contador ('(2/6)' duas×, '(3/6)'
# três× no papel), gravando N+1 por cima um do outro e até REGREDINDO o
# contador (o mais velho escreveu por último). O flock decide no KERNEL:
# quem chega 2º sai 0 em silêncio — UM dono por veredito. O fd morre com
# o processo, sem órfão segurando a porta (a lição E43).
APPLY_LOCK="$RUN_E/display-apply.lock"
# E126 — O FREIO POR COMANDO: nenhuma chamada ao wlr-randr fica SEM
# timeout — o compositor travado que BLOQUEIA (em vez de falhar rápido)
# pendurava o apply INTEIRO para sempre segurando o pipe (a pilha de
# applies vivos do rig). 6s é o teto: o labwc saudável responde em ms.
RANDR_T=6
# E118 — O CONTADOR DO PÓS-SONO: o retry sob a marca fresca conta UM
# heartbeat de assento (5s) e re-tenta — não dorme a janela inteira.
RESUME_TICKS="$RUN_E/display-resume-ticks"

dlog() {
    mkdir -p "${DLOG%/*}" 2>/dev/null || true
    if [ -f "$DLOG" ] && [ "$(wc -c <"$DLOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$DLOG" > "$DLOG.tmp" 2>/dev/null && mv -f "$DLOG.tmp" "$DLOG"
    fi
    if ! printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$DLOG" 2>/dev/null; then
        # E106 — a mesma honestidade do ilog do craft-idle: papel que não
        # aceita escrita não é mais silêncio (tmpfs sempre gravável).
        printf '[%s] dlog FALHOU (%s): %s\n' "$(date '+%F %T')" "$DLOG" "$*" \
            >>"${XDG_RUNTIME_DIR:-/tmp}/elite/display-write-fail" 2>/dev/null || true
    fi
    return 0
}
dnotify() {
    command -v notify-send >/dev/null 2>&1 && \
        timeout 5 notify-send -a 'Elite' -u normal -t 6000 'Displays' "$1" || true
    return 0
}

# ── O PARSER do wlr-randr (a única leitura de verdade da casa) ───────────
# Lê o stdout do $RANDR e imprime, POR output, uma linha canônica:
#   NOME|mode:LxA@T|pos:X,Y|scale:S|transform:T|adaptive:ESTADO
# Duas gerações de formato cobertas: o "Current mode:" da 0.4 e a marca
# "(current)" na lista de modos da 0.5 (a do rig).
parse_state() {
    timeout "$RANDR_T" "$RANDR" 2>/dev/null | awk '
        function flush() {
            if (name != "" && enabled == "yes") {
                if (cur == "") cur="-"
                if (pos == "") pos="-"
                if (scale == "") scale="-"
                if (tr == "") tr="normal"
                if (adap == "") adap="disabled"
                printf "%s|mode:%s|pos:%s|scale:%s|transform:%s|adaptive:%s\n",
                       name, cur, pos, scale, tr, adap
            }
        }
        # a impressão é no FIM do bloco de cada output (a marca "(current)"
        # da 0.5 vem DEPOIS da lista — imprimir na Adaptive Sync perderia)
        /^[A-Za-z0-9-]+[ \t]+"/ {
            flush()
            name=$1
            enabled=""; cur=""; pos=""; scale=""; tr=""; adap=""
        }
        /Enabled:/    { enabled=$2 }
        /Current mode:/ {
            for (i=1;i<=NF;i++) {
                if ($i ~ /^[0-9]+x[0-9]+$/) cur=$i
                if ($i ~ /^[0-9.]+$/ && $(i+1)=="Hz") cur=cur"@"$i
            }
        }
        /Position:/   { pos=$2 }
        /Transform:/  { tr=$2 }
        /Scale:/      { scale=$2 }
        /Adaptive Sync:/ { adap=$NF }
        /^[ \t]+[0-9]+x[0-9]+ px,/ {
            if (index($0, "(current)") > 0) {
                m=$1; r=""
                for (i=2;i<=NF;i++) if ($i ~ /^[0-9.]+$/) r=$i
                cur=m"@"r
            }
        }
        END { flush() }
    '
}

# conf_hash — a impressão digital do conf (a mesma linha canônica, sem
# comentários/linhas vazias — o watch compara ESTADO com CONF, não ruído)
conf_keys() {
    grep -v '^[[:space:]]*#' "$CONF" 2>/dev/null | grep -v '^[[:space:]]*$' | sort
}
state_keys() {
    parse_state | sort
}

# E107 — a TRANSIÇÃO não é escolha: no meio de uma troca de modo o
# wlr-randr some com a marca '(current)' e o parse devolve 'mode:-'. Essa
# leitura NÃO é a vontade do dono — nem o save grava, nem o watch conta
# estabilidade sobre ela.
modo_em_curso() {
    state_keys | grep -q 'mode:-|'
}

# E106 — o MARCO DO RESUME (a fronteira entre ESCOLHA e REVERSÃO): o
# hook elite-resume-display (root, system-sleep) toca ESTE arquivo no
# pós-sono. O watch e o reconcile leem a idade: reversão do driver no
# resume NÃO é escolha — não grava e não re-aplica sob o wake instável.
RESUME_MARK="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 0)}/elite/display-resume"
resume_fresco() {
    [ -r "$RESUME_MARK" ] || return 1
    _m="$(stat -c %Y "$RESUME_MARK" 2>/dev/null || echo 0)"
    [ "$(($(date +%s) - _m))" -lt 45 ]
}

# ── apply: o braço PURO (só aplica o conf; o stamp é do do_apply) ────────
aplica_arranjo() {
    # E107 — O APLICADOR PURO: a v2.11.4 carregava DUAS gramáticas de
    # stamp no mesmo corpo (o guarda anti-duplo E96 DENTRO da aplicadora
    # + o retry E106 FORA) — o retry anunciava 'RE-TENTANDO' e a
    # aplicadora respondia 'nada a fazer' e matava o processo inteiro
    # com exit 0: o contador congelava em 1/6 para sempre (o eco duplo
    # no log do dump 200537, o rig a 60 Hz desde o boot). Agora ela NÃO
    # LÊ stamp nenhum: espera os outputs e aplica; ok/fail:N é decisão
    # do do_apply, DEPOIS do feito.
    [ -s "$CONF" ] || { dlog "apply: sem conf salvo — nada a aplicar (o monitor manda o preferido do EDID)"; return 0; }
    # a espera: o compositor precisa dos outputs de pé para o wlr-randr
    # responder (o autostart roda antes da primeira frame às vezes)
    i=0
    while [ "$i" -lt 8 ]; do
        out="$(timeout "$RANDR_T" "$RANDR" 2>/dev/null)" && [ -n "$out" ] && break
        sleep 0.5
        i=$((i + 1))
    done
    if [ "$i" -ge 8 ]; then
        dlog "FALHA: wlr-randr não respondeu (8 sondas de até ${RANDR_T}s) — apply abortado (o conf fica salvo; o retry do heartbeat tenta de novo; compositor mudo há muito tempo = o guard do orquestrador (elite-daemon) toma a frente)"
        return 1
    fi
    vivos="$(parse_state | cut -d'|' -f1)"
    aplicados=0
    falhas=0
    while IFS= read -r linha; do
        case "$linha" in ''|'#'*) continue ;; esac
        nome="${linha%%|*}"
        # vivo? (o grep -qx casa a LINHA exata — o output sumiu = pulado,
        # o conf fica para a volta dele)
        if ! printf '%s\n' "$vivos" | grep -qx "$nome"; then
            dlog "apply: $nome não está presente agora — pulado (o conf fica)"
            continue
        fi
        args=""
        campo=""
        rest="${linha#*|}"
        resto="$rest"
        while [ -n "$resto" ]; do
            campo="${resto%%|*}"
            resto="${resto#*|}"
            [ "$campo" = "$resto" ] && resto=""
            case "$campo" in
                mode:*)
                    modo="${campo#mode:}"
                    [ "$modo" = "-" ] && continue
                    # E96 — a string salva INTEIRA (WxH@TAXA, 6 casas do
                    # float do EDID): sem reformat %.3f (viagem de ida e
                    # volta que podia cair no mHz vizinho) e sem sufixo
                    # Hz (o parse_mode do wlr-randr antigo exigia número
                    # puro). O que o EDID imprimiu é o que volta.
                    args="$args --mode $modo"
                    ;;
                pos:*)      [ "${campo#pos:}" != "-" ] && args="$args --pos ${campo#pos:}" ;;
                scale:*)    [ "${campo#scale:}" != "-" ] && args="$args $RANDR_SCALE_FLAG ${campo#scale:}" ;;
                transform:*) [ "${campo#transform:}" != "normal" ] && args="$args --transform ${campo#transform:}" ;;
                adaptive:*)
                    case "${campo#adaptive:}" in
                        enabled)  args="$args --adaptive-sync on" ;;
                        disabled) args="$args --adaptive-sync off" ;;
                    esac ;;
            esac
            [ "$campo" = "${linha##*|}" ] && break
        done
        if [ -z "$args" ]; then
            continue
        fi
        _rc=0
        _err="$(timeout "$RANDR_T" "$RANDR" --output "$nome" $args 2>&1 1>/dev/null)" || _rc=$?
        if [ "$_rc" -ne 0 ] && printf '%s' "$_err" | grep -q 'invalid adaptive sync state'; then
            # E117 — O FLAG QUE ESTE WLR-RANDR NÃO ACEITA (dump 163548: o
            # apply 6/6 com rc=1 'invalid adaptive sync state: off' e a
            # tela NO MODO CERTO — o wlr-randr 0.5.0 deste rig recusa o
            # --adaptive-sync off e morria ANTES de aplicar nada; o stamp
            # ficava fail:6 gritando FALHA para um arranjo que o
            # compositor JÁ entrega, porque VRR desligado é o estado
            # default dele). Cura: o stderr nomeou o flag → o flag MORRE
            # da linha (o adaptive:disabled é o estado que nasce) e o
            # apply RE-RODA com o resto — modo/pos/scale/transform
            # aplicam; se ainda falhar, a FALHA volta a ser nomeada.
            case "$args" in
                *"--adaptive-sync "*)
                    args="${args%--adaptive-sync *}"
                    args="${args% }"
                    _rc=0
                    _err="$(timeout "$RANDR_T" "$RANDR" --output "$nome" $args 2>&1 1>/dev/null)" || _rc=$?
                    ;;
            esac
        fi
        if [ "$_rc" -eq 0 ]; then
            dlog "apply: $nome$args — OK"
            aplicados=$((aplicados + 1))
        else
            # E108 — A FALHA NOMEADA: o rc e o stderr do wlr-randr entram
            # no papel (o FALHA antigo CHUTAVA a causa — 'o modo pode não
            # existir neste EDID' — com o stderr engolido por >/dev/null;
            # o dump 180302 fotografou 6 FALHAS sem UMA prova do porquê).
            dlog "FALHA: apply $nome$args — rc=$_rc stderr: ${_err:-<vazio>} (o modo pode não existir mais neste EDID — o monitor manda)"
            falhas=$((falhas + 1))
        fi
    done < "$CONF"
    dlog "apply: fim ($aplicados aplicado(s), $falhas falha(s))"
    if [ "$falhas" -gt 0 ]; then
        dnotify "Modo salvo não pôde ser aplicado em $falhas tela(s) — log: ~/.cache/elite/display.log"
        return 1
    fi
    return 0
}

# ── apply-boot: o FRAME 0 do relogin (E129 — a ordem do dono) ────────
apply_boot() {
    # UMA passada SÍNCRONA: o autostart do labwc roda desapegado por
    # desenho (o compositor o lança em background), então correr AQUI de
    # forma síncrona atrasa as barras em NO MÁXIMO a espera dos outputs
    # (8 sondas de 0.5s — o normal é a 1ª responder). O ganho: a resolução
    # do dono nasce ANTES da waybar/dock — nada de barras nascendo a 60 Hz
    # para trocar a 200 Hz (o 'aplicou do nada' que o dono fotografou no
    # dump 210305). SEM o teatro do retry (os 6 ticks do E106 eram ~27s de
    # tela errada no relogin): UMA aplicação, stamp honesto ok/fail:1, e a
    # casa da persistência continua de pé por baixo (o do_apply do
    # supervisor re-tenta com o teto; o watch segue gravando a escolha).
    if command -v flock >/dev/null 2>&1; then
        exec 8>"$APPLY_LOCK" 2>/dev/null || true
        flock -n 8 2>/dev/null || { dlog "apply-boot: outro apply vive — sai (o mutex E126)"; exit 0; }
    fi
    if [ ! -s "$CONF" ]; then
        dlog "apply-boot: sem conf salvo — nada a aplicar (o EDID manda; silêncio)"
        return 0
    fi
    if aplica_arranjo; then
        printf 'ok\n' > "$STAMP" 2>/dev/null || true
        dlog "apply-boot: arranjo salvo aplicado no frame 0 (uma passada, sem retry — E129)"
    else
        printf 'fail:1\n' > "$STAMP" 2>/dev/null || true
        dlog "apply-boot: falhou no frame 0 (stamp fail:1 — o do_apply do supervisor re-tenta com o teto E106; nada morre aqui)"
    fi
    return 0
}

do_apply() {
    # E107 — A MÁQUINA DE ESTADOS ÚNICA (a casa do stamp): o E96
    # (anti-duplo: autostart e supervisor podem AMBOS chamar — o ok é a
    # fé do heartbeat), o E105 (reconcile: o reset do driver no resume
    # não vence o conf) e o E106 (o fail re-tenta com teto) moram TODOS
    # aqui — e SÓ aqui. Quem escreve o stamp é este corpo, DEPOIS do
    # feito: ok no sucesso, fail:N+1 na falha (o contador ANDA — a
    # v2.11.4 relia um stamp vazio e eternizava fail:1).
    mkdir -p "${STAMP%/*}" 2>/dev/null || true
    # E126 — O MUTEX PRIMEIRO DE TUDO (a tempestade do rig: sem exclusão,
    # o contador do stamp era lido por 3-4 processos no mesmo segundo —
    # cada um logava '(N/6)' e gravava N+1 por cima; o flock garante UM
    # dono por veredito e o craft-bars também pula o spawn com apply
    # vivo — as duas metades da cura). Quem chega 2º sai 0 em silêncio:
    # o dono da vez é quem conta para o papel.
    if command -v flock >/dev/null 2>&1; then
        exec 8>"$APPLY_LOCK" 2>/dev/null || true
        flock -n 8 2>/dev/null || exit 0
    fi
    if [ ! -s "$CONF" ]; then
        rm -f "$STAMP" "$DIVERGE" 2>/dev/null || true
        exit 0   # sem conf = nada a aplicar (o monitor manda o EDID; silêncio — heartbeat)
    fi
    # E108 — O CONF DOENTE DORME A PERSISTÊNCIA (a cura da raiz do '60 Hz
    # sempre volta'): o conf gravado por save antigo pode amanhecer com
    # 'mode:-' (o traço da transição — o veneno que o dump 200537
    # fotografou e o E107 recusa escrever NOVO). O E107 pula o CAMPO por
    # desenho — mas o resto da linha aplicava meia-casa (pos/scale sem o
    # modo) e o reconcile do stamp ok lutava 30s contra um conf que NUNCA
    # restaura o modo: a máquina reconciliava PARA 60 Hz para sempre. O
    # dump 180302 fotografou a cauda: FALHA ×6 (16:45:13→34), stamp
    # fail:6, e o conf só curou quando o dono salvou à mão às 18:02:39.
    # Cura: conf com mode:- = persistência DORME (log nomeado UMA vez por
    # sessão + aviso na cara do dono dizendo a porta da cura) — o save
    # novo grava limpo e o ciclo renasce sem reinício.
    if grep -q 'mode:-' "$CONF" 2>/dev/null; then
        if [ ! -e "$RUN_E/display-sick-notified" ]; then
            : > "$RUN_E/display-sick-notified" 2>/dev/null || true
            _doentes="$(grep 'mode:-' "$CONF" 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ')"
            dlog "conf doente (E108): [${_doentes}] com mode:- no disco — o modo nunca será restaurado por ESTE conf; a persistência dorme até o save novo (o wdisplays escolhe e o watch grava limpo — o ciclo renasce sem reinício)"
            dnotify "Registro de telas doente (mode:-) — escolha o modo no wdisplays e aplique; o watch grava e o conf cura na hora"
        fi
        exit 0
    fi
    n_fail=0
    estado_stamp=""
    if [ -f "$STAMP" ] && [ -s "$STAMP" ]; then
        estado_stamp="$(cat "$STAMP" 2>/dev/null || true)"
    fi
    case "$estado_stamp" in
        ok)
            # E105 — O RECONCILIE (o mode1 reset do amdgpu no resume
            # devolvia o rig a 60 Hz com o conf em 200 Hz): conf ≠
            # realidade estável por ~30s = o arranjo salvo volta.
            vivos="$(state_keys)"
            divergente=0
            while IFS= read -r linha; do
                case "$linha" in ''|'#'*) continue ;; esac
                if ! printf '%s\n' "$vivos" | grep -Fxq "$linha"; then
                    divergente=1
                    break
                fi
            done < "$CONF"
            if [ "$divergente" -eq 0 ]; then
                rm -f "$DIVERGE" "$RESUME_TICKS" 2>/dev/null || true
                exit 0   # confere — no-op silencioso (o heartbeat de 5s)
            fi
            if resume_fresco; then
                # E118 — O IMEDIATO DO PÓS-SONO (a ordem do dono no dump
                # 210305: 'demorou um tempo aí para aplicar e aplicou do
                # nada… fica imediato, fica fixo, e que nunca volte para
                # o padrão — seja realmente a configuração que o usuário
                # setou'). A v2.13 via a marca fresca e DORMIA: o
                # reconcile aguardava a janela de 45s inteira e AINDA
                # pagava os 6 ticks de estabilidade (~74s de tela errada
                # no papel 20:27:11→20:28:14). A marca existe para NOMEAR
                # a divergência — 'a reversão do driver não é escolha' —
                # e o papel já dizia o que o apply devia fazer. Hoje o
                # reconcile re-aplica NO PRIMEIRO heartbeat divergente do
                # pós-sono (≤10s do resume), o apply falho re-tenta com
                # UM tick de assento e o teto E106 intacto, e o conf
                # salvo segue sendo a fonte da verdade — o save guarda a
                # janela de 45s INTEIRA (a reversão nunca vira escolha;
                # a escolha do dono continua intocável).
                dlog "apply: realidade diverge do conf no pós-sono (marca fresca) — a reversão do driver não é escolha; REAPLICANDO o arranjo do dono AGORA (o imediato é lei E118)"
                rm -f "$DIVERGE" "$RESUME_TICKS" 2>/dev/null || true
                # cai no apply real abaixo (o stamp ok renasce do feito)
            else
                rm -f "$RESUME_TICKS" 2>/dev/null || true
                n_div=$(( $(cat "$DIVERGE" 2>/dev/null || echo 0) + 1 ))
                printf '%s\n' "$n_div" > "$DIVERGE" 2>/dev/null || true
                # E134 — A ESPERA DE 6 TICKS (~30s) MORREU (a ordem do
                # dono 1.0-81: 'display instantâneo'). A janela que
                # SOBRA é de 2 heartbeats (~10s) e é CORRIDA, não
                # espera: o watch precisa de 8s de estado ESTÁVEL
                # (2 ticks de 4s) para gravar a escolha do dono feita
                # no wdisplays — sem esta janela, o apply REVERTERIA a
                # escolha no primeiro heartbeat divergente, antes de o
                # conf dela existir (o dono mudaria o modo e o sistema
                # desmancharia a mão dele 5s depois). 10s > 8s: o watch
                # SEMPRE vence a corrida da escolha; a reversão de
                # driver/replug (que NINGUÉM escolheu) re-aplica em
                # ~10s em vez de ~30s.
                if [ "$n_div" -lt 2 ]; then
                    dlog "apply: realidade diverge do conf salvo (heartbeat $n_div/2 — a janela da corrida do watch: a escolha do dono no wdisplays grava em 8s; revertê-la antes seria desmanchar a mão dele)"
                    exit 0
                fi
                dlog "apply: realidade ≠ conf salvo há ~10s e NINGUÉM escolheu isto (reversão/replug?) — REAPLICANDO o arranjo do dono (E134: a espera de 30s morreu)"
                rm -f "$DIVERGE" 2>/dev/null || true
                # cai no apply real abaixo (o stamp ok renasce do feito)
            fi
            ;;
        fail:*)
            # E106 — O RETRY COM TETO (a ferida que muteava a sessão:
            # fail era terminal na v2.6). Até 6 falhas seguidas o apply
            # re-tenta a cada heartbeat (o link DP frio treina na 2ª-3ª
            # tentativa); depois de 6 = silêncio honesto (o papel tem as
            # 6 provas; o menu à mão grava o conf e recomeça o ciclo).
            # E107 — o retry agora RETENTA DE VERDADE (a aplicadora pura
            # não recusa mais; o contador caminha para o teto).
            n_fail="${estado_stamp#fail:}"
            case "$n_fail" in ''|*[!0-9]*) n_fail=1 ;; esac
            if [ "$n_fail" -ge 6 ]; then
                exit 0
            fi
            if resume_fresco; then
                # E118 — o retry do pós-sono NÃO dorme a janela inteira:
                # UM heartbeat de assento (5s) e re-tenta — o teto E106
                # segue sendo o guarda (o link DP frio treina na 2ª-3ª
                # tentativa; o imediato que o dono ordenou não espera 45s
                # para começar a treinar).
                n_res=$(( $(cat "$RESUME_TICKS" 2>/dev/null || echo 0) + 1 ))
                printf '%s\n' "$n_res" > "$RESUME_TICKS" 2>/dev/null || true
                if [ "$n_res" -lt 2 ]; then
                    exit 0   # um heartbeat de assento — o wake termina de acordar
                fi
                dlog "apply: tentativa anterior falhou ($n_fail/6) no pós-sono — RE-TENTANDO (E118: o imediato não dorme o resume)"
            else
                rm -f "$RESUME_TICKS" 2>/dev/null || true
                dlog "apply: tentativa anterior falhou ($n_fail/6) — RE-TENTANDO (o stamp honesto re-tenta; a v2.11.4 congelava em 1/6 com o eco duplo)"
            fi
            ;;
        *)
            # stamp vazio/lixo (a era v2.6 do 'sucesso antecipado') =
            # em curso: o apply corre de novo (quem nasceu por último
            # vence — a escola E64)
            ;;
    esac

    if aplica_arranjo; then
        printf 'ok\n' > "$STAMP" 2>/dev/null || true
        rm -f "$DIVERGE" 2>/dev/null || true
    else
        n_fail=$((n_fail + 1))
        [ "$n_fail" -ge 1 ] || n_fail=1
        printf 'fail:%s\n' "$n_fail" > "$STAMP" 2>/dev/null || true
    fi
    exit 0
}

# ── save: fotografa o AGORA para o conf (SEM lixo de transição) ───────────
do_save() {
    estado="$(state_keys)"
    if [ -z "$estado" ]; then
        dlog "FALHA: save sem estado do wlr-randr (sessão sem outputs?)"
        dnotify "Não consegui ler as telas agora — nada salvo"
        return 1
    fi
    # E107 — A GUARDA CONTRA O LIXO: o displays.conf do rig do dono
    # amanheceu com 'mode:-' (um traço no lugar do 200 Hz — gravado no
    # meio de uma troca de modo, quando a marca '(current)' some do
    # wlr-randr). O apply pula campo traço por desenho: o 200 Hz saiu
    # do disco para sempre ('tá salvando lixo', na letra do dono).
    # Estado sem marca de modo atual NÃO entra no conf — espera a marca
    # assentar (até 5s); não vem, recusa com a prova no papel.
    i=0
    while [ "$i" -lt 5 ] && modo_em_curso; do
        sleep 1
        i=$((i + 1))
    done
    if modo_em_curso; then
        dlog "save: RECUSADO — modo em transição sem a marca de atual (o parser não viu o '(current)' em 5s; nada de lixo no conf)"
        dnotify "A tela ainda está trocando de modo — o registro assenta sozinho quando ela parar"
        return 1
    fi
    estado="$(state_keys)"
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    tmp="$CONF.tmp.$$"
    {
        printf '# Archcraft ELITE · displays.conf — o arrangement salvo (craft-display E89)\n'
        printf '# Regrado por craft-display em %s\n' "$(date '+%F %T')"
        printf '%s\n' "$estado"
    } > "$tmp" 2>/dev/null || { dlog "FALHA: save não conseguiu escrever $tmp"; rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$CONF"
    dlog "save: arrangement gravado ($estado)"
    return 0
}

# ── E134 — O OUVIDOR DO LOGIND: Unlock e PrepareForSleep(false) são ────
#     EVENTOS, e evento não se espera por heartbeat. O ouvidor é um
#     FILHO do watch (um processo por sessão, âncora própria no cmdline
#     — o órfão da sessão anterior morre pelo pkill na nascença) e
#     escuta o D-Bus do sistema (org.freedesktop.login1.Manager): ao
#     DESTRAVAR a sessão ou VOLTAR do sono, toca a marca do resume (a
#     reversão do driver não é escolha — E118) e chama o apply NA HORA
#     (latência zero do 'display instantâneo' da ordem do dono 1.0-81;
#     o sleep-hook elite-resume-display segue cobrindo o resume SEM
#     watch vivo — as duas portas são idempotentes, o flock do apply
#     serializa a corrida).
login1_ouvidor() {
    command -v dbus-monitor >/dev/null 2>&1 || return 0
    # UM ouvidor por sessão (E30): o órfão do relogin morre pela âncora
    # ANTES do nascimento — dois ouvidores seriam duas corridas de apply
    # por evento (o flock seguraria, mas o papel contaria a dobradinha).
    pkill -f "craft-display __login1-watch$" 2>/dev/null || true
    ( /usr/local/bin/craft-display __login1-watch ) >/dev/null 2>&1 &
}

login1_watch() {
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager'" 2>/dev/null | awk '
        /member=Unlock$/          { pend = "unlock"; next }
        /member=PrepareForSleep$/ { pend = "sleep"; next }
        pend == "sleep" && /boolean false/ { print "despertar"; fflush(); pend = "" }
        pend == "sleep" && /boolean true/  { pend = "" }
        pend == "unlock" && /^ *uint32 /   { print "destravar"; fflush(); pend = "" }
    ' | while IFS= read -r _ev; do
        case "$_ev" in
            despertar|destravar)
                : > "${XDG_RUNTIME_DIR:-/tmp}/elite/display-resume" 2>/dev/null || true
                /usr/local/bin/craft-display apply >/dev/null 2>&1 || true
                ;;
        esac
    done
    exit 0
}

# ── watch: a escolha do dono grava sozinha (com o gate do arranjo) ───────
do_watch_loop() {
    # o watch nasce DEPOIS do apply (ordem do autostart): o primeiro
    # estado é fotografiado como base — só MUDANÇA estável depois dele
    # vira conf. Sem conf inicial, o estado atual É a base (nada é salvo
    # "à toa" no arranque — a mudança tem que ser uma ESCOLHA visível).
    base="$(state_keys | sort | md5sum | cut -d' ' -f1)"
    estavel=0
    while :; do
        sleep 4
        agora="$(state_keys | sort | md5sum | cut -d' ' -f1)"
        [ -z "$agora" ] && continue                     # sessão sem resposta — espera
        if [ "$agora" = "$base" ]; then
            estavel=0
            continue
        fi
        estavel=$((estavel + 1))
        if [ "$estavel" -lt 2 ]; then
            continue                                    # mudança instável — pode ser transição
        fi
        # E106 — A FRONTEIRA ENTRE ESCOLHA E REVERSÃO: divergência com o
        # marco do resume fresco (<45s) = reversão do driver, NÃO é
        # escolha: NÃO grava — o reconcile do apply re-assegura o conf.
        if resume_fresco; then
            dlog "watch: mudança estável DURANTE o resume (marca fresca) — NÃO grava (a reversão do driver não é escolha; o apply re-assegura o conf salvo)"
            base="$agora"
            estavel=0
            continue
        fi
        # E107 — A TRANSIÇÃO NÃO É ESTABILIDADE: leitura sem a marca de
        # modo atual é o MEIO de uma troca, não o fim dela — a base
        # atualiza e a escolha REAL (o estado com marca) grava no
        # próximo tick.
        if modo_em_curso; then
            base="$agora"
            estavel=0
            continue
        fi
        # E107 — O GATE DO ARRANJO: o apply desta sessão ainda não
        # assentou (stamp fail) — o estado estável agora é o DEFAULT DO
        # BOOT, não a mão do dono: gravá-lo seria destruir o conf salvo
        # (o envenenamento que o dump 200537 fotografou — o conf
        # sobrescrito 1 minuto após o boot). O conf é a fonte da
        # verdade até o arranjo de pé; a porta do MENU grava sempre (é
        # escolha explícita, com o stamp ok na mão).
        # E126 — A DESCULPA EXPIRA (a janela de perda do item da
        # resolução: o rig ficou fail:6 ETERNO após a tempestade do
        # compositor mudo — o dono escolheu o modo pelo wdisplays na
        # sessão recuperada e o watch NUNCA gravou; o reboot devolvia o
        # conf velho — 'a resolução escolhida precisa ser salva'). Um
        # stamp fail com MAIS DE 2 MINUTOS de idade não é 'arranjo a
        # caminho' — é arranjo desistido: se o wlr-randr RESPONDE ao
        # watch agora (condição de entrada deste bloco) e o estado está
        # estável com marca, é a mão do dono por qualquer porta — grava
        # COM VOZ. O envenenamento do boot (a razão do gate) mora nos
        # primeiros 2min — a janela original segue intacta lá.
        if ! grep -qx 'ok' "$STAMP" 2>/dev/null; then
            _st_age=$(( $(date +%s) - $(stat -c %Y "$STAMP" 2>/dev/null || echo 0) ))
            if [ "$_st_age" -le 120 ]; then
                dlog "watch: mudança estável com o apply pendente (stamp '$(cat "$STAMP" 2>/dev/null || echo ausente)' há ${_st_age}s) — NÃO grava (o conf salvo é a fonte da verdade até o arranjo assentar)"
                base="$agora"
                estavel=0
                continue
            fi
            dlog "watch: mudança estável com stamp fail VELHO (${_st_age}s — a desculpa do arranjo a caminho expirou) — o wlr-randr responde e o estado assentou: É ESCOLHA — gravando (E126)"
        fi
        # mudança estável com marca e arranjo assentado: é a escolha do
        # dono por qualquer porta — grava.
        do_save || true
        dnotify "Arranjo de telas salvo — volta assim nos próximos boots"
        base="$agora"
        estavel=0
    done
}

# E139 — O WATCH LEGADO (a porta de fora) volta a ter o OUVIDOR LOGIND:
# o guard E135 manda o rig COM o daemon session sair 0 (o daemon é o
# ouvidor nativo); nos rigs sem o binário, o ouvidor nasce aqui como
# sempre nasceu — e o corpo do watch é o MESMO do_watch_loop (a escolha
# grava sozinha).
do_watch() {
    # E134 — o ouvidor do logind nasce com o watch (Unlock/PrepareForSleep
    # viram apply IMEDIATO — a latência zero do 'display instantâneo')
    login1_ouvidor
    do_watch_loop
}

# ── o MENU (craft-display nu): todos os modos do EDID, aplicado+salvo ────
menu_pick() {
    _mp_title="$1"
    errf="$(mktemp)"
    ec=0
    choice="$(craft-menu --title="$_mp_title" --at=power 2>"$errf")" || ec=$?
    rm -f "$errf"
    # 143 (cross-dismiss) e 2 (toggle) e 1 (ESC) = fechamentos benignos —
    # a mesma gramática do craft-idle (E46/v2.3.10)
    case "$ec" in
        0) printf '%s' "$choice"; return 0 ;;
        *) return 1 ;;
    esac
}

# E107 — O GESTO DO MENU ASSENTA O ARRANJO: escolha explícita do dono
# aplicada com sucesso = stamp ok na hora (o watch volta a gravar por
# qualquer porta) + o save guardado (a transição não entra no conf; a
# recusa avisa e o watch grava quando assentar).
menu_escolheu() { # $1 = alvo, $2 = modo mostrado
    if timeout "$RANDR_T" "$RANDR" --output "$1" --mode "$3" >/dev/null 2>&1; then
        printf 'ok\n' > "$STAMP" 2>/dev/null || true
        if do_save; then
            dnotify "$1: $2 — aplicado e salvo para os próximos boots"
        else
            dnotify "$1: $2 aplicado — o registro assenta sozinho quando a tela parar (o watch grava)"
        fi
        return 0
    fi
    dnotify "Falhou aplicar $2 (log: ~/.cache/elite/display.log)"
    dlog "FALHA: menu apply $1 --mode $3"
    return 1
}

do_menu() {
    command -v craft-menu >/dev/null 2>&1 || {
        # sem fuzzel/menu: a porta gráfica direta (o binário existe na ISO)
        dlog "menu: craft-menu ausente — abrindo wdisplays direto"
        exec wdisplays 2>/dev/null || dnotify "Nenhuma porta de Displays disponível"
        exit 0
    }
    estado="$(state_keys)"
    if [ -z "$estado" ]; then
        dnotify "Não consegui ler as telas agora"
        exit 1
    fi
    n_out="$(printf '%s\n' "$estado" | grep -c .)"
    alvo=""
    if [ "$n_out" -gt 1 ]; then
        itens="$(printf '%s\n' "$estado" | awk -F'|' '{
            m=$2; sub(/^mode:/,"",m); sub(/@/," @ ",m); sub(/Hz$/," Hz",m)
            printf "Tela: %s (%s)\n", $1, m
        }')"
        escolha="$(printf '%s\n' "$itens" | menu_pick 'Displays — qual tela?')" || exit 0
        alvo="$(printf '%s' "$escolha" | sed 's/^Tela: //; s/ (.*$//')"
        [ -n "$alvo" ] || exit 0
    else
        alvo="$(printf '%s\n' "$estado" | head -1 | cut -d'|' -f1)"
    fi
    linhad="$(printf '%s\n' "$estado" | awk -F'|' -v a="$alvo" '$1==a')"
    # E109 — A MORTE CALADA DO SINGLE-OUTPUT (o dono: 'Telas e resolução,
    # eu clico e não acontece nada — nem abre uma janelinha' — o dump
    # 181701: UM output DP-1 e NENHUMA abertura de menu). O alvo da 1ª
    # tela nascia de `cut -f1` — o -f corta por TAB, a linha canônica
    # não tem tab: o alvo recebia A LINHA INTEIRA ('DP-1|mode:…'), o
    # filtro awk nunca casava e o `[ -n "$linhad" ] || exit 0` matava o
    # menu SEM JANELA e SEM PALAVRA — morto só nas máquinas de UM monitor
    # (as de duas telas escolhiam pela 1ª porta e nunca pisaram neste
    # ramo). A cura é o separador CERTO + a morte NOMEADA (a lei E33: o
    # desfecho sem tela e sem log é a mentira silenciosa).
    if [ -z "$linhad" ]; then
        dlog "FALHA: menu — o output '$alvo' saiu do estado entre a leitura e o filtro (réu nomeado; nada aberto)"
        dnotify "Não consegui ler '$alvo' agora — tenta de novo (log: ~/.cache/elite/display.log)"
        exit 1
    fi
    cur="$(printf '%s\n' "$linhad" | cut -d'|' -f2 | sed 's/^mode://')"
    # a lista de modos REAIS do EDID (a porta "todas as detectadas" do dono)
    modos="$(timeout "$RANDR_T" "$RANDR" 2>/dev/null | awk -v out="$alvo" '
        $1 == out && /"/ { dentro=1; proxima=0 }
        dentro && /^  Modes:/ { proxima=1; next }
        dentro && proxima && /^[ \t]+[0-9]+x[0-9]+ px,/ {
            m=$1; r=""
            for (i=2;i<=NF;i++) if ($i ~ /^[0-9.]+$/) r=$i
            printf "%s @ %s Hz\n", m, r
        }
    ')"
    if [ -z "$modos" ]; then
        dnotify "Não listei os modos de $alvo — abra o wdisplays"
        exit 1
    fi
    cur_label="$(printf '%s' "$cur" | sed 's/@/ @ /; s/$/ Hz/')"
    # E110 — O MENU QUE O DONO LÊ (o dump 114852: 'a tela é bem poluída e
    # não é fácil ter os indicadores do que está marcado'): a lista nascia
    # do sort -u ALFABÉTICO — '1024x768' antes de '1920x1080', as taxas
    # misturadas, o atual perdido no meio. A cura: resolução de cima para
    # baixo (numérica), dentro dela a maior taxa primeiro, o modo atual
    # com o marcador ← atual (o dono nunca perde o ponto). Os rótulos de
    # ação saem da fala técnica e entram na língua do usuário leigo —
    # 'aplicar por lá já salva automático' (a cura do auto-save já era o
    # desenho: menu_escolheu aplica E grava; o item de guardar segue para
    # o arrangement feito fora da porta, agora com nome que explica).
    itens="$(printf '%s\n' "$modos" \
        | awk -v c="$cur_label" '
            $0 == c { print "1\t" $0 " ← atual"; next }
            { print "2\t" $0 }' \
        | awk -F'\t' '
            {
                m=$2; res=m; sub(/ @ .*/, "", res);
                split(res, wh, "x");
                chave = (wh[1]+0)*100000 + (wh[2]+0);
                hz=m; sub(/.*@/, "", hz); sub(/ Hz.*/, "", hz);
                if ($1 == "1") chave = chave * 1000 + 999999; else chave = chave * 1000 + hz*10;
                printf "%015d\t%s\n", chave, $2
            }' | sort -r | cut -f2-)"
    itens="$(printf '%s\n' "$itens" \
        "Melhor qualidade do monitor" \
        "Duas telas: posição/escala (avançado)" \
        "Guardar como está agora (para os próximos boots)")"
    escolha="$(printf '%s\n' "$itens" | menu_pick "Displays — $alvo")" || exit 0
    case "$escolha" in
        'Melhor qualidade do monitor')
            if timeout "$RANDR_T" "$RANDR" --output "$alvo" --preferred >/dev/null 2>&1; then
                printf 'ok\n' > "$STAMP" 2>/dev/null || true
                if do_save; then
                    dnotify "$alvo no modo preferido — salvo para os próximos boots"
                else
                    dnotify "$alvo no modo preferido — o registro assenta quando a tela parar"
                fi
            else
                dnotify "Falhou aplicar o modo preferido (log: ~/.cache/elite/display.log)"
            fi
            exit 0 ;;
        'Duas telas: posição/escala (avançado)')
            if command -v wdisplays >/dev/null 2>&1; then
                exec wdisplays   # o watch grava o que o dono fechar configurado
            else
                dnotify "wdisplays não está instalado"
            fi
            exit 0 ;;
        'Guardar como está agora (para os próximos boots)')
            do_save && dnotify "Arranjo atual salvo para os próximos boots"
            exit 0 ;;
        '← atual'|*←\ atual) exit 0 ;;
        *)
            modo="$(printf '%s' "$escolha" | sed 's/ ← atual$//; s/ @ /@/; s/ Hz$//')"
            menu_escolheu "$alvo" "$escolha" "$modo"
            exit 0 ;;
    esac
}

case "${1:-}" in
    apply)  do_apply ;;
    apply-boot) apply_boot ;;
    save)   do_save; exit $? ;;
    watch)
        # E135 — O GUARD DO OUVIDOR LEGADO: o elite-daemon session é o
        # dono dos eventos de display agora (netlink drm + logind — os
        # threads dele dormem nos sinais). Vivo o daemon, este watch
        # shell É O RESIDENTE QUE A ORDEM DO DONO MANDOU MATAR (o dump
        # 101339: 3 processos craft-display residentes) — sai 0 sem
        # tocar em nada (o fallback só vale para rig sem o binário).
        if pgrep -f '^/usr/local/bin/elite-daemon session$' >/dev/null 2>&1; then
            _l="${XDG_CACHE_HOME:-$HOME/.cache}/elite/display.log"
            printf '[%s] watch: elite-daemon session é o ouvidor (E135) — residente shell não nasce
' "$(date '+%F %T')" >>"$_l" 2>/dev/null
            exit 0
        fi
        do_watch ;;
    watch-save)
        # E139 — A VAGA SUPERVISIONADA (a sessão é quem lança — o slot
        # 'displaysave' do elite-daemon session): o MESMO corpo do watch
        # (a escolha do wdisplays grava de novo) SEM o guard E135 e SEM
        # o ouvidor logind próprio — o daemon session é o ouvidor
        # nativo do resume (dois ouvidos = duas corridas de apply por
        # evento). Caiu → o supervisor ressuscita em 2s.
        do_watch_loop ;;
    __login1-watch)
        # E135 — idem: o daemon session tem o thread logind nativo.
        if pgrep -f '^/usr/local/bin/elite-daemon session$' >/dev/null 2>&1; then
            exit 0
        fi
        login1_watch ;;   # E134: o ouvidor do logind (filho do watch)
    status)
        # E106 — O STATUS QUE FALAVA SOZINHO: seções vazias ganham LINHA
        # NOMEADA e exit ≠ 0 quando a realidade não responde. E107 — o
        # estado do stamp também é veredito (o eco mentiroso do retry
        # morre na transparência: o papel mostra a máquina inteira).
        _rc=0
        echo "── salvo ($(basename "$CONF")) em $CONF_DIR"
        if [ -s "$CONF" ]; then
            conf_keys || true
            grep -q 'mode:-' "$CONF" 2>/dev/null && echo "   (conf doente: mode:- no disco — a persistência dorme; escolha o modo no wdisplays e aplique para curar — o watch grava — E108)"
        else
            echo "   (sem conf em disco — nenhuma escolha registrada ainda)"
        fi
        echo "── agora:"
        st="$(state_keys 2>/dev/null)"
        if [ -n "$st" ]; then
            printf '%s\n' "$st"
        else
            echo "   (wlr-randr sem resposta — WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<não setado>}, HOME=${HOME:-<não setado>})"
            _rc=1
        fi
        echo "── stamp da sessão:"
        if [ -f "$STAMP" ]; then
            echo "   $(cat "$STAMP" 2>/dev/null || echo '(ilegível)')"
        else
            echo "   (sem stamp — o apply ainda não rodou nesta sessão)"
        fi
        exit "$_rc" ;;
    *)      do_menu ;;
esac
