# ── E147 — O FÓSSIL DOS 2º PLANOS + AS PELES DO SKEL NOS RIGS VIVOS ────
#      (a diretriz do dono: "Mantém um módulo/indicador de aplicativos
#      em segundo plano que deve ser completamente removido — já havia
#      sido solicitado para sair, mas permaneceu na interface e no
#      código"; e "Falta de sincronização de configs visuais do
#      /etc/skel/.config/ (swaync, gtk-3.0, gtk-4.0, fuzzel) para
#      usuários já instalados no post_upgrade"). O bin morre COM VOZ
#      (não tem mais consumidor: a barra E147 removeu o módulo e o
#      daemon removeu o ouvidor do +9); as peles AUSENTES chegam pela
#      dose (a gramática do domínio v3: o arquivo do dono é INTOCÁVEL
#      — só o que NÃO existe é entregue, idempotente por desenho).
if [ -f /usr/local/bin/craft-bgapps ]; then
    rm -f /usr/local/bin/craft-bgapps 2>/dev/null \
        && tlog "E147: fóssil craft-bgapps REMOVIDO (o indicador de 2º planos saiu da barra pela ordem do dono — o bin não tem consumidor)"
fi

sync_skel() {
    # sync_skel <home> <uid> — entrega do /etc/skel/.config o que o rig
    # NÃO tem (swaync, gtk-3.0, gtk-4.0, fuzzel — as peles da diretriz
    # UI/UX); arquivo presente = domínio do dono, NUNCA tocado.
    _sh="$1"
    _suid="$2"
    _entregues=0
    for _cfg in swaync gtk-3.0 gtk-4.0 fuzzel; do
        [ -d "/etc/skel/.config/$_cfg" ] || continue
        for _sf in "/etc/skel/.config/$_cfg"/*; do
            [ -f "$_sf" ] || continue
            _alvo="$_sh/.config/$_cfg/$(basename "$_sf")"
            if [ ! -e "$_alvo" ]; then
                mkdir -p "$_sh/.config/$_cfg" 2>/dev/null || true
                if cp -p "$_sf" "$_alvo" 2>/dev/null; then
                    chown "$_suid:$(stat -c %g "$_sh" 2>/dev/null || echo "$_suid")" "$_alvo" 2>/dev/null || true
                    _entregues=$((_entregues + 1))
                fi
            fi
        done
    done
    if [ "$_entregues" -gt 0 ]; then
        tlog "skel $_suid: $_entregues arquivo(s) de peles ENTREGUE(S) (swaync/gtk-3.0/gtk-4.0/fuzzel ausentes no rig — a pele da casa chega pela dose; o personalizado é intocável)"
    fi
}

# ── 1.0-93 — O SCX_LAVD DE VERDADE (a ordem do dono: o scx-scheds
#      instala /usr/bin/scx_lavd SEM .service nenhum — a unit nova da
#      casa /etc/systemd/system/scx-lavd.service o roda DIRETO). A
#      ConditionPathExists do unit segura kernel sem sched_ext (unit
#      PULADA, nunca FAILED); aqui o enable só desce com a interface E
#      o binário EM DISCO. O scx_loader genérico é DESLIGADO na mesma
#      jogada (UM escalonador sched_ext por vez — quem sobe primeiro
#      ganha; a dona é a unit nova) ─────────────────────────────────
if [ -d /sys/kernel/sched_ext ] && [ -x /usr/bin/scx_lavd ]; then
    if systemctl cat scx-lavd.service >/dev/null 2>&1; then
        systemctl disable --now scx_loader.service >/dev/null 2>&1 \
            && tlog "scx: scx_loader DESLIGADO (a unit nova scx-lavd.service é a dona do escalonador — 1.0-93)"
        systemctl enable --now scx-lavd.service >/dev/null 2>&1 \
            && tlog "scx: scx-lavd.service habilitado na dose (o lavd latência-first DIRETO, sem o loader genérico — 1.0-93)"
    else
        tlog "scx: a unit scx-lavd.service não chegou ao disco (o pacote traz — a próxima dose liga)"
    fi
else
    tlog "scx: sched_ext ausente no kernel OU scx_lavd não instalado — o BORE do kernel segue como chão (a unit fica PULADA, nunca FAILED)"
fi

# ── 1.0-93 — O GRUB SEM MITIGAÇÕES E SEM WATCHDOG (a ordem do dono:
#      desktop de jogo — mitigations=off + nowatchdog no
#      GRUB_CMDLINE_LINUX_DEFAULT; o mkconfig só roda se MUDOU de
#      verdade — o rebuild fantasma morre, a lei E130) ─────────────────
_ensure_token /etc/default/grub mitigations=off       && { tlog "grub: mitigations=off entrou (a ordem 1.0-93 — o desktop de jogo sem o imposto de espectre/meltdown)"; _grub_mudou=1; }
_ensure_token /etc/default/grub nowatchdog            && { tlog "grub: nowatchdog entrou (o watchdog de softlockup do desktop é custo sem serviço)"; _grub_mudou=1; }
if [ "${_grub_mudou:-0}" = 1 ] && command -v grub-mkconfig >/dev/null 2>&1; then
    if grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; then
        tlog "grub: grub-mkconfig rodou (o cmdline 1.0-93 vale no PRÓXIMO boot)"
    else
        tlog "grub: grub-mkconfig falhou (os tokens ficaram no default/grub — o próximo tune/primeiro boot re-tenta)"
    fi
fi

# ── 1.0-95 — A CURA DOS ARQUIVOS DE SESSÃO (E146 — o relato final do
#      dono periciado): o autostart do home VIVO chegou CORROMPIDO (8
#      lançadores `elite-daemon session &` injetados no meio de
#      comentários por sed cego FORA do repo; o flock segurou o dano),
#      o menu.xml carregava texto órfão fora de tag desde o E103 e os
#      .bak-* acumulavam sem rotação. O elite-heal-sessao cura os
#      três (reconstrução do mestre com prova pós-escrita, rotação,
#      idempotente) — a migração 1.0-93 (append do lançador) morre
#      SUBSTITUÍDA: append não detecta corrupção, o heal sim.
for _hdir in /home/*; do
    [ -d "$_hdir" ] || continue
    _auid="$(stat -c %u "$_hdir" 2>/dev/null || echo 0)"
    case "$_auid" in
        ''|0|*[!0-9]*) continue ;;
    esac
    [ "$_auid" -ge 1000 ] || continue
    if [ -x /usr/local/bin/elite-heal-sessao ]; then
        _heal_out="$(/usr/local/bin/elite-heal-sessao "$_auid" "$_hdir" 2>/dev/null || true)"
        # o papel do heal viaja no log da dose (veredito por arquivo)
        while IFS= read -r _hl; do
            [ -n "$_hl" ] && tlog "heal $_auid: $_hl"
        done <<EOF
$_heal_out
EOF
    fi
    # E147 — AS PELES DO SKEL CHEGAM AO RIG VIVO (a ordem do dono: as
    # configs visuais de /etc/skel/.config para usuários já instalados,
    # sem comando manual e sem tocar o personalizado)
    sync_skel "$_hdir" "$_auid"
done
unset _hdir _auid _heal_out _hl

# ── 1.0-93 — O DEBLOAT DOS RIGS VIVOS (a ordem do dono): waybar e
#      gpsd SAEM quando nenhum pacote depende deles (a consulta é no
#      pacman; dependente vivo = o pacote fica, com voz no papel); os
#      .desktop órfãos (xterm/uxterm/qv4l2/qvidcap/xgps/xgpsspeed)
#      ganham o NoDisplay em /usr/local/share/applications (sombra da
#      casa: o pacote e o binário seguem intactos, a UI é que não
#      lista) ────────────────────────────────────────────────────────
for _deb in waybar gpsd; do
    if command -v pacman >/dev/null 2>&1 && pacman -Qq "$_deb" >/dev/null 2>&1; then
        if pacman -Qi "$_deb" 2>/dev/null | grep -q '^Required By *: *None'; then
            if pacman -Rns --noconfirm "$_deb" >/dev/null 2>&1; then
                tlog "debloat 1.0-93: $_deb REMOVIDO (nenhum dependente — a barra é o craft-bar-rs)"
            fi
        else
            tlog "debloat 1.0-93: $_deb FICA (há dependente no db — a remoção forçada quebraria a casa)"
        fi
    fi
done
unset _deb
install -d /usr/local/share/applications 2>/dev/null || true
for _ofan in xterm uxterm qv4l2 qvidcap xgps xgpsspeed; do
    _alvo="/usr/local/share/applications/$_ofan.desktop"
    if [ -f "/usr/share/applications/$_ofan.desktop" ] && [ ! -f "$_alvo" ]; then
        printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nNoDisplay=true\n' "$_ofan" "$_ofan" > "$_alvo" 2>/dev/null \
            && tlog "debloat 1.0-93: $_ofan.desktop ocultado (NoDisplay — utilitário interno não é app de menu)"
    fi
done
unset _ofan _alvo

tlog "post-upgrade: concluído (a migração é idempotente — rodar de novo é no-op com papel)"
exit 0
