#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-post-upgrade — A MIGRAÇÃO AUTÔNOMA (E129)
# ═══════════════════════════════════════════════════════════════════════════
# A LEI DO DONO (AGENTS.md §4, 2026-11-20): "O usuário final nunca roda
# comandos manuais de pós-instalação — toda correção em /etc, Polkit,
# systemd, sysctl, GRUB, Flatpaks e dotfiles roda automaticamente no
# pacman -Syu via post_upgrade(), SEM depender do firstboot-done (que só
# roda na instalação inicial)". O post_upgrade do elite-system chama ESTE
# bin a cada upgrade do pacote — o rig já instalado RECEBE a cura pela
# transação, não a procura num manual.
#
# IDEMPOTENTE POR DESENHO (§4: rodar múltiplas vezes = mesmo estado final):
#   · máscara/enable são no-op repetidos (o systemd responde igual);
#   · token de GRUB entra UMA vez (grep antes do sed); grub-mkconfig SÓ
#     roda quando o default/grub mudou de verdade (sem rebuild fantasma);
#   · qt6ct.conf só nasce SE AUSENTE (personalizado do dono é intocável);
#   · flatpak okular/--unused sem alvo = linha no papel, rc 0;
#   · o rice das peles segue a gramática E101/E123 do craft-rice
#     (ausente/marcador/fóssil renova com backup; personalizado intocável).
# Papel: /var/log/elite-post-upgrade.log (teto E36 256 KiB). Instância
# única por flock (a lei E30 — zero pgrep, zero polling).
# ═══════════════════════════════════════════════════════════════════════════
set -u

LOG=/var/log/elite-post-upgrade.log
LOCK=/run/elite-post-upgrade.lock

tlog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >>"$LOG" 2>/dev/null || true
}

if [ "${1:-}" = "--help" ]; then
    sed -n '2,30p' "$0" | grep '^# ' | sed 's/^# \{0,1\}//'
    exit 0
fi

[ "$(id -u)" = 0 ] || { printf 'elite-post-upgrade: corre como raiz (o post_upgrade do elite-system o convoca)\n' >&2; exit 0; }

# instância única (E30): flock na entrada — a segunda corrida SAI (o
# pacman nunca roda dois post_upgrade do mesmo pacote em paralelo, mas a
# porta manual é livre; a lei é de UM dono por vez)
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK" 2>/dev/null || true
    flock -n 9 || { tlog "post-upgrade: outra corrida viva — saída honesta (a lei E30)"; exit 0; }
fi

tlog "post-upgrade: iniciando (E129 — a migração autônoma da constituição §4)"

# ── 1. O systemd RELE o mundo (units novas/mascaradas da transação) ──
systemctl daemon-reload >/dev/null 2>&1 && tlog "systemd: daemon-reload ok" || tlog "systemd: daemon-reload falhou (sem systemd rodando? — ambiente de prova, no-op honesto)"

# ── 2. A CADÊNCIA MORTA NÃO RENASCE + O ESPERA-TEMPO DO BOOT MORRE ──
# E128: a família da cadência (a revogação da E51 pela §5) é disable+mask —
# o fóssil de rig antigo não volta nem por start manual.
# §5 do dono: o systemd-time-wait-sync segura o boot esperando rede
# (o -31s de arranque que a máquina do dono pagou) — MASCARADO (o
# systemd-networkd-wait-online é quem sobrou, e é da base, não da casa).
# E132 — O IRMÃO DE REDE ENTRA JUNTO (a ordem do dono: userspace 65s →
# ~6s): o NetworkManager-wait-online segura o fim do boot pela
# verificação de rede — a REDE segue funcionando, só a ESPERA morre
# (o systemd-analyze nomeou o réu; unmask devolve).
systemctl mask systemd-time-wait-sync.service >/dev/null 2>&1 \
    && tlog "boot: systemd-time-wait-sync MASCARADO (o arranque não espera rede morta)" \
    || tlog "boot: mask do time-wait-sync falhou (no-op honesto)"
systemctl mask NetworkManager-wait-online.service >/dev/null 2>&1 \
    && tlog "boot: NetworkManager-wait-online MASCARADO (o desktop não espera a rede levantar — E132)" \
    || tlog "boot: mask do NM-wait-online falhou (no-op honesto)"
_cad=""
for _u in elite-channel.timer elite-channel.service \
          elite-bootupdate.timer elite-bootupdate.service \
          elite-sysupdate.timer elite-sysupdate.service; do
    systemctl disable --now "$_u" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$_u" 2>/dev/null || true
    _cad="$_cad $_u"
done
if systemctl mask $_cad >/dev/null 2>&1; then
    tlog "cadência: elite-channel/bootupdate/sysupdate aposentados e MASCARADOS (E128 — a constituição §5; os timers de update não renascem)"
fi

# ── 3. TMPFILES DA CASA CRIA O QUE PRECISA EXISTIR (o /run e o /var) ──
systemd-tmpfiles --create >/dev/null 2>&1 \
    && tlog "tmpfiles: --create ok (a estrutura transitória segue a receita)" \
    || tlog "tmpfiles: --create falhou (no-op honesto)"

# ── 4. O SYSCTL DA CASA NO KERNEL VIVO (a transação pode ter trazido ──
#      conf de terceiro por cima — a E101 do post-transaction prova a classe)
# E132→E137 — O CONF DA CASA FALA 180 (PROMPT 3 do dono: zram0 zstd 8G +
#      MGLRU de fábrica → estilo SteamOS; recalibra a ordem E136). O
#      fóssil 99-elite-ram.conf da era E74, que vencia a lei por ordem
#      lexical, é REMOVIDO aqui com voz: a casa inteira fala UM número
#      só. Regeneração idempotente: a régua da MESMA máquina gera o
#      MESMO arquivo — rodar 2× = mesmo estado. QUEM DEFENDE O 180 NO
#      BOOT é a regra udev 81-elite-zram.rules (o réu do drift 150≠180
#      tem nome desde o dump 201219: o 30-zram.rules do cachyos-settings
#      escreve 150 no evento do zram0 e a 81 da casa recoloca o 180 no
#      MESMO evento, por ordem lexical).
_mib=$(( $(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0) / 1024 ))
_sw=180
if [ "$_mib" -gt 0 ] 2>/dev/null; then
    _tem_chave=novas
    grep -q '^vm\.compaction_proactiveness' /etc/sysctl.d/99-elite-performance.conf 2>/dev/null || _tem_chave=velhas
    _tem_sw=""
    _tem_sw="$(sed -n 's/^vm\.swappiness *= *//p' /etc/sysctl.d/99-elite-performance.conf 2>/dev/null | tail -1)"
    if [ "$_tem_chave" = velhas ]; then
        cp -p /etc/sysctl.d/99-elite-performance.conf "/etc/sysctl.d/99-elite-performance.conf.bak-e137-$(date +%s)" 2>/dev/null || true
        printf '%s\n' \
            "# ── ELITE: performance consolidado (E137 — regenerado pelo post_upgrade; a ordem PROMPT 3: swappiness 180 com zram zstd + MGLRU)" \
            "vm.swappiness = 180" \
            "vm.vfs_cache_pressure = 50" \
            "vm.page_lock_unfairness = 1" \
            "vm.max_map_count = 2147483642" \
            "kernel.sched_autogroup_enabled = 1" \
            "vm.page-cluster = 0" \
            "vm.watermark_boost_factor = 0" \
            "vm.watermark_scale_factor = 125" \
            "vm.dirty_background_ratio = 5" \
            "vm.dirty_ratio = 10" \
            "vm.compaction_proactiveness = 0" \
            > /etc/sysctl.d/99-elite-performance.conf 2>/dev/null \
            && tlog "sysctl: 99-elite-performance.conf REGENERADO com a lei E137 (RAM ${_mib} MiB → swappiness 180 + dirty 5/10 + compaction 0)"
    elif [ "$_tem_sw" != "$_sw" ]; then
        sed -i "s/^vm\.swappiness *=.*/vm.swappiness = 180/" /etc/sysctl.d/99-elite-performance.conf 2>/dev/null \
            && tlog "sysctl: swappiness recalibrado → 180 (a ordem PROMPT 3 na dose — o drift do 30-zram.rules do vendor morre pela regra 81 da casa)"
    fi
    unset _tem_chave _tem_sw
fi
unset _mib _sw
# o FÓSSIL DA ORDEM LEXICAL morre (era o réu do drift: vencia a lei em toda aplicação)
if [ -f /etc/sysctl.d/99-elite-ram.conf ]; then
    rm -f /etc/sysctl.d/99-elite-ram.conf 2>/dev/null \
        && tlog "sysctl: 99-elite-ram.conf REMOVIDO (o fóssil E74 que vencia a lei por ordem lexical — uma voz só)"
fi
# E136 — A CONSOLIDAÇÃO chega aos rigs vivos: os DOIS confs da era
# anterior (99-elite.conf da RAM + 99-elite-net.conf da rede) viram UM
# (o 99-elite-performance.conf do dono). O pacote entrega o
# consolidado; os fósseis saem COM VOZ (o systemd-sysctl nunca lê dois
# donos do mesmo número — a lição E135 em arquivo novo).
for _fossil in 99-elite.conf 99-elite-net.conf; do
    if [ -f "/etc/sysctl.d/$_fossil" ]; then
        rm -f "/etc/sysctl.d/$_fossil" 2>/dev/null \
            && tlog "sysctl: $_fossil REMOVIDO (consolidado no 99-elite-performance.conf — E136, a ordem PARTE 2/2)"
    fi
done
unset _fossil
sysctl --system >/dev/null 2>&1 \
    && tlog "sysctl: --system re-aplicou (o tuning da casa vale NA HORA, não no próximo boot)" \
    || tlog "sysctl: --system não aplicou (no-op honesto)"

# ── 4b. E132 — O THP MADVISE NO KERNEL VIVO + O TMPFILES DE TODO BOOT ─────
#      (o cmdline do GRUB (seção 5) cobre o PRÓXIMO boot; este gesto cobre
#      o AGORA — e o tmpfiles reafirma em cada arranque, barato e à prova
#      de regressão de firmware)
if [ ! -e /etc/tmpfiles.d/99-elite-thp.conf ]; then
    mkdir -p /etc/tmpfiles.d 2>/dev/null || true
    printf '%s\n' \
        "# ── ELITE (E132): THP=madvise em TODO boot (o GRUB cobre desde o arranque;" \
        "# este tmpfiles reafirma no userspace — barato e idempotente)" \
        "w /sys/kernel/mm/transparent_hugepage/enabled - - - - madvise" \
        > /etc/tmpfiles.d/99-elite-thp.conf 2>/dev/null \
        && tlog "THP: tmpfiles 99-elite-thp.conf nasceu (madvise em todo boot)"
fi
if [ -w /sys/kernel/mm/transparent_hugepage/enabled ] \
   && ! grep -q '\[madvise\]' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null; then
    if echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null; then
        tlog "THP: madvise aplicado no kernel VIVO (sem esperar reboot — a ordem do dono E132)"
    fi
fi

# ── 5. GRUB: OS TOKENS DA CASA ENTRAM UMA VEZ; O REBUILD SÓ SE MUDOU ──
# zswap.enabled=0: o zram da casa é o swap (zram-generator) — o zswap na
# frente dele é CPU de compressão DUPLA por desenho.
# transparent_hugepage=madvise: THP total ('always') fragmenta e trava o
# reclaim sob memória apertada; madvise dá THP a quem pede (a ordem do
# dono 2026-11-20 substitui o 'always' da era E74).
_ensure_token() {
    _f=$1; _t=$2
    grep '^GRUB_CMDLINE_LINUX_DEFAULT=' "$_f" 2>/dev/null | grep -qF -- "$_t" && return 1
    if [ -f "$_f" ]; then
        cp -p "$_f" "$_f.bak-post-upgrade-$(date +%s)" 2>/dev/null || true
        sed -i -E "/^GRUB_CMDLINE_LINUX_DEFAULT=/ s|\"([^\"]*)\"|\"\1 ${_t}\"|" "$_f" 2>/dev/null || return 1
    else
        printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet %s"\n' "$_t" > "$_f" 2>/dev/null || return 1
    fi
    return 0
}
_grub_mudou=0
[ -f /etc/default/grub ] || { printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet"\n' > /etc/default/grub 2>/dev/null; _grub_mudou=1; }
# o FÓSSIL 'always' SAI (E129: o rig da era E74 amanheceu com o token
# antigo — a migração o remove ANTES de cravar o madvise; o sed é no-op
# se o fóssil não existe — idempotente)
if grep -q 'transparent_hugepage=always' /etc/default/grub 2>/dev/null; then
    cp -p /etc/default/grub "/etc/default/grub.bak-post-upgrade-$(date +%s)" 2>/dev/null || true
    sed -i -E 's/(GRUB_CMDLINE_LINUX_DEFAULT=)"([^"]*)"/\1"\2"/; s/transparent_hugepage=always ?//g; s/  +/ /g; s/" "/"/' /etc/default/grub 2>/dev/null && {
        tlog "grub: o fóssil transparent_hugepage=always SAIU (a migração E129 substitui — não empilha)"
        _grub_mudou=1
    }
fi
_ensure_token /etc/default/grub zswap.enabled=0         && { tlog "grub: zswap.enabled=0 entrou (o zram é o swap da casa — compressão dupla morre)"; _grub_mudou=1; }
_ensure_token /etc/default/grub transparent_hugepage=madvise && { tlog "grub: transparent_hugepage=madvise entrou (a ordem do dono E129 substitui o 'always' — THP a quem pede)"; _grub_mudou=1; }
if [ "$_grub_mudou" = 1 ] && command -v grub-mkconfig >/dev/null 2>&1; then
    if grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; then
        tlog "grub: grub-mkconfig rodou (o cmdline novo vale no PRÓXIMO boot — o atual segue de pé)"
    else
        tlog "grub: grub-mkconfig falhou (os tokens ficaram no default/grub — o próximo tune/primeiro boot re-tenta)"
    fi
fi

# ── 6. O HELPER DO POLKIT COM O SETUID DE FÁBRICA + O TRONO LIMPO ──
# O 'Usuário não autorizado' do dono: o polkit-agent-helper-1 SEM o 4755
# recusa autenticar qualquer agente (a classe documentada na FICHA do
# polkit-agent-helper). O reset-failed limpa as unidades do agente que
# morreram antes da cura (o journal deixa de gritar o passado).
if [ -e /usr/lib/polkit-1/polkit-agent-helper-1 ]; then
    chmod 4755 /usr/lib/polkit-1/polkit-agent-helper-1 2>/dev/null \
        && tlog "polkit: helper com 4755 de fábrica (o agente da casa autentica — o 'Usuário não autorizado' morre)"
fi
systemctl reset-failed 'polkit-agent-helper@*' >/dev/null 2>&1 || true
tlog "polkit: reset-failed dos agentes mortos (o journal conta o presente, não o passado)"

# ── 7. O OKULAR SAI DO SISTEMA (E128 — idempotente; a ordem do dono:
#      apenas Papers + Bazaar moram na casa) + os runtimes órfãos
if command -v flatpak >/dev/null 2>&1; then
    if flatpak info --system org.kde.okular >/dev/null 2>&1; then
        flatpak uninstall --system --noninteractive org.kde.okular >/dev/null 2>&1 \
            && tlog "flatpak: org.kde.okular REMOVIDO (Papers é o leitor da casa — E128)" \
            || tlog "flatpak: okular não saiu agora (a próxima transação re-tenta — best-effort)"
    fi
    flatpak uninstall --system --noninteractive --unused >/dev/null 2>&1 || true
fi

# ── 8. O RICE E O QT DO USUÁRIO ATIVO (a peça que o firstboot-done ──
#      NUNCA levava ao rig já instalado): as seis peles viajam pelo
#      craft-rice (gramática E101/E123 — marcador/backup/intocável) e o
#      qt6ct.conf da casa nasce SE AUSENTE (Papirus-Dark — o mesmo tema
#      dos settings.ini; o Qt6 para de ficar nu no meio do rice escuro).
#      O labwc --reconfigure aplica NA SESSÃO VIVA (a descoberta do
#      WAYLAND_DISPLAY no /run/user/$uid — a escola E126 do craft-update).
loginctl list-users --no-legend 2>/dev/null | while read -r uid _; do
    [ -n "$uid" ] || continue
    [ "$uid" -ge 1000 ] 2>/dev/null || continue
    _home="$(getent passwd "$uid" 2>/dev/null | cut -d: -f6)"
    [ -n "$_home" ] && [ -d "$_home" ] || continue
    # qt6ct: a casa do tema Qt — cria se ausente, toca no que o dono tem
    if [ ! -e "$_home/.config/qt6ct/qt6ct.conf" ]; then
        if [ -r /usr/local/share/elite/qt6ct/qt6ct.conf ]; then
            mkdir -p "$_home/.config/qt6ct" 2>/dev/null || true
            cp /usr/local/share/elite/qt6ct/qt6ct.conf "$_home/.config/qt6ct/qt6ct.conf" 2>/dev/null \
                && chown -R "$uid:$uid" "$_home/.config/qt6ct" 2>/dev/null \
                && tlog "qt6ct: qt6ct.conf da casa nasceu no uid $uid (Papirus-Dark — o Qt6 veste o rice; personalização futura do dono é intocável)"
        fi
    fi
    # o rice + o reconfigure na sessão viva (guard: socket do compositor)
    _wd=""
    for _w in /run/user/"$uid"/wayland-*; do
        [ -S "$_w" ] || continue
        _wd="${_w##*/}"
        break
    done
    if [ -n "$_wd" ]; then
        _out="$(runuser -u "#$uid" -- env \
            XDG_RUNTIME_DIR="/run/user/$uid" \
            WAYLAND_DISPLAY="$_wd" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            HOME="$_home" \
            /usr/local/bin/craft-rice 2>&1 || true)"
        case "$_out" in
            *'reconfigure aplicado'*) tlog "sessão: peles renovadas + reconfigure (uid $uid) — o rice novo vale sem relogin" ;;
            *) tlog "sessão: craft-rice correu (uid $uid, sem socket de sessão viva o reconfigure fica para o arranque)" ;;
        esac
        if [ "$uid" != "$(id -u)" ]; then
            runuser -u "#$uid" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
                WAYLAND_DISPLAY="$_wd" HOME="$_home" \
                labwc --reconfigure >/dev/null 2>&1 || true
        fi
    else
        # sem sessão viva: o rice corre MESMO ASSIM (as peles valem no
        # próximo arranque — o rig sem login aberto recebe a cura igual)
        _out="$(runuser -u "#$uid" -- env HOME="$_home" \
            /usr/local/bin/craft-rice 2>&1 || true)"
        tlog "sessão: uid $uid sem Wayland vivo — o rice correu para o disco (as peles valem no próximo arranque)"
    fi
done

# ── 12. E134 — O FÓSSIL DA DOCK PYTHON MORRE E O SUPERVISOR RENASCE ──────
#      A prova do dump 1.0-80: OITO craft-bars vivos no mesmo rig
#      (BARS_RESTARTS=63), o flock segurado por órfãos de relogins
#      antigos e o craft-dock-gui PYTHON respawnando sob o supervisor
#      VELHO — a dose nova chegava e a sessão nem ficava sabendo (o
#      craft-bars novo saía no-op no lock do órfão). A migração é em
#      TRÊS gestos idempotentes, POR USUÁRIO DE SESSÃO VIVA:
#        (a) o fóssil do arquivo sai do disco (a dose já não o embarca;
#            o rm cobre o rig da era anterior — pacman deixa de ser dono
#            dele NESTA transação);
#        (b) TODO craft-bars do usuário morre (o órfão segurando o lock
#            também — é exatamente ele o réu) e o processo Python da
#            dock idem (o supervisor novo só lança o craft-dock-rs);
#        (c) UM craft-bars novo nasce POR SESSÃO Wayland viva (o mesmo
#            runuser do rice da seção 8) — ele ressuscita waybar, dock
#            Rust, toplevel e idle em ≤5s, com o CÓDIGO NOVO.
if [ ! -e /run/archiso ] && [ -e /usr/local/bin/craft-dock-gui ]; then
    rm -f /usr/local/bin/craft-dock-gui 2>/dev/null \
        && tlog "dock E134: fóssil Python /usr/local/bin/craft-dock-gui REMOVIDO (a dock da casa é o binário Rust craft-dock-rs)"
fi
loginctl list-users --no-legend 2>/dev/null | while read -r _uid _ _; do
    [ -n "$_uid" ] || continue
    [ "$_uid" -ge 1000 ] 2>/dev/null || continue
    _home="$(getent passwd "$_uid" 2>/dev/null | cut -d: -f6)"
    [ -n "$_home" ] && [ -d "$_home" ] || continue
    # sem sessão Wayland viva não há o que renascer (o próximo login
    # nasce com o código novo — o autostart é a porta)
    _wd=""
    for _w in /run/user/"$_uid"/wayland-*; do
        [ -S "$_w" ] || continue
        _wd="${_w##*/}"
        break
    done
    [ -n "$_wd" ] || continue
    if pgrep -u "$_uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' >/dev/null 2>&1; then
        pkill -u "$_uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' 2>/dev/null || true
        tlog "dock E134: processo Python da dock ENCERRADO (uid $_uid) — o supervisor novo lança o craft-dock-rs"
    fi
    if pgrep -u "$_uid" -f '/usr/local/bin/craft-bars' >/dev/null 2>&1; then
        pkill -u "$_uid" -f '/usr/local/bin/craft-bars' 2>/dev/null || true
    fi
    # E135 — OS RESIDENTES SHELL/PYTHON DA ERA ANTERIOR MORREM (a ordem
    # do dono do dump 101339: zero /bin/sh e python3 residentes). O
    # craft-bars NOVO (a dose em disco) execa o elite-daemon session;
    # os órfãos de rotação (audio-route python residente, craft-display
    # watch/login1-watch) morrem AQUI — os guards nos scripts evitam o
    # renascimento (o daemon session é o ouvidor nativo deles).
    for _velho in 'python3 /usr/local/bin/craft-audio-route'                   'craft-audio-route'                   'craft-display watch'                   'craft-display __login1-watch'; do
        if pgrep -u "$_uid" -f "$_velho" >/dev/null 2>&1; then
            pkill -u "$_uid" -f "$_velho" 2>/dev/null || true
            tlog "E135: residente legado '$_velho' morto no uid $_uid (o elite-daemon session é o ouvidor nativo)"
        fi
    done
    sleep 1
    tlog "bars E134: supervisor(es) do uid $_uid ENCERRADO(S) — o órfão do lock morreu junto; UM novo nasce agora (exec elite-daemon session — E135)"
    runuser -u "#$_uid" -- env \
        XDG_RUNTIME_DIR="/run/user/$_uid" \
        WAYLAND_DISPLAY="$_wd" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$_uid/bus" \
        HOME="$_home" \
        /usr/local/bin/craft-bars >/dev/null 2>&1 &
    tlog "bars E134: craft-bars NOVO nascido na sessão do uid $_uid (waybar + dock Rust + toplevel + idle voltam em ≤5s, com o código da dose)"
done

# ── 13. E134 — O CHAVEIRO DO GNOME SAI DA CASA (a ordem do dono, dump ──
#      1.0-80: 'gkr-pam: unable to locate daemon control file' no SDDM,
#      CENTENAS de gcr-prompter no dock.log, senha pedida no Bazaar). A
#      casa não é GNOME: o Secret Service não presta serviço aqui e só
#      gera prompt fantasma. Idempotente em três gestos:
#        (a) as units de USUÁRIO são MASCARADAS (global + o drop do
#            ~/.config/systemd/user de cada usuário — symlink /dev/null,
#            reversível com unmask) e as instâncias vivas são encerradas;
#        (b) as linhas pam_gnome_keyring.so SAEM do /etc/pam.d/sddm e
#            do /etc/pam.d/login (backup .bak- ao lado — a escola bak-);
#        (c) o PACOTE sai pela higiene do craft-update --sistema (NUNCA
#            aqui: o db.lck da própria transação mataria o pacman dentro
#            de scriptlet — a lição E132 documentada na higiene_e132).
#      Os apps Chromium/Electron usam --password-store=basic (o conf
#      viaja pelo elite-post-transaction) — nenhuma senha a perder.
systemctl --global mask gnome-keyring-daemon.service gnome-keyring-daemon.socket gcr-prompter.service >/dev/null 2>&1 \
    && tlog "keyring E134: units de usuário gnome-keyring-daemon/gcr-prompter MASCARADAS globalmente (o daemon não nasce mais em NENHUM login)" \
    || tlog "keyring E134: mask global falhou (réu nomeado — as unidades seguem; a próxima dose re-tenta)"
for _pamd in /etc/pam.d/sddm /etc/pam.d/login; do
    if [ -f "$_pamd" ] && grep -q 'pam_gnome_keyring.so' "$_pamd" 2>/dev/null; then
        cp -p "$_pamd" "${_pamd}.bak-e134-$(date +%s)" 2>/dev/null || true
        if sed -i '/pam_gnome_keyring\.so/d' "$_pamd" 2>/dev/null; then
            tlog "keyring E134: pam_gnome_keyring.so SAIU do $_pamd (o 'gkr-pam: unable to locate daemon control file' do SDDM morre; o .bak- ao lado devolve)"
        fi
    fi
done
loginctl list-users --no-legend 2>/dev/null | while read -r _uid _ _; do
    [ -n "$_uid" ] || continue
    [ "$_uid" -ge 1000 ] 2>/dev/null || continue
    _home="$(getent passwd "$_uid" 2>/dev/null | cut -d: -f6)"
    [ -n "$_home" ] && [ -d "$_home" ] || continue
    mkdir -p "$_home/.config/systemd/user" 2>/dev/null || true
    for _u in gnome-keyring-daemon.service gnome-keyring-daemon.socket gcr-prompter.service; do
        ln -sf /dev/null "$_home/.config/systemd/user/$_u" 2>/dev/null || true
    done
    chown -R "$_uid:$_uid" "$_home/.config/systemd/user" 2>/dev/null || true
    for _proc in gnome-keyring-daemon gcr-prompter; do
        if pgrep -u "$_uid" -x "$_proc" >/dev/null 2>&1; then
            pkill -u "$_uid" -x "$_proc" 2>/dev/null || true
            tlog "keyring E134: $_proc do uid $_uid ENCERRADO (o diálogo fantasma que pedia senha no Bazaar morre com ele)"
        fi
    done
done

tlog "post-upgrade: concluído (a migração é idempotente — rodar de novo é no-op com papel)"
exit 0
