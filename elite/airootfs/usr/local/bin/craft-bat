#!/usr/bin/env bash
# craft-bat — resumo da bateria em notificação (notebooks — chame do
# terminal/launcher ou do clique no módulo de bateria da waybar)
#
# v2.10.5 — A BATERIA QUE RESPONDE (auditoria de simulações, persona
# "notebook na bateria"):
#   1. O 'set -euo pipefail' + 'grep -m1' MATAVA o script CALADO quando
#      não há bateria: o grep rc=1 dentro de $() disparava o set -e
#      ANTES da linha da mensagem amigável — a mensagem era código morto
#      (provado em sandbox: zero saída, exit 1).
#   2. UPOWER SAIU DA EQUAÇÃO: /sys/class/power_supply é kernel puro —
#      sem dependência, sem daemon, sem o 'upower ausente' (o upower não
#      estava na ISO e o docs/SCRIPTS.md jurava /sys — agora o código
#      concorda com o contrato).
set -u

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
uso() {
    printf '%s\n' \
        'uso: craft-bat — resumo da bateria em notificação (/sys puro, sem' \
        '     upower)' \
        '' \
        '  chamado pelo clique no módulo de bateria da waybar (ou do terminal).' \
        '  Sem bateria (desktop): recusa amigável com rc 1.'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac
bat=""
for d in /sys/class/power_supply/BAT*; do
    [ -d "$d" ] && bat="$d" && break
done
if [ -z "$bat" ]; then
    echo "✖ nenhuma bateria encontrada (é um notebook?)" >&2
    exit 1
fi
pct="$(cat "$bat/capacity" 2>/dev/null || echo '?')"
st="$(cat "$bat/status" 2>/dev/null || echo '?')"
case "$st" in
    Charging|Full)  icon="⚡" ;;
    Discharging)    icon="🔋" ;;
    *)              icon="🔋" ;;
esac
msg="$icon ${pct}% · $st"
if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 4000 "Bateria" "$msg"
else
    echo "$msg"
fi
