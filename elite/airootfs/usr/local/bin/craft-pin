#!/usr/bin/env bash
# craft-pin — fixa (pin) apps na DOCK da Elite (waybar config.dock + CSS)
#
# A dock tem: launchers fixos do skel + separador + janelas abertas (wlr/
# taskbar — que não tem pin nativo) — TUDO num grupo central (v2.1, modelo
# macOS). Este script adiciona/remove launchers SEM quebrar o JSONC: um
# pin = 1 linha na seção PINS do config.dock + 1 entrada no
# "modules-center" (ANTES do "custom/sep" — junto aos fixos) + 1 bloco
# CSS autocontido no style.dock.css (mesmo DNA visual dos fixos: glyph
# 30px, zoom 34px no hover). Backups .bak.<ts> de ambos; `restore`
# desfaz a última alteração.
#
# uso:
#   craft-pin list                                  apps fixados
#   craft-pin add NOME GLYPH TOOLTIP COMANDO [cor]  fixa um app
#   craft-pin rm NOME                               desfixa
#   craft-pin reload                                recarrega as barras
#   craft-pin restore                               desfaz a última alteração
#
# exemplos:
#   craft-pin add steam   ''  Steam    steam     green
#   craft-pin add discord ''  Discord  discord   mauve
#   craft-pin add code    ''  VS Code  code      sky
#
# NOME:  só [a-z0-9-] (vira o id do botão, custom/pin-NOME)
# GLYPH: glifo Nerd Font — cheatsheet: nerdfonts.com/cheat-sheet
# COR:   nome Catppuccin definido no style.dock.css (mauve red maroon peach
#        yellow green teal sky sapphire blue lavender pink flamingo
#        rosewater …); padrão mauve
#
# Reload (v1.8.2) = reinício do waybar (o SIGUSR2 do waybar 0.15 só
# recarrega CSS — o config novo nunca entrava); o craft-bars devolve as
# duas barras em ≤5s já com os pins. Sem waybar rodando, só avisa.
#
# INDICADOR DE ABERTO (v1.8 — a spec do dono: "indicador de programa fixado
# que está aberto"): TODO pin (de fábrica e do usuário) é um módulo custom
# com return-type json alimentado pelo craft-pin-status (1 pgrep a cada 3s
# — sem rede; o contrato anti-exec da v1.6.2 virou NARROW: só é permitido
# exec = craft-pin-status). class="running" acende a barra sob o ícone
# (style.dock.css .running). O PROCNAME do pgrep = 1º word do COMANDO —
# para apps cujo binário difere do comando, informe o comando do binário.
# Limite honesto restante vs macOS: o clique no pin abre nova instância
# (o waybar 0.15 não expõe ativação externa de toplevel e não há wlrctl
# no Arch) — o FOCO de janelas abertas segue no taskbar da direita (clique
# foca, meio fecha, dir minimiza), como em qualquer OS.
set -euo pipefail

DOCK="$HOME/.config/waybar/config.dock"
STYLE="$HOME/.config/waybar/style.dock.css"
POINTER="$HOME/.config/waybar/.craft-pin-last"

CORES=" rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0 surface2 surface1 surface0 base mantle crust "

die() { echo "✖ $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
craft-pin — fixa apps na DOCK da Elite (waybar)

uso:
  craft-pin list                                  apps fixados
  craft-pin add NOME GLYPH TOOLTIP COMANDO [cor]  fixa um app
  craft-pin rm NOME                               desfixa
  craft-pin reload                                recarrega as barras (SIGUSR2)
  craft-pin restore                               desfaz a última alteração

exemplos:
  craft-pin add steam   ''  Steam    steam     green
  craft-pin add discord ''  Discord  discord   mauve
  craft-pin add code    ''  VS Code  code      sky

NOME: só [a-z0-9-]. GLYPH: glifo Nerd Font (nerdfonts.com/cheat-sheet).
COR: nome Catppuccin do style.dock.css (mauve red peach yellow green teal
sky lavender blue pink …); padrão mauve. Toda alteração grava .bak.<ts>
dos dois arquivos — craft-pin restore volta o estado anterior.
EOF
  exit "${1:-0}"
}

jesc() { # <string> → escapes de \ e " para dentro de string JSON
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

bak() { # grava .bak.<ts> de config+css e registra o ts no ponteiro
  local ts
  ts="$(date +%Y%m%d-%H%M%S).$$"
  cp -a "$DOCK"  "$DOCK.bak.$ts"
  cp -a "$STYLE" "$STYLE.bak.$ts"
  printf '%s\n' "$ts" > "$POINTER"
}

rollback() { # restaura o último backup (estado ANTES da alteração atual)
  local ts
  ts="$(cat "$POINTER" 2>/dev/null || true)"
  [ -n "$ts" ] || return 0
  cp -a "$DOCK.bak.$ts"  "$DOCK"  2>/dev/null || true
  cp -a "$STYLE.bak.$ts" "$STYLE" 2>/dev/null || true
  rm -f "$POINTER"
}

reload() {
  # v1.8.2 — RELOAD DE VERDADE (flagrante do dono: "fixou, mas a dock não
  # atualizou"). O SIGUSR2 no waybar 0.15 recarrega SÓ O CSS (man 5 waybar:
  # "Reload the waybar css style") — o NOVO módulo do pin nunca entrava até
  # a sessão reiniciar. Curar = reiniciar o waybar inteiro: o craft-bars
  # (supervisor) relança as 2 instâncias em ≤5s JÁ LENDO o config novo.
  if pgrep -x waybar >/dev/null 2>&1; then
    pkill -x waybar || true
    echo "→ dock recarregada (waybar reiniciado — o craft-bars devolve as 2 barras em ≤5s com o config novo)"
  else
    echo "→ waybar não está rodando; os pins aparecem ao entrar na sessão"
  fi
}

sanity_config() { # tripwire: chaves/colchetes equilibrados + pin coerente
  local o c defs mods
  o="$(tr -cd '{' < "$DOCK" | wc -c)"; c="$(tr -cd '}' < "$DOCK" | wc -c)"
  [ "$o" -eq "$c" ] || return 1
  o="$(tr -cd '[' < "$DOCK" | wc -c)"; c="$(tr -cd ']' < "$DOCK" | wc -c)"
  [ "$o" -eq "$c" ] || return 1
  defs="$(grep -c '^  "custom/pin-' "$DOCK" || true)"
  mods="$(sed -n '/^  "modules-center": \[/,/^  \],/p' "$DOCK" | grep -c '"custom/pin-' || true)"
  [ "$defs" -eq "$mods" ] || return 1
  return 0
}

ensure_marker() { # seção PINS ausente (skel antigo/mão) → cria antes do } final
  if grep -q 'PINS (craft-pin)' "$DOCK"; then return 0; fi
  local tmp="$DOCK.tmp"
  awk '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = NR; i >= 1; i--)
        if (lines[i] ~ /^[[:space:]]*\}[[:space:]]*$/) { last = i; break }
      if (last == 0) exit 3
      for (i = 1; i <= NR; i++) {
        if (i == last) print "  // ── PINS (craft-pin) — apps fixados pelo usuário; use craft-pin add/rm"
        print lines[i]
      }
    }' "$DOCK" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$DOCK"
}

list_pins() {
  [ -f "$DOCK" ] || die "config.dock não encontrado: $DOCK"
  local linha nome tip cmd count=0
  while IFS= read -r linha; do
    count=$((count + 1))
    nome="$(printf '%s' "$linha" | sed -E 's#^[[:space:]]*"custom/pin-([a-z0-9-]+)".*#\1#')"
    # v1.8: tooltip mora dentro do exec (craft-pin-status PROC GLIFO 'TIP')
    tip="$(printf '%s'  "$linha" | sed -n "s#.*craft-pin-status [^']* [^']* '\([^']*\)'.*#\1#p")"
    cmd="$(printf '%s' "$linha" | sed -E 's#.*"on-click": "(([^"\\]|\\.)*)".*#\1#')"
    tip=${tip//\\\"/\"}; tip=${tip//\\\\/\\}
    cmd=${cmd//\\\"/\"}; cmd=${cmd//\\\\/\\}
    printf '  %-14s %-20s %s\n' "$nome" "$tip" "$cmd"
  done < <(grep '^  "custom/pin-' "$DOCK" || true)
  [ "$count" -gt 0 ] || echo "  nenhum app fixado — craft-pin add NOME GLYPH TOOLTIP COMANDO [cor]"
}

add_pin() { # nome glyph tooltip cmd [cor]
  local nome=$1 glyph=$2 tooltip=$3 cmd=$4 cor=${5:-mauve}
  local a
  [[ "$nome" =~ ^[a-z0-9-]+$ ]] || die "NOME '$nome' inválido: use só [a-z0-9-] (ex.: steam, discord)"
  [[ -n "$glyph" ]] || die "GLYPH vazio — escolha um glifo em nerdfonts.com/cheat-sheet"
  [[ "$CORES" == *" $cor "* ]] || die "cor '$cor' não existe no style.dock.css (opções:$CORES)"
  for a in "$nome" "$glyph" "$tooltip" "$cmd"; do
    if [[ "$a" == *$'\t'* || "$a" == *$'\n'* || "$a" == *$'\r'* ]]; then
      die "argumentos não podem ter tab/quebra de linha"
    fi
  done
  # v1.8: o tooltip viaja DENTRO do exec (craft-pin-status PROC GLIFO
  # 'TOOLTIP') — apóstrofo quebraria o sh -c que o waybar executa
  case "$tooltip" in *"'"*) die "TOOLTIP não pode ter apóstrofo (o exec do indicador usa aspas simples)" ;; esac
  local proc=${cmd%% *}   # PROCNAME do pgrep = 1º word do comando
  if grep -q "\"custom/pin-$nome\"" "$DOCK"; then
    die "'$nome' já está fixado — craft-pin rm $nome primeiro"
  fi

  glyph="$(jesc "$glyph")"; tooltip="$(jesc "$tooltip")"; cmd="$(jesc "$cmd")"

  bak
  ensure_marker || { rollback; die "não consegui preparar a seção PINS do config.dock"; }

  # config.dock: 1 awk atômico — entrada no modules-center (antes do
  # separador, junto aos fixos) + linha na seção PINS + vírgulas certas
  # nos DOIS lugares (valores via ENVIRON: -v do awk processa escapes e
  # comeria o \" do JSON)
  local tmp="$DOCK.tmp"
  # v1.8: pin = módulo json do craft-pin-status (indicador de aberto) —
  # 1 LINHA SÓ (o sanity_config e o rm_pin contam com isso)
  PINLINE="  \"custom/pin-$nome\": { \"exec\": \"craft-pin-status $proc $glyph '$tooltip'\", \"return-type\": \"json\", \"interval\": 3, \"on-click\": \"$cmd\" }" \
  MODLINE="    \"custom/pin-$nome\"," \
  awk '
    { lines[NR] = $0 }
    END {
      pin = ENVIRON["PINLINE"]; mod = ENVIRON["MODLINE"]
      inarr = 0; sepidx = 0; marker = 0; lastpin = 0
      for (i = 1; i <= NR; i++) {
        if (lines[i] ~ /^  "modules-center": \[/) inarr = 1
        else if (inarr && lines[i] ~ /^  \]/) inarr = 0
        if (inarr && lines[i] ~ /"custom\/sep"/ && sepidx == 0) sepidx = i
        if (lines[i] ~ /PINS \(craft-pin\)/ && marker == 0) marker = i
        if (lines[i] ~ /^  "custom\/pin-[a-z0-9-]+": \{/) lastpin = i
      }
      if (sepidx == 0 || marker == 0) exit 3
      n = 0
      for (i = 1; i <= NR; i++) {
        if (i == sepidx) {              # v2.1: pin entra ANTES do separador
          j = n                         # (junto aos fixos; o MODLINE já sai
          while (j > 0 && out[j] ~ /^[[:space:]]*$/) j--   # com vírgula — o
          if (j > 0 && out[j] !~ /,[[:space:]]*$/) out[j] = out[j] ","  # sep vem depois)
          out[++n] = mod
          out[++n] = lines[i]
          continue
        }
        if (i == lastpin) {               # PINS: entra após o último pin
          l = lines[i]
          if (l !~ /,[[:space:]]*$/) l = l ","
          out[++n] = l; out[++n] = pin
          continue
        }
        if (i == marker && lastpin == 0) { # 1º pin: o } de cima ganha vírgula
          j = n
          while (j > 0 && out[j] ~ /^[[:space:]]*$/) j--
          if (j > 0 && out[j] !~ /,[[:space:]]*$/) out[j] = out[j] ","
          out[++n] = lines[i]; out[++n] = pin
          continue
        }
        out[++n] = lines[i]
      }
      for (j = 1; j <= n; j++) print out[j]
    }' "$DOCK" > "$tmp" || { rm -f "$tmp"; rollback; die "falha ao inserir o pin no config.dock"; }
  mv "$tmp" "$DOCK"

  # style.dock.css: bloco autocontido (mesmo DNA visual dos launchers fixos)
  cat >> "$STYLE" <<EOF || { rollback; die "falha ao escrever o bloco CSS do pin"; }

/* pin: $nome (craft-pin) */
#custom-pin-$nome {
  font-size: 27px;
  padding: 4px 10px;
  border-radius: 14px;
  color: @$cor;
  transition: background 0.15s ease, color 0.15s ease,
              font-size 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}
#custom-pin-$nome:hover {
  font-size: 32px;
  background: alpha(@surface0, 0.95);
}
#custom-pin-$nome:active {
  background: alpha(@surface2, 0.95);
}
/* end pin: $nome (craft-pin) */
EOF

  sanity_config || { rollback; die "config.dock ficou inconsistente — restaurado o backup (.bak)"; }
  reload
  echo "✔ '$nome' fixado na dock COM indicador de aberto (craft-pin rm $nome para tirar)"
}

rm_pin() { # nome
  local nome=$1
  [[ "$nome" =~ ^[a-z0-9-]+$ ]] || die "NOME '$nome' inválido"
  grep -q "\"custom/pin-$nome\"" "$DOCK" || die "'$nome' não está fixado (craft-pin list)"

  bak

  # config.dock: remove a linha do pin + a entrada do modules-center e
  # conserta as vírgulas que ficam soltas quando o removido era o último
  local tmp="$DOCK.tmp"
  NAME="$nome" \
  awk '
    { lines[NR] = $0 }
    END {
      name = ENVIRON["NAME"]
      pinre = "^  \"custom/pin-" name "\": \\{"
      modre = "^    \"custom/pin-" name "\",?[[:space:]]*$"
      target = 0; modtarget = 0
      for (i = 1; i <= NR; i++) {
        if (lines[i] ~ pinre) target = i
        if (lines[i] ~ modre) modtarget = i
      }
      if (target == 0 || modtarget == 0) exit 4
      pinhadcomma  = (lines[target]    ~ /,$/)
      modhadcomma  = (lines[modtarget] ~ /,$/)
      n = 0
      for (i = 1; i <= NR; i++) {
        if (i == target || i == modtarget) continue
        out[++n] = lines[i]
      }
      if (!pinhadcomma) { # pin removido era o último do bloco
        lastpin = 0; marker = 0
        for (i = 1; i <= n; i++) {
          if (out[i] ~ /^  "custom\/pin-[a-z0-9-]+": \{/) lastpin = i
          if (out[i] ~ /PINS \(craft-pin\)/ && marker == 0) marker = i
        }
        if (lastpin > 0) fixidx = lastpin
        else {
          fixidx = 0
          for (i = marker - 1; i >= 1; i--)
            if (out[i] !~ /^[[:space:]]*$/) { fixidx = i; break }
        }
        if (fixidx > 0) sub(/,[[:space:]]*$/, "", out[fixidx])
      }
      if (!modhadcomma) { # entrada do array era a última da seção de pins
        for (i = modtarget - 1; i > 1; i--) {
          if (lines[i] ~ /^  "modules-center": \[/) break
          if (lines[i] !~ /^[[:space:]]*$/) { sub(/,[[:space:]]*$/, "", out[i]); break }
        }
      }
      for (j = 1; j <= n; j++) print out[j]
    }' "$DOCK" > "$tmp" || { rm -f "$tmp"; rollback; die "falha ao remover o pin do config.dock"; }
  mv "$tmp" "$DOCK"

  # style.dock.css: apaga o bloco inteiro (delimitado por comentários) e a
  # linha em branco que o add deixa como separador antes dele
  tmp="$STYLE.tmp"
  if awk -v name="$nome" '
    { lines[NR] = $0 }
    END {
      n = 0; deleted = 0; skip = 0
      for (i = 1; i <= NR; i++) {
        if (!skip && lines[i] == ("/* pin: " name " (craft-pin) */")) {
          if (n > 0 && out[n] ~ /^[[:space:]]*$/) n--
          skip = 1; deleted = 1; continue
        }
        if (skip && lines[i] == ("/* end pin: " name " (craft-pin) */")) { skip = 0; continue }
        if (!skip) out[++n] = lines[i]
      }
      if (!deleted) exit 5
      for (j = 1; j <= n; j++) print out[j]
    }' "$STYLE" > "$tmp"; then
    mv "$tmp" "$STYLE"
  else
    rm -f "$tmp"
    echo "⚠ bloco CSS do pin não encontrado — config limpo, CSS intacto" >&2
  fi

  sanity_config || { rollback; die "config.dock ficou inconsistente — restaurado o backup (.bak)"; }
  reload
  echo "✔ '$nome' desfixado da dock"
}

do_restore() {
  [ -s "$POINTER" ] || die "nada para restaurar (nenhuma alteração registrada)"
  local ts
  ts="$(cat "$POINTER")"
  [ -f "$DOCK.bak.$ts" ] && [ -f "$STYLE.bak.$ts" ] || die "backup .bak.$ts não encontrado"
  cp -a "$DOCK.bak.$ts"  "$DOCK"
  cp -a "$STYLE.bak.$ts" "$STYLE"
  rm -f "$POINTER"
  reload
  echo "↩ restaurado o estado anterior a $ts"
}

[ -f "$DOCK" ]  || die "dock não encontrada: $DOCK (sessão labwc?)"
[ -f "$STYLE" ] || die "CSS da dock não encontrado: $STYLE"

case "${1:-}" in
  list)                     list_pins ;;
  add)  [ $# -ge 5 ] || usage 1; shift; add_pin "$@" ;;
  rm)   [ $# -eq 2 ] || usage 1; rm_pin "$2" ;;
  reload)                   reload ;;
  restore)                  do_restore ;;
  -h|--help|help|"")        usage 0 ;;
  *)                        usage 1 ;;
esac
