#!/usr/bin/env bash
# =====================================================================
#  elite-tune v4.2 — Archcraft Elite Edition
#  Elite A: Ryzen 7 5700X · RTX 5060 8GB · 16GB · B550M
#  Elite B: veterano — detecção automática de GPU/CPU/disco
#
#  v4.2: · scx-elite.service própria (bpfland) — 'scx.service' não existe em
#          pacote nenhum (scx-scheds = binários; scx-tools = scx_loader)
#        · dmemcg-booster-SYSTEM.service (nome real da unit)
#        · Vulkan stack AMD/Intel idempotente no firstboot
#        · mirror us.cachyos.org (mirror.cachyos.org desativado no mirrorlist
#          oficial) · repos inseridos antes de [core], não antes do [archcraft]
#
#  Modos:
#    elite-tune               → tune interativo (máquina já instalada)
#    elite-tune --firstboot   → não-interativo (unit elite-firstboot)
#    elite-tune --apps        → menu de apps do usuário
#    elite-tune --status      → certificação do sistema
#  Flags:  --dry-run (simula) | --yes (sem confirmações)
#
#  Fatos 2026 embutidos (fonte: mirror.cachyos.org + wiki):
#    · Chave GPG CachyOS: F3B607488DB35A47 (keyserver.ubuntu.com)
#    · BORE = linux-cachyos-bore | linux-cachyos = EEVDF+ThinLTO
#    · Repos: [cachyos](v2) + [cachyos-v3|core-v3|extra-v3]
#    · scx-scheds → pacote "scx-tools"; VRAM mgmt → dmemcg-booster
# =====================================================================
set -uo pipefail
G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; B='\033[1m'; N='\033[0m'
say()  { echo -e "${G}==>${N} $1"; }
warn() { echo -e "${Y}!>${N} $1"; }
err()  { echo -e "${R}X>${N} $1"; }

DRY=0; YES=0; FIRSTBOOT=0; APPS=0; STATUS=0
for a in "$@"; do
  case $a in
    --dry-run)  DRY=1 ;;
    --yes)      YES=1 ;;
    --firstboot) FIRSTBOOT=1 ;;
    --apps)     APPS=1 ;;
    --status)   STATUS=1 ;;
  esac
done

# Constantes validadas (projeto archcraft-cachyos-elite)
KERNEL_PKG="${KERNEL_PKG:-linux-cachyos-bore}"   # BORE p/ interatividade/gaming
CACHYOS_KEY="F3B607488DB35A47"
MIRROR="https://us.cachyos.org"    # listagem de dir. p/ discover_latest (mirror.cachyos.org está desativado)
PINNED_KEYRING="cachyos-keyring-20240331-1-any.pkg.tar.zst"
PINNED_V3ML="cachyos-v3-mirrorlist-27-1-any.pkg.tar.zst"
PACMAN_CONF="/etc/pacman.conf"

# ── Helpers ─────────────────────────────────────────────────────────
BK=".bak.$(date +%Y%m%d-%H%M%S)"
backup() { [[ $EUID -eq 0 && -f "$1" ]] && cp -a "$1" "$1$BK" 2>/dev/null; return 0; }
run() { echo -e "  ${B}\$${N} $*"; (( DRY )) || "$@"; return 0; }
wfile() { # wfile <dest>  (heredoc via stdin)
  local f=$1
  echo -e "  ${B}[arquivo]${N} $f"
  if (( DRY )); then cat > /dev/null; else backup "$f"; mkdir -p "$(dirname "$f")"; cat > "$f"; fi
}
confirm() { (( YES )) && return 0; local r=""; read -rp "$1 [S/n] " r || r=""; [[ ! "${r,,}" == n* ]]; }
askn()    { (( YES )) && return 0; local r=""; read -rp "$1 [s/N] " r || r=""; [[ "${r,,}" == s* ]]; }

# ── Detecção ────────────────────────────────────────────────────────
detect_hw() {
  ISA="v1"
  /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v3' && ISA="v3"
  /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v4' && ISA="v4"
  GPULINE=$(lspci 2>/dev/null | grep -Ei 'vga|3d' | head -1); GLOW=$(tr 'A-Z' 'a-z' <<< "${GPULINE:-}")
  VENDOR=unknown; GEN=unknown
  grep -q nvidia            <<< "$GLOW" && VENDOR=nvidia
  grep -qE 'amd|ati|radeon' <<< "$GLOW" && VENDOR=amd
  grep -qE 'intel'          <<< "$GLOW" && VENDOR=intel
  if command -v nvidia-smi >/dev/null 2>&1; then
    GLOW2=$(tr 'A-Z' 'a-z' <<< "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)")
    [[ -n "$GLOW2" ]] && GLOW="$GLOW $GLOW2"
  fi
  case "$GLOW" in
    *"rtx 50"*|*gb1*|*gb2*)     GEN=blackwell; VENDOR=nvidia ;;
    *"rtx 40"*|*ad1*)           GEN=ada;       VENDOR=nvidia ;;
    *"rtx 30"*|*ga1*)           GEN=ampere;    VENDOR=nvidia ;;
    *"rtx 20"*|*"gtx 16"*|*tu1*) GEN=turing;   VENDOR=nvidia ;;
    *"gtx 10"*|*gp1*)           GEN=pascal;    VENDOR=nvidia ;;
    *"gtx 9"*|*gm1*)            GEN=maxwell;   VENDOR=nvidia ;;
  esac
  MEM_GIB=$(awk '/MemTotal/{printf "%d", ($2+524288)/1048576}' /proc/meminfo)
  STICKS=$(dmidecode -t memory 2>/dev/null | awk -F: '/Size:/{if($2 ~ /GB/) n++} END{print n+0}')
  MEMSPEED=$(dmidecode -t memory 2>/dev/null | awk -F: '/Configured Clock Speed/{gsub(/[^0-9]/,"",$2); if($2+0>0){print $2; exit}}')
  CPU_AMD=0; grep -q AuthenticAMD /proc/cpuinfo && CPU_AMD=1
}

dossie() {
  echo -e "${B}══════════ DOSSIÊ DETECTADO ══════════${N}"
  echo "CPU ISA ..: $ISA $([[ $CPU_AMD == 1 ]] && echo '(AMD → amd_pstate=active)')"
  echo "GPU ......: ${GPULINE##*:} [gen=$GEN vendor=$VENDOR]"
  echo "RAM ......: ${MEM_GIB}GB | ${STICKS} pente(s) | ${MEMSPEED:-?}MHz"
}

# ── ensure_cmdline_token (inserção à prova de aspas — padrão validado) ──
ensure_cmdline_token() {
  local file=$1 token=$2
  [[ $EUID -ne 0 || $DRY -eq 1 ]] && return 0
  grep -E '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file" 2>/dev/null | grep -qF -- "$token" && return 0
  backup "$file"
  if grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file" 2>/dev/null; then
    sed -i -E "/^GRUB_CMDLINE_LINUX_DEFAULT=/ s|\"([^\"]*)\"|\"\1 ${token}\"|" "$file"
  else
    printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet %s"\n' "$token" >> "$file"
  fi
}

# ── CachyOS: chave + keyring + mirrorlist + repos (padrão validado) ──
cachyos_key_present() { pacman-key --list-keys "$CACHYOS_KEY" >/dev/null 2>&1; }

discover_latest() {
  curl -fsSL --max-time 30 "${MIRROR}/repo/x86_64/cachyos/" 2>/dev/null \
    | grep -oE "$1-[0-9][^\"]*\.pkg\.tar\.zst" | sort -Vu | tail -1 || true
}

ensure_cachyos() {
  say "CachyOS: chave + keyring + mirrorlist + repos (pacman stock preservado)"
  if ! cachyos_key_present; then
    run pacman-key --recv-keys "$CACHYOS_KEY" --keyserver keyserver.ubuntu.com
    run pacman-key --lsign-key "$CACHYOS_KEY"
  else
    say "chave $CACHYOS_KEY já importada"
  fi
  local kr ml
  kr=$(discover_latest cachyos-keyring);   [[ -n "$kr" ]] || kr="$PINNED_KEYRING"
  ml=$(discover_latest cachyos-v3-mirrorlist); [[ -n "$ml" ]] || ml="$PINNED_V3ML"
  if ! pacman -Q cachyos-keyring >/dev/null 2>&1 || ! pacman -Q cachyos-v3-mirrorlist >/dev/null 2>&1; then
    run pacman -U --noconfirm "${MIRROR}/repo/x86_64/cachyos/${kr}" "${MIRROR}/repo/x86_64/cachyos/${ml}"
  fi
  if ! grep -q '^\[cachyos-v3\]' "$PACMAN_CONF"; then
    say "Inserindo [cachyos] + trio v3 antes de [core] em $PACMAN_CONF"
    (( DRY )) && return 0
    backup "$PACMAN_CONF"
    local block tmp
    read -r -d '' block <<'EOF' || true
# >>> ELITE: CachyOS — wiki.cachyos.org/features/optimized_repos
# Trio v3 ANTES do baseline (o kernel BORE existe nos dois: baseline é x86_64)
[cachyos-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-core-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-extra-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos]
Server = https://us.cachyos.org/repo/x86_64/cachyos
Server = https://cdn77.cachyos.org/repo/x86_64/cachyos
# <<< ELITE
EOF
    tmp=$(mktemp)
    awk -v block="$block" '
      /^\[core\]/ && !done { print block; print ""; done = 1 }
      { print }
      END { if (!done) { print ""; print block } }
    ' "$PACMAN_CONF" > "$tmp"
    cat "$tmp" > "$PACMAN_CONF"; rm -f "$tmp"
  fi
  # Arquitetura: pacotes v3 do CachyOS são arch "x86_64_v3" (o "auto"
  # só aceita x86_64 — sem isso o pacman rejeita a transação)
  if ! grep -qE '^Architecture = .*\bx86_64_v3\b' "$PACMAN_CONF"; then
    say "pacman.conf: Architecture = x86_64 x86_64_v3 (necessário p/ os pacotes v3)"
    if (( ! DRY )); then
      backup "$PACMAN_CONF"
      if grep -qE '^Architecture = ' "$PACMAN_CONF"; then
        sed -i -E 's|^Architecture = .*$|Architecture = x86_64 x86_64_v3|' "$PACMAN_CONF"
      else
        sed -i '/^\[options\]/a Architecture = x86_64 x86_64_v3' "$PACMAN_CONF"
      fi
    fi
  fi
  grep -q '^\[multilib\]' "$PACMAN_CONF" || warn "ative [multilib] no pacman.conf (lib32 p/ Steam)"
  run pacman -Sy
}

# ════════════════════════════════════════════════════════════════════
# MODO --status  (certificação)
# ════════════════════════════════════════════════════════════════════
if (( STATUS )); then
  echo -e "${B}══════════ CERTIFICAÇÃO ELITE ══════════${N}"
  printf '%-22s %s\n' "kernel:" "$(uname -r)"
  printf '%-22s %s\n' "driver cpufreq:" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo '—')"
  printf '%-22s %s\n' "cmdline:" "$(cat /proc/cmdline)"
  printf '%-22s %s\n' "zram:" "$(zramctl 2>/dev/null | tail -n +2 | awk '{print $1,$3}' | tr '\n' ' ')"
  printf '%-22s %s\n' "THP:" "$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)"
  printf '%-22s %s\n' "repos cachyos:" "$(grep -oE '^\[cachyos[^]]*\]' $PACMAN_CONF 2>/dev/null | tr '\n' ' ')"
  echo ""
  for s in scx-elite ananicy-cpp fg-booster dmemcg-booster-system grub-btrfsd lactd elite-firstboot; do
    printf 'service %-15s %s\n' "$s" "$(systemctl is-active $s.service 2>/dev/null || echo inactive)"
  done
  echo ""
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
    nvidia-smi -q 2>/dev/null | grep -A2 'BAR1' | grep -E 'Total|Current' | head -2
  else
    echo "GPU: ${GPULINE:-$(lspci 2>/dev/null | grep -Ei 'vga|3d' | head -1)}"
  fi
  echo ""
  echo "fg-boost.slice: $(wc -l < /sys/fs/cgroup/fg-boost.slice/cgroup.procs 2>/dev/null) pid(s) no slice turbinado"
  echo "firstboot:      $([[ -f /var/lib/elite/firstboot-done ]] && echo 'concluído' || echo 'pendente/não-ISO')"
  echo ""
  echo "Verificações manuais: systemd-cgls /fg-boost.slice | nvtop | elite-tune --apps"
  exit 0
fi

[[ $EUID -eq 0 ]] || { echo "Execute com sudo (exceto --status)."; exit 1; }
detect_hw

# ════════════════════════════════════════════════════════════════════
# MODO --apps  (menu de apps — "baixo só o que vou usar")
# ════════════════════════════════════════════════════════════════════
if (( APPS )); then
  echo -e "${B}══════════ ELITE APPS ══════════${N}"
  echo " 1) Steam (gaming)          4) Criação (GIMP/Inkscape/Kdenlive)"
  echo " 2) Lutris + Wine           5) Escritório (LibreOffice/Thunderbird)"
  echo " 3) OBS Studio              0) Sair"
  local_ok=""; read -rp "Escolha: " local_ok || local_ok=""
  case "$local_ok" in
    1) run pacman -S --needed --noconfirm steam protontricks ;;
    2) run pacman -S --needed --noconfirm lutris wine-staging winetricks ;;
    3) run pacman -S --needed --noconfirm obs-studio ;;
    4) run pacman -S --needed --noconfirm gimp inkscape kdenlive ;;
    5) run pacman -S --needed --noconfirm libreoffice-fresh thunderbird ;;
    *) say "Nada instalado."; exit 0 ;;
  esac
  say "Concluído. Steam: ative Shader Pre-Caching nas configurações."
  exit 0
fi

# ════════════════════════════════════════════════════════════════════
# MODO --firstboot  (unit systemd — sistema recém-instalado da ISO)
# ════════════════════════════════════════════════════════════════════
if (( FIRSTBOOT )); then
  say "ELITE FIRSTBOOT — hardware: ISA=$ISA GPU=$VENDOR/$GEN RAM=${MEM_GIB}GB"
  [[ "$ISA" == "v1" || "$ISA" == "v2" ]] && \
    err "CPU não reporta x86-64-v3 — esta ISO é v3 (legal instruction pode falhar). Considere a ISO padrão do Archcraft."

  # 1. keyring fresco (ISO pode ter meses)
  run pacman -Sy --noconfirm archlinux-keyring || true

  # 2. driver de vídeo
  case "$VENDOR:$GEN" in
    nvidia:blackwell|nvidia:ada|nvidia:ampere|nvidia:turing)
      say "NVIDIA $GEN → nvidia-open-dkms (dkms cobre o kernel BORE E o fallback do Arch)"
      run pacman -R --noconfirm nvidia-open 2>/dev/null || true
      run pacman -S --needed --noconfirm nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils
      ;;
    nvidia:pascal|nvidia:maxwell)
      say "NVIDIA $GEN → tentando nvidia-dkms (branch 580 = última p/ Maxwell/Pascal)"
      run pacman -R --noconfirm nvidia-open 2>/dev/null || true
      if ! pacman -S --needed --noconfirm nvidia-dkms nvidia-utils lib32-nvidia-utils; then
        warn "pacote nvidia-dkms indisponível p/ $GEN. Rode manualmente:"
        warn "  paru -S nvidia-580xx-dkms && sudo elite-tune --yes"
      fi
      ;;
    amd:*)
      say "AMD → mesa/RADV (vulkan-radeon assado na ISO Elite; --needed = no-op)"
      run pacman -S --needed --noconfirm mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon || true
      wfile /etc/modprobe.d/00-elite-amdgpu.conf <<'EOF'
# ── ELITE: AMD — destrava undervolt/OC p/ LACT/CoreCtrl
options amdgpu ppfeaturemask=0xffffffff
EOF
      ;;
    intel:*)
      say "Intel → mesa/ANV (vulkan-intel assado na ISO Elite; --needed = no-op)"
      run pacman -S --needed --noconfirm mesa lib32-mesa vulkan-intel || true
      ;;
    *)
      warn "GPU não identificada ($GPULINE) — nenhum driver extra instalado"
      ;;
  esac
  if [[ "$VENDOR" == "nvidia" ]]; then
    wfile /etc/modprobe.d/00-elite-nvidia.conf <<'EOF'
# ── ELITE: NVIDIA (modeset+fbdev p/ Wayland/gamescope; VRAM preservada em suspend)
options nvidia-drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
EOF
    run systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service nvidia-persistenced.service || true
  fi

  # 3. serviços de tuning
  run systemctl enable --now ananicy-cpp.service || true
  # sched-ext: unit própria scx-elite (bpfland). Trocar scheduler:
  #   sudo systemctl edit scx-elite  →  ExecStart=/usr/bin/scx_lavd
  if [[ ! -f /etc/systemd/system/scx-elite.service ]]; then
    wfile /etc/systemd/system/scx-elite.service <<'EOF'
[Unit]
Description=Elite: sched-ext bpfland (games first)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/scx_bpfland
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
    run systemctl daemon-reload
  fi
  run systemctl enable --now scx-elite.service || warn "scx-elite: falhou (kernel sem sched-ext?)"
  run systemctl enable --now dmemcg-booster-system.service 2>/dev/null \
    || warn "dmemcg-booster-system: unit não encontrada (pacman -Ql dmemcg-booster | grep service)"
  run systemctl enable --now fg-boost.slice fg-booster.service || true
  run systemctl enable --now grub-btrfsd.service 2>/dev/null || true
  run systemctl enable --now lactd.service 2>/dev/null || true

  # 4. tokens de kernel (GRUB) — inserção à prova de aspas
  (( CPU_AMD )) && ensure_cmdline_token /etc/default/grub amd_pstate=active
  ensure_cmdline_token /etc/default/grub nowatchdog
  ensure_cmdline_token /etc/default/grub zswap.enabled=0
  ensure_cmdline_token /etc/default/grub transparent_hugepage=always
  run grub-mkconfig -o /boot/grub/grub.cfg

  # 5. self-disable + marker + aviso
  mkdir -p /var/lib/elite && touch /var/lib/elite/firstboot-done
  run systemctl disable elite-firstboot.service || true
  say "FIRSTBOOT CONCLUÍDO — log: /var/log/elite-firstboot.log"
  if [[ "$VENDOR" == "nvidia" ]]; then
    wall "ELITE: driver NVIDIA instalado. REINICIE para ativar (o atual usa o módulo antigo/nouveau)." 2>/dev/null || true
  else
    wall "ELITE: primeiro boot concluído (serviços de tuning ativos). Reboot recomendado." 2>/dev/null || true
  fi
  exit 0
fi

# ════════════════════════════════════════════════════════════════════
# MODO PADRÃO (interativo — enxerto em qualquer Arch/Archcraft)
# ════════════════════════════════════════════════════════════════════
dossie
(( STICKS == 1 )) && err "SINGLE-CHANNEL! Um 2º pente de RAM = +10-15% fps (verifique dmidecode)"
[[ -n "${MEMSPEED:-}" ]] && (( MEMSPEED < 3000 )) && warn "RAM @ ${MEMSPEED}MHz → ligue DOCP/XMP na BIOS"
[[ "$ISA" == "v1" ]] && err "CPU pré-v2: use kernel linux/linux-lts do Arch (CachyOS exige v2+)"

confirm "Aplicar o Elite Tune neste hardware?" || exit 0

# ── [1] CachyOS + kernel BORE (fallback 'linux' permanece) ─────────
ensure_cachyos
run pacman -S --needed --noconfirm "$KERNEL_PKG" "${KERNEL_PKG}-headers" linux-headers
run pacman -S --needed --noconfirm cachyos-settings cachyos-ananicy-rules ananicy-cpp scx-scheds scx-tools dmemcg-booster

# ── [2] Daemons ─────────────────────────────────────────────────────
run systemctl enable --now ananicy-cpp.service || true
if [[ ! -f /etc/systemd/system/scx-elite.service ]]; then
  wfile /etc/systemd/system/scx-elite.service <<'EOF'
[Unit]
Description=Elite: sched-ext bpfland (games first)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/scx_bpfland
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
  run systemctl daemon-reload
fi
run systemctl enable --now scx-elite.service || true
run systemctl enable --now dmemcg-booster-system.service 2>/dev/null || true

# ── [3] Boot params ────────────────────────────────────────────────
(( CPU_AMD )) && ensure_cmdline_token /etc/default/grub amd_pstate=active
ensure_cmdline_token /etc/default/grub nowatchdog
ensure_cmdline_token /etc/default/grub zswap.enabled=0
ensure_cmdline_token /etc/default/grub transparent_hugepage=always
run grub-mkconfig -o /boot/grub/grub.cfg

# ── [4] GPU ─────────────────────────────────────────────────────────
if [[ "$VENDOR" == "nvidia" ]]; then
  DRIVER=nvidia-open-dkms; GSPOPT=fixed
  case "$GEN" in
    pascal|maxwell) DRIVER=nvidia-dkms ;;
    turing|ampere)
      if askn "Turing/Ampere: driver FECHADO p/ recuperar 200-400MB de VRAM (GSP off)? (padrão: open)"; then
        DRIVER=nvidia-dkms; GSPOPT=off
      fi ;;
  esac
  say "NVIDIA $GEN → $DRIVER"
  run pacman -R --noconfirm nvidia-open 2>/dev/null || true
  if ! pacman -Qqs "^${DRIVER}$" >/dev/null 2>&1; then
    if (( DRY )); then
      echo "  \$ pacman -S --needed --noconfirm $DRIVER nvidia-utils nvidia-settings lib32-nvidia-utils"
    elif ! pacman -S --needed --noconfirm "$DRIVER" nvidia-utils nvidia-settings lib32-nvidia-utils; then
      [[ "$GEN" == pascal || "$GEN" == maxwell ]] && \
        warn "Para $GEN: paru -S nvidia-580xx-dkms (AUR) e rode elite-tune de novo"
    fi
  fi
  wfile /etc/modprobe.d/00-elite-nvidia.conf <<EOF
# ── ELITE: NVIDIA
options nvidia-drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
$( [[ "$GSPOPT" == "off" ]] && echo 'options nvidia NVreg_EnableGpuFirmware=0   # GSP off: recupera 200-400MB (fechado em Turing/Ampere)' )
EOF
  run systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service nvidia-persistenced.service || true
elif [[ "$VENDOR" == "amd" ]]; then
  run pacman -S --needed --noconfirm mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon radeontop
  wfile /etc/modprobe.d/00-elite-amdgpu.conf <<'EOF'
# ── ELITE: AMD — destrava undervolt/OC p/ LACT/CoreCtrl
options amdgpu ppfeaturemask=0xffffffff
EOF
fi

# ── [5] Memória + I/O (idempotente — na ISO já vêm assados) ───────
ZMB=$(( MEM_GIB * 1024 )); (( ZMB > 8192 )) && ZMB=8192
run pacman -S --needed --noconfirm zram-generator
wfile /etc/systemd/zram-generator.conf <<EOF
[zram0]
zram-size = ${ZMB}M
compression-algorithm = zstd
EOF
run systemctl daemon-reload
run systemctl start systemd-zram-setup@zram0.service || true

wfile /etc/sysctl.d/99-elite.conf <<'EOF'
# ── ELITE: sysctl de gaming
vm.swappiness = 180
vm.vfs_cache_pressure = 50
vm.page_lock_unfairness = 1
vm.max_map_count = 2147483642
kernel.sched_autogroup_enabled = 1
EOF
run sysctl --system || true

wfile /etc/udev/rules.d/60-io-elite.rules <<'EOF'
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF
run udevadm control --reload || true

# ── [6] fg-booster (nosso foreground-booster X11) ──────────────────
run pacman -S --needed --noconfirm xdotool
if [[ ! -x /usr/local/bin/fg-booster ]]; then
  say "fg-booster: binário não encontrado — na ISO Elite ele já vem assado."
  warn "instalação manual: copie fg-booster+units do repo archcraft-elite"
fi
wfile /etc/systemd/system/fg-boost.slice <<'EOF'
[Unit]
Description=Elite: slice turbinado para o app em foco

[Slice]
CPUWeight=900
IOWeight=900

[Install]
WantedBy=multi-user.target
EOF
run systemctl daemon-reload
run systemctl enable --now fg-boost.slice fg-booster.service || true

# ── [7] Stack de jogo + ferramentas ─────────────────────────────────
run pacman -S --needed --noconfirm gamemode lib32-gamemode gamescope \
  mangohud lib32-mangohud grub-btrfs timeshift nvtop lact
run systemctl enable --now lactd.service 2>/dev/null || true
run systemctl enable --now grub-btrfsd.service 2>/dev/null || true

# ── [8] Shader cache NVIDIA ─────────────────────────────────────────
if [[ "$VENDOR" == "nvidia" ]]; then
  backup /etc/environment
  for v in __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1 __GL_SHADER_DISK_CACHE_SIZE=1073741824; do
    (( DRY )) || grep -qxF "$v" /etc/environment 2>/dev/null || echo "$v" >> /etc/environment
  done
fi

say "CONCLUÍDO. Reboot e depois: sudo elite-tune --status"
echo "Apps opcionais: sudo elite-tune --apps"
