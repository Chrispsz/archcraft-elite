#!/usr/bin/env bash
# =====================================================================
#  elite-tune v4.9 — Archcraft Elite Edition
#  Elite A: Ryzen 7 5700X · RTX 5060 8GB · 16GB · B550M
#  Elite B: veterano — detecção automática de GPU/CPU/disco
#
#  v4.9 (E37 — FATORAÇÃO DOS ESPELHOS, plano ARQUITETURA nº1 + nº16):
#        · 4 pares gêmeos firstboot↔interativo viraram FUNÇÃO ÚNICA
#          chamada pelos DOIS modos: apply_grub_tokens, write_elite_sysctl,
#          ensure_bbr, ensure_btrfs_stack — a doença que o E33 flagrou (o
#          interativo carregava o guard do snapper por exit code que o D6
#          já matara no firstboot, sob o comentário 'o MESMO GUARD') não
#          pode renascer: revisar um caminho É revisar o outro, e a suíte
#          crava o espelho novo (def 1×, chamada 2×, zero cópia viva).
#        · BBR no firstboot: a limpeza do sysctl agora respeita o --dry-run
#          (dry é seco, v4.4 — o sed/rm rodavam até seco).
#        · nº16: epílogo HONESTO no interativo — pacman_s com rc real
#          alimenta FAILURES; falha vira 'PENDÊNCIA: …' na hora e
#          'CONCLUÍDO COM N PENDÊNCIA(S)' no fim (o 'CONCLUÍDO'
#          incondicional vendia como instalado o que o pacman não baixou).
#          O eco do plano (  $ pacman …) passa a existir TAMBÉM no modo
#          real do pacman_s — o rc real não pode custar a linha do plano.
#
#  v4.8 (v2.3.4 — FIM DO INSTALADOR NO INSTALADO): o unpackfs copia o root
#        do LIVE inteiro p/ o disco — o Calamares e o atalho "Instalar o
#        Archcraft" chegavam ao sistema instalado e ficavam para sempre
#        ("ficou o botão instalar archcraft ainda no menu de aplicativos",
#        dono). Passo 2d do firstboot (exclusivo do INSTALADO — o live
#        precisa do Calamares): pacote + atalho + wrappers + /etc/calamares
#        fora. Idempotente e best-effort.
#
#  v4.7 (v2.2 — FUSÃO DOS BOOSTERS 4→1, diretriz do dono — leveza radical):
#        · ananicy-cpp é o ÚNICO daemon de boost: regras oficiais CachyOS
#          (cachyos-ananicy-rules) aplicando nice/ionice por processo.
#        · o scheduler é o BORE do KERNEL — scx-scheds/scx-tools e a unit
#          scx-elite (bpfland userspace) saíram: um scheduler userspace
#          SOBRESCREVE o BORE; dois escalonadores = luta de autoridade e
#          ~15 MB de RAM para decisão duplicada.
#        · dmemcg-booster e o fg-booster próprio (poll xdotool + slice)
#          saíram — o xdotool saiu junto. Boost de jogo = gamemode
#          (on-demand, o que o mecanismo de cgroup tentava fazer pior).
#        · lib32 da ISO virou ON-DEMAND: este modo (--firstboot/graft)
#          segue recolocando o stack do vendor (mesmos comandos de
#          sempre) — a ISO nasce 64-bit puro.
#
#  v4.6: · v1.1 MEGA PROMPT — a ISO embarca o nvidia-open-dkms PRÉ-COMPILADO
#          contra o kernel BORE (E11): no rig NVIDIA o firstboot DETECTA os
#          módulos já presentes e NÃO instala nada (1º boot 100% offline,
#          marker na primeira passada); o caminho online vira só fallback
#          p/ sistema não-ISO/desatualizado.
#        · gpu_cleanup_foreign: rig AMD/Intel também remove o nvidia-open-dkms
#          e os .ko pré-compilados de /usr/lib/modules/*/updates/dkms
#          (v1.1: o dkms viaja na ISO p/ ambos os rigs — quem não é NVIDIA
#          não carrega nem um byte de driver alheio no disco).
#        · rede: BBR+fq (sysctl.d 99-elite-net + modules-load tcp_bbr) —
#          firstboot CONFIRMA que o kernel oferece bbr; senão tira do
#          sysctl.d (cubic fica) em vez de falhar silencioso.
#
#  v4.5: · firstboot NVIDIA sem rede não BRICA o driver: o nvidia-open-dkms
#          é instalado ANTES de destronar o nvidia-open pré-compilado (a
#          ordem antiga era -R → -S: sem rede no 1º boot o rig ficava sem
#          driver NENHUM). Falha no -S → driver do live preservado + marker
#          NÃO escrito → elite-firstboot re-tenta no próximo boot com rede.
#        · wall honesto: "REINICIE" só quando o driver foi trocado de fato;
#          sem rede avisa para conectar e reiniciar em vez de mentir.
#
#  v4.4: · "dry é seco" DE VERDADE (3 side-effects pegados pela suíte):
#          · backup() ignorava --dry-run → criava /etc/*.bak.* em simulação
#          · marker firstboot-done era tocado no --dry-run (e o say do [dry]
#            agora avisa em vez de mentir silenciosamente)
#          · wall() transmitia "REINICIE" para todos os ttys mesmo em dry
#
#  v4.3: · fix detecção de vendor: '\b(amd|ati|radeon)\b' — o 'ati' solto
#          casava dentro de 'compatible' e 'Corporation' (toda linha lspci
#          diz 'VGA compatible controller'!) e classificava GPU NV/desconhecida
#          como AMD. Pegado pela suíte de testes (tests/, peça nv-device-bare
#          + matrox); mesmo bug já corrigido no archcraft-cachyos-elite.
#
#  v4.2: · scx-elite.service própria (bpfland) [v4.7: EXTINTA — a fusão
#          dos boosters acabou com o sched-ext userspace; o scheduler da
#          Elite é o BORE do kernel, custo zero em userspace]
#        · dmemcg-booster-SYSTEM.service (nome real da unit) [v4.7: idem]
#        · Vulkan stack AMD/Intel idempotente no firstboot
#        · mirror us.cachyos.org (mirror.cachyos.org desativado no mirrorlist
#          oficial) · repos inseridos antes de [core], não antes do [archcraft]
#
#  Modos:
#    elite-tune               → tune interativo (máquina já instalada)
#    elite-tune --firstboot   → não-interativo (unit elite-firstboot)
#    elite-tune --apps        → menu de apps do usuário
#    elite-tune --status      → certificação do sistema
#  Flags:  --dry-run (simula) | --yes (sem confirmações)
#
#  Fatos 2026 embutidos (fonte: mirror.cachyos.org + wiki):
#    · Chave GPG CachyOS: F3B607488DB35A47 (keyserver.ubuntu.com)
#    · BORE = linux-cachyos-bore | linux-cachyos = EEVDF+ThinLTO
#    · Repos: [cachyos](v2) + [cachyos-v3|core-v3|extra-v3]
# =====================================================================
set -uo pipefail
G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; B='\033[1m'; N='\033[0m'
say()  { echo -e "${G}==>${N} $1"; }
warn() { echo -e "${Y}!>${N} $1"; }
err()  { echo -e "${R}X>${N} $1"; }
note_fail() { # E37/n16: pendência anunciada NA HORA e no epílogo
  FAILURES+=("$1"); warn "PENDÊNCIA: $1"
}

DRY=0; YES=0; FIRSTBOOT=0; APPS=0; STATUS=0
FAILURES=()   # E37/n16: memória de pendências do modo interativo (epílogo honesto)
for a in "$@"; do
  case $a in
    --dry-run)  DRY=1 ;;
    --yes)      YES=1 ;;
    --firstboot) FIRSTBOOT=1 ;;
    --apps)     APPS=1 ;;
    --status)   STATUS=1 ;;
  esac
done

# Constantes validadas (projeto archcraft-cachyos-elite)
KERNEL_PKG="${KERNEL_PKG:-linux-cachyos-bore}"   # BORE p/ interatividade/gaming
CACHYOS_KEY="F3B607488DB35A47"
MIRROR="https://us.cachyos.org"    # listagem de dir. p/ discover_latest (mirror.cachyos.org está desativado)
PINNED_KEYRING="cachyos-keyring-20240331-1-any.pkg.tar.zst"
PINNED_V3ML="cachyos-v3-mirrorlist-27-1-any.pkg.tar.zst"
PACMAN_CONF="/etc/pacman.conf"

# ── Helpers ─────────────────────────────────────────────────────────
BK=".bak.$(date +%Y%m%d-%H%M%S)"
backup() { (( DRY )) && return 0; [[ $EUID -eq 0 && -f "$1" ]] && cp -a "$1" "$1$BK" 2>/dev/null; return 0; }
run() { echo -e "  ${B}\$${N} $*"; (( DRY )) || "$@"; return 0; }
pacman_s() { # pacman -S com código de retorno REAL (run() engole rc por design)
  # v4.5: fluxos que DECIDEM algo (troca de driver) precisam do rc de
  # verdade. --dry-run: NÃO executa (dry é seco, v4.4) — simulado = OK,
  # o plano segue como se a rede existisse.
  # v4.9/E37: o eco do plano existe TAMBÉM no modo real (contrato visual
  # da casa — o rc real não pode custar a linha '  $ pacman …').
  if (( DRY )); then say "[dry] pacman -S --needed --noconfirm $* (simulado: OK)"; return 0; fi
  echo -e "  ${B}\$${N} pacman -S --needed --noconfirm $*"
  pacman -S --needed --noconfirm "$@"
}
wfile() { # wfile <dest>  (heredoc via stdin)
  local f=$1
  echo -e "  ${B}[arquivo]${N} $f"
  if (( DRY )); then cat > /dev/null; else backup "$f"; mkdir -p "$(dirname "$f")"; cat > "$f"; fi
}
confirm() { (( YES )) && return 0; local r=""; read -rp "$1 [S/n] " r || r=""; [[ ! "${r,,}" == n* ]]; }
askn()    { (( YES )) && return 0; local r=""; read -rp "$1 [s/N] " r || r=""; [[ "${r,,}" == s* ]]; }

# ── Detecção ────────────────────────────────────────────────────────
detect_hw() {
  ISA="v1"
  /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v3' && ISA="v3"
  /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v4' && ISA="v4"
  GPULINE=$(lspci 2>/dev/null | grep -Ei 'vga|3d' | head -1); GLOW=$(tr 'A-Z' 'a-z' <<< "${GPULINE:-}")
  VENDOR=unknown; GEN=unknown
  grep -q nvidia            <<< "$GLOW" && VENDOR=nvidia
  grep -qE '\b(amd|ati|radeon)\b' <<< "$GLOW" && VENDOR=amd
  grep -qE 'intel'          <<< "$GLOW" && VENDOR=intel
  # v2.10.6 — HÍBRIDO (Optimus): VGA/3D intel|amd E nvidia na MESMA
  # máquina — a 1ª linha (iGPU) manda no VENDOR (quem desenha), mas o
  # dGPU EXISTE e o gpu_cleanup_foreign não pode removê-lo ($2=1).
  HYBRID=0
  GALL=$(lspci 2>/dev/null | grep -Ei 'vga|3d' | tr 'A-Z' 'a-z')
  if grep -q nvidia <<< "$GALL" && grep -qE '\b(intel|amd|ati|radeon)\b' <<< "$GALL"; then
    HYBRID=1
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    GLOW2=$(tr 'A-Z' 'a-z' <<< "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)")
    [[ -n "$GLOW2" ]] && GLOW="$GLOW $GLOW2"
  fi
  case "$GLOW" in
    *"rtx 50"*|*gb1*|*gb2*)     GEN=blackwell; VENDOR=nvidia ;;
    *"rtx 40"*|*ad1*)           GEN=ada;       VENDOR=nvidia ;;
    *"rtx 30"*|*ga1*)           GEN=ampere;    VENDOR=nvidia ;;
    *"rtx 20"*|*"gtx 16"*|*tu1*) GEN=turing;   VENDOR=nvidia ;;
    *"gtx 10"*|*gp1*)           GEN=pascal;    VENDOR=nvidia ;;
    *"gtx 9"*|*gm1*)            GEN=maxwell;   VENDOR=nvidia ;;
  esac
  MEM_GIB=$(awk '/MemTotal/{printf "%d", ($2+524288)/1048576}' /proc/meminfo)
  STICKS=$(dmidecode -t memory 2>/dev/null | awk -F: '/Size:/{if($2 ~ /GB/) n++} END{print n+0}')
  MEMSPEED=$(dmidecode -t memory 2>/dev/null | awk -F: '/Configured Clock Speed/{gsub(/[^0-9]/,"",$2); if($2+0>0){print $2; exit}}')
  CPU_AMD=0; grep -q AuthenticAMD /proc/cpuinfo && CPU_AMD=1
}

dossie() {
  echo -e "${B}══════════ DOSSIÊ DETECTADO ══════════${N}"
  echo "CPU ISA ..: $ISA $([[ $CPU_AMD == 1 ]] && echo '(AMD → amd_pstate=active)')"
  echo "GPU ......: ${GPULINE##*:} [gen=$GEN vendor=$VENDOR]"
  echo "RAM ......: ${MEM_GIB}GB | ${STICKS} pente(s) | ${MEMSPEED:-?}MHz"
}

# ── ensure_cmdline_token (inserção à prova de aspas — padrão validado) ──
ensure_cmdline_token() {
  local file=$1 token=$2
  [[ $EUID -ne 0 || $DRY -eq 1 ]] && return 0
  grep -E '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file" 2>/dev/null | grep -qF -- "$token" && return 0
  backup "$file"
  if grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file" 2>/dev/null; then
    sed -i -E "/^GRUB_CMDLINE_LINUX_DEFAULT=/ s|\"([^\"]*)\"|\"\1 ${token}\"|" "$file"
  else
    printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet %s"\n' "$token" >> "$file"
  fi
}

# ── gpu_cleanup_foreign: auto-limpeza do stack estranho à GPU detectada ──
# A ISO Elite carrega os DOIS stacks de driver (o live tem que bootar em
# qualquer máquina); no primeiro boot do sistema INSTALADO o que não
# pertence ao hardware sai do disco — cada rig fica só com seus pacotes:
#   amd|intel → stack NVIDIA inteiro (nvidia-open/nvidia-utils/…, ~500MB
#               de userspace que nunca carrega em GPU AMD/Intel)
#   nvidia    → ICDs Vulkan AMD/Intel (~50MB; o loader nunca os escolhe)
# Mesa fica SEMPRE (llvmpipe do primeiro login, fallback de boot, GL).
# v2.10.6 — HÍBRIDO (2º arg): notebook Optimus tem iGPU (quem desenha) E
# dGPU (offload) — REMOVER o driver nvidia deixava a RTX/GTX INÚTIL para
# sempre (a classe documentada no :206 virava doença real no híbrido).
# Com $2=1 o stack NVIDIA fica (o install-stage já escreveu MODULES e o
# modprobe.d coerentes); só os ICDs do TERCEIRO vendor saem.
# Idempotente (pacman -Qq decide), auto-verificante (avisa o que restou)
# e seguro no --dry-run (só o 'run' escreve).
gpu_cleanup_foreign() {
  local vendor=$1 hybrid=${2:-0} np pkgs=()
  case "$vendor" in
    amd)    for np in nvidia-open nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils vulkan-intel lib32-vulkan-intel; do (( hybrid )) && [[ "$np" == *nvidia* ]] && continue; pacman -Qq "$np" >/dev/null 2>&1 && pkgs+=("$np"); done ;;
    intel)  for np in nvidia-open nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils vulkan-radeon lib32-vulkan-radeon; do (( hybrid )) && [[ "$np" == *nvidia* ]] && continue; pacman -Qq "$np" >/dev/null 2>&1 && pkgs+=("$np"); done ;;
    nvidia) for np in vulkan-radeon lib32-vulkan-radeon vulkan-intel lib32-vulkan-intel; do pacman -Qq "$np" >/dev/null 2>&1 && pkgs+=("$np"); done ;;
    *)      return 0 ;;
  esac
  (( ${#pkgs[@]} )) || { say "Auto-limpeza: nenhum pacote estranho ao hardware (já limpo)"; return 0; }
  say "Auto-limpeza: GPU $vendor → removendo stack do outro vendor (${pkgs[*]})"
  run pacman -Rns --noconfirm "${pkgs[@]}" || true
  # v4.6: módulos dkms pré-compilados da ISO (não são pacman-owned — o dkms
  # hook do build os compilou fora do controle de arquivo do pacman)
  # v2.10.6 — no HÍBRIDO os .ko nvidia ficam (o driver é do hardware que
  # está lá); o bloco de reconciliação abaixo só faz sentido SEM driver.
  if [[ "$vendor" != "nvidia" && "$hybrid" != "1" ]]; then
    local m found=0
    for m in /usr/lib/modules/*/updates/dkms/nvidia*.ko*; do
      [[ -e "$m" ]] || continue
      (( DRY )) || rm -f "$m"; found=1
    done
    (( found )) && say "Auto-limpeza: .ko nvidia pré-compilados removidos de /usr/lib/modules/*/updates/dkms"
    # v2.10.5 — RECONCILIAÇÃO DO INITRAMFS (a contradição Optimus, achada
    # na auditoria de simulações): o elite-install-stage decide pela
    # /sys/class/drm (vê o dGPU — em híbrido escreve MODULES=(nvidia …))
    # e ESTE tune decide pela 1ª linha lspci (conservador: iGPU). Sair daqui
    # com 'nvidia' no MODULES depois de REMOVER os .ko = o PRÓXIMO
    # mkinitcpio -P (todo update de kernel) morre 'module not found' e o
    # boot seguinte vai pro emergency shell. A contradição morre na fonte.
    if [[ -f /etc/mkinitcpio.conf ]] && grep -q '^MODULES=(nvidia' /etc/mkinitcpio.conf; then
      (( DRY )) || sed -i 's|^MODULES=(nvidia[^)]*)|MODULES=()|' /etc/mkinitcpio.conf
      say "Auto-limpeza: MODULES=(nvidia …) saiu do initramfs (install-stage viu o dGPU; quem manda no driver é o tune — GPU $vendor)"
    fi
    if [[ -e /etc/modprobe.d/00-elite-nvidia.conf ]]; then
      (( DRY )) || rm -f /etc/modprobe.d/00-elite-nvidia.conf
      say "Auto-limpeza: /etc/modprobe.d/00-elite-nvidia.conf saiu (sem driver, options órfãs)"
    fi
  fi
  for np in "${pkgs[@]}"; do
    pacman -Qq "$np" >/dev/null 2>&1 && warn "restou '$np' (dependência?) — manual: pacman -Rns $np"
  done
  return 0
}

# ── FATORAÇÃO DOS ESPELHOS (E37 — plano ARQUITETURA nº1) ─────────
# firstboot e interativo carregavam 4 pares de código GÊMEO editados à
# mão — a doença que o E33 flagrou (o interativo com o guard do snapper
# por exit code que o D6 já matara no firstboot, sob o comentário 'o
# MESMO GUARD'). Função ÚNICA chamada PELOS DOIS modos: revisar um
# caminho É revisar o outro. A suíte crava o espelho novo: def 1×,
# chamada 2×, zero cópia viva.

apply_grub_tokens() { # tokens de kernel + grub-mkconfig ([4] firstboot / [3] interativo)
  (( CPU_AMD )) && ensure_cmdline_token /etc/default/grub amd_pstate=active
  ensure_cmdline_token /etc/default/grub nowatchdog
  ensure_cmdline_token /etc/default/grub zswap.enabled=0
  ensure_cmdline_token /etc/default/grub transparent_hugepage=always
  run grub-mkconfig -o /boot/grub/grub.cfg
}

write_elite_sysctl() { # a lei do sysctl ([2i] firstboot quando ausente / [5] interativo)
  wfile /etc/sysctl.d/99-elite.conf <<'EOF'
# ── ELITE: sysctl de gaming
# v2.10.26/E38 — o trio zram abaixo é o MESMO do 99-elite.conf da ISO
# (o espelho não pode divergir — a doença do swappiness 150×180 nunca mais)
vm.swappiness = 180
vm.vfs_cache_pressure = 50
vm.page_lock_unfairness = 1
vm.max_map_count = 2147483642
kernel.sched_autogroup_enabled = 1
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
EOF
}

ensure_bbr() { # BBR+fq ([2c] firstboot / [5] interativo) — $1 = iso | graft
  # iso: a ISO JÁ embarca 99-elite-net.conf + elite-bbr.conf — presente =
  # confirma; ausente = LIMPA (o systemd-sysctl não pode reclamar a cada
  # boot). graft: enxerto em sistema qualquer — presente = ESCREVE os
  # arquivos; ausente = warn (cubic fica).
  if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
    if [[ "$1" == "graft" ]]; then
      wfile /etc/sysctl.d/99-elite-net.conf <<'EOF'
# ── ELITE: rede — BBR + fq (throughput em links de alta latência/perda)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
      wfile /etc/modules-load.d/elite-bbr.conf <<'EOF'
# ── ELITE: garante o módulo BBR antes do systemd-sysctl (kernel =m)
tcp_bbr
EOF
    else
      say "TCP: bbr + fq ativos (sysctl.d da ISO) — throughput em links de alta latência"
    fi
  else
    if [[ "$1" == "iso" ]]; then
      warn "bbr indisponível neste kernel — limpando sysctl.d/99-elite-net.conf (cubic fica)"
      # v4.9: a limpeza respeita o DRY (dry é seco, v4.4 — o sed/rm rodavam
      # até seco; primeiroboot é unit, mas a promessa é da casa)
      (( DRY )) || sed -i -E '/^net\.(core\.default_qdisc|ipv4\.tcp_congestion_control)/d' \
        /etc/sysctl.d/99-elite-net.conf 2>/dev/null || true
      (( DRY )) || rm -f /etc/modules-load.d/elite-bbr.conf 2>/dev/null || true
    else
      warn "kernel sem bbr — mantendo cubic (padrão do kernel)"
    fi
  fi
}

ensure_btrfs_stack() { # snapshots/grub-btrfsd/lactd-tail ([3] firstboot / [6] interativo)
  # findmnt decide (o guard 'mount | grep on / btrfs' NUNCA casava — D1);
  # guard do snapper por SAÍDA (list-configs sai 0 até com ZERO configs —
  # D6/E33); timer cleanup só aplica limites (E32). Idempotente.
  if [[ "$(findmnt -n -o FSTYPE / 2>/dev/null)" == "btrfs" ]]; then
    if command -v snapper >/dev/null 2>&1; then
      snapper --no-dbus list-configs 2>/dev/null | grep -qw root || \
        run snapper --no-dbus -c root create-config / || true
    elif [ ! -d /.snapshots ]; then
      # fallback sem-snapper (legado do firstboot; no interativo é a rede
      # de segurança se o [6] falhou offline): subvolume nu já deixa a
      # grub-btrfsd subir sadia
      run btrfs subvolume create /.snapshots || true
    fi
    run systemctl enable --now grub-btrfsd.service 2>/dev/null || true
    run systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
  else
    say "raiz não é btrfs — snapshots/grub-btrfsd ficam de fora (rollback é lei do btrfs)"
  fi
}

# ── CachyOS: chave + keyring + mirrorlist + repos (padrão validado) ──
cachyos_key_present() { pacman-key --list-keys "$CACHYOS_KEY" >/dev/null 2>&1; }

discover_latest() {
  curl -fsSL --max-time 30 "${MIRROR}/repo/x86_64/cachyos/" 2>/dev/null \
    | grep -oE "$1-[0-9][^\"]*\.pkg\.tar\.zst" | sort -Vu | tail -1 || true
}

ensure_cachyos() {
  say "CachyOS: chave + keyring + mirrorlist + repos (pacman stock preservado)"
  if ! cachyos_key_present; then
    # timeout 90: keyserver lento/indisponível NUNCA pendura a unit
    # (o rig flagrou 'activating' por 17min — TimeoutStartSec=1800)
    run timeout 90 pacman-key --recv-keys "$CACHYOS_KEY" --keyserver keyserver.ubuntu.com || true
    run pacman-key --lsign-key "$CACHYOS_KEY" || true
  else
    say "chave $CACHYOS_KEY já importada"
  fi
  local kr ml
  kr=$(discover_latest cachyos-keyring);   [[ -n "$kr" ]] || kr="$PINNED_KEYRING"
  ml=$(discover_latest cachyos-v3-mirrorlist); [[ -n "$ml" ]] || ml="$PINNED_V3ML"
  if ! pacman -Q cachyos-keyring >/dev/null 2>&1 || ! pacman -Q cachyos-v3-mirrorlist >/dev/null 2>&1; then
    run pacman -U --noconfirm "${MIRROR}/repo/x86_64/cachyos/${kr}" "${MIRROR}/repo/x86_64/cachyos/${ml}"
  fi
  if ! grep -q '^\[cachyos-v3\]' "$PACMAN_CONF"; then
    say "Inserindo [cachyos] + trio v3 antes de [core] em $PACMAN_CONF"
    (( DRY )) && return 0
    backup "$PACMAN_CONF"
    local block tmp
    read -r -d '' block <<'EOF' || true
# >>> ELITE: CachyOS — wiki.cachyos.org/features/optimized_repos
# Trio v3 ANTES do baseline (o kernel BORE existe nos dois: baseline é x86_64)
[cachyos-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-core-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-extra-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos]
Server = https://us.cachyos.org/repo/x86_64/cachyos
Server = https://cdn77.cachyos.org/repo/x86_64/cachyos
# <<< ELITE
EOF
    tmp=$(mktemp)
    awk -v block="$block" '
      /^\[core\]/ && !done { print block; print ""; done = 1 }
      { print }
      END { if (!done) { print ""; print block } }
    ' "$PACMAN_CONF" > "$tmp"
    cat "$tmp" > "$PACMAN_CONF"; rm -f "$tmp"
  fi
  # Arquitetura: pacotes v3 do CachyOS são arch "x86_64_v3" (o "auto"
  # só aceita x86_64 — sem isso o pacman rejeita a transação)
  if ! grep -qE '^Architecture = .*\bx86_64_v3\b' "$PACMAN_CONF"; then
    say "pacman.conf: Architecture = x86_64 x86_64_v3 (necessário p/ os pacotes v3)"
    if (( ! DRY )); then
      backup "$PACMAN_CONF"
      if grep -qE '^Architecture = ' "$PACMAN_CONF"; then
        sed -i -E 's|^Architecture = .*$|Architecture = x86_64 x86_64_v3|' "$PACMAN_CONF"
      else
        sed -i '/^\[options\]/a Architecture = x86_64 x86_64_v3' "$PACMAN_CONF"
      fi
    fi
  fi
  grep -q '^\[multilib\]' "$PACMAN_CONF" || warn "ative [multilib] no pacman.conf (lib32 p/ Steam)"
  run pacman -Sy
}

# ════════════════════════════════════════════════════════════════════
# MODO --status  (certificação)
# ════════════════════════════════════════════════════════════════════
if (( STATUS )); then
  echo -e "${B}══════════ CERTIFICAÇÃO ELITE ══════════${N}"
  printf '%-22s %s\n' "kernel:" "$(uname -r)"
  printf '%-22s %s\n' "driver cpufreq:" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo '—')"
  printf '%-22s %s\n' "cmdline:" "$(cat /proc/cmdline)"
  printf '%-22s %s\n' "zram:" "$(zramctl 2>/dev/null | tail -n +2 | awk '{print $1,$3}' | tr '\n' ' ')"
  printf '%-22s %s\n' "THP:" "$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)"
  printf '%-22s %s\n' "repos cachyos:" "$(grep -oE '^\[cachyos[^]]*\]' $PACMAN_CONF 2>/dev/null | tr '\n' ' ')"
  echo ""
  for s in ananicy-cpp grub-btrfsd lactd elite-firstboot; do
    printf 'service %-15s %s\n' "$s" "$(systemctl is-active $s.service 2>/dev/null || echo inactive)"
  done
  echo ""
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
    nvidia-smi -q 2>/dev/null | grep -A2 'BAR1' | grep -E 'Total|Current' | head -2
  else
    echo "GPU: ${GPULINE:-$(lspci 2>/dev/null | grep -Ei 'vga|3d' | head -1)}"
  fi
  echo ""
  echo "firstboot:      $([[ -f /var/lib/elite/firstboot-done ]] && echo 'concluído' || echo 'pendente/não-ISO')"
  echo ""
  echo "Verificações manuais: btop | elite-tune --apps"
  exit 0
fi

[[ $EUID -eq 0 ]] || { echo "Execute com sudo (exceto --status)."; exit 1; }
detect_hw

# ════════════════════════════════════════════════════════════════════
# MODO --apps  (menu de apps — "baixo só o que vou usar")
# ════════════════════════════════════════════════════════════════════
if (( APPS )); then
  echo -e "${B}══════════ ELITE APPS ══════════${N}"
  echo " 1) Steam (gaming)          4) Criação (GIMP/Inkscape/Kdenlive)"
  echo " 2) Lutris + Wine           5) Escritório (LibreOffice/Thunderbird)"
  echo " 3) OBS Studio              0) Sair"
  local_ok=""; read -rp "Escolha: " local_ok || local_ok=""
  case "$local_ok" in
    1) run pacman -S --needed --noconfirm steam protontricks ;;
    2) run pacman -S --needed --noconfirm lutris wine-staging winetricks ;;
    3) run pacman -S --needed --noconfirm obs-studio ;;
    4) run pacman -S --needed --noconfirm gimp inkscape kdenlive ;;
    5) run pacman -S --needed --noconfirm libreoffice-fresh thunderbird ;;
    *) say "Nada instalado."; exit 0 ;;
  esac
  say "Concluído. Steam: ative Shader Pre-Caching nas configurações."
  exit 0
fi

# ════════════════════════════════════════════════════════════════════
# MODO --firstboot  (unit systemd — sistema recém-instalado da ISO)
# ════════════════════════════════════════════════════════════════════
if (( FIRSTBOOT )); then
  say "ELITE FIRSTBOOT — hardware: ISA=$ISA GPU=$VENDOR/$GEN RAM=${MEM_GIB}GB"
  [[ "$ISA" == "v1" || "$ISA" == "v2" ]] && \
    err "CPU não reporta x86-64-v3 — esta ISO é v3 (legal instruction pode falhar). Considere a ISO padrão do Archcraft."
  RETRY_DRIVER=0   # 1 = driver pendente → NÃO marca done; re-tenta no próximo boot

  # 1. keyring fresco no INSTALADO (ISO pode ter meses E o keyring embutido
  #    é um pacote datado — o rig v2.3.5 flagrou: 'a chave 882DCFE… é
  #    desconhecida' + unit 'activating' por 17min no journal). A ORDEM
  #    mata o ovo-e-galinha: chaves ANTES de qualquer -Sy — db de repo
  #    assinado por chave desconhecida faz o -Sy INTEIRO falhar (prova no
  #    dump do rig; o ensure_cachyos puxa o keyring FRESCO direto do
  #    mirror, sem depender de db assinado).
  run pacman-key --init || true
  run pacman-key --populate archlinux cachyos || true
  if ! cachyos_key_present; then
    run timeout 90 pacman-key --recv-keys "$CACHYOS_KEY" --keyserver keyserver.ubuntu.com || true
    run pacman-key --lsign-key "$CACHYOS_KEY" || true
  fi
  run pacman -Sy --noconfirm archlinux-keyring || true
  run ensure_cachyos || true

  # 2. driver de vídeo
  # v4.6: a ISO v1.1 embarca o nvidia-open-dkms PRÉ-COMPILADO contra o
  # kernel BORE (E11) — módulos + userspace já estão no disco. Detectamos
  # isto ANTES de qualquer pacman: rig NVIDIA da ISO = 1º boot 100%
  # offline (nenhum download, marker na primeira passada).
  NV_PREBUILT=0
  if ls /usr/lib/modules/"$(uname -r)"/updates/dkms/nvidia.ko* >/dev/null 2>&1 \
     && pacman -Qq nvidia-utils >/dev/null 2>&1; then
    NV_PREBUILT=1
  fi
  case "$VENDOR:$GEN" in
    nvidia:blackwell|nvidia:ada|nvidia:ampere|nvidia:turing)
      if (( NV_PREBUILT )); then
        say "NVIDIA $GEN → driver dkms PRÉ-COMPILADO da ISO já presente p/ $(uname -r) — nada a instalar (offline OK)"
      else
        say "NVIDIA $GEN → nvidia-open-dkms (kernel único BORE da v1.1)"
        # v4.5: instalar ANTES de remover. A ordem antiga (-R → -S) deixava o
        # rig sem driver NENHUM se o -S falhasse (ex.: sem rede no 1º boot) —
        # e o marker 'done' sepultava o retry. Agora: -S vence → -R limpa o
        # pré-compilado; -S falha → driver PRESERVADO e re-tenta amanhã.
        if pacman_s nvidia-open-dkms nvidia-utils lib32-nvidia-utils; then
          run pacman -R --noconfirm nvidia-open 2>/dev/null || true
        else
          RETRY_DRIVER=1
          warn "nvidia-open-dkms não instalou (sem rede?) — driver atual PRESERVADO"
          warn "elite-firstboot vai re-tentar no próximo boot (marker não escrito)"
        fi
      fi
      ;;
    nvidia:pascal|nvidia:maxwell)
      say "NVIDIA $GEN → tentando nvidia-dkms (branch 580 = última p/ Maxwell/Pascal)"
      if pacman_s nvidia-dkms nvidia-utils lib32-nvidia-utils; then
        run pacman -R --noconfirm nvidia-open 2>/dev/null || true
      else
        RETRY_DRIVER=1
        warn "pacote nvidia-dkms indisponível p/ $GEN. Rode manualmente:"
        warn "  paru -S nvidia-580xx-dkms && sudo elite-tune --yes"
        warn "elite-firstboot vai re-tentar no próximo boot (marker não escrito)"
      fi
      ;;
    amd:*)
      say "AMD → mesa/RADV (vulkan-radeon assado na ISO Elite; --needed = no-op)"
      run pacman -S --needed --noconfirm mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon || true
      wfile /etc/modprobe.d/00-elite-amdgpu.conf <<'EOF'
# ── ELITE: AMD — destrava undervolt/OC p/ LACT/CoreCtrl
options amdgpu ppfeaturemask=0xffffffff
EOF
      ;;
    intel:*)
      say "Intel → mesa/ANV (vulkan-intel assado na ISO Elite; --needed = no-op)"
      run pacman -S --needed --noconfirm mesa lib32-mesa vulkan-intel || true
      # v2.10.6 — HÍBRIDO: userspace NVIDIA garantido (offload) — o
      # install-stage já escreveu MODULES=(nvidia …) e o modprobe.d; o
      # gpu_cleanup_foreign abaixo NÃO remove o driver (hybrid=1). Se o
      # userspace faltar por qualquer razão, tenta instalar (sem rede →
      # preservado, o aviso do prebuilt cobre).
      if (( HYBRID )) && ! pacman -Qq nvidia-utils >/dev/null 2>&1; then
        say "Híbrido (iGPU intel + dGPU nvidia) → nvidia-utils p/ offload (PRIME)"
        run pacman -S --needed --noconfirm nvidia-utils lib32-nvidia-utils || true
      fi
      ;;
    *)
      warn "GPU não identificada ($GPULINE) — nenhum driver extra instalado"
      ;;
  esac
  if [[ "$VENDOR" == "nvidia" ]]; then
    wfile /etc/modprobe.d/00-elite-nvidia.conf <<'EOF'
# ── ELITE: NVIDIA (modeset+fbdev p/ Wayland/gamescope; VRAM preservada em suspend)
options nvidia-drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
EOF
    run systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service nvidia-persistenced.service || true
  fi

  # 2b. auto-limpeza: cada rig fica SÓ com os pacotes do SEU hardware
  #     (NVIDIA em AMD/Intel = ~500MB inertes; ICDs Vulkan alienígenas ~50MB)
  #     v2.10.6 — no HÍBRIDO o stack NVIDIA FICA (offload do dGPU).
  gpu_cleanup_foreign "$VENDOR" "$HYBRID"
  if (( HYBRID )); then
    say "Híbrido detectado (iGPU $VENDOR + dGPU nvidia) — driver NVIDIA preservado p/ offload"
  fi

  # 2c. v4.6 — rede: BBR+fq ("internet rápida"): o sysctl.d da ISO pede bbr;
  #     se ESTE kernel não oferece (improvável no BORE), remove as linhas
  #     em vez de deixar o systemd-sysctl reclamando a cada boot.
  #     E37: o par gêmeo vive em ensure_bbr — modo 'iso'. v4.9: a limpeza
  #     respeita o DRY.
  ensure_bbr iso

  # 2d. v4.8 (v2.3.4) — REMOÇÃO DO INSTALADOR: mídia de instalação não é
  #     sistema. O unpackfs copia o root do LIVE inteiro p/ o disco — o
  #     Calamares, o atalho "Instalar o Archcraft" do Launchpad e os
  #     scripts de instalação CHEGAVAM ao sistema instalado e ficavam
  #     para sempre (relato do dono, out/2026). O live NÃO é tocado:
  #     esta etapa só existe no elite-firstboot (ConditionPathExists
  #     !/run/archiso — a unit). Idempotente (pacman -Qq decide),
  #     best-effort no pacman (falhou → os arquivos saem igual: o
  #     sintoma que o dono vê é o atalho no menu) e seco no --dry-run
  #     (só anuncia — "dry é seco", v4.4).
  if pacman -Qq calamares >/dev/null 2>&1; then
    say "Instalador: removendo calamares do sistema instalado (mídia ≠ sistema)"
    run pacman -Rns --noconfirm calamares || true
    if pacman -Qq calamares >/dev/null 2>&1; then
      warn "calamares restou (dependência?) — os atalhos saem abaixo do mesmo jeito"
    fi
  else
    say "Instalador: calamares não está no disco (nada a remover)"
  fi
  if (( DRY )); then
    say "[dry] remoção dos arquivos do instalador simulada (atalho · wrapper de log · stage · /etc/calamares)"
  else
    rm -f /usr/local/share/applications/calamares.desktop \
          /usr/local/share/applications/abif.desktop \
          /usr/local/bin/calamares-elite-log \
          /usr/local/bin/elite-install-stage
    rm -rf /etc/calamares
    # v2.10.12 — O FANTASMA NO DRAWER (relato do dono na 10.12: 'o
    # instalador tá ficando nos aplicativos depois de instalar'): o
    # cleanup SEMPRE removeu o calamares.desktop (o log do firstboot
    # prova: 'nada a remover' + rm rodando em silêncio) — o ícone que
    # sobrevive é o CACHE do nwg-drawer (~/.cache/nwg-drawer/cache.db
    # construído ANTES da remoção). Sem purge, o drawer desenha entrada
    # de arquivo morto. O cache reconstrói sozinho na próxima abertura.
    for cdb in /home/*/.cache/nwg-drawer/cache.db*; do
      [ -e "$cdb" ] && rm -f "$cdb"
    done 2>/dev/null || true
  fi

  # 2e. v2.10.6 — O AUTOLOGIN DO LIVE NÃO ENTRA NO INSTALADO (achado Z1
  #     da Rodada 2): o drop-in kde_settings.conf ([Autologin]
  #     User=liveuser) sobrevive ao unpackfs e um usuário inexistente no
  #     [Autologin] é comportamento indefinido do SDDM. O bloco sai; o
  #     Theme/General ficam (a sessão labwc continua pré-selecionada).
  SDDM_KDE=/etc/sddm.conf.d/kde_settings.conf
  if [[ -f "$SDDM_KDE" ]] && grep -q '^\[Autologin\]' "$SDDM_KDE"; then
    say "SDDM: removendo [Autologin] herdado do live (User=liveuser não existe no instalado)"
    if (( ! DRY )); then
      awk 'BEGIN{skip=0} /^\[Autologin\]/{skip=1; next} /^\[/{skip=0} skip==0{print}' \
        "$SDDM_KDE" > "${SDDM_KDE}.new" && mv "${SDDM_KDE}.new" "$SDDM_KDE"
    fi
  fi

  # 2f. v2.10.6 — O TECLADO DO CALAMARES CHEGA À SESSÃO (achado Z2): o
  #     módulo keyboard escreve /etc/X11/xorg.conf.d/00-keyboard.conf —
  #     o greeter e o TTY obedecem, mas a sessão labwc não lê X11 e
  #     nascia us(). XKB_DEFAULT_LAYOUT no /etc/environment (pam_env
  #     alimenta SDDM→labwc) fecha o vão (ABNT2 no desktop inteiro).
  KB_CONF=/etc/X11/xorg.conf.d/00-keyboard.conf
  if [[ -f "$KB_CONF" ]] && ! grep -q '^XKB_DEFAULT_LAYOUT=' /etc/environment 2>/dev/null; then
    KBL=$(awk -F'"' '/XkbLayout/{print $4; exit}' "$KB_CONF" 2>/dev/null)
    KBV=$(awk -F'"' '/XkbVariant/{print $4; exit}' "$KB_CONF" 2>/dev/null)
    # v2.10.7 — o guard 'KBL != us' MATAVA o us-INTERNACIONAL: a variante
    # 'intl' É o que precisa viajar (dead keys) e o layout 'us' puro não é
    # o default da sessão labwc. O 1º rig-install da 10.6 flagrou (dump
    # 0qmq: localectl 'us + intl' e /etc/environment SEM XKB — a sessão
    # nasceu us() seca). Escreve se o layout ≠ us OU a variante existe.
    if [[ -n "$KBL" && ( "$KBL" != "us" || -n "$KBV" ) ]]; then
      say "Teclado: XKB_DEFAULT_LAYOUT=$KBL${KBV:+ ($KBV)} → /etc/environment (a sessão labwc herda do Calamares)"
      if (( ! DRY )); then
        backup /etc/environment
        printf 'XKB_DEFAULT_LAYOUT=%s\n' "$KBL" >> /etc/environment
        [[ -n "$KBV" ]] && printf 'XKB_DEFAULT_VARIANT=%s\n' "$KBV" >> /etc/environment
      fi
    fi
  fi

  # 2g. v2.10.8 — O BRAVE QUE NÃO MORRE (o dono: "não consigo encerrar o
  #     Brave... quando encerro um programa não precisa aparecer
  #     notificação... ele não aparece na lista"): o default do Brave é
  #     continuar rodando em 2º plano quando a última janela fecha
  #     (background_mode.enabled interno) — o processo vive, a dock
  #     (janela = a verdade) mostra NADA, o verbo do meio não acha
  #     janela, e o Brave ainda cospe o toast "executando em segundo
  #     plano" a cada fecho. O cluster inteiro do relato é UM ajuste:
  #     background_mode.enabled=false. O skel da ISO já nasce curado; o
  #     firstboot patcha PERFIS EXISTENTES (o rig que instalou a 10.7
  #     recebe no próximo boot — firstboot ainda pendente lá, dump d33o).
  #     Idempotente (a chave false não é reescrita), JSON de verdade
  #     (python3 — sed em Local State é tiro no escuro), dono do arquivo
  #     PRESERVADO (root escreve, uid/gid volta).
  if (( ! DRY )); then
    # v2.10.8.1 — o espaço em "Local State" É um caractere do nome: o glob
    # sem escape é partido em DUAS palavras pelo word-splitting e o loop
    # nunca acharia o arquivo (o patch morreria calado — a lei proíbe).
    for bs in /home/*/.config/BraveSoftware/Brave-Browser/Local\ State; do
      [[ -f "$bs" ]] || continue
      rc=0
      PYTHONDONTWRITEBYTECODE=1 python3 - "$bs" <<'PYBRAVE' 2>/dev/null || rc=$?
import json, os, sys
p = sys.argv[1]
try:
    with open(p, encoding="utf-8") as fh:
        d = json.load(fh)
except Exception:
    raise SystemExit(3)          # perfil exótico/corrompido: sem tocar
bm = d.get("background_mode")
if isinstance(bm, dict) and bm.get("enabled") is False:
    raise SystemExit(1)          # já curado — nada a fazer (idempotente)
if not isinstance(bm, dict):
    bm = {}
bm["enabled"] = False
d["background_mode"] = bm
tmp = p + ".elite-tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(d, fh)
os.replace(tmp, p)
raise SystemExit(2)              # patch aplicado
PYBRAVE
      case "$rc" in
        1) say "Brave: background_mode já é false em $bs — ok" ;;
        2)
          _u="$(stat -c '%U' "$bs" 2>/dev/null)"; _g="$(stat -c '%G' "$bs" 2>/dev/null)"
          [[ -n "$_u" && "$_u" != "root" ]] && chown "$_u:$_g" "$bs" 2>/dev/null || true
          say "Brave: background_mode.enabled=false em $bs — fechar janela ENCERRA o programa (sem toast de 2º plano)"
          ;;
        3) warn "Brave: Local State não parseável ($bs) — nenhum patch aplicado" ;;
        *) warn "Brave: patch falhou em $bs (exit=$rc)" ;;
      esac
    done
  else
    say "[dry] Brave: patch de background_mode simulado (perfis /home/*)"
  fi

  # 2h. v2.10.14 — O SSH QUE O ARCHISO DEIXA LIGADO (dump nl3z: symlink
  #     multi-user.target.wants/sshd.service no INSTALADO): o perfil live
  #     habilita sshd para a conveniência da mídia; o unpackfs copia o /etc
  #     inteiro e o desktop nasce SERVINDO SSH sem ninguém pedir — daemon
  #     ouvindo na rede = superfície de ataque + daemon que o dono não
  #     escolheu (mesma escola do ufw: bloat sai). O PACOTE fica (quem
  #     quiser o serviço: systemctl enable --now sshd). Só no INSTALADO
  #     (esta etapa vive no firstboot, que nunca roda no live); idempotente.
  if systemctl is-enabled sshd.service >/dev/null 2>&1; then
    say "sshd: servidor SSH herdado do archiso — desligando (desktop não serve SSH de fábrica; pacote preservado)"
    if (( ! DRY )); then
      systemctl disable --now sshd.service 2>/dev/null || true
    fi
  else
    say "sshd: já desligado (nada a fazer)"
  fi

  # 2i. v2.10.14 — A AUDITORIA DO SYSCTL (dump nl3z: o rig respondeu
  #     vm.swappiness=150 com a ISO entregando 180 — o valor da Elite não
  #     chegou ao kernel e o papel v2.4 não lista os arquivos para nomear
  #     a causa: arquivo ausente no alvo OU arquivo que vence por ordem
  #     lexical). A cura não aposta: GARANTE o arquivo da Elite em
  #     /etc/sysctl.d, REAPLICA e CONFERE no kernel — o resultado vai ao
  #     log; se seguir divergente, o aviso nomeia o réu (o dump v2.5
  #     lista /etc/sysctl.d inteiro na seção 3 para o próximo papel).
  if [[ ! -f /etc/sysctl.d/99-elite.conf ]]; then
    say "sysctl: 99-elite.conf ausente no alvo — recriando (a lei da ISO)"
    # E37: o conteúdo é lei ÚNICA (write_elite_sysctl) — a cópia local com
    # o cabeçalho 'restaurado pelo firstboot' era o espelho que divergia
    write_elite_sysctl
  fi
  want_sw=180
  got_sw="$(sysctl -n vm.swappiness 2>/dev/null || true)"
  if [[ "$got_sw" != "$want_sw" ]]; then
    say "sysctl: kernel em vm.swappiness='${got_sw:-?}' (Elite pede $want_sw) — reaplicando sysctl.d"
    if (( ! DRY )); then
      systemctl restart systemd-sysctl.service 2>/dev/null || sysctl --system >/dev/null 2>&1 || true
      got_sw="$(sysctl -n vm.swappiness 2>/dev/null || true)"
    fi
    if [[ "$got_sw" == "$want_sw" ]]; then
      say "sysctl: vm.swappiness = $want_sw confirmado no kernel"
    else
      warn "sysctl: vm.swappiness segue '${got_sw:-?}' APÓS reaplicar — réu à vista no dump (seção 3 lista /etc/sysctl.d)"
    fi
  else
    say "sysctl: vm.swappiness = $want_sw (kernel já na lei da Elite)"
  fi

  # 3. serviços de tuning
  # v4.7 (fusão 4→1): ananicy-cpp é o ÚNICO daemon de boost. O scheduler
  # é o BORE do kernel (nenhum scheduler userspace por cima) e o boost de
  # jogo sob demanda é o gamemode. scx-elite/dmemcg/fg-booster extintos.
  run systemctl enable --now ananicy-cpp.service || true
  # snapshots: o grub-btrfsd vigia /.snapshots — sem o subvolume a unit
  # nasce FAILED ('No directory found at /.snapshots' — o rig flagrou no
  # dump: active=failed). O snapper cria o subvolume junto com a config
  # (idempotente); sem snapper, subvolume nu já faz a unit subir sadia.
  # v2.10.5 — TUDO ISTO É LEI DO BTRFS: em raiz ext4 a unit era habilitada
  # do mesmo jeito e nascia FAILED pra sempre (systemctl --failed vermelho
  # em toda instalação ext4 — ruído que imita doença).
  # v2.10.6 — O GATE ESTAVA MORTO (achado D1 da Rodada 2, provado):
  # 'mount | grep -q " on / btrfs"' NUNCA casava — a história completa da
  # lei do btrfs (findmnt, guard por SAÍDA, timer E32) vive na FUNÇÃO.
  # E37: ensure_btrfs_stack — o 'mesmo bloco do firstboot' deixou de ser
  # promessa de comentário: é a MESMA FUNÇÃO.
  ensure_btrfs_stack
  run systemctl enable --now lactd.service 2>/dev/null || true

  # 4. tokens de kernel (GRUB) — E37: apply_grub_tokens (o espelho morreu)
  apply_grub_tokens

  # 5. self-disable + marker + aviso
  #    v4.5: marker/só-disable APENAS com driver garantido. Sem rede no 1º
  #    boot o marker NÃO é escrito — a unit (ConditionPathExists=!done)
  #    re-tenta no boot seguinte até conseguir. É o comportamento de uma
  #    distro de verdade: nunca deixa o usuário num estado sem saída.
  #    v4.6: com o driver pré-compilado da ISO o RETRY_DRIVER nunca arma
  #    no rig NVIDIA — offline deixou de ser caso especial.
  if (( DRY )); then
    say "[dry] marker firstboot-done e self-disable apenas simulados"
  elif (( RETRY_DRIVER )); then
    say "driver pendente — marker NÃO escrito; elite-firstboot re-tenta no próximo boot"
  else
    mkdir -p /var/lib/elite && touch /var/lib/elite/firstboot-done
    run systemctl disable elite-firstboot.service || true
  fi
  say "FIRSTBOOT CONCLUÍDO — log: /var/log/elite-firstboot.log"
  # E30 (v2.10.18) — O BELL MISTERIOSO MORRE (dump p6aw, foot do dono:
  # 'Mensagem de broadcast de root@archpc (somewhere)' às 16:14:45 — o
  # MESMO segundo do 'Finished elite-firstboot' no journal: era o `wall`
  # da conclusão, tocando o bell de todo terminal aberto com uma mensagem
  # que a sessão GRÁFICA nunca pediu). Os 3 `wall` saem de cena:
  #   · conclusão (AMD/Intel/sem driver trocado): NENHUMA notificação —
  #     o log basta (doutrina do dono: só o feedback necessário);
  #   · NVIDIA pendente/instalado: toast CRÍTICO na sessão viva (a via
  #     v2.10.5 que o dono de fato vê) — o wall não volta jamais.
  if [[ "$VENDOR" == "nvidia" ]]; then
    if (( RETRY_DRIVER )); then
      # honesto: não trocamos nada — pedir reboot seria mentira
      for ub in /run/user/*/bus; do
        [[ -S "$ub" ]] || continue
        uid=${ub#/run/user/}; uid=${uid%/bus}
        (( DRY )) || sudo -n -u "#$uid" env DBUS_SESSION_BUS_ADDRESS="unix:path=$ub" \
          notify-send -a 'Elite' -u critical \
          'ELITE: driver NVIDIA pendente' \
          'Conecte-se à rede e reinicie — o firstboot re-tenta no próximo boot.' 2>/dev/null || true
      done
    else
      for ub in /run/user/*/bus; do
        [[ -S "$ub" ]] || continue
        uid=${ub#/run/user/}; uid=${uid%/bus}
        (( DRY )) || sudo -n -u "#$uid" env DBUS_SESSION_BUS_ADDRESS="unix:path=$ub" \
          notify-send -a 'Elite' -u critical \
          'ELITE: driver NVIDIA instalado' \
          'REINICIE para ativar (o sistema atual usa o módulo antigo/nouveau).' 2>/dev/null || true
      done
    fi
  fi
  exit 0
fi

# ════════════════════════════════════════════════════════════════════
# MODO PADRÃO (interativo — enxerto em qualquer Arch/Archcraft)
# ════════════════════════════════════════════════════════════════════
dossie
(( STICKS == 1 )) && err "SINGLE-CHANNEL! Um 2º pente de RAM = +10-15% fps (verifique dmidecode)"
[[ -n "${MEMSPEED:-}" ]] && (( MEMSPEED < 3000 )) && warn "RAM @ ${MEMSPEED}MHz → ligue DOCP/XMP na BIOS"
[[ "$ISA" == "v1" ]] && err "CPU pré-v2: use kernel linux/linux-lts do Arch (CachyOS exige v2+)"

# E36 (audit de arquitetura — tune Q2, o achado ❌ mais perigoso): o err de
# cima NÃO SAI (é só echo) e a seção [1] instalava o kernel x86_64_v3 MESMO
# em CPU pré-v3 → SIGILL no boot seguinte — o 'avisa e mesmo assim instala'
# viola a doutrina da própria casa ('nunca deixa o usuário num estado sem
# saída', :723-726). O gate: PRV3=0 pula a seção [1] INTEIRA (repos v3 +
# kernel) — o RESTO do tune (zram/sysctl/udev/daemons/grub) é independente
# do kernel e segue. (A detecção produz v1/v3/v4 — 'v2' não existe; v1 =
# pré-v3 de verdade. O firstboot roda SÓ no sistema que JÁ bootou a ISO v3,
# então o gate é do enxerto interativo — o único caminho capaz de destruir.)
PRV3=1
case "$ISA" in v1) PRV3=0 ;; esac

confirm "Aplicar o Elite Tune neste hardware?" || exit 0

# ── [1] CachyOS + kernel BORE (kernel único da Elite v1.1) ─────────
if (( PRV3 )); then
  ensure_cachyos
  # E37/n16: pacman_s — o rc REAL alimenta o epílogo honesto (o
  # 'CONCLUÍDO' incondicional vendia como instalado o kernel que o pacman
  # não baixou — o usuário descobria no boot seguinte)
  if pacman_s "$KERNEL_PKG" "${KERNEL_PKG}-headers"; then
    :
  else
    note_fail "kernel $KERNEL_PKG + headers (sem rede/repos?) — o sistema segue no kernel atual"
  fi
  if pacman_s cachyos-settings cachyos-ananicy-rules ananicy-cpp; then
    :
  else
    note_fail "booster único (cachyos-settings/cachyos-ananicy-rules/ananicy-cpp)"
  fi
else
  warn "SEÇÃO [1] PULADA — CPU $ISA não roda pacotes x86-64-v3 (SIGILL no boot)."
  warn "O kernel atual do sistema permanece; zram/sysctl/daemon/grub seguem (seções 2+)."
fi

# ── [2] Daemons ─────────────────────────────────────────────────────
# v4.7: um daemon só — ananicy-cpp (o scheduler é o BORE do kernel;
# scx-elite/dmemcg/fg-booster extintos na fusão dos boosters)
# E36 — enable só quando o pacote pôde nascer (PRV3): habilitar serviço
# de pacote que não instalou é falha engolida pelo || true.
if (( PRV3 )); then
  run systemctl enable --now ananicy-cpp.service || true
fi

# ── [3] Boot params (E37: apply_grub_tokens — a função única) ─────
apply_grub_tokens

# ── [4] GPU ─────────────────────────────────────────────────────────
if [[ "$VENDOR" == "nvidia" ]]; then
  DRIVER=nvidia-open-dkms; GSPOPT=fixed
  case "$GEN" in
    pascal|maxwell) DRIVER=nvidia-dkms ;;
    turing|ampere)
      if askn "Turing/Ampere: driver FECHADO p/ recuperar 200-400MB de VRAM (GSP off)? (padrão: open)"; then
        DRIVER=nvidia-dkms; GSPOPT=off
      fi ;;
  esac
  say "NVIDIA $GEN → $DRIVER"
  run pacman -R --noconfirm nvidia-open 2>/dev/null || true
  if ! pacman -Qqs "^${DRIVER}$" >/dev/null 2>&1; then
    if (( DRY )); then
      echo "  \$ pacman -S --needed --noconfirm $DRIVER nvidia-utils nvidia-settings lib32-nvidia-utils"
    elif ! pacman -S --needed --noconfirm "$DRIVER" nvidia-utils nvidia-settings lib32-nvidia-utils; then
      note_fail "driver NVIDIA ($DRIVER) — o sistema segue no driver presente"
      [[ "$GEN" == pascal || "$GEN" == maxwell ]] && \
        warn "Para $GEN: paru -S nvidia-580xx-dkms (AUR) e rode elite-tune de novo"
    fi
  fi
  wfile /etc/modprobe.d/00-elite-nvidia.conf <<EOF
# ── ELITE: NVIDIA
options nvidia-drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
$( [[ "$GSPOPT" == "off" ]] && echo 'options nvidia NVreg_EnableGpuFirmware=0   # GSP off: recupera 200-400MB (fechado em Turing/Ampere)' )
EOF
  run systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service nvidia-persistenced.service || true
elif [[ "$VENDOR" == "amd" ]]; then
  pacman_s mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon radeontop \
    || note_fail "stack AMD (mesa/vulkan-radeon/radeontop)"
  wfile /etc/modprobe.d/00-elite-amdgpu.conf <<'EOF'
# ── ELITE: AMD — destrava undervolt/OC p/ LACT/CoreCtrl
options amdgpu ppfeaturemask=0xffffffff
EOF
fi

# ── [5] Memória + I/O (idempotente — na ISO já vêm assados) ───────
# Auto-limpeza também no modo interativo (enxerto em sistema existente):
gpu_cleanup_foreign "$VENDOR" "$HYBRID"
ZMB=$(( MEM_GIB * 1024 )); (( ZMB > 8192 )) && ZMB=8192
pacman_s zram-generator || note_fail "zram-generator (swappiness 180 sem zram segue funcional)"
wfile /etc/systemd/zram-generator.conf <<EOF
[zram0]
zram-size = ${ZMB}M
compression-algorithm = zstd
EOF
run systemctl daemon-reload
run systemctl start systemd-zram-setup@zram0.service || true

write_elite_sysctl   # E37: a lei única (era cópia literal do bloco do firstboot)

# v4.6 — "internet rápida": BBR+fq quando o kernel oferece (enxerto em
# sistema qualquer; no BORE da ISO já vem assado via 99-elite-net.conf +
# elite-bbr.conf). E37: o par gêmeo vive em ensure_bbr — modo 'graft'.
ensure_bbr graft
run sysctl --system || true

wfile /etc/udev/rules.d/60-io-elite.rules <<'EOF'
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]*", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF
run udevadm control --reload || true

# ── [6] Stack de jogo + ferramentas ─────────────────────────────────
# v4.7: a seção antiga [6] (fg-booster + xdotool + fg-boost.slice) foi
# EXTINTA na fusão dos boosters — o boost de jogo é o gamemode abaixo.
pacman_s gamemode lib32-gamemode gamescope \
  mangohud lib32-mangohud grub-btrfs snapper lact \
  || note_fail "stack de jogo + btrfs + lact (pacman não completou — sem rede?)"
# snapshots no fluxo manual também — E37: ensure_btrfs_stack, a lei ÚNICA
# (findmnt decide; guard do snapper por SAÍDA — D6/E33; timer do E32).
# O 'mesmo bloco do firstboot' deixou de ser promessa: é a MESMA FUNÇÃO.
ensure_btrfs_stack
run systemctl enable --now lactd.service 2>/dev/null || true

# ── [7] Shader cache NVIDIA ─────────────────────────────────────────
if [[ "$VENDOR" == "nvidia" ]]; then
  backup /etc/environment
  for v in __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1 __GL_SHADER_DISK_CACHE_SIZE=1073741824; do
    (( DRY )) || grep -qxF "$v" /etc/environment 2>/dev/null || echo "$v" >> /etc/environment
  done
fi

# ── [8] SESSÃO: A MOLDURA ÚNICA + TEMA ESCURO (E70 — o rig vivo recebe) ──
# O print do dono (06/nov 20:46) provou a ferida NO CAMPO: o LACT
# (libadwaita) abriu CLARO e com headerbar própria no meio do rice escuro;
# o VS Code (Electron em XWayland) desenhava titlebar própria — dois
# sistemas de moldura num só desktop. O papel da casa já era certo
# (rc.xml <decoration>server + settings.ini escuros) e o campo venceu a
# negociação DUAS vezes: o xdg-decoration é NEGOCIADO (app que pede CSD
# vence o default) e a libadwaita NÃO lê o settings.ini (lê o
# color-scheme do dconf). A cura é ARQUITETURAL (a moldura vira
# propriedade do compositor) e o skel da ISO já nasce curado; ESTA seção
# leva a cura às HOMES EXISTENTES (o pacote NUNCA toca config de usuário
# — a lei do domínio v3): entrega o code-flags.conf, append idempotente
# no environment e no autostart (marcador E70), grava o escuro AGORA e
# roda o craft-rice (fragmentos + reconfigure vivo — sockets wayland-*
# reais, a lição E68: SEM chute wayland-0). Escola 2g: backup + chown.
if [[ -d /etc/skel/.config/labwc ]]; then
  for h in /home/*/; do
    [[ -d "$h/.config" ]] || continue
    u="$(stat -c '%U' "$h")"; [[ "$u" == "root" ]] && continue
    uid="$(id -u "$u" 2>/dev/null)" || continue
    # 8a. VS Code em Wayland nativo (code-flags.conf — o launcher da Arch lê)
    #     O CONTEÚDO MORA AQUI (padrão craft-rice: o que viaja no pacote
    #     chega a TODO rig). A perícia por download do 1.0-20 flagrou: o
    #     elite-system NUNCA carregou skel (64 membros = bins/units — o
    #     skel é veículo da ISO) — o /etc/skel do rig instalado é da ÉPOCA
    #     DA INSTALAÇÃO e o pacote NUNCA o atualiza; copiar do skel era a
    #     cura que não alcança o rig antigo (o VS Code ficaria XWayland
    #     com titlebar própria — a ferida do print persistiria).
    DST="$h/.config/code-flags.conf"
    if [[ ! -f "$DST" ]]; then
      say "Sessão ($u): code-flags.conf entregue (VS Code Wayland nativo)"
      if (( ! DRY )); then
        cat > "$DST" <<'E70CODE'
# ── ELITE E70 · VS Code — Wayland nativo + a moldura do compositor ──────
# (lido pelo launcher do code da Arch — padrão code-flags.conf; entregue
#  pela seção [8] do elite-tune — o conteúdo viaja no pacote único)
--enable-features=UseOzonePlatform
--ozone-platform=wayland
E70CODE
        chown "$(stat -c '%U:%G' "$h")" "$DST" 2>/dev/null || true
      fi
    fi
    # 8b. ELECTRON_OZONE_PLATFORM_HINT no environment (Electron ≥28/AppImage)
    ENVF="$h/.config/labwc/environment"
    if [[ -f "$ENVF" ]] && ! grep -q '^ELECTRON_OZONE_PLATFORM_HINT=' "$ENVF" 2>/dev/null; then
      say "Sessão ($u): ELECTRON_OZONE_PLATFORM_HINT=auto → environment (Electron nasce Wayland)"
      if (( ! DRY )); then
        backup "$ENVF"
        printf '\n# E70 — A MOLDURA ÚNICA: todo Electron (AppImage incluído) nasce\n# Wayland nativo — o compositor decora, a moldura é UMA.\nELECTRON_OZONE_PLATFORM_HINT=auto\n' >> "$ENVF"
        chown "$(stat -c '%U:%G' "$h")" "$ENVF" 2>/dev/null || true
      fi
    fi
    # 8c. O escuro alcança a libadwaita (o LACT claro do print)
    ASTF="$h/.config/labwc/autostart"
    if [[ -f "$ASTF" ]] && ! grep -q 'Tema escuro UNIVERSAL (E70' "$ASTF" 2>/dev/null; then
      say "Sessão ($u): color-scheme prefer-dark → autostart (libadwaita/portal abrem escuros)"
      if (( ! DRY )); then
        backup "$ASTF"
        cat >> "$ASTF" <<'E70DARK'

# --- Tema escuro UNIVERSAL (E70 — o print do dono 20:46: LACT claro no
#     meio do rice escuro): a libadwaita NÃO lê o settings.ini gtk-3/gtk-4
#     — ela lê o color-scheme do dconf (via portal; sem portal, via
#     gsettings). Roda a cada boot: o padrão da casa é escuro.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Mocha-Standard-Mauve-Dark' >/dev/null 2>&1 &
fi
E70DARK
        chown "$(stat -c '%U:%G' "$h")" "$ASTF" 2>/dev/null || true
      fi
    fi
    # 8d. O escuro AGORA (sem esperar boot) + os fragmentos do rice VIVOS
    if (( ! DRY )); then
      if runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
           gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1; then
        say "Sessão ($u): color-scheme prefer-dark gravado no dconf AGORA"
      else
        warn "Sessão ($u): gsettings sem dbus do usuário — o escuro vale no próximo login (o autostart 8c cobre)"
      fi
      if [[ -x /usr/local/bin/craft-rice ]]; then
        WSOCK=""
        for w in /run/user/"$uid"/wayland-*; do [[ -S "$w" ]] && WSOCK="${w##*/}" && break; done
        if [[ -n "$WSOCK" ]]; then
          runuser -u "$u" -- env XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY="$WSOCK" \
            /usr/local/bin/craft-rice >/dev/null 2>&1 || true
        else
          runuser -u "$u" -- /usr/local/bin/craft-rice >/dev/null 2>&1 || true
        fi
        say "Sessão ($u): craft-rice entregou os fragmentos (reconfigure vivo quando há sessão — o que sobrou vale no próximo login)"
      fi
    else
      say "[dry] Sessão ($u): color-scheme AGORA + craft-rice (fragmentos/reconfigure) simulados"
    fi
  done
else
  say "Sessão: skel labwc ausente (alvo não-Elite?) — seção [8] pulada"
fi

# ── [9] ARQUIVOS: O COMPRIMIR MORRE COM HONRA (E72 — o rig vivo recebe) ──
# O dono (07/nov) apertou o "Comprimir…" e colheu o erro HONESTO da E42
# ('O diálogo de compressão não abriu (zenity rc=255) — --entry-text não
# tem suporte para este diálogo'): o zenity --forms REAL recusa a flag que
# é do diálogo --entry (a prova funcional da E42 rodou com zenity de rc
# controlado — o stub aceitava a flag; a classe 'o sandbox mente' de novo).
# Terceira onda da mesma peça (E35 nasceu cega ao 7z; E42 curou o motor) e
# a ordem é REMOVE ('remove esse botao de comprimir' — 'se for pra ser
# quebrado é melhor nem ter', já lei do dono desde a E40). No pacote a
# peça INTEIRA sai (verbo fora do uca.xml do skel + craft-compress extinto
# — o pacman apaga o binário na transação). FALTA o uca.xml do USUÁRIO:
# config de usuário NUNCA é tocado por update (lei do domínio v3) — ESTA
# seção é a porta EXPLÍCITA do dono: remove o bloco <action> do verbo
# morto das homes vivas (idempotente; backup escola 2g; os vizinhos —
# elite-open-terminal-1 (terminal E40) e elite-craft-extract-1 (Extrair
# aqui E46) — intactos, o awk só apaga o bloco que carrega o marcador).
for h in /home/*/; do
  UCAF="$h/.config/Thunar/uca.xml"
  [[ -f "$UCAF" ]] || continue
  grep -q 'elite-craft-compress-1' "$UCAF" 2>/dev/null || continue
  u="$(stat -c '%U' "$h")"
  if (( DRY )); then
    say "[dry] Arquivos ($u): verbo Comprimir… seria removido do uca.xml (E72)"
    continue
  fi
  backup "$UCAF"
  if awk '
      /<action>/ { ina=1; buf="" }
      ina { buf = buf (buf=="" ? "" : ORS) $0 }
      ina && /<\/action>/ {
        ina=0
        if (buf !~ /elite-craft-compress-1/) print buf
        next
      }
      !ina { print }
    ' "$UCAF" > "$UCAF.tmp" && [[ -s "$UCAF.tmp" ]]; then
    chmod --reference="$UCAF" "$UCAF.tmp" 2>/dev/null || true
    chown "$(stat -c '%U:%G' "$h")" "$UCAF.tmp" 2>/dev/null || true
    mv -f "$UCAF.tmp" "$UCAF"
    say "Arquivos ($u): verbo Comprimir… removido do uca.xml (E72 — a peça morreu com honra; terminal e Extrair intactos)"
  else
    rm -f "$UCAF.tmp"
    warn "Arquivos ($u): a reescrita do uca.xml falhou — o verbo segue no menu (réu à vista no papel)"
  fi
done

# ── [10] TERMINAL: A SAUDAÇÃO VOLTA (E73 — o rig vivo recebe) ─────────
# O dono: "faz o terminal abrir por padrao com aquelas paradas que mostra
# o kernel e etc". O craft-hello EXISTE desde a v1.0.3 mas ninguém o
# chamava quando o terminal abre (só o W-S-h — que executava o script SEM
# terminal: a saída se perdia no journal do labwc). A cura é DUAS mãos:
# o skel da ISO já nasce com o bloco no .zshrc; ESTA seção injeta o MESMO
# bloco nas homes vivas (config de usuário NUNCA viaja no pacote — lei do
# domínio v3 e lição E70.1). Idempotente pelo marcador elite-hello-1;
# backup escola 2g; append puro — o .zshrc do usuário é da casa desde a
# v1.0.3 (stack zsh da Elite) e o bloco entra no FIM, intacto o resto.
# E o W-S-h ganha terminal de verdade (foot + retrato + shell, com
# ELITE_NO_HELLO evitando a saudação dobrada — o que hoje roda SEM
# terminal imprime no journal, invisível ao dono).
ZSKEL=/etc/skel/.zshrc
if [[ -f "$ZSKEL" ]] && ! grep -q 'elite-hello-1' "$ZSKEL" 2>/dev/null; then
  if (( DRY )); then
    say "[dry] Terminal: bloco da saudação seria injetado no /etc/skel/.zshrc (E73)"
  else
    backup "$ZSKEL"
    cat >> "$ZSKEL" <<'E73HELLO'

# ── elite-hello-1 · Saudação: o terminal abre com o retrato do sistema ──
# E73 (injetado pela seção [10] do elite-tune — o craft-hello = fastfetch
# com o logo Archcraft + fallback próprio; kernel, uptime e pacotes na
# cara sem comando nenhum). Fuga honesta: export ELITE_NO_HELLO=1 desliga.
if [[ -o interactive ]] && (( $+commands[craft-hello] )) && [[ -z "${ELITE_NO_HELLO}" ]]; then
  craft-hello
fi
E73HELLO
    say "Terminal: bloco da saudação injetado no /etc/skel/.zshrc (E73 — futuros usuários da casa nascem com o retrato)"
  fi
fi
for h in /home/*/; do
  ZRC="$h/.zshrc"
  [[ -f "$ZRC" ]] || continue
  grep -q 'elite-hello-1' "$ZRC" 2>/dev/null && continue
  u="$(stat -c '%U' "$h")"; [[ "$u" == "root" ]] && continue
  if (( DRY )); then
    say "[dry] Terminal ($u): bloco da saudação seria injetado no .zshrc (E73)"
    continue
  fi
  backup "$ZRC"
  cat >> "$ZRC" <<'E73HELLO'

# ── elite-hello-1 · Saudação: o terminal abre com o retrato do sistema ──
# E73 (injetado pela seção [10] do elite-tune — o craft-hello = fastfetch
# com o logo Archcraft + fallback próprio; kernel, uptime e pacotes na
# cara sem comando nenhum). Fuga honesta: export ELITE_NO_HELLO=1 desliga.
if [[ -o interactive ]] && (( $+commands[craft-hello] )) && [[ -z "${ELITE_NO_HELLO}" ]]; then
  craft-hello
fi
E73HELLO
  chown "$(stat -c '%U:%G' "$h")" "$ZRC" 2>/dev/null || true
  say "Terminal ($u): saudação injetada no .zshrc (E73 — o terminal abre com o retrato do sistema)"
done
for h in /home/*/; do
  RXML="$h/.config/labwc/rc.xml"
  [[ -f "$RXML" ]] || continue
  grep -q 'command="craft-hello"' "$RXML" 2>/dev/null || continue
  grep -q 'export ELITE_NO_HELLO=1' "$RXML" 2>/dev/null && continue
  u="$(stat -c '%U' "$h")"; [[ "$u" == "root" ]] && continue
  if (( DRY )); then
    say "[dry] Terminal ($u): W-S-h do rc.xml ganharia terminal de verdade (E73)"
    continue
  fi
  backup "$RXML"
  if awk -v q="'" '
      /command="craft-hello"/ {
        gsub(/command="craft-hello"/,
             "command=\"foot -e sh -c " q "craft-hello; export ELITE_NO_HELLO=1; exec zsh" q "\"")
      }
      { print }
    ' "$RXML" > "$RXML.tmp" && [[ -s "$RXML.tmp" ]]; then
    chmod --reference="$RXML" "$RXML.tmp" 2>/dev/null || true
    chown "$(stat -c '%U:%G' "$h")" "$RXML.tmp" 2>/dev/null || true
    mv -f "$RXML.tmp" "$RXML"
    say "Terminal ($u): W-S-h abre foot com o retrato e cai no shell (E73 — a saída nunca mais se perde no journal)"
  else
    rm -f "$RXML.tmp"
    warn "Terminal ($u): a reescrita do rc.xml falhou — o W-S-h segue executando sem terminal (réu à vista no papel)"
  fi
done

# E37/n16 — epílogo HONESTO: o pacman_s alimentou FAILURES com rc real;
# dizer 'CONCLUÍDO' sobre pendência era a mentira que o usuário só
# descobria no boot seguinte (kernel que não veio, booster morto).
if (( ${#FAILURES[@]} )); then
  err "CONCLUÍDO COM ${#FAILURES[@]} PENDÊNCIA(S) — o resto do tune foi aplicado:"
  for f in "${FAILURES[@]}"; do err "  · $f"; done
  echo "Resolva (rede/repos) e rode elite-tune de novo — as seções são idempotentes."
else
  say "CONCLUÍDO. Reboot e depois: sudo elite-tune --status"
fi
echo "Apps opcionais: sudo elite-tune --apps"
