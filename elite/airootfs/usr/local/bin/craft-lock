#!/usr/bin/env bash
# craft-lock — bloqueia a tela (hyprlock → loginctl → erro claro)
# v2.6 (E105): A PORTEIRA + A FOTO + O SED DE ESCOPO — (1) todo nascimento
#   atravessa o flock único (a corrida idle 120s × sleep-hook não gera
#   mais spawn paralelo; a porta fecha enquanto o hyprlock vive) e cada
#   spawn/if-needed ganha UMA linha no lock.log (argv + ppid = a porta e
#   QUEM chamou — a perícia do 'pediu a senha duas vezes' tem papel);
#   (2) o sedito do wallpaper fica PRESO ao bloco background — o bloco
#   avatar (E103) deixou de ser sobrescrito (a 'fotinha cortada' e o
#   'preview feio do papel de parede' eram o path do avatar virando o
#   wallpaper no conf efêmero).
# v2.1 (E100): A PELE SEGUE O LOCK — antes de cada lock novo, o craft-rice
#   --lock-quiet renova o conf do home (a MESMA gramática do arranque:
#   marcador renova, fóssil renova, ausente entrega, personalizado
#   intoca). A dose da casa vale no PRÓXIMO LOCK — não no próximo
#   relogin: o 'não mudou nada' morre (a pele não espera a sessão
#   renascer; o lock não é lugar de log). O --if-needed segue intacto:
#   lock JÁ VIVO sai cedo ANTES daqui — ninguém troca a pele de um
#   hyprlock que já está na tela (o conf é lido no nascimento).
# v2.0 (v2.5.0): o FUNDO do lock = o MESMO wallpaper do desktop — o dono:
#   "ele deve ficar só o wallpaper com Blur e não mostrar as janelas
#   abertas e etc como o PC estava antes de ir pra tela de bloqueio/idle".
#   Este script resolve o arquivo (png→jpg, a MESMA prioridade do swaybg
#   no autostart) e escreve o conf efêmero do hyprlock com o path certo:
#     · png vence jpg (mesma regra do autostart);
#     · sem nenhum: path vazio → o color do bloco background assume
#       (preto AMOLED — o mesmo fallback do autostart).
#   O arquivo mora no XDG_RUNTIME_DIR com nome FIXO: sobrescrito a cada
#   lock, zero acumulação (sem mktemp — o exec não roda trap de cleanup).
# v1.5: o locker da Elite é o hyprlock (~/.config/hypr/hyprlock.conf —
#   wallpaper + blur + dim + relógio + campo estilizado). Roda no labwc
#   via ext-session-lock-v1 (protocolo nativo). O swaylock (tela branca
#   estática do burn test) saiu.
# E47 — --if-needed: O LOCK QUE JÁ VIVE NÃO MORRE NO ESCURO (a denúncia
#   recorrente do dono: 'só entra em suspensão quando coloco a senha na
#   tela de bloqueio — essa lógica é burra'). A cadeia do auto-suspend
#   (swayidle: timeout SUSPEND_MIN → systemctl suspend -i → PrepareForSleep
#   → before-sleep craft-lock) REINICIAVA o hyprlock que JÁ ESTAVA na
#   tela: pkill + espera + exec + init (o blur do wallpaper é caro —
#   segundos numa GPU fraca). O logind só espera InhibitDelayMaxSec (5s)
#   pelos hooks delay — se o hyprlock novo não terminou de mapear, o
#   kernel congela no meio da init e o ACORDA NÃO TEM LOCK (ou tem um
#   locker morto). Com --if-needed: lock vivo = exit 0 (ele sobrevive ao
#   congelamento e recebe o dono acordando); lock MORTO = segue o fluxo
#   completo (a promessa 'acorda no lock' também se AUTO-CURA). O caminho
#   MANUAL (W-l, menu) continua com a semântica de reinício da E30 —
#   instância única garantida nos dois mundos.
set -euo pipefail

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
uso() {
    printf '%s\n' \
        'uso: craft-lock [--if-needed] — trava a sessão (hyprlock, com o' \
        '     wallpaper resolvido + a lock skin da casa)' \
        '' \
        '  --if-needed: lock já vivo = exit 0 (ele sobrevive; o braço do idle' \
        '  usa para não matar o lock no escuro — E47).' \
        '  E100: cada lock NOVO renova a lock skin antes de nascer (o' \
        '  craft-rice --lock-quiet — a dose da casa vale no próximo lock).' \
        '  atalho: W-l. A vigília (craft-vigil) nasce com TODO lock novo.'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

# E105 — A PORTEIRA DO NASCIMENTO (a corrida que o dump não conseguiu
# fotografar: 'pediu a senha duas vezes'). TODO craft-lock atravessa a
# MESMA porteira (flock em XDG_RUNTIME_DIR — tmpfs por boot): o 2º
# instante da corrida (o idle 120s e o sleep-hook do suspend nascendo
# juntos) espera até 2s em vez de spawnar em paralelo; com o lock vivo, o
# --if-needed de baixo vê o pgrep e sai. A porta fica FECHADA enquanto o
# lock vive (o fd 9 acompanha o exec do hyprlock — o flock é dele):
# nenhum outro nascimento por descuido. Sem flock(1) na máquina, a
# porteira degrada em silêncio (o pgrep de baixo segue segurando).
LLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/lock.log"
mkdir -p "${XDG_RUNTIME_DIR:-/tmp}/elite" "${LLOG%/*}" 2>/dev/null || true
exec 9>>"${XDG_RUNTIME_DIR:-/tmp}/elite/lock-spawn.lock" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
    flock -w 2 9 2>/dev/null || true
fi

# E47 — o no-op DIFERENTE do silêncio: só sai cedo quando há lock SAUDÁVEL
# para guardar (a checagem é pgrep, não fé).
if [ "${1:-}" = "--if-needed" ] && pgrep -x hyprlock >/dev/null 2>&1; then
    printf '[%s] if-needed: lock vivo — nada a fazer\n' "$(date '+%F %T')" >>"$LLOG" 2>/dev/null || true
    exit 0
fi

# E105 — A FOTO DO NASCIMENTO (uma linha por spawn REAL — o argv diz a
# porta e o ppid diz QUEM chamou: idle, sleep-hook, menu, W-l; a próxima
# denúncia de dupla senha tem o nascimento de CADA lock no papel, e o
# craft-dump fotografa este log). Teto 1 MiB (a escola do bars.log).
if [ -f "$LLOG" ] && [ "$(wc -c <"$LLOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    : > "$LLOG" 2>/dev/null || true
fi
printf '[%s] spawn argv=[%s] ppid=%s\n' "$(date '+%F %T')" "$*" "${PPID:-?}" >>"$LLOG" 2>/dev/null || true

# E100 — A PELE SEGUE O LOCK (a renovação vem ANTES do pkill: o conf é
# lido pelo hyprlock NO NASCIMENTO — quem já está na tela não troca de
# pele, e quem vai nascer nasce VESTIDO). craft-rice ausente (ISO
# estranha?) = silêncio: o lock segue com o conf do home como sempre.
if command -v craft-rice >/dev/null 2>&1; then
    craft-rice --lock-quiet >/dev/null 2>&1 || true
fi

# E30 (v2.10.18) — INSTÂNCIA ÚNICA (bars.log do dump p6aw: hyprlock
# 'onLockFinished called. Seems we got yeeten. Is another lockscreen
# running?' — dois caminhos do lock atravessaram [timeout do idle +
# manual/suspend] e o perdedor ficou VIVO, pid 3666, mesmo com a sessão
# destravada: um locker fantasma esperando para dar dor de cabeça).
# pkill+espera+exec: SEMPRE exatamente um locker — o TERM no velho É o
# fecho da corrida, e um lock pedido nunca vira no-op silencioso.
# E47: o caminho --if-needed já devolveu cedo ACIMA quando havia lock
# vivo — o pkill abaixo só alcança quem chegou até aqui (lock morto ou
# caminho manual), a E30 segue intacta onde ela nasceu.
pkill -x hyprlock 2>/dev/null || true
i=0
while [ "$i" -lt 10 ] && pgrep -x hyprlock >/dev/null 2>&1; do
    sleep 0.1
    i=$((i + 1))
done
if command -v hyprlock >/dev/null 2>&1; then
  # E60 — A VIGÍLIA: TODO lock novo ARMA o próprio vigia do suspend
  # (setsid — sobrevive ao exec abaixo; stdin/stdout soltos). O suspend
  # deixa de depender do relógio de idle do compositor: o vigia conta o
  # tempo TRAVADO (hyprlock vivo) e dorme o PC com SUSPEND_MIN minutos de
  # lock. O caminho --if-needed com lock VIVO saiu cedo acima — não
  # rearma (o vigia daquele lock já está no ar). O fallback loginctl não
  # arma por honestidade: o vigia lê a vida do HYPRLOCK — armar sem
  # hyprlock é prometer o que não pode vigiar. Manual (W-l), menu,
  # timeout do idle e craft-power: TODOS dormem travado agora.
  if command -v craft-vigil >/dev/null 2>&1; then
    setsid craft-vigil >/dev/null 2>&1 </dev/null 9>&- &
  fi
  src="$HOME/.config/hypr/hyprlock.conf"
  if [ -r "$src" ]; then
    bg="$HOME/.config/labwc/wallpaper.png"
    [ -r "$bg" ] || bg="$HOME/.config/labwc/wallpaper.jpg"
    conf="${XDG_RUNTIME_DIR:-/tmp}/elite-hyprlock.conf"
    if [ -r "$bg" ]; then
      # v2.5.0-fix: a linha path é INDENTADA no conf (bloco background) —
      # o ^path puro era no-op silencioso (o teste dos 3 cenários flagrou).
      # v2.5.0 (N1a, audit 24-r): $bg escapado p/ sed — HOME com | & \
      # morria o sed (set -e) e o lock morria sem fallback.
      # E105 — O SED DE ESCOPO (o dump 195332 + a denúncia do dono: 'a
      # fotinha cortada e um preview feio do papel de parede entre o
      # relógio e as credenciais'): o sedito antigo trocava TODA linha
      # path do conf — o bloco avatar (E103) inclusive, que na sessão
      # viva virava o WALLPAPER (a foto do dono nunca aparecia; o círculo
      # 96px mostrava um recorte feio da parede). A cura: a troca fica
      # PRESA ao bloco background (a parede); o path do avatar
      # (~/.cache/elite/avatar.png) sobra intacto e a foto real aparece
      # no círculo 1:1 que a E101 entregou.
      bg_esc=$(printf '%s' "$bg" | sed 's/[&|\\]/\\&/g')
      sed "/^background {/,/^}/ s|^[[:space:]]*path = .*|    path = $bg_esc|" "$src" > "$conf"
    else
      # sem wallpaper: path vazio → o color do bloco assume (preto);
      # mesmo escopo E105: só o bloco background
      sed "/^background {/,/^}/ s|^[[:space:]]*path = .*|    path =|" "$src" > "$conf"
    fi
    # E101 — O AVATAR 1:1 (a diretriz do dono: proporção 1:1 rigorosa,
    # círculo perfeito). O rounding=-1 do hyprlock sobre imagem RETANGULAR
    # é ELIPSE — o corte assimétrico que o dono mandou eliminar. A cura:
    # a FONTE é sempre QUADRADA — o crop min(iw,ih) do ffmpeg (que a casa
    # já leva na ISO) recorta o lado menor e o cache nasce quadrado.
    # FONTE: ~/.config/elite/avatar.png (a casa do dono) → ~/.face (o
    # padrão XDG). CACHE com mtime: a foto mudou? nasce de novo; igual?
    # o lock não paga o ffmpeg (milissegundos viram zero).
    if command -v ffmpeg >/dev/null 2>&1; then
      av_src=""
      for cand in "$HOME/.config/elite/avatar.png" "$HOME/.face" \
                  "$HOME/.config/elite/avatar.jpg" "$HOME/.face.icon"; do
        [ -r "$cand" ] && { av_src="$cand"; break; }
      done
      if [ -n "$av_src" ]; then
        av_dst="${XDG_CACHE_HOME:-$HOME/.cache}/elite/avatar.png"
        if [ ! -r "$av_dst" ] || [ "$av_src" -nt "$av_dst" ]; then
          mkdir -p "${av_dst%/*}" 2>/dev/null || true
          ffmpeg -y -loglevel error -i "$av_src" \
            -vf "crop='min(iw,ih)':'min(iw,ih)',scale=256:256" \
            "$av_dst" 2>/dev/null || true
        fi
      fi
    fi
    exec hyprlock -c "$conf"
  fi
  exec hyprlock
fi
if command -v loginctl >/dev/null 2>&1; then
  exec loginctl lock-session
fi
echo "✖ instale o locker: sudo pacman -S hyprlock" >&2
exit 1
