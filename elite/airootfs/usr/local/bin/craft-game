#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-game (E101 — O MODO DE JOGO DA CASA)
# ═══════════════════════════════════════════════════════════════════════════
# A diretriz do dono: "tem o modo de jogo do CachyOS ou do feral, o que for
# melhor, que vai abrir automaticamente e definir o performance no CPU
# quando entrar no jogo — ou um botão em algum lugar do sistema para
# conseguir mexer no governor". A resposta da casa é OS DOIS NO MESMO
# CORPO, sem daemon novo:
#
#   · O MÚSCULO é o gamemode do Feral (JÁ NA ISO/ADOÇÃO — zero pacote
#     novo): o gamemoded sobe por D-BUS ACTIVATION só quando há jogo
#     (idle = ZERO RAM — o mesmo princípio do polkit E101), aplica o
#     governor performance (EPP incluso no amd-pstate-epp), o
#     amd_performance_level high na GPU (power_dpm_force_performance_
#     level), inibe o screensaver e morre com o jogo — TUDO NATIVO, com
#     rede de segurança própria (reaper) erollback automático.
#   · O CÉREBRO é este script: o WATCH detecta o jogo (pgrep da família —
#     Steam sem gamemoderun, emuladores, Wine) e REGISTRA O PID DO JOGO no
#     gamemode (o reaper DELE sabe quando o pid morre — a casa não conta
#     nada duas vezes); o MANUAL (menu) registra um HOLDER próprio; os
#     hooks [custom] do gamemode.ini avisam o dono (-u low — pop-up não é
#     lugar de estado, a lei C101 da casa).
#
#   O CachyOS-Settings (ananicy-cpp + kernel BORE) já dá o scheduling de
#   fundo — o gamemode entra POR CIMA só no jogo: nenhuma camada luta com
#   outra (a lição v2.2 da leveza radical).
#
# Uso:
#   craft-game            menu (Ativar agora / Desativar / Automático / Status)
#   craft-game status     o veredito sem tocar nada
#   craft-game on|off     manual (holder próprio, conta no gamemode)
#   craft-game watch      o daemon da sessão (AUTO=1 em ~/.config/elite/game.conf;
#                         AUTO=0/ausente = sai 0 — ausência intencional, lei do idle)
#   craft-game hook       os [custom] do gamemode.ini (inicio/fim do modo)
# ═══════════════════════════════════════════════════════════════════════════
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/elite"
CONF="$CONF_DIR/game.conf"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/elite"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/game.log"

# a família de JOGOS da casa (ERE sobre o COMM, ancorada — pgrep SEM -x).
# Steam nativo, Wine/Proton (preloader), emuladores e clients conhecidos.
# E106 — O COMM QUE NUNCA CASOU (a doutrina E48 na família do jogo): o
# kernel corta o comm em 15 caracteres — 'wine64-preloader' (17) chega
# como 'wine64-preload' e o 'pgrep -x wine64-preloader' da lista antiga
# JAMAIS viu o jogo Wine/Proton 64-bit: o modo automático nasceu CEGO
# para a família mais comum do dono. A lista agora é ERE sobre o comm
# (pgrep sem -x casa regex) com âncoras ^…$ — o corte do kernel entra
# no padrão ('wine6?-preload(er)?' casa 14 e 17 chars), e a âncora
# impede que um 'gamescope-helper' hipotético passe por 'gamescope'.
GAME_PATS='^wine6?-preload(er)?$|^gamescope$|^pcsx2$|^retroarch$|^duckstation$|^dolphin-emu$|^melonds$|^citra-qt$|^ryujinx$|^PPSSPPSDL$|^rpcs3$|^osu!$|^Cemu$'

# o glifo de log único (o papel da casa — 256 KiB de teto, lei E36)
glog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || true
}

# o aviso para o dono: -u low por padrão (a lei do pop-up: estado não sobe
# na tela — a central/histórico guarda; pop-up é lugar de normal/critical).
# E106 — A EXCEÇÃO QUE O DONO MANDOU: ação DELE no menu (on/off/Automático)
# que não deixava NENHUM feedback — o menu fechava e NADA aparecia (o
# dump: 'clico em ativar agora e eu não vejo nada se ele está on ou off').
# A política -u low do swaync MATA toda urgência low (notification-visibility
# muted) — o feedback da ação do dono usa -u normal: sobe na tela, some em
# 8s (nunca critical — a doutrina da casa fica). Eventos AUTOMÁTICOS
# (jogo detectado/saído) seguem -u low — a lei C101 fica de pé.
note() {
    local urgen="${NOTE_URGEN:-low}"
    command -v notify-send >/dev/null 2>&1 || return 0
    timeout 5 notify-send -a 'Elite · Jogo' -u "$urgen" -t 8000 "$@" >/dev/null 2>&1 || true
}

# ── o canal D-Bus do gamemode (o sistema é root por trás do gamemoded) ──
gm_call() { # $1..n = método + args (int32:…)
    dbus-send --system --print-reply --dest=org.freedesktop.GameMode \
        /org/freedesktop/GameMode "$@" 2>/dev/null \
        | awk '/int32/ {print $NF; exit}'
}
gm_register() { gm_call org.freedesktop.GameMode.RegisterGame "int32:$1" "int32:$1" "int32:0"; }
gm_unregister() { gm_call org.freedesktop.GameMode.UnregisterGame "int32:$1" "int32:$1" "int32:0"; }
gm_status() { gm_call org.freedesktop.GameMode.QueryStatus "int32:$1" "int32:$1" "int32:0"; }

has_gamemode() {
    command -v dbus-send >/dev/null 2>&1 && command -v gamemoded >/dev/null 2>&1
}

# o holder do modo MANUAL: um processo da casa que dorme enquanto o dono
# quer performance — o pid registrado é o DELE (off = unregister + ceifa)
holder_pid_file() { printf '%s/game-holder.pid' "$RUN_DIR"; }

ensure_run_dir() { mkdir -p "$RUN_DIR" 2>/dev/null || true; }

gm_on() {
    if ! has_gamemode; then
        glog "manual: gamemode/dbus-send ausente — nada a fazer (honesto)"
        echo "✖ gamemode/dbus-send ausente — sudo craft-update (a âncora E94 adota)" >&2
        return 1
    fi
    ensure_run_dir
    local hpid file
    file="$(holder_pid_file)"
    if [ -r "$file" ] && kill -0 "$(cat "$file" 2>/dev/null)" 2>/dev/null; then
        echo "o modo de jogo JÁ está ativo (manual)" >&2
        return 1
    fi
    hpid="$(setsid sh -c 'while :; do sleep 30; done' 2>/dev/null & echo $!)"
    printf '%s\n' "$hpid" > "$file" 2>/dev/null || true
    if gm_register "$hpid" >/dev/null 2>&1; then
        glog "manual: ON (holder pid $hpid registrado no gamemode)"
        NOTE_URGEN=normal note 'Modo de jogo ATIVO' 'Governor performance + GPU high (gamemode) — desligue no menu ou craft-game off'
        echo "==> modo de jogo ATIVO (governor performance + GPU high — gamemode)"
        return 0
    fi
    kill "$hpid" 2>/dev/null || true
    rm -f "$file" 2>/dev/null || true
    glog "manual: o gamemode RECUSOU o registro (dbus?) — nada mudou"
    NOTE_URGEN=normal note 'Modo de jogo não ativou' "O gamemode não respondeu — prova em $LOG"
    echo "✖ o gamemode não respondeu — prova em $LOG" >&2
    return 1
}

gm_off() {
    local file hpid
    file="$(holder_pid_file)"
    if [ -r "$file" ]; then
        hpid="$(cat "$file" 2>/dev/null)"
        gm_unregister "$hpid" >/dev/null 2>&1 || true
        kill "$hpid" 2>/dev/null || true
        rm -f "$file" 2>/dev/null || true
        glog "manual: OFF (holder pid $hpid liberado — o gamemode devolve o governor)"
        NOTE_URGEN=normal note 'Modo de jogo DESATIVADO' 'Perfil normal restaurado (governor/GPU da casa)'
        echo "==> modo de jogo DESATIVADO (o governor volta ao perfil da casa)"
        return 0
    fi
    # jogos do watch: liberar TUDO que o watch registrou (o round falhou?)
    if [ -r "$RUN_DIR/game-watch.pid" ]; then
        rm -f "$RUN_DIR/game-watch.pids" 2>/dev/null || true
        glog "manual: OFF — fila do watch limpa (os jogos que morreram o reaper já liberou)"
    fi
    NOTE_URGEN=normal note 'Modo de jogo' 'Não estava ativo — nada a desativar'
    echo "o modo de jogo não está ativo (nada a desativar)" >&2
    return 1
}

# ── o WATCH (o detector da família — daemon da sessão, pgrep barato) ────
# Um jogo achado → o PID DELE vai pro gamemode (o reaper de lá sabe da
# morte dele — zero estado duplicado); jogo nenhum → 5s de silêncio (um
# pgrep de µs). O AUTO=0/ausente é AUSÊNCIA INTENCIONAL (lei do idle E36).
gm_watch() {
    if ! has_gamemode; then
        glog "watch: gamemode ausente — daemon sai (a âncora E94 traz o pacote)"
        exit 0
    fi
    local auto=""
    [ -r "$CONF" ] && auto="$(sed -n 's/^AUTO=//p' "$CONF" | head -1)"
    if [ "${auto:-0}" != "1" ]; then
        glog "watch: AUTO≠1 (config da casa) — ausência intencional, nada roda"
        exit 0
    fi
    ensure_run_dir
    # E106 — O SINGLETON QUE O SUPERVISOR CEGO EXIGE (o dump 20261112: a
    # âncora quebrada do craft-bars spawnou UM watch novo a cada 5s — 12
    # pares vivos no ps, 1540 restarts no papel). A âncora do supervisor
    # está curada (E106 lá), mas a defesa final é DO CORPO: o flock no
    # XDG_RUNTIME_DIR decide no KERNEL — o 2º watch sai 0 em silêncio,
    # mesmo que alguém o lance na mão ou um supervisor antigo (versão
    # velha em memória) continue cego. O fd morre com o processo — sem
    # órfão segurando a porta (a lição E43 do craft-bars).
    exec 9>"$RUN_DIR/game-watch.lock" 2>/dev/null || true
    if command -v flock >/dev/null 2>&1 && ! flock -n 9 2>/dev/null; then
        exit 0
    fi
    printf '%s\n' "$$" > "$RUN_DIR/game-watch.pid" 2>/dev/null || true
    glog "watch: no ar (pid $$ — família ERE sobre o comm, ${#GAME_PATS} chars de padrões)"

    local -A held=()   # pid → 1 (registrado por nós)
    while :; do
        # 1) os REGISTRADOS que morreram: libera (o reaper de lá também
        #    sabe — o unregister é o cinto)
        for p in "${!held[@]}"; do
            if ! kill -0 "$p" 2>/dev/null; then
                gm_unregister "$p" >/dev/null 2>&1 || true
                unset "held[$p]"
                glog "watch: jogo pid $p morreu — gamemode liberado (o governor volta)"
            fi
        done
        # 2) os jogos VIVOS da família que AINDA não estão registrados
        # (E106: pgrep SEM -x — a família é ERE sobre o comm cortado; a
        # lista antiga nunca viu o Wine 64-bit)
        while IFS= read -r p; do
            [ -n "$p" ] || continue
            [ "${held[$p]:-}" = 1 ] && continue
            if gm_register "$p" >/dev/null 2>&1; then
                held["$p"]=1
                glog "watch: jogo detectado (pid $p) — registrando no gamemode (performance ON)"
                note 'Modo de jogo' 'Governor performance + GPU high automáticos'
            else
                glog "watch: jogo pid $p detectado mas o registro recusou (dbus?) — próxima rodada tenta de novo"
            fi
        done < <(pgrep -u "$(id -u)" "$GAME_PATS" 2>/dev/null || true)
        sleep 5
    done
}

# ── o HOOK (o [custom] do gamemode.ini — início/fim NATIVO do modo) ─────
gm_hook() { # $1 = start|end
    case "${1:-}" in
        start) glog "gamemode: INÍCIO (o hook nativo do gamemode.ini — governor/GPU já aplicados)"
               note 'Modo de jogo' 'Performance ativa (CPU governor + GPU high)' ;;
        end)   glog "gamemode: FIM (o hook nativo devolveu o perfil da casa)"
               note 'Modo de jogo' 'Perfil normal restaurado' ;;
    esac
    exit 0
}

# ── o STATUS (o veredito sem tocar nada — a escola do --check) ──────────
gm_status_cmd() {
    printf '══════════ craft-game status — o veredito sem tocar nada ══════════\n'
    command -v gamemoded >/dev/null 2>&1 \
        && printf 'gamemode            instalado (%s)\n' "$(pacman -Q gamemode 2>/dev/null | awk '{print $2}')" \
        || printf 'gamemode            AUSENTE (sudo craft-update — a âncora E94 adota)\n'
    local auto=""
    [ -r "$CONF" ] && auto="$(sed -n 's/^AUTO=//p' "$CONF" | head -1)"
    printf 'automático          %s\n' "$([ "${auto:-0}" = 1 ] && echo ON || echo OFF)"
    if [ -r "$(holder_pid_file)" ]; then
        printf 'manual              ATIVO (holder pid %s)\n' "$(cat "$(holder_pid_file)" 2>/dev/null)"
    else
        printf 'manual              —\n'
    fi
    if has_gamemode; then
        st="$(gm_status "$$" 2>/dev/null)"
        [ "$st" = "1" ] && printf 'gamemoded           ATIVO nesta sessão\n' || printf 'gamemoded           idle (sobe por D-Bus só com jogo — RAM zero)\n'
    fi
    printf 'jogos vivos agora   '
    pgrep -u "$(id -u)" "$GAME_PATS" >/dev/null 2>&1 \
        && pgrep -a -u "$(id -u)" "$GAME_PATS" 2>/dev/null | head -3 \
        || echo "(nenhum da família)"
    printf '\npapel da casa: %s\n' "$LOG"
}

# ── o MENU (a porta mouse-first — o motor único craft-menu) ─────────────
gm_menu() {
    command -v craft-menu >/dev/null 2>&1 || { gm_status_cmd; exit 0; }
    local auto=""
    [ -r "$CONF" ] && auto="$(sed -n 's/^AUTO=//p' "$CONF" | head -1)"
    local items=() choice
    [ "${auto:-0}" = 1 ] && items+=("Automático: ON (desligar)") || items+=("Automático: OFF (ligar)")
    items+=("Ativar agora (manual)" "Desativar" "Status" )
    choice="$(printf '%s\n' "${items[@]}" | craft-menu --title='Modo de jogo' --at=power)" || exit 0
    case "$choice" in
        Automático*) 
            if [ "${auto:-0}" = 1 ]; then
                printf 'AUTO=0\n' > "$CONF" 2>/dev/null
                pkill -f '^bash /usr/local/bin/craft-game watch$|^/usr/bin/env bash /usr/local/bin/craft-game watch$' 2>/dev/null || true
                NOTE_URGEN=normal note 'Automático: OFF' 'O modo de jogo só entra pela porta manual (menu)'
            else
                mkdir -p "$CONF_DIR" 2>/dev/null || true
                printf 'AUTO=1\n' > "$CONF" 2>/dev/null
                setsid /usr/local/bin/craft-game watch >/dev/null 2>&1 </dev/null 9>&- &
                NOTE_URGEN=normal note 'Automático: ON' 'Performance entra sozinha quando um jogo abre'
            fi ;;
        *Ativar*) gm_on ;;
        *Desativar*) gm_off ;;
        *Status*)
            # E106 — O STATUS QUE NÃO EXISTIA (o dono: 'tem o status também,
            # que sinceramente eu clico nele e nada'). O veredito ia TODO
            # para o stdout do labwc — sumido. Agora: a UMA LINHA do
            # veredito sobe na tela (normal, some em 8s) e o veredito
            # COMPLETO vai para o papel (game.log — ou terminal à mão:
            # craft-game status).
            _st_auto="OFF"; [ "${auto:-0}" = 1 ] && _st_auto="ON"
            _st_gm="idle (sobe sozinho com jogo — RAM zero)"
            if [ -r "$(holder_pid_file)" ]; then _st_gm="ATIVO (manual)"; fi
            NOTE_URGEN=normal note "Automático: $_st_auto · gamemoded: $_st_gm" "Completo no papel: ~/.cache/elite/game.log"
            gm_status_cmd >>"$LOG" 2>&1 || true ;;
    esac
}

case "${1:-menu}" in
    status) gm_status_cmd ;;
    on) gm_on ;;
    off) gm_off ;;
    watch) gm_watch ;;
    hook) gm_hook "${2:-}" ;;
    menu|"") gm_menu ;;
    -h|--help|uso) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "uso: craft-game [status|on|off|watch|hook start|hook end|menu]" >&2; exit 2 ;;
esac
