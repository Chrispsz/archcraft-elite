#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-game (E101 → 1.0-107) — O MODO DE JOGO MANUAL
# ═══════════════════════════════════════════════════════════════════════════
# 1.0-107 — O AUTOMÁTICO MORREU POR ORDEM DO DONO (a diretriz §6:
# "remover integralmente o modo automático" — o watcher de sessão, a
# chave de conf que o ligava, a leitura contínua de /proc, os filtros
# de auxiliares do Wine, a perícia do hook e a lógica de aposentadoria
# do gamemoded; deixar o elite-daemon LIVRE de varredura de
# processos). O corpo de era (o watch bash de 5s, a sonda /proc das
# três portas, a aposentadoria do gamemoded, o hook [custom] e a
# perícia do início/fim) sai INTEIRO — os daemons de heurística
# desnecessários são a dívida que a diretriz 1.0-107 cobra.
#
# O MODO É O MANUAL (o PERFIL COMPLETO na mão do dono):
#   · o MÚSCULO é o gamemode do Feral (JÁ NA ISO): o `on` registra um
#     HOLDER próprio no gamemoded — o governor performance (EPP incluso
#     no amd-pstate-epp) e o amd_performance_level high na GPU são DELE
#     (nativos, com rollback próprio na liberação);
#   · o INIBIDOR de ocioso/sono: o holder prende um
#     `systemd-inhibit --what=idle:sleep` no GRUPO dele (a diretriz:
#     "prender inibidor systemd-inhibit --what=idle:sleep no grupo do
#     holder para impedir bloqueio/suspensão durante a jogatina") — a
#     vigília do elite-daemon honra o inhibitor (idle OU sleep, modo
#     block: o logind é o juiz);
#   · o ÍCONE na top bar: o fio do elite-daemon (`game-notify`) acende
#     o pill roxo NO MESMO instante do clique — o clique ESQUERDO no
#     ícone abre este menu, o DIREITO desliga na hora;
#   · o FEEDBACK: toast -u normal na ação do dono (a diretriz: ações
#     manuais exibem confirmação objetiva).
#
# Uso:
#   craft-game            menu (Ativar modo de jogo / Desativar modo de
#                         jogo — conforme o estado atual — e Status)
#   craft-game status     a mesa de fatos (sem palestra — a aula mora no --help)
#   craft-game on|off     manual direto (o perfil completo acima)
#   craft-game toggle     o pill da barra pede pelo bus: ativo → desliga,
#                         parado → liga (o estado REAL é o juiz)
#   craft-game pill       JSON para o módulo game da topbar (E115): o
#                         assento só existe QUANDO o modo está ATIVO de
#                         verdade (E126: o estado é o QueryStatus do D-Bus,
#                         não a vida do daemon — o rig fotografou o ícone
#                         aceso SEM jogo nenhum porque o gamemoded sobrevive
#                         ao último cliente)
# ═══════════════════════════════════════════════════════════════════════════
set -u

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/elite"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/game.log"

# a família de JOGOS da casa (ERE sobre o COMM, ancorada) — SÓ PARA O
# STATUS listar os vivos do momento (uma leitura PONTUAL por consulta,
# nunca o loop contínuo de era: o 1.0-107 matou a varredura).
GAME_PATS='^wine6?-preload(er)?$|^gamescope$|^pcsx2$|^retroarch$|^duckstation$|^dolphin-emu$|^melonds$|^citra-qt$|^ryujinx$|^PPSSPPSDL$|^rpcs3$|^osu!$|^Cemu$'

# o glifo de log único (o papel da casa — 256 KiB de teto, lei E36)
glog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || true
}

# o aviso para o dono: a ação MANUAL do dono usa -u normal (a diretriz
# 1.0-107 §1: "ações manuais do usuário exibem confirmação objetiva") —
# sobe na tela, some em 8s (nunca critical — a doutrina da casa fica).
note() {
    local urgen="${NOTE_URGEN:-normal}"
    command -v notify-send >/dev/null 2>&1 || return 0
    timeout 5 notify-send -a 'Elite · Jogo' -u "$urgen" -t 8000 "$@" >/dev/null 2>&1 || true
}

# ── o canal D-Bus do gamemode (o sistema é root por trás do gamemoded) ──
gm_call() { # $1..n = método + args (int32:…)
    dbus-send --system --print-reply --dest=org.freedesktop.GameMode \
        /org/freedesktop/GameMode "$@" 2>/dev/null \
        | awk '/int32/ {print $NF; exit}'
}
gm_register() { gm_call org.freedesktop.GameMode.RegisterGame "int32:$1" "int32:$1" "int32:0"; }
gm_unregister() { gm_call org.freedesktop.GameMode.UnregisterGame "int32:$1" "int32:$1" "int32:0"; }
gm_status() { gm_call org.freedesktop.GameMode.QueryStatus "int32:$1" "int32:$1" "int32:0"; }

has_gamemode() {
    command -v dbus-send >/dev/null 2>&1 && command -v gamemoded >/dev/null 2>&1
}

# o holder do modo MANUAL: um processo da casa que dorme enquanto o dono
# quer performance — o pid registrado é o DELE (off = unregister + ceifa)
holder_pid_file() { printf '%s/game-holder.pid' "$RUN_DIR"; }

# 2.0 — a sonda silenciosa do QueryStatus (o toggle pergunta; o papel
# só fala no menu — zero stdout roubado do chamador; a pergunta é o
# gm_status do PRÓPRIO pid — o daemon proxy conta, o manual idem)
gm_status_quiet() {
    has_gamemode || return 1
    [ "$(gm_status $$)" = "1" ]
}

ensure_run_dir() { mkdir -p "$RUN_DIR" 2>/dev/null || true; }

# o estado novo no FILO do elite-daemon (a barra acende o pill roxo NO
# MESMO instante do clique — o cinto do 30s é a rede, o fio é o gesto)
bus_notifica() {
    [ -x /usr/local/bin/elite-daemon ] || return 0
    /usr/local/bin/elite-daemon game-notify >/dev/null 2>&1 || true
}

# ── 1.0-107 — O MANUAL COMPLETO: gamemoded + inibidor idle:sleep + ────────
#      o pill na hora (CPU governor performance + GPU high são do
#      gamemoded NATIVO; o inibidor prende bloqueio E suspensão no grupo
#      do holder; o fio do daemon acende o ícone da top bar no clique).
gm_on() {
    if ! has_gamemode; then
        glog "manual: gamemode/dbus-send ausente — nada a fazer (honesto)"
        echo "✖ O pacote gamemode não está instalado — Atualizar o sistema (menu) traz e o modo passa a funcionar" >&2
        NOTE_URGEN=normal note 'Modo de jogo não ativou' 'O pacote gamemode falta neste sistema — Atualizar o sistema (menu) adota e o modo passa a funcionar'
        return 1
    fi
    ensure_run_dir
    local hpid file
    file="$(holder_pid_file)"
    if [ -r "$file" ] && kill -0 "$(cat "$file" 2>/dev/null)" 2>/dev/null; then
        glog "manual: já estava ATIVO (holder pid $(cat "$file" 2>/dev/null) vivo) — nada mudou"
        echo "o modo de jogo JÁ está ativo (manual)" >&2
        return 1
    fi
    # E121 — O HOLDER DESPRENDIDO: stdin/stdout/stderr em /dev/null (a
    # substituição $(…) espera EOF e o EOF nunca chegava — o 'Ativar
    # agora' TRAVAVA para sempre; o desprendimento TOTAL fecha a janela).
    # 1.0-107 — O INIBIDOR É idle:sleep (a diretriz: "impedir bloqueio/
    # suspensão durante a jogatina" — o sleep entra na trava junto com
    # o idle: a vigília do daemon honra os DOIS lados do logind).
    if command -v systemd-inhibit >/dev/null 2>&1; then
        hpid="$(setsid systemd-inhibit --what=idle:sleep --who=Elite --why='Modo de jogo ativo' --mode=block sh -c 'while :; do sleep 30; done' </dev/null >/dev/null 2>&1 & echo $!)"
    else
        hpid="$(setsid sh -c 'while :; do sleep 30; done' </dev/null >/dev/null 2>&1 & echo $!)"
    fi
    printf '%s\n' "$hpid" > "$file" 2>/dev/null || true
    if gm_register "$hpid" >/dev/null 2>&1; then
        # o estado PRIMEIRO (a ordem que o dono pediu): o papel assina o
        # 'manual: ON' no MESMO instante do registro no gamemode; o fio
        # do elite-daemon acende o pill roxo DEPOIS — nenhuma porta
        # estranha entre o clique e a assinatura.
        glog "manual: ON (holder pid $hpid no gamemode + inhibitor logind idle:sleep armado — governador performance + GPU high)"
        bus_notifica
        NOTE_URGEN=normal note 'Modo de jogo ATIVO' 'Governor performance + GPU high + inibidor de ocioso/sono (desligue no menu ou craft-game off)'
        echo "==> modo de jogo ATIVO (governor performance + GPU high + inibidor de ocioso/sono)"
        return 0
    fi
    kill -- -"$hpid" 2>/dev/null || kill "$hpid" 2>/dev/null || true
    rm -f "$file" 2>/dev/null || true
    glog "manual: o gamemode RECUSOU o registro (dbus?) — nada mudou"
    NOTE_URGEN=normal note 'Modo de jogo não ativou' "O gamemode não respondeu — prova em $LOG"
    echo "✖ o gamemode não respondeu — prova em $LOG" >&2
    return 1
}

gm_off() {
    local file hpid
    file="$(holder_pid_file)"
    if [ -r "$file" ]; then
        hpid="$(cat "$file" 2>/dev/null)"
        gm_unregister "$hpid" >/dev/null 2>&1 || true
        # o GRUPO inteiro morre (o holder é setsid: o grupo DELE é
        # systemd-inhibit + o corpo do sleep — matar só o pid deixaria
        # o inibidor/sleep órfão segurando o logind)
        kill -- -"$hpid" 2>/dev/null || kill "$hpid" 2>/dev/null || true
        rm -f "$file" 2>/dev/null || true
        # o estado PRIMEIRO no papel; o fio do pill vem depois
        glog "manual: OFF (holder pid $hpid liberado — o gamemode devolve o governor, o inhibitor morre com o grupo)"
        bus_notifica
        NOTE_URGEN=normal note 'Modo de jogo DESATIVADO' 'Perfil normal restaurado (governor/GPU da casa)'
        echo "==> modo de jogo DESATIVADO (o governor volta ao perfil da casa)"
        return 0
    fi
    NOTE_URGEN=normal note 'Modo de jogo' 'Não estava ativo — nada a desativar'
    echo "o modo de jogo não está ativo (nada a desativar)" >&2
    return 1
}

# ── o PILL (o assento da topbar — E115: o estado é o QUERYSTATUS, ──────────
#      NÃO o pgrep do daemon: o gamemoded é ativado por D-Bus e SOBREVIVE
#      ao último cliente — 'pgrep gamemoded' acenderia o assento para
#      sempre. O D-Bus é o juiz: QueryStatus 1 = modo ATIVO (o holder
#      manual conta); 0/sem resposta = assento vazio, ZERO pixel.
gm_pill() {
    if [ "$(gm_status "$$" 2>/dev/null)" = "1" ]; then
        printf '{"text":"\\uf11b","class":"game-on","tooltip":"Modo de jogo ATIVO — governor performance + GPU high (desligue no menu · clique direito: desativar)"}\n'
    else
        printf '{"text":"","class":"","tooltip":""}\n'
    fi
}

# ── o STATUS (a mesa de FATOS — E124: sem palestra, a aula mora no ─────────
#      --help; uma linha cada)
gm_status_cmd() {
    printf '%s\n' '═══ Modo de jogo ═══'
    if has_gamemode; then
        printf 'gamemode            instalado\n'
    else
        printf 'gamemode            AUSENTE — Atualizar o sistema (menu) traz o pacote\n'
    fi
    if [ -r "$(holder_pid_file)" ]; then
        printf 'manual              ATIVO\n'
    else
        printf 'manual              —\n'
    fi
    if has_gamemode; then
        st="$(gm_status "$$" 2>/dev/null)"
        [ "$st" = "1" ] && printf 'gamemoded           ATIVO\n' || printf 'gamemoded           idle (sobe sozinho só com registro)\n'
    fi
    printf 'jogos vivos agora   '
    pgrep -u "$(id -u)" "$GAME_PATS" >/dev/null 2>&1 \
        && pgrep -a -u "$(id -u)" "$GAME_PATS" 2>/dev/null | head -3 \
        || echo "(nenhum)"
    printf '\nlog: %s\n' "$LOG"
}

# ── o MENU (a porta mouse-first — o motor único é o craft-pick) ───────────
# E150→1.0-105 — O PICK VESTE AS FLAGS REAIS DE `craft-pick --help` E A
#      FORMA DO FOOT (a prova do rig da 1.0-98: o menu abortava com
#      'Opção --title=... desconhecida' quando o binário do rig não
#      conhecia a flag — chamador de uma era, binário de outra, o MENU
#      morto no meio; e o terminal foot NÃO aceita --title=VALOR
#      colado: a forma da casa é o -T "..." COM ESPAÇO).
# E106/2 — (1) a sonda do -T casa o traço também colado ao COLCHETE do
#      uso ('[-T TÍTULO' — a âncora de espaço/linha da era JAMAIS casava
#      o papel real e o painel nascia SEM título de boa-fé); (2) o
#      stderr do craft-pick desce no vazio (os avisos de portal do GTK
#      não mancham a sessão nativa) SEM tocar no contrato 0/1.
gm_pick() {
    if craft-pick --help 2>/dev/null | grep -qE -- '(^|[^[:alnum:]])-T[[:space:]]'; then
        craft-pick -T "$1" 2>/dev/null
    else
        craft-pick 2>/dev/null
    fi
}

gm_menu() {
    command -v craft-pick >/dev/null 2>&1 || { gm_status_cmd; exit 0; }
    local items=() choice
    # 1.0-107 — O ITEM DIZ O ESTADO (a diretriz §6: "Ativar modo de
    # jogo / Desativar modo de jogo (conforme o estado atual)"): o
    # holder vivo vira a porta de SAÍDA do modo.
    if [ -r "$(holder_pid_file)" ]; then
        items+=("Desativar modo de jogo")
    else
        items+=("Ativar modo de jogo")
    fi
    items+=("Status")
    # E119 — O PAPEL DA PORTA (o clique que chega deixa a escolha; o
    # fecho benigno segue na lei dos menus; o rc anômalo fica nomeado).
    _gm_rc=0
    choice="$(printf '%s\n' "${items[@]}" | gm_pick 'Modo de jogo')" || _gm_rc=$?
    if [ "$_gm_rc" = 0 ]; then
        glog "menu: escolha '$choice' (despacho = papel)"
    else
        case "$_gm_rc" in
            1|2|143) : ;;   # ESC/toggle/cross-dismiss — a lei dos menus, benigno
            *) glog "menu: fechou ANORMAL (rc=$_gm_rc) — nenhum despacho correu" ;;
        esac
        exit 0
    fi
    case "$choice" in
        *Ativar*) gm_on ;;
        *Desativar*) gm_off ;;
        *Status*)
            # E125 — O PAPEL RECEBE UMA LINHA (o estado completo sobe NA
            # TELA; o papel guarda a frase que cabe).
            glog "status: consultado ($(gm_status_cmd 2>/dev/null | grep -v '^═══' | grep -v '^$' | tr '\n' ' ' | sed 's/  */ /g; s/ $//'))"
            if command -v foot >/dev/null 2>&1; then
                foot -e sh -c 'craft-game status; echo; read -r -p "Enter para fechar" _' &
            else
                _st_gm="idle (sobe sozinho só com registro — RAM zero)"
                if [ -r "$(holder_pid_file)" ]; then _st_gm="ATIVO (manual)"; fi
                NOTE_URGEN=normal note "gamemoded: $_st_gm" "Completo no papel: ~/.cache/elite/game.log"
            fi ;;
    esac
}

# 2.0 — O TOGGLE (o pill da barra pede pelo bus: ativo → desliga,
# parado → liga; o estado REAL do holder é o juiz — o mesmo do menu)
gm_toggle() {
    if [ -r "$(holder_pid_file)" ] || gm_status_quiet; then
        gm_off
    else
        gm_on
    fi
}

case "${1:-menu}" in
    status) gm_status_cmd ;;
    pill) gm_pill ;;
    on) gm_on ;;
    off) gm_off ;;
    toggle) gm_toggle ;;
    menu|"") gm_menu ;;
    -h|--help|uso) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "uso: craft-game [status|on|off|toggle|menu|pill]" >&2; exit 2 ;;
esac
