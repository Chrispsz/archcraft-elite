#!/usr/bin/env bash
# craft-update — atualiza TUDO que a Elite entrega (v5 — E50)
# ═══════════════════════════════════════════════════════════════════════════
# v1 (v2.10.5): 'sudo pacman -Syu' + cabeçalho honesto (paru prometido não
#   existe — o bloco fica pronto, mas calado enquanto paru não entra).
# v2 (E32 — diretriz do dono: "deixe tudo atualizável, a distro não pode
#   ficar velha"): o pacman.conf da Elite (E32) agora entrega o [elite-local]
#   (brave-origin, pwvucontrol, craft-toplevel, wlrctl) com Server =
#   releases/latest/download — o MESMO -Syu abaixo atualiza o navegador,
#   que era o único pacote congelado. Este script soma duas verdades que o
#   pacman não vê:
#   · kernel novo na transação → aviso de reboot (comparando -Q antes/depois,
#     sem adivinhar formato de uname — exato por construção);
#   · código da casa (scripts/configs) não é pacote → o marker
#     /usr/local/share/elite/VERSION (escrito no build) compara com a
#     release viva e aponta ISO/cura quando defasa. Offline-safe: falha de
#     rede aqui é silêncio (nunca é erro de atualização).
# v3 (E43 — O CANAL DIÁRIO): o código de casa em /usr/local/bin AGORA É
#   PACOTE (elite-craft + craft-toplevel) e o commit de hoje chega ao rig
#   no -Syu de hoje — sem formatar, sem reinstalar (a demanda do dono).
#   O --overwrite ESCOPADO à casa existe por causa da ADOÇÃO: nos rigs
#   instalados, os arquivos de /usr/local/bin nasceram SEM dono (overlay da
#   ISO) e o pacman recusa sobrescrever não-dono ANTES de qualquer scriptlet
#   (pre_install não alcança) — o --overwrite não-cibe /usr/local/bin/*
#   adota os arquivos na 1ª vez e é inócuo depois (dono = transação normal).
#   O domínio da casa é /usr/local/bin: configs de usuário (~) NUNCA são
#   tocados por update.
# v4 (E46 — O CANAL QUE INSTALA + A CADÊNCIA): o dono: "vejo os erros
#   persistir após atualizar… nosso sistema deve atualizar perfeitamente de
#   forma cirúrgica e com a persistência necessária". A FERIDA CRAVADA: o
#   pacman só ATUALIZA o que JÁ ESTÁ INSTALADO — e o veículo de TODAS as
#   curas (elite-craft, E43) nunca tinha sido INSTALADO nos rigs cuja ISO é
#   anterior (o packages.add só carregava o craft-toplevel): o 'Comprimir…'
#   quebrado da era pré-E42 e o idle sem a normalização E44 sobreviveram a
#   TODOS os craft-update. CURA em três mãos:
#   (1) OS ALVOS EXPLÍCITOS no -Syu (elite-craft craft-toplevel): quem não
#       tem, INSTALA (o pre_install adota os arquivos de overlay); quem tem,
#       atualiza. A porta que o dono já usa ('Atualizar sistema') fecha o
#       déficit na 1ª rodada e habilita o automatismo (timers abaixo).
#   (2) --canal (root, dose DIÁRIA — timer elite-channel.timer, 11:30±40min):
#       a dose cirúrgica — SÓ os pacotes do [elite-local] (pacman -Slq),
#       --needed, offline-safe (repo não respondeu = silêncio, o timer volta
#       amanhã), log honesto + aviso na sessão do usuário.
#   (3) --sistema (root, dose SEMANAL — timer elite-sysupdate.timer,
#       sáb 10:00±2h): o -Syu completo COM REDE DE SEGURANÇA — snapshot PRE
#       do snapper antes, POST depois (quebrou? o GRUB liga o snapshot e o
#       rollback é um reboot), kernel novo = aviso de reboot, pacman ocupado
#       = silêncio (a semana volta). A CADÊNCIA (o dono pediu para pensar):
#       casa = DIÁRIA · sistema = SEMANAL · ISO = MENSAL (1º, tarefa 4) ·
#       manual = este script (sempre). Tudo só na tomada (ConditionACPower).
#   A morada do log é overridável (ELITE_UPDATE_LOG) para prova em sandbox —
#   mesma escola do VMARK/DETECT_ONLY (o teste nunca escreve em /var).
# v4.1 (E48 — A CURA CHEGA À SESSÃO VIVA): o dono atualizou e o problema da
#   suspensão PERSISTIU — o dump nl3z provou o réu: o update entrega
#   ARQUIVOS, mas o swayidle que corre desde o login segue com a RECEITA
#   VELHA até relogin (o rig corria 'timeout 1200 systemctl suspend' CRU,
#   receita anterior à E44 — lock e apagar separados, before-sleep sem o
#   --if-needed). O update perfeito não pede relogin para valer: quando o
#   elite-craft MUDA na transação, o craft-update reinicia o swayidle da
#   sessão (pkill cirúrgico) — o supervisor craft-bars o ressuscita em ~1s
#   com o código novo (craft-idle start = normalização E44 do conf legado
#   + receita nova) e o fluxo de idle/suspensão vale NA HORA, sem relogin.
#   Sem supervisor vivo, o pkill NÃO sai (matar sem volta é dano, não
#   cura) — o papel diz a verdade e o relogin aplica.
# v4.2 (E49 — A CURA NA SESSÃO INTEIRA + A ADOÇÃO DE UMA VIA): duas feridas
#   que o v4.1 deixou abertas:
#   (1) o refresh reiniciava SÓ o swayidle — mas o elite-craft carrega
#       TODOS os daemons vivos da casa (a dock com a transição suave, o
#       roteador de áudio, o idle) e o craft-toplevel carrega o daemon de
#       janelas: o update trocava os ARQUIVOS e cada um seguia velho na
#       sessão até relogin (o dono veria 'a dock continua piscando'). O
#       refresh é agora POR DELTA e POR PACOTE: só morre quem mudou, o
#       toplevel primeiro (a dock nova nasce sobre ele de pé), SEMPRE
#       condicionado ao supervisor craft-bars vivo.
#   (2) o OVO-GALINHA: o rig da era pré-E46 roda um craft-update SEM os
#       alvos explícitos — o -Syu atualiza o instalado e o elite-craft (o
#       veículo onde mora o craft-update novo) NUNCA é adotado. A quebra
#       mora no elite-adopt (hook PostTransaction que viaja no
#       craft-toplevel — o ÚNICO pacote da casa que TODO rig tem): veículo
#       ausente → adoção desprendida (pacman não roda dentro do hook — o
#       lock da transação-mãe ainda vive) → craft-update --adotar fecha a
#       rodada: sessão inteira com o código novo + cadência ligada, UMA
#       atualização, sem relogin.
# v5 (E50 — O SISTEMA EM UM PACOTE SÓ): o dono: "a atualização do sistema
#   como um todo deveria ser em um só pacote — assim fica até mais
#   organizado o repositório e já atualizava todo o sistema com um só
#   pacote". A era dos DOIS veículos (elite-craft + craft-toplevel) se
#   ENCERRA: o elite-system carrega TUDO (scripts + daemon de janelas +
#   units da cadência) e o pacman substitui o par legado na transação
#   (replaces/conflicts). As mãos:
#   (1) O ALVO ÚNICO no -Syu (elite-system): quem não tem, INSTALA (e o
#       pacman remove o par legado na MESMA transação); quem tem,
#       atualiza. UM número para olhar, UM dono para /usr/local/bin.
#   (2) O DELTA DA CASA ÚNICA: o refresh da sessão viva lê o elite-system
#       (os deltas LEGADOS contam para a transição — presente → ausente é
#       a substituição acontecendo); o daemon de janelas agora viaja no
#       pacote único, então mudou a casa = toplevel também reinicia (a
#       ordem importa: toplevel primeiro, a dock nasce sobre ele de pé).
#   (3) A PONTE dos rigs sem pacote algum: o craft-toplevel 1.0-5 (o
#       ÚNICO pacote que TODO rig tem) puxa o elite-system pelo hook e
#       entrega a conclusão ao --adotar (os 'antes' LEGADOS que o hook
#       capturou dão o delta da transição — o pacote único não tinha
#       'antes': a ADOÇÃO já é a mudança).
# v5.1 (E51 — A CADÊNCIA AO LIGAR): o dono: "a ISO deve atualizar o
#   sistema a cada vez que iniciar para poupar o usuário de ficar
#   atualizando manualmente". O timer de relógio (11:30) era uma aposta
#   contra a rotina do dono — máquina desligada na hora = dia sem cura. O
#   boot é o ÚNICO relógio que o dono bate todos os dias: o
#   elite-bootupdate.timer (OnBootSec 3min) assume a dose da casa e o
#   elite-channel APOSENTA (disable --now + unit files fora do caminho —
#   a função elite_cadencia serve as DUAS portas, --adotar e manual,
#   idempotente). A dose semanal (sistema inteiro, com snapshot PRE/POST)
#   segue no sáb 10:00 — a rede de segurança não se corta.
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

KPKG=linux-cachyos-bore
# marker de versão da casa — overridável para prova em sandbox
VMARK="${ELITE_VERSION_MARKER:-/usr/local/share/elite/VERSION}"
# log da automação — overridável para prova em sandbox (mesma escola)
ULOG="${ELITE_UPDATE_LOG:-/var/log/elite-update.log}"

ulog() {
    mkdir -p "$(dirname "$ULOG")" 2>/dev/null || true
    # teto 256 KiB (lei E36 — a mesma política de toda a família de logs)
    if [ -f "$ULOG" ] && [ "$(wc -c <"$ULOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$ULOG" > "$ULOG.tmp" 2>/dev/null && mv -f "$ULOG.tmp" "$ULOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$ULOG" 2>/dev/null || true
}

# root executa direto; humano com sessão usa o sudo (o interativo é a porta
# do dono; os timers nascem root — mesmo binário, dois mundos)
run_root() {
    if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# o aviso para a SESSÃO do dono: root não tem bus — vai pelo bus de cada
# usuário logado (/run/user/N/bus; sem bus = sem sessão gráfica, silêncio)
notify_users() {
    local uid
    while read -r uid _; do
        [ -n "$uid" ] || continue
        [ -S "/run/user/$uid/bus" ] || continue
        if [ "$(id -u)" = 0 ]; then
            runuser -u "#$uid" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                notify-send -a 'Elite' "$@" 2>/dev/null || true
        else
            sudo -u "#$uid" env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                notify-send -a 'Elite' "$@" 2>/dev/null || true
        fi
    done < <(loginctl list-users --no-legend 2>/dev/null || true)
}

# o delta da casa ÚNICA: a versão do elite-system (vazio = ausente — a
# ADOÇÃO e a SUBSTITUIÇÃO também são delta: '?' → '1.0-1' mudou a casa)
es_q() {
    pacman -Q elite-system 2>/dev/null | awk '{print $2}' || true
}

# LEGADO (a transição E50): os DOIS veículos da era antiga. Mudarem AQUI
# (presente → ausente) é a prova da substituição pelo pacote único; o
# papel registra a história completa (rig nenhum fica sem narrativa)
elite_craft_q() {
    pacman -Q elite-craft 2>/dev/null | awk '{print $2}' || true
}

craft_tl_q() {
    pacman -Q craft-toplevel 2>/dev/null | awk '{print $2}' || true
}

# E48→E49→E50 — A CURA NA SESSÃO VIVA, agora com UM dono: o update troca
# ARQUIVOS, mas o daemon vivo corre a receita ANTERIOR até relogin. O
# pkill é cirúrgico DUAS VEZES: por DELTA (só morre quem mudou de pacote)
# e por SUPERVISOR (só morre quem tem craft-bars vivo para ressuscitar em
# ~1s com o código novo). A ORDEM importa: o toplevel primeiro — a dock
# nova nasce sobre o daemon de janelas já de pé (ELITE_TL_SETTLE é a
# porta de prova da espera, mesma escola do VMARK/ELITE_UNIT_DIR). No E50
# o daemon de janelas viaja DENTRO do pacote único: mudou a casa → o
# toplevel também reinicia (os deltas LEGADOS preservam os rigs de
# transição).
refresh_session() {
    local casa_mudou="$1" tl_mudou="$2" uid
    [ "$casa_mudou" = 1 ] || [ "$tl_mudou" = 1 ] || return 0
    while read -r uid _; do
        [ -n "$uid" ] || continue
        if ! pgrep -u "$uid" -x craft-bars >/dev/null 2>&1; then
            ulog "sessão: supervisor craft-bars AUSENTE (uid $uid) — a sessão segue com o código antigo até relogin (pkill sem volta seria dano, não cura)"
            continue
        fi
        if { [ "$tl_mudou" = 1 ] || [ "$casa_mudou" = 1 ]; } && pgrep -u "$uid" -x craft-toplevel >/dev/null 2>&1; then
            pkill -u "$uid" -x craft-toplevel 2>/dev/null || true
            ulog "sessão: craft-toplevel (uid $uid) reiniciado — o supervisor ressuscita com o daemon de janelas novo"
            sleep "${ELITE_TL_SETTLE:-2}"
        fi
        if [ "$casa_mudou" = 1 ]; then
            if pgrep -u "$uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' >/dev/null 2>&1; then
                pkill -u "$uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' 2>/dev/null || true
                ulog "sessão: dock craft-dock-gui (uid $uid) reiniciada — a transição suave dos dinâmicos vale SEM relogin"
            fi
            if pgrep -u "$uid" -x craft-audio-route >/dev/null 2>&1; then
                pkill -u "$uid" -x craft-audio-route 2>/dev/null || true
                ulog "sessão: craft-audio-route (uid $uid) reiniciado — o roteamento de áudio segue com o código novo"
            fi
            if pgrep -u "$uid" -x swayidle >/dev/null 2>&1; then
                pkill -u "$uid" -x swayidle 2>/dev/null || true
                ulog "sessão: swayidle (uid $uid) reiniciado — o supervisor craft-bars ressuscita com a receita nova (idle/suspensão valem SEM relogin)"
            fi
        fi
    done < <(loginctl list-users --no-legend 2>/dev/null || true)
}

# E51 — A CADÊNCIA AO LIGAR (a função única das duas portas — --adotar e
# manual): a casa atualiza A CADA BOOT (o dono: "a ISO deve atualizar o
# sistema a cada vez que iniciar para poupar o usuário de ficar
# atualizando manualmente"). O timer de relógio (11:30) era uma aposta
# contra a rotina: máquina desligada na hora = dia sem cura. O boot é o
# relógio que o dono BATE todos os dias (elite-bootupdate.timer,
# OnBootSec 3min) + a dose SEMANAL do sistema (sáb 10:00) segue como rede
# completa. O elite-channel APOSENTA aqui: disable --now + as unit files
# fora do caminho (rigs com overlay sem dono não ficam com cadência
# fantasma; os que tinham as units por PACOTE já as perderam no replaces
# do elite-system 1.0-2 — o rm é para os órfãos de overlay).
elite_cadencia() {
    UNITDIR="${ELITE_UNIT_DIR:-/etc/systemd/system}"
    if run_root systemctl disable --now elite-channel.timer >/dev/null 2>&1; then
        ulog "cadência: elite-channel.timer aposentado — a casa atualiza AO LIGAR (E51)"
    fi
    rm -f "$UNITDIR/elite-channel.timer" "$UNITDIR/elite-channel.service" 2>/dev/null || true
    if [ -f "$UNITDIR/elite-bootupdate.timer" ] && [ -f "$UNITDIR/elite-sysupdate.timer" ]; then
        if run_root systemctl enable --now elite-bootupdate.timer elite-sysupdate.timer >/dev/null 2>&1; then
            ulog "cadência: AO LIGAR (bootupdate, 3min pós-boot) · sistema SEMANAL sáb 10:00"
            echo "==> automatismo da casa ativo: casa AO LIGAR (3min pós-boot) · sistema SEMANAL sáb 10:00"
        fi
    fi
}

# o delta que IMPORTA para a sessão: versão antes ≠ depois (ou adoção, ou
# SUBSTITUIÇÃO de era), POR PACOTE — elite-system mudou (ou o legado
# mudou/apagou) → dock/áudio/idle/toplevel; o papel narra a história
# completa da transição (o rig da era velha fica com a prova da troca)
refresh_if_craft_changed() {
    local es_antes="$1" ec_antes="$2" tl_antes="$3" es_depois ec_depois tl_depois casa_m=0 tl_m=0
    es_depois="$(es_q)"
    ec_depois="$(elite_craft_q)"
    tl_depois="$(craft_tl_q)"
    [[ "$es_depois" != "$es_antes" ]] && casa_m=1
    [[ "$ec_depois" != "$ec_antes" ]] && casa_m=1
    [[ "$tl_depois" != "$tl_antes" ]] && tl_m=1
    if [ "$casa_m" = 1 ] || [ "$tl_m" = 1 ]; then
        ulog "casa: elite-system ${es_antes:-ausente} → ${es_depois:-ausente} · elite-craft ${ec_antes:-ausente} → ${ec_depois:-ausente} · craft-toplevel ${tl_antes:-ausente} → ${tl_depois:-ausente} — a sessão recebe o código novo"
        refresh_session "$casa_m" "$tl_m"
        notify_users 'Elite: código da casa atualizado' \
            'Idle/suspensão, dock e áudio da sessão já valem o novo — sem relogin.'
    fi
}

# ── a porta da ADOÇÃO (E49/E50 — o elite-adopt entrega aqui): o rig velho
# foi puxado pelo hook do craft-toplevel (a PONTE para o pacote único); o
# craft-update NOVO conclui a rodada: refresh da sessão viva (o pacote
# único não tinha 'antes' — a ADOÇÃO já é a mudança; os 'antes' LEGADOS
# do hook narram a substituição) + cadência ligada. UMA atualização, sem
# relogin.
if [[ "${1:-}" == "--adotar" ]]; then
    # assinatura v5: --adotar ES_ANTES EC_ANTES TL_ANTES — a ponte (o hook)
    # não tem 'antes' do pacote único e passa VAZIO na frente (a ADOÇÃO já
    # é a mudança); quem chama com o delta completo o narra inteiro
    # (o verbo consome $1 — os deltas moram em $2/$3/$4; a lição do rc
    # capturado fora da negação: a posição certa ANTES de usar)
    refresh_if_craft_changed "${2:-}" "${3:-}" "${4:-}"
    elite_cadencia
    exit 0
fi

# ── dose da casa AO LIGAR (elite-bootupdate.timer — OnBootSec 3min, E51) ─
if [[ "${1:-}" == "--canal" ]]; then
    ulog "canal: iniciando (dose da casa — ao ligar, E51)"
    es_before="$(es_q)"
    ec_before="$(elite_craft_q)"
    tl_before="$(craft_tl_q)"
    CANAL_PKGS=()
    # E50 — a era do PACOTE ÚNICO: o par legado NÃO entra na dose. O
    # elite-craft é FÓSSIL do db (o replaces o removeu do rig) e o
    # craft-toplevel é a PONTE congelada (o daemon vive no pacote único) —
    # puxar qualquer um num rig da era nova seria BRIGA DE DONO pelo
    # binário do daemon e o pacman RECUSARIA a dose inteira.
    ERA_UNICA=""
    [ -n "$(es_q)" ] && ERA_UNICA=1
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if [ -n "$ERA_UNICA" ] && { [ "$p" = "elite-craft" ] || [ "$p" = "craft-toplevel" ]; }; then
            continue
        fi
        CANAL_PKGS+=("$p")
    done < <(pacman -Slq elite-local 2>/dev/null || true)
    if [ "${#CANAL_PKGS[@]}" -eq 0 ]; then
        ulog "canal: [elite-local] não respondeu (offline?) — silêncio, o timer volta amanhã"
        exit 0
    fi
    if [ -n "$ERA_UNICA" ]; then
        ulog "canal: era do pacote único — o par legado (fóssil/ponte) fica fora da dose"
    fi
    if ! run_root pacman -Sy --needed --noconfirm \
            --overwrite '/usr/local/bin/*' "${CANAL_PKGS[@]}" >>"$ULOG" 2>&1; then
        ulog "canal: pacman RECUSOU a dose — a prova está acima no log"
        notify_users -u critical 'Canal da Elite falhou' \
            'A dose diária da casa foi recusada — log: /var/log/elite-update.log'
        exit 1
    fi
    ulog "canal: OK — ${CANAL_PKGS[*]}"
    refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"
    notify_users 'Elite: canal em dia' 'O código da casa foi atualizado (dose diária).'
    # E51.1 — a dose AUTO-CURA a cadência: rigs adotados por caminhos que
    # não passam pela elite_cadencia (a dose v4.2 de hoje) recebem a troca
    # do timer na PRÓPRIA dose (idempotente — disable falho é silêncio)
    elite_cadencia
    exit 0
fi

# ── dose SEMANAL: o sistema inteiro, com rede de segurança (elite-sysupdate.timer)
if [[ "${1:-}" == "--sistema" ]]; then
    ulog "sistema: iniciando (dose semanal completa)"
    # pacman ocupado? (o dono transacionando ou o keyring-fix) — silêncio
    if command -v fuser >/dev/null 2>&1 && fuser /var/lib/pacman/db.lck >/dev/null 2>&1; then
        ulog "sistema: pacman ocupado (lock vivo) — silêncio, a semana volta"
        exit 0
    fi
    PRE_N=""
    if command -v snapper >/dev/null 2>&1 && snapper -c root list-configs >/dev/null 2>&1; then
        PRE_N="$(snapper -c root create -t pre -p -d 'elite-sysupdate' 2>/dev/null || true)"
        if [ -n "$PRE_N" ]; then
            ulog "sistema: snapshot PRE #$PRE_N — a rede de segurança está armada"
        else
            ulog "sistema: snapper recusou o PRE — seguindo SEM rede (a prova fica no log)"
        fi
    else
        ulog "sistema: snapper indisponível — seguindo SEM rede de segurança (honesto)"
    fi
    kbefore="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
    es_before="$(es_q)"
    ec_before="$(elite_craft_q)"
    tl_before="$(craft_tl_q)"
    # o rc REAL se captura fora da negação (dentro do `if !`, o $? é o
    # status NEGADO — o log imprimiria rc=1 em qualquer falha)
    sys_rc=0
    run_root pacman -Syu --needed --noconfirm \
        --overwrite '/usr/local/bin/*' >>"$ULOG" 2>&1 || sys_rc=$?
    if [ "$sys_rc" -ne 0 ]; then
        ulog "sistema: pacman FALHOU (rc=$sys_rc) — snapshot PRE #$PRE_N guarda o estado anterior"
        notify_users -u critical 'Atualização semanal falhou' \
            "rc=$sys_rc — log: /var/log/elite-update.log${PRE_N:+ · rollback: snapshot #$PRE_N no GRUB}"
        exit 1
    fi
    refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"
    if [ -n "$PRE_N" ] && snapper -c root create -t post --pre-number "$PRE_N" \
            -d 'elite-sysupdate' >/dev/null 2>&1; then
        ulog "sistema: snapshot POST #$PRE_N criado (o par PRE/POST fecha a história)"
    fi
    kafter="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
    if [ -n "$kafter" ] && [ "$kafter" != "$kbefore" ]; then
        ulog "sistema: kernel ${kbefore:-ausente} → $kafter — REBOOT aplica"
        notify_users 'Elite: sistema atualizado' \
            "Kernel novo ($kafter) — REINICIE para rodá-lo.${PRE_N:+ Snapshots: #$PRE_N}"
    else
        ulog "sistema: OK (kernel intocado)"
        notify_users 'Elite: sistema atualizado' 'Atualização semanal concluída.'
    fi
    exit 0
fi

# ── a porta MANUAL (o menu 'Atualizar sistema'): o -Syu completo ────────
# kernel ANTES da transação (o -Syu pode tocá-lo; vazio = pacote ausente)
kbefore="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
# E48 — a casa ANTES (a adoção e o upgrade contam como delta da casa)
# E50 — o ALVO ÚNICO: o elite-system é a casa inteira; o pacman substitui
# o par legado (elite-craft + craft-toplevel) na MESMA transação
# (replaces/conflicts) — os deltas LEGADOS capturados aqui narram a
# substituição (presente → ausente) no papel
es_before="$(es_q)"
ec_before="$(elite_craft_q)"
tl_before="$(craft_tl_q)"

# E46/E50 — o alvo EXPLÍCITO faz a ADOÇÃO E A SUBSTITUIÇÃO DE ERA: o rig
# que nunca teve pacote INSTALA o único nesta transação (o pre_install
# adota os arquivos de overlay); quem tinha o par legado acorda com UM
# dono (o pacman remove o par na mesma transação); quem já tem o único,
# segue na dose normal.
run_root pacman -Syu --needed --overwrite '/usr/local/bin/*' elite-system

# E48→E50 — a sessão do dono recebe o código novo NA HORA e INTEIRA (o
# daemon vivo não segue com a receita velha até relogin — a ferida do
# 'atualizei e persistiu' morre aqui, na dock, no áudio, no idle e no
# daemon de janelas — que agora viaja no pacote único)
refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"

# E46/E51 — o automatismo nasce aqui (idempotente): a cadência AO LIGAR
# + a semanal ficam vivas depois da 1ª 'Atualizar sistema'. A morada das
# units é injetável (ELITE_UNIT_DIR) para prova em sandbox —
# mesma escola do VMARK/ELITE_UPDATE_LOG.
elite_cadencia

if command -v paru >/dev/null 2>&1; then
  echo "==> AUR (paru -Sua)"
  paru -Sua
fi

# kernel DEPOIS: mudou na transação = reboot aplica (aviso, nunca erro)
kafter="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
if [[ -n "$kafter" && "$kafter" != "$kbefore" ]]; then
  echo "==> kernel atualizado (${kbefore:-ausente} → $kafter) — REINICIE para rodá-lo"
fi

# código da casa defasado? (curl com teto de tempo; falha = silêncio)
if [[ -r "$VMARK" ]] && command -v curl >/dev/null 2>&1; then
  inst="$(head -n1 "$VMARK" 2>/dev/null || true)"
  latest="$(curl -fsSL --max-time 10 \
      https://api.github.com/repos/Chrispsz/archcraft-elite/releases/latest 2>/dev/null \
      | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -n1 || true)"
  if [[ -n "$latest" && "$latest" != "$inst" ]]; then
    echo "==> Elite $latest disponível (base desta máquina: ${inst:-desconhecida})"
    echo "    o código da casa viaja SOZINHO agora (canal diário); a ISO nova é o capote mensal:"
    echo "    https://github.com/Chrispsz/archcraft-elite/releases/latest"
  fi
fi
