#!/usr/bin/env bash
# craft-update — atualiza TUDO que a Elite entrega (v5.5 — E64)
# ═══════════════════════════════════════════════════════════════════════════
# v1 (v2.10.5): 'sudo pacman -Syu' + cabeçalho honesto (paru prometido não
#   existe — o bloco fica pronto, mas calado enquanto paru não entra).
# v2 (E32 — diretriz do dono: "deixe tudo atualizável, a distro não pode
#   ficar velha"): o pacman.conf da Elite (E32) agora entrega o [elite-local]
#   (brave-origin, pwvucontrol, craft-toplevel, wlrctl) com Server =
#   releases/latest/download — o MESMO -Syu abaixo atualiza o navegador,
#   que era o único pacote congelado. Este script soma duas verdades que o
#   pacman não vê:
#   · kernel novo na transação → aviso de reboot (comparando -Q antes/depois,
#     sem adivinhar formato de uname — exato por construção);
#   · código da casa (scripts/configs) não é pacote → o marker
#     /usr/local/share/elite/VERSION (escrito no build) compara com a
#     release viva e aponta ISO/cura quando defasa. Offline-safe: falha de
#     rede aqui é silêncio (nunca é erro de atualização).
# v3 (E43 — O CANAL DIÁRIO): o código de casa em /usr/local/bin AGORA É
#   PACOTE (elite-craft + craft-toplevel) e o commit de hoje chega ao rig
#   no -Syu de hoje — sem formatar, sem reinstalar (a demanda do dono).
#   O --overwrite ESCOPADO à casa existe por causa da ADOÇÃO: nos rigs
#   instalados, os arquivos de /usr/local/bin nasceram SEM dono (overlay da
#   ISO) e o pacman recusa sobrescrever não-dono ANTES de qualquer scriptlet
#   (pre_install não alcança) — o --overwrite não-cibe /usr/local/bin/*
#   adota os arquivos na 1ª vez e é inócuo depois (dono = transação normal).
#   O domínio da casa é /usr/local/bin: configs de usuário (~) NUNCA são
#   tocados por update.
# v4 (E46 — O CANAL QUE INSTALA + A CADÊNCIA): o dono: "vejo os erros
#   persistir após atualizar… nosso sistema deve atualizar perfeitamente de
#   forma cirúrgica e com a persistência necessária". A FERIDA CRAVADA: o
#   pacman só ATUALIZA o que JÁ ESTÁ INSTALADO — e o veículo de TODAS as
#   curas (elite-craft, E43) nunca tinha sido INSTALADO nos rigs cuja ISO é
#   anterior (o packages.add só carregava o craft-toplevel): o 'Comprimir…'
#   quebrado da era pré-E42 e o idle sem a normalização E44 sobreviveram a
#   TODOS os craft-update. CURA em três mãos:
#   (1) OS ALVOS EXPLÍCITOS no -Syu (elite-craft craft-toplevel): quem não
#       tem, INSTALA (o pre_install adota os arquivos de overlay); quem tem,
#       atualiza. A porta que o dono já usa ('Atualizar sistema') fecha o
#       déficit na 1ª rodada e habilita o automatismo (timers abaixo).
#   (2) --canal (root, dose DIÁRIA — timer elite-channel.timer, 11:30±40min):
#       a dose cirúrgica — SÓ os pacotes do [elite-local] (pacman -Slq),
#       --needed, offline-safe (repo não respondeu = silêncio, o timer volta
#       amanhã), log honesto + aviso na sessão do usuário.
#   (3) --sistema (root, dose SEMANAL — timer elite-sysupdate.timer,
#       sáb 10:00±2h): o -Syu completo COM REDE DE SEGURANÇA — snapshot PRE
#       do snapper antes, POST depois (quebrou? o GRUB liga o snapshot e o
#       rollback é um reboot), kernel novo = aviso de reboot, pacman ocupado
#       = silêncio (a semana volta). A CADÊNCIA (o dono pediu para pensar):
#       casa = DIÁRIA · sistema = SEMANAL · ISO = MENSAL (1º, tarefa 4) ·
#       manual = este script (sempre). Tudo só na tomada (ConditionACPower).
#   A morada do log é overridável (ELITE_UPDATE_LOG) para prova em sandbox —
#   mesma escola do VMARK/DETECT_ONLY (o teste nunca escreve em /var).
# v4.1 (E48 — A CURA CHEGA À SESSÃO VIVA): o dono atualizou e o problema da
#   suspensão PERSISTIU — o dump nl3z provou o réu: o update entrega
#   ARQUIVOS, mas o swayidle que corre desde o login segue com a RECEITA
#   VELHA até relogin (o rig corria 'timeout 1200 systemctl suspend' CRU,
#   receita anterior à E44 — lock e apagar separados, before-sleep sem o
#   --if-needed). O update perfeito não pede relogin para valer: quando o
#   elite-craft MUDA na transação, o craft-update reinicia o swayidle da
#   sessão (pkill cirúrgico) — o supervisor craft-bars o ressuscita em ~1s
#   com o código novo (craft-idle start = normalização E44 do conf legado
#   + receita nova) e o fluxo de idle/suspensão vale NA HORA, sem relogin.
#   Sem supervisor vivo, o pkill NÃO sai (matar sem volta é dano, não
#   cura) — o papel diz a verdade e o relogin aplica.
# v4.2 (E49 — A CURA NA SESSÃO INTEIRA + A ADOÇÃO DE UMA VIA): duas feridas
#   que o v4.1 deixou abertas:
#   (1) o refresh reiniciava SÓ o swayidle — mas o elite-craft carrega
#       TODOS os daemons vivos da casa (a dock com a transição suave, o
#       roteador de áudio, o idle) e o craft-toplevel carrega o daemon de
#       janelas: o update trocava os ARQUIVOS e cada um seguia velho na
#       sessão até relogin (o dono veria 'a dock continua piscando'). O
#       refresh é agora POR DELTA e POR PACOTE: só morre quem mudou, o
#       toplevel primeiro (a dock nova nasce sobre ele de pé), SEMPRE
#       condicionado ao supervisor craft-bars vivo.
#   (2) o OVO-GALINHA: o rig da era pré-E46 roda um craft-update SEM os
#       alvos explícitos — o -Syu atualiza o instalado e o elite-craft (o
#       veículo onde mora o craft-update novo) NUNCA é adotado. A quebra
#       mora no elite-adopt (hook PostTransaction que viaja no
#       craft-toplevel — o ÚNICO pacote da casa que TODO rig tem): veículo
#       ausente → adoção desprendida (pacman não roda dentro do hook — o
#       lock da transação-mãe ainda vive) → craft-update --adotar fecha a
#       rodada: sessão inteira com o código novo + cadência ligada, UMA
#       atualização, sem relogin.
# v5 (E50 — O SISTEMA EM UM PACOTE SÓ): o dono: "a atualização do sistema
#   como um todo deveria ser em um só pacote — assim fica até mais
#   organizado o repositório e já atualizava todo o sistema com um só
#   pacote". A era dos DOIS veículos (elite-craft + craft-toplevel) se
#   ENCERRA: o elite-system carrega TUDO (scripts + daemon de janelas +
#   units da cadência) e o pacman substitui o par legado na transação
#   (replaces/conflicts). As mãos:
#   (1) O ALVO ÚNICO no -Syu (elite-system): quem não tem, INSTALA (e o
#       pacman remove o par legado na MESMA transação); quem tem,
#       atualiza. UM número para olhar, UM dono para /usr/local/bin.
#   (2) O DELTA DA CASA ÚNICA: o refresh da sessão viva lê o elite-system
#       (os deltas LEGADOS contam para a transição — presente → ausente é
#       a substituição acontecendo); o daemon de janelas agora viaja no
#       pacote único, então mudou a casa = toplevel também reinicia (a
#       ordem importa: toplevel primeiro, a dock nasce sobre ele de pé).
#   (3) A PONTE dos rigs sem pacote algum: o craft-toplevel 1.0-5 (o
#       ÚNICO pacote que TODO rig tem) puxa o elite-system pelo hook e
#       entrega a conclusão ao --adotar (os 'antes' LEGADOS que o hook
#       capturou dão o delta da transição — o pacote único não tinha
#       'antes': a ADOÇÃO já é a mudança).
# v5.1 (E51 — A CADÊNCIA AO LIGAR): o dono: "a ISO deve atualizar o
#   sistema a cada vez que iniciar para poupar o usuário de ficar
#   atualizando manualmente". O timer de relógio (11:30) era uma aposta
#   contra a rotina do dono — máquina desligada na hora = dia sem cura. O
#   boot é o ÚNICO relógio que o dono bate todos os dias: o
#   elite-bootupdate.timer (OnBootSec 3min) assume a dose da casa e o
#   elite-channel APOSENTA (disable --now + unit files fora do caminho —
#   a função elite_cadencia serve as DUAS portas, --adotar e manual,
#   idempotente). A dose semanal (sistema inteiro, com snapshot PRE/POST)
#   segue no sáb 10:00 — a rede de segurança não se corta.
# v5.2 (E54 — A SENTINELA DA BASE): o dono rodou 'craft-update' e colheu o
#   erro cru do pacman: "falha ao sincronizar todas as bases de dados (não
#   foi possível travar a base de dados)". A raiz honesta tem DUAS caras:
#   (1) a CASA CONTRA ELA MESMA — a dose ao ligar (elite-bootupdate,
#       OnBootSec 3min) roda o pacman aos 3min do boot; o dono senta,
#       roda o 'Atualizar sistema' no mesmo minuto e o lock recusa o
#       manual. A dose semanal (--sistema) já sabia esperar (fuser, E46);
#       a porta MANUAL não sabia NADA — com set -e o script morria com o
#       erro cru do pacman, sem explicação e sem saída.
#   (2) o LOCK ÓRFÃO — desligamento no meio de uma transação (a dose ao
#       ligar cortada pelo botão do gabinete) deixa o db.lck para trás;
#       nenhum pacman vivo, o arquivo é lixo — mas o pacman o respeita
#       para sempre e TODO update morde o mesmo erro.
#   A cura: a SENTINELA — a base de dados é um recurso de UM dono por vez.
#   Porta manual: pacman vivo → ESPERA com mensagem (teto ELITE_LOCK_WAIT,
#   120s — nada é tocado à força); lock sem dono → REMOVIDO com a prova
#   no papel (a remoção só acontece com NENHUM pacman vivo, e um pacman
#   que nascer no meio da limpeza aborta a rodada — segurança primeiro);
#   transação recusada = mensagem honesta com o rc, nunca mais o erro cru.
#   Portas automáticas (--canal): pacman ocupado = silêncio e o próximo
#   boot traz a dose (a mesma lei da --sistema, E46). Uma definição só
#   (db_busy) serve as três portas — revisar uma é revisar todas.
# v5.4 (E62 — O PAPEL É DO DONO TAMBÉM): a foto do rig, 05/nov —
#   '/usr/local/bin/craft-update: linha 154: /var/log/elite-update.log:
#   Permissão negada' gritando na cara do dono logo após o 'nada para
#   fazer'. A raiz é de DONO: o log nasce root:root 644 (a dose ao ligar
#   é a primeira a escrever) e a porta MANUAL roda como o dono — o append
#   contra a parede fazia o BASH gritar (erro de redirecionamento é do
#   shell, não morre no '|| true'), e as linhas do manual se perdiam
#   inteiras (o papel que a sentinela aponta como prova nunca recebeu
#   a história do próprio dono). Cura de DUAS mãos no ulog: root mantém
#   o papel aberto (666 — a casa é de um dono; o conteúdo já era legível
#   por todos de qualquer jeito); o dono sem poder de escrita cura o
#   próprio papel pelo sudo que a porta manual ACABOU de autorizar
#   (sudo -n: NUNCA um prompt por causa de log — sudo frio = a linha
#   morre em silêncio honesto, os timers escrevem como root de qualquer
#   jeito). O append em si viaja em subshell calado: mesmo um imprevisto
#   de modo não grita mais (o rc do log nunca foi erro de atualização).
# v5.5 (E64 — A ATUALIZAÇÃO FINA, os 5 curáveis do AUD-B da auditoria
#   geral): a dose do sistema que o dono aplaudiu tinha feridas de TEMPO e
#   de REDE — nenhuma estrutural, todas curáveis:
#   (1) A PROVA DE REDE ANTES DE TUDO (AUD-B2): falha de rede na dose ao
#       ligar virava notify CRITICAL A CADA BOOT (o pacman recusava o -Sy
#       e o aviso soava por doença que era só silêncio da rede). O curl
#       prova o db da casa em 8s: sem rede = adiamento honesto, ZERO
#       transação, ZERO susto — a lei v2 do offline-safe agora atua ANTES
#       do pacman, não depois. A semanal ganha a MESMA prova (e de quebra
#       não desperdiça mais um snapshot PRE numa manhã sem rede).
#   (2) A SENTINELA NAS TRÊS PORTAS (AUD-B3): a base de dados é um
#       recurso de UM dono por vez — a lei E54 agora é da casa inteira.
#       A dose ao ligar brigava com a cura do keyring (aos 120s do boot)
#       e morria calada = dia inteiro sem dose; a semanal brigava igual.
#       As automáticas também ESPERAM com teto agora; estourou o teto =
#       adiamento honesto (o timer re-arma — ver elite-bootupdate.timer
#       E64). O lock órfão é curado nas 3 portas com a MESMA lei.
#   (3) CHECAGEM NÃO É NOTÍCIA: com o re-armamento horário do timer, a
#       dose roda de 1h em 1h; pacman --needed sem candidato novo é o
#       caso COMUM — notify só quando a casa MUDA (delta antes/depois,
#       escola E48; o pop-up 'canal em dia' a cada hora seria ruído).
#   As irmãs do mesmo degrau moram nas units (TimeoutStartSec,
#   ConditionPathExists !/run/archiso, OnUnitInactiveSec — E64 nos
#   comentários delas).
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

KPKG=linux-cachyos-bore
# a morada do lock do pacman — overridável para prova em sandbox
# (mesma escola do VMARK/ELITE_UPDATE_LOG/ELITE_UNIT_DIR)
LCK="${ELITE_PACMAN_LCK:-/var/lib/pacman/db.lck}"
# marker de versão da casa — overridável para prova em sandbox
VMARK="${ELITE_VERSION_MARKER:-/usr/local/share/elite/VERSION}"
# log da automação — overridável para prova em sandbox (mesma escola)
ULOG="${ELITE_UPDATE_LOG:-/var/log/elite-update.log}"
# E64 — a prova de rede ANTES de qualquer transação: o endereço do db da
# casa (o MESMO arquivo que o pacman baixa no -Sy). Overridável para prova
# em sandbox — mesma escola do LCK/VMARK/ULOG/UNIT_DIR.
NETURL="${ELITE_NET_URL:-https://github.com/Chrispsz/archcraft-elite/releases/latest/download/elite-local.db}"

# E64 — a prova custa 8s e vale a dose inteira: -f (404 recusa), -L (o
# releases/latest redireciona para o asset assinado), --head (nada é
# baixado — só o sinal de que a casa está no ar). Sem curl = sem prova =
# adiamento honesto (nunca uma transação às cegas).
rede_viva() {
    command -v curl >/dev/null 2>&1 || return 1
    curl -fsSL --head --max-time "${ELITE_NET_PROBE:-8}" -o /dev/null "$NETURL" 2>/dev/null
}

# ── E92 — AS FAMÍLIAS DA CASA (UMA lista, todos os sites do pacman) ──────
# O --overwrite é escopado à casa (E42): o pacman assume a propriedade dos
# arquivos SEM dono que a Elite entrega (a adoção dos rigs) — nunca de
# coisa alheia (cada padrão é elite-* ou caminho da casa, zero risco a
# pacote de fora). A lista ENFERRUJOU 2×: E46 (bins por nome) e agora
# 08/11 — o sweep da E90/E91 pôs elite-sleep-report no pacote e o escopo
# velho (só /usr/local/bin + units) não cobria: o pacman do rig RECUSOU a
# transação INTEIRA ('existe no sistema de arquivos', relato do dono). A
# cura estrutural: UMA definição aqui (fonte única usada pelos 4 sites —
# canal, semanal e a porta manual) + a suíte CONTRATA a sincronia
# lista↔payload (40-integration: cada família que o elite-system entrega
# tem de estar coberta — o esquecimento seguinte morre na porteira, não
# no rig do dono).
HOUSE_OVERWRITE=(
    '--overwrite' '/usr/local/bin/*'
    '--overwrite' '/etc/systemd/system/elite-*'
    '--overwrite' '/usr/lib/systemd/system-sleep/*'
    '--overwrite' '/usr/local/share/elite/*'
    '--overwrite' '/usr/local/share/applications/*'
    '--overwrite' '/usr/share/libalpm/hooks/elite-*'
)

# E94 — A ADOÇÃO DE ÂNCORAS. packages.add só nutre a ISO: o rig JÁ-INSTALADO
# nunca recebe um pacote novo da casa se ele não for dependência de nada —
# o -Syu atualiza o que existe, não instala o que falta. Primeiro réu: o
# gparted 'não vem funcionando por padrão' (relato do dono 09/11) — a
# cabeça da fila do craft-bars (E58) é o lxqt-policykit e nos rigs
# anteriores à ISO da E58 ele NUNCA chegou: a fila caía no hyprpolkitagent
# hyprtoolkit (skip pelo probe) ou no polkit-gnome zumbi — o réu do dump
# tg0b1 que morria COM a senha viva. Disciplina: âncora entra COM
# procedência (disponibilidade no repo Arch verificada na entrada, a
# escola do pin: checksum ou nada) e PRESENTE no packages.add (a MESMA
# definição na ISO e no rig — a suíte contrata o sync).
ADOCAO=(lxqt-policykit)

ulog() {
    mkdir -p "$(dirname "$ULOG")" 2>/dev/null || true
    # teto 256 KiB (lei E36 — a mesma política de toda a família de logs)
    if [ -f "$ULOG" ] && [ "$(wc -c <"$ULOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$ULOG" > "$ULOG.tmp" 2>/dev/null && mv -f "$ULOG.tmp" "$ULOG" || true
    fi
    # E62 — O PAPEL É DO DONO TAMBÉM: o log nasce root:root 644 (a dose ao
    # ligar é a primeira a escrever) e a porta MANUAL do dono escrevia contra
    # a parede — o bash gritava 'linha 154: /var/log/elite-update.log:
    # Permissão negada' (a foto do rig, 05/nov). Duas mãos: root mantém o
    # papel aberto (666 — a casa é de um dono; o conteúdo já era legível por
    # todos de qualquer jeito); o dono sem poder de escrita cura o próprio
    # papel pelo sudo que a porta manual ACABOU de autorizar (sudo -n: NUNCA
    # um prompt por causa de log — sudo frio = a linha morre em silêncio
    # honesto, os timers escrevem como root de qualquer jeito). E o append
    # em si viaja em subshell calado: mesmo um imprevisto de modo não grita
    # mais (o rc do log nunca foi erro de atualização).
    if [ "$(id -u)" = 0 ]; then
        chmod 666 "$ULOG" 2>/dev/null || true
    else
        if [ ! -w "$ULOG" ] && [ ! -w "$(dirname "$ULOG")" ]; then
            sudo -n true 2>/dev/null || return 0
            run_root touch "$ULOG" 2>/dev/null || true
            run_root chmod 666 "$ULOG" 2>/dev/null || true
            [ -w "$ULOG" ] || return 0
        fi
    fi
    ( printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$ULOG" ) 2>/dev/null || true
}

# root executa direto; humano com sessão usa o sudo (o interativo é a porta
# do dono; os timers nascem root — mesmo binário, dois mundos)
run_root() {
    if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# E93 — A CLASSE ÓRFÃ GANHA A PALAVRA DA CASA. '…existe no sistema de
# arquivos' é a ferida era-ISO: o arquivo nasceu no sistema ANTES de o
# pacote da casa o carregar (airootfs/deploy direto não tem dono no
# pacman) e a checagem de conflito corre ANTES de qualquer scriptlet —
# nenhuma cura viaja no pacote, o pre_install NUNCA alcança. A prova do
# dono (08/11): o 1.0-36 recusado na máquina com o elite-sleep-report —
# e a cura E92 (HOUSE_OVERWRITE) viajava DENTRO do pacote recusado
# (bootstrap da cura: a chave foi o bak- À MÃO, uma vez, na primeira dose
# que carrega o overwrite). A sentinela ENSINA com o caminho EXATO que o
# pacman nomeou (lido do papel cru) e NUNCA move nada sem o dono: a lei
# é bak- (nunca destruição) PARA FORA do dir de sono — systemd executa
# TUDO executável em system-sleep, até um .bak renomeado no lugar.
ensina_orfao() {
    local src="${1:-$ULOG}"
    grep -q 'existe no sistema de arquivos' "$src" 2>/dev/null || return 0
    local p base l
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        base="$(basename "$p")"
        local -a msgs=(
            "CLASSE CONHECIDA — ARQUIVO ÓRFÃO: '$p' existe no sistema de arquivos (sem dono, era ISO/deploy direto)."
            "  o pre_install do pacote NUNCA alcança: a checagem de conflito corre ANTES de qualquer scriptlet."
            "  a lei da casa é bak- (nunca destruição), PARA FORA do dir de sono (systemd executa tudo executável lá):"
            "    1) pacman -Qo '$p'   # deve responder 'Nenhum pacote possui' — se nomear outro pacote, NÃO mova"
            "    2) sudo install -d /var/backups/elite && sudo mv '$p' '/var/backups/elite/${base}.bak-\$(date +%Y%m%d-%H%M%S)'"
            "    3) rode craft-update de novo — a transação passa e o pacote entrega o arquivo com dono."
        )
        for l in "${msgs[@]}"; do
            ulog "$l"
            printf '%s\n' "$l" >&2
        done
    done < <(sed -n -E 's/^[^:]+: (.+) existe no sistema de arquivos$/\1/p' "$src" | sort -u)
}

# E94 — A ADOÇÃO EXECUTADA. Transação SEPARADA e best-effort DEPOIS da
# dose vencida: âncora que não resolve NUNCA bloqueia a principal (a
# lição E93 no lado da discrição — recusa da adoção não é notícia do
# tamanho de uma dose perdida). -Q com guarda na FONTE (a lei do -Qu —
# condição é lugar seguro sob pipefail) e checagem que NÃO é notícia
# (a escola E64: presente = silêncio, sem transação nenhuma). -S sem
# -Sy: a dose acabou de sincronizar o db — zero custo de rede a mais.
adota_ancoras() {
    local a
    for a in "${ADOCAO[@]}"; do
        if run_root pacman -Q "$a" >/dev/null 2>&1; then
            continue
        fi
        if run_root pacman -S --needed --noconfirm "$a" >>"$ULOG" 2>&1; then
            ulog "adoção: $a presente (âncora da casa — o rig convergiu)"
        else
            ulog "adoção: $a não resolveu agora — a dose principal segue de pé (best-effort, nunca bloqueia)"
        fi
    done
    return 0
}

# E88 — A ATUALIZAÇÃO ÁGIL: downloads paralelos no pacman.conf. O default
# do pacote vem COMENTADO ('#ParallelDownloads = 5') — UM pacote por vez:
# o -Syu que 'parecia travado' no pacote grande era ISTO. Idempotente e
# best-effort (conf ausente/ilegível = silêncio honesto — o réu é o conf
# da base, nunca o update); a ISO já nasce com a linha (E3 do customize);
# este gesto alcança os RIGS instalados pelo canal.
pacman_agil() {
    local PC=/etc/pacman.conf
    [ -r "$PC" ] || return 0
    if ! run_root grep -q '^ParallelDownloads' "$PC" 2>/dev/null; then
        if run_root sed -i '/^\[options\]$/a ParallelDownloads = 5' "$PC" 2>/dev/null; then
            ulog "E88: pacman.conf ganhou ParallelDownloads = 5 (downloads paralelos — o -Syu ágil)"
        fi
    fi
}

# E54 — A BASE É DE UM DONO POR VEZ. O fuser diz quem segura o arquivo
# AGORA (mais forte que pgrep: pega o pacman embaixo de paru/yay/timer);
# sem fuser no rig, o pgrep -x pacman assume (casamento exato do binário).
db_busy() {
    if command -v fuser >/dev/null 2>&1; then
        fuser "$LCK" >/dev/null 2>&1
    else
        pgrep -x pacman >/dev/null 2>&1
    fi
}

# E54→E64 — A SENTINELA DA BASE, agora nas TRÊS PORTAS. A base de dados é
# um recurso de UM dono por vez: a manual (interativa) espera com teto e
# erra honesto — e as AUTOMÁTICAS (canal/sistema, modo "auto") também
# esperam agora: a dose ao ligar brigava com a cura do keyring (aos 120s
# do boot) e morria calada = o DIA INTEIRO sem dose; a semanal brigava
# igual. Na automática, estourou o teto não é erro: é ADIAMENTO honesto
# (a função devolve 1, a porta sai em silêncio rc 0 e o timer re-arma —
# a lei E54 do adiamento não morre, ganha braço de espera). O lock órfão
# é curado nas 3 portas com a MESMA lei: remoção SÓ com nenhum pacman
# vivo, e um pacman que nascer durante a limpeza aborta (dois pacmans
# numa base = corrupção — a sentinela não quebra a lei para curá-la).
# A porta é nomeada no papel (o log da casa começa pelo nome da porta).
sentinela_db() {
    local modo="${1:-manual}" porta="${2:-manual}" espera=0 limite="${ELITE_LOCK_WAIT:-120}"
    if db_busy; then
        if [ "$modo" = "auto" ]; then
            ulog "$porta: pacman ocupado (lock vivo) — a sentinela espera (teto ${limite}s)"
        else
            echo "==> outra operação de pacotes está em execução — aguardando a base liberar (teto ${limite}s)…"
            echo "    (costuma ser a dose ao ligar — elite-bootupdate, 3min após o boot — terminando)"
        fi
        while db_busy; do
            sleep 2
            espera=$((espera + 2))
            if [ "$espera" -ge "$limite" ]; then
                if [ "$modo" = "auto" ]; then
                    ulog "$porta: base ocupada há ${espera}s — adiamento honesto (o timer traz a dose de volta)"
                    return 1
                fi
                echo "ERRO: a base de dados segue ocupada há ${espera}s — NADA foi tocado." >&2
                echo "      Tente de novo em instantes; a prova da outra transação mora em $ULOG." >&2
                exit 1
            fi
        done
        if [ "$modo" = "auto" ]; then
            ulog "$porta: base liberada (${espera}s de espera) — a dose segue"
        else
            echo "==> base liberada (${espera}s de espera) — seguindo"
            ulog "manual: base ocupada por ${espera}s (outra transação viva) — liberou, seguindo"
        fi
    fi
    if [ -f "$LCK" ] && ! db_busy; then
        if [ "$modo" = "auto" ]; then
            ulog "$porta: lock órfão em $LCK (nenhuma transação viva) — curando antes da dose"
        else
            echo "==> lock órfão em $LCK (nenhuma transação viva — sobra de desligamento no meio de uma atualização)"
        fi
        run_root rm -f "$LCK"
        sleep 0.3
        if db_busy; then
            if [ "$modo" = "auto" ]; then
                ulog "$porta: transação nasceu durante a limpeza do lock — adiamento honesto (um dono por vez)"
                return 1
            fi
            echo "ERRO: uma transação nasceu durante a limpeza do lock — abortando (um dono por vez)." >&2
            exit 1
        fi
        if [ "$modo" = "auto" ]; then
            ulog "$porta: lock órfão removido — a base está livre"
        else
            ulog "manual: lock órfão de $LCK removido (nenhuma transação viva — sobra de crash/desligamento)"
            echo "==> lock órfão removido — a base está livre"
        fi
    fi
    return 0
}

# o aviso para a SESSÃO do dono: root não tem bus — vai pelo bus de cada
# usuário logado (/run/user/N/bus; sem bus = sem sessão gráfica, silêncio)
notify_users() {
    local uid
    while read -r uid _; do
        [ -n "$uid" ] || continue
        [ -S "/run/user/$uid/bus" ] || continue
        if [ "$(id -u)" = 0 ]; then
            runuser -u "#$uid" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                notify-send -a 'Elite' "$@" 2>/dev/null || true
        else
            sudo -u "#$uid" env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                notify-send -a 'Elite' "$@" 2>/dev/null || true
        fi
    done < <(loginctl list-users --no-legend 2>/dev/null || true)
}

# o delta da casa ÚNICA: a versão do elite-system (vazio = ausente — a
# ADOÇÃO e a SUBSTITUIÇÃO também são delta: '?' → '1.0-1' mudou a casa)
es_q() {
    pacman -Q elite-system 2>/dev/null | awk '{print $2}' || true
}

# LEGADO (a transição E50): os DOIS veículos da era antiga. Mudarem AQUI
# (presente → ausente) é a prova da substituição pelo pacote único; o
# papel registra a história completa (rig nenhum fica sem narrativa)
elite_craft_q() {
    pacman -Q elite-craft 2>/dev/null | awk '{print $2}' || true
}

craft_tl_q() {
    pacman -Q craft-toplevel 2>/dev/null | awk '{print $2}' || true
}

# E48→E49→E50 — A CURA NA SESSÃO VIVA, agora com UM dono: o update troca
# ARQUIVOS, mas o daemon vivo corre a receita ANTERIOR até relogin. O
# pkill é cirúrgico DUAS VEZES: por DELTA (só morre quem mudou de pacote)
# e por SUPERVISOR (só morre quem tem craft-bars vivo para ressuscitar em
# ~1s com o código novo). A ORDEM importa: o toplevel primeiro — a dock
# nova nasce sobre o daemon de janelas já de pé (ELITE_TL_SETTLE é a
# porta de prova da espera, mesma escola do VMARK/ELITE_UNIT_DIR). No E50
# o daemon de janelas viaja DENTRO do pacote único: mudou a casa → o
# toplevel também reinicia (os deltas LEGADOS preservam os rigs de
# transição).
refresh_session() {
    local casa_mudou="$1" tl_mudou="$2" uid
    [ "$casa_mudou" = 1 ] || [ "$tl_mudou" = 1 ] || return 0
    while read -r uid _; do
        [ -n "$uid" ] || continue
        if ! pgrep -u "$uid" -x craft-bars >/dev/null 2>&1; then
            ulog "sessão: supervisor craft-bars AUSENTE (uid $uid) — a sessão segue com o código antigo até relogin (pkill sem volta seria dano, não cura)"
            continue
        fi
        if { [ "$tl_mudou" = 1 ] || [ "$casa_mudou" = 1 ]; } && pgrep -u "$uid" -x craft-toplevel >/dev/null 2>&1; then
            pkill -u "$uid" -x craft-toplevel 2>/dev/null || true
            ulog "sessão: craft-toplevel (uid $uid) reiniciado — o supervisor ressuscita com o daemon de janelas novo"
            sleep "${ELITE_TL_SETTLE:-2}"
        fi
        if [ "$casa_mudou" = 1 ]; then
            if pgrep -u "$uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' >/dev/null 2>&1; then
                pkill -u "$uid" -f '^/usr/bin/python3 /usr/local/bin/craft-dock-gui$' 2>/dev/null || true
                ulog "sessão: dock craft-dock-gui (uid $uid) reiniciada — a transição suave dos dinâmicos vale SEM relogin"
            fi
            if pgrep -u "$uid" -x craft-audio-route >/dev/null 2>&1; then
                pkill -u "$uid" -x craft-audio-route 2>/dev/null || true
                ulog "sessão: craft-audio-route (uid $uid) reiniciado — o roteamento de áudio segue com o código novo"
            fi
            if pgrep -u "$uid" -x swayidle >/dev/null 2>&1; then
                pkill -u "$uid" -x swayidle 2>/dev/null || true
                ulog "sessão: swayidle (uid $uid) reiniciado — o supervisor craft-bars ressuscita com a receita nova (idle/suspensão valem SEM relogin)"
            fi
        fi
    done < <(loginctl list-users --no-legend 2>/dev/null || true)
}

# E51 — A CADÊNCIA AO LIGAR (a função única das duas portas — --adotar e
# manual): a casa atualiza A CADA BOOT (o dono: "a ISO deve atualizar o
# sistema a cada vez que iniciar para poupar o usuário de ficar
# atualizando manualmente"). O timer de relógio (11:30) era uma aposta
# contra a rotina: máquina desligada na hora = dia sem cura. O boot é o
# relógio que o dono BATE todos os dias (elite-bootupdate.timer,
# OnBootSec 3min) + a dose SEMANAL do sistema (sáb 10:00) segue como rede
# completa. O elite-channel APOSENTA aqui: disable --now + as unit files
# fora do caminho (rigs com overlay sem dono não ficam com cadência
# fantasma; os que tinham as units por PACOTE já as perderam no replaces
# do elite-system 1.0-2 — o rm é para os órfãos de overlay).
elite_cadencia() {
    UNITDIR="${ELITE_UNIT_DIR:-/etc/systemd/system}"
    if run_root systemctl disable --now elite-channel.timer >/dev/null 2>&1; then
        ulog "cadência: elite-channel.timer aposentado — a casa atualiza AO LIGAR (E51)"
    fi
    rm -f "$UNITDIR/elite-channel.timer" "$UNITDIR/elite-channel.service" 2>/dev/null || true
    if [ -f "$UNITDIR/elite-bootupdate.timer" ] && [ -f "$UNITDIR/elite-sysupdate.timer" ]; then
        if run_root systemctl enable --now elite-bootupdate.timer elite-sysupdate.timer >/dev/null 2>&1; then
            ulog "cadência: AO LIGAR (bootupdate, 3min pós-boot) · sistema SEMANAL sáb 10:00"
            echo "==> automatismo da casa ativo: casa AO LIGAR (3min pós-boot) · sistema SEMANAL sáb 10:00"
        fi
    fi
}

# o delta que IMPORTA para a sessão: versão antes ≠ depois (ou adoção, ou
# SUBSTITUIÇÃO de era), POR PACOTE — elite-system mudou (ou o legado
# mudou/apagou) → dock/áudio/idle/toplevel; o papel narra a história
# completa da transição (o rig da era velha fica com a prova da troca)
refresh_if_craft_changed() {
    local es_antes="$1" ec_antes="$2" tl_antes="$3" es_depois ec_depois tl_depois casa_m=0 tl_m=0
    es_depois="$(es_q)"
    ec_depois="$(elite_craft_q)"
    tl_depois="$(craft_tl_q)"
    [[ "$es_depois" != "$es_antes" ]] && casa_m=1
    [[ "$ec_depois" != "$ec_antes" ]] && casa_m=1
    [[ "$tl_depois" != "$tl_antes" ]] && tl_m=1
    if [ "$casa_m" = 1 ] || [ "$tl_m" = 1 ]; then
        ulog "casa: elite-system ${es_antes:-ausente} → ${es_depois:-ausente} · elite-craft ${ec_antes:-ausente} → ${ec_depois:-ausente} · craft-toplevel ${tl_antes:-ausente} → ${tl_depois:-ausente} — a sessão recebe o código novo"
        refresh_session "$casa_m" "$tl_m"
        notify_users 'Elite: código da casa atualizado' \
            'Idle/suspensão, dock e áudio da sessão já valem o novo — sem relogin.'
    fi
}

# ── E90 — A PORTA DE DESCOBERTA E O VEREDITO SEM TRANSAÇÃO ──────────────
# A auditoria E66 nomeou as duas lacunas: "--help não existe" (o script é
# de linha reta) e "checagem não é porta" (nada responde 'tem atualização
# pendente?' SEM tocar a base). O --check é READ-ONLY DE VERDADE: zero
# pacman -Sy, zero root, zero transação — lê o INSTALADO, a base LOCAL
# (com a idade dela no papel — base velha = julgamento honesto do que o
# pacman JÁ conhece), a cadência e (se houver rede) a tag viva da casa.
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "uso" ]]; then
    cat <<'EOUSO'
uso: craft-update [--check | --canal | --sistema | --adotar] — atualiza TUDO
     que a Elite entrega (pacote único elite-system + repositórios)

  (sem args)   a porta MANUAL: sudo pacman -Syu com alvo elite-system,
               sentinela da base (espera lock vivo, cura lock órfão),
               refresh da sessão viva SEM relogin e aviso de kernel novo
  --check      o VEREDITO SEM TOCAR NADA: versões instaladas, pendências
               da base LOCAL (com a idade dela), cadência e a tag viva
               (se houver rede). Read-only, sem root — a pergunta
               barata de 'tem atualização?' (E90)
  --canal      dose da casa AO LIGAR (elite-bootupdate.timer, OnBootSec
               3min — a cadência que o (sem args) liga)
  --sistema    dose SEMANAL com snapshot PRE/POST (sáb 10:00±2h)
  --adotar     a conclusão da PONTE (elite-adopt do craft-toplevel velho)

  a dose pede sudo; o --check roda como dono mesmo. O papel da
  automação: /var/log/elite-update.log
EOUSO
    exit 0
fi

if [[ "${1:-}" == "--check" ]]; then
    printf '══════════ craft-update --check — veredito SEM tocar nada ══════════\n'
    printf '(read-only: zero -Sy, zero root, zero transação — a base local\n'
    printf ' permanece a que o último sincronismo trouxe)\n\n'
    # ── a era instalada (o que o pacman TEM) ──
    printf '── instalado\n'
    if command -v pacman >/dev/null 2>&1; then
        for p in elite-system elite-craft craft-toplevel linux-cachyos-bore; do
            # || true na FONTE (mesma lei do -Qu abaixo): pacman -Q de pacote
            # ausente devolve rc=1 e o pipefail NÃO pode matar a pergunta
            # barata — a classe que o CI flagrou (container Arch real,
            # elite ausente = rc 1 no meio do veredito). Ausente é papel, é
            # '(ausente)', não morte.
            v="$( { pacman -Q "$p" 2>/dev/null || true; } | awk '{print $2}')"
            printf '  %-20s %s\n' "$p" "${v:-(ausente)}"
        done
    else
        printf '  (pacman ausente — ambiente de prova?)\n'
    fi
    if [[ -r "$VMARK" ]]; then
        printf '  base da ISO          %s (/usr/local/share/elite/VERSION)\n' "$(head -n1 "$VMARK" 2>/dev/null || echo '?')"
    fi
    # ── a cadência (a automação de pé?) ──
    printf '\n── cadência\n'
    for t in elite-bootupdate.timer elite-sysupdate.timer; do
        st="$(systemctl is-enabled "$t" 2>/dev/null)" || st='desligada'
        printf '  %-22s %s\n' "$t" "$st"
    done
    # ── a última dose no papel ──
    printf '\n── última dose (o papel da automação)\n'
    if [[ -r "$ULOG" ]]; then
        { grep -E 'canal: |manual: |sistema: ' "$ULOG" 2>/dev/null || true; } | tail -3 | sed 's/^/  /'
    else
        printf '  (sem %s ainda — nenhuma dose rodou nesta máquina?)\n' "$ULOG"
    fi
    # ── as pendências que a base LOCAL já conhece (com a idade da base) ──
    # (pipefail: o pacman -Qu devolve rc=1 quando NADA está pendente — a
    # negação honesta não pode matar o veredito; o || true na FONTE)
    printf '\n── pendências conhecidas da base LOCAL\n'
    if command -v pacman >/dev/null 2>&1; then
        npend="$( { pacman -Qu 2>/dev/null || true; } | wc -l )"
        oldest=""
        for db in /var/lib/pacman/sync/*.db; do
            [[ -e "$db" ]] || continue
            d="$(date -r "$db" '+%d/%m %H:%M' 2>/dev/null)" || continue
            [[ -z "$oldest" || "$db" -ot "$oldest_db" ]] && oldest="$d" && oldest_db="$db"
        done
        if (( npend > 0 )); then
            printf '  %d pacote(s) com upgrade pronto — base sincronizada %s\n' "$npend" "${oldest:-?}"
            { pacman -Qu 2>/dev/null || true; } | head -8 | sed 's/^/    /'
            (( npend > 8 )) && printf '    … e mais %d\n' $((npend - 8))
        else
            printf '  nada pendente — base sincronizada %s\n' "${oldest:-?}"
        fi
    fi
    # ── a rede: a tag viva da casa (a prova de 8s — nunca às cegas) ──
    printf '\n── o canal (a tag viva, se a rede responder)\n'
    if rede_viva; then
        latest="$(curl -fsSL --max-time 10 \
            https://api.github.com/repos/Chrispsz/archcraft-elite/releases/latest 2>/dev/null \
            | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -n1 || true)"
        inst_tag="$(head -n1 "$VMARK" 2>/dev/null || true)"
        if [[ -n "$latest" ]]; then
            if [[ -n "$inst_tag" && "$latest" != "$inst_tag" ]]; then
                printf '  ISO %s disponível (base desta máquina: %s)\n' "$latest" "$inst_tag"
                printf '  o código da casa viaja SOZINHO pelo canal; a ISO nova é o capote mensal\n'
            else
                printf '  canal no ar — a base desta máquina é a última (%s)\n' "${latest:-?}"
            fi
        else
            printf '  (a API não respondeu a tempo — o canal está no ar, a tag não veio)\n'
        fi
    else
        printf '  SEM REDE (a prova de 8s falhou) — o julgamento do canal fica\n'
        printf '  para a próxima dose; a base local acima segue valendo\n'
    fi
    printf '\n══════════ fim do veredito (nada foi tocado) ══════════\n'
    exit 0
fi

# ── a porta da ADOÇÃO (E49/E50 — o elite-adopt entrega aqui): o rig velho
# foi puxado pelo hook do craft-toplevel (a PONTE para o pacote único); o
# craft-update NOVO conclui a rodada: refresh da sessão viva (o pacote
# único não tinha 'antes' — a ADOÇÃO já é a mudança; os 'antes' LEGADOS
# do hook narram a substituição) + cadência ligada. UMA atualização, sem
# relogin.
if [[ "${1:-}" == "--adotar" ]]; then
    # assinatura v5: --adotar ES_ANTES EC_ANTES TL_ANTES — a ponte (o hook)
    # não tem 'antes' do pacote único e passa VAZIO na frente (a ADOÇÃO já
    # é a mudança); quem chama com o delta completo o narra inteiro
    # (o verbo consome $1 — os deltas moram em $2/$3/$4; a lição do rc
    # capturado fora da negação: a posição certa ANTES de usar)
    refresh_if_craft_changed "${2:-}" "${3:-}" "${4:-}"
    elite_cadencia
    exit 0
fi

# ── dose da casa AO LIGAR (elite-bootupdate.timer — OnBootSec 3min, E51) ─
if [[ "${1:-}" == "--canal" ]]; then
    pacman_agil
    ulog "canal: iniciando (dose da casa — ao ligar, E51)"
    # E64 — A PROVA DE REDE ANTES DE TUDO (AUD-B2): a falha de rede na
    # dose ao ligar virava notify CRITICAL A CADA BOOT (o pacman recusava
    # o -Sy e o aviso soava por doença que era só silêncio da rede). Prova
    # de 8s no db da casa: sem rede = silêncio honesto, ZERO transação,
    # ZERO susto — e nem briga pelo lock (a cura do keyring segue em paz).
    if ! rede_viva; then
        ulog "canal: sem rede — silêncio honesto, o próximo ciclo traz a dose"
        exit 0
    fi
    # E64 — A SENTINELA NA PORTA AUTOMÁTICA (AUD-B3): a dose ao ligar
    # brigava com a cura do keyring (aos 120s do boot) e morria calada —
    # o DIA inteiro sem dose. Agora ESPERA com teto (a cortesia da manual,
    # E54); estourou o teto = adiamento honesto (rc 1 → silêncio rc 0 e o
    # timer re-arma em 1h — elite-bootupdate.timer, E64).
    if ! sentinela_db auto canal; then
        exit 0
    fi
    # E54 — pacman ocupado? (o dono transacionando, a semanal, o keyring) —
    # a espera com teto virou lei das TRÊS portas (E64: a sentinela acima).
    es_before="$(es_q)"
    ec_before="$(elite_craft_q)"
    tl_before="$(craft_tl_q)"
    CANAL_PKGS=()
    # E50 — a era do PACOTE ÚNICO: o par legado NÃO entra na dose. O
    # elite-craft é FÓSSIL do db (o replaces o removeu do rig) e o
    # craft-toplevel é a PONTE congelada (o daemon vive no pacote único) —
    # puxar qualquer um num rig da era nova seria BRIGA DE DONO pelo
    # binário do daemon e o pacman RECUSARIA a dose inteira.
    ERA_UNICA=""
    [ -n "$(es_q)" ] && ERA_UNICA=1
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        # E56 — o par legado fica FORA da dose SEMPRE (antes, só na era
        # única): com craft-toplevel vivo NA LISTA junto do elite-system, o
        # pacman recusa a dose inteira (conflito alvo-contra-alvo — a prova
        # crua do rig, 05/nov). O replaces do elite-system faz a troca de
        # era na própria dose — a adoção não briga com ninguém.
        if [ "$p" = "elite-craft" ] || [ "$p" = "craft-toplevel" ]; then
            continue
        fi
        CANAL_PKGS+=("$p")
    done < <(pacman -Slq elite-local 2>/dev/null || true)
    if [ "${#CANAL_PKGS[@]}" -eq 0 ]; then
        # E64: com a prova de rede ANTES daqui, "lista vazia" deixou de ser
        # sinônimo de offline — a rede respondeu e o db local não entregou
        # peça (stale/corrupto/nunca sincronizado). Silêncio honesto igual.
        ulog "canal: [elite-local] não entregou lista (a rede respondeu, o db não) — silêncio, o timer volta"
        exit 0
    fi
    if [ -n "$ERA_UNICA" ]; then
        ulog "canal: era do pacote único — o par legado (fóssil/ponte) fica fora da dose"
    else
        ulog "canal: ADOÇÃO nesta dose — o replaces do elite-system troca o par legado (alvo-contra-alvo nunca entra na lista)"
    fi
    if ! run_root pacman -Sy --needed --noconfirm \
            "${HOUSE_OVERWRITE[@]}" \
            "${CANAL_PKGS[@]}" >>"$ULOG" 2>&1; then
        ulog "canal: pacman RECUSOU a dose — a prova está acima no log"
        # E93 — o papel é a única boca do timer: a classe órfã (se for
        # ela a ré) ensina no log, com o caminho exato que o pacman nomeou
        ensina_orfao
        notify_users -u critical 'Canal da Elite falhou' \
            'A dose diária da casa foi recusada — log: /var/log/elite-update.log'
        exit 1
    fi
    ulog "canal: OK — a transação passou (${#CANAL_PKGS[@]} peças da casa)"
    adota_ancoras
    refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"
    # E64 — CHECAGEM NÃO É NOTÍCIA: com o re-armamento horário do timer
    # (OnUnitInactiveSec), a dose roda de 1h em 1h e o pacman --needed sem
    # candidato novo é o caso COMUM — notify só quando a casa MUDA (o
    # refresh_if_craft_changed acima já notifica por delta, escola E48);
    # sem novidade = a linha no papel e SILENCIO para o dono.
    if [[ "$(es_q)" == "$es_before" && "$(elite_craft_q)" == "$ec_before" && "$(craft_tl_q)" == "$tl_before" ]]; then
        ulog "canal: a casa já estava em dia — silêncio para o dono (checagem não é notícia)"
    fi
    # E51.1 — a dose AUTO-CURA a cadência: rigs adotados por caminhos que
    # não passam pela elite_cadencia (a dose v4.2 de hoje) recebem a troca
    # do timer na PRÓPRIA dose (idempotente — disable falho é silêncio)
    elite_cadencia
    exit 0
fi

# ── dose SEMANAL: o sistema inteiro, com rede de segurança (elite-sysupdate.timer)
if [[ "${1:-}" == "--sistema" ]]; then
    ulog "sistema: iniciando (dose semanal completa)"
    # E64 — A PROVA DE REDE ANTES DO PRE (AUD-B2 na irmã semanal): sem
    # rede, o -Syu morreria DEPOIS de gastar um snapshot PRE à toa (e o
    # notify CRITICAL soaria por doença que era silêncio). Prova de 8s:
    # sem rede = adiamento honesto, NENHUM snapshot gasto, a semana volta.
    if ! rede_viva; then
        ulog "sistema: sem rede — adiamento honesto (a semana volta; nenhum snapshot PRE desperdiçado)"
        exit 0
    fi
    # E64 — A SENTINELA NA SEMANAL (AUD-B3): a mesma espera com teto das
    # portas irmãs — brigava com o keyring aos 120s do boot e com a dose
    # ao ligar; agora espera e segue, ou adia honesta (o timer volta).
    if ! sentinela_db auto sistema; then
        exit 0
    fi
    # pacman ocupado? — lei das TRÊS portas (a sentinela acima, E64)
    PRE_N=""
    if command -v snapper >/dev/null 2>&1 && snapper -c root list-configs >/dev/null 2>&1; then
        PRE_N="$(snapper -c root create -t pre -p -d 'elite-sysupdate' 2>/dev/null || true)"
        if [ -n "$PRE_N" ]; then
            ulog "sistema: snapshot PRE #$PRE_N — a rede de segurança está armada"
        else
            ulog "sistema: snapper recusou o PRE — seguindo SEM rede (a prova fica no log)"
        fi
    else
        ulog "sistema: snapper indisponível — seguindo SEM rede de segurança (honesto)"
    fi
    kbefore="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
    es_before="$(es_q)"
    ec_before="$(elite_craft_q)"
    tl_before="$(craft_tl_q)"
    # o rc REAL se captura fora da negação (dentro do `if !`, o $? é o
    # status NEGADO — o log imprimiria rc=1 em qualquer falha)
    sys_rc=0
    run_root pacman -Syu --needed --noconfirm \
        "${HOUSE_OVERWRITE[@]}" >>"$ULOG" 2>&1 || sys_rc=$?
    if [ "$sys_rc" -ne 0 ]; then
        ulog "sistema: pacman FALHOU (rc=$sys_rc) — snapshot PRE #$PRE_N guarda o estado anterior"
        # E93 — a recusa órfã ensina no papel (a semanal também é boca do log)
        ensina_orfao
        notify_users -u critical 'Atualização semanal falhou' \
            "rc=$sys_rc — log: /var/log/elite-update.log${PRE_N:+ · rollback: snapshot #$PRE_N no GRUB}"
        exit 1
    fi
    adota_ancoras
    refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"
    if [ -n "$PRE_N" ] && snapper -c root create -t post --pre-number "$PRE_N" \
            -d 'elite-sysupdate' >/dev/null 2>&1; then
        ulog "sistema: snapshot POST #$PRE_N criado (o par PRE/POST fecha a história)"
    fi
    kafter="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
    if [ -n "$kafter" ] && [ "$kafter" != "$kbefore" ]; then
        ulog "sistema: kernel ${kbefore:-ausente} → $kafter — REBOOT aplica"
        notify_users 'Elite: sistema atualizado' \
            "Kernel novo ($kafter) — REINICIE para rodá-lo.${PRE_N:+ Snapshots: #$PRE_N}"
    else
        ulog "sistema: OK (kernel intocado)"
        notify_users 'Elite: sistema atualizado' 'Atualização semanal concluída.'
    fi
    exit 0
fi

# ── a porta MANUAL (o menu 'Atualizar sistema'): o -Syu completo ────────
pacman_agil
# kernel ANTES da transação (o -Syu pode tocá-lo; vazio = pacote ausente)
kbefore="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
# E48 — a casa ANTES (a adoção e o upgrade contam como delta da casa)
# E50 — o ALVO ÚNICO: o elite-system é a casa inteira; o pacman substitui
# o par legado (elite-craft + craft-toplevel) na MESMA transação
# (replaces/conflicts) — os deltas LEGADOS capturados aqui narram a
# substituição (presente → ausente) no papel
es_before="$(es_q)"
ec_before="$(elite_craft_q)"
tl_before="$(craft_tl_q)"

# E46/E50→E56 — O ALVO É CONDICIONAL (a prova crua do rig, 05/nov): nomear
# elite-system junto do -Syu num rig onde o craft-toplevel tem candidato
# de upgrade é conflito NÃO solucionável ('elite-system-1.0-6 e
# craft-toplevel-1.0-5 estão em conflito' — o pacman não substitui o
# pacote que a MESMA transação atualiza). O MESMO rig provou o caminho
# limpo: SEM alvo explícito, o replaces do elite-system resolve a adoção
# ('Substituir craft-toplevel por elite-local/elite-system?'). A lei:
#   · craft-toplevel vivo + elite-system ausente → SEM alvo: o replaces
#     adota (o par sai, o único entra, na MESMA transação);
#   · nos outros estados → alvo explícito (quem já tem o único segue na
#     dose normal; estado sem o par instala o único sem briga).
# E56 — O SEGUNDO GLOB: as units elite-* da era da ISO vivem ÓRFÃS em
# /etc/systemd/system e derrubaram a transação do rig em 'arquivos
# conflitantes' — /usr/local/bin/* sozinho era cego para o /etc. As DUAS
# famílias da casa escopam o --overwrite; nada fora delas é tocado.
# E54 — A SENTINELA ANTES DA TRANSAÇÃO (o erro cru do dono morre aqui):
# espera a base liberar / limpa o lock órfão, e a recusa do pacman vira
# mensagem honesta com o rc — o script NUNCA mais morde o erro cru calado
# (o rc REAL se captura fora da negação, a mesma lição E46 do --sistema).
if [ -z "$es_before" ] && [ -n "$tl_before" ]; then
    ulog "manual: craft-toplevel ${tl_before} vivo — o REPLACES puxa o elite-system nesta transação (alvo explícito brigaria alvo-contra-alvo com o próprio craft-toplevel)"
    _alvo=""
else
    _alvo="elite-system"
fi
sentinela_db
manual_rc=0
# E93 — o cru do pacman não some da tela: o STDERR passa pelo papel
# (ERRCAP → cat de volta + ULOG) e a classe órfã ganha a palavra. O
# STDOUT fica VIVO (as barras do pacman são a prova do progresso —
# capturar tudo era cegar a transação); só o stderr — onde o pacman
# fala 'existe no sistema de arquivos' — viaja pelo papel primeiro.
ERRCAP="$(mktemp "${TMPDIR:-/tmp}/elite-err.XXXXXX")"
if [ -n "$_alvo" ]; then
    run_root pacman -Syu --needed "${HOUSE_OVERWRITE[@]}" elite-system 2>"$ERRCAP" || manual_rc=$?
else
    run_root pacman -Syu --needed "${HOUSE_OVERWRITE[@]}" 2>"$ERRCAP" || manual_rc=$?
fi
if [ "$manual_rc" -ne 0 ]; then
    cat "$ERRCAP" >&2
    cat "$ERRCAP" >>"$ULOG" 2>/dev/null || true
    echo "ERRO: o pacman recusou a transação (rc=$manual_rc) — NADA da casa mudou." >&2
    echo "      A prova está nas linhas acima; se falar de 'travar a base de dados'," >&2
    echo "      outra operação de pacotes está em execução — rode de novo (a sentinela espera por você)." >&2
    ensina_orfao "$ERRCAP"
    rm -f "$ERRCAP"
    exit "$manual_rc"
fi
rm -f "$ERRCAP"
# E94 — a adoção de âncoras entra DEPOIS da dose vencida (a transação
# separada nunca bloqueia a principal) e ANTES do refresh da sessão.
adota_ancoras

# E48→E50 — a sessão do dono recebe o código novo NA HORA e INTEIRA (o
# daemon vivo não segue com a receita velha até relogin — a ferida do
# 'atualizei e persistiu' morre aqui, na dock, no áudio, no idle e no
# daemon de janelas — que agora viaja no pacote único)
refresh_if_craft_changed "$es_before" "$ec_before" "$tl_before"

# E46/E51 — o automatismo nasce aqui (idempotente): a cadência AO LIGAR
# + a semanal ficam vivas depois da 1ª 'Atualizar sistema'. A morada das
# units é injetável (ELITE_UNIT_DIR) para prova em sandbox —
# mesma escola do VMARK/ELITE_UPDATE_LOG.
elite_cadencia

if command -v paru >/dev/null 2>&1; then
  echo "==> AUR (paru -Sua)"
  paru -Sua
fi

# kernel DEPOIS: mudou na transação = reboot aplica (aviso, nunca erro)
kafter="$(pacman -Q "$KPKG" 2>/dev/null | awk '{print $2}' || true)"
if [[ -n "$kafter" && "$kafter" != "$kbefore" ]]; then
  echo "==> kernel atualizado (${kbefore:-ausente} → $kafter) — REINICIE para rodá-lo"
fi

# código da casa defasado? (curl com teto de tempo; falha = silêncio)
if [[ -r "$VMARK" ]] && command -v curl >/dev/null 2>&1; then
  inst="$(head -n1 "$VMARK" 2>/dev/null || true)"
  latest="$(curl -fsSL --max-time 10 \
      https://api.github.com/repos/Chrispsz/archcraft-elite/releases/latest 2>/dev/null \
      | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -n1 || true)"
  if [[ -n "$latest" && "$latest" != "$inst" ]]; then
    echo "==> Elite $latest disponível (base desta máquina: ${inst:-desconhecida})"
    echo "    o código da casa viaja SOZINHO agora (canal diário); a ISO nova é o capote mensal:"
    echo "    https://github.com/Chrispsz/archcraft-elite/releases/latest"
  fi
fi
