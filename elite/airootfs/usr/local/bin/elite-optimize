#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-optimize (v1.0 — E74, Fase 5 do protocolo do dono)
# ═══════════════════════════════════════════════════════════════════════════
# "Matemática dinâmica de RAM": o papel vindo da ISO era ÚNICO (swappiness
# 180 + zram min(ram,8192) para todo mundo) — servia o rig de 16 GB e
# enforcava a máquina de 2 GB. A spec manda LER A RAM FÍSICA e aplicar:
#
#   ≤ 4608 MiB (2-4 GB)  → ZRAM agressivo min(ram*2, 8192) · swappiness 150
#                          · vfs_cache_pressure 150 (o cache pequeno rende)
#   ≤ 10240 MiB (8 GB)   → ZRAM equilibrado min(ram, 8192) · swappiness 60
#                          · vfs_cache_pressure 100
#   > 10240 MiB (16 GB+) → ZRAM min(ram/2, 16384) · swappiness 15
#                          · vfs_cache_pressure 50 (prioriza cache em RAM)
#
# ENTREGA: /etc/sysctl.d/99-elite-ram.conf — LEXICALMENTE DEPOIS de
# 99-elite.conf ('r' > 'c'), o perfil VENCE nos 3 pontos sem tocar na lei
# base (page-cluster/watermarks/etc. ficam intocados). O zram-generator.conf
# só é reescrito QUANDO o pacote existe (conf sem dono era doença — a
# reconciliação E74 pôs o zram-generator no packages.add).
#
# Uso: elite-optimize            aplica (raiz)
#      elite-optimize --status   lê sem mutar (a E33 manda poder conferir)
#      elite-optimize --profile  imprime o nome do perfil
#      elite-optimize --swappiness  imprime o swappiness do perfil (o 2i
#                                do firstboot consulta em vez de adivinhar)
# Costuras de teste: ELITE_MEMINFO / ELITE_SYSCTL_DIR / ELITE_ZRAM_CONF ·
# ELITE_NO_ROOT_CHECK=1 (o executor de testes roda sem raiz) · ELITE_PROVA=0
# (o kernel do ambiente de teste não carrega o perfil — a prova real é do
# rig; aqui a prova é o CONTEÚDO dos arquivos) · ELITE_CPU_DIR (o sysfs da
# CPU no teste) · ELITE_NO_CPU=1 (máquina sem cpufreq — o passo é pulado
# com aviso). Em produção, nada disso é setado: raiz exigida, prova no
# kernel obrigatória.
# ═════════════════════════════════════════════════════════════════════════
set -u
MEMINFO="${ELITE_MEMINFO:-/proc/meminfo}"
SYSCTL_DIR="${ELITE_SYSCTL_DIR:-/etc/sysctl.d}"
ZRAM_CONF="${ELITE_ZRAM_CONF:-/etc/systemd/zram-generator.conf}"
CPU_DIR="${ELITE_CPU_DIR:-/sys/devices/system/cpu}"

say() { printf 'elite-optimize: %s\n' "$*"; }
die() { printf 'elite-optimize: ERRO: %s\n' "$*" >&2; exit 1; }

mem_mib() {
    awk '/^MemTotal:/ { printf "%d\n", $2/1024 }' "$MEMINFO" 2>/dev/null | head -1
}

# ── a matemática (a ÚNICA fonte de verdade dos 3 números) ──────────────────
calc() {
    local m; m="$(mem_mib)"
    [[ "${m:-0}" =~ ^[0-9]+$ ]] || m=0
    (( m > 0 )) || die "MemTotal ilegível em $MEMINFO (impossível calcular o perfil)"
    MEM_MIB="$m"
    if (( m <= 4608 )); then
        PROFILE="pequena (2-4 GB)"; SW=150; CP=150; ZRAM='min(ram * 2, 8192)'
    elif (( m <= 10240 )); then
        PROFILE="equilibrada (8 GB)"; SW=60; CP=100; ZRAM='min(ram, 8192)'
    else
        PROFILE="abundante (16 GB+)"; SW=15; CP=50; ZRAM='min(ram / 2, 16384)'
    fi
}

status() {
    calc
    say "RAM física: ${MEM_MIB} MiB → perfil $PROFILE"
    say "perfil: swappiness=$SW · vfs_cache_pressure=$CP · zram-size=$ZRAM (zstd)"
    say "kernel hoje: vm.swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo '?')"
    if command -v zramctl >/dev/null 2>&1 && zramctl 2>/dev/null | grep -q zram0; then
        say "zram vivo: $(zramctl --output DISKSIZE,ALGORITHM 2>/dev/null | tail -1)"
    else
        say "zram: inativo (o systemd-zram-setup@zram0 sobe com o conf)"
    fi
    say "arquivos: $SYSCTL_DIR/99-elite-ram.conf $( [[ -f $SYSCTL_DIR/99-elite-ram.conf ]] && echo '(presente)' || echo '(ausente)' )"
    # E88 — o governor no status (o 'responsivo?' se responde sem mutar)
    local g epp
    g="$(cat "$CPU_DIR/cpu0/cpufreq/scaling_governor" 2>/dev/null || echo '?')"
    epp="$(cat "$CPU_DIR/cpu0/cpufreq/energy_performance_preference" 2>/dev/null || echo '?')"
    say "CPU: governor=$g · epp=$epp (o alvo da casa: performance/performance)"
}

case "${1:-apply}" in
    --status) status; exit 0 ;;
    --profile) calc; say "$PROFILE"; exit 0 ;;
    --swappiness) calc; echo "$SW"; exit 0 ;;
    -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    apply) : ;;
    *) die "modo desconhecido: $1 (use --status / --profile / --swappiness)" ;;
esac

(( EUID == 0 || ${ELITE_NO_ROOT_CHECK:-0} == 1 )) \
    || die "aplicar exige root (sudo elite-optimize) — o --status é público"

calc
say "RAM física: ${MEM_MIB} MiB → perfil $PROFILE"

# ── 1. o perfil de sysctl (vence a base por ordem lexical — sem tocar nela) ──
mkdir -p "$SYSCTL_DIR" 2>/dev/null
SYSF="$SYSCTL_DIR/99-elite-ram.conf"
cat > "$SYSF" <<EOF
# ── ELITE: perfil de RAM (elite-optimize — E74, Fase 5 do protocolo) ──
# MemTotal = ${MEM_MIB} MiB → perfil $PROFILE
# Este arquivo VENCE o 99-elite.conf nos pontos abaixo (ordem lexical:
# 'ram' > nada) — a lei base (page-cluster/watermarks/bbr) fica intacta.
vm.swappiness = ${SW}
vm.vfs_cache_pressure = ${CP}
EOF
say "sysctl: $SYSF escrito (swappiness=$SW · cache_pressure=$CP)"

# ── 2. o zram SÓ quando o pacote existe (conf sem dono era doença) ─────────
if [[ -f "$ZRAM_CONF" ]]; then
    cat > "$ZRAM_CONF" <<EOF
# ── ELITE: perfil de RAM (elite-optimize — E74) — vence o do cachyos-settings
# MemTotal = ${MEM_MIB} MiB → perfil $PROFILE
[zram0]
zram-size = ${ZRAM}
compression-algorithm = zstd
EOF
    say "zram: $ZRAM_CONF reescrito (zram-size = $ZRAM · zstd)"
    systemctl daemon-reload 2>/dev/null || true
    systemctl try-restart systemd-zram-setup@zram0.service 2>/dev/null || true
else
    say "zram: $ZRAM_CONF ausente (zram-generator não instalado — o elite-tune [5] cuida)"
fi

# ── 3. O CORAÇÃO DA RESPONSIVIDADE: governor de CPU (E88 — a diretriz do
#      dono: 'tudo acontecer na maior velocidade possível, como se fosse
#      ali direto no hardware'). O scheduler que escala para baixo é a
#      diferença entre INSTANTÂNEO e 'parece estar pensando': governor
#      performance + EPP performance (amd-pstate) fazem o clock subir com
#      o primeiro clique, não com o segundo. Idempotente, por-núcleo, e o
#      custo é honesto: mais consumo energético — NUMA DESKTOP é a escolha
#      certa (a spec do dono); notebook na bateria pode reverter com o
#      powerprofilesctl (a casa não decide pelo dono aqui, aplica o pedido).
if [[ "${ELITE_NO_CPU:-0}" == "1" ]]; then
    say "CPU: passo pulado (ELITE_NO_CPU=1 — ambiente sem cpufreq)"
else
    _cpu_feitos=0; _cpu_falhas=0
    for _gdir in "$CPU_DIR"/cpu*/cpufreq; do
        [[ -d "$_gdir" ]] || continue
        if [[ -w "$_gdir/scaling_governor" ]]; then
            if echo performance > "$_gdir/scaling_governor" 2>/dev/null; then
                _cpu_feitos=$((_cpu_feitos + 1))
            else
                _cpu_falhas=$((_cpu_falhas + 1))
            fi
        fi
        # EPP: amd-pstate(-epp) expõe energy_performance_preference — o
        # firmware pesando 'quão agressivo o governor sobe'; performance
        # = sobe com o primeiro clique
        if [[ -w "$_gdir/energy_performance_preference" ]]; then
            echo performance > "$_gdir/energy_performance_preference" 2>/dev/null || true
        fi
    done
    if (( _cpu_feitos == 0 && _cpu_falhas == 0 )); then
        say "CPU: nenhum cpufreq exposto no sysfs — passo sem objeto (réu nomeado, não fingido)"
    elif (( _cpu_falhas > 0 )); then
        say "CPU: governor performance aplicado em $_cpu_feitos núcleo(s), $_cpu_falhas RECUSADO(S) — o kernel nomeia (o réu fica no papel)"
    else
        say "CPU: governor performance aplicado em $_cpu_feitos núcleo(s) + EPP performance (o clock sobe com o PRIMEIRO clique — a responsividade que o dono mandou)"
    fi
fi

# ── 4. aplica e PROVA no kernel (a lei 2i: conferir, não apostar) ──────────
if [[ "${ELITE_PROVA:-1}" == "1" ]]; then
    sysctl --system >/dev/null 2>&1 || true
    got="$(sysctl -n vm.swappiness 2>/dev/null || echo '?')"
    if [[ "$got" == "$SW" ]]; then
        say "PROVA: vm.swappiness = $got confirmado no kernel (perfil $PROFILE no ar)"
    else
        die "vm.swappiness do kernel segue '$got' (queria $SW) — réu à vista: sysctl.d concorrente"
    fi
else
    say "prova no kernel ADIADA (ELITE_PROVA=0 — ambiente de teste): a prova aqui é o conteúdo"
fi
