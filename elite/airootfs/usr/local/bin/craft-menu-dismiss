#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-menu-dismiss (v1.1 — A LEI DO DISMISS, v2.9.0/E98)
# ═══════════════════════════════════════════════════════════════════════════
# O QUE É: o fechamento de menu por clique fora, como LEI DO COMPOSITOR.
#
# HISTÓRIA (por que este script existe):
#   · v2.3.11 — a "gaiola" era uma janela GTK modal (nunca abriu no rig).
#   · v2.7.0/v2.8.0 — a gaiola virou superfície layer-shell da dock com
#     input region trocável. O rig do dono DESMENTIU com a carne: "matou o
#     uso do mouse no sistema… só topbar e dock funcionam" — a perícia do
#     código provou o bug (self.cage setado DEPOIS do _cage_set_region —
#     a região de input nascia CHEIA e só crescia: uma rede invisível
#     engolindo o clique de TODA janela, Calamares incluso).
#   · v2.9.0 — ZERO superfícies novas. O labwc entrega o clique fora ao
#     DESKTOP (contexto Root do rc.xml), e o rc.xml o executa AQUI:
#       · ESQUERDO no desktop: mata o menu aberto e NÃO abre nada (o
#         "fechar clicando fora" do dono — sem vazar pro menu-raiz);
#       · DIREITO no desktop: mata o menu aberto e abre o menu-raiz
#         (substituição limpa — o desktop segue com o direito de sempre).
#     Se NENHUM menu está aberto, este script é um no-op de ~1ms
#     (um stat() no state) — o clique esquerdo do desktop continua MUDO
#     na prática, como o dono quer desde a v2.7.
#
# v1.1 (E98 — O MARTELO ALCANÇA A GAVETA): o relato do dono ("menu de
#   aplicativos em primeiro plano que não fecha") + o baile das 20:31 no
#   dump 203201 — a GAVETA (nwg-drawer, layer-shell, keyboard-exclusivo)
#   não tinha martelo: o state só casa fuzzel, e uma gaveta presa não
#   morria por clique-fora NENHUM. Agora o clique no desktop encerra
#   QUALQUER gaveta aberta, por comm exato (pkill -x — a mesma lei: pid
#   é pid, comm é a prova), com uma linha no menus.log quando fala — o
#   próximo dump prova o martelo em ação.
#
# GARANTIAS (a classe de bug que matou a gaiola é impossível aqui):
#   · nenhuma superfície, nenhuma input region, nenhuma geometria;
#   · só mata processo cujo comm é EXATAMENTE "fuzzel" (state — nunca um
#     pid reciclado de outro programa) ou "nwg-drawer" (martelo, comm
#     exato — mesma lei do toggle do craft-menu/craft-drawer);
#   · estado é do craft-menu: o kill interrompe o wait() lá e o trap
#     EXIT do craft-menu limpa o state; o rm aqui é cinto e suspensório.
#   · sem gaveta e sem menu: no-op de poucos milissegundos (um pkill
#     comm-exato + um stat no state — o esquerdo segue MUDO na prática).
# ═══════════════════════════════════════════════════════════════════════════
set -u

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP)
uso() {
    printf '%s\n' \
        'uso: craft-menu-dismiss — fecha QUALQUER menu/OSD aberto da sessão' \
        '     (a lei de cross-dismiss: um menu novo ou um lançamento nunca' \
        '     convivem com o anterior)' \
        '' \
        '  sem args — encerra a gaveta aberta (martelo E98) e o menu fuzzel' \
        '  do state (comm exato); gramática 0/1/143 no menus.log.'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac

# E98 — O MARTELO (antes do state: a gaveta não é fuzzel e nunca terá
# state; o clique no desktop é do dono — qualquer overlay aberto encerra)
if pkill -x nwg-drawer 2>/dev/null; then
    mlog="${XDG_CACHE_HOME:-${HOME:-/root}/.cache}/elite/menus.log"
    mkdir -p "${mlog%/*}" 2>/dev/null || true
    printf '[%s] gaveta: encerrada pelo clique-fora (martelo E98 — comm nwg-drawer)\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" >> "$mlog" 2>/dev/null || true
fi

ST="${XDG_RUNTIME_DIR:-/tmp}/elite-menus.$(id -u 2>/dev/null || echo 0)"

# sem state = sem menu fuzzel aberto = no-op imediato (o caminho comum)
[ -f "$ST" ] || exit 0

pid=""
read -r pid _ <"$ST" 2>/dev/null || true
case "${pid:-}" in
    ''|*[!0-9]*) exit 0 ;;   # state corrompido: não mata NADA
esac
[ "$pid" -gt 1 ] 2>/dev/null || exit 0

# a lei do toggle do craft-menu: pid é pid, comm é a prova
[ "$(ps -o comm= -p "$pid" 2>/dev/null || true)" = "fuzzel" ] || exit 0

kill "$pid" 2>/dev/null || true
rm -f "$ST" 2>/dev/null || true
exit 0
