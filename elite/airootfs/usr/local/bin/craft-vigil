#!/bin/sh
# craft-vigil — A VIGÍLIA do lock (E60) com OUVIDOS (E61)
# ─────────────────────────────────────────────────────────────────────────
# O RELATO DO DONO (v2.10.28+): "quando bloqueia, não entra a suspensão
# automática de forma alguma. Então passa o tempo, nada acontece." — e o
# update não mudou nada. A perícia no papel (E60) apontou o desenho:
# a receita swayidle conta LOCK/SUSPEND do MESMO zero (última atividade),
# e o braço do lock chamava 'craft-lock' SEM --if-needed — se o lock
# screen rearmar o relógio de idle do compositor (surface nova + grab do
# teclado é atividade em compositor wlroots), o ciclo vira escrachador:
# lock aos 5min → relock aos 10 → relock aos 15 → o suspend aos 20 NUNCA
# chega. O update não curou porque o defeito é de DESENHO, não de valor.
#
# A OUTRA ABORDAGEM (o dono pediu outra): o suspend deixa de depender do
# relógio de idle POR COMPLETO. Quem arma é o LOCK (craft-lock): este
# vigia conta o tempo TRAVADO (hyprlock vivo) e dorme o PC quando o lock
# completar SUSPEND_MIN minutos. Desarmou? O hyprlock morreu (usuário
# destravou) → vigia sai. O braço swayidle (timeout SUSPEND_MIN) fica no
# ar como SEGUNDA rede — e desde a E61 como rede DEFERIDA: lock vivo com
# vigília no ar, o braço idle NÃO dorme (o tempo TRAVADO é a autoridade
# enquanto travado).
#
# E61 — O RELATO ESCLARECIDO (a ordem errada): "ele até suspendia, mas só
# DEPOIS que eu colocava a senha para desbloquear... ele vai lá e entra
# em suspensão depois que eu coloco a senha... a suspensão tá no lugar
# errado". A arma identificada: o braço idle de suspend — o deadline de
# idle não vê a digitação quando o compositor não conta input travado
# como atividade: o timeout vencia com a senha NO MEIO e o PC dormia em
# vez de desbloquear (o dono ligava de novo, digitava de novo — o ciclo
# que ele viveu). A cura tem duas camadas:
#   (1) o braço idle defere com lock vivo + vigia no ar (no craft-idle);
#   (2) ESTA vigília ganhou OUVIDOS — ela não suspende com mãos no lock:
#       · orelha de CPU (universal): o hyprlock é o único que RECEBE a
#         digitação em TODOS os mundos — queimou ≥ 1 jiffy de CPU desde
#         o último tick = mãos (a única voz da mão quando o compositor
#         não conta input travado);
#       · orelha do compositor (mundo A): o RESUME do swayidle renova a
#         marca idle-activity (mtime) — input travado contado como
#         atividade renova a marca a cada tecla;
#       · dormir EXIGE ticks quietos (≥ 60s sem nenhuma orelha gritar):
#         falso-positivo custa só um suspend mais tarde (inofensivo);
#         falso-negativo é o que não pode existir.
#
# SEMÂNTICA DO TEMPO: SUSPEND_MIN passou a valer DUAS leituras, ambas
# legítimas — minutos de idle até dormir (rede swayidle) E minutos
# TRAVADO até dormir (a vigília). O knob é o mesmo (idle.conf), o menu do
# craft-idle continua sendo a única porta de ajuste. O sleep do vigia usa
# contagem de ticks — o tempo SUSPENSO não conta (o vigia morre no
# suspend de qualquer forma: a missão acabou).
#
# GRAVIDADE: spawn ANTES do exec do hyprlock (craft-lock) → o lock pode
# ainda não ter mapeado quando o vigia acorda. Graça de 15s pelo primeiro
# aliveness; lock que não nasce = braço desarmado com réu no papel.
#
# LIMITAÇÃO HONESTA: o vigia lê a vida do HYPRLOCK — é o locker da Elite
# (v1.5). No fallback loginctl (hyprlock ausente) o craft-lock NÃO arma
# (armar seria prometer o que não pode vigiar — a lei da casa). As
# orelhas têm limites próprios: a orelha de CPU pode não ver UMA tecla
# isolada (o limiar é ≥ 1 jiffy); o limiar ≥ 60s de quieto pode suspender
# com o dono PARADO na frente do lock (parado = idle por definição —
# acordar dá o lock de volta com a senha, o fluxo prometido).
#
# OBSERVÁVEL: todo braço deixa linha no idle.log (a lei E33/E44 do corpo
# do craft-idle) — 'não suspendeu' ganha réu NOMEADO com rc, não opinião.
#
# E77 — O PORTÃO E A AUTORIDADE ÚNICA (a spec do dono: timers de
# bloqueio/DPMS/suspensão estritamente sequenciais e mutuamente
# exclusivos; resume não re-suspende até o destravo e um novo período
# completo de inatividade):
#   · AUTORIDADE ÚNICA: sob lock vivo, esta vigília é o ÚNICO juiz do
#     suspend (o braço idle do craft-idle defere SEMPRE e a re-arma se
#     ela morreu — a janela 'vigia morto + senha no meio' morreu);
#   · O PORTÃO (idle-suspend-gate, XDG_RUNTIME_DIR): fechado no pós-sono
#     (o sleep-hook do before-sleep fecha em TODO sono; esta vigília
#     fecha de novo antes do próprio suspend — swayidle morto também
#     fica coberto) = o teto estourado NÃO dorme: espera o destravo. O
#     destravo mata esta vigília pelo próprio laço — e a saída natural
#     ABRE o portão (o lock que morreu é evento NOVO: o ciclo pode
#     recomeçar do zero — T1 → lock novo → vigília nova).
#   · A GRAÇA que falha (lock não nasceu em 15s) também abre: um braço
#     desarmado não pode segurar o ciclo para sempre.
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/elite/idle.conf"
SUSPEND_MIN=20   # fábrica = a mesma do craft-idle (conf ruim → padrão,
                 # nunca silêncio — v2.10.5)
# shellcheck disable=SC1090  # conf do usuário POR DESIGN (v1.6.1)
[ -r "$CONF" ] && . "$CONF"
case "${SUSPEND_MIN:-}" in ''|*[!0-9]*) SUSPEND_MIN=20 ;; esac
[ "$SUSPEND_MIN" -gt 0 ] || exit 0   # 'Nunca' é escolha EXPLÍCITA do dono

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/idle.log"
vlog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null
    return 0
}

ACT_EPOCH="${XDG_RUNTIME_DIR:-/tmp}/elite/idle-activity"
# E77 — o portão do pós-sono (a MESMA lei do craft-idle: existe = fechado
# = nenhum timer suspende; a vigília obedece, fecha no próprio sono e
# abre na saída natural — o destravo é o dono da chave).
GATE="${XDG_RUNTIME_DIR:-/tmp}/elite/idle-suspend-gate"

alive() { pgrep -x hyprlock >/dev/null 2>&1; }

# E61 — a orelha de CPU: utime+stime do hyprlock em jiffies. Após o
# comm (com ')' no meio — o corte é GULOSO até o último ') '), o utime
# é o 12º campo do resto e o stime o 13º (campos 14/15 do stat inteiro).
cpu_of() {
    p="$(pgrep -x hyprlock 2>/dev/null | head -1)" || return 1
    [ -r "/proc/$p/stat" ] || return 1
    awk '{ sub(/^.*\) /, ""); printf "%d", $12 + $13 }' "/proc/$p/stat" 2>/dev/null
}

# graça: o lock que me armou pode ainda estar nascendo (spawn < exec)
i=0
while [ "$i" -lt 15 ] && ! alive; do
    sleep 1
    i=$((i + 1))
done
if ! alive; then
    vlog "VIGÍLIA: lock não nasceu em 15s — braço desarmado (réu: o lock não mapeou)"
    # E77 — braço desarmado não segura o ciclo: um portão fechado aqui é
    # prisão perpétua do suspend (o lock morreu antes de nascer — evento
    # NOVO, não o resume; o próximo T1/lock novo recomeça do zero).
    rm -f "$GATE" 2>/dev/null || true
    exit 0
fi

vlog "VIGÍLIA: armada — suspende com o lock vivo por ${SUSPEND_MIN}min sem mãos (orelhas: CPU do hyprlock + marca de atividade do compositor; dormir exige ticks quietos)"
cpu_ant="$(cpu_of 2>/dev/null || echo 0)"
quiet=0
elapsed=0
teto=$((SUSPEND_MIN * 60))
gate_dito=""   # E77 — o portão falha UMA vez por episódio (o papel não spama)
while alive; do
    cpu_agora="$(cpu_of 2>/dev/null || echo 0)"
    delta=$((cpu_agora - cpu_ant))
    [ "$delta" -lt 0 ] && delta=0
    cpu_ant="$cpu_agora"
    motivo=""
    if [ "$delta" -ge 1 ]; then
        motivo="hyprlock +${delta} jiffies (mãos no lock)"
    fi
    if [ -r "$ACT_EPOCH" ]; then
        marca="$(stat -c %Y "$ACT_EPOCH" 2>/dev/null || echo 0)"
        idade=$(( $(date +%s) - marca ))
        if [ "$idade" -lt 90 ]; then
            if [ -n "$motivo" ]; then
                motivo="$motivo; compositor viu atividade há ${idade}s"
            else
                motivo="compositor viu atividade há ${idade}s"
            fi
        fi
    fi
    if [ -n "$motivo" ]; then
        # E61 — UM log por episódio: a mão que volta depois de um tick
        # quieto registra; teclas seguidas no MESMO episódio não spama.
        if [ "$quiet" -ge 1 ]; then
            vlog "VIGÍLIA: mãos no lock ($motivo) — suspend adiado (não dorme sob o dono)"
        fi
        quiet=0
    else
        quiet=$((quiet + 1))
    fi
    if [ "$elapsed" -ge "$teto" ] && [ "$quiet" -ge 2 ]; then
        # E77 — O PORTÃO NA DECISÃO: fechado = o último sono ainda não foi
        # pago com um destravo (a spec: nenhum timer suspende de novo até
        # a sessão desbloquear e correr um novo período completo de
        # inatividade). A vigília ESPERA (o laço segue; o destravo mata o
        # laço e a saída natural abre o portão) — o wake fica travado e
        # ACORDADO esperando a senha, nunca re-suspendido por timer.
        if [ -e "$GATE" ]; then
            if [ -z "$gate_dito" ]; then
                vlog "VIGÍLIA: portão FECHADO — suspend suprimido (pós-sono sem destravo: isolamento E77; o destravo abre o portão e encerra a vigília)"
                gate_dito=1
            fi
        else
            vlog "VIGÍLIA: suspendindo (travado há ${SUSPEND_MIN}min, ${quiet} ticks quietos — escuro e travado: acorda no lock)"
            # E77 — o portão fecha PELO SUSPEND (cinto-e-suspensório do
            # sleep-hook do before-sleep: swayidle morto = before-sleep
            # não roda — o sono da vigília mesma garante o isolamento do
            # próximo wake).
            mkdir -p "${GATE%/*}" 2>/dev/null || true
            : > "$GATE" 2>/dev/null || true
            if systemctl suspend -i; then
                vlog "VIGÍLIA: suspend voltou (ciclo completo — a vigília EXISTE e está no papel)"
                # E63 — A VOLTA DA IMAGEM: quem chamou o sono SOBREVIVE a ele
                # e é um dos primeiros processos de usuário de pé no wake —
                # o screenon (sondagem 6×2s + rearmamento da vigília sucessora)
                # roda AQUI também. O callback resume do swayidle pode perder
                # a corrida contra a re-inicialização do driver (o monitor
                # 'sem sinal, luz vermelha' do dono, 06/nov) — um caminho só
                # não é rede; são três: swayidle resume, ESTA chamada e o
                # hook de sistema elite-resume-display (todos idempotentes).
                craft-idle screenon >/dev/null 2>&1 || true
            else
                vlog "FALHA: vigília systemctl suspend -i rc=$? — o PC NÃO dormiu (réu nomeado no papel)"
            fi
            exit 0
        fi
    fi
    sleep 30
    elapsed=$((elapsed + 30))
done
# E77 — O DESTRAVO ABRE O PORTÃO: o lock morreu (o dono digitou a senha —
# ou o lock crashou; os dois são eventos NOVOS, não o resume). O isolamento
# acaba aqui: o próximo ciclo (T1 → lock novo → vigília nova) é o 'novo
# período completo de inatividade' da spec. Sem isto, um vigia morto antes
# de abrir deixaria o portão preso fechado para sempre.
rm -f "$GATE" 2>/dev/null || true
vlog "VIGÍLIA: destravado com o lock vivo por ${elapsed}s (últimos ${quiet} ticks quietos) — braço desarmado sem suspend · portão ABERTO (E77)"
exit 0
