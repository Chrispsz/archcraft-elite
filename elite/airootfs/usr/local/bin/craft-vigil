#!/bin/sh
# craft-vigil — a vigília do lock: suspende com o hyprlock vivo e quieto
# ─────────────────────────────────────────────────────────────────────────
# PAPEL: armada pelo craft-lock a todo lock novo. Com o hyprlock vivo,
# suspende via `systemctl suspend -i` após SUSPEND_MIN minutos TRAVADOS
# sem mãos no lock. O tempo TRAVADO decide (nunca o idle do compositor).
#
# DESENHO:
#   · orelha de CPU: utime+stime do hyprlock por tick de 30s — pico de
#     ≥ 8 jiffies = tentativa de senha (mão de verdade); o relógio de
#     render (+1/+2 jiffies) é ruído e NÃO renova a contagem;
#   · dormir exige ≥ 2 ticks quietos: falso-positivo custa um sono mais
#     tarde (inofensivo); falso-negativo é o que não pode existir;
#   · contagem CONTÍNUA: mãos no lock zeram teto E contador — a senha
#     digitada empurra o sono um período INTEIRO para a frente;
#   · portão (idle-suspend-gate, XDG_RUNTIME_DIR): fechado no pós-sono;
#     aberto no destravo (evento NOVO — o ciclo recomeça do zero);
#   · ciclo persistente: a vigília obsoleta (sono sob a própria vigília)
#     aposenta-se e arma a sucessora com a contagem nova do wake; a
#     sucessora nasce após CADA sono pago OU recusado — UMA vigília por
#     ciclo (flock no XDG_RUNTIME_DIR, lei E30);
#   · veredito do sono pelo JOURNAL: 'Suspending system' → 'Awake from
#     suspend' — a chamada systemctl é assíncrona, o papel não chuta;
#   · última olhada: pgrep fresco imediatamente antes do systemctl —
#     lock morto = destravo no intervalo do tick = nada de sono sobre
#     destravo.
#
# OBSERVÁVEL: todo braço deixa linha no idle.log com réu NOMEADO.
# LIMITAÇÃO HONESTA: vigia o hyprlock (o locker da casa); sem hyprlock
# o craft-lock nem arma. Daemon interno — NÃO rodar na mão (Uma vigília
# por ciclo; o papel completo está no --help).
set -u

# E90 — o --help que faltava (a lacuna nº 1 do UX-ROADMAP). A vigília é um
# daemon interno — não é porta de mão: qualquer argumento aqui seria uma
# SEGUNDA vigília (a lei E30 manda UMA por ciclo). O estado mora no
# idle.log (seção da vigília) e no craft-dump.
uso() {
    printf '%s\n' \
        'uso: craft-vigil — A VIGÍLIA DO LOCK (daemon interno; sem argumentos)' \
        '' \
        '  armada pelo craft-lock a TODO lock novo: com o hyprlock vivo, suspende' \
        '  via systemctl suspend -i após SUSPEND_MIN minutos TRAVADOS (o tempo' \
        '  travado decide — E60); ouvidos E61: exige ticks quietos do próprio' \
        '  hyprlock (nunca suspende sob o dono digitando a senha); o destravo' \
        '  desarma; a sucessora do próprio ciclo renasce a cada sono (E78/E79).' \
        '  o estado no papel: ~/.cache/elite/idle.log · sudo craft-dump (seção 10).' \
        '  NÃO rodar na mão — UMA vigília por ciclo (lei E30).'
    exit 0
}
case "${1:-}" in -h|--help|uso) uso ;; esac
# E90 — A PORTA FECHA (a cura E30 que faltava): os DOIS chamadores legítimos
# (craft-lock e craft-idle) armam sem argumentos — um argumento qualquer
# aqui não é contrato, é erro humano (e viraria uma SEGUNDA vigília).
# Recusa clara antes de qualquer contagem.
if [ $# -gt 0 ]; then
    # (o uso() termina em exit 0 — chamá-lo aqui ROUBARIA o rc 2; o caminho
    # de erro aponta a porta em vez de imprimi-la)
    printf 'craft-vigil: argumento inesperado "%s" — a vigília não tem verbos (uso completo: craft-vigil --help)\n' "$1" >&2
    exit 2
fi

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/elite/idle.conf"
SUSPEND_MIN=20   # fábrica = a mesma do craft-idle (conf ruim → padrão,
                 # nunca silêncio — v2.10.5)
# shellcheck disable=SC1090  # conf do usuário POR DESIGN (v1.6.1)
[ -r "$CONF" ] && . "$CONF"
case "${SUSPEND_MIN:-}" in ''|*[!0-9]*) SUSPEND_MIN=20 ;; esac
[ "$SUSPEND_MIN" -gt 0 ] || exit 0   # 'Nunca' é escolha EXPLÍCITA do dono

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/idle.log"
vlog() {
    mkdir -p "${LOG%/*}" 2>/dev/null || true
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null
    return 0
}

# E77 — o portão do pós-sono (a MESMA lei do craft-idle: existe = fechado
# = nenhum timer suspende; a vigília obedece, fecha no próprio sono e
# abre na saída natural — o destravo é o dono da chave).
GATE="${XDG_RUNTIME_DIR:-/tmp}/elite/idle-suspend-gate"

# E97 — A TRAVA DA LEI E30 (o dump 163423 do rig flagrou DUAS vigílias
# vivas no mesmo lock — pids 37301+59893: a sucessora da E79 e o re-arme
# do screenon nasceram da mesma janela e o pgrep de guard perdeu a
# corrida, como o próprio E79 confessa). O flock não perde corrida: o
# kernel decide, a perdedora se retira em silêncio. A trava mora no
# XDG_RUNTIME_DIR/elite (tmpfs — morre com a sessão, zero lixo em disco);
# sem XDG_RUNTIME_DIR o /tmp com uid no nome evita colisão de usuários.
# DUAS LIÇÕES DA PRÓPRIA SUÍTE (a cena C2 do 30-unit pegou as duas na
# carne — a rede funcionando):
#   · O CAMINHO: o .lock mora DENTRO do elite/ (o primeiro rascunho
#     colava o sufixo no PRÓPRIO dir do XDG — ${XDG}.lock — e o arquivo
#     sobrevivia ao rm -rf de qualquer cenário de renascimento);
#   · O VAZAMENTO: fd 9 é HERDADO pelos filhos — o sleep do loop vira
#     ÓRFÃO com a trava na mão quando a vigília morre, e a sucessora
#     nasce batendo numa trava que NINGUÉM segura (o sleep segura!).
#     TODO filho longo fecha o 9 na cara (a mesma gramática 9>&- do
#     craft-bars); os filhos curtos (awk/pgrep de um tick) morrem em
#     milissegundos e nunca atravessam um parto.
_rt97="${XDG_RUNTIME_DIR:-/tmp/elite-vigil-$(id -u 2>/dev/null || echo 0)}"
VLOCK="$_rt97/elite/vigil.lock"
mkdir -p "${VLOCK%/*}" 2>/dev/null || true
exec 9>"$VLOCK" 2>/dev/null || true
if ! flock -n 9 2>/dev/null; then
    # UMA vigília por ciclo — a lei E30 deixou de ser promessa do pgrep
    # (o pgrep vê o próprio chamador, perde a corrida do sucessor, morre
    # no duplo-nascimento) e virou fato do kernel. A retirada é SILENTE
    # de propósito: o nascimento legítimo (craft-lock) e os re-armes
    # (screenon/suspend/sucessora) DISPUTAM a trava toda hora — logar
    # cada retirada seria choramingar o circuito sadio.
    exit 0
fi

alive() { pgrep -x hyprlock >/dev/null 2>&1; }

# E78 — O MARCO DO MEU NASCIMENTO: a fronteira entre a contagem que é
# MINHA e a contagem pré-sono que virou papel velho. O portão com mtime
# DEPOIS deste instante é um sono que aconteceu SOB a minha vigília —
# e um sono sob a minha vigília invalida a minha contagem (a sucessora
# nasce com a contagem nova do wake).
nascimento="$(date +%s)"

# E61 — a orelha de CPU: utime+stime do hyprlock em jiffies. Após o
# comm (com ')' no meio — o corte é GULOSO até o último ') '), o utime
# é o 12º campo do resto e o stime o 13º (campos 14/15 do stat inteiro).
cpu_of() {
    p="$(pgrep -x hyprlock 2>/dev/null | head -1)" || return 1
    [ -r "/proc/$p/stat" ] || return 1
    awk '{ sub(/^.*\) /, ""); printf "%d", $12 + $13 }' "/proc/$p/stat" 2>/dev/null
}

# graça: o lock que me armou pode ainda estar nascendo (spawn < exec)
i=0
while [ "$i" -lt 15 ] && ! alive; do
    sleep 1 9>&- 2>/dev/null || sleep 1
    i=$((i + 1))
done
if ! alive; then
    vlog "VIGÍLIA: lock não nasceu em 15s — braço desarmado (réu: o lock não mapeou)"
    # E77 — braço desarmado não segura o ciclo: um portão fechado aqui é
    # prisão perpétua do suspend (o lock morreu antes de nascer — evento
    # NOVO, não o resume; o próximo T1/lock novo recomeça do zero).
    rm -f "$GATE" 2>/dev/null || true
    exit 0
fi

vlog "VIGÍLIA: armada — suspende com o lock vivo por ${SUSPEND_MIN}min sem mãos (orelha: CPU do hyprlock; dormir exige ticks quietos)"
cpu_ant="$(cpu_of 2>/dev/null || echo 0)"
quiet=0
elapsed=0
teto=$((SUSPEND_MIN * 60))
while alive; do
    cpu_agora="$(cpu_of 2>/dev/null || echo 0)"
    delta=$((cpu_agora - cpu_ant))
    [ "$delta" -lt 0 ] && delta=0
    cpu_ant="$cpu_agora"
    motivo=""
    # o limiar da orelha: ≥ 8 jiffies num único tick de 30s = a
    # tentativa de senha (PAM + crypt + o redraw completo do lock) — o
    # relógio e o cursor do campo (+1/+2) são ruído de render, não mão.
    if [ "$delta" -ge 8 ]; then
        motivo="hyprlock +${delta} jiffies (pike de senha — mão de verdade, não o relógio)"
    fi
    if [ -n "$motivo" ]; then
        # E61 — UM log por episódio: a mão que volta depois de um tick
        # quieto registra; teclas seguidas no MESMO episódio não spama.
        # E78 (3) — AS MÃOS RENOVAM A CONTAGEM: o teto deixa de ser tempo
        # TRAVADO total e vira PERÍODO CONTÍNUO sem mãos (a spec: T3 só
        # corre continuamente idle — input reseta T3). A senha digitada
        # empurra o suspend um período INTEIRO para a frente a cada
        # episódio: a pausa de pensamento do dono não é mais suficiente
        # para dormir (o total antigo estourava com 60s de pausa).
        if [ "$quiet" -ge 1 ]; then
            vlog "VIGÍLIA: mãos no lock ($motivo) — suspend adiado e CONTAGEM RENOVADA (E78: o novo período começa AGORA — não dorme sob o dono)"
        fi
        quiet=0
        elapsed=0
    else
        quiet=$((quiet + 1))
    fi
    if [ "$elapsed" -ge "$teto" ] && [ "$quiet" -ge 2 ]; then
        # E78 — O PORTÃO NA DECISÃO, REESCRITO PELA EMENDA: fechado não é
        # mais prisão perpétua. Dois julgamentos, na ordem:
        #   (a) OBRIGAÇÃO: portão com mtime DEPOIS do meu nascimento = o
        #       sono aconteceu SOB a minha vigília — minha contagem é
        #       pré-sono (papel velho): aposto-me SEM dormir e a sucessora
        #       nasce com a contagem nova do wake (o ciclo persistente
        #       limpo; a guard anti-loop é o próprio marco — a sucessora
        #       nasce DEPOIS do portão, nunca re-entra aqui pelo MESMO
        #       sono).
        #   (b) O PAGAMENTO: portão fechado com a MINHA contagem (nasci
        #       DEPOIS do portão) = o novo período completo de inatividade
        #       foi pago na íntegra DESDE o wake — o isolamento E77
        #       termina legitimamente AQUI (lock vivo, orelhas quietas,
        #       ninguém digitando). Suspende — e o screenon do retorno
        #       re-arma a sucessora: o ciclo persiste indefinidamente.
        if [ -e "$GATE" ]; then
            gmt="$(stat -c %Y "$GATE" 2>/dev/null || echo 0)"
            if [ "$gmt" -gt "$nascimento" ]; then
                vlog "E78: vigília OBSOLETA (o sono fechou o portão DEPOIS do meu nascimento) — contagem VOID: saio sem dormir e a sucessora nasce com a contagem NOVA do wake (o ciclo persistente não herda tempo pré-sono)"
                # E97 — a trava abre ANTES do parto: a sucessora nasce sob
                # flock novo (senão ela vê a minha trava ainda viva, se
                # retira, e o wake fica ÓRFÃO — a cura E30 matando a E79).
                exec 9>&- 2>/dev/null || true
                setsid craft-vigil >/dev/null 2>&1 </dev/null &
                exit 0
            fi
            vlog "E78: portão fechado no pós-sono, mas a contagem é MINHA (nasceu do wake) — novo período completo PAGO: o isolamento E77 termina legitimamente (lock vivo, orelhas quietas); o ciclo persiste"
        fi
        vlog "VIGÍLIA: suspendindo (travado há ${SUSPEND_MIN}min sem mãos — contagem contínua E78, ${quiet} ticks quietos; escuro e travado: acorda no lock)"
        # E106 — A ÚLTIMA OLHADA ANTES DE DORMIR (a prova do dump: o suspend
        # das 16:09:58 congelou a máquina 1 segundo DEPOIS do destravo do
        # dono — o tick de 30s viu lock vivo, o dono digitou e saiu no
        # intervalo, e o sono caiu na cara dele). O tick é amostra; o sono
        # é FATRÁGIO: pgrep FRESCO (sem janela) imediatamente antes do
        # systemctl — lock morto = o dono acabou de sair: nada de sono,
        # portão abre e o vigia sai (o próximo lock arma vigília nova).
        if ! pgrep -x hyprlock >/dev/null 2>&1; then
            rm -f "$GATE" 2>/dev/null || true
            vlog "E106: suspend ABORTADO na última olhada — o lock morreu AGORA (o dono destravou no intervalo do tick; sono sobre destravo nunca mais)"
            exit 0
        fi
        # E77 — o portão fecha PELO SUSPEND (cinto-e-suspensório do
        # sleep-hook do before-sleep: swayidle morto = before-sleep
        # não roda — o sono da vigília mesma garante o isolamento do
        # próximo wake).
        mkdir -p "${GATE%/*}" 2>/dev/null || true
        : > "$GATE" 2>/dev/null || true
        # E108→E122 — O VEREDICTO É O QUE O JOURNAL MOSTRA (a prova do papel
        # do próprio rig, 20+ linhas no idle.log: 'systemctl voltou em 0s
        # SEM sono' seguido 1s depois de 'tela: ACORDOU' + vigília
        # re-armada — a chamada systemctl é ASSÍNCRONA: ela só ENTREGA o
        # pedido ao logind, o sono acontece por conta DELE; 'voltou em 0s'
        # nunca provou insônia e o papel mentiu dias a fio — E33 na própria
        # cura). O julgamento agora é por JANELA de journal: systemd-suspend
        # loga 'Suspending system...' antes do S3 e 'Awake from suspend.'
        # depois do thaw — os dois timestamps são a prova de parede.
        _t0="$(date +%s)"
        if systemctl suspend -i; then
            _dur=$(( $(date +%s) - _t0 ))
            vlog "VIGÍLIA: systemctl suspend aceito (${_dur}s, rc=0) — a chamada é ASSÍNCRONA (E122); o veredito do sono é o que o journal mostra na janela:"
            # E140 — A ESPERA DO VEREDITO (a ordem do dono, dossiê 1.0-88:
            # 'corrigir o timing do sleep-hook' — o dump 192038 fotografou
            # o E110 TARDIO e o 'tela: ACORDOU' NO MESMO SEGUNDO da
            # chamada: o código antigo lia o journal na janela de 0s — o
            # sono nem tinha COMEÇADO — e seguia em frente com o screenon
            # e o rearme DENTRO do limbo entre a chamada e o S3. Agora: o
            # olho espera o journal DIZER (≤5s, 1s por olhada — o logind
            # demora ~1s para o 'Suspending system'): o sono começou =
            # ESTE processo congela junto e o screenon roda DEPOIS do
            # wake (a ordem certa de sempre); sono recusado/inibido = o
            # veredito honesto vira a linha do papel e o ciclo rearma
            # limpo, sem o fantasma que suspende de novo na cara do dono)
            # o tamanho do olho: 8×0.7s (≈5.6s) — o logind da casa
            # espera os inhibitors delay por até InhibitDelayMaxSec=5s
            # ANTES do 'Suspending system' (E106/5a: o olho antigo de 3×0.7s
            # via a janela FECHAR antes do logind dizer a palavra e o papel
            # mentia 'SEM sono' para sono a caminho — o journal conta, o
            # papel não chuta); o S3 CONGELA este processo no meio do loop
            # (o freeze É a espera) e a sucessora do ciclo nasce depois
            _esp=0
            _j=""
            _ts=""
            while [ "$_esp" -le 8 ]; do
                _j="$(journalctl -b -u systemd-suspend --since "@$_t0" -o short-epoch --no-pager 2>/dev/null || true)"
                _ts="$(printf '%s\n' "$_j" | grep -m1 'Suspending system' | cut -d' ' -f1 | cut -d. -f1)"
                [ -n "$_ts" ] && break
                sleep 0.7
                _esp=$((_esp + 1))
            done
            _ts="$(printf '%s\n' "$_j" | grep -m1 'Suspending system' | cut -d' ' -f1 | cut -d. -f1)"
            _ta="$(printf '%s\n' "$_j" | grep -m1 'Awake from suspend' | cut -d' ' -f1 | cut -d. -f1)"
            case "${_ts:-}" in ''|*[!0-9]*) _ts="" ;; esac
            case "${_ta:-}" in ''|*[!0-9]*) _ta="" ;; esac
            if [ -n "$_ts" ] && [ -n "$_ta" ]; then
                vlog "VIGÍLIA: sono REAL confirmado pelo journal ($((_ta - _ts))s de S3 — Suspending→Awake, 1º ciclo da janela)"
            elif [ -n "$_ts" ]; then
                vlog "VIGÍLIA: journal confirma o INÍCIO do sono (Suspending system) sem o despertar na janela vista — quem conta o fim é o journal (o papel não chuta)"
            else
                vlog "VIGÍLIA: journal SEM sono na janela da chamada (${_dur}s) — se o logind dormir depois, quem conta é o journal; o papel não chuta (E122)"
            fi
            # E63 — A VOLTA DA IMAGEM: quem chamou o sono SOBREVIVE a ele
            # e é um dos primeiros processos de usuário de pé no wake — o
            # recover (ciclo off→on COM o modo salvo, para TODAS as saídas
            # vivas) roda AQUI também. O callback resume do swayidle pode
            # perder a corrida contra a re-inicialização do driver (o
            # monitor 'sem sinal, luz vermelha' do dono, 06/nov) — um
            # caminho só não é rede; são QUATRO agora: o despertar do
            # elite-daemon (PrepareForSleep(false)/Unlock), ESTA chamada,
            # o hook de sistema elite-resume-display e o pós-unlock do
            # craft-lock (todos idempotentes — o guard de 10s do recover
            # deixa UM dono por veredito).
            # E106/5a — o verbo 'screenon' do craft-idle MORREU com o
            # swayidle (não existe mais na v2.0 e a chamada caía no CYCLE
            # dos presets: cada sono MUDAVA o LOCK_MIN do dono às
            # escondidas — o bug mais quieto do dossiê). O recover do
            # craft-display é o herdeiro da rede de imagem.
            craft-display recover >/dev/null 2>&1 || true
        else
            vlog "FALHA: vigília systemctl suspend -i rc=$? — o PC NÃO dormiu (réu nomeado no papel)"
        fi
        # E79 — A SUCESSORA DO PRÓPRIO CICLO: o screenon acima NÃO arma
        # ninguém para o meu ciclo (o pgrep dele vê o CHAMADOR vivo — eu),
        # e o callback resume do swayidle perde a corrida contra o meu
        # exit: sem este spawn, o wake do pagamento fica SEM vigia e o
        # ciclo persistente morre no 1º wake (o rig provou: dump 4nsos,
        # wake 14:11:35 sem re-arme → 2h08min escuro, travado e ACORDADO).
        # A sucessora nasce AQUI, nos DOIS desfechos do sono: no sucesso é
        # a contagem nova do wake (nascida DEPOIS do touch do portão —
        # PAGA o período inteiro no teto, dorme/acorda/conta/dorme); no
        # FALHA é a anti-prisão (o sono que não veio re-tenta a cada
        # período com vigia no ar e réu nomeado no papel). Nascida depois
        # do portão, ela nunca re-entra pelo MESMO sono — a guard anti-
        # loop é o próprio marco de nascimento (E78 preservada).
        # E97 — a trava abre ANTES do parto (a mesma cura do ramo
        # OBSOLETA: sucessora sob flock novo, nunca órfã).
        exec 9>&- 2>/dev/null || true
        setsid craft-vigil >/dev/null 2>&1 </dev/null &
        exit 0
    fi
    sleep 30 9>&- 2>/dev/null || sleep 30
    elapsed=$((elapsed + 30))
done
# E77 — O DESTRAVO ABRE O PORTÃO: o lock morreu (o dono digitou a senha —
# ou o lock crashou; os dois são eventos NOVOS, não o resume). O isolamento
# acaba aqui: o próximo ciclo (T1 → lock novo → vigília nova) é o 'novo
# período completo de inatividade' da spec. Sem isto, um vigia morto antes
# de abrir deixaria o portão preso fechado para sempre.
rm -f "$GATE" 2>/dev/null || true
vlog "VIGÍLIA: destravado com o lock vivo por ${elapsed}s (últimos ${quiet} ticks quietos) — braço desarmado sem suspend · portão ABERTO"
exit 0
