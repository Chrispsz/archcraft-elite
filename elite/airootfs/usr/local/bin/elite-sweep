#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-sweep — varredura PRÉ-LOGIN do instalador herdado
# ═══════════════════════════════════════════════════════════════════════════
# E30 (v2.10.18) — dump p6aw (rig do dono, 31/out 2026): o drawer do
# primeiro login indexou o calamares.desktop às 16:12:16 (9s após o login)
# e o dono CLICOU no "Install Archcraft" às 16:12:21 — o elite-firstboot
# só removeria os atalhos às 16:14:4x, DEPOIS do graphical.target +
# network-online (a lei v2.10.7: o desktop nunca é refém do firstboot).
# A janela de corrida durou ~2min30s e o clique executou o wrapper morto.
#
# CURA: a varredura roda ANTES do display-manager (SDDM) — nenhum menu
# enxerga atalho de instalador num sistema que já está instalado. O
# elite-tune --firstboot continua como 2ª camada (ele remove o PACOTE
# calamares inteiro; este sweep remove os ATALHOS órfãos mesmo sem rede).
#
# Regras: live (/run/archiso) NUNCA toca — o instalador é legítimo lá;
# cada remoção nomeia o arquivo (o journal é a evidência).
# E106 — O PURGE DO CACHE SAI DO GATE (o dump 20261112 + o journal do
# drawer: "Cannot load icon 'calamares' for 'Install Archcraft'" no rig do
# dono HOJE, com firstboot-done CRAVADO desde 3/nov): o sweep inteiro era
# 1× (o gate do firstboot o matava para sempre) — e a dose do elite-system
# REINSTALAVA o calamares.desktop por cima (--overwrite applications/*, a
# varredura E98 embalava o fóssil). Fantasma ressuscitado + cache que
# nunca mais purgava = o 'Starchcraft' que o dono viu nascer do nada.
# A cura tem duas mãos: o build SAI de embalar o fantasma (E106 no
# build.sh + elite-post-transaction o remove dos rigs) e AQUI o purge do
# cache da gaveta roda em TODA varredura — incondicional do firstboot.
set -eu

if [ -e /run/archiso ]; then
    exit 0   # live: o instalador é o quebra-vento da ISO — intocado
fi

# E106 — o PURGE DO CACHE vem PRIMEIRO e roda SEMPRE (o gate do firstboot
# não o segura mais: o cache podre de uma era antiga morre em qualquer
# varredura — barato, idempotente, honesto).
for c in /home/*/.cache/nwg-drawer/cache.db; do
    [ -f "$c" ] || continue
    if grep -aq calamares "$c" 2>/dev/null; then
        rm -f -- "$c"
        echo "elite-sweep: cache do drawer purgado (listava calamares): $c"
    fi
done

if [ -e /var/lib/elite/firstboot-done ]; then
    exit 0   # firstboot concluído: a varredura dele já cobriu os atalhos
fi

removed=0
for f in \
    /usr/share/applications/calamares.desktop \
    /usr/local/share/applications/calamares.desktop \
    /usr/share/applications/abif.desktop \
    /usr/local/share/applications/abif.desktop
do
    if [ -e "$f" ]; then
        rm -f -- "$f"
        removed=$((removed + 1))
        echo "elite-sweep: atalho do instalador removido: $f"
    fi
done

# o wrapper de log (o Exec do atalho) morre junto — clique sem alvo não
# executa coisa nenhuma
if [ -e /usr/local/bin/calamares-elite-log ]; then
    rm -f -- /usr/local/bin/calamares-elite-log
    echo "elite-sweep: wrapper removido: /usr/local/bin/calamares-elite-log"
fi

# cache do nwg-drawer que listou o fantasma: re-indexa limpo na 1ª abertura
for c in /home/*/.cache/nwg-drawer/cache.db; do
    [ -f "$c" ] || continue
    if grep -aq calamares "$c" 2>/dev/null; then
        rm -f -- "$c"
        echo "elite-sweep: cache do drawer purgado (listava calamares): $c"
    fi
done

echo "elite-sweep: concluído ($removed atalho(s) de instalador removidos)"
exit 0
