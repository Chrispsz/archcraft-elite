#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-menu (v3.0 — O MOTOR QUE JÁ ABRIA, v2.4.0)
# ═══════════════════════════════════════════════════════════════════════════
# A HONESTIDADE PRIMEIRO: o motor GTK do menu (v2.3.8 nativo → v2.3.11
# "gaiola") NUNCA abriu no rig do dono — o dono clicava e nada aparecia,
# duas reescritas, dois funerais. A v3 troca o motor pelo ÚNICO com prova
# de vida na máquina real: o FUZZEL — o launcher e o menu de Sessão
# sempre abriram, filtraram e fecharam nele, e a cura v2.3.6
# (keyboard-focus=on-demand) provou o clique-fora-fecha NO RIG do dono.
#
# POR QUE ESTA CLASSE DE FALHA ESTÁ EXTINTA POR CONSTRUÇÃO:
#   · ZERO GTK, ZERO layer-shell, ZERO corrida de foco para EXISTIR — o
#     compositor mapeia o layer do fuzzel sem depender de nada (a v1
#     morria ANTES do 1º frame; isso aqui não tem esse código);
#   · toggle e cross-dismiss viraram FÍSICA, não código: só existe um
#     teclado — abrir outro menu rouba o foco e o anterior FECHA SOZINHO
#     (exit-on-focus-loss=yes, agora CONTRATO explícito no fuzzel.ini;
#     o 2º clique no botão fecha — o que o burn test v1.4 do Sessão já
#     provou na prática);
#   · ESC = exit 1 com stderr vazio (a lei v2.3.6/v2.3.10 intacta:
#     fechar NUNCA é falha — o fuzzel cala no ESC desde o fix dos ';').
#
# A GRAMÁTICA DE SAÍDA (contrato com os 7 chamadores — intocado):
#   stdout: o item escolhido · exit 0
#   exit 1: fechado sem escolha (ESC / clique fora / foco perdido) — stderr vazio
#   exit 2: (aposentado) o toggle virou física do compositor — os
#           chamadores tratam 2 como benigno e o ramo fica dormente
#   143:    morto por SIGTERM (cross-dismiss)
#   outros: falha REAL — o stderr segue vivo até o chamador (log + aviso
#           que SOME).
#
# O TÍTULO: vive no prompt do fuzzel — contexto + filtro por digitação
# (começar a digitar já navega a lista). O preço honesto de abrir SEMPRE.
#
# Uso: craft-menu --title=TÍTULO item1 [item2 …]   (ou itens por STDIN —
# a interface dmenu: 1 linha = 1 item, listas dinâmicas sem eval)
# ═══════════════════════════════════════════════════════════════════════════
set -u

command -v fuzzel >/dev/null 2>&1 || {
    printf 'craft-menu: fuzzel ausente (pacote fuzzel)\n' >&2
    exit 127
}

title="Menu"
list=""
sep=""
for a in "$@"; do
    case "$a" in
        --title=*) title="${a#--title=}" ;;
        *)
            list="$list$sep$a"
            sep="
"
            ;;
    esac
done
# itens alternativos por STDIN (a interface dmenu — listas DINÂMICAS
# como os processos vivos e os snapshots passam por pipe, sem eval e
# sem word-splitting no chamador: shellcheck limpo por construção)
if [ -z "$list" ] && [ ! -t 0 ]; then
    list="$(cat)"
fi
# linhas vazias fora (a v2 as descartava; o contrato é o mesmo)
list="$(printf '%s\n' "$list" | sed '/^[[:space:]]*$/d')"
[ -n "$list" ] || exit 0

choice="$(printf '%s\n' "$list" | fuzzel --dmenu --prompt "$title: ")"
rc=$?
[ -n "$choice" ] || exit "$rc"
printf '%s\n' "$choice"
exit 0
