#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# craft-compress — O VERBO "COMPRIMIR…" DO EXPLORADOR (E35)
# ───────────────────────────────────────────────────────────────────────────
# E35 — o dono tentou compactar VÁRIOS arquivos em UM só pelo Thunar e não
# conseguiu: o "Criar Arquivo…" (thunar-archive-plugin + xarchiver, v2.8.0)
# abre o fluxo do xarchiver, que NÃO é o que o usuário espera (diálogo de
# gerenciador, não de compactar a seleção). Cura: o verbo da CASA —
# seleciona tudo → clique-direito → "Comprimir…" → UM diálogo (nome +
# formato) → UM arquivo ao lado da seleção → notificação. O backend é o
# 7zip que JÁ está na ISO desde a v1.1 (zip E 7z são nativos dele; o
# tar.xz é do tar da base) — ZERO pacote de compressão novo. O xarchiver
# FICA para abrir e extrair arquivos existentes (aí ele é bom); CRIAR é
# trabalho do craft.
#
# NOTA 7z: exit 1 = WARNING (arquivo criado, algum item travado — ex.:
# permissão) → SUCESSO com o aviso no log; exit ≥ 2 = falha de verdade.
# Tratar 1 como falha apagaria um arquivo BOM — a suíte crava isso.
#
# E42 — O VERBO QUE MORRIA EM TODA ISO: o dono apertou Comprimir… e 'não
# aconteceu nada' (04/nov). Raiz cravada: o dep-check exigia o binário
# '7z', mas o pacote '7zip' do Arch entrega '7zz' — e o PRÓPRIO repo sabia
# desde a v2.3.0 (e96bec4: qemu-boot-test.sh:24 'Arch: pacote 7zip fornece
# 7zz; Ubuntu/CI: p7zip-full fornece 7z'). O sandbox/CI tem 7z (p7zip-full),
# a ISO não: os '6 testes com zip REAL' e os greps da porteira provavam o
# TEXTO, nunca a ISO — a classe E35.1 de novo (o sandbox mente, o CI não vê
# a ISO). Segunda ferida do mesmo tiro: o '|| exit 0' do diálogo tratava
# QUALQUER falha do zenity como 'Cancelar' — crash saía calado. Cura em
# três mãos: (1) o resolver do qemu-boot-test entra aqui (7z OU 7zz); (2) a
# dica de cura cita o pacote CERTO (7zip, não 7z); (3) rc do zenity PROVADO
# no fonte oficial (util.c:45-53: OK=0 · CANCEL/ESC=1 · ERROR=-1→255) —
# rc=1 é o dono desistindo (sai calado, com linha no log); rc≠0/1 vira die
# com o stderr capturado. Erro nunca mais calado — lei da casa.
#
# uso:      craft-compress ARQUIVO… [ARQUIVO… DIR…]   (%F do uca.xml — a
#           multi-seleção inteira chega como argumentos separados)
# frontend: uca.xml do Thunar (skel) — "Comprimir…" no menu de contexto
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

LOG_DIR="$HOME/.cache/elite"
LOG="$LOG_DIR/compress.log"

# evidência append-only (mesma política da dock — nada calado, nada falso)
# %b: as mensagens de diálogo falam em \n (o zenity interpreta) — o log
# também (a evidência se lê, não se decifra)
log() {
    mkdir -p "$LOG_DIR"
    # E36 — a lei do teto vale para TODA a família (bars 1 MiB, audio 256 KiB,
    # menus 256 KiB): o compress.log nasceu append-only sem teto — a peça
    # nova não pode nascer fora da lei. Teto 256 KiB, poda pela metade.
    if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
    fi
    printf '%s %b\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"
}

# ── o erro NUNCA é calado (lei da casa): diálogo para o usuário, log para a
# evidência. Uso: die "título" "mensagem longa"
die() {
    log "FALHA: $1 — $2"
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="$1" --text="$2" 2>/dev/null || true
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "$1" "$2" >/dev/null 2>&1 || true
    fi
    exit 1
}

# ── dependências: declaradas no packages.add, guardas aqui (o binário
# fantasma não existe — quem chama fora do Thunar recebe o caminho de cura)
# E42 — o motor se RESOLVE (7z OU 7zz): o '7z' exigido a fio morria em toda
# ISO da casa (o pacote 7zip entrega 7zz — qemu-boot-test.sh:24, e96bec4).
SEVENZ="$(command -v 7z || command -v 7zz || true)"
[[ -n "$SEVENZ" ]] ||
    die "craft-compress" "O motor 7-Zip não está instalado.\nNo terminal: sudo pacman -S 7zip"
for bin in zenity tar; do
    command -v "$bin" >/dev/null 2>&1 ||
        die "craft-compress" "O programa '$bin' não está instalado.\nNo terminal: sudo pacman -S $bin"
done

# ── a seleção: o uca.xml manda %F (um argumento por item selecionado) ──
if [[ $# -eq 0 ]]; then
    die "craft-compress" "Nenhum arquivo selecionado.\nSelecione os itens no explorador e use Comprimir… de novo."
fi
N_ITENS=$#

# destino = a pasta do 1º item (onde a seleção mora); tudo vira UM arquivo lá
dest_dir="$(dirname -- "$1")"
if [[ ! -w "$dest_dir" ]]; then
    die "Sem permissão de escrita" "A pasta '$dest_dir' não aceita novos arquivos.\nComprima para uma pasta sua (ex.: Downloads)."
fi

# ── nome sugerido: 1 item = o nome dele; vários = "<pasta>-compactado" ──
if [[ $N_ITENS -eq 1 ]]; then
    sugestao="$(basename -- "$1")"
else
    sugestao="$(basename -- "$dest_dir")-compactado"
fi

# ── O DIÁLOGO ÚNICO: formato + nome, do jeito que o usuário espera ──
# E42 — rc provado no fonte oficial (util.c:45-53): 0=OK · 1=Cancelar/ESC ·
# -1→255=ERRO. O '|| exit 0' antigo tratava QUALQUER falha como Cancelar —
# um crash do diálogo saía calado (o dono apertava e NADA). Agora: rc=1 é o
# dono desistindo (sai calado, com a linha no log); rc≠0/1 vira die com o
# stderr capturado — erro nunca mais calado (lei da casa).
formerr=$(mktemp)
frc=0
form=$(zenity --forms --title="Comprimir" \
    --text="Compactar $N_ITENS item(ns) em um único arquivo" \
    --add-combo="Formato" \
    --combo-values="zip (universal — abre em qualquer lugar)|7z (comprime mais)|tar.xz (nativo Linux)" \
    --add-entry="Nome do arquivo (sem extensão)" \
    --entry-text="$sugestao" \
    --separator="|" 2>"$formerr") || frc=$?
if [[ "$frc" -ne 0 ]]; then
    cauda=$(tail -3 "$formerr" 2>/dev/null | tr '\n' ' ' | cut -c1-300)
    rm -f "$formerr"
    if [[ "$frc" -eq 1 ]]; then
        log "cancelado: o dono fechou o diálogo (rc=1)${cauda:+ | stderr: $cauda}"
        exit 0    # Cancelar = mudou de ideia: sai calado, sem meia-work
    fi
    die "Comprimir" "O diálogo de compressão não abriu (zenity rc=$frc).\n${cauda:-sem stderr do zenity}\n\nA prova completa fica no log: $LOG"
fi
rm -f "$formerr"

fmt="${form%%|*}"
nome="${form#*|}"
nome="${nome//\//-}"        # barra não é nome de arquivo
nome="${nome//|/-}"         # nem separador do próprio formulário
nome="${nome#"${nome%%[![:space:]]*}"}"   # trim à esquerda (SÓ trim — o
nome="${nome%"${nome##*[![:space:]]}"}"   # resto do nome é do usuário)
[[ -z "$nome" ]] && nome="$sugestao"      # apagou o campo? o sugerido salva

case "$fmt" in
    zip*)     alvo="$dest_dir/$nome.zip" ;;
    7z*)      alvo="$dest_dir/$nome.7z" ;;
    tar.xz*)  alvo="$dest_dir/$nome.tar.xz" ;;
    *)        die "Comprimir" "Formato desconhecido: '$fmt'" ;;
esac

# ── colisão: o arquivo existente NUNCA morre sem pergunta ──
if [[ -e "$alvo" ]]; then
    zenity --question --title="Comprimir" \
        --text="O arquivo '$(basename -- "$alvo")' já existe nesta pasta.\nSubstituir?" \
        2>/dev/null || { log "cancelado: $(basename -- "$alvo") já existe (não substituído)"; exit 0; }
    rm -f -- "$alvo"
fi

# ── o motor: 7z fala zip E 7z; tar.xz é do tar (xz é da base) ──
logf=$(mktemp)
rcf="$logf.rc"
trap 'rm -f "$logf" "$rcf"' EXIT
if [[ "$alvo" == *.tar.xz ]]; then
    # E36 — SIMETRIA DO TAR (audit de arquitetura): tar rc=1 = 'file changed
    # as we read it' (item escrito durante a compactação — cenário real de
    # download/log) COM arquivo BOM criado: tratar como falha APAGAVA um
    # tar.xz bom — a mesma lição do 7z rc=1 (E35) que não tinha sido
    # espelhada aqui. E o `--` que o 7z já tinha: um arquivo começando com
    # '-' era engolido como opção do tar. rc ≥ 2 = erro de verdade.
    motor=(tar -cJvf "$alvo" -- "$@")
    rc_ok=1
else
    motor=("$SEVENZ" a -bd -bso0 -bsp0 -- "$alvo" "$@")   # E42: binário RESOLVIDO
    rc_ok=1                    # 7z/7zz: 0 OU 1 (warning) = arquivo criado
fi
motor_name="$(basename -- "${motor[0]}")"   # E42: o log nomeia o motor REAL (tar ≠ 7zz)
log "comprimir: $N_ITENS item(ns) → $(basename -- "$alvo") (motor: $motor_name)"
( "${motor[@]}" >"$logf" 2>&1; echo $? >"$rcf" ) &
bgpid=$!

# janela de progresso: pulsa até o motor terminar; fechar = cancelar
( while kill -0 "$bgpid" 2>/dev/null; do
      echo "#Compactando $N_ITENS item(ns) em $(basename -- "$alvo")…"
      sleep 0.3
  done
  echo 100 ) | zenity --progress --title="Comprimir" --pulsate --auto-close \
      --text="Compactando…" 2>/dev/null &
zpid=$!
wait "$zpid" 2>/dev/null || true

if kill -0 "$bgpid" 2>/dev/null; then
    # a janela de progresso fechou antes do fim = o usuário cancelou
    pkill -P "$bgpid" 2>/dev/null || true
    kill "$bgpid" 2>/dev/null || true
    wait "$bgpid" 2>/dev/null || true
    rm -f -- "$alvo"
    log "cancelado no meio: $(basename -- "$alvo") (parcial apagado)"
    exit 0
fi
wait "$bgpid" 2>/dev/null || true
rc="$(cat "$rcf" 2>/dev/null || echo 99)"

if [[ "$rc" -gt "$rc_ok" ]]; then
    rm -f -- "$alvo"    # parcial não fica entulhando a pasta
    cauda=$(tail -5 "$logf" 2>/dev/null | tr '\n' ' ' | cut -c1-300)
    die "Falhou ao compactar" "O '$(basename -- "$alvo")' não nasceu.\n$cauda\n\nO arquivo parcial foi apagado — tente de novo ou troque o formato."
fi

if [[ "$rc" == "1" ]]; then
    # WARNING do motor: o arquivo NASCEU, mas houve item travado — a prova
    # no log (7z = item não compactado; tar = 'file changed as we read it')
    log "AVISO ${motor[0]} (rc=1): $(tail -3 "$logf" | tr '\n' ' ')"
fi

# ── vitória: notificação com o tamanho real (o usuário vê o resultado) ──
tamanho=$(du -h -- "$alvo" | cut -f1)
log "OK: $(basename -- "$alvo") ($tamanho, $N_ITENS itens)"
if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 3000 "Compactado" \
        "$(basename -- "$alvo") criado ($tamanho)" \
        -i package-x-generic >/dev/null 2>&1 || true
fi
