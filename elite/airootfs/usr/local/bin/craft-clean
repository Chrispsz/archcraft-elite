#!/usr/bin/env bash
# craft-clean — limpeza do sistema (v4 — E114)
# ═══════════════════════════════════════════════════════════════════════
# v1: cache do pacman, órfãos e journal.
# v2 (E88 — a diretriz do dono: "mexe no limpeza"): a limpeza deixa de ser
# três comandos mudos e vira UM relatório honesto, rápido e sem sustos:
# TAMANHOS ANTES/DEPOIS, LIXEIRA, FLATPAK órfãos, MODO --yes, pausa final.
# v3 (E107 — o 'bem completinho' do dono: "um script de limpeza que faz
# uma limpeza realmente aprofundada… que limpa cache do octopi, todos
# os pacotes, versões antigas que não estão sendo mais usadas, pacotes
# mortos"): os CACHES DE USUÁRIO que nenhum passo cobria entram com
# tamanho medido no relatório — octopi (o gerenciador da casa deixa
# cache de ícones/imports), yay (build dirs de AUR — a loja de fábrica
# E97) e thumbnails (miniaturas de vídeo/foto órfãs). O relatório
# soma tudo que saiu, com a fonte de cada número.
# v4 (E114 — o papel 183150 + o relato do dono: 'eu clico e não abre
# nada… ele tenta até abrir uma tela, mas ele não executa uma limpeza no
# sistema realmente'): DUAS curas. (1) O MODO ROOT HONESTO: sudo dentro
# de terminal exigia senha no ESCURO do prompt (a parede invisível que
# o dono abandonava) — o item do menu agora PEDE RAIZ pelo polkit
# GRÁFICO (pkexec, o diálogo que o dono já conhece do octopi) e este
# script roda como root COM O HOME DO DONO (a lixeira certa, os caches
# do usuário certos, zero sudo no escuro). (2) O PRÊMIO REAL: o cache do
# BRAVE (1,6 GB no papel — o MAIOR do disco) entra na varredura, só com
# o navegador fechado e só os regeneráveis (Cache/Code Cache/GPUCache).
# A ordem importa: tudo que só LÊ vem antes; o que DESTRÓI pede raiz —
# sudo falho = passo pulado COM aviso (nunca morte calada).
# v5 (E115 — o clean.log do dump 224713 conta CINCO 'iniciado' e ZERO
# 'fim' — o dono fechou a janela no meio (o paccache num cache grande
# leva até 1 min e a tela parecia parada) e a perícia só tinha a
# abertura): cada passo deixa linha ANTES de correr (o trace sobrevive
# à morte no meio — o papel mostra ONDE estava quando a janela fechou);
# a abertura nomeia uid/HOME (o modo pkexec fica no papel: raiz com o
# home do dono é legível, não presumido); e o passo pesado AVISA que é
# pesado (o relógio de parede no papel também — o 'não abre' era o
# passo lendo o disco calado).
# ═══════════════════════════════════════════════════════════════════════
set -euo pipefail

# E109 — O PAPEL DA LIMPEZA (a denúncia do dono no dump 181701: 'limpeza
# do sistema também não funciona' — e a casa NÃO TINHA UM LOG para
# julgar: o item rodava no foot -e e morria sem rastro nenhum; nem a
# perícia do dump achava a execução). Cada passo deixa linha com rc —
# 'não funciona' vira réu nomeado no papel (a lei E33 no último irmão).
# Teto 256 KiB — a lei da família E36.
CLEAN_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/clean.log"
clog() {
    mkdir -p "${CLEAN_LOG%/*}" 2>/dev/null || true
    if [ -f "$CLEAN_LOG" ] && [ "$(wc -c <"$CLEAN_LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -c 131072 "$CLEAN_LOG" > "$CLEAN_LOG.tmp" 2>/dev/null && mv -f "$CLEAN_LOG.tmp" "$CLEAN_LOG" || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$CLEAN_LOG" 2>/dev/null || true
    return 0
}

ASSUME_YES=0
MENU_HOLD=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    menu) MENU_HOLD=1 ;;
    -h|--help) printf 'uso: craft-clean [--yes|menu] — a limpeza honesta (o que sai, quanto saiu — E88)\n\n'; sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "craft-clean: arg desconhecido: $arg (use --yes)" >&2; exit 2 ;;
  esac
done

# E110 — O MENU SEGURA O PAPEL (o dono, dump 114852: 'limpeza do sistema,
# ele tenta abrir uma tela que fecha na hora, terminal') — o modo `menu`
# pausa INCONDICIONAL no fim: o terminal do menu nunca fecha antes do
# Enter, MESMO que um passo morra no meio (o read do modo interativo
# exigia TTY em stdin/stdout — qualquer lançamento sem os dois e o relatório
# virava flash de novo). O CLI manual mantém a pausa TTY de sempre.

_modo="interativo"
[ "$ASSUME_YES" = 1 ] && _modo="--yes"
[ "$ASSUME_YES" != 1 ] && [ "$MENU_HOLD" = 1 ] && _modo="menu"
# E115 — a abertura fala QUEM corre: uid e HOME no papel (o modo pkexec
# é raiz com o home do dono — o dono do papel vê a física, não presume)
clog "═══ craft-clean iniciado (TTY: $([ -t 0 ] && echo sim || echo não) · modo: $_modo · uid: $(id -u) · HOME: ${HOME:-?})"

# E118 — A TESTEMUNHA DA PORTA (o papel 210305: dois 'iniciado' uid 1000
# — e NENHUMA porta da casa corre craft-clean como usuário: o item do
# menu é pkexec→raiz — o papel não dizia de ONDE o clique veio). O pai
# entra na abertura: a próxima corrida NOMEIA a porta dela (fuzzel,
# menu, terminal, .desktop — o réu da porta se entrega no papel).
_ppid="$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')"
[ -n "$_ppid" ] && _pai="$(tr '\0' ' ' </proc/"$_ppid"/cmdline 2>/dev/null | cut -c1-100)" || _pai='(pai já saiu)'
clog "porta: ppid=$_ppid pai: ${_pai:-?}"

# E118 — A MORTE DEIXA TESTEMUNHO (a mesma escola do E115 — 'o trace
# sobrevive à morte no meio' — agora vale TAMBÉM para a morte que
# acontece ANTES do primeiro passo): o trap registra qualquer saída que
# não passou pelo 'fim:' — papel sem cabeçalho órfão nunca mais.
_sem_fim=1
# E118-corrige — o rc NÃO viaja em variável (SC2154 no shellcheck 0.11 do
# CI: o rc=$? dentro da string do trap não conta como atribuição) — o $? 
# direto diz o mesmo número e o réu morre.
trap 'if [ "${_sem_fim:-0}" = 1 ]; then clog "MORTE no meio (rc=$? — set -e, kill ou janela fechada): o último passo antes da morte é o último passo logado acima"; fi' EXIT

# E118 — O BOTÃO NÃO EMPILHA CORRIDAS (o papel 210305: dois 'iniciado'
# a 2s — duas corridas concorrentes brigam pelo mesmo paccache): flock
# no dir do papel (o MESMO arquivo para a porta usuário e a pkexec — o
# HOME viaja em ambas); a segunda corrida SAIR com testemunho.
if exec 9>>"${CLEAN_LOG%/*}/clean.lock" 2>/dev/null && command -v flock >/dev/null 2>&1; then
  if ! flock -n 9; then
    _sem_fim=0
    clog "saiu: já há uma limpeza a correr — este clique não empilha (a corrida viva é a dona do papel)"
    echo "  (já há uma limpeza a correr — esta janela sai; a corrida viva segue no comando dela)"
    exit 0
  fi
fi

PKG_CACHE="/var/cache/pacman/pkg"
cache_mib() {
  # E118 — A MEDIDA NÃO MATA: a v5 media o cache no top-level com
  # set -euo pipefail — um du que falha (rc≠0 sob pipefail) matava o
  # script ENTRE a abertura e o primeiro passo (o papel 210305: DOIS
  # 'iniciado' e ZERO trace — a janela cega entre as linhas 79 e 108).
  # Hoje a medida falha e devolve 0 — o papel segue e o fim mostra o
  # 0→0 honesto (a medida ruim não vale uma morte calada).
  local m=''
  if [[ -d "$PKG_CACHE" ]]; then
    m="$(du -sm "$PKG_CACHE" 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '%s\n' "${m:-0}"
}
antes="$(cache_mib)"
step() { printf '\n==> %s\n' "$*"; }
skipped() { printf '   (pulado: %s — sudo indisponível/sem TTY; nada quebrou)\n' "$*" >&2; }

srun() {
  # sudo que NÃO mata o script: sem root/TTY o passo é pulado com aviso
  if (( EUID == 0 )); then "$@"; return 0; fi
  if command -v sudo >/dev/null 2>&1 && [[ -t 0 || ${ASSUME_YES} -eq 1 ]]; then
    sudo "$@"
  else
    return 127
  fi
}

step "cache: mantendo 2 versões (paccache -rk2)"
# E115 — O PASSO FALA ANTES DE CORRER (o clean.log do dump só tinha a
# abertura: o dono fechava a janela no meio do paccache silencioso e o
# papel não contava o porquê). Cache grande = até 1 min de leitura de
# disco — o aviso DIZ isso na tela e no papel.
clog "passo: paccache -rk2 iniciado (cache grande pode levar até 1 min)"
echo "   (o paccache lê o cache inteiro — cache grande leva até 1 min)"
if srun paccache -rk2 2>/dev/null; then
  clog "paccache -rk2: OK"
else
  _prc=$?
  clog "paccache -rk2: PULADO (rc=$_prc — pacman-contrib ausente? sudo recusado? a adoção do craft-update traz o pacote; 'sudo pacman -S pacman-contrib' cura à mão)"
  skipped "paccache (instale pacman-contrib)"
fi
srun paccache -ruk1 2>/dev/null && clog "paccache -ruk1: OK" || clog "paccache -ruk1: pulado"

step "órfãos (pacman -Qtdq)"
orphans="$(pacman -Qtdq 2>/dev/null || true)"
if [[ -n "$orphans" ]]; then
  echo "$orphans" | sed 's/^/  /'
  clog "órfãos achados: $(echo "$orphans" | tr '\n' ' ')"
  if (( ASSUME_YES == 1 )); then
    srun pacman -Rns --noconfirm $orphans || skipped "remoção dos órfãos"
    clog "órfãos: removidos (--yes)"
  else
    # v2.10.6 — EOF/set -e NÃO MATA CALADO (a lei do craft-idle v2.10.5
    # chegando ao último irmão): rodar de script/pipe sem TTY matava o
    # craft-clean no read ANTES do vacuum do journal — morte silenciosa.
    read -r -p "remover todos? [s/N] " ans || ans=''
    if [[ "${ans,,}" == "s" ]]; then
      srun pacman -Rns --noconfirm $orphans || skipped "remoção dos órfãos"
      clog "órfãos: removidos (escolha do dono no TTY)"
    else
      echo "  (órfãos mantidos — escolha do usuário no papel)"
      clog "órfãos: mantidos (escolha do usuário)"
    fi
  fi
else
  echo "  nenhum órfão (o sistema já está limpo desta praga)"
  clog "órfãos: nenhum"
fi

step "lixeira do desktop"
# E114 — O MODO pkexec É ROOT COM O HOME DO DONO: o gio como root opera a
# lixeira do ROOT — a do dono ficava de pé. Com HOME do usuário no bolso
# (o item do menu passa HOME= via pkexec env), a lixeira certa é
# esvaziada direto; o caminho de sessão (gio) segue como sempre.
if [ "$(id -u)" = "0" ] && [ -n "${HOME:-}" ] && [ -d "$HOME/.local/share/Trash" ]; then
  rm -rf -- "$HOME/.local/share/Trash/files" "$HOME/.local/share/Trash/info" 2>/dev/null || true
  echo "  lixeira esvaziada (modo pkexec: a lixeira do dono)"
elif command -v gio >/dev/null 2>&1; then
  gio trash --empty 2>/dev/null && echo "  lixeira esvaziada" || echo "  lixeira já vazia (ou sem acesso — nada quebrou)"
else
  echo "  (gio ausente — pulado)"
fi

# E107 — OS CACHES DE USUÁRIO (o 'bem completinho'): cada um medido ANTES,
# varrido e contado no relatório final. Todos são ~/.cache — domínio do
# usuário, zero sudo, tudo regenerável por desenho (índices e miniaturas
# reconstroem sozinhos no uso; o build do yay refaz no próximo -S).
step "octopi: cache do gerenciador"
lib_user=0
if [ -d "$HOME/.cache/octopi" ]; then
  mib="$(du -sm "$HOME/.cache/octopi" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/octopi"/* 2>/dev/null || true
  echo "  $mib MiB varridos (ícones/imports antigos — reconstroem no uso)"
  lib_user=$((lib_user + mib))
else
  echo "  (sem cache do octopi — nada a fazer)"
fi

step "yay: cache de build do AUR"
if [ -d "$HOME/.cache/yay" ]; then
  mib="$(du -sm "$HOME/.cache/yay" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/yay"/* 2>/dev/null || true
  echo "  $mib MiB varridos (fontes/pkgbuilds de builds passados — o próximo -S baixa de novo)"
  lib_user=$((lib_user + mib))
else
  echo "  (sem cache do yay — nada a fazer)"
fi

step "thumbnails: miniaturas órfãs"
if [ -d "$HOME/.cache/thumbnails" ]; then
  mib="$(du -sm "$HOME/.cache/thumbnails" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/thumbnails"/* 2>/dev/null || true
  echo "  $mib MiB varridos (miniaturas de mídia — reconstroem na navegação)"
  lib_user=$((lib_user + mib))
else
  echo "  (sem thumbnails — nada a fazer)"
fi

# E114 — O PRÊMIO QUE A LIMPEZA NUNCA PEGOU (o papel da seção 14 do dump
# 183150: o cache do Brave era o MAIOR cache do disco — 1,6 GB — e nenhum
# passo o tocava; o dono: 'ele tenta até abrir uma tela, mas ele não
# executa uma limpeza no sistema realmente'). Seguro por desenho: SÓ com
# o navegador fechado (pgrep nomeado no papel quando aberto) e SÓ os
# caches regeneráveis (Cache/Code Cache/GPUCache) — senhas, histórico e
# extensões moram em OUTROS arquivos do perfil: nada deles sai.
step "Brave: cache do navegador (o maior prêmio do disco)"
clog "passo: cache do Brave iniciado (checa navegador vivo antes de tocar)"
if pgrep -x brave >/dev/null 2>&1; then
  echo "  (Brave está ABERTO — pulado: feche o navegador e rode a limpeza de novo)"
  clog "Brave cache: PULADO (o navegador está vivo)"
elif [ -d "$HOME/.cache/BraveSoftware" ]; then
  mib="$(du -sm "$HOME/.cache/BraveSoftware" 2>/dev/null | awk '{print $1}')"
  mib="${mib:-0}"
  rm -rf -- "$HOME/.cache/BraveSoftware"/Brave-Browser/*/Cache \
            "$HOME/.cache/BraveSoftware"/Brave-Browser/*/Code*Cache \
            "$HOME/.cache/BraveSoftware"/Brave-Browser/*/GPUCache 2>/dev/null || true
  echo "  $mib MiB avaliados (Cache/Code Cache/GPUCache varridos — o perfil intacto; reconstroem no uso)"
  lib_user=$((lib_user + mib))
  clog "Brave cache: varrido (${mib} MiB avaliados — só os caches regeneráveis)"
else
  echo "  (sem cache do Brave — nada a fazer)"
  clog "Brave cache: ausente"
fi

step "flatpak: runtimes órfãos"
if command -v flatpak >/dev/null 2>&1; then
  if (( ASSUME_YES == 1 )); then
    flatpak uninstall --unused -y 2>/dev/null || echo "  (nada a remover ou sem sessão — pulado)"
  else
    flatpak uninstall --unused 2>/dev/null || echo "  (nada a remover ou sem sessão — pulado)"
  fi
else
  echo "  (flatpak ausente — pulado)"
fi

step "journal: retendo 2 semanas"
srun journalctl --vacuum-time=2weeks || skipped "journalctl --vacuum"

depois="$(cache_mib)"
liberado=$(( antes - depois ))
(( liberado < 0 )) && liberado=0
_sem_fim=0
clog "fim: cache do pacman ${antes}→${depois} MiB · caches de usuário: ${lib_user} MiB · total liberado: $((liberado + lib_user)) MiB"
printf '\n✔ limpo. cache do pacman: %s MiB → %s MiB (liberado: %s MiB)\n' "$antes" "$depois" "$liberado"
printf '✔ caches de usuário (octopi/yay/thumbnails): %s MiB liberados (a fonte de cada número acima do passo dele)\n' "$lib_user"
# E96 — O RELATÓRIO NÃO SOME (o relato do dono: "o botão de limpeza do
# menu do sistema não funciona" — o item existia, o foot -e fechava na
# hora e o dono via um flash sem conteúdo; e o passo principal vivia
# pulado sem o paccache do pacman-contrib, que entra na ISO neste
# commit). Interativo = pausa honesta: o dono LÊ o que a limpeza fez.
# E110 — o modo `menu` (a ordem do dono no dump 114852) pausa SEM EXIGIR
# de TTY: o terminal do menu fica aberto até o Enter MESMO que um passo
# morra no meio — 'fecha na hora' extinto por construção.
if (( MENU_HOLD == 1 )); then
  read -r -p 'Enter para fechar… ' _ || true
elif (( ASSUME_YES == 0 )) && [[ -t 0 ]] && [[ -t 1 ]]; then
  read -r -p 'Enter para fechar… ' _ || true
fi
