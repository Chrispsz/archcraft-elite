#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-wake-guard (E122 → 1.0-107) — A POLÍTICA DO DESPERTAR
# ═══════════════════════════════════════════════════════════════════════════
# 1.0-107 — A POLÍTICA NOVA (a ordem do dono, palavra por palavra: "o PC
#   acordar sozinho logo após suspender" — o dongle 2.4G do rig expunha uma
#   interface HID de teclado FALSA e o gate de era E122/E139 ("teclado na
#   árvore do controlador arma o controlador") julgava o FINGIDOR como a
#   mão do dono: o XHC0 rearmava em todo boot e em todo pré-sono, o
#   elite-acpi-wakeup desarmava, o sono nascia com a porta aberta e o
#   dongle acordava a máquina num pigarro). A lei agora é a da diretriz:
#   "mantendo o despertar apenas pelo botão Power (e dispositivos
#   explicitamente desejados)":
#     · TODO dispositivo USB dorme (teclado incluso — o dongle fingidor
#       matou a exceção; a MÃO de verdade do dono é o botão do power e
#       o PS/2 de sempre — dongle nenhum finge ser PS2K);
#     · TODO controlador USB PCI (class 0x0c03) dorme — o elo ACPI dele
#       idem (ninguém REARMA o que o elite-acpi-wakeup desarma: as duas
#       leis da casa agora dizem a MESMA coisa);
#     · 1.0-107.2 — O ALLOWLIST UNIVERSAL acorda (desktop E notebook,
#       QUALQUER placa AMD/Intel): PWRB/PBTN (as duas grafias do botão
#       do power), SLPB (o botão de sleep físico), PS2K (teclado PS/2
#       — o dispositivo EXPLICITAMENTE desejado da E122, que dongle
#       nenhum consegue fingir) e LID (a tampa do notebook) — o cinto
#       ARMA o que o firmware entrega dormindo de fábrica;
#     · PS2M e TODO o resto do ACPI dorme; WoL segue morto POR FORÇA.
# 1.0-108 — A LEI PURA (a diretriz do dono: ler /proc/acpi/wakeup
#   DIRETAMENTE e alternar TODO *enabled FORA da allowlist para
#   *disabled — a lista FIXA de nomes (GP12/GP13/SWUS/SWDS/XHC*) morre
#   com os fora-da-lista acordados: qualquer nome que a placa imprimir
#   amanhã já nasce coberto; o PS2K ausente do hardware é pulo, nunca
#   erro) — A MESMA LEI do elite-acpi-wakeup e do craft-doctor (uma lei
#   só na casa).
#
# QUEM APLICA: a regra udev da casa (ISO: 90-elite-wake-guard.rules;
# pacote: /usr/lib/udev/rules.d/91-elite-wake-guard.rules — coldplug +
# hotplug) E a unit elite-wake-guard.service a CADA boot (`craft-wake-guard
# apply`) E o elite-daemon session a cada PrepareForSleep(true) — o gate é
# REAFIRMADO no limiar de cada sono (o dongle plugado depois não vira voz).
#
# Custo honesto: acordar o PC é apertar o botão do power (ou ter um
# teclado PS/2) — é EXATAMENTE o que a diretriz 1.0-107 pediu; o dongle
# sensível que acordava a mesa a cada vibrada morre com a porta fechada.
#
# Uso:
#   craft-wake-guard              = status (a vista da política agora)
#   craft-wake-guard apply        APLICA a política (varredura completa)
#   craft-wake-guard usb-apply P  gancho udev: um usb_device (por %p)
#   craft-wake-guard off|on       A MARRETA E24 (legado/resgate): desarma
#                                 ou arma TODA a família serial bus 0x0c0x
# WAKE_SYSFS / WAKE_ACPI (ambiente): raiz alternativa de /sys e /proc para
# PERÍCIA SEM RAIZ (os testes da suíte constroem a árvore falsa e julgam a
# decisão — a prova não precisa de kernel de verdade).
# ═══════════════════════════════════════════════════════════════════════════
set -u

PROG="${0##*/}"
S="${WAKE_SYSFS:-/sys}"
ACPI_TABLE="${WAKE_ACPI:-/proc/acpi/wakeup}"
# 1.0-108 — A MÃO DO DONO (a MESMA allowlist universal do
# elite-acpi-wakeup/craft-doctor — uma lei só na casa)
MANTEM_ALLOW="PWRB SLPB PBTN PS2K LID"
TEST_MODE=0
[ -n "${WAKE_SYSFS:-}" ] && TEST_MODE=1

usb_pci_ctrls() {
    # SÓ a classe USB 0x0c03 (a política é do despertar por USB — as
    # irmãs 0x0c00-0x0c07 não falam por teclado e a E24 as tocava por
    # excesso; a marreta `off` legada mantém a família inteira)
    for d in "$S"/bus/pci/devices/*; do
        [ -r "$d/power/wakeup" ] || continue
        cls="$(cat "$d/class" 2>/dev/null)"; cls="${cls:-0x000000}"
        case "$cls" in
            0x0c03*) echo "$d" ;;
        esac
    done
}

# 1.0-107 — O ELO ACPI do controlador ($1 = devpath) SEMPRE DORME (a
# política do teclado de era morreu — o dongle 2.4G fingia a mão do dono
# e o controlador rearmado abria a porta do sono a cada boot). O
# /proc/acpi/wakeup é TOGGLE — só escreve quando o estado atual é o
# CONTRÁRIO do pedido (o elo do controlador desarmado é silêncio).
_acpi_elo() {
    [ -f "$ACPI_TABLE" ] && [ "$TEST_MODE" -eq 0 ] || return 0
    local addr="pci:${1##*/}" aclinha aname
    aclinha="$(grep -m1 " $addr\$\| $addr " "$ACPI_TABLE" 2>/dev/null \
               || grep -m1 "$addr" "$ACPI_TABLE" 2>/dev/null || true)"
    aname="$(printf '%s' "$aclinha" | awk '{print $1}')"
    [ -n "$aname" ] || return 0
    if printf '%s' "$aclinha" | grep -q '\*enabled'; then
        if printf '%s' "$aname" > "$ACPI_TABLE" 2>/dev/null; then
            printf '  ACPI       DORME   %s (%s — o controlador USB não é porta de ninguém — 1.0-107)\n' "$aname" "$addr"
        fi
    fi
    return 0
}

set_wakeup() { # $1=arquivo power/wakeup  $2=valor → 0 se escreveu
    [ -f "$1" ] || return 1
    if [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
        return 0
    fi
    echo "$2" > "$1" 2>/dev/null
}

usb_apply_one() { # $1 = devpath (absoluto sob $S) — o gancho udev
    local dev="$1"
    [ -d "$dev" ] || return 0
    [ -f "$dev/power/wakeup" ] || return 0
    # 1.0-107 — TODO dispositivo USB dorme (teclado incluso: o dongle
    # 2.4G que fingia a mão do dono matou a exceção de era)
    set_wakeup "$dev/power/wakeup" disabled >/dev/null 2>&1 || true
    return 0
}

do_apply() {
    local n_off=0 n_ctrl=0 dev
    # (1) controladores USB PCI: TODOS dormem (o gate do teclado de era
    #     morreu — o dongle fingidor provou que a interface HID 01 não
    #     é prova de mão) + o elo ACPI de cada um dorme junto
    for dev in $(usb_pci_ctrls); do
        if set_wakeup "$dev/power/wakeup" disabled; then
            printf '  controlador DORME   %s (todo USB dorme — 1.0-107.2: despertar só na mão do dono)\n' "${dev##*/}"
        fi
        _acpi_elo "$dev"
        n_ctrl=$((n_ctrl + 1))
    done
    # (2) dispositivos USB: TODO o resto tem wakeup=disabled FORÇADO
    #     (o pré-sono do daemon reafirma — o hotplug não abre porta)
    for dev in "$S"/bus/usb/devices/*; do
        case "${dev##*/}" in *:*) continue ;; esac   # interfaces (:x.y) não são dispositivos
        [ -f "$dev/power/wakeup" ] || continue
        if set_wakeup "$dev/power/wakeup" disabled; then
            printf '  usb        dorme     %s (não é a mão do dono — disabled forçado — 1.0-107)\n' "${dev##*/}"
            n_off=$((n_off + 1))
        fi
    done
    # (3) 1.0-108 — ACPI: A LEI PURA (a diretriz do dono: ler a tabela
    #     DIRETAMENTE e alternar TODO *enabled FORA da allowlist para
    #     *disabled — GP12/GP13/SWUS/SWDS/XHC*/PTXH e QUALQUER nome novo
    #     que a placa imprimir; a lista fixa de nomes de era morreu com
    #     os fora-da-lista acordados). O cinto veste a OUTRA FACE no
    #     mesmo giro: o nome da allowlist presente e DORMINDO acorda (o
    #     firmware que entrega o botão *disabled de fábrica não rouba o
    #     despertar do dono); o PS2K AUSENTE do hardware é pulo, nunca
    #     erro (desktop USB-only — a MESMA lei do elite-acpi-wakeup e do
    #     craft-doctor).
    if [ -f "$ACPI_TABLE" ] && [ "$TEST_MODE" -eq 0 ]; then
        local _anome _aestado _ast _aresto _atog
        while read -r _anome _aestado _ast _aresto; do
            [ -n "${_anome:-}" ] || continue
            case "$_ast" in
                '*enabled')
                    case " $MANTEM_ALLOW " in
                        *" $_anome "*) continue ;;
                    esac
                    _atog="$_anome"
                    ;;
                '*disabled')
                    case " $MANTEM_ALLOW " in
                        *" $_anome "*) _atog="$_anome" ;;
                        *) continue ;;
                    esac
                    ;;
                *) continue ;;
            esac
            if printf '%s' "$_atog" > "$ACPI_TABLE" 2>/dev/null; then
                [ "$_ast" = '*enabled' ] \
                    && printf '  ACPI       dorme   %s (fora da mão do dono — a lei PURA 1.0-108)\n' "$_anome" \
                    || printf '  %-10s acorda (a allowlist da mão do dono — 1.0-108)\n' "$_anome"
            fi
        done <"$ACPI_TABLE" 2>/dev/null
    fi
    # (4) O SELO DO WoL MORTO POR FORÇA: a rede (WoL por sysfs E
    #     ethtool) NÃO desperta a máquina — o despertar é do botão do
    #     power e da mão do dono, de ninguém mais. Vale no apply de boot
    #     (a unit) e é re-julgado em cada pré-sono do daemon.
    if [ "$TEST_MODE" -eq 0 ]; then
        local _n _devw
        for _n in "$S"/class/net/*; do
            [ -d "$_n" ] || continue
            _devw="$(readlink -f "$_n/device/power/wakeup" 2>/dev/null)"
            if [ -f "$_devw" ] && set_wakeup "$_devw" disabled >/dev/null 2>&1; then
                printf '  rede       dorme    %s (WoL morto por sysfs — E139)\n' "${_n##*/}"
            fi
        done
        if command -v ethtool >/dev/null 2>&1; then
            for _n in "$S"/class/net/*; do
                [ -d "$_n" ] || continue
                ethtool -s "${_n##*/}" wol d >/dev/null 2>&1 || true
            done
        fi
    fi
    printf '  ── política aplicada: %d usb dorme · %d controlador(es) desarmado(s) · despertar = power/sleep/PS2K/LID (a lei PURA 1.0-108: todo *enabled fora da allowlist dorme)\n' "$n_off" "$n_ctrl"
    [ "$TEST_MODE" -eq 1 ] && printf '  (modo perícia WAKE_SYSFS=%s — nada real foi tocado)\n' "$S"
    return 0
}

do_status() {
    local dev cls
    printf '── A POLÍTICA (1.0-108 — a LEI PURA): TODO o USB dorme (teclado incluso — o dongle\n'
    printf '   matou a exceção de era); despertar SÓ na mão do dono UNIVERSAL — power (PWRB/PBTN),\n'
    printf '   sleep (SLPB), PS2K e LID (a tampa do notebook; dongle nenhum finge ser PS/2)\n'
    printf '── controladores USB PCI (todos dormem — o elo ACPI de cada um idem):\n'
    for dev in $(usb_pci_ctrls); do
        cls="$(cat "$dev/class" 2>/dev/null)"
        printf '  %-12s class=%s wakeup=%s (dorme — o elite-acpi-wakeup sela o elo ACPI)\n' "${dev##*/}" "$cls" "$(cat "$dev/power/wakeup" 2>/dev/null)"
    done
    printf '── dispositivos USB (todos dormem):\n'
    for dev in "$S"/bus/usb/devices/*; do
        case "${dev##*/}" in *:*) continue ;; esac
        [ -f "$dev/power/wakeup" ] || continue
        printf '  %-12s dorme (wakeup=%s)\n' "${dev##*/}" "$(cat "$dev/power/wakeup" 2>/dev/null)"
    done
    printf '── ACPI (a allowlist da mão do dono: PWRB/SLPB/PBTN/PS2K/LID — TODO o resto dorme):\n'
    grep -E '\*enabled' "$ACPI_TABLE" 2>/dev/null | sed 's/^/  /' \
        || printf '  (nenhuma armada — tudo desarmado)\n'
    printf '── mem_sleep (o modo que o hardware entrega)\n'
    printf '  %s\n' "$(cat "$S/power/mem_sleep" 2>/dev/null || echo '(sem mem_sleep)')"
}

do_set() { # $1 = enabled|disabled — A MARRETA LEGADA (família 0x0c0x inteira)
    local want="$1" dev n=0
    for d in "$S"/bus/pci/devices/*; do
        [ -r "$d/power/wakeup" ] || continue
        cls="$(cat "$d/class" 2>/dev/null)"; cls="${cls:-0x000000}"
        case "$cls" in
            0x0c03*|0x0c00*|0x0c01*|0x0c02*|0x0c04*|0x0c05*|0x0c06*|0x0c07*)
                if echo "$want" >"$d/power/wakeup" 2>/dev/null; then
                    printf '  wakeup=%-9s %s\n' "$want" "${d##*/}"
                    n=$((n + 1))
                fi ;;
        esac
    done
    [ "$n" -gt 0 ] || printf '  (nenhum controlador da família serial bus expôs wakeup)\n'
}

case "${1:-status}" in
    apply)
        [ "$TEST_MODE" -eq 1 ] || [ "$(id -u)" -eq 0 ] || { printf '%s: aplicar a política precisa root (sudo %s apply)\n' "$PROG" "$PROG" >&2; exit 1; }
        printf 'Aplicando a política do despertar (1.0-107.2 — todo USB dorme; despertar só na mão do dono: power/sleep/PS2K/LID):\n'
        do_apply
        ;;
    usb-apply)
        # o gancho da regra udev: silencioso por contrato (um gancho que
        # grita vira spam do udevd; falha aqui é cortesia, não desastre —
        # a varredura de boot refaz)
        usb_apply_one "${S}${2:-}" || true
        [ -d "${S}${2:-}" ] || usb_apply_one "${2:-}" || true
        exit 0
        ;;
    off)
        [ "$TEST_MODE" -eq 1 ] || [ "$(id -u)" -eq 0 ] || { printf '%s: desarmar precisa root (sudo %s off)\n' "$PROG" "$PROG" >&2; exit 1; }
        printf 'MARRETA LEGADA (E24): desarmando TODA a família serial bus (acordar = botão de power):\n'
        do_set disabled
        ;;
    on)
        [ "$TEST_MODE" -eq 1 ] || [ "$(id -u)" -eq 0 ] || { printf '%s: rearmar precisa root (sudo %s on)\n' "$PROG" "$PROG" >&2; exit 1; }
        printf 'MARRETA LEGADA (E24): REARMANDO TODA a família serial bus (é a porta de volta do despertar sozinho):\n'
        do_set enabled
        ;;
    status)
        do_status
        ;;
    *)
        printf 'uso: %s [apply|usb-apply <devpath>|status|off|on]\n' "$PROG" >&2
        exit 2
        ;;
esac
