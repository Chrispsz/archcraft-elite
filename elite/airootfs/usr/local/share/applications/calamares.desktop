[Desktop Entry]
Type=Application
Version=1.0
Name=Install Archcraft
Name[pt_BR]=Instalar o Archcraft
GenericName=System Installer
GenericName[pt_BR]=Instalador de sistema
Keywords=calamares;system;installer;
TryExec=calamares
Exec=/usr/local/bin/calamares-elite-log
Comment=Archcraft System Installer
Comment[pt_BR]=Instalador de sistema do Archcraft Elite
# v2.2: Icon=calamares — o ícone do PRÓPRIO pacote (hicolor do calamares);
# sem tema de ícones na ISO, ícone de tema não é garantia.
Icon=calamares
Terminal=false
StartupNotify=true
StartupWMClass=calamares
Categories=Qt;System;
X-AppStream-Ignore=true
