[Desktop Entry]
Type=Application
Version=1.0
Name=mpv Media Player
GenericName=Media Player
Keywords=video;movie;film;player;
Exec=mpv --player-operation-mode=pseudo-gui
TryExec=mpv
Icon=/usr/share/pixmaps/elite/mpv.png
Terminal=false
StartupNotify=true
StartupWMClass=mpv
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/x-matroska;audio/x-matroska;audio/mpeg;
