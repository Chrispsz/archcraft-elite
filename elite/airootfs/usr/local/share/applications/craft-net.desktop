# ═════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · craft-net.desktop (1.0-110 — O NMTUI FLUTUANTE DA CASA)
# ────────────────────────────────────────────────────────────────────────
# 1.0-110 T4 — A GAVETA LIMPA (a diretriz: apenas UMA entrada de rede no
# craft-apps). O binário craft-net (o seletor de 1 clique de 1.0-109)
# SEGUE VIVO como ferramenta de terminal; a ENTRADA da grade agora veste
# o nmtui FLUTUANTE — o mesmo "Redes" que o clique no botão de rede da
# barra abre: Wi-Fi conectando apenas com senha, cabo, VPN e DNS, na
# janela foot centrada em ~60% da tela (a windowRule identifier
# "craft-net-tui" do rc.xml centra; o foot veste o tamanho percentual).
# O editor técnico nm-connection-editor ganhou NoDisplay (a sombra da
# casa em /usr/local/share/applications) — a rede tem UM endereço só.
# ═════════════════════════════════════════════════════════════════════════
[Desktop Entry]
Type=Application
Version=1.0
Name=Redes
Name[pt_BR]=Redes
GenericName=Gerenciador de rede
GenericName[pt_BR]=Gerenciador de rede
Comment=Wi-Fi, cabo, VPN e DNS — o nmtui flutuante da casa
Comment[pt_BR]=Wi-Fi, cabo, VPN e DNS — o nmtui flutuante da casa
Keywords=network;wifi;ethernet;rede;sem fio;gerenciador;nmtui;
Exec=foot --app-id=craft-net-tui -T Redes -w 60%x60% nmtui
Icon=preferences-system-network
Terminal=false
Categories=Network;Settings;
StartupWMClass=craft-net-tui
NoDisplay=false
