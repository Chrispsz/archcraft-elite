# ═════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · nm-connection-editor.desktop (1.0-110 — A GAVETA LIMPA)
# ────────────────────────────────────────────────────────────────────────
# 1.0-108 nasceu para dar PARIDADE com o Bluetooth: o editor técnico
# morava OCULTO da grade (o applet de era era a única porta) — e a
# entrada visível trouxe o dono. 1.0-110 T4 fecha o ciclo (a diretriz:
# "deixando apenas UMA entrada de rede no craft-apps"): a entrada ÚNICA
# é o "Redes" (craft-net.desktop → o nmtui FLUTUANTE — Wi-Fi conectando
# apenas com senha, cabo, VPN e DNS); o editor GRÁFICO técnico vira a
# SOMBRA da casa (o mesmo frontão do xterm/qv4l2 de 1.0-108): a MESMA
# desktop-id na FRENTE do XDG_DATA_DIRS com NoDisplay=true — o binário e
# o W-n seguem vivos, a GRADE não lista (o dono não fica na frente de
# DUAS portas de rede no mesmo ícone de grade).
# ═════════════════════════════════════════════════════════════════════════
[Desktop Entry]
Name=Conexões de Rede
Name[pt_BR]=Conexões de Rede
GenericName=Editor de conexões
GenericName[pt_BR]=Editor de conexões
Comment=Network connections editor (Ethernet, Wi-Fi, VPN — the network editor of the house)
Comment[pt_BR]=Editor de conexões de rede (Ethernet, Wi-Fi, VPN — o editor de redes da casa)
Exec=nm-connection-editor
Icon=preferences-system-network
Terminal=false
Type=Application
Categories=GNOME;GTK;Settings;Network;
Keywords=Network;Wireless;Wi-Fi;Ethernet;VPN;Connection;
StartupNotify=true
StartupWMClass=nm-connection-editor
NoDisplay=true
