{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Archcraft",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "⚡ Archcraft Elite — labwc · engine CachyOS",
      "outputColor": "magenta"
    },
    {
      "type": "title"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "disk",
      "folders": ["/"]
    },
    "break",
    "colors"
  ]
}
