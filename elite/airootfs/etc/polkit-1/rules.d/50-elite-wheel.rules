// ═════════════════════════════════════════════════════════════════════════
// Archcraft ELITE · 50-elite-wheel.rules — a AUTORIZAÇÃO DA CASA (E128)
// ═════════════════════════════════════════════════════════════════════════
// O RELATO DO DONO (2026-11-20): o polkit cobrava senha onde a casa é dona
// ("Polkit sem erro 'Usuário não autorizado'"). A cura é NARROW por
// desenho — NADA de wildcard: as duas portas que a casa entende de raiz
// ficam sem senha PARA QUEM PODE (usuário LOCAL ATIVO do grupo wheel);
// todo o resto do sistema continua pedindo autenticação como sempre.
//
// 2.0 Fase 2 — A FAMÍLIA DOS MOTORES (as FACES agora são janelas GTK4:
//   craft-update/craft-clean chamam pkexec por DENTRO; os motores é que
//   sobem como raiz):
//   · /usr/local/bin/elite-update — a porta canônica da dose (a GUI
//     invoca; o diálogo gráfico da sessão pergunta UMA vez);
//   · /usr/local/bin/elite-dose   — o motor da atualização (o corpo
//     provado da era craft-update, renomeado — a porta sem senha é a
//     mesma de sempre);
//   · /usr/local/bin/elite-clean  — o motor da limpeza (o corpo da era
//     craft-clean, renomeado — a GUI chama com --as-root USUÁRIO HOME,
//     o caminho EXATO desta regra, sem env injection).
//
// O grupo wheel É o juiz (a casa não inventa grupo novo — sudo/pam_wheel
// já decidem quem é admin neste rig; polkit apenas RESPEITA a decisão).
// id "org.freedesktop.policykit.exec" com lookup do CAMINHO: o casamento é
// EXATO (strcmp do polkit — path diferente = regra não casa = senha normal).
// ═════════════════════════════════════════════════════════════════════════
polkit.addRule(function(action, subject) {
    var casa = [
        "/usr/local/bin/elite-update",
        "/usr/local/bin/elite-dose",
        "/usr/local/bin/elite-clean"
    ];
    if (action.id == "org.freedesktop.policykit.exec"
        && subject.isInGroup("wheel")
        && subject.local && subject.active
        && casa.indexOf(action.lookup) >= 0) {
        return polkit.Result.YES;
    }
});
