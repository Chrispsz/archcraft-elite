# Archcraft ELITE · labwc themerc-override — RICE PRÓPRIO Catppuccin Mocha
# ══════════════════════════════════════════════════════════════════════════
# v1.0.4 · Desktop v2 RICE: este arquivo SOBRESCREVE qualquer <theme><name>
# do rc.xml (labwc-theme(5): "Theme settings specified in themerc can be
# overridden by creating a 'themerc-override' file in the configuration
# directory"). Zero dependência de pacotes de tema Openbox — o rice é nosso.
#
# v1.3 · AMOLED rice: titlebar ATIVA desce ao preto REAL (#000000) — só a
# borda mauve assina. Janelas parecem "carne" colorida (conteúdo Catppuccin)
# pendurada num cabide preto. Menu/OSD em crust escurecido; pressed segue
# a escada v1.3 (#22222e). Sombras intactas — acertos do v1.0.4.
#
# v1.6 · BOTÕES MACOS TRAFFIC-LIGHT: círculos close #ff5f57 / iconify
# #febc2e / max #28c840 como PNGs do tema Archcraft-Elite (gerados com
# supersampling, hover com glifo). Layout rc.xml: icon:iconify,max,close
# = ícone à esquerda + botões à DIREITA — "estilo mac, posição windows".
#
# Receita sintetizada dos melhores rices labwc públicos (hakuspace 272★,
# Speyll, modern-labwc 143★, dux-shell 8.4k★ + themercs Catppuccin reais
# codenamekt/zigshell/naravisuals + catppuccin/openbox oficial):
#  · titlebar centralizada, fina (28px), botões "traffic lights" Mocha
#  · janela ATIVA com borda MAUVE (1px de identidade — assinatura do rice)
#  · botões com hover em pílula translúcida (hakuspace)
#  · sombras GRANDES e suaves (60/40) — o maior diferencial vs default
#  · menu/OSD coerentes com a paleta (item ativo surface1, OSD mauve)
# Paleta: github.com/catppuccin/palette (mocha)

# ── Geometria ──────────────────────────────────────────────────────────────
border.width: 1
padding.height: 4
padding.width: 0
window.titlebar.padding.height: 2
window.titlebar.padding.width: 5
window.label.text.justify: center

# ── Janela ATIVA: base + identidade mauve na borda ─────────────────────────
window.active.border.color: #cba6f7
window.active.title.bg.color: #000000
window.active.label.text.color: #cdd6f4
window.active.handle.bg.color: #000000
window.active.grip.bg.color: #16161f

# ── Janela INATIVA: recolhe pra mantle, texto discreto ─────────────────────
window.inactive.border.color: #16161f
window.inactive.title.bg.color: #050508
window.inactive.label.text.color: #6c7086
window.inactive.handle.bg.color: #050508
window.inactive.grip.bg.color: #16161f

# ── Botões "traffic lights" macOS à DIREITA (v1.6 — pedido do dono) ───────
# Os PNGs vivem no TEMA /usr/share/themes/Archcraft-Elite/labwc/ (rc.xml
# <theme><name>); este override cuida da GEOMETRIA. Círculos 12px em célula
# 24px (proporção macOS); spacing 2 = o trio lê como um grupo. O hover tem
# glifo NO PRÓPRIO PNG (×/−/⤢ escuros) — o overlay genérico do labwc fica
# INVISÍVEL (alpha 00) pra não brigar com o visual mac. Cores: close #ff5f57
# · iconify #febc2e · max #28c840 · inativo #5b5b60 (as .image.color abaixo
# só tingem XBM — PNG ignora por design; ficam como fallback documentado).
window.button.width: 24
window.button.height: 24
window.button.spacing: 2
window.button.hover.bg.color: #00000000
window.button.hover.bg.corner-radius: 12

window.active.button.iconify.unpressed.image.color: #febc2e
window.active.button.max.unpressed.image.color: #28c840
window.active.button.close.unpressed.image.color: #ff5f57
window.active.button.iconify.hover.image.color: #febc2e
window.active.button.max.hover.image.color: #28c840
window.active.button.close.hover.image.color: #ff5f57
window.active.button.iconify.pressed.image.color: #22222e
window.active.button.max.pressed.image.color: #22222e
window.active.button.close.pressed.image.color: #22222e

window.inactive.button.unpressed.image.color: #5b5b60
window.inactive.button.hover.image.color: #a6adc8
window.inactive.button.pressed.image.color: #22222e

# ── Sombras grandes e suaves (a receita premium do hakuspace) ──────────────
window.active.shadow.size: 60
window.active.shadow.color: #00000060
window.inactive.shadow.size: 40
window.inactive.shadow.color: #00000040

# ── Menu (raiz/cliente — coerência com waybar/swaync) ─────────────────────
menu.items.bg.color: #050508
menu.items.text.color: #cdd6f4
menu.items.active.bg.color: #22222e
menu.items.active.text.color: #cdd6f4
menu.items.padding.x: 8
menu.items.padding.y: 4
menu.border.width: 1
menu.border.color: #16161f
menu.separator.width: 1
menu.separator.color: #16161f
menu.separator.padding.height: 4

# ── OSD (volume/brilho) e window switcher ─────────────────────────────────
osd.bg.color: #000000
osd.label.text.color: #cba6f7
osd.border.width: 1
osd.border.color: #22222e
osd.window-switcher.width: 600
osd.window-switcher.padding: 12
osd.window-switcher.item.padding.x: 12
osd.window-switcher.item.padding.y: 6
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.item.active.border.color: #cba6f7

# ── Snapping (preview de divisão da tela) ─────────────────────────────────
snapping.overlay.edge.bg.color: #cba6f780
snapping.overlay.region.bg.color: #cba6f780
