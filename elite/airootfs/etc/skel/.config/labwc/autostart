#!/bin/sh
# Archcraft ELITE ISO · labwc autostart — sessão ÚNICA do live e do sistema
# instalado (v1.0.3+): openbox/bspwm foram removidos da ISO. Idêntico ao
# autostart do zip Cockpit: quem instala a ISO já nasce no mesmo ambiente
# de quem rodou o zip.
# Executado no início da sessão LABWC — termine comandos com & para não bloquear.
#
# Desktop v2 (v1.0.4) — estilo macOS, mouse-first: menu bar no topo
# (waybar config.top) + DOCK flutuante na base (waybar config.dock),
# Launchpad (nwg-drawer via craft-drawer) e wallpaper de imagem.

# --- Wallpaper: AMOLED (v1.3) — fractal mauve sobre preto REAL (4K) --------
# Fonte: curadoria da internet (Wallpapers.com, licença de uso livre de
# wallpaper) — 3840x2160. Pós-processado para o conceito "backlight
# desligado": black-point por luminância (K=10, ombro S=64, croma
# preservado — o glow fica byte-idêntico). PNG LOSSLESS: JPEG re-quantiza
# cada bloco 8x8 e não preserva preto exato. 62% dos pixels são (0,0,0)
# EXATOS — pixels fisicamente desligados; número conferido por dois
# métodos independentes (numpy e contagem PIL: 62.22%). Fallback: preto.
if command -v swaybg >/dev/null 2>&1; then
    if [ -r "$HOME/.config/labwc/wallpaper.png" ]; then
        swaybg -m fill -i "$HOME/.config/labwc/wallpaper.png" &
    else
        # sem imagem (ex.: skel parcial): preto AMOLED, zero decodificação
        swaybg -m fill -c '#000000' &
    fi
fi

# --- Barras (Desktop v2): menu bar no TOPO + DOCK na base ------------------
#     2 instâncias do waybar: o tray (SNI watcher é único por sessão) fica
#     SÓ na de cima; o dock tem launchers fixos + janelas abertas.
if command -v waybar >/dev/null 2>&1; then
    waybar -c "$HOME/.config/waybar/config.top" \
           -s "$HOME/.config/waybar/style.top.css" &
    waybar -c "$HOME/.config/waybar/config.dock" \
           -s "$HOME/.config/waybar/style.dock.css" &
fi

# --- Central de notificações (SwayNC) — toggle no relógio da barra ---------
swaync &

# --- Diálogo de senha gráfico (polkit) — o Archcraft só sobe agente na sessão
#     Openbox dele; na sessão LABWC é este arquivo que sobe o agente
#     (necessário p/ gparted, coolercontrol, btrfs-assistant no dia-1)
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# --- Bluetooth/Rede (v1.1): os applets GTK3 (blueman, nm-applet) saíram —
#     pareamento = bluetui (W-b no rc.xml), rede = impala (W-n) ou o módulo
#     network da waybar (clique abre o nmtui no foot). Zero daemon GTK3
#     rodando de graça na sessão; o bluetooth.service segue habilitado.

# --- USB: automount + notificação (udiskie — daemon próprio; o
#     thunar-volman só age com o Thunar aberto)
if command -v udiskie >/dev/null 2>&1; then
    udiskie --automount --notify --no-tray &
fi

# --- Idle + lock (v1.5): hyprlock aos 10 min, DPMS (wlopm) aos 15,
#     lock também no before-sleep. Receita canônica da wiki do labwc
#     (labwc.github.io/integration §7: swayidle + wlopm — o wlr-randr
#     --off re-arranja views; wlopm é o cliente do protocolo
#     wlr-output-power-management-v1, que o labwc implementa).
#     O lock agora é o hyprlock (~/.config/hypr/hyprlock.conf): screenshot
#     + blur + dim + relógio + avatar + campo estilizado — a tela branca
#     estática do swaylock saiu de cena (fix do burn test).
if command -v swayidle >/dev/null 2>&1; then
    swayidle -w \
        timeout 600 'hyprlock' \
        timeout 900 'wlopm --off "*"' \
        resume 'wlopm --on "*"' \
        before-sleep 'hyprlock' &
fi

# --- Keyring CachyOS (v1.5, camada 4): self-healing de runtime — os
#     comandos LITERAIS da spec (init → populate → refresh de keyring)
#     em background, idempotentes, sudo -n (nunca pede senha no escuro).
#     As camadas 1-3 (build E2b + E10 no alvo + pacman-init do live) já
#     curam o essencial; esta cobre skew futuro e liveuser no live.
if [ -x /usr/local/bin/craft-fix-keys ]; then
    /usr/local/bin/craft-fix-keys &
fi

# --- Clipboard: histórico persistente (cliphist — receita oficial do
#     labwc; W-v abre o histórico no fuzzel)
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    wl-paste --watch cliphist store &
fi

# --- EasyEffects em modo serviço (DSP do microfone): sobe no login pronto para
#     OBS/Discord. O preset (ex.: RNNoise na entrada) é criado 1× no app e
#     carrega sozinho nas sessões seguintes (dia-1 · v1.2.2)
if command -v easyeffects >/dev/null 2>&1; then
    easyeffects --gapplication-service &
fi
