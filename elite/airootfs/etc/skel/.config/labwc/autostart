#!/bin/sh
# Archcraft ELITE ISO · labwc autostart — sessão ÚNICA do live e do sistema
# instalado (v1.0.3+): openbox/bspwm foram removidos da ISO. Idêntico ao
# autostart do zip Cockpit: quem instala a ISO já nasce no mesmo ambiente
# de quem rodou o zip.
# Executado no início da sessão LABWC — termine comandos com & para não bloquear.
#
# Desktop v2 (v1.0.4) — estilo macOS, mouse-first: menu bar no topo
# (waybar config.top) + DOCK flutuante na base (craft-dock-gui — v2.0),
# Launchpad (nwg-drawer via craft-drawer) e wallpaper de imagem.

# --- Wallpaper: v1.7.1 — CURADORIA DA INTERNET (decisão do dono) ----------
#     "Eu queria um wallpaper da internet mesmo, esses gerados são muito
#     ruim" — o experimento IA da v1.7 saiu de cena. Fonte: Unsplash
#     (licença Unsplash — uso livre, sem atribuição obrigatória),
#     abstrato 3D de ondas de seda roxo/preto. Nativo 3000x1688 →
#     3840x2160 (Lanczos + UnsharpMask leve), JPEG q93 = 0.43 MB (o PNG
#     de 10.7 MB da v1.7 engordava a ISO ~19 MB no squashfs). Métricas
#     medidas e contratos na suíte: 0.24% de preto puro (não esmaga o
#     IPS), luma média 32.6 (dark premium), strip do topo luma 5.7 <<
#     média (a menu bar assenta em zona escura — texto branco legível).
#     Fallback: wallpaper.png (legado/custom do usuário) → preto.
if command -v swaybg >/dev/null 2>&1; then
    # v1.9 — spec M5.1 do dono: o wallpaper JPEG tinha ruído/granulação de
    # compressão ("impressão de poeira"). PADRÃO: PNG lossless.
    # v2.8.0 — a curadoria da INTERNET volta (pedido do dono: "esse
    # wallpaper dá pra arrumar melhor na internet… mais vivo em IPS, de
    # forma minimalista, sem destrair ou machucar a visão"): ondas de seda
    # roxo/violeta da Unsplash (triada por VLM entre 3 candidatas), PNG
    # lossless 2812×1582 com blur 0.4px no fonte — a poeira não volta
    # (luma 30.1, 0% preto puro, gradiente medido suave — contratos na
    # suíte). O lock (craft-lock/hyprlock) bebe do MESMO arquivo.
    if [ -r "$HOME/.config/labwc/wallpaper.png" ]; then
        swaybg -m fill -i "$HOME/.config/labwc/wallpaper.png" &
    elif [ -r "$HOME/.config/labwc/wallpaper.jpg" ]; then
        swaybg -m fill -i "$HOME/.config/labwc/wallpaper.jpg" &
    else
        # sem imagem (ex.: skel parcial): preto AMOLED, zero decodificação
        swaybg -m fill -c '#000000' &
    fi
fi

# --- Janelas: daemon wlr-foreign-toplevel (v2.10.1 — a dock COMUTADORA) ---
#     O craft-toplevel fala o protocolo DIRETO com o labwc (janelas por id +
#     anel MRU do alt-tab) e serve a dock num socket da sessão. Antes do
#     craft-bars (que o supervisiona): a dock reconnecta sozinha no 1º tick,
#     mas nascer com o socket pronto é a ordem certa. Sem WAYLAND_DISPLAY o
#     daemon sai 0 por conta própria (a supervisão assume depois do boot).
if command -v craft-toplevel >/dev/null 2>&1; then
    craft-toplevel &
fi

# --- Barras (Desktop v2): menu bar no TOPO + DOCK na base ------------------
#     v1.6.3 — SUPERVISÃO (burn test da v1.6.2: a sessão subiu SÓ com o
#     wallpaper — as duas instâncias morreram caladas, sem deixar stderr;
#     o gate do CI para no LOGIN, nunca vê a sessão gráfica). O craft-bars
#     vigia as duas barras, reinicia em ≤5s e guarda o stderr em
#     ~/.cache/elite/bars.log (teto 1 MiB) — fim da sessão muda, e se o
#     waybar morrer de novo o log traz a mensagem EXATA dele.
#     v1.7.1 — FIM DO SILÊNCIO DO GUARD: se o binário do waybar não
#     existir no squashfs ou o craft-bars estiver sem +x, o guard abaixo
#     falhava SEM NENHUM rastro (a classe "subiu só o wallpaper" que
#     atravessou v1.6.2→v1.7.0). Agora TUDO que decide as barras deixa
#     rastro no MESMO bars.log do supervisor.
BARLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/bars.log"
if ! command -v waybar >/dev/null 2>&1; then
    mkdir -p "${BARLOG%/*}" 2>/dev/null
    printf '[%s] AUTOSTART: binário waybar AUSENTE no sistema — barras NÃO sobem (guard)\n' "$(date '+%F %T')" >>"$BARLOG" 2>/dev/null
elif [ ! -x /usr/local/bin/craft-bars ]; then
    mkdir -p "${BARLOG%/*}" 2>/dev/null
    printf '[%s] AUTOSTART: craft-bars ausente/sem bit de execução — barras NÃO sobem (guard)\n' "$(date '+%F %T')" >>"$BARLOG" 2>/dev/null
else
    craft-bars &
fi

# --- Central de notificações (SwayNC) — toggle no relógio da barra ---------
# v2.10.5 — MESMA LEI DOS VIZINHOS (fim do último spawn sem guarda): o
# swaync é a única superfície de TODOS os avisos de erro dos craft-*,
# morrer calado contrariava a doutrina do próprio arquivo.
if command -v swaync >/dev/null 2>&1; then
    swaync &
fi

# --- Diálogo de senha gráfico (polkit) — o Archcraft só sobe agente na sessão
#     Openbox dele; na sessão LABWC é este arquivo que sobe o agente
#     (necessário p/ gparted, coolercontrol, btrfs-assistant no dia-1)
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# --- Rede/Bluetooth (v2.0 → v2.3.5 → v2.3.6 — a história, com as 3 evidências):
#     v2.0 tirou os applets (estética: "um ícone antigo… e um de Bluetooth.
#     Ambos ficaram meio quebrados"). O rig v2.3.2 provou o custo: o editor
#     EDITA, não CONECTA → v2.3.5 devolveu o nm-applet como conector. O rig
#     v2.3.5 provou o custo DO remédio: o ícone SNI de ethernet é bitmap de
#     tema de ícones — desanda a família tipográfica da barra ("os ícones
#     estão inconsistentes visualmente e espaçados"; o dono: "remove esse
#     ícone feio de Pc… coloca a função… como texto escrito nela"). A cura
#     final não é estética nem função — é as duas juntas: O CONECTOR É O
#     PRÓPRIO craft-connect EM TEXTO ('Wi-Fi: conectar à rede…' → redes do
#     entorno → senha oculta → conectado, tudo fuzzel+nmcli). Nada sobe na
#     tray (udiskie roda --no-tray); edição avançada continua no W-n.

# --- USB: automount + notificação (udiskie — daemon próprio; o
#     thunar-volman só age com o Thunar aberto)
if command -v udiskie >/dev/null 2>&1; then
    udiskie --automount --notify --no-tray &
fi

# --- Idle + lock (v1.6.1): TEMPOS AJUSTÁVEIS PELO USUÁRIO — "consigo
#     controlar em quanto tempo o Pc entra em idle?" (dono). Defaults
#     no ~/.config/elite/idle.conf (10 min lock · 15 min apagar); o
#     menu do desktop → "Tempo para travar a tela…" (craft-idle) troca
#     e reinicia o daemon NA HORA, sem relogin. Receita canônica da
#     wiki do labwc (labwc.github.io/integration §7: swayidle + wlopm —
#     o wlr-randr --off re-arranha views; wlopm é o cliente do protocolo
#     wlr-output-power-management-v1, que o labwc implementa).
#     O lock é o hyprlock (~/.config/hypr/hyprlock.conf): screenshot +
#     blur + dim + relógio + avatar + campo estilizado. FLUXO: X min →
#     lock; X+5 → tela APAGA (DPMS real — o PC não fica ligado numa
#     tela fixa); input → acorda JÁ no lock; before-sleep → lock no
#     suspender. "Nunca" (LOCK_MIN=0) = sem daemon (W-l manual).
#     v2.10.6 — O SPAWN SAIU DAQUI: quem lança (e RELANÇA — a morte
#     calada do swayidle deixava lock/DPMS/suspend fora para sempre, o
#     achado da Rodada 2 da auditoria) é o CRAFT-BARS, o supervisor da
#     sessão (idle entra no loop de 5s com ausência intencional
#     silenciosa quando "Nunca"). Um só lançador mata a corrida
#     fork/exec: dois spawns próximos do idle se pkillariam (o
#     pkill -x swayidle do começo do start) e o morto deixaria
#     'SAIU exit=143' no gate do QEMU.

# --- Keyring CachyOS (v1.5, camada 4): self-healing de runtime — os
#     comandos LITERAIS da spec (init → populate → refresh de keyring)
#     em background, idempotentes, sudo -n (nunca pede senha no escuro).
#     As camadas 1-3 (build E2b + E10 no alvo + pacman-init do live) já
#     curam o essencial; esta cobre skew futuro e liveuser no live.
if [ -x /usr/local/bin/craft-fix-keys ]; then
    /usr/local/bin/craft-fix-keys &
fi

# --- Keyring GNOME (v1.6 — a resposta ao "programas pedem a senha do
#     keyring"): o chaveiro (gnome-keyring) guarda senhas de Wi-Fi e
#     navegador via libsecret. No login COM senha o PAM do sddm já
#     desbloqueia junto (linhas pam_gnome_keyring do upstream). No
#     live/autologin não há senha — este bootstrap cria o chaveiro com
#     senha VAZIA (gnome-keyring-daemon --unlock lê a senha do stdin;
#     sem chaveiro, ele CRIA) — os apps (Brave, Wi-Fi, etc) param de
#     pedir "desbloquear chaveiro". Uma vez só: o marcador é o próprio
#     arquivo do chaveiro. No sistema INSTALADO com login por senha,
#     o arquivo já existe e o PAM cuida — este bloco é no-op.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    if [ ! -e "$HOME/.local/share/keyrings/login.keyring" ]; then
        ( printf '' | gnome-keyring-daemon --unlock >/dev/null 2>&1 ) &
    fi
fi

# --- Clipboard: histórico persistente (cliphist — receita oficial do
#     labwc; W-v abre o histórico no fuzzel)
#     v1.6.2 — PODA antes do watcher (camada 1 da receita do README
#     upstream: "cliphist wipe -older-than 720h from a timer"): o DB
#     cresceria sem limite (screenshots inteiros em base64). SÍNCRONA e
#     proposital: milissegundos com o DB podado; estritamente antes do
#     watcher, sem disputa de lock. Camada 2: cliphist-prune.timer do
#     user manager (diário — uptimes longos).
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    cliphist wipe -older-than 720h 2>/dev/null
    wl-paste --watch cliphist store &
fi
