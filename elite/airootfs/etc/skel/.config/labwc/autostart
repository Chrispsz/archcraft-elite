#!/bin/sh
# Archcraft ELITE · labwc autostart v4 (E190 T4 — O ARRANQUE LIMPO DE
# VERDADE: zero residentes legados) — executado no início da sessão
# LABWC — termine comandos com & para não bloquear.
#
# A ARQUITETURA (2.0 → E190): o AUTOSTART é o berço do FRAME 0 da
# sessão — o AMBIENTE, os alicerces que NÃO podem depender do
# supervisor (wallpaper, agente polkit, keyring, clipboard) e UM SÓ
# lançador de orquestração: `elite-daemon session &` (o bloco marcado
# BEGIN/END — o ÚNICO lançador da casa, auditado pelo elite-heal-
# sessao). TODO o resto — top bar, dock, notificações (swaync), OSD,
# vigília/trava, motor de jogo, watch de displays e AGORA O AUTOMOUNT
# — é evento do daemon (E190 T4: o ouvidor UDisks2 do elite-daemon
# monta o pen drive NO EVENTO com a notificação na cara — o udiskie
# Python residente APOSENTOU; o watch de telas idem — o wl_output
# nativo grava cada escolha com debounce de 400ms). NENHUM swaync
# nasce aqui (o daemon é o ÚNICO dono da central — a lei 1.0-107
# segue) e NENHUM udiskie/blueman-applet volta NUNCA (E190 T4).
#
# v2 (1.0-102): a reescrita limpa da era `elite-daemon session`.
# v3 (1.0-108): os alicerces voltam ao frame 0. v4 (E190): o
# udiskie sai — o automount é evento do daemon.

# ── 0. O AMBIENTE WAYLAND NO DBUS/USERD ANTES DE TUDO (1.0-107/108) ──────
#     A cura do COLD BOOT VAZIO: os processos D-Bus-ativados e as units
#     --user do systemd só ENXERGAM o WAYLAND_DISPLAY quando ele mora no
#     activation environment — a exportação corre ANTES de swaybg/daemon/
#     qualquer cliente de display (a linha da receita oficial do labwc;
#     idempotente por natureza, falha calada em sessão sem dbus).
#     1.0-108: XDG_CURRENT_DESKTOP=labwc:wlroots (a grafia da diretriz —
#     o xdg-desktop-portal-wlr e o fuzzel casam as DUAS palavras).
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc:wlroots >/dev/null 2>&1 || true
fi

# ── 1. OS ÓRFÃOS DA SESSÃO ANTERIOR MORREM NO FRAME 0 ────────────────────
#     ${XDG_RUNTIME_DIR:-/run/user/$UID}/elite/ é tmpfs da SESSÃO, mas o
#     relogin rápido e o crash deixam fósseis que MENTEM à sessão nova
#     (sockets mortos, stamps, locks). No frame 0 do labwc não há outra
#     sessão viva — tudo que está aqui é órfão e sai (o diretório fica:
#     é a morada da sessão que nasce agora; o elite-daemon session
#     re-varre no arranque dele — a segunda porta do cinto).
_elite_run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/elite"
if [ -d "$_elite_run" ]; then
    find "$_elite_run" -mindepth 1 -maxdepth 1 \( -type s -o -type f \) -delete 2>/dev/null
fi
unset _elite_run

# ── 2. OS PAPÉIS NASCEM PODADOS ────────────────────────────────────────────
#     ~/.cache/elite/*.log crescia sem freio entre doses (o bars.log do
#     rig passou de 980 KB em poucos dias). No frame 0 cada papel fica
#     com os ÚLTIMOS 256 KiB — passada síncrona de milissegundos, antes
#     de qualquer daemon escrever linha nova.
_elite_logs="${XDG_CACHE_HOME:-$HOME/.cache}/elite"
if [ -d "$_elite_logs" ]; then
    for _l in "$_elite_logs"/*.log; do
        [ -f "$_l" ] || continue
        if [ "$(wc -c <"$_l" 2>/dev/null || echo 0)" -gt 262144 ]; then
            tail -c 131072 "$_l" > "$_l.poda" 2>/dev/null && mv -f "$_l.poda" "$_l" 2>/dev/null
        fi
    done
fi
unset _elite_logs _l

# ── 3. O ARRANJO DO MONITOR NASCE APLICADO ────────────────────────────────
#     O modo do display é propriedade do compositor em RAM — nada na
#     casa gravava a escolha e os 200 Hz escolhidos somiam a cada boot.
#     O apply-boot é SÍNCRONO na PRIMEIRA linha da sessão: a resolução
#     e o refresh nascem ANTES das barras (nada de dock a 60 Hz trocando
#     depois). O cinto do boot frio (amdgpu acorda depois do frame 0) é
#     o elite-daemon session, que re-aplica com retry após o socket
#     registrar; o watch de displays é vaga supervisionada dele.
if command -v craft-display >/dev/null 2>&1; then
    craft-display apply-boot >/dev/null 2>&1
fi

# ── 4. O WALLPAPER DO FRAME 0 (1.0-108 — o alicoe que não espera motor) ───
#     O relato do rig 1.0-107.3: o daemon doente levava o wallpaper
#     junto — a tela nascia PRETA quando o motor tossia. O swaybg é
#     alicoe de frame 0: nasce AQUI, na hora; a vaga "wallpaper" do
#     daemon ADOTA esta instância pelo gate de comm (nunca duplica) e
#     é a rede de respawn se ela cair (o desenho E138/E150 de sempre).
if command -v swaybg >/dev/null 2>&1; then
    if [ -f "$HOME/.config/labwc/wallpaper.png" ]; then
        swaybg -m fill -i "$HOME/.config/labwc/wallpaper.png" >/dev/null 2>&1 &
    elif [ -f "$HOME/.config/labwc/wallpaper.jpg" ]; then
        swaybg -m fill -i "$HOME/.config/labwc/wallpaper.jpg" >/dev/null 2>&1 &
    else
        swaybg -m fill -c '#000000' >/dev/null 2>&1 &
    fi
fi

# ── 5. O AGENTE POLKIT DO FRAME 0 (guard pgrep — UM só na sessão) ─────────
#     O agente da casa é o lxqt-policykit (Qt6, WM-agnóstico — 1.0-107);
#     o guard pgrep nunca soma o segundo (o supressor XDG do skel
#     amordaça o /etc/xdg/autostart do pacote — E151/1.0-108: o agente
#     agora nasce no frame 0 do labwc, não na fila do supervisor; o
#     rc.xml, o craft-update e o pkexec da dose dependem dele no
#     PRIMEIRO clique — sem motor no meio).
if command -v lxqt-policykit-agent >/dev/null 2>&1 \
    && ! pgrep -x lxqt-policykit-agent >/dev/null 2>&1; then
    lxqt-policykit-agent >/dev/null 2>&1 &
fi

# ── 6. O AUTOMOUNT É EVENTO DO DAEMON (E190 T4 — o udiskie APOSENTOU) ────
#     O pen drive monta sozinho NO EVENTO: o ouvidor UDisks2 do
#     elite-daemon (discos.rs) escuta o ObjectManager do system bus e
#     monta cada bloco removível com Filesystem pela via PRÓPRIA do
#     D-Bus (Filesystem.Mount) com a notificação na cara — zero
#     residente Python, zero bandeja. O udiskie NUNCA volta ao
#     autostart (o elite-post-upgrade ceifa a linha dos rigs vivos).

# ── 7. KEYRING CACHYOS ──────────────────────────────────────────────────────
#     Self-healing de runtime (init → populate → refresh) em background,
#     idempotente, sudo -n (nunca pede senha no escuro).
if [ -x /usr/local/bin/craft-fix-keys ]; then
    /usr/local/bin/craft-fix-keys &
fi

# ── 8. CLIPBOARD COM HISTÓRICO PERSISTENTE ────────────────────────────────
#     cliphist — a receita oficial do labwc (W-v abre o histórico no
#     seletor). A PODA síncrona antes do watcher: o DB cresceria sem
#     limite (screenshots inteiros em base64) — milissegundos com o DB
#     podado, estritamente antes do watcher nascer. A camada 2 (timer
#     diário do user manager) mora no systemd de usuário.
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    cliphist wipe -older-than 720h 2>/dev/null
    wl-paste --watch cliphist store &
fi

# ── 9. O ORQUESTRADOR ÚNICO DA SESSÃO ─────────────────────────────────────
#     TODO o resto da casa é filho DELE (gate de posse por flock + nome
#     no bus E135; caiu → volta em 2s; o logout derruba a sessão inteira
#     e o session.lock sai do chão — 1.0-102, o relogin nasce limpo).
#     O guard só CLAMA no bars.log quando o motor não existe.
BARLOG="${XDG_CACHE_HOME:-$HOME/.cache}/elite/bars.log"
if ! command -v elite-daemon >/dev/null 2>&1; then
    mkdir -p "${BARLOG%/*}" 2>/dev/null
    printf '[%s] AUTOSTART: elite-daemon AUSENTE no sistema — a sessão NÃO sobe (guard 2.0)\n' "$(date '+%F %T')" >>"$BARLOG" 2>/dev/null
else
    # BEGIN ELITE-DAEMON-SESSION (bloco gerenciado pela casa — E146:
    # exatamente UM lançador; o elite-heal-sessao audita e renova)
    elite-daemon session &
    # END ELITE-DAEMON-SESSION
fi
unset BARLOG

# ── 10. TEMA ESCURO UNIVERSAL ─────────────────────────────────────────────
#     A libadwaita lê o color-scheme do dconf; o gsettings crava o
#     escuro na sessão inteira (libadwaita + portal + Qt6 + GTK3-dconf)
#     e o gtk-theme é o espelho do settings.ini (Catppuccin Mocha Mauve —
#     a família do rice). Idempotente por natureza, roda a cada login.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Mocha-Standard-Mauve-Dark' >/dev/null 2>&1 &
fi
