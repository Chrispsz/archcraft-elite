<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archcraft Cockpit · labwc rc.xml — PERFIL ELITE (v1.3) · E123 (entregue por craft-rice)

  ══════════════════════════════════════════════════════════════════════════
  DERIVADO DO ARQUIVO OFICIAL DO CRIADOR DO ARCHCRAFT
  Base: archcraft-openbox/files/rc.xml · Aditya Shakya (adi1090x)
        https://github.com/archcraft-os/archcraft-openbox
  O labwc é um clone Openbox para Wayland (mesma gramática de rc.xml),
  então este arquivo porta as convenções do criador 1:1 onde o Wayland permite:

  Adotado do criador (archcraft-openbox rc.xml):
    · Fonte JetBrainsMono NF 9 (ActiveWindow Bold / InactiveWindow Normal)
    · W-space → root-menu · C-A-space → launcher (no lugar do app-menu dele)
    · C-A-t → terminal (alias) · W-Return → terminal (foot no lugar de alacritty)
    · W-w → navegador (brave em 1º — Wayland-native, v1.1)
    · W-b mantido como alias do navegador
    · W-f → gerenciador de arquivos (Thunar, v1.5: FM padrão xdg-mime)
    · W-e → editor (nano no foot, v1.5: helix saiu — EDITOR=nano)
    · W-q e W-c → fechar (o criador usa ambos) · A-F4 · W-i / A-F5 → minimizar
    · W-m / A-F10 → maximizar · A-F11 → fullscreen (fullscreen do criador!)
    · W-←/→/↑/↓ → snap em metades (mesma semântica do snap MoveResizeTo dele)
    · W-n → rede (nm-connection-editor, GUI) · W-S-b → bluetooth (blueman-manager, GUI 2.0)
    · W-x → menu de sessão (criador: rori-powermenu da era; 2.0: o menu
      elite-sessao NATIVO do labwc)
    · C-A-Delete → sessão (criador: Exit com prompt; 2.0: menu elite-sessao)
    · C-S-R → Reconfigure (alias do W-S-r)
    · Teclas XF86 de volume/brilho/mídia (o criador também as usa)

  Desvios conscientes (documentados):
    · W-d → Launchpad (nwg-drawer) · W-S-d → toggle da dock — a nota antiga
      'fuzzel / ToggleShowDesktop preservada' descrevia a v1.2 (E33 curado
      no E36: o código real nunca foi esse)
    · 4 desktops, não 5 (W-1..4 cabe na fileira sem olhar; popupTime 800 p/
      feedback — o criador usa popupTime 0)
    · Screenshots em W-p/W-S-p (v2.10.5: keysym minúsculo — o keysym 'P'
      maiúsculo implícita Shift e embaçava o verbo região×tela; o README
      e o rc.xml agora dizem a mesma língua): o AULA F75 MAX (75%) NÃO tem
      tecla Print (criador usa Print → ob-screenshot, que é X11)
    · labwc ganha de graça: <core><gap>, cornerRadius, dropShadows, snapping
      overlay — não existem no Openbox do criador
    · BLOCO 3 (1.0-98) — A SESSÃO COSMIC: o arraste magnético nasce de
      VERDADE (o range da v1.6 era lido como atributo e o parser espera
      CONTEÚDO — range 0 = snap de arraste morto no rig); quadrantes em
      <regions> (arraste com modificador segurado + ciclo W-Left/W-Right);
      W-Setas viram ToggleSnapToEdge (divide/desencaixa na mesma tecla);
      W-S-Setas move a janela entre workspaces (o volume/faixa migra
      para C-A-Setas); cornerRange migrado para <resize> onde o parser
      o lê. Preview roxo 150ms, topMaximize e notifyClient intactos
    · RICE PRÓPRIO (v1.0.4): themerc-override Catppuccin Mocha — traffic
      lights, borda ativa mauve, sombras 60/40, menu/OSD coerentes. Zero
      dependência de pacote de tema: o "tema OB Catppuccin" citado em
      versões anteriores NUNCA existiu (tema fantasma) — era a causa do
      visual "cru" das titlebars; corrigido de vez com o override)
    · v1.7 do themerc-override (Bloco 3): a escada OFICIAL — titlebar
      #11111b elevada (o #000000 chapado morre), ativa borda 2px
      #a855f7 / inativa 1px #262637, menu/OSD na mesma base

  Teclado alvo: AULA F75 MAX (75% ANSI US · 80 teclas + knob de volume
  metálico + tela TFT · gasket · tri-mode). O knob é HID puro → envia
  XF86AudioRaise/LowerVolume (mapeados abaixo — funciona no cabo, 2.4G e BT).

  Fonte de sintaxe labwc: docs/rc.xml.all + labwc-config(5) + labwc-actions(5)
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <!-- Gaps entre janelas/bordas (novo no labwc vs Openbox do criador) -->
    <gap>10</gap>
    <!-- VRR/FreeSync quando o monitor suportar (RX 7600 + FreeSync) -->
    <adaptiveSync>auto</adaptiveSync>
    <!-- Para gaming competitivo: "yes" libera tearing imediato (com VRR fica imperceptível) -->
    <allowTearing>no</allowTearing>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <!-- RICE PRÓPRIO (v1.0.4): TODO o visual de CORES vive em themerc-override —
         labwc-theme(5): "themerc-override in the configuration directory"
         sobrescreve qualquer tema. <name> aponta pro tema com os ASSETS:
         v1.6 — /usr/share/themes/Archcraft-Elite/labwc/ carrega os botões
         "traffic lights" macOS (PNGs 24px: vermelho fecha, amarelo
         minimiza, verde maximiza; hover com glifo; cinza inativo) — o
         pedido do dono: "estilo macos, posicionamento windows padrão"
         (layout icon:iconify,max,close = ícone à esquerda, botões à
         direita — a ordem Windows que o dedo já conhece). -->
    <name>Archcraft-Elite</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <!-- Fonte do criador: JetBrainsMono NF 9 (o nome REAL da família do
         archcraft-fonts 2.0 — 'JetBrains Mono' com espaço é a família
         upstream que NÃO vem na ISO; fontconfig cairia no fallback
         genérico sem o rice. Mesma lei da waybar/fuzzel/foot). -->
    <font place="ActiveWindow">
      <name>JetBrainsMono NF</name>
      <size>9</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>JetBrainsMono NF</name>
      <size>9</size>
      <weight>normal</weight>
    </font>
    <!-- v1.7 — ÍCONES DO MENU VISÍVEIS (pedido do dono): no labwc o
         tamanho do ícone de menu É a altura da fonte do item —
         src/menu/menu.c: #define ICON_SIZE (menu_item_height - 2 *
         menu_items_padding_y) e src/theme.c: menu_item_height =
         font_height(font_menuitem) + 2 * padding_y → o padding CANCELA e
         sobra a fonte. Default 10px = itens de ~14px (a foto do dono).
         Fonte 12 = itens ~27px (v2.2: sem coluna de ícones — o texto
         manda sozinho). -->
    <font place="MenuItem">
      <name>JetBrainsMono NF</name>
      <size>12</size>
      <weight>normal</weight>
    </font>
  </theme>

  <!-- Menu SEM ícones (v2.2 — diretriz do dono, leveza radical): o
       papirus-icon-theme saiu da ISO e o menu.xml é texto puro — a coluna
       de ícones fica desligada ("showIcons no"). A fonte MenuItem segue
       mandando na altura dos itens. -->
  <menu>
    <showIcons>no</showIcons>
  </menu>

  <!-- Alt+Tab com preview e miniaturas -->
  <windowSwitcher preview="yes" outlines="yes" unshade="yes">
    <osd show="yes" style="classic" output="all" thumbnailLabelFormat="%T" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <!-- Resistência do criador: screen_edge_strength 20 -->
  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
    <unSnapThreshold>20</unSnapThreshold>
    <unMaximizeThreshold>150</unMaximizeThreshold>
  </resistance>

  <snapping>
    <!-- BLOCO 3 — O ARRASTE MAGNÉTICO NASCE DE VERDADE (a cura do bug
         silencioso da v1.6): o parser do labwc (rcxml.c 0.9.1) lê range
         como CONTEÚDO do elemento ('range.snapping' → atoi(content)) —
         a forma antiga <range inner="10" outer="10"/> produzia
         nodenames 'inner.range.snapping'/'outer.range.snapping' que
         nenhum ramo do parser casa → atoi("") = 0 → range 0 = o
         edge_from_cursor() devolvia INVALID ANTES DE TUDO e o arraste
         para as bordas NUNCA snapava no rig (só os atalhos de teclado
         funcionavam). O 14px é o íman COSMIC (o screenEdgeStrength 20
         da resistência continua na frente). -->
    <range>14</range>
    <!-- O preview sobe NO GESTO (era 500ms — a suavidade COSMIC é
         aparecer imediato; o delay é só anti-falso-positivo) -->
    <overlay enabled="yes">
      <delay inner="150" outer="150" />
      <placement>below</placement>
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <!-- BLOCO 3 — O IMÃ DE CANTO DO RESIZE (cornerRange é filho de
         <resize>, NÃO de <snapping> — o parser só casa
         'cornerRange.resize' (rcxml.c): a v1.6 o deixava sob
         <snapping>, o nodename 'cornerrange.snapping' casava com NADA e
         o valor caía no default titlebar_height/2 (~14px). 50px: agarrar
         o canto para redimensionar fica fácil em Full HD. -->
  <resize>
    <cornerRange>50</cornerRange>
  </resize>

  <!-- BLOCO 3 — OS QUADRANTES COSMIC (regiões snapáveis): 50%×50% da
         área ÚTIL (o labwc calcula sobre o espaço SEM a barra/dock e o
         rc.gap 10 entra DEPOIS — view_apply_region_geometry ajusta o
         conf para margem limpa). O gesto é do compositor: ARRASTE com
         MODIFICADOR segurado (Ctrl/Alt/Shift/Logo) snapa no quadrante
         sob o cursor (labwc-config(5) §REGIONS) — as metades seguem no
         arraste simples com o preview roxo (themerc-override), e o
         teclado ganha o ciclo W-Setas abaixo. -->
  <regions>
    <region name="quadrante-esq-cima" x="0%" y="0%" width="50%" height="50%" />
    <region name="quadrante-dir-cima" x="50%" y="0%" width="50%" height="50%" />
    <region name="quadrante-esq-baixo" x="0%" y="50%" width="50%" height="50%" />
    <region name="quadrante-dir-baixo" x="50%" y="50%" width="50%" height="50%" />
  </regions>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <desktops>
    <!-- Criador usa 5 desktops e popupTime 0; aqui 4 com popup visível -->
    <popupTime>800</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default/>
    <repeatRate>30</repeatRate>
    <repeatDelay>330</repeatDelay>

    <!-- v2.10.6 — DETERMINISMO DO W-Tab (achado Q27 da Rodada 2): o
         <default/> do labwc pode trazer W-Tab → a LISTA de janelas que a
         v1.7 aposentou, de volta pela porta dos fundos — por teclado.
         O menu das janelas mora na DOCK (clique, v2.10.3); por teclado o
         ciclista é o A-Tab/A-S-Tab do compositor. Bind explícito =
         nenhum default volta sem licença. -->
    <keybind key="W-Tab">
      <action name="None" />
    </keybind>

    <!-- ===== Aplicativos (convenções do criador + núcleo do projeto) ===== -->
    <!-- Terminal: W-Return (criador) e C-A-t (criador) → foot -->
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="foot" />
    </keybind>
    <!-- Launcher: W-d → Launchpad (craft-apps — 1.0-94: a gaveta com
         MEMÓRIA; W-d de novo FECHA, o ESC segue valendo dentro dela e
         o botão Aplicativos da barra alterna igual. O relato do dono
         da 1.0-93: só abria pelo menu — o toggle é porta de primeira
         classe. O fuzzel clássico fica no C-A-space p/ quem quer digitar. -->
    <keybind key="W-d">
      <action name="Execute" command="craft-apps" />
    </keybind>
    <!-- v1.9 — spec M4.1 do dono: a tecla SUPER (Windows) SOZINHA aciona
         o menu de aplicativos (o mesmo Launchpad do botão Arch da barra
         superior — convenção GNOME/Windows: Super = apps). -->
    <keybind key="Super_L">
      <action name="Execute" command="craft-apps" />
    </keybind>
    <!-- v2.0/v2.3.4 — dock NATIVA (craft-dock-gui): SEMPRE VISÍVEL (layer
         BOTTOM + zona exclusiva — o hotspot/tira de 4px da v2.0 morreu no
         rig); W-S-d alterna manualmente (SIGUSR1) e FUNCIONA EM TELA CHEIA
         (keybind do compositor não depende do estado da janela). -->
    <keybind key="W-S-d">
      <action name="Execute" command="craft-dock toggle" />
    </keybind>
    <keybind key="C-A-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <!-- Navegador: W-w (criador) e alias W-b — brave (Wayland-native, v1.1)
         em 1º; os outros são fallback de máquina sem brave -->
    <keybind key="W-w">
      <action name="Execute" command="sh -c 'for b in brave librewolf chromium thorium-browser qutebrowser; do command -v &quot;$b&quot; &gt;/dev/null &amp;&amp; exec &quot;$b&quot;; done; exec xdg-open https://archlinux.org'" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="sh -c 'for b in brave librewolf chromium thorium-browser qutebrowser; do command -v &quot;$b&quot; &gt;/dev/null &amp;&amp; exec &quot;$b&quot;; done; exec xdg-open https://archlinux.org'" />
    </keybind>
    <!-- Arquivos: W-f → Thunar (v1.5: FM padrão, GUI, xdg-mime
         inode/directory=thunar.desktop) · Editor: W-e → gnome-text-editor
         (E136 — a PARTE 2/2 do dono: o GNOME Text Editor GTK4/libadwaita
         é o editor gráfico LEVE padrão da casa, no atalho do desktop e no
         clique duplo do Thunar; o nano FICA no terminal — EDITOR/git) -->
    <keybind key="W-f">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="gnome-text-editor" />
    </keybind>
    <!-- Rede (W-n · o editor gráfico de conexões — E132: o applet saiu,
         o editor é pacote próprio nm-connection-editor) -->
    <keybind key="W-n">
      <action name="Execute" command="nm-connection-editor" />
    </keybind>
    <!-- Bluetooth (W-S-b · E140: o gerenciador gráfico DE VERDADE da
         diretriz do dossiê — o blueman-manager, o mesmo que o botão
         dedicado da craft-bar-rs abre; a casa não reimplementa o
         Bluetooth em menu fuzzel) -->
    <keybind key="W-S-b">
      <action name="Execute" command="blueman-manager" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="foot -e btop" />
    </keybind>
    <!-- E140 — O MIXER DE VERDADE (a ordem do dono, dossiê 1.0-88: o
         craft-audio aposentou com o waybar — o mute instantâneo mora no
         BOTÃO de áudio da craft-bar-rs e o mixer completo é o pwvucontrol,
         o mesmo que o clique direito da barra abre) -->
    <keybind key="W-a">
      <action name="Execute" command="pwvucontrol" />
    </keybind>
    <!-- craft-hello: visão rápida do sistema (E73 — a saudação vive no
         .zshrc; ESTE verbo abre um foot com o retrato e CAI NO SHELL:
         o script executado sem terminal perdia a saída no journal do
         labwc; ELITE_NO_HELLO evita a saudação dobrada) -->
    <keybind key="W-S-h">
      <action name="Execute" command="foot -e sh -c 'craft-hello; export ELITE_NO_HELLO=1; exec zsh'" />
    </keybind>

    <!-- ===== Clipboard: histórico no fuzzel (cliphist — receita labwc) ===== -->
    <keybind key="W-v">
      <action name="Execute" command="sh -c 'cliphist list | craft-pick --title=Clipboard | cliphist decode | wl-copy'" />
    </keybind>

    <!-- ===== Screenshot (F75 Max não tem Print → combos em p) =====
         v2.10.5 — keysym MINÚSCULO: o keysym 'P' maiúsculo implícita
         Shift (Super+p solto podia não casar) e os DOIS binds brilhavam
         no mesmo Super+Shift+p — verbo 'região' podia perder. Em minús-
         culas, W-p = região, W-S-p = tela inteira, SEM ambiguidade. -->
    <keybind key="W-p">
      <action name="Execute" command="craft-shot area" />
    </keybind>
    <keybind key="W-S-p">
      <action name="Execute" command="craft-shot full" />
    </keybind>

    <!-- ===== E136 — OS ATALHOS UNIVERSAIS 60%/75% (Aula F75 Max) =====
         A PARTE 2/2 do dono: nenhum gesto pode depender de tecla que o
         teclado compacto NÃO tem (Print/Fn-row ausentes). Tudo o que
         importa ganha um COMBO de modificador — redundante com os
         W-p/W-S-p de sempre, nunca no lugar deles:
           · W-Print e W-S-s → captura de região (grim+slurp no
             craft-shot; o W-S-s é o combo do costume Windows/GNOME);
           · W-bracketleft/right → workspace anterior/próximo;
           · W-S-space → play/pause; W-S-m → mudo.
         BLOCO 3 — A MIGRAÇÃO DAS SETAS: o Super+Shift+Setas é AGORA o
         mover-entre-workspaces da janela (a ordem do dono acima) — o
         volume e a faixa migram para o Ctrl+Alt+Setas (o MESMO papel,
         o combo irmão de 60/75%); as XF86 continuam mandando no knob
         do F75 e nas teclas Fn de notebook/fone. -->
    <keybind key="W-Print">
      <action name="Execute" command="craft-shot area" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="craft-shot area" />
    </keybind>
    <keybind key="W-bracketleft">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-bracketright">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="C-A-Up">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume raise || pactl set-sink-volume @DEFAULT_SINK@ +5%'" />
    </keybind>
    <keybind key="C-A-Down">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume lower || pactl set-sink-volume @DEFAULT_SINK@ -5%'" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="Execute" command="playerctl next" />
    </keybind>
    <keybind key="C-A-Left">
      <action name="Execute" command="playerctl previous" />
    </keybind>
    <keybind key="W-S-m">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume mute-toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle'" />
    </keybind>
    <keybind key="W-S-space">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>

    <!-- ===== Janelas (convenções do criador) ===== -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <!-- Fechar: W-q e W-c (o criador usa ambos) + A-F4 -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-c">
      <action name="Close" />
    </keybind>
    <!-- Minimizar: W-i e A-F5 (criador) -->
    <keybind key="W-i">
      <action name="Iconify" />
    </keybind>
    <keybind key="A-F5">
      <action name="Iconify" />
    </keybind>
    <!-- Maximizar: W-m e A-F10 (criador) · Fullscreen: A-F11 (criador) -->
    <keybind key="W-m">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="A-F10">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="A-F11">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleDecorations" />
    </keybind>
    <!-- Snap COSMIC — BLOCO 3 (W-setas dividem/encaixam; o segundo
         toque DESENCAIXA — ToggleSnapToEdge devolve a geometria
         natural, a mesma tecla divide e solta). W-Left/W-Right têm o
         ciclo de quadrantes (If de UM nível — o labwc recusa If aninhado
         em branch: "action 'If' cannot be a child action",
         rcxml.c): já tileado na metade → sobe pro QUADRANTE superior da
         mesma metade (a região do rc.xml <regions>); senão → a metade.
         O query <tiled> casa o estado do compositor (view->tiled) e o
         SnapToRegion é validado no arranque (região inexistente =
         'Invalid SnapToRegion id' no log do labwc). -->
    <keybind key="W-Left">
      <action name="If">
        <query>
          <tiled>left</tiled>
        </query>
        <then>
          <action name="SnapToRegion" region="quadrante-esq-cima" />
        </then>
        <else>
          <action name="SnapToEdge" direction="left" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="If">
        <query>
          <tiled>right</tiled>
        </query>
        <then>
          <action name="SnapToRegion" region="quadrante-dir-cima" />
        </then>
        <else>
          <action name="SnapToEdge" direction="right" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleSnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="ToggleSnapToEdge" direction="down" />
    </keybind>

    <!-- BLOCO 3 — SUPER + SHIFT + SETAS MOVEM A JANELA ENTRE WORKSPACES
         (a ordem do dono: a janela em foco viaja e a sessão SEGUE —
         follow=yes; o wrap devolve no fim da fila). O eixo da casa é 1D
         (4 desktops em fila): esquerda/direita andam UMA, cima/baixo
         pulam para a anterior/próxima OCUPADA (workspaces_find:
         left-occupied/right-occupied, labwc 0.9). -->
    <keybind key="W-S-Left">
      <action name="SendToDesktop" to="left" wrap="yes" follow="yes" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SendToDesktop" to="right" wrap="yes" follow="yes" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="SendToDesktop" to="left-occupied" wrap="yes" follow="yes" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="SendToDesktop" to="right-occupied" wrap="yes" follow="yes" />
    </keybind>

    <!-- ===== Desktops (criador: W-1..5; aqui 1..4) ===== -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="yes" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="yes" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="yes" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="yes" />
    </keybind>

    <!-- ===== Menus / Sessão ===== -->
    <!-- W-space → root-menu (convenção do criador) -->
    <keybind key="W-space">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>
    <keybind key="W-Menu">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <!-- Lock (W-l) e sessão: W-Escape · W-x (powermenu do criador) ·
         C-A-Delete → o menu elite-sessao NATIVO do labwc (2.0: o
         craft-logout/craft-power fuzzel aposentou — a tecla abre o
         MESMO menu do botão direito, ZERO processo) -->
    <keybind key="W-l">
      <action name="Execute" command="craft-lock" />
    </keybind>
    <keybind key="W-Escape">
      <action name="ShowMenu" menu="elite-sessao" />
    </keybind>
    <keybind key="W-x">
      <action name="ShowMenu" menu="elite-sessao" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="ShowMenu" menu="elite-sessao" />
    </keybind>
    <!-- Recarregar configs: W-S-r e C-S-R (convenção do criador) -->
    <keybind key="W-S-r">
      <action name="Reconfigure" />
    </keybind>
    <keybind key="C-S-R">
      <action name="Reconfigure" />
    </keybind>
    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>

    <!-- ===== Mídia (knob do F75 Max + teclas Fn de notebook/fone) =====
         E74 — Fase 3: volume/brilho ganham OSD (swayosd — a barra per-
         centual flutuante). O client pede E O daemon aplica; sem daemon
         vivo, o || degrada ao pactl/brightnessctl puro: a barra some,
         a função NUNCA morre. Mic segue pactl (sem OSD — consciente). -->
    <!-- E103: A GRAMÁTICA CERTA DO CLIENT (README do swayosd, main):
         flags output-volume raise/lower/mute-toggle e input-volume
         mute-toggle. O "volume" da era antiga o swayosd atual RECUSA
         ("not a valid option") em CADA tecla. O MIC ganha OSD: o estado
         do mute é feedback, não segredo (a diretriz do dono). -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume raise || pactl set-sink-volume @DEFAULT_SINK@ +5%'" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume lower || pactl set-sink-volume @DEFAULT_SINK@ -5%'" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="sh -c 'swayosd-client --output-volume mute-toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle'" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="sh -c 'swayosd-client --input-volume mute-toggle || pactl set-source-mute @DEFAULT_SOURCE@ toggle'" />
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioPause">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute" command="playerctl next" />
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="playerctl previous" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="sh -c 'swayosd-client --brightness +10% || brightnessctl set +10%'" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="sh -c 'swayosd-client --brightness -10% || brightnessctl set 10%-'" />
    </keybind>
  </keyboard>

  <mouse>
    <default/>
    <context name="Root">
      <!-- v2.7.0 — A LEI DOS DOIS BOTÕES (o dono, rig: "a topbar era pra
           funcionar com click esquerdo e não direito e na home ao
           contrário"): a DIVISÃO é geográfica —
             · TOPBAR (interface): clique ESQUERDO abre/fecha os menus;
             · DESKTOP (aqui): clique DIREITO abre o MENU RAIZ — é o único
               botão que abre menu no desktop, e o ESQUERDO é MUDO por lei
               (nada de menu acidental, nada de menu ao fechar outro).
           A lista de janelas do botão direito saiu na v1.7 (o dock já é
           o comutador de janelas). SCROLL no desktop segue trocando de
           workspace (o gesto que o dono prefere). -->
      <!-- 2.0 — O CLIQUE DO DESKTOP (a lei do dismiss era da era fuzzel:
           o menu era um PROCESSO de fora que o compositor não fechava —
           o craft-menu-dismiss morreu com o motor; o menu do labwc fecha
           SOZINHO no clique fora, Lei do próprio compositor). AQUI fica
           o essencial de sempre:
             · ESQUERDO → None (mudo na prática — a lei v2.7 segue; sem
               Execute o clique é consumido pelo bind casado);
             · MÉDIO → None (limpa o default);
             · DIREITO → ShowMenu root-menu (o menu-raiz no lugar).
           SCROLL no desktop segue trocando de workspace (o gesto que
           o dono prefere). -->
      <mousebind button="Left" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="GoToDesktop" to="left" wrap="yes" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="GoToDesktop" to="right" wrap="yes" />
      </mousebind>
    </context>
  </mouse>

  <!-- Desktop (Aula F75 Max): mouse — tap é irrelevante; ajuste ao gosto -->
  <libinput>
    <device category="default">
      <tap>yes</tap>
      <!-- <naturalScroll>no</naturalScroll> -->
      <!-- <pointerSpeed>0.0</pointerSpeed> -->
      <!-- <disableWhileTyping>yes</disableWhileTyping> -->
    </device>
  </libinput>

  <windowRules>
    <!-- E123 — A MOLDURA É UMA SÓ (spec do dono 06/nov: "todas,
         absolutamente todas as janelas seguem o mesmo padrão"). Regra SEM
         identifier casa com TODA janela (labwc-config(5) + src/view.c:
         query_str_match sem condition devolve true) e o serverDecoration
         "sobrepõe qualquer outra definição no primeiro mapa" (man). O
         casamento do labwc é GLOB (fnmatch(3) case-insensitive —
         labwc-config(5): "shell wildcard patterns (see glob(7))") — em
         glob, "^a|b$" casa com NADA, não use regex aqui.
         App que PRECISA ficar nu: regra identifier="meu-app"
         serverDecoration="no" DEPOIS desta (last-match-wins — o man:
         "later config entries have higher priority") e tire o marcador
         do cabeçalho: o arquivo vira personalizado e a casa nunca mais
         o renova. -->
    <windowRule serverDecoration="yes" />
    <!-- E70/E123 — A ÁREA SE ORGANIZA NO LANÇAMENTO: brave e Code nascem
         maximizados por AÇÃO no primeiro mapa (o man lista as propriedades
         da windowRule e maximized não está nelas — maximized é CRITÉRIO;
         quem maximiza é a ação, que roda no único evento da windowRule,
         ON_FIRST_MAP). Dois identifiers exatos: glob não tem alternância. -->
    <windowRule identifier="brave-browser"><action name="Maximize" /></windowRule>
    <windowRule identifier="Code"><action name="Maximize" /></windowRule>
    <!-- Exemplo para o dono (COMENTADO — descomente para ativar; a sintaxe
         é glob(7): identifier exato, sem '^', sem '|'): <windowRule
         identifier="org.pulseaudio.pavucontrol"><action
         name="ToggleAlwaysOnTop" /></windowRule> -->
    <!-- Outro exemplo: <windowRule identifier="foot" skipTaskbar="yes" /> -->
  </windowRules>

</labwc_config>
