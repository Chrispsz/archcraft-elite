<!-- entregue por craft-rice — a pele do menu (E104): rig vivo renova pela
     gramática fóssil/marcador; menu editado pelo dono = intocável -->
<!--
  Archcraft Cockpit · labwc menu.xml — PERFIL ELITE (v3)
  ══════════════════════════════════════════════════════════════════════════
  E107 — A LEI DO COMENTÁRIO (a ferida que comeu o menu inteiro): a espec
  XML PROÍBE dois hífens seguidos dentro de comentário. A v2.11.4 citou
  um verbo de CLI prefixado por dois hífens na linha 74 e o libxml2 do
  labwc REJEITOU O ARQUIVO
  INTEIRO: todo rig da dose 1.0-50 caiu no menu de fábrica de 3 itens
  (Terminal, Reconfigure, Exit) e o dono perdeu TODAS as portas de uma
  vez — print, atualização, game mode, gaveta da dock, telas, lock ('de
  21 para 3', o dump 200537: o item 'Reconfigurar' que não faz nada é o
  do labwc de fábrica, não da casa). Prova periciada: python3 parse
  'not well-formed line 74 column 65' + o pacote 1.0-50 byte a byte
  igual ao repo. A suíte agora PARSEIA este arquivo como XML de verdade
  (contrato E107 na fase 2) e o craft-rice RECUSA pele que não parseia
  (a pele viva do home segue no lugar — a defesa final do rig).
  ══════════════════════════════════════════════════════════════════════════
  E107 — A CURADORIA DO DONO (a auditoria que ele mandou fazer: 'uma
  definição só do que realmente é importante no botão direito, um menu
  rápido, evitar o terminal, evitar ações de teclado e ações escondidas
  no sistema'): o menu é de AÇÕES DE SISTEMA. Programas vivem no
  Aplicativos (gaveta) — Navegador, Arquivos e Calculadora SAEM (o
  dono: 'para abrir programas padrão já tem a parte de aplicativos';
  a curadoria anterior tirou Editor e Leitor de PDF pelo mesmo motivo).
  O Terminal FICA (o dono, palavra por palavra: 'pode ter o terminal,
  que é um negócio mais universal do sistema'). ENTRAM as portas de
  pacote que faltavam: AppImages… (o registrador da casa — ícone e menu
  para o arquivo único) e Flatpaks… (instalar, remover e limpar dados
  sem terminal) — 'a integração entre os formatos de pacote' do
  relato do dono.
  ══════════════════════════════════════════════════════════════════════════
  ESTRUTURA herdada do menu do criador do Archcraft (obmenu-generator;
  o labwc lê menu.xml ESTÁTICO). Sintaxe: labwc docs/menu.xml +
  labwc-menu(5) (formato openbox_menu).

  DUAS REGRAS COM CONTRATO CI (v1.6.3; a 2ª da v2.2):
    1. TODO Execute command=X tem binário REAL na ISO (packages.add ∪
       /usr/local/bin ∪ allowlist base) — o debloat não quebra item em
       silêncio.
    2. (v2.2, diretriz do dono — leveza radical) NENHUM item carrega
       atributo de ícone: o menu é TEXTO PURO.
    3. (E107) NENHUM comentário deste arquivo contém dois hífens
       seguidos — a espec XML proíbe e o labwc rejeita o arquivo
       inteiro (a suíte parseia: o juiz é o parser, não o olho).
-->
<openbox_menu>

  <!-- Menu da janela (botão direito na titlebar / A-Space) -->
  <menu id="client-menu">
    <item label="Minimizar">
      <action name="Iconify" />
    </item>
    <item label="Maximizar">
      <action name="ToggleMaximize" />
    </item>
    <item label="Fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <item label="Decorações">
      <action name="ToggleDecorations" />
    </item>
    <item label="Sempre no topo">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="Fechar">
      <action name="Close" />
    </item>
  </menu>

  <!-- root-menu (botão direito no desktop)
       E107: AÇÕES DE SISTEMA, nada de programas soltos (o dono:
       'trazer pelo menos o essencial, o importante… mais prático, mais
       direto, o sistema configurável de verdade'). A ordem é a rotina:
       capturar, telas, atualizar, limpar, pacotes, dock, jogo, lock,
       sair. -->
  <menu id="root-menu">
    <!-- o dono: 'pode ter o terminal, que é um negócio mais universal
         assim do sistema' -->
    <item label="Terminal">
      <action name="Execute" command="sh -c 'exec &quot;${TERMINAL:-foot}&quot;'" />
    </item>
    <!-- E30 (v2.10.18): captura rápida no menu (pedido do dono — 'botão de
         captura de tela rápida'; o modo região é o default do craft-shot e
         W-p segue vivo no teclado; tela inteira = W-S-p) -->
    <item label="Captura de tela">
      <action name="Execute" command="craft-shot" />
    </item>
    <!-- E89 — o craft-display lista TODOS os modos do EDID no fuzzel,
         aplica E grava no mesmo clique (a persistência dos hertz que o
         sistema não tinha). E106 — o rótulo DIZ o que faz. -->
    <item label="Telas — resolução e Hz…">
      <action name="Execute" command="craft-display" />
    </item>
    <separator />
    <item label="Atualizar sistema">
      <action name="Execute" command="foot -e craft-update" />
    </item>
    <item label="Limpeza do sistema">
      <action name="Execute" command="foot -e craft-clean" />
    </item>
    <separator />
    <!-- E107 — A PORTA DO APPIMAGE (o craft-appimage da E97 era CLI
         invisível: registra o arquivo baixado no menu da casa com
         ícone e .desktop, extrai de dentro do próprio arquivo — sem
         daemon, sem AUR) -->
    <item label="AppImages…">
      <action name="Execute" command="craft-appimage menu" />
    </item>
    <!-- E107 — A GESTÃO DE FLATPAKS SEM TERMINAL (instalar por busca,
         remover, limpar dados órfãos, atualizar — o flatpak e o remote
         Flathub já viajam na ISO desde a E97; faltava a PORTA) -->
    <item label="Flatpaks…">
      <action name="Execute" command="craft-flatpak" />
    </item>
    <!-- E106 — A GAVETA UNIFICADA (o desenho do dono, palavra por
         palavra: 'um menu unificado… os programas… com o marcador se tá
         ativado, habilitado ou não, para você habilitar e
         desabilitar'). ✓ fixado · não fixado; escolher alterna e
         reabre; ESC/clique-fora/cross-dismiss fecham o laço. -->
    <item label="Apps da dock…">
      <action name="Execute" command="craft-pin-pick" />
    </item>
    <!-- E103 — O MODO DE JOGO (a diretriz do dono: 'um botão em algum
         lugar do sistema para mexer no governor — e o automático que
         define performance quando entrar no jogo'): o craft-game é o
         cérebro, o gamemode do Feral o músculo (governor performance +
         GPU high + rollback automático, RAM zero no idle). E106:
         ON/OFF/Automático/Status DEVOLvem feedback na tela. -->
    <item label="Modo de jogo…">
      <action name="Execute" command="craft-game" />
    </item>
    <!-- v1.6.1: presets do idle no fuzzel, efeito imediato, sem
         relogin -->
    <item label="Tempo para travar a tela…">
      <action name="Execute" command="craft-idle" />
    </item>
    <separator />
    <!-- E90 — O MAPA DOS COMANDOS. E106 — a pausa do E96: a janela
         ABRE E FICA. -->
    <item label="Ajuda — comandos da Elite">
      <action name="Execute" command="foot -e craft-help" />
    </item>
    <item label="Aplicativos">
      <action name="Execute" command="craft-drawer" />
    </item>
    <item label="Lock">
      <action name="Execute" command="craft-lock" />
    </item>
    <!-- E106 — O SAIR DIRETO (o dono: reboot e desligar já estão aqui —
         o que faltava era o SAIR). O menu gráfico completo do power
         segue vivo no ⏻ da topbar e nos atalhos (W-Escape/W-x/C-A-Del). -->
    <item label="Sair da sessão">
      <action name="Execute" command="labwc --exit" />
    </item>
    <separator />
    <item label="Reboot">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="Desligar">
      <action name="Execute" command="systemctl poweroff" />
    </item>
  </menu>

</openbox_menu>
