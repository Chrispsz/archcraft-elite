<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archcraft Cockpit · labwc menu.xml — PERFIL ELITE (v1.2)
  ══════════════════════════════════════════════════════════════════════════
  Estrutura derivada do menu do criador do Archcraft (Aditya Shakya):
  no Archcraft Openbox o menu é gerado dinamicamente por obmenu-generator
  (schema.pl com as categorias Applications/Settings/System) — o labwc lê
  apenas menu.xml ESTÁTICO, então este arquivo reproduz a hierarquia dele
  com os apps que o Cockpit instala/archcraft já traz.
  Fonte: archcraft-openbox/files/obmenu-generator/schema.pl
  Sintaxe: labwc docs/menu.xml + labwc-menu(5) (formato openbox_menu)

  v1.6.3 — CURADORIA COM PROVA (burn test do dono: itens que não abriam e
  itens sem ícone). Duas regras, cada uma com contrato CI:
    1. TODO Execute command=X tem binário REAL na ISO (packages.add ∪
       /usr/local/bin ∪ allowlist base) — o debloat não quebra item em
       silêncio. craft-hello agora abre em foot (fastfetch solto no menu
       escrevia no stdout do labwc — invisível; "overview" que não abre).
    2. TODO item tem icon= e o caminho está no fixture Papirus real
       (tests/fixtures/menu-icons-papirus.txt — lista de arquivos do
       papirus-icon-theme, conferida na API do Arch em out/2026).
  Ícones de AÇÃO (pin/view-refresh/log-out) só existem no Papirus até
  24x24 — itens de APP usam 48x48, itens de ação usam 24x24 (mesmo
  padrão dos itens de Lock/Sessão que já renderizavam).
-->
<openbox_menu>

  <!-- Menu da janela (botão direito na titlebar / A-Space) -->
  <menu id="client-menu">
    <item label="Minimizar">
      <action name="Iconify" />
    </item>
    <item label="Maximizar">
      <action name="ToggleMaximize" />
    </item>
    <item label="Fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <item label="Decorações">
      <action name="ToggleDecorations" />
    </item>
    <item label="Sempre no topo">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="Fechar">
      <action name="Close" />
    </item>
  </menu>

  <!-- root-menu (W-space / W-Menu / clique no desktop) -->
  <menu id="root-menu">
    <item label="Terminal (foot)" icon="/usr/share/icons/Papirus/48x48/apps/utilities-terminal.svg">
      <action name="Execute" command="foot" />
    </item>
    <item label="Navegador" icon="/usr/share/icons/Papirus/48x48/apps/web-browser.svg">
      <action name="Execute" command="sh -c 'for b in brave librewolf chromium thorium-browser qutebrowser; do command -v &quot;$b&quot; &gt;/dev/null &amp;&amp; exec &quot;$b&quot;; done; exec xdg-open https://archlinux.org'" />
    </item>
    <item label="Arquivos (Thunar)" icon="/usr/share/icons/Papirus/48x48/apps/system-file-manager.svg">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Editor (nano)" icon="/usr/share/icons/Papirus/48x48/apps/text-editor.svg">
      <action name="Execute" command="foot -e nano" />
    </item>
    <item label="Leitor de PDF (papers)" icon="/usr/share/icons/Papirus/48x48/mimetypes/application-pdf.svg">
      <action name="Execute" command="papers" />
    </item>
    <item label="Calculadora (qalculate)" icon="/usr/share/icons/Papirus/48x48/apps/qalculate.svg">
      <action name="Execute" command="qalculate-gtk" />
    </item>
    <separator />
    <!-- Applications (categorias do criador, versão enxuta do Cockpit) -->
    <menu id="cockpit-menu" label="Cockpit" icon="/usr/share/icons/Papirus/48x48/apps/preferences-system.svg">
      <item label="craft-hello · overview" icon="/usr/share/icons/Papirus/48x48/apps/utilities-terminal.svg">
        <action name="Execute" command="foot -e craft-hello" />
      </item>
      <item label="craft-update · atualizar sistema" icon="/usr/share/icons/Papirus/48x48/apps/system-software-update.svg">
        <action name="Execute" command="foot -e craft-update" />
      </item>
      <item label="craft-clean · limpeza" icon="/usr/share/icons/Papirus/48x48/apps/bleachbit.svg">
        <action name="Execute" command="foot -e craft-clean" />
      </item>
      <item label="craft-rollback · restaurar backups" icon="/usr/share/icons/Papirus/48x48/apps/timeshift.svg">
        <action name="Execute" command="foot -e sudo craft-rollback" />
      </item>
      <separator />
      <item label="Monitor (btop)" icon="/usr/share/icons/Papirus/48x48/apps/btop.svg">
        <action name="Execute" command="foot -e btop" />
      </item>
      <item label="Mixer (pwvucontrol)" icon="/usr/share/icons/Papirus/48x48/apps/multimedia-volume-control.svg">
        <action name="Execute" command="pwvucontrol" />
      </item>
      <item label="Rede (impala)" icon="/usr/share/icons/Papirus/48x48/devices/network-wireless.svg">
        <action name="Execute" command="foot -e impala" />
      </item>
      <item label="Bluetooth (bluetui)" icon="/usr/share/icons/Papirus/48x48/apps/blueman.svg">
        <action name="Execute" command="foot -e bluetui" />
      </item>
      <item label="Aparência GTK (nwg-look)" icon="/usr/share/icons/Papirus/48x48/apps/nwg-look.svg">
        <action name="Execute" command="nwg-look" />
      </item>
      <item label="Arquivos compactados (7z)" icon="/usr/share/icons/Papirus/48x48/apps/7zip.svg">
        <action name="Execute" command="foot -e 7z" />
      </item>
    </menu>
    <menu id="client-list-combined-menu" label="Janelas..." icon="/usr/share/icons/Papirus/48x48/apps/preferences-system-windows.svg" />
    <separator />
    <item label="Reconfigure (W-S-r)" icon="/usr/share/icons/Papirus/24x24/actions/view-refresh.svg">
      <action name="Reconfigure" />
    </item>
    <item label="Aplicativos (Launchpad)" icon="/usr/share/icons/Papirus/48x48/apps/preferences-desktop.svg">
      <action name="Execute" command="craft-drawer" />
    </item>
    <!-- v1.4: fixar apps na dock no fluxo mouse-first (burn test: o
         clique-direito do drawer pinava no drawer, não na dock) -->
    <item label="Fixar app na dock…" icon="/usr/share/icons/Papirus/24x24/actions/pin.svg">
      <action name="Execute" command="craft-pin-pick" />
    </item>
    <item label="Lock (W-l)" icon="/usr/share/icons/Papirus/24x24/actions/system-lock-screen.svg">
      <action name="Execute" command="craft-lock" />
    </item>
    <!-- v1.6.1: "consigo controlar em quanto tempo o Pc entra em idle?"
         (dono) — presets no fuzzel, efeito imediato, sem relogin -->
    <item label="Tempo para travar a tela…" icon="/usr/share/icons/Papirus/24x24/actions/system-lock-screen.svg">
      <action name="Execute" command="craft-idle" />
    </item>
    <item label="Sessão (menu gráfico)" icon="/usr/share/icons/Papirus/24x24/actions/system-shutdown.svg">
      <action name="Execute" command="craft-power" />
    </item>
    <separator />
    <item label="Reboot" icon="/usr/share/icons/Papirus/24x24/actions/system-reboot.svg">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="Desligar" icon="/usr/share/icons/Papirus/24x24/actions/system-shutdown.svg">
      <action name="Execute" command="systemctl poweroff" />
    </item>
    <item label="Encerrar labwc" icon="/usr/share/icons/Papirus/24x24/actions/system-log-out.svg">
      <action name="Exit" />
    </item>
  </menu>

</openbox_menu>
