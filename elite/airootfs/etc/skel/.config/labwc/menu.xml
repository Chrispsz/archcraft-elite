<?xml version="1.0" encoding="UTF-8"?>
<!-- entregue por craft-rice — a pele do menu (E104): rig vivo renova pela
     gramática fóssil/marcador; menu editado pelo dono = intocável -->
<!--
  Archcraft Cockpit · labwc menu.xml — PERFIL ELITE (v2)
  ══════════════════════════════════════════════════════════════════════════
  E104 (v2) — O RÓTULO NUNCA NOMEIA O PACOTE (ordem do dono: "fica
  aparecendo os nomes dos pacotes"): os rótulos que carregavam o nome do
  pacote ou do atalho entre parênteses (Leitor de PDF, Calculadora,
  Lock, Captura de tela) viram rótulos limpos — o EXEC resolve (a
  varredura do Navegador generalizada: papers→evince→zathura→okular;
  qalculate→gnome-calculator).
  E A PORTA QUE FALTAVA: "Desafixar app da dock…" — o craft-pin rm
  existia desde a v2.0 e era CLI invisível (o dono: "eu consigo fixar,
  mas eu não consigo tirar um aplicativo da dock. Como é que eu faço?").
  E A PELE: este arquivo viaja NO PACOTE (build.sh) e alcança homes
  vivos via craft-rice — o menu do rig deixa de ser fóssil da ISO que o
  instalou (o menu do rig v2.10.28 não tinha nem o Displays… da E89).
  ══════════════════════════════════════════════════════════════════════════
  v1.7 — CURADORIA DO DONO ("deixa só os importantes", "sem muita
  complexidade"): SAÍRAM os itens de ferramentas do antigo submenu
  Cockpit (todos CONTINUAM instalados e vivem no Launchpad, que busca e
  categoriza), a lista de janelas que o botão direito abria (o dock é o
  comutador de janelas), o item de reconfiguração do compositor
  (ferramenta de dev) e o item de encerrar a sessão do compositor
  (mis-click perigoso; o menu de sessão já tem sair).
    · FICARAM: os apps do dia-1 + as 2 ações de sistema que o dono
      elegeu (Atualizar · Limpeza) + Launchpad/Fixar + lock/idle/sessão
      + Reboot/Desligar. 15 itens, texto puro (v2.2: sem tema de ícones).
  ESTRUTURA herdada do menu do criador do Archcraft (obmenu-generator;
  o labwc lê menu.xml ESTÁTICO). Sintaxe: labwc docs/menu.xml +
  labwc-menu(5) (formato openbox_menu).

  DUAS REGRAS COM CONTRATO CI (v1.6.3 — a 2ª substituída na v2.2):
    1. TODO Execute command=X tem binário REAL na ISO (packages.add ∪
       /usr/local/bin ∪ allowlist base) — o debloat não quebra item em
       silêncio.
    2. (v2.2, diretriz do dono — leveza radical) NENHUM item carrega
       atributo de ícone: o tema de ícones saiu da ISO e o menu é TEXTO
       PURO — nenhum caminho de tema pode voltar a este arquivo.
-->
<openbox_menu>

  <!-- Menu da janela (botão direito na titlebar / A-Space) -->
  <menu id="client-menu">
    <item label="Minimizar">
      <action name="Iconify" />
    </item>
    <item label="Maximizar">
      <action name="ToggleMaximize" />
    </item>
    <item label="Fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <item label="Decorações">
      <action name="ToggleDecorations" />
    </item>
    <item label="Sempre no topo">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="Fechar">
      <action name="Close" />
    </item>
  </menu>

  <!-- root-menu (botão direito no desktop)
       E106 — O ENXUGAMENTO QUE O DONO MANDOU ("o menu cresceu… muita coisa
       aqui pode simplesmente ser inútil e pode ser removida… não vamos
       sair adicionando um monte de coisa"): 21 → 17 itens, NADA novo —
       · Editor e Leitor de PDF MORREM (Terminal + Aplicativos cobrem —
         o dono não pediu nenhum dos dois por nome; eram volume morto);
       · "Verificar atualizações" MORRE (o dono: "os dois é a mesma
         coisa. No caso o atualizar sistema ele já verifica e já
         atualiza, se necessário" — provado no craft-update: o --check é
         read-only sobre a base LOCAL, o -Syu sincroniza E atualiza);
       · Fixar + Desafixar VIRAM UM ("Apps da dock…" — a gaveta com
         marcador ✓/· que alterna e reabre, laço que fecha só no
         ESC/clique-fora — o fluxo que o dono desenhou);
       · "Sessão (menu gráfico)" vira "Sair da sessão" (o dono: "só não
         tem sair da sessão ali… poderia levar direto para sessão" — o
         menu completo do power segue vivo no ⏻ da topbar e nos atalhos);
       · Displays ganha o rótulo que diz o que faz (o dono: "esse
         display, eu não sei nem para que é isso"). -->
  <menu id="root-menu">
    <item label="Navegador">
      <action name="Execute" command="sh -c 'for b in brave librewolf chromium thorium-browser qutebrowser; do command -v &quot;$b&quot; &gt;/dev/null &amp;&amp; exec &quot;$b&quot;; done; exec xdg-open https://archlinux.org'" />
    </item>
    <item label="Arquivos">
      <action name="Execute" command="sh -c 'exec &quot;${FILEMANAGER:-thunar}&quot;'" />
    </item>
    <item label="Terminal">
      <action name="Execute" command="sh -c 'exec &quot;${TERMINAL:-foot}&quot;'" />
    </item>
    <!-- E104 — o rótulo não nomeia o pacote: a varredura resolve pelo que
         EXISTE no sistema (a escola do Navegador; o dono: "de acordo com o
         que está, com o que existe no sistema"). E106: o ramo vazio AVISA
         (a classe dnotify do craft-display — morte calada nunca mais). -->
    <item label="Calculadora">
      <action name="Execute" command="sh -c 'for c in qalculate-gtk gnome-calculator; do command -v &quot;$c&quot; &gt;/dev/null &amp;&amp; exec &quot;$c&quot;; done; notify-send -a Elite -u normal -t 8000 &quot;Calculadora não encontrada&quot; &quot;Nenhum binário conhecido no sistema — o sudo craft-update traz o qalculate-gtk&quot;; exit 1'" />
    </item>
    <!-- E30 (v2.10.18): captura rápida no menu (pedido do dono — "botão de
         captura de tela rápida"; o modo região é o default do craft-shot e
         W-p segue vivo no teclado; tela inteira = W-S-p) -->
    <item label="Captura de tela">
      <action name="Execute" command="craft-shot" />
    </item>
    <!-- E89 — Displays no menu (o dono: "deveria ser todas as detectadas…
         ou esse menu fosse bem pensado"): o craft-display lista TODOS os
         modos do EDID no fuzzel, aplica E grava no mesmo clique (a
         persistência dos hertz que o sistema não tinha). E106 — o rótulo
         agora DIZ o que faz (o dono: "esse display, eu não sei nem para
         que é isso" — o nome era a doença). -->
    <item label="Telas — resolução e Hz…">
      <action name="Execute" command="craft-display" />
    </item>
    <separator />
    <item label="Atualizar sistema">
      <action name="Execute" command="foot -e craft-update" />
    </item>
    <item label="Limpeza do sistema">
      <action name="Execute" command="foot -e craft-clean" />
    </item>
    <separator />
    <!-- E90 — O MAPA DOS COMANDOS (a lacuna nº 1 do UX-ROADMAP). E106 — a
         pausa do E96 chegou ao craft-help: a janela ABRE E FICA (o dono:
         "ele tenta abrir uma janela, mas também fecha"). -->
    <item label="Ajuda — comandos da Elite">
      <action name="Execute" command="foot -e craft-help" />
    </item>
    <item label="Aplicativos">
      <action name="Execute" command="craft-drawer" />
    </item>
    <!-- E106 — A GAVETA UNIFICADA (o desenho do dono, palavra por palavra:
         "um menu unificado… os programas… com o marcador se tá ativado,
         habilitado ou não, para você habilitar e desabilitar. Aí ele só
         fecharia quando você tirasse o mouse de cima da função ou
         clicasse fora da tela"). ✓ fixado · não fixado; escolher alterna
         e reabre; ESC/clique-fora/cross-dismiss fecham o laço. -->
    <item label="Apps da dock…">
      <action name="Execute" command="craft-pin-pick" />
    </item>
    <separator />
    <item label="Lock">
      <action name="Execute" command="craft-lock" />
    </item>
    <!-- v1.6.1: "consigo controlar em quanto tempo o Pc entra em idle?"
         (dono) — presets no fuzzel, efeito imediato, sem relogin -->
    <!-- E103 — O MODO DE JOGO (a diretriz do dono: "um botão em algum
         lugar do sistema para mexer no governor — e o automático que
         define performance quando entrar no jogo"): o craft-game é o
         cérebro, o gamemode do Feral o músculo (governor performance +
         GPU high + rollback automático, RAM zero no idle). E106: ON/OFF/
         Automático/Status agora DEVOLvem feedback na tela (o dono:
         "clico em ativar agora e eu não vejo nada"). -->
    <item label="Modo de jogo…">
      <action name="Execute" command="craft-game" />
    </item>
    <item label="Tempo para travar a tela…">
      <action name="Execute" command="craft-idle" />
    </item>
    <!-- E106 — O SAIR DIRETO (o dono: reboot e desligar já estão aqui — o
         que faltava era o SAIR). O menu gráfico completo do power segue
         vivo no ⏻ da topbar e nos atalhos (W-Escape/W-x/C-A-Del). -->
    <item label="Sair da sessão">
      <action name="Execute" command="labwc --exit" />
    </item>
    <separator />
    <item label="Reboot">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="Desligar">
      <action name="Execute" command="systemctl poweroff" />
    </item>
  </menu>

</openbox_menu>
