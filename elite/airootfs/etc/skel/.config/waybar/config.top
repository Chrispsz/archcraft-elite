// Archcraft ELITE · Waybar TOP — "Menu Bar" estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v2.3 (v1.5): canto esquerdo LIMPO (o lançador ARCH saiu — ordem
// direta da spec v1.5; o Launchpad segue na DOCK, 1º botão do grupo
// central). Relógio no CENTRO EXATO (fixed-center + modules-center),
// power no canto direito abrindo o menu de sessão (craft-power), áudio/
// rede só ícone (sem %). Esquerda = nome do app (janela focada) — o
// modelo macOS. Tudo clicável (mouse-first).
//
// v1.4 (burn test da v1.3 AO VIVO no rig do dono, 2026-10-22):
//   · REDE: um só ícone p/ TUDO (cabo + Wi-Fi + Bluetooth) — clique abre
//     o craft-connect (central de conectividade); o café toggle só
//     aparece no bar quando ATIVO (CSS v1.4 — burn test: dois ícones
//     "de rede" confundiam, "um só ícone" é a diretriz)
//
// GLIFOS: escritos como escapes JSON \uXXXX — à prova de corrupção de
// encoding (v1.1 perdeu glifos literais: botões invisíveis na dock).
// Todos os codepoints verificados no cmap do Symbols Nerd Font
// (archcraft-fonts 2.0). Família de fonte REAL: "JetBrainsMono NF".
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,

  // Esquerda (v1.5): SÓ o nome do app focado (wlr-foreign-toplevel,
  // nativo do labwc). Sem janelas → canto esquerdo limpo, zero sujeira.
  "modules-left": ["wlr/window"],

  // Centro: o relógio (v2.1 — diretriz do dono)
  "modules-center": ["clock"],

  // Direita: música → café → rede → áudio → tray → sessão
  "modules-right": [
    "mpris",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "tray",
    "custom/power"
  ],

  // Janela focada — o "nome do app" do menu bar
  "wlr/window": {
    "format": "{}",
    "max-length": 42,
    "truncate": true,
    "tooltip": false
  },

  // Música do USUÁRIO (MPRIS) — YouTube no navegador, Spotify, mpv: o que
  // VOCÊ tocar aparece aqui. Com nada tocando o módulo some sozinho.
  // Clique: esq = play/pause, meio = próxima, dir = anterior.
  "mpris": {
    "format": " \uf001 {dynamic}",
    "format-paused": " \uf04c {dynamic}",
    "format-stopped": "\uf04d",
    "format-empty": "",
    "player-icons": {
      "default": "\uf001"
    },
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c",
      "stopped": "\uf04d"
    },
    "ignored-players": ["playerctld"],
    "dynamic-len": 40,
    "interval": 10
  },

  // Café: inibir idle (útil em vídeos/jogos) — toggle discreto; ativado
  // fica âmbar via CSS (#idle-inhibitor.activated). v1.4: DESATIVADO ele
  // SOMA do bar (fonte 0 + transparente no CSS — burn test: dois ícones
  // "de rede" confundiam; ligado = café âmbar visível, desligado = nada)
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf0f4",
      "deactivated": "\uf0f4"
    }
  },

  // Rede — SÓ ÍCONE, UM SÓ P/ TUDO (v1.4: cabo + Wi-Fi + Bluetooth —
  // diretriz do dono do burn test: "um só ícone, conectividade é 1").
  // O estado vive no ícone (ethernet/wifi/desconectado — tooltips com
  // essid/ip); clique abre a CENTRAL (craft-connect: Redes→impala,
  // Bluetooth→bluetui). Teclado segue: W-n (impala), W-S-b (bluetui).
  // v2.1: ícones FA BMP — escapes \uXXXX legíveis, sem surrogate pairs
  // (network-wired = ethernet; unlink = sem conexão)
  "network": {
    "format": "{icon}",
    "format-ethernet": "\uf6ff",
    "format-wifi": "\uf1eb",
    "format-linked": "\uf6ff",
    "format-disconnected": "\uf127",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "on-click": "craft-connect"
  },

  // Volume (PipeWire) — SÓ ÍCONE (v2.1: sem porcentagem numérica — diretriz
  // do dono; o valor exato mora no tooltip). Clique muta, scroll ajusta,
  // dir abre o mixer. Mudo = ícone vermelho via CSS (.muted).
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\uf026",
    "format-icons": {
      "default": ["\uf027", "\uf028"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "scroll-step": 5,
    "tooltip-format": "{volume}% · {desc}"
  },

  // Tray (udiskie e o que o usuário subir) — SÓ nesta instância (a 2ª waybar
  // não pode ter tray: o SNI watcher é único por sessão)
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // Relógio no CENTRO (v2.1) — clique abre a central de notificações (SwayNC)
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "swaync-client -t",
    "interval": 60
  },

  // Sessão — canto direito: menu dropdown (travar/sair/suspender/reiniciar/
  // desligar — craft-power v2, fuzzel ancorado top-right). Ícone: FA
  // power-off (BMP — o md-power U+F0425 seria surrogate pair)
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Sessão",
    "on-click": "craft-power"
  }
}
