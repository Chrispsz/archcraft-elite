// Archcraft ELITE · Waybar TOP — "Menu Bar" estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v2.1: relógio no CENTRO (diretriz do dono), sem logo no canto
// esquerdo (o launcher mora na dock — botão grade), power no canto DIREITO
// abrindo o menu de sessão (craft-power: dropdown fuzzel ancorado), áudio
// só ícone (sem "40%" numérico). Esquerda = nome do app (janela focada) —
// o modelo macOS. Tudo clicável (mouse-first).
//
// GLIFOS: escritos como escapes JSON \uXXXX — à prova de corrupção de
// encoding (v1.1 perdeu glifos literais: botões invisíveis na dock).
// Todos os codepoints verificados no cmap do Symbols Nerd Font
// (archcraft-fonts 2.0). Família de fonte REAL: "JetBrainsMono NF".
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,

  // Esquerda: nome do app focado (wlr-foreign-toplevel, nativo do labwc).
  // Sem janelas → canto vazio, zero sujeira.
  "modules-left": ["wlr/window"],

  // Centro: o relógio (v2.1 — diretriz do dono)
  "modules-center": ["clock"],

  // Direita: música → café → rede → áudio → tray → sessão
  "modules-right": [
    "mpris",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "tray",
    "custom/power"
  ],

  // Janela focada — o "nome do app" do menu bar
  "wlr/window": {
    "format": "{}",
    "max-length": 42,
    "truncate": true,
    "tooltip": false
  },

  // Música do USUÁRIO (MPRIS) — YouTube no navegador, Spotify, mpv: o que
  // VOCÊ tocar aparece aqui. Com nada tocando o módulo some sozinho.
  // Clique: esq = play/pause, meio = próxima, dir = anterior.
  "mpris": {
    "format": " \uf001 {dynamic}",
    "format-paused": " \uf04c {dynamic}",
    "format-stopped": "\uf04d",
    "format-empty": "",
    "player-icons": {
      "default": "\uf001"
    },
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c",
      "stopped": "\uf04d"
    },
    "ignored-players": ["playerctld"],
    "dynamic-len": 40,
    "interval": 10
  },

  // Café: inibir idle (útil em vídeos/jogos) — toggle discreto; ativado
  // fica âmbar via CSS (#idle-inhibitor.activated)
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf0f4",
      "deactivated": "\uf0f4"
    }
  },

  // Rede — SÓ ÍCONE (essid/ip vivem no tooltip; clique abre o impala).
  // v2.1: ícones FA BMP — escapes \uXXXX legíveis, sem surrogate pairs
  // (network-wired = ethernet; unlink = sem conexão)
  "network": {
    "format": "{icon}",
    "format-ethernet": "\uf6ff",
    "format-wifi": "\uf1eb",
    "format-linked": "\uf6ff",
    "format-disconnected": "\uf127",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "on-click": "foot -e impala"
  },

  // Volume (PipeWire) — SÓ ÍCONE (v2.1: sem porcentagem numérica — diretriz
  // do dono; o valor exato mora no tooltip). Clique muta, scroll ajusta,
  // dir abre o mixer. Mudo = ícone vermelho via CSS (.muted).
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\uf026",
    "format-icons": {
      "default": ["\uf027", "\uf028"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "scroll-step": 5,
    "tooltip-format": "{volume}% · {desc}"
  },

  // Tray (udiskie e o que o usuário subir) — SÓ nesta instância (a 2ª waybar
  // não pode ter tray: o SNI watcher é único por sessão)
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // Relógio no CENTRO (v2.1) — clique abre a central de notificações (SwayNC)
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "swaync-client -t",
    "interval": 60
  },

  // Sessão — canto direito: menu dropdown (travar/sair/suspender/reiniciar/
  // desligar — craft-power v2, fuzzel ancorado top-right). Ícone: FA
  // power-off (BMP — o md-power U+F0425 seria surrogate pair)
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Sessão",
    "on-click": "craft-power"
  }
}
