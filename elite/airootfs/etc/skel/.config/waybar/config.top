// Archcraft ELITE · Waybar TOP — "Menu Bar" estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v2 (v1.0.4): barra de MENU full-width no topo — o modelo é o
// menu bar do macOS: identidade à esquerda, nome do app (janela focada),
// status + relógio à direita. Tudo CLICÁVEL (mouse-first — diretriz do
// dono: "não sou muito de atalho").
//
// Sintaxe validada contra a wiki oficial do Waybar — JSONC com comentários.
// A 2ª instância (dock) fica em config.dock; o autostart sobe as duas.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "fixed-center": false,
  "reload_style_on_change": true,

  // Esquerda: "Apple menu" (logo → Launchpad/nwg-drawer) + janela focada
  "modules-left": ["custom/menu", "wlr/window"],

  // Centro: vazio — o modelo macOS não usa centro
  "modules-center": [],

  // Direita: música → status → tray → relógio → power (modelo macOS)
  "modules-right": [
    "mpris",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "tray",
    "clock",
    "custom/power"
  ],

  // Logo — o "menu Apple" da Elite: abre o Launchpad (nwg-drawer)
  "custom/menu": {
    "format": " 󰣇",
    "tooltip": false,
    "on-click": "craft-drawer"
  },

  // Janela focada — o "nome do app" do menu bar (wlr-foreign-toplevel,
  // protocolo nativo do labwc via wlroots)
  "wlr/window": {
    "format": "{}",
    "max-length": 42,
    "truncate": true,
    "tooltip": false
  },

  // Música do USUÁRIO (MPRIS) — YouTube no navegador, Spotify, mpv: o que
  // VOCÊ tocar aparece aqui. Com nada tocando o módulo some sozinho.
  // Clique: esq = play/pause, meio = próxima, dir = anterior.
  "mpris": {
    "format": " {player_icon} {dynamic}",
    "format-paused": " {status_icon} {dynamic}",
    "format-stopped": " {status_icon}",
    "format-empty": "",
    "player-icons": {
      "default": "",
      "firefox": "",
      "librewolf": "",
      "chromium": "",
      "brave": "",
      "thorium-browser": "",
      "mpv": "",
      "spotify": ""
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "ignored-players": ["playerctld"],
    "dynamic-len": 40,
    "interval": 10
  },

  // Café: inibir idle (útil em vídeos/jogos) — vira "toggle" na barra
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  // Rede — clique abre o gerenciador GRÁFICO de conexões (mouse-first)
  "network": {
    "format": "{ifname}",
    "format-ethernet": "󰈀",
    "format-wifi": " {essid}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰖪",
    "tooltip-format-ethernet": "{ipaddr} via {ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  // Volume (PipeWire) — clique muta, scroll ajusta, dir abre o mixer
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "󰖁 MUT",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "tooltip-format": "{desc}"
  },

  // Tray (blueman, nm-applet, udiskie…) — SÓ nesta instância (a 2ª waybar
  // não pode ter tray: o SNI watcher é único por sessão)
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // Relógio estilo macOS — clique abre a central de notificações (SwayNC)
  "clock": {
    "format": " {:%a %d %b  %H:%M}",
    "format-alt": " {:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "swaync-client -t",
    "interval": 60
  },

  // Power — abre o menu de sessão (labnag; fallback fuzzel)
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "craft-power"
  }
}
