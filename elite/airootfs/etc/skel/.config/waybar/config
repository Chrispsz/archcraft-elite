// Archcraft Cockpit · Waybar — "Floating Pill" (Catppuccin Mocha)
// Sintaxe validada contra a wiki oficial (Bar Config) — JSONC com comentários.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 6,
  "fixed-center": true,
  "reload_style_on_change": true,

  "modules-left": ["wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["idle_inhibitor", "mpris", "pulseaudio", "cpu", "memory", "tray"],

  // Taskbar (janelas abertas — protocolo wlr-foreign-toplevel, nativo do labwc)
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },

  // Relógio — clique alternar hora/data; tooltip com calendário
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%A, %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 60
  },

  // Café: inibir idle (útil em vídeos/jogos) — vira "toggle" na barra
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  // Música do USUÁRIO (MPRIS) — YouTube no navegador, Spotify, mpv: o que
  // VOCÊ tocar aparece aqui. Zero sample music no sistema; com nada tocando
  // o módulo some sozinho (format-empty vazio). Clique: esq = play/pause,
  // meio = próxima, dir = anterior (nativo do módulo — D-Bus direto).
  "mpris": {
    "format": " {player_icon} {dynamic}",
    "format-paused": " {status_icon} {dynamic}",
    "format-stopped": " {status_icon}",
    "format-empty": "",
    "player-icons": {
      "default": "",
      "firefox": "",
      "librewolf": "",
      "chromium": "",
      "brave": "",
      "thorium-browser": "",
      "mpv": "",
      "spotify": ""
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "ignored-players": ["playerctld"],
    "dynamic-len": 40,
    "interval": 10
  },

  // Volume (PipeWire/PulseAudio) — clique muta, scroll ajusta
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "󰖁 MUT",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5,
    "tooltip-format": "{desc}"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip-format": "Load: {load}"
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
