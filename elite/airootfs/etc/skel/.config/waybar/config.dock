// Archcraft ELITE · Waybar DOCK — pílula flutuante estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v2.2: fixados + janelas abertas num SÓ grupo CENTRAL (modelo macOS
// — diretriz do dono: "fixados no centro, abertos no centro").
//
// v1.5 (spec do dono — "dock funcional com pinned apps, ícones visíveis
// no centro mesmo com o app fechado; Brave fixado no centro"):
//   · apps fixados agora são ÍCONES REAIS (módulo image do waybar 0.15:
//     path+size+on-click — o custom module só ganha imagem no master
//     pós-0.15, PR #5069). PNGs 96px do overlay em /usr/share/pixmaps/
//     elite/: Papirus rasterizado (terminal/files) + logo OFICIAL do
//     Brave Origin (product_logo do brave-origin) — bytes determinís-
//     ticos, contrato sha256 no CI, zero dependência de tema ícone.
//   · BRAVE fixado no CENTRO do grupo: o botão image#web é o navegador
//     padrão (mimeapps.list x-scheme-handler/http → brave-browser)
//   · editor (Helix) saiu da dock junto com o pacote (spec: bloatware);
//     nano vive no terminal (W-e)
//   · tooltip = 2ª linha do exec do módulo image (man waybar-image:
//     "$path\n$tooltip") — o mesmo modelo macOS de hover com nome
//
// GLIFOS (drawer/shot): escapes JSON \uXXXX — à prova de corrupção de
// encoding (v1.1 perdeu glifos literais: 7 de 8 botões invisíveis).
// Verificados no cmap do Symbols Nerd Font (archcraft-fonts 2.0).
//
// FIXAR APPS (glyph, route do usuário): clique-direito no desktop →
// "Fixar app na dock…" (craft-pin-pick) ou `craft-pin add NOME GLYPH
// TOOLTIP COMANDO [cor]` — insere ANTES do separador, junto aos fixos.
{
  "layer": "top",
  "position": "bottom",
  "height": 62,
  "exclusive": false,
  "margin-top": 0,
  // v1.4: 8px SEMPRE (a pílula flutua visível — auto-hide morto; o CSS
  // só cuida do visual da pílula e do zoom no hover)
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,

  // Esquerda/direita: VAZIOS — o modelo macOS é um único bloco central
  "modules-left": [],
  "modules-right": [],

  // Centro: Launchpad + apps fixados (ícones reais) + separador +
  // janelas abertas — um grupo (craft-pin insere os SEUS pins antes
  // do "custom/sep")
  "modules-center": [
    "custom/drawer",
    "image#term",
    "image#files",
    "image#web",
    "custom/shot",
    "custom/sep",
    "wlr/taskbar"
  ],

  // Launchpad — grade de apps com busca (nwg-drawer). Glifo ARCH
  // (U+F303, nf-linux-archlinux) em MAUVE no CSS — marca do rice; é
  // também o herdeiro do botão que saiu da menu bar (spec v1.5).
  "custom/drawer": {
    "format": "\uf303",
    "tooltip-format": "Aplicativos",
    "on-click": "craft-drawer"
  },

  // ── Apps fixados — ÍCONES REAIS (v1.5) ──────────────────────────────
  // Pin de fábrica: visível no centro MESMO COM O APP FECHADO (é o
  // módulo image, não o taskbar). Sem interval → render única, zero
  // polling. O exec devolve 2 linhas: path do PNG + tooltip (label de
  // hover no idioma do rice).
  "image#term": {
    "exec": "echo /usr/share/pixmaps/elite/terminal.png; echo 'Terminal (foot)'",
    "size": 36,
    "on-click": "foot"
  },
  "image#files": {
    "exec": "echo /usr/share/pixmaps/elite/files.png; echo 'Arquivos (Thunar)'",
    "size": 36,
    "on-click": "thunar"
  },
  "image#web": {
    "exec": "echo /usr/share/pixmaps/elite/web.png; echo 'Brave Origin (navegador padrão)'",
    "size": 36,
    "on-click": "brave"
  },

  // Screenshot — ação (não app): segue glifo com zoom no hover
  "custom/shot": {
    "format": "\uf0c4",
    "tooltip-format": "Screenshot (região)",
    "on-click": "craft-shot"
  },

  // Separador fixos │ abertos (1px via CSS — fronteira visual do modelo)
  "custom/sep": {
    "format": " ",
    "tooltip": false
  },

  // Janelas abertas — ícones grandes estilo dock (Papirus via wlr/taskbar;
  // app_id → .desktop → ícone). Clique foca, meio fecha, dir minimiza.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 40,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "ignore-list": []
  }

  // ── PINS (craft-pin) — apps fixados pelo usuário; use craft-pin add/rm
}
