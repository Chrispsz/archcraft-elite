// Archcraft ELITE · Waybar DOCK — pílula flutuante estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v2.1: fixados + janelas abertas num SÓ grupo CENTRAL (modelo macOS
// — diretriz do dono: "fixados no centro, abertos no centro").
//
// v1.4 (burn test da v1.3 ao vivo, diretrizes do dono):
//   · SEMPRE VISÍVEL: o auto-hide (margin-bottom negativa, v1.1) SAIU —
//     "a dock sumiu": com exclusive:false + -52px de CSS sobrava só um
//     talho de 10px de ícones CORTADOS na base da tela ("ícones
//     sobrepostos"). iOS/macOS: dock é permanente — a pílula flutua 8px
//     acima da base e o zoom no hover continua (CSS)
//   · Fixar apps: clique-direito no desktop → "Fixar app na dock…"
//     (craft-pin-pick — o caminho mouse-first; CLI segue craft-pin)
//
// GLIFOS: escritos como escapes JSON \uXXXX — à prova de corrupção de
// encoding (v1.1 perdeu glifos literais: 7 de 8 botões invisíveis).
// Verificados no cmap do Symbols Nerd Font (archcraft-fonts 2.0).
//
// FIXAR APPS: os launchers fixos acima nascem no skel; os SEUS ficam na
// seção PINS — gerencie com `craft-pin add steam '' Steam steam green` /
// `craft-pin rm steam` (insere ANTES do separador, junto aos fixos).
{
  "layer": "top",
  "position": "bottom",
  "height": 62,
  "exclusive": false,
  "margin-top": 0,
  // v1.4: 8px SEMPRE (a pílula flutua visível — auto-hide morto; o CSS
  // só cuida do visual da pílula e do zoom no hover)
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,

  // Esquerda/direita: VAZIOS — o modelo macOS é um único bloco central
  "modules-left": [],
  "modules-right": [],

  // Centro: Launchpad + apps fixos + separador + janelas abertas — um grupo
  // (craft-pin insere os SEUS pins antes do "custom/sep")
  "modules-center": [
    "custom/drawer",
    "custom/term",
    "custom/files",
    "custom/web",
    "custom/editor",
    "custom/shot",
    "custom/sep",
    "wlr/taskbar"
  ],

  // Launchpad — grade de apps com busca e categorias (nwg-drawer).
  // v1.3: glifo ARCH (U+F303, nf-linux-archlinux — presente no cmap do
  // JetBrainsMono NF do archcraft-fonts 2.0). Era o grid U+F00b genérico;
  // o dono pediu o logo do Arch no drawer — em mauve no CSS (marca do rice).
  "custom/drawer": {
    "format": "\uf303",
    "tooltip-format": "Aplicativos",
    "on-click": "craft-drawer"
  },

  // ── Apps fixos (mouse-first: um clique, um app) ──────────────────────
  "custom/term": {
    "format": "\uf120",
    "tooltip-format": "Terminal (foot)",
    "on-click": "foot"
  },
  "custom/files": {
    "format": "\uf07b",
    "tooltip-format": "Arquivos (yazi)",
    "on-click": "foot -e yazi"
  },
  "custom/web": {
    "format": "\uf132",
    "tooltip-format": "Brave Origin (navegador padrão)",
    "on-click": "brave"
  },
  "custom/editor": {
    "format": "\uf121",
    "tooltip-format": "Editor (Helix)",
    "on-click": "foot -e helix"
  },
  "custom/shot": {
    "format": "\uf0c4",
    "tooltip-format": "Screenshot (região)",
    "on-click": "craft-shot"
  },

  // Separador fixos │ abertos (1px via CSS — fronteira visual do modelo)
  "custom/sep": {
    "format": " ",
    "tooltip": false
  },

  // Janelas abertas — ícones grandes estilo dock (Papirus via wlr/taskbar;
  // app_id → .desktop → ícone). Clique foca, meio fecha, dir minimiza.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 40,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "ignore-list": []
  }

  // ── PINS (craft-pin) — apps fixados pelo usuário; use craft-pin add/rm
}
