// Archcraft ELITE · Waybar DOCK — pílula flutuante estilo macOS (Catppuccin Mocha)
// ─────────────────────────────────────────────────────────────────────────
// Desktop v3 (v1.8 — a SPEC DO DONO): dock centralizada estilo macOS/COSMIC,
// "bem bonita, organizada e arredondada", com os principais programas
// fixados de fábrica, fixar/desfixar pelo usuário (craft-pin) e — NOVO —
// INDICADOR DE PROGRAMA ABERTO no pin (o ponto do macOS):
//   · cada pin é um módulo custom com `return-type: json` alimentado pelo
//     craft-pin-status: 1 pgrep por pin a cada 3s (sem rede, sem jq — a
//     classe de leak da v1.6.2 segue extinta por contrato NARROW:
//     só é permitido exec = craft-pin-status).
//   · o JSON devolve class="running" quando o app está de pé → o CSS
//     acende a barra-indicador sob o ícone (style.dock.css .running).
//   · janelas abertas (fixadas ou não) continuam no wlr/taskbar à direita
//     do separador — clique foca, meio fecha, dir minimiza. O waybar 0.15
//     não expõe ativação de toplevel externa (sem wlrctl no Arch), então o
//     clique no pin abre nova instância — limitação documentada, o foco
//     das janelas abertas é pelo taskbar (o que qualquer OS faz).
//
// v1.6 (mantido — FORENSE COM FONTE PRIMÁRIA): pins são módulos custom com
//   GLIFO Nerd Font — o waybar 0.15.0 crasha em silêncio com 3+ módulos
//   image (Alexays/Waybar#5051, fix só no master). Zero pixbuf, zero race.
//
// GLIFOS (drawer/shot/pins): escapes JSON \uXXXX — à prova de corrupção de
// encoding (v1.1 perdeu glifos literais: 7 de 8 botões invisíveis).
// Verificados no cmap do Symbols Nerd Font (archcraft-fonts 2.0).
//
// FIXAR APPS: clique-direito no desktop → "Fixar app na dock…"
// (craft-pin-pick) ou `craft-pin add NOME GLYPH TOOLTIP COMANDO [cor]` —
// insere ANTES do separador, junto aos fixos, com indicador de aberto.
{
  "layer": "top",
  "position": "bottom",
  "height": 62,
  "exclusive": false,
  "margin-top": 0,
  // v1.4: 8px SEMPRE (a pílula flutua visível — auto-hide morto; o CSS
  // só cuida do visual da pílula e do zoom no hover)
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,

  // Esquerda/direita: VAZIOS — o modelo macOS é um único bloco central
  "modules-left": [],
  "modules-right": [],

  // Centro: Launchpad + apps fixados (GLIFOS — v1.6) + separador +
  // janelas abertas — um grupo (craft-pin insere os SEUS pins antes
  // do "custom/sep"). BRAVE é o 3º de 5 pins = CENTRO EXATO da dock.
  "modules-center": [
    "custom/drawer",
    "custom/term",
    "custom/files",
    "custom/web",
    "custom/shot",
    "custom/sep",
    "wlr/taskbar"
  ],

  // Launchpad — grade de apps com busca (nwg-drawer). Glifo ARCH
  // (U+F303, nf-linux-archlinux) em MAUVE no CSS — marca do rice; é
  // também o herdeiro do botão que saiu da menu bar (spec v1.5).
  "custom/drawer": {
    "format": "\uf303",
    "tooltip-format": "Aplicativos",
    "on-click": "craft-drawer"
  },

  // ── Apps fixados de fábrica — INDICADOR DE ABERTO (v1.8) ───────────
  // O exec devolve JSON {text, class, tooltip} do craft-pin-status:
  // class="running" acende o ponto macOS no CSS; tooltip = label de
  // hover no idioma do rice. Polling limitado: 1 pgrep a cada 3s.
  "custom/term": {
    "exec": "craft-pin-status foot \uf489 'Terminal (foot)'",
    "return-type": "json",
    "interval": 3,
    "on-click": "foot"
  },
  "custom/files": {
    "exec": "craft-pin-status thunar \uf07c 'Arquivos (Thunar)'",
    "return-type": "json",
    "interval": 3,
    "on-click": "thunar"
  },
  "custom/web": {
    "exec": "craft-pin-status brave \uf292 'Brave Origin (navegador padrão)'",
    "return-type": "json",
    "interval": 3,
    "on-click": "brave"
  },

  // Screenshot — ação (não app): segue glifo com zoom no hover
  "custom/shot": {
    "format": "\uf0c4",
    "tooltip-format": "Screenshot (região)",
    "on-click": "craft-shot"
  },

  // Separador fixos │ abertos (1px via CSS — fronteira visual do modelo)
  "custom/sep": {
    "format": " ",
    "tooltip": false
  },

  // Janelas abertas — ícones grandes estilo dock (Papirus via wlr/taskbar;
  // app_id → .desktop → ícone). Clique foca, meio fecha, dir minimiza.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 40,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "ignore-list": []
  }

  // ── PINS (craft-pin) — apps do usuário, com indicador de aberto; craft-pin add/rm
}
