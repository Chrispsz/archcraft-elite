# ═══════════════════════════════════════════════════════════════════════════
# Archcraft ELITE · elite-automount@.service — o oneshot POR EVENTO (E151)
# ═══════════════════════════════════════════════════════════════════════════
# A segunda metade do substituto do udiskie (a regra 91-elite-automount
# agenda esta unit via SYSTEMD_WANTS no evento do plug): cada dispositivo
# ganha UMA execução curta do elite-automount e o systemd esquece —
# zero daemon residente, zero polling (a filosofia §5 da casa).
[Unit]
Description=ELITE automount de %i (o udiskie Python aposentou — E151)
# o udisksd responde por D-Bus: presente ou dbus-ativado no instante
After=udisks2.service multi-user.target

[Service]
Type=oneshot
# o %i é o nome do device (sdb1/mmcblk0p1); o helper resolve o usuário
# ativo da sessão gráfica e monta DELE (nunca um mount de root no home)
ExecStart=/usr/local/bin/elite-automount %i
# o plug não é urgência: não segura o boot nem morre por timeout agressivo
TimeoutStartSec=30
