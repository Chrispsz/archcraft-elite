[Unit]
Description=Elite session probe — evidência da sessão gráfica p/ o gate de CI
Documentation=man:elite-session-probe(8)
# POR QUÊ EXISTE: o gate do CI parava no LOGIN e nunca via a sessão — a
# classe "barras mortas" (v1.6.2→v1.7.0) atravessou 3 releases invisível.
# Este unit dispara o probe 60s após o graphical.target, quando o SDDM
# autologin + labwc + o orquestrador elite-daemon session já subiram e
# estabilizaram.
# E190 T1 — O PROBE É DA LIVE (a auditoria do boot do rig: o oneshot de
# 60s INFLAVA o systemd-analyze instalado em 1min 00.231s — o
# elite-daemon supervisiona a sessão em tempo real e o probe não tem
# ofício NENHUM no rig; o gate do CI boota a ISO e é LÁ que o console
# serial do probe é lido). O MARCADOR /run/archiso (o carimbo do
# archiso de fábrica) é a cerca: na Live o gate segue com a prova
# inteira; no sistema INSTALADO a unit é PULADA no arranque (o
# post-upgrade ainda a desabilita + mascara como cinto — a dose veste
# os dois lados).
ConditionPathExists=/run/archiso
After=graphical.target

[Service]
Type=oneshot
TimeoutStartSec=180
# 60s: janela de estabilização. O waybar que vai morrer por condição de
# arranque (race/recurso) já morreu e já foi reiniciado pelo craft-bars
# (loop de 5s) — o probe enxerga o estado REAL, não o instantâneo do spawn.
ExecStartPre=/bin/sleep 60
ExecStart=/usr/local/bin/elite-session-probe
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
