[Unit]
# ═══════════════════════════════════════════════════════════════════════════
# ELITE (E122) — A POLÍTICA DO DESPERTAR, a cada boot.
# ═══════════════════════════════════════════════════════════════════════════
# O relato do dono (dump 182602, seção 10): dormiu e NADA acordava — o
# /proc/acpi/wakeup do rig mostrava XHC0/PS2K/PS2M TODOS *disabled (a era
# E24 desarmou TODO controlador USB PCI e o dono fotografou o preço:
# monitor apagado, PC vivo, teclado e mouse sem voz, o power button que
# o logind atende como poweroff). A cura é a política do craft-wake-guard:
# TECLADO acorda (USB HID protocolo 01 + PS2K), MOUSE e o resto do bus
# dormem (a vibração na mesa não acende nada), controlador USB 0x0c03
# armado (a porta por onde o teclado fala).
#
# POR QUE UMA UNIT a cada boot: a regra udev da casa v2 (ISO: 90-*; pacote:
# /usr/lib/udev/rules.d/91-elite-wake-guard.rules — a E126) cobre a ISO
# nova (coldplug + hotplug), MAS os rigs da era E24 ainda
# têm a .rules velha no disco (pacote não sobrescreve arquivo que não é
# dele) — a varredura roda DEPOIS do coldplug e VENCE por ordem: o
# suspende só acontece minutos depois (LOCK/SUSPEND_MIN), nunca há
# corrida. Idempotente por contrato (escrever só o que diverge).
ConditionPathExists=/usr/local/bin/craft-wake-guard

[Service]
Type=oneshot
ExecStart=/usr/local/bin/craft-wake-guard apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
