[Unit]
Description=Elite: foreground booster (promove o app/jogo em foco p/ fg-boost.slice)
Documentation=https://github.com/ValveSoftware
After=graphical.target
# v1.5.2 — TETO DE RESTART: on-failure com RestartSec=5 NUNCA atinge o
# start-limit default (5/10s) — um exit≠0 numa guarda virava crash-loop
# INFINITO silencioso. Aconteceu: o debloat v4.2 varreu o xdotool e TODA
# boot de v1.0 a v1.5 teve 'Failed with result exit-code' repetindo no
# journal (17× no serial do gate verify da v1.5 — nenhum gate via, porque
# nada varria units em failed; v1.5.2 fecha esse buraco no gate também).
# 3 tentativas em 2min e a unit para em failed: visível no status, sem spam.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
# Slice= realiza o fg-boost.slice (CPUWeight/IOWeight altos) — sem isto o
# script morre na guarda '[[ -d /sys/fs/cgroup/fg-boost.slice ]]' (fix diag:
# restart-loop 203 + slice nunca criado no live da v1.0.2)
Slice=fg-boost.slice
ExecStart=/usr/local/bin/fg-booster
# on-failure (e não always): se xdotool sumir, não virar crash-loop
# (v4.1.1: guards de ambiente saem 0 — restart só em crash REAL do loop)
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
