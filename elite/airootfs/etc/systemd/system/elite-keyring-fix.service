[Unit]
# ═══════════════════════════════════════════════════════════════════════════
# ELITE (v2.10.10) — E23: a 5ª camada da cura do keyring, agora como ROOT.
# ═══════════════════════════════════════════════════════════════════════════
# A doença no rig (dump d33o, journal 23:00:46): o craft-fix-keys da sessão
# chama 'sudo -n' sem terminal — "a password is required" — e o keyring do
# pacman NUNCA curou no sistema instalado ("o chaveiro não pode ser escrito"
# + chaves CachyOS desconhecidas = pacman -Syu morto = sistema que não
# atualiza = sistema que não PERMANECE na melhor versão).
# Esta unit roda o MESMO craft-fix-keys como root — o script já é root-ready
# (id -u 0 executa direto, sem sudo) e tem guard próprio de 24h (o selo só
# é escrito com a cura FEITA; sem rede, sem selo, re-tenta).
# LIÇÃO DO CICLO (a3dea28, dump d33o L403): aqui NÃO existe ordenação com
# graphical/multi-user e NÃO existe .wants de boot target — a ativação é
# EXCLUSIVA do timer (timers.target.wants), o caminho que não briga com a
# transação de boot. Habilitação de fábrica == o único caminho de ativação.
Description=ELITE: cura do keyring do pacman (root, sem sudo de sessão)
Documentation=man:pacman-key(8)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/bin/craft-fix-keys

[Service]
Type=oneshot
# v2.10.16.1 · E29.1 — ESPERAR ANTES DE CURAR: a camada de sessão
# (craft-fix-keys no autostart do liveuser) pode estar no MEIO da própria
# transação quando este timer dispara (login ~40s vs timer 120s) — duas
# curas simultâneas disputam o MESMO lock do gnupg e o mesmo db.lck do
# pacman. O guarda espera (teto 420s) qualquer pacman/pacman-key em voo:
# transações se enfileiram em vez de colidir (e um pacman-init que o
# daemon-reload marcou para reiniciar encontra o mesmo guarda).
ExecStartPre=/usr/local/bin/craft-keyring-wait
ExecStart=/usr/local/bin/craft-fix-keys
