[Unit]
Description=Elite: first-boot (driver GPU + serviços + tokens GRUB) — auto-desativa
Documentation=https://wiki.cachyos.org
# Só no sistema INSTALADO — na sessão live (/run/archiso existe) nunca roda
ConditionPathExists=!/run/archiso
ConditionPathExists=!/var/lib/elite/firstboot-done
# DEPOIS do desktop, nunca refém dele: com multi-user.target o boot ficou
# 30min preso num pacman lento até o TimeoutStartSec matar o serviço. O
# desktop sobe primeiro; o tuning termina em background.
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/elite-tune --firstboot
TimeoutStartSec=1800
# O EPÍLOGO É LEI: sucesso, falha OU timeout-kill registram o resultado
# (ExecStopPost roda em TODOS os casos; NÃO marca firstboot-done — sem
# rede o firstboot re-tenta no boot seguinte, agora sem travar nada).
# O "$$" entrega um '$' LITERAL ao sh (a gramática do systemd.service(5)):
# a expansão vira UMA só (a do sh, que lê o env SERVICE_RESULT/EXIT_STATUS
# garantido ao ExecStopPost — a linha com ${VAR} cruzava DUAS camadas de
# expansão e virava lixo).
# E138 — A PROVA DO EPÍLOGO (a ordem do dono, dump v2.13: o log do rig
# carregava 'resultado: /bin/bash (exit=/bin/bash)' — o %s de SPECIFIER
# da unit da ISO de 3/nov virava o SHELL DO ROOT; o $$ atual é a cura e
# o EXIT_CODE entra junto: signal-kill tem exit-status vazio e o código
# mora nele — o timeout-kill do primeiro boot fica LEGÍVEL no papel).
ExecStopPost=/bin/sh -c 'printf "\n[elite-firstboot] resultado: %s (exit=%s code=%s)\n" "$$SERVICE_RESULT" "$$EXIT_STATUS" "$$EXIT_CODE" >> /var/log/elite-firstboot.log'
StandardOutput=append:/var/log/elite-firstboot.log
StandardError=append:/var/log/elite-firstboot.log
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
