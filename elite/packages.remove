boost              # headers de dev no live; o boost-libs runtime viria por dep se algo pedisse
man-db             # o E15 já poda /usr/share/man do disco — manter o pacote é peso duplo
man-pages          # idem
memtest86+         # memtest no menu do GRUB — nicho de resgate (restore: pacman -S)
memtest86+-efi     # idem
apparmor           # userspace inerte sem LSM habilitado no kernel
linux-firmware-marvell # firmware nicho, fora da curadoria de firmware (v1.1)
rxvt-unicode-terminfo  # terminal removido, terminfo órfã
archcraft-openbox-themes # temas OB de sessões mortas (o rice tem themerc-override próprio)
