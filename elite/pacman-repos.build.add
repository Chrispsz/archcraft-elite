# >>> ELITE: CachyOS — inserido ANTES de [core] (precedência v3 sobre core/extra;
# [archcraft] continua acima, como no upstream). Servers seguem o mirrorlist
# oficial (cdn77 primário; mirror.cachyos.org está DESABILITADO no mirrorlist
# deles). SigLevel TrustAll SÓ neste conf de BUILD — bootstrap determinístico,
# o mesmo padrão que o próprio repo [archcraft] usa. O SISTEMA instalado
# recebe o keyring oficial (chave F3B607488DB35A47) via elite-customize.sh [E1/E2].
[cachyos]
SigLevel = Optional TrustAll
Server = https://cdn77.cachyos.org/repo/x86_64/cachyos
Server = https://us.cachyos.org/repo/x86_64/cachyos

[cachyos-v3]
SigLevel = Optional TrustAll
Server = https://cdn77.cachyos.org/repo/x86_64_v3/cachyos-v3
Server = https://us.cachyos.org/repo/x86_64_v3/cachyos-v3

[cachyos-core-v3]
SigLevel = Optional TrustAll
Server = https://cdn77.cachyos.org/repo/x86_64_v3/cachyos-core-v3
Server = https://us.cachyos.org/repo/x86_64_v3/cachyos-core-v3

[cachyos-extra-v3]
SigLevel = Optional TrustAll
Server = https://cdn77.cachyos.org/repo/x86_64_v3/cachyos-extra-v3
Server = https://us.cachyos.org/repo/x86_64_v3/cachyos-extra-v3
# <<< ELITE
